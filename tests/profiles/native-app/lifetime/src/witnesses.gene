(fn checkpoint [phase count]
  ($runtime/test_collect)
  (let stats ($runtime/gc_stats))
  ($println ($json/stringify
    {^workload "witnesses" ^phase phase ^iterations count
     ^rc_stats stats/rc_stats?
     ^live_managed stats/live_managed
     ^managed_classes stats/managed_classes
     ^native_roots stats/native_roots})))

(fn main [args] : Int
  (let count ($parse/parse_int (?? args/0 "1000")))
  (let form ($read_one """
    (do
      (type WitnessKey ^props {^text Str})
      (impl ValueEq for WitnessKey
        (message equal [other : WitnessKey] : Bool
          (== self/text other/text)))
      (impl ValueHash for WitnessKey
        (message hash [] : Int ($hash self/text)))
      (impl ValueOrder for WitnessKey
        (message compare [other : WitnessKey] : Int
          (if (< self/text other/text) -1
            (if (> self/text other/text) 1 0))))
      WitnessKey)
  """))
  (let retained (eval form ^in (env)))
  ($assert (== (retained ^text "a") (retained ^text "a")))
  (repeat 100 (eval form ^in (env)))
  (checkpoint "warm" 100)
  (for batch in [1 100 1000 count]
    ($println ($json/stringify
      {^workload "witnesses" ^phase "starting" ^iterations batch}))
    (repeat batch (eval form ^in (env)))
    ($assert (== (retained ^text "a") (retained ^text "a")))
    (checkpoint "after" batch))
  0)
