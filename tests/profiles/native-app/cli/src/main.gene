(import [label] ^from "." ^pkg "support")

(fn main [args] : Int
  (let text ($pkg/read_text this_pkg "data/schema.json"))
  (let bytes ($pkg/read_bytes this_pkg "data/schema.json"))
  (let schema ($json/parse text))
  (let dependency ($pkg/dependency this_pkg "support"))
  (let lease ($pkg/materialize this_pkg "data/schema.json"))
  (let cached ($json/parse ($fs/read_text lease/.path)))
  (let leased (/materialized_resource_leases ($runtime/gc_stats)))
  lease/.close
  (let released (/materialized_resource_leases ($runtime/gc_stats)))
  (var abandoned ($pkg/materialize this_pkg "data/schema.json"))
  (set abandoned nil)
  (let dropped (/materialized_resource_leases ($runtime/gc_stats)))
  (let native_lease ($pkg/native_binary this_pkg "native"))
  (let native_lib ($ffi/open native_lease/.path))
  (let score ($ffi/bind native_lib "native_score" [C/Int64] C/Int64))
  (let native_result (score 41))
  ($ffi/Library/close native_lib)
  native_lease/.close
  ($println ($json/stringify {^workload "cli"
                             ^ok (&& (== text ($binary/to_str bytes))
                                     (== dependency/name "gene/native_app_support")
                                     (== cached/title schema/title)
                                     (== leased 1) (== released 0)
                                     (== dropped 0)
                                     (== native_result 42)
                                     (== (/materialized_resource_leases
                                            ($runtime/gc_stats)) 0))
                             ^native_result native_result
                             ^label (label schema/title)}))
  0)
