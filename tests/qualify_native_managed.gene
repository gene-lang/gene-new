# Native Gene orchestrates bounded managed-SDK qualification subprocesses.
# Run from the repository root with optional --asan and --tsan.
(fn main [args] : Int
  (let modes ["disabled" "probe"])
  (for option in args/body
    ($assert (|| (== option "--asan") (== option "--tsan"))
      "expected --asan or --tsan")
    (modes .push (if (== option "--asan") "asan" "tsan")))
  ($fs/make_dir "tmp/native-managed-qualification")
  (let root ($fs/real_path "tmp/native-managed-qualification"))
  (var results [])
  (for mode in modes
    ($println ($json/stringify {^mode mode ^phase "build"}))
    (let output $"${root}/${mode}")
    (var command ["c" "--mm:atomicArc" "--threads:on" "-d:geneRcStats"
      "--path:src" "--hints:off" $"--nimcache:${root}/cache-${mode}" $"-o:${output}"])
    (if (!= mode "disabled")
      (command .push "-d:geneAtomicGenerationRetirementProbe"))
    (if (== mode "asan")
      (do
        (command .push "--passC:-fsanitize=address")
        (command .push "--passC:-fno-omit-frame-pointer")
        (command .push "--passL:-fsanitize=address")))
    (if (== mode "tsan")
      (do
        (command .push "--passC:-fsanitize=thread")
        (command .push "--passC:-fno-omit-frame-pointer")
        (command .push "--passL:-fsanitize=thread")))
    (command .push (if (== mode "disabled")
      "tests/test_native_managed_disabled.nim" "tests/test_native_managed.nim"))
    (let build (await ($os/exec_async ^cmd "nim" ^args command
      ^timeout_ms 600000 ^max_bytes 1048576)))
    ($fs/write_text $"${output}-build.log" ($to_str build/stdout build/stderr))
    ($assert (&& (== build/status 0) (! build/truncated))
      $"build failed: ${output}-build.log")
    ($println ($json/stringify {^mode mode ^phase "run"}))
    (let filters (if (== mode "tsan")
      ["wrong lane is rejected before reading a live borrow"
       "foreign attached lane traverses handles while collector defers"
       "foreign root release waits for its admitted borrow"
       "foreign root and borrow retain private Scope provenance"
       "a released handle cannot invalidate an admitted borrow"
       "attached foreign lane completes a managed Task"
       "frozen child handles keep weak provenance after parents release"
       "managed definitions transfer weak Scope tickets to binding and result"
       "managed Actor keeps message provenance while its handler is parked"
       "managed Actor stays on root until worker allocations are qualified"
       "owner-dependent borrow callback never blocks its collecting lane"
       "last owner cleanup runs outside registry and admission locks"] []))
    (let run (await ($os/exec_async ^cmd output ^args filters
      ^timeout_ms 180000 ^max_bytes 1048576)))
    ($fs/write_text $"${output}-run.log" ($to_str run/stdout run/stderr))
    (let sha ($crypto/sha256 ($fs/read_bytes output)))
    (let ok (&& (== run/status 0) (! run/truncated) (! run/timed_out)))
    (results .push {^mode mode ^ok ok ^sha256 sha ^status run/status
      ^timed_out run/timed_out ^command command})
    ($fs/write_text $"${root}/report.json" ($json/stringify results))
    ($println ($json/stringify {^mode mode ^phase "finished" ^ok ok ^sha256 sha}))
    ($assert ok $"qualification failed: ${output}-run.log"))
  0)
