(serde_v1 "(mod plugin (import [Plugin DescriptorContext PluginContext PluginHost] from \"../../../src/plugin_api\") (import_impl PluginHost for PluginContext from \"../../../src/kernel\") (fn ^capabilities [] init [ctx : DescriptorContext] : Plugin (Plugin ^id \"session_counter\" ^provides [\"SessionCounter\"] ^requires [] ^^contextual ^activate (fn [] (fn [host] (fn increment [] (let current (host .PluginHost:state)) (let count (if (== current nil) 0 (path current count))) (let next {^count (+ count 1)}) (host .PluginHost:update_state next) (path next count)) (host .PluginHost:provide \"SessionCounter\" increment))))))")