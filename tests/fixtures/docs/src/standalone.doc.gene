(mod standalone @doc "A native namespace documented only by its sidecar.")

(fn thing [x : Int] : Int
  ^errors []
  @doc "Return `x` unchanged."
  @for "standalone/thing"
  nil)

(fn ghost [] : Int
  @@unverified
  @doc "A name the runtime may not register; recorded as unverified."
  @for "standalone/ghost"
  nil)
