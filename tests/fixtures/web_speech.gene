(mod web_speech_fixture ^profile web)
(fn recognition_available [] : Bool ($speech/recognizer_available?))
(fn synthesis_available [] : Bool ($speech/synth_available?))
(fn voices [] : (List Any) ($speech/voices))
(fn recognize [partial : (Fn [Str] Nil), final : (Fn [Str] Nil), ended : (Fn [Str] Nil)] : EventTarget
  ($speech/recognize_start "en-US" partial final ended))
(fn finish [capture : EventTarget] : Nil ($speech/recognize_stop capture))
(fn abort [capture : EventTarget] : Nil ($speech/recognize_abort capture))
(fn speak [value : Str, started : (Fn [] Nil), ended : (Fn [Str] Nil)] : Nil
  ($speech/speak value "test" 1.0 started ended))
(fn cancel [] : Nil ($speech/cancel))
(fn context [] : EventTarget ($audio/context))
(fn resume [context : EventTarget] : Nil ($audio/resume context))
(fn close [context : EventTarget] : Nil ($audio/close context))
(fn pcm_capture [context : EventTarget, frame : (Fn [(Buffer U8)] Nil), level : (Fn [F64] Nil), error : (Fn [Str] Nil)] : EventTarget
  ($audio/capture_open context 16000.0 20.0 frame level error))
(fn pcm_capture_raw [context : EventTarget, frame : (Fn [(Buffer U8)] Nil), level : (Fn [F64] Nil), error : (Fn [Str] Nil)] : EventTarget
  ($audio/capture_open_raw context 16000.0 20.0 frame level error))
(fn pcm_finish [capture : EventTarget, done : (Fn [] Nil)] : Nil ($audio/capture_finish capture done))
(fn pcm_abort [capture : EventTarget] : Nil ($audio/capture_close capture))
(fn pcm_player [context : EventTarget, error : (Fn [Str] Nil)] : EventTarget ($audio/player_open context 24000.0 error))
(fn pcm_push [player : EventTarget, bytes : (Buffer U8)] : Nil ($audio/player_push player bytes))
(fn pcm_stop [player : EventTarget] : Nil ($audio/player_fade_stop player))
(fn pcm_started [player : EventTarget, callback : (Fn [] Nil)] : Nil ($audio/player_on_start player callback))
(fn pcm_drained [player : EventTarget, callback : (Fn [] Nil)] : Nil ($audio/player_on_drain player callback))
(fn pcm_queued [player : EventTarget] : F64 ($audio/player_queued_ms player))
(fn pcm_played [player : EventTarget] : F64 ($audio/player_played_bytes player))
