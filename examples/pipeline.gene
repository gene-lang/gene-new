# Sequenced value pipelines evaluate each incoming value before the next stage.

(fn named [^value]
  value)

(var arithmetic (2 -> + 3 -> * 4))

(var named_value (7 -> named ^value _))

# A `=>` stage with a later stage maps lazily; nothing is collected until the
# final `->` asks for it.
(var doubled ([1 2 3] => * 2 -> $into []))

# The same shape terminates on a producer that never ends.
(fn naturals* []
  (var n 0)
  (while true
    (yield n)
    (set n (+ n 1))))
(var head ((naturals*) => * 2 -> $take 4 -> $into []))

($println [arithmetic named_value doubled head])

# A `=>` that ends the pipeline runs for effect and answers nil.
([1 2 3] => $println)
