#!/usr/bin/env gene run
# =============================================================================
# Gene TODO app — end-to-end web application on the net/http MVP server,
# persisted in SQLite through the shared Db protocol.
#
#   HTML page:  GET  /                     server-rendered todo list + forms
#               GET  /?filter=active|done  same page, filtered rows
#   Form flow:  POST /todos                create (redirects to /)
#               POST /todos/toggle         toggle done flag (redirects to /)
#               POST /todos/delete         delete (redirects to /)
#               POST /todos/clear-done     drop finished todos (redirects to /)
#   JSON API:   GET  /api/todos            list todos (honors ?filter=...)
#               POST /api/todos            create   (form body: text=...)
#               POST /api/todos/toggle     toggle   (form body: id=N)
#               POST /api/todos/delete     delete   (form body: id=N)
#
# Run:  bin/gene run examples/todo_app/src/main.gene   (creates ./todo.db)
# Then: open http://127.0.0.1:8090
#
# The whole page is one authored source file: server logic, HTML, CSS, and
# browser behavior. No build command, no bundler, no hand-written JavaScript.
# The `web_module` block below is compiled to a browser module while this
# module loads, and served from a content-addressed route the application owns
# (docs/proposals/transpile.md §4.12).
#
# The one thing outside this file is `gene/utils`, a sibling package holding
# the form-decoding helpers every form-posting app needs and nothing this app
# owns. It is declared in package.gene as a `^path` dependency, so a fresh
# clone resolves it with no install step (docs/proposals/package.md §8).
#
# The store functions only speak the Db protocol (exec/query/execute), so
# swapping in db/postgres means changing `open` and the SQL placeholder
# style ($1 instead of ?) — the app code shape stays the same. Markup is
# ordinary node data built with quasiquote templates; one `render` edge
# converts nodes to HTML text at the response boundary.
# =============================================================================

(mod todo_app
  @doc "SQLite-backed TODO list with an HTML page and a JSON API")

(import $html [render])
(import $css [css rule decl scoped class_name render : render_css])
(import $web [script stylesheet])
(import $json [stringify])
(import gene/stream [to_stream map filter into])
(import $net/http [Request Response Server serve json redirect not_found])
(import $db/sqlite [open DbError Db])
# Form decoding and field validation are not todo-specific, so they live in a
# sibling package rather than at the bottom of this file. `"."` is that
# package's entry module (docs/proposals/package.md §10); the dependency is
# declared in package.gene, and only a declared dependency can be imported.
(import [with_str with_int] from "." ^pkg "gene/utils")

# -----------------------------------------------------------------------------
# Store: SQLite via the Db protocol. `done` is stored as 0/1.
# -----------------------------------------------------------------------------

(var db (open "todo.db"))
(db ~ Db:exec "create table if not exists todos (
  id integer primary key autoincrement,
  text text not null,
  done integer not null default 0)")

(fn list_todos [] : (List Map)
  (db ~ Db:query "select id, text, done from todos order by id"))

(fn add_todo [text : Str] : Nil
  (db ~ Db:execute "insert into todos(text) values (?)" text))

(fn toggle_todo [id : Int] : Nil
  (db ~ Db:execute "update todos set done = 1 - done where id = ?" id))

(fn delete_todo [id : Int] : Nil
  (db ~ Db:execute "delete from todos where id = ?" id))

(fn clear_done [] : Nil
  (db ~ Db:execute "delete from todos where done = 1"))

(fn done? [t] : Bool
  (!= t/done 0))

# -----------------------------------------------------------------------------
# Browser behavior, authored here. This block is a web-profile source unit: it
# sees the web prelude and its own declarations, and nothing from the module
# around it — not `db`, not the current request, not `styles`. That is what
# keeps it compilable (the profile has no image for a SQLite handle) and what
# stops "same file" from quietly becoming "captures the server".
#
# The enhancement is progressive: every row below is server-rendered and works
# with JavaScript off. One delegated listener on the mount root then upgrades
# two interactions in place — including rows a later response adds, which is the
# property delegation buys over per-row listeners:
#
#   - clicking a todo's text reveals the id the server already rendered beside
#     it;
#   - clicking its ✓/○ button posts to the JSON API instead of submitting the
#     form, and rewrites that one row from the response rather than reloading
#     the page. With JavaScript off the form posts and the page reloads, which
#     is the behavior this replaces, not a fallback bolted beside it.
# -----------------------------------------------------------------------------

(web_module todo_client
  (fn peeking? [classes : Str] : Bool
    (str/contains? classes "peek"))

  (fn without_peek [classes : Str] : Str
    (str/trim (str/join (str/split classes "peek") "")))

  (fn toggled [classes : Str] : Str
    (if (peeking? classes)
      (without_peek classes)
      (str/trim $"${classes} peek")))

  # Row lookup without `querySelector`: the delegated listener already has the
  # clicked button, and the row is its form's parent.
  (fn row_for [button : Any] : Any
    (var form button/parent_element)
    (if_yes form form/parent_element))

  # The server's own rendering rule, applied to one row. Keeping it in one
  # function is what stops the optimistic update and the server response from
  # drifting apart.
  (fn paint_row [row : Any, button : Any, done : Bool] : Void
    (var was : Str row/class_name)
    (var peek (if (peeking? was) " peek" ""))
    (set! row/class_name (if done $"done${peek}" $"open${peek}"))
    (set! button/text_content (if done "✓" "○")))

  # `event` is the DOM `Any` boundary, so each field read is annotated where it
  # re-enters typed code — that annotation is the only place a mistake about
  # the DOM shape can hide, rather than every use downstream of it.
  (fn on_click [event : Any] : Void
    (var target event/target)
    (var target_class : Str target/class_name)
    ($console/log $"todo_client: click on class=${target_class}")
    (if_yes (== target_class "text")
      (var row target/parent_element)
      (if_yes row
        (var row_class : Str row/class_name)
        (set! row/class_name (toggled row_class))))
    (if_yes (== target_class "toggle")
      # Stop the form POST *before* the request goes out: after an await the
      # browser has already navigated and nothing this handler does can matter.
      ($dom/prevent_default event)
      (var id : Str target/dataset/id)
      (var row (row_for target))
      (if_yes row
        ($console/log $"todo_client: toggling todo ${id}")
        ($http/post_form "/api/todos/toggle" $"id=${id}"
          (fn [body : Str] : Void
            # The response is the authoritative list, so the row is painted
            # from what the server stored rather than from a guess about what
            # the click did.
            (var todos : (List Any) ($json/parse body))
            (for todo in todos
              (var todo_id : Int todo/id)
              (if_yes (== $"${todo_id}" id)
                (var done : Bool todo/done)
                ($console/log $"todo_client: todo ${id} is now done=${done}")
                (paint_row row target done))))))))

  (fn main [root : EventTarget] : Void
    ($console/log "todo_client: mounted, delegating clicks from the root")
    ($dom/add_event_listener root "click" on_click)))

# -----------------------------------------------------------------------------
# Filter views: every listing route accepts all | active | done. The public URL
# still uses stable strings; app code uses a backed enum internally.
# -----------------------------------------------------------------------------

(enum TodoFilter ^backing Str
  (all "all")
  (active "active")
  (done "done"))

(fn parse_filter [value] : TodoFilter
  (var flt (TodoFilter ~ from_backing (|| value "all")))
  (if (== flt void) TodoFilter/all flt))

(fn keep? [flt : TodoFilter]
  (match flt
    (when TodoFilter/active (fn [t] (! (done? t))))
    (when TodoFilter/done   done?)
    (when TodoFilter/all    (fn [t] true))))

(fn todos_for [flt : TodoFilter] : (List Map)
  ((to_stream (list_todos)) ~ filter (keep? flt) ; ~ into []))

# -----------------------------------------------------------------------------
# JSON rendering: plain maps in, json/stringify out.
# -----------------------------------------------------------------------------

(fn todo_map [t] : Map
  {^id t/id ^text t/text ^done (done? t)})

(fn todos_json [flt : TodoFilter] : Str
  (stringify ((to_stream (todos_for flt)) ~ map todo_map ; ~ into [])))

# -----------------------------------------------------------------------------
# HTML and CSS rendering: both stay ordinary node data until their one public
# render edge. The generated class scopes every selector to this component.
# -----------------------------------------------------------------------------

(var styles
  (scoped "todo_app"
    (css
      (rule "&"
        (decl font "16px/1.5 system-ui")
        (decl margin 0)
        (decl background "#f4f4f5")
        (decl color "#18181b"))
      (rule ".wrap"
        (decl max_width "560px")
        (decl margin "40px auto")
        (decl padding "0 20px"))
      (rule ".card"
        (decl padding "20px 24px")
        (decl border_radius "14px")
        (decl margin "16px 0")
        (decl background "#fff"))
      (rule "ul" (decl list_style "none") (decl padding 0))
      (rule "li"
        (decl display "flex")
        (decl align_items "center")
        (decl gap "8px")
        (decl padding "6px 0")
        (decl border_bottom "1px solid #eee"))
      (rule "li.done .text"
        (decl text_decoration "line-through")
        (decl opacity ".5"))
      (rule ".text" (decl flex 1) (decl cursor "pointer"))
      # The server renders every hint; the click handler only toggles `peek`.
      # With JavaScript off the hints stay hidden and nothing else changes.
      (rule ".hint"
        (decl display "none")
        (decl font_variant_numeric "tabular-nums"))
      (rule "li.peek" (decl background "#fef9c3"))
      (rule "li.peek .hint" (decl display "inline"))
      (rule "form.inline" (decl display "inline"))
      (rule "button"
        (decl border 0)
        (decl border_radius "8px")
        (decl padding "4px 10px")
        (decl cursor "pointer")
        (decl background "#e4e4e7"))
      (rule ".add input[type=text]"
        (decl flex 1)
        (decl padding "8px")
        (decl border "1px solid #ddd")
        (decl border_radius "8px"))
      (rule ".add" (decl display "flex") (decl gap "8px"))
      (rule ".muted" (decl opacity ".6") (decl font_size ".85em"))
      (rule ".foot"
        (decl display "flex")
        (decl gap "12px")
        (decl align_items "center")
        (decl justify_content "space-between")
        (decl flex_wrap "wrap"))
      (rule ".filters" (decl display "flex") (decl gap "8px"))
      (rule "a.filter"
        (decl color "inherit")
        (decl text_decoration "none")
        (decl opacity ".55"))
      (rule "a.filter.on" (decl opacity 1) (decl font_weight 600)))))

(var rendered_css (render_css styles))
(var scope_class (class_name styles))

(fn todo_row [t] : Node
  (var id t/id)
  (var text t/text)
  (var mark (if (done? t) "✓" "○"))
  (var cls (if (done? t) "done" "open"))
  (var hint $"#${id}")
  # `data-id` on the button is what lets the delegated handler identify the row
  # without traversing up to find the form's hidden input. It keeps its wire
  # spelling — `html/render` writes attribute names verbatim, the same rule
  # `^content-type` follows below. With JavaScript off the form still posts and
  # the page reloads, exactly as before.
  `(li ^class %cls
     (form ^class "inline" ^method "post" ^action "/todos/toggle"
       (input ^type "hidden" ^name "id" ^value %id)
       (button ^class "toggle" ^data-id %id ^title "toggle" %mark))
     (span ^class "text" %text)
     (span ^class "muted hint" %hint)
     (form ^class "inline" ^method "post" ^action "/todos/delete"
       (input ^type "hidden" ^name "id" ^value %id)
       (button ^title "delete" "✕"))))

(fn filter_link [flt : TodoFilter, target : TodoFilter] : Node
  (var cls (if (== flt target) "filter on" "filter"))
  (var key (target ~ backing))
  (var href (if (== target TodoFilter/all) "/" $"/?filter=${key}"))
  `(a ^class %cls ^href %href %key))

(fn page [flt : TodoFilter] : Str
  (var rows ((to_stream (todos_for flt)) ~ map todo_row ; ~ into []))
  (var all_items (list_todos))
  (var done_count ($size ((to_stream all_items) ~ filter done? ; ~ into [])))
  (var open_count (- ($size all_items) done_count))
  (var counts $"${open_count} open · ${done_count} done")
  (var clear
    (if (> done_count 0)
      `(form ^class "inline" ^method "post" ^action "/todos/clear-done"
         (button ^title "delete all done todos" "clear done"))
      ""))
  # Both the stylesheet and the script are generated routes, so this page
  # loads under a plain `script-src 'self'; style-src 'self'` — no nonce, no
  # inline hash, and nothing for a `Str` return type to have to carry.
  # Referring to the asset is what publishes it; there is no route table to
  # forget to mount.
  ($ "<!doctype html>"
     (render
       `(html
          (head (title "Gene TODO")
                %(stylesheet "todo_app" rendered_css))
          (body ^class %scope_class
            (main ^class "wrap" ^id "todo_root"
              (header (h1 "Gene TODO"))
              (section ^class "card"
                (form ^class "add" ^method "post" ^action "/todos"
                  (input ^type "text" ^name "text"
                         ^placeholder "What needs doing?" ^^autofocus)
                  (button "Add"))
                (ul %rows...)
                (div ^class "muted foot"
                  (span %counts)
                  (span ^class "filters"
                    %(filter_link flt TodoFilter/all)
                    %(filter_link flt TodoFilter/active)
                    %(filter_link flt TodoFilter/done))
                  %clear
                  (a ^href "/api/todos" "JSON"))))
            %(script todo_client ^mount "todo_root"))))))

# -----------------------------------------------------------------------------
# Routing: method + path, HTML flows redirect, API flows return JSON.
# -----------------------------------------------------------------------------

(fn handle [req]
  (match [req/method req/path]
    (when ["GET" "/"]
      (page (parse_filter req/params/filter)))
    (when ["POST" "/todos"]
      (with_str req "text" (fn [text] (add_todo text) (redirect "/"))))
    (when ["POST" "/todos/toggle"]
      (with_int req "id" (fn [id] (toggle_todo id) (redirect "/"))))
    (when ["POST" "/todos/delete"]
      (with_int req "id" (fn [id] (delete_todo id) (redirect "/"))))
    (when ["POST" "/todos/clear-done"]
      (clear_done)
      (redirect "/"))
    (when ["GET" "/api/todos"]
      (json (todos_json (parse_filter req/params/filter))))
    (when ["POST" "/api/todos"]
      (with_str req "text" (fn [text]
        (add_todo text)
        (Response ^status 201
                  ^headers {^content-type "application/json"}
                  ^body (todos_json TodoFilter/all)))))
    (when ["POST" "/api/todos/toggle"]
      (with_int req "id"
        (fn [id] (toggle_todo id) (json (todos_json TodoFilter/all)))))
    (when ["POST" "/api/todos/delete"]
      (with_int req "id"
        (fn [id] (delete_todo id) (json (todos_json TodoFilter/all)))))
    (else
      (not_found "<h1>404</h1><p>No such route.</p>"))))

# -----------------------------------------------------------------------------
# Entry point: serve until the process is stopped.
# -----------------------------------------------------------------------------

($println "TODO app listening on http://127.0.0.1:8090")
(serve (Server ^host "127.0.0.1" ^port 8090) handle)
