# Drawing. The only module that touches a canvas, which is why it is separate
# from world.gene: keeping the simulation host-free is what lets it run on the
# VM as well as in the browser.
#
# There is no JavaScript here. `$canvas/*` reaches CanvasRenderingContext2D
# directly through the web profile, so the atlas blit, the player sprite, the
# cursor, and the cave backdrop are all Gene.

(mod render ^profile web)

(import [t_stone t_dirt tile_size hash2 surface_at idx in_reach? p_width p_height]
  from "./world.gene")

(fn atlas_cols [] : F64 4.0)

# --- primitives --------------------------------------------------------------

(fn draw_tile [ctx : Canvas2D atlas : EventTarget
               id : F64 sx : F64 sy : F64] : Void
  (var ts tile_size)
  (var col (// id (atlas_cols)))
  (var row ($math/floor (/ id (atlas_cols))))
  ($canvas/draw_image ctx atlas
    (* col ts) (* row ts) ts ts
    ($math/round sx) ($math/round sy) ts ts))

# The wall behind a cave. Without it, air below the surface shows the sky
# gradient and every cavern reads as a hole punched through the world.
(fn draw_backdrop [ctx : Canvas2D sx : F64 sy : F64 depth : F64] : Void
  (var t ($math/clamp (/ depth 55.0) 0.0 1.0))
  (var r ($math/round (- 58.0 (* 34.0 t))))
  (var g ($math/round (- 64.0 (* 38.0 t))))
  (var b ($math/round (- 76.0 (* 44.0 t))))
  ($canvas/set_fill ctx ($ "rgb(" r "," g "," b ")"))
  ($canvas/fill_rect ctx ($math/round sx) ($math/round sy)
    tile_size tile_size))

(fn draw_player [ctx : Canvas2D sx : F64 sy : F64 facing : F64] : Void
  (var ts tile_size)
  (var x ($math/round sx))
  (var y ($math/round sy))
  (var pw ($math/round (* p_width ts)))
  (var ph ($math/round (* p_height ts)))
  ($canvas/set_fill ctx "#2f3542")
  ($canvas/fill_rect ctx x (+ y (- ph 10.0)) pw 10.0)      # legs
  ($canvas/set_fill ctx "#c85a54")
  ($canvas/fill_rect ctx x (+ y 8.0) pw (- ph 18.0))       # torso
  ($canvas/set_fill ctx "#e8c39e")
  ($canvas/fill_rect ctx (- x 1.0) y (+ pw 2.0) 9.0)       # head
  # One eye, so which way the player faces is readable at 16px.
  ($canvas/set_fill ctx "#2f3542")
  ($canvas/fill_rect ctx (if (< facing 0.0) x (+ x (- pw 3.0))) (+ y 3.0) 2.0 2.0))

(fn draw_highlight [ctx : Canvas2D sx : F64 sy : F64 reachable : Bool] : Void
  ($canvas/set_stroke ctx
    (if reachable "rgba(255,255,255,0.85)" "rgba(255,120,120,0.5)"))
  ($canvas/set_line_width ctx 1.0)
  ($canvas/stroke_rect ctx (+ ($math/round sx) 0.5) (+ ($math/round sy) 0.5)
    (- tile_size 1.0) (- tile_size 1.0)))

# --- the walk ----------------------------------------------------------------
# Only the visible window is walked, so world size costs nothing per frame.

# Gameplay id and drawn id are different things: the world stores stone as
# `t_stone` so mining and inventory stay simple, while the renderer picks one of
# several stamps so a cliff face is not one texture repeated.
(fn render_variant [id : F64 x : F64 y : F64] : F64
  (if (== id t_stone)
    (do
      (var r (hash2 x y 777.0))
      (if (< r 0.34) id (if (< r 0.67) 12.0 13.0)))
    (if (== id t_dirt)
      (if (< (hash2 x y 778.0) 0.5) id 14.0)
      id)))

(fn render [ctx : Canvas2D atlas : EventTarget
            tiles : (List F64) w : F64 h : F64
            cam_x : F64 cam_y : F64
            view_w : F64 view_h : F64 seed : F64] : Void
  (var ts tile_size)
  (var x0 ($math/floor (/ cam_x ts)))
  (var y0 ($math/floor (/ cam_y ts)))
  (var x1 (+ x0 (+ 2.0 ($math/floor (/ view_w ts)))))
  (var y1 (+ y0 (+ 2.0 ($math/floor (/ view_h ts)))))
  (if_yes (< x0 0.0) (set x0 0.0))
  (if_yes (< y0 0.0) (set y0 0.0))
  (if_yes (> x1 w) (set x1 w))
  (if_yes (> y1 h) (set y1 h))
  # Column-major so each column's surface height is computed once rather than
  # once per tile. That height is what tells a cave from open sky.
  (var x x0)
  (while (< x x1)
    (var ground (surface_at x seed))
    (var y y0)
    (while (< y y1)
      (var i (idx x y w))
      (var id tiles/%i)
      (var sx (- (* x ts) cam_x))
      (var sy (- (* y ts) cam_y))
      (if (> id 0.5)
        (draw_tile ctx atlas (render_variant id x y) sx sy)
        # Sub-surface air is a cave, not a window: put a wall behind it that
        # darkens with depth, or the underground reads as a hole in the world.
        (if_yes (> y ground)
          (draw_backdrop ctx sx sy (- y ground))))
      (set y (+ y 1.0)))
    (set x (+ x 1.0))))

(fn render_cursor [ctx : Canvas2D tiles : (List F64) p : (List F64)
                   tx : F64 ty : F64 cam_x : F64 cam_y : F64
                   w : F64 h : F64] : Void
  (var ts tile_size)
  (draw_highlight ctx (- (* tx ts) cam_x) (- (* ty ts) cam_y)
    (in_reach? p tx ty)))

(fn render_player [ctx : Canvas2D p : (List F64) cam_x : F64 cam_y : F64] : Void
  (var ts tile_size)
  (draw_player ctx (- (* (- p/0 (/ p_width 2.0)) ts) cam_x)
               (- (* p/1 ts) cam_y)
               p/5))
