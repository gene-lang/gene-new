# Game-shell logic: camera, spawn, save encoding, hotbar.
#
# These were JavaScript in main.mjs, and none of them had a reason to be:
# they are arithmetic and array walks over state the host already owns. What
# stays in JS is only what touches the DOM — the canvas, the keyboard, and
# localStorage — because the web profile's host surface stops there.
#
# Same rules as world.gene: every hot value is F64 (Int lowers to bigint), and
# nothing is held at module level, so all state arrives as arguments.

(mod shell ^profile web)

(fn tile_size [] : F64 16.0)

# --- camera ----------------------------------------------------------------
# cam is [x y]; the host owns it so this module stays stateless.

(fn follow_camera [cam : (List F64) px : F64 py : F64
                   w : F64 h : F64 view_w : F64 view_h : F64
                   ease : F64] : Void
  (var ts (tile_size))
  # Ease toward the player, then clamp so the view never leaves the world.
  # Clamping after easing matters: easing toward an already-clamped target
  # would drift the camera inside the edge instead of pinning it there.
  (var tx (- (* px ts) (/ view_w 2.0)))
  (var ty (- (* py ts) (/ view_h 2.0)))
  (var cx (+ cam/0 (* (- tx cam/0) ease)))
  (var cy (+ cam/1 (* (- ty cam/1) ease)))
  (set! cam/0 ($math/clamp cx 0.0 (- (* w ts) view_w)))
  (set! cam/1 ($math/clamp cy 0.0 (- (* h ts) view_h))))

# How dark the world is at this camera height: 0 at the surface, rising
# underground. Drives both the sky gradient and the depth overlay.
(fn depth_shade [cam_y : F64 start : F64 span : F64 limit : F64] : F64
  ($math/clamp (/ (- (/ cam_y (tile_size)) start) span) 0.0 limit))

# --- spawn -----------------------------------------------------------------

# First y where a player standing at `x` would rest on something solid.
(fn spawn_y [tiles : (List F64) x : F64 w : F64 h : F64] : F64
  (var y 0.0)
  (var found -1.0)
  (while (< y (- h 3.0))
    (if_yes (< found 0.0)
      (do
        (var i (+ x (* (+ y 2.0) w)))
        (if_yes (> tiles/%i 0.5) (set found y))))
    (set y (+ y 1.0)))
  (if (< found 0.0) 0.0 found))

# --- save encoding ---------------------------------------------------------
# A world is mostly long runs of stone and air, so it round-trips through a
# run-length pair list. The host owns `out` and reads back the pair count,
# because the web profile has no growable list.

(fn rle_encode [tiles : (List F64) n : F64 out : (List F64) cap : F64] : F64
  (var pairs 0.0)
  (var last tiles/0)
  (var run 0.0)
  (var i 0.0)
  (while (< i n)
    (var v tiles/%i)
    (if (== v last)
      (set run (+ run 1.0))
      (do
        (if_yes (< (* pairs 2.0) cap)
          (do
            (var a (* pairs 2.0))
            (var b (+ a 1.0))
            (set! out/%a last)
            (set! out/%b run)))
        (set pairs (+ pairs 1.0))
        (set last v)
        (set run 1.0)))
    (set i (+ i 1.0)))
  (if_yes (< (* pairs 2.0) cap)
    (do
      (var a (* pairs 2.0))
      (var b (+ a 1.0))
      (set! out/%a last)
      (set! out/%b run)))
  (+ pairs 1.0))

(fn rle_decode [runs : (List F64) pairs : F64
                tiles : (List F64) n : F64] : Void
  (var at 0.0)
  (var p 0.0)
  (while (< p pairs)
    (var a (* p 2.0))
    (var b (+ a 1.0))
    (var value runs/%a)
    (var count runs/%b)
    (var k 0.0)
    (while (&& (< k count) (< at n))
      (set! tiles/%at value)
      (set at (+ at 1.0))
      (set k (+ k 1.0)))
    (set p (+ p 1.0))))

# --- hotbar ----------------------------------------------------------------

# Wrap a selection by `step` over `count` slots. Written out rather than using
# a remainder so a negative step stays in range without a second correction.
(fn cycle_slot [selected : F64 step : F64 count : F64] : F64
  (var next (+ selected step))
  (if (< next 0.0)
    (+ next count)
    (if (>= next count) (- next count) next)))
