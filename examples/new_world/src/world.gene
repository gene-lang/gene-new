# New World — the game, per docs/design.md D2.
#
# Side-view Minecraft-like. Everything here is world generation, physics,
# collision, mining, and the render walk; JavaScript owns only the canvas, the
# keyboard, and the arrays this module writes into.
#
# Two constraints from transpile.md shape the whole file:
#   - every hot value is F64, because Int lowers to bigint (§4.5) and both the
#     arithmetic and the canvas boundary would pay for it;
#   - the web profile rejects top-level `var`, so there is no module state at
#     all — the world is a flat (List F64) the host owns and passes back in.

(mod world ^profile web)


# --- tile ids (must match the atlas order in tools/gen_atlas.mjs) -----------
# The profile has no top-level constants, so these are nullary functions. V8
# inlines them; they cost nothing and they keep the ids named in one place.

(fn t_air [] : F64 0.0)
(fn t_grass [] : F64 1.0)
(fn t_dirt [] : F64 2.0)
(fn t_stone [] : F64 3.0)
(fn t_log [] : F64 4.0)
(fn t_leaves [] : F64 5.0)
(fn t_sand [] : F64 6.0)
(fn t_water [] : F64 7.0)
(fn t_coal [] : F64 8.0)
(fn t_iron [] : F64 9.0)
(fn t_gold [] : F64 10.0)
(fn t_plank [] : F64 11.0)

(fn tile_size [] : F64 16.0)
(fn sea_level [] : F64 74.0)
(fn gravity [] : F64 0.045)
(fn move_speed [] : F64 0.115)
(fn jump_speed [] : F64 0.72)
(fn reach [] : F64 5.5)

# Solid tiles stop the player. Water and leaves are passable, which is what
# makes a lake swimmable and a canopy something you can climb through.
(fn solid? [id : F64] : Bool
  (&& (> id 0.5)
      (&& (!= id (t_water)) (!= id (t_leaves)))))

# --- noise -----------------------------------------------------------------
# One hash, used at three scales. Deterministic from the seed, so a world is
# reproducible from a single number and needs no stored heightmap.

(fn frac [x : F64] : F64 (- x ($math/floor x)))

(fn hash2 [x : F64 y : F64 seed : F64] : F64
  (frac (* ($math/sin (+ (* x 127.1) (+ (* y 311.7) (* seed 74.7)))) 43758.5453)))

# Value noise: bilinear blend of four lattice corners, smoothed so the terrain
# has rolling hills rather than visible triangles.
(fn noise2 [x : F64 y : F64 seed : F64] : F64
  (var xi ($math/floor x))
  (var yi ($math/floor y))
  (var xf (- x xi))
  (var yf (- y yi))
  (var u (* (* xf xf) (- 3.0 (* 2.0 xf))))
  (var v (* (* yf yf) (- 3.0 (* 2.0 yf))))
  (var a (hash2 xi yi seed))
  (var b (hash2 (+ xi 1.0) yi seed))
  (var c (hash2 xi (+ yi 1.0) seed))
  (var d (hash2 (+ xi 1.0) (+ yi 1.0) seed))
  (+ (* (+ (* a (- 1.0 u)) (* b u)) (- 1.0 v))
     (* (+ (* c (- 1.0 u)) (* d u)) v)))

# Three octaves is enough for a readable skyline and cheap enough to run over
# the whole width at load.
(fn fbm [x : F64 y : F64 seed : F64] : F64
  (+ (* 0.5 (noise2 x y seed))
     (+ (* 0.3 (noise2 (* x 2.0) (* y 2.0) (+ seed 1.0)))
        (* 0.2 (noise2 (* x 4.0) (* y 4.0) (+ seed 2.0))))))

(fn surface_at [x : F64 seed : F64] : F64
  ($math/floor (+ (sea_level)
            (- (* 26.0 (fbm (* x 0.045) 0.0 seed)) 11.0))))

# --- world storage ---------------------------------------------------------
# Row-major: index = y * width + x. `tiles` is one flat (List F64).

(fn idx [x : F64 y : F64 w : F64] : F64 (+ x (* y w)))

(fn poke [tiles : (List F64) i : F64 v : F64] : Void
  # A `: Void` signature discards the body's value (design.md §7.7), so the
  # assignment can just be the body.
  (set! tiles/%i v))

(fn get_tile [tiles : (List F64) x : F64 y : F64 w : F64 h : F64] : F64
  # A `%` path segment takes a symbol, not a call, so the index is bound first.
  (var i (idx x y w))
  (if (|| (|| (< x 0.0) (>= x w)) (|| (< y 0.0) (>= y h)))
    (t_stone)                      # out of bounds reads as bedrock
    tiles/%i))

(fn set_tile [tiles : (List F64) x : F64 y : F64 w : F64 h : F64 v : F64] : Void
  (if_yes (&& (&& (>= x 0.0) (< x w)) (&& (>= y 0.0) (< y h)))
    (poke tiles (idx x y w) v)))

# --- generation ------------------------------------------------------------

(fn place_tree [tiles : (List F64) x : F64 ground : F64
                w : F64 h : F64 seed : F64] : Void
  (var trunk (+ 4.0 ($math/floor (* 3.0 (hash2 x 7.0 seed)))))
  (var top (- ground trunk))
  # Canopy first, so the trunk is drawn through it rather than buried by it.
  (var ly (- top 2.0))
  (while (<= ly (+ top 1.0))
    (var lx (- x 2.0))
    (while (<= lx (+ x 2.0))
      (var d (+ ($math/abs (- lx x)) ($math/abs (- ly top))))
      (if_yes (&& (< d 3.5) (> (hash2 lx ly seed) 0.18))
        (if_yes (! (solid? (get_tile tiles lx ly w h)))
          (set_tile tiles lx ly w h (t_leaves))))
      (set lx (+ lx 1.0)))
    (set ly (+ ly 1.0)))
  (var ty (- ground 1.0))
  (while (>= ty top)
    (set_tile tiles x ty w h (t_log))
    (set ty (- ty 1.0))))

(fn generate [tiles : (List F64) w : F64 h : F64 seed : F64] : Void
  (var x 0.0)
  (while (< x w)
    (var ground (surface_at x seed))
    (var beach (< ($math/abs (- ground (sea_level))) 2.5))
    (var y 0.0)
    (while (< y h)
      (var id (t_air))
      (if (< y ground)
        # Above ground: sky, or sea if this column dips below the waterline.
        (if_yes (&& (>= y (sea_level)) (> ground (sea_level)))
          (set id (t_water)))
        (if (< y (+ ground 1.0))
          (set id (if beach (t_sand) (t_grass)))
          (if (< y (+ ground 5.0))
            (set id (if beach (t_sand) (t_dirt)))
            (set id (t_stone)))))
      # Caves, cut only below the soil so the surface stays walkable.
      (if_yes (&& (> y (+ ground 4.0)) (< y (- h 3.0)))
        (if_yes (> (fbm (* x 0.09) (* y 0.09) (+ seed 40.0)) 0.62)
          (set id (t_air))))
      # Ores, banded by depth so digging deeper is worth doing.
      (if_yes (== id (t_stone))
        (do
          (var depth (- y ground))
          (var o (hash2 x y (+ seed 90.0)))
          (if_yes (&& (> depth 6.0) (> o 0.982)) (set id (t_coal)))
          (if_yes (&& (> depth 24.0) (&& (> o 0.968) (< o 0.982))) (set id (t_iron)))
          (if_yes (&& (> depth 52.0) (&& (> o 0.9915) (< o 0.9962))) (set id (t_gold)))))
      (poke tiles (idx x y w) id)
      (set y (+ y 1.0)))
    (set x (+ x 1.0)))
  # Trees on a second pass, so a canopy can overhang a neighbouring column.
  (set x 3.0)
  (while (< x (- w 3.0))
    (var ground (surface_at x seed))
    (if_yes (&& (<= ground (sea_level))
                (> (hash2 x 3.0 (+ seed 11.0)) 0.88))
      (place_tree tiles x ground w h seed))
    (set x (+ x 1.0))))

# --- player ----------------------------------------------------------------
# State is a (List F64) the host owns: 0 x, 1 y, 2 vx, 3 vy, 4 on_ground,
# 5 facing. Positions are in tiles, not pixels, so collision is grid-local.

(fn p_width [] : F64 0.6)
(fn p_height [] : F64 1.8)

# Does the player box at (px, py) overlap any solid tile?
(fn blocked? [tiles : (List F64) px : F64 py : F64 w : F64 h : F64] : Bool
  (var x0 ($math/floor (- px (/ (p_width) 2.0))))
  (var x1 ($math/floor (+ px (/ (p_width) 2.0))))
  (var y0 ($math/floor py))
  (var y1 ($math/floor (+ py (- (p_height) 0.02))))
  (var hit false)
  (var ty y0)
  (while (<= ty y1)
    (var tx x0)
    (while (<= tx x1)
      (if_yes (solid? (get_tile tiles tx ty w h)) (set hit true))
      (set tx (+ tx 1.0)))
    (set ty (+ ty 1.0)))
  hit)

(fn step_player [tiles : (List F64) p : (List F64)
                 left : F64 right : F64 jump : F64
                 w : F64 h : F64 dt : F64] : Void
  (var px p/0)
  (var py p/1)
  (var vx p/2)
  (var vy p/3)
  (var grounded p/4)
  (var facing p/5)

  (set vx 0.0)
  (if_yes (> left 0.5) (do (set vx (- 0.0 (move_speed))) (set facing -1.0)))
  (if_yes (> right 0.5) (do (set vx (move_speed)) (set facing 1.0)))
  (if_yes (&& (> jump 0.5) (> grounded 0.5)) (set vy (- 0.0 (jump_speed))))

  (set vy (+ vy (* (gravity) dt)))
  (if_yes (> vy 1.2) (set vy 1.2))

  # Axis-separated resolution: move x, undo if it hit; then the same for y.
  # Sub-stepping keeps a fast fall from tunnelling through a one-tile floor.
  (var steps (+ 1.0 ($math/floor (* ($math/abs vy) 2.0))))
  (var s 0.0)
  (while (< s steps)
    (var nx (+ px (* (/ (* vx dt) steps) 1.0)))
    (if (blocked? tiles nx py w h) (set vx 0.0) (set px nx))
    (var ny (+ py (/ (* vy dt) steps)))
    (if (blocked? tiles px ny w h)
      (do
        (if_yes (> vy 0.0) (set grounded 1.0))
        (set vy 0.0))
      (do
        (set py ny)
        (set grounded 0.0)))
    (set s (+ s 1.0)))

  # Standing check, so walking off a ledge starts a fall immediately.
  (if_yes (! (blocked? tiles px (+ py 0.06) w h)) (set grounded 0.0))

  (if_yes (< px 1.0) (set px 1.0))
  (if_yes (> px (- w 1.0)) (set px (- w 1.0)))

  (poke p 0.0 px)
  (poke p 1.0 py)
  (poke p 2.0 vx)
  (poke p 3.0 vy)
  (poke p 4.0 grounded)
  (poke p 5.0 facing))

# --- interaction -----------------------------------------------------------

(fn in_reach? [p : (List F64) tx : F64 ty : F64] : Bool
  (var dx (- (+ tx 0.5) p/0))
  (var dy (- (+ ty 0.5) (+ p/1 (/ (p_height) 2.0))))
  (< (+ (* dx dx) (* dy dy)) (* (reach) (reach))))

# Returns the mined tile id, or 0 when nothing was mined. The host adds it to
# the inventory, so this stays a pure grid operation.
(fn mine [tiles : (List F64) p : (List F64)
          tx : F64 ty : F64 w : F64 h : F64] : F64
  (var id (get_tile tiles tx ty w h))
  (if (&& (in_reach? p tx ty) (&& (> id 0.5) (!= id (t_water))))
    (do (set_tile tiles tx ty w h (t_air)) id)
    0.0))

# Returns 1.0 when the block was placed. Refuses to place inside the player,
# which is the classic way to seal yourself into a wall.
(fn place [tiles : (List F64) p : (List F64)
           tx : F64 ty : F64 id : F64 w : F64 h : F64] : F64
  (var target (get_tile tiles tx ty w h))
  (if (&& (in_reach? p tx ty)
          (&& (|| (< target 0.5) (== target (t_water)))
              (! (&& (== ($math/floor p/0) tx)
                     (|| (== ($math/floor p/1) ty)
                         (== ($math/floor (+ p/1 1.0)) ty))))))
    (do (set_tile tiles tx ty w h id) 1.0)
    0.0))
