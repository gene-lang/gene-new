# Typed-native SQLite row reader.
#
# Compiled with `gene compile --target c`, every function below becomes a plain
# C function taking an unboxed `sqlite3_stmt *` in a register. No GeneValue, no
# boxing, no runtime message resolution — the calls into SQLite are direct.
#
# See README.md for what the current typed_native subset does and does not
# allow; the shape of this module is dictated by those limits.

# SQLite's handles are opaque: no public layout, so no declared fields. The
# ffi/struct exists to give the pointer a name and a stable ABI identity.
(ffi/struct sqlite3_stmt ^fields [])

# The nominal Gene Type whose typed-native representation is `sqlite3_stmt *`.
# ^lifecycle manual: SQLite owns the statement, Gene never frees it.
(type Stmt ^native {^abi sqlite3_stmt ^lifecycle manual})

# Bound straight to libsqlite3 — these take only the statement pointer, so
# their real signatures are expressible as-is.
(ffi/fn sqlite3_step
  ^library libsqlite3
  ^symbol "sqlite3_step"
  [stmt : Stmt] : C/Int)

(ffi/fn sqlite3_reset
  ^library libsqlite3
  ^symbol "sqlite3_reset"
  [stmt : Stmt] : C/Int)

(ffi/fn sqlite3_column_count
  ^library libsqlite3
  ^symbol "sqlite3_column_count"
  [stmt : Stmt] : C/Int)

# Bound straight to libsqlite3 as well. The column index is declared `I32`, so
# it matches sqlite3_column_int64's `int` exactly — no widening shim. `I32` is
# a boundary representation: it crosses edges and widens into `I64` to be
# computed with, but arithmetic never produces one, because C would wrap where
# Gene's range-checked `I32` errors.
(ffi/fn sqlite3_column_int64
  ^library libsqlite3
  ^symbol "sqlite3_column_int64"
  [stmt : Stmt column : C/Int] : C/Int64)

# The typed-native surface the C harness calls. Each lowers to a direct call
# with the statement pointer passed in a register.

(fn step_row [stmt : Stmt] : I64
  (sqlite3_step stmt))

(fn reset_stmt [stmt : Stmt] : I64
  (sqlite3_reset stmt))

(fn column_count [stmt : Stmt] : I64
  (sqlite3_column_count stmt))

(fn column_i64 [stmt : Stmt column : I32] : I64
  (sqlite3_column_int64 stmt column))

# A typed-native function calling another typed-native function: `read_first`
# is lowered to a direct C call to `gene_native_column_i64`, not a dispatch.
(fn read_first [stmt : Stmt first_column : I32] : I64
  (do
    (let value : I64 (column_i64 stmt first_column))
    value))

# Per-row work, compiled: two direct SQLite calls and the multiply all lower
# into one C function with no boxing.
(fn row_total [stmt : Stmt amount_column : I32 quantity_column : I32] : I64
  (* (column_i64 stmt amount_column) (column_i64 stmt quantity_column)))

# Conditionals lower to a C ternary.
(fn row_total_capped [stmt : Stmt amount_column : I32 quantity_column : I32
                      cap : I64] : I64
  (if (< (row_total stmt amount_column quantity_column) cap)
    (row_total stmt amount_column quantity_column)
    cap))

# The whole scan, compiled: `while` and block-scoped locals keep the loop in
# Gene, so stepping, both column reads, the multiply and the accumulate all
# lower into one C function. `main.c` calls this once instead of driving the
# loop itself.
(fn scan_total [stmt : Stmt amount_column : I32 quantity_column : I32
                row_marker : I64] : I64
  (do
    (var total : I64 0)
    (while (= (step_row stmt) row_marker)
      (set total (+ total (row_total stmt amount_column quantity_column))))
    total))
