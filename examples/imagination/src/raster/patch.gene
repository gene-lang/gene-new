(mod imagination_raster_patch)
(import [reject kind_of child_named sorted_keys str? node?] ^from "../types")
(import [read_envelope read_locks require_props] ^from "../patch")
(import [canonical digest_of] ^from "../scene")
(import [normalize_program registry media_id] ^from "./schema")
(import [index_program replace resource_ids diff_programs] ^from "./program")
(import [expand_region] ^from "./generate")

(fn entry_of [program, id]
  (if_not (str? id) (reject "missing_field" "operation needs a target/destination ID"))
  (let entry ((index_program program) .get id))
  (if ($absent? entry) (reject "unknown_target" $"no painting object ${id}" ^target id))
  entry)

(fn splice [program, parent : Str, value, operation]
  (let entry (entry_of program parent))
  (let body ($body entry/node))
  (var anchors 0)
  (for name in ["before" "after" "position"]
    (if ($has_key? ($props operation) name) (set anchors (+ anchors 1))))
  (if (!= anchors 1) (reject "invalid_placement" "use exactly one ^before, ^after, or ^position start/end"))
  (var position nil)
  (if_not ($absent? operation/position)
    (if (== operation/position "start") (then (set position (if (== parent "painting") 1 0)))
      (elif (== operation/position "end") (set position body/.size))
      (else (reject "invalid_placement" "position must be start or end"))))
  (var i 0)
  (for child in body
    (if (&& (! ($absent? operation/before)) (== child/id operation/before)) (set position i))
    (if (&& (! ($absent? operation/after)) (== child/id operation/after)) (set position (+ i 1)))
    (set i (+ i 1)))
  (if ($absent? position) (reject "stale_anchor" "placement anchor is not in the destination list"))
  (let children [])
  (set i 0)
  (for child in body
    (if (== i position) (children .push value))
    (children .push child) (set i (+ i 1)))
  (if (== position body/.size) (children .push value))
  (replace program parent ($node/rebuild entry/node ^body children)))

(fn enforce_locks [before, after, policy]
  (let left (index_program before)) (let right (index_program after))
  (for lock in (read_locks policy)
    (let a (left .get lock/target)) (let b (right .get lock/target))
    (if_not ($absent? a)
      (if (|| ($absent? b) (!= a/kind b/kind) (!= a/parent b/parent) (!= a/position b/position))
        (reject "locked" $"${lock/target} identity or placement is locked" ^target lock/target))
      (if (!= lock/scope "identity")
        (then
          # Conservative v1: field scopes protect the entire selected object,
          # plus ancestor compositing and resource closure. No indirect edits
          # can bypass a lock; finer independence can be added later.
          (if (!= (canonical a/node) (canonical b/node))
            (reject "locked" $"${lock/target} is locked" ^target lock/target))
          (for id in (resource_ids a/node)
            (let old (left .get id)) (let new (right .get id))
            (if (|| ($absent? new) (!= (canonical old/node) (canonical new/node)))
              (reject "locked_dependency" $"${id} is used by locked ${lock/target}" ^target id)))
          (var parent a/parent)
          (while (! ($absent? parent))
            (let old (left .get parent)) (let new (right .get parent))
            (if (|| ($absent? new) (!= old/position new/position) (!= (canonical ($node/rebuild old/node ^body []))
                                      (canonical ($node/rebuild new/node ^body []))))
              (reject "locked_dependency" $"ancestor ${parent} affects locked ${lock/target}"))
            (for id in (resource_ids ($node/rebuild old/node ^body []))
              (let old_resource (left .get id)) (let new_resource (right .get id))
              (if (|| ($absent? new_resource) (!= (canonical old_resource/node) (canonical new_resource/node)))
                (reject "locked_dependency" $"ancestor mask ${id} affects locked ${lock/target}")))
            (set parent old/parent))))))
  nil)

(fn apply_program_patch [program, patch, ^expected_base expected_base = nil,
  ^expected_goal expected_goal = nil, ^prefix prefix : Str = "", ^taken taken = nil,
  ^policy policy = nil, ^replay replay = false, ^reference_loader reference_loader = nil]
  (let props ($thaw ($freeze ($props patch))))
  (let patch_media (props .get "media"))
  (if (&& (! ($absent? patch_media)) (!= patch_media program/schema)) (reject "wrong_media" "patch belongs to another medium"))
  (let envelope_props {})
  (for [key value] in props (if (!= ($to_str key) "media") (envelope_props .put ($to_str key) value)))
  (let envelope (read_envelope ($node/rebuild patch ^props envelope_props)))
  (if (&& (! ($absent? expected_base)) (!= envelope/base expected_base)) (reject "stale_base" "patch base is not the working revision"))
  (if (&& (! ($absent? expected_goal)) (!= envelope/goal expected_goal)) (reject "stale_goal" "patch goal changed"))
  (var draft program)
  (let original (index_program program)) (let allocated {})
  (let effects [])
  (let expanded [])
  (fn add_ids [node]
    (if_not ($absent? node/id)
      (if (|| ($has_key? original node/id) ($has_key? allocated node/id)
              (&& (! ($absent? taken)) (taken node/id)))
        (reject "duplicate_id" $"identity ${node/id} was already used"))
      (if (&& (! replay) (! ($str/starts_with? node/id prefix)))
        (reject "invalid_id" $"new IDs must start with ${prefix}"))
      (allocated .put node/id true)
      (let id node/id) (effects .push `(effect ^kind "insert" ^target %id)))
    (for child in ($body node) (if (node? child) (add_ids child))))
  (var index 0)
  (for proposed in envelope/operations
    (if (&& replay (== (kind_of proposed) "paint_region")) (reject "invalid_patch" "exact replay requires saved expanded strokes"))
    (let operation (if (== (kind_of proposed) "paint_region")
      (expand_region draft proposed ^reference_loader reference_loader) proposed))
    (expanded .push operation)
    (let kind (kind_of operation))
    (let body ($body operation))
    (if (["insert_layer" "insert_operation" "add_resource"] .contains? kind)
      (then
        (require_props operation (if (== kind "insert_operation")
          ["layer" "before?" "after?" "position?"] ["before?" "after?" "position?"]) index)
        (if (!= body/.size 1) (reject "invalid_operation" "insertion requires one new object"))
        (let parent (if (== kind "insert_layer") "painting" (if (== kind "add_resource") "resources" operation/layer)))
        (if (&& (== kind "insert_operation") (!= (/kind (entry_of draft parent)) "layer"))
          (reject "invalid_parent" "operations are inserted into a layer"))
        (add_ids body/0)
        (set draft (splice draft parent body/0 operation)))
      (elif (["remove_layer" "remove_operation" "remove_resource"] .contains? kind)
        (require_props operation ["target"] index)
        (if (!= body/.size 0) (reject "invalid_operation" "remove takes no children"))
        (let entry (entry_of draft operation/target))
        (if (|| (&& (== kind "remove_layer") (!= entry/kind "layer"))
                (&& (== kind "remove_resource") (!= entry/parent "resources"))
                (&& (== kind "remove_operation") (! (["fill_path" "fill_mask" "stroke" "erase"] .contains? entry/kind))))
          (reject "wrong_kind" "remove target has wrong kind"))
        (set draft (replace draft operation/target nil)))
      (elif (["replace_operation" "replace_resource"] .contains? kind)
        (require_props operation ["target"] index)
        (let entry (entry_of draft operation/target))
        (if (|| (!= body/.size 1) (!= body/0/id entry/id) (!= (kind_of body/0) entry/kind)
                (!= (== kind "replace_resource") (== entry/parent "resources"))
                (== entry/kind "layer") (== entry/kind "painting") (== entry/kind "resources"))
          (reject "identity_changed" "replacement preserves resource/operation ID and kind"))
        (set draft (replace draft entry/id body/0)))
      (elif (["set_layer" "set_operation"] .contains? kind)
        (let entry (entry_of draft operation/target))
        (if (|| (!= body/.size 0) (!= (== kind "set_layer") (== entry/kind "layer"))
                (! (["layer" "fill_path" "fill_mask" "stroke" "erase"] .contains? entry/kind)))
          (reject "wrong_kind" "set target has wrong kind or unexpected children"))
        (let fields ($thaw ($freeze ($props entry/node))))
        (for [key value] in ($props operation)
          (let name ($to_str key))
          (if_yes (!= name "target")
            (if (|| (== name "id") (! ($has_key? (registry .get entry/kind) name)))
              (reject "unknown_field" $"cannot set ^${name} on ${entry/kind}"))
            (fields .put name value)))
        (set draft (replace draft entry/id ($node/rebuild entry/node ^props fields))))
      (elif (== kind "set_points")
        (require_props operation ["target"] index)
        (let entry (entry_of draft operation/target))
        (if_not (["stroke" "erase"] .contains? entry/kind) (reject "wrong_kind" "only strokes/erasers have points"))
        (set draft (replace draft entry/id ($node/rebuild entry/node ^body [`(points %body...)]))))
      (elif (["move_layer" "move_operation"] .contains? kind)
        (require_props operation (if (== kind "move_layer") ["target" "before?" "after?" "position?"]
          ["target" "layer" "before?" "after?" "position?"]) index)
        (if (!= body/.size 0) (reject "invalid_operation" "move takes no children"))
        (let entry (entry_of draft operation/target))
        (if (!= (== kind "move_layer") (== entry/kind "layer")) (reject "wrong_kind" "move target has wrong kind"))
        (let parent (if (== kind "move_layer") "painting" operation/layer))
        (if (&& (== kind "move_operation") (!= (/kind (entry_of draft parent)) "layer"))
          (reject "invalid_parent" "operations move to a layer"))
        (set draft (splice (replace draft entry/id nil) parent entry/node operation)))
      (else (reject "unknown_operation" $"unsupported raster edit ${kind}" ^index index)))
    (set index (+ index 1)))
  (let value (normalize_program draft))
  (enforce_locks program value policy)
  (let diff (diff_programs program value))
  (for change in ($body diff)
    (if_not (== (kind_of change) "added")
      (let kind (kind_of change))
      (let target (?? change/id change/parent))
      (effects .push `(effect ^kind %kind ^target %target))))
  (let digest (digest_of (canonical value)))
  (let intent (child_named patch "intent"))
  (let normalized ($freeze ($node/rebuild patch ^body [intent expanded...])))
  {^scene value ^digest digest ^patch ($freeze patch) ^normalized normalized
   ^effects effects ^diff diff ^changed (!= (canonical program) (canonical value))
   ^noop (== (canonical program) (canonical value))})

(fn replay_program_patch [program, patch, ^policy policy = nil]
  (apply_program_patch program patch ^expected_base patch/base ^policy policy ^^replay))
