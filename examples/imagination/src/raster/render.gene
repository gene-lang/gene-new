(mod imagination_raster_render)
(import [worker_profile worker_render RasterError dependencies checked] ^from "." ^pkg "raster")
(import [RenderError reject kind_of child_named list? int?] ^from "../types")
(import [finite?] ^from "../scene_schema")
(import [canonical digest_of] ^from "../scene")
(import [artifact_node profile_fingerprint png_size] ^from "../render")
(import [normalize_program] ^from "./schema")
(const profile_id "raster-cairo-linear/v1")

(fn open_raster_profile [^version version = 1]
  (try
    (let native (worker_profile ^version version))
    (let id (if (== version 2) "raster-cairo-linear/v2" profile_id))
    (if_not ($str/starts_with? native/version id) (reject "profile_mismatch" "wrong raster worker version"))
    {^id id ^version version ^native native ^edge 2048 ^stage_ms 25000 ^pipeline_ms 25000}
  catch RasterError
    (fail (RenderError ^code "raster_dependency" ^stage "raster_profile" ^message $err/message ^detail nil))))

(fn raster_profile_manifest [profile]
  (let native profile/native)
  (let version native/version)
  (let system native/system)
  (let executable native/worker_digest)
  (let libraries native/dependencies)
  (let id profile/id)
  (let schema (if (== profile/version 2) "raster-painting/v2" "raster-painting/v1"))
  (let brush (if (== profile/version 2) "round-dab/v1+bristle-hash32/v1" "round-dab/v1"))
  (let manifest `(render_profile ^schema 1 ^id %id ^worker %executable ^native %version
    ^system %system ^libraries %libraries ^schema_version %schema
    ^brush %brush ^geometry "cairo-a8-gray-tolerance-0.1-nonzero"
    ^working "linear-srgb-premultiplied-float32" ^encoding "straight-rgba8-srgb-half-up"
    ^png "compression6-sub-sRGB-relative-no-metadata" ^thumbnail "nearest-center-max256"))
  (let props ($thaw ($freeze ($props manifest))))
  (props .put "fingerprint" (profile_fingerprint manifest))
  ($node/rebuild manifest ^props props))

(fn color_numbers [color]
  (let bytes ($binary/from_str color))
  (fn digit [index]
    (let byte ($binary/get bytes index))
    (if (<= byte 57) (- byte 48) (- byte 87)))
  (let result [])
  (var i 1)
  (while (< i 9)
    (let hi (digit i))
    (let lo (digit (+ i 1)))
    (result .push (+ (* hi 16) lo))
    (set i (+ i 2)))
  result)

# Versioned numeric wire format. No strings, paths, executable forms, shaders
# or callbacks reach the worker. Resource references become bounded indexes.
(fn render_request [program, directory : Str, assets]
  (let tokens [(if (== program/schema "raster-painting/v2") 2 1) program/width program/height])
  (fn emit [values] (for v in values (tokens .push v)))
  (fn color [value] (emit (color_numbers value)))
  (color program/background)
  (let resources {})
  (let masks {})
  (let definitions ($body (child_named program "resources")))
  (for item in definitions
    (resources .put item/id item)
    (if (== (kind_of item) "mask") (masks .put item/id ($size masks))))
  (tokens .push ($size masks))
  (fn emit_path [node]
    (tokens .push ($size ($body node)))
    (for command in ($body node)
      (tokens .push ({^M 0 ^L 1 ^C 2 ^Q 3 ^Z 4} .get (kind_of command)))
      (emit ($body command))))
  (let asset_digests [])
  (for item in definitions
    (if_yes (== (kind_of item) "reference")
      (asset_digests .push item/asset)
      (asset_digests .push item/source))
    (if_yes (== (kind_of item) "mask")
      (if (== item/kind "path")
        (then (tokens .push 0) (emit_path (child_named item "path")))
        (else
          (emit [1 item/width item/height]) (emit item/origin)
          (let bytes (if ($absent? assets) nil (assets item/asset)))
          (if (|| ($absent? bytes) (!= (digest_of bytes) item/asset)
                  (!= ($binary/size bytes) (* item/width item/height)))
            (reject "invalid_asset" $"missing or changed raw grayscale mask ${item/asset}"))
          ($fs/write_bytes ($path/join directory $"asset-${(masks .get item/id)}.raw") bytes)
          (asset_digests .push item/asset)))))
  (fn mask_ref [node] (if ($absent? node/mask) -1 (masks .get node/mask)))
  (fn paint [node]
    (if_not ($absent? node/color)
      (tokens .push 0) (color node/color) (return nil))
    (let gradient (resources .get node/paint))
    (if (== gradient/kind "linear")
      (then (tokens .push 1) (emit gradient/from) (emit gradient/to))
      (else (tokens .push 2) (emit gradient/center) (emit [gradient/radius 0])))
    (tokens .push ($size ($body gradient)))
    (for stop in ($body gradient) (tokens .push stop/offset) (color stop/color)))
  (let layers ($drop ($body program) 1))
  (tokens .push layers/.size)
  (for layer in layers
    (emit [(if layer/visible 1 0) layer/opacity (mask_ref layer) ($size ($body layer))])
    (for operation in ($body layer)
      (let kind (kind_of operation))
      (if (["stroke" "erase"] .contains? kind)
        (then
          (let brush (resources .get operation/brush))
          (emit [(if (== kind "stroke") 2 3) (if (== brush/kind "bristle/v1") 2 (if (== brush/kind "hard-round/v1") 0 1))
            brush/hardness brush/spacing brush/flow brush/min_radius_ratio operation/radius operation/opacity])
          (color (if (== kind "erase") "#ffffffff" operation/color))
          (emit [(mask_ref operation) operation/seed])
          (if (== brush/kind "bristle/v1") (emit [brush/aspect brush/angle brush/texture brush/bristles]))
          (let points ($body (child_named operation "points")))
          (tokens .push points/.size)
          (for point in points (emit point)))
        (else
          (if (== kind "fill_path")
            (then (tokens .push 0) (emit_path (child_named operation "path")))
            (else (emit [1 (mask_ref operation)])))
          (paint operation)
          # fill_mask's mask is its geometry and must be applied exactly once.
          (emit [operation/opacity (if (== kind "fill_mask") -1 (mask_ref operation))])))))
  {^text ($str/join ($map tokens $to_str) " ") ^assets asset_digests})

(fn render_program [profile, painting, directory : Str, ^assets assets = nil]
  (let program (normalize_program painting))
  (if (!= (== program/schema "raster-painting/v2") (== profile/version 2))
    (reject "profile_mismatch" "painting schema and renderer version disagree"))
  (let request (render_request program directory assets))
  (try
    (if (!= (dependencies profile/native/worker) profile/native/dependencies)
      (fail (RasterError ^message "Raster libraries changed since profile admission.")))
    (worker_render profile/native request/text directory)
  catch RasterError
    (fail (RenderError ^code "raster_failed" ^stage "raster" ^message $err/message ^detail nil)))
  (let png_path ($path/join directory "observation.png"))
  (let size (png_size ($fs/read_bytes png_path)))
  (if (!= size [program/width program/height]) (reject "invalid_render" "worker returned wrong dimensions"))
  (let pixels ($fs/read_bytes ($path/join directory "pixels.rgba")))
  (if (!= ($binary/size pixels) (* size/0 size/1 4)) (reject "invalid_render" "worker returned wrong pixel count"))
  # Version/color tag + decimal dimensions + raw RGBA8, with no row padding.
  (let header ($binary/from_str $"raster-pixels/v1\nsrgb-rgba8\n${size/0} ${size/1}\n"))
  (let pixel_digest (digest_of ($binary/concat [header pixels])))
  (let scene (digest_of (canonical program)))
  (let fingerprint (profile_fingerprint (raster_profile_manifest profile)))
  (let thumb_path ($path/join directory "thumbnail.png"))
  (let thumb_size (png_size ($fs/read_bytes thumb_path)))
  (let artifacts [(artifact_node "observation.png" png_path {^width size/0 ^height size/1})
    (artifact_node "thumbnail.png" thumb_path {^width thumb_size/0 ^height thumb_size/1 ^source "observation.png"})])
  (let asset_digests request/assets)
  (let id profile/id)
  (let manifest `(render_manifest ^schema 1 ^profile %id ^profile_fingerprint %fingerprint
    ^scene %scene ^program %scene ^pixel %pixel_digest ^assets %asset_digests ^canvas %size ^output %size
    ^color "straight RGBA8 sRGB" ^matte nil ^full_repaint true %artifacts...))
  (let text (canonical manifest))
  ($fs/write_text ($path/join directory "manifest.gene") text)
  {^digest (digest_of text) ^dir directory ^manifest manifest ^scene_digest scene ^pixel_digest pixel_digest
   ^png_digest artifacts/0/digest ^thumbnail_digest artifacts/1/digest ^width size/0 ^height size/1})

(fn raster_crop [profile, program, source : Str, out : Str, rect, ^zoom zoom = 2]
  (if_not (&& (list? rect) (== rect/.size 4) (int? zoom)) (reject "invalid_crop" "crop needs a rectangle and integer zoom"))
  (for number in rect (if_not (finite? number) (reject "invalid_crop" "crop coordinates must be finite")))
  (if (|| (<= rect/2 0) (<= rect/3 0)) (reject "invalid_crop" "crop dimensions must be positive"))
  (let x ($math/max 0 ($to_int ($math/floor rect/0))))
  (let y ($math/max 0 ($to_int ($math/floor rect/1))))
  (let width (- ($math/min program/width ($to_int ($math/ceil (+ rect/0 rect/2)))) x))
  (let height (- ($math/min program/height ($to_int ($math/ceil (+ rect/1 rect/3)))) y))
  (if (|| (< width 1) (< height 1) (< zoom 1) (> zoom 4)) (reject "invalid_crop" "crop is outside canvas or zoom limits"))
  (let dir $"${out}-work")
  ($fs/make_dir dir)
  (let source_bytes ($fs/read_bytes source))
  (try
    (if (|| (!= profile/native/worker_digest ($crypto/sha256 ($fs/read_bytes profile/native/worker)))
            (!= profile/native/dependencies (dependencies profile/native/worker)))
      (reject "profile_mismatch" "raster worker or libraries changed before crop"))
    ($fs/write_bytes ($path/join dir "source.png") source_bytes)
    ($fs/write_text ($path/join dir "request.txt") ($str/join ($map [x y width height zoom] $to_str) " "))
    (checked profile/native/worker ["--crop"] ^dir dir)
    (let bytes ($fs/read_bytes ($path/join dir "crop.png")))
    ($fs/write_bytes $"${out}.png" bytes)
    {^digest (digest_of bytes) ^width (* width zoom) ^height (* height zoom) ^rectangle rect
     ^source (digest_of source_bytes) ^pixel_rect [x y width height] ^resize "nearest-center"
     ^page [program/width program/height] ^pixel_origin [x y] ^profile profile/id}
  ensure
    (for name in ["source.png" "request.txt" "crop.png"] ($fs/remove ($path/join dir name)))
    ($fs/remove_dir dir)))
