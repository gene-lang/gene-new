(patch ^schema 1 ^id "landscape-02" ^base "r001" ^goal "goal-01"
  (intent "Add the river winding from the horizon to the foreground.")
  (add ^parent "defs" ^placement (last)
    (linear_gradient ^id "p2-water" ^x1 0 ^y1 620 ^x2 0 ^y2 1024
      (stop ^id "p2-water-far" ^offset 0 ^color "#f6c98a")
      (stop ^id "p2-water-near" ^offset 1 ^color "#3b82c4")))
  (add ^parent "scene" ^placement (last)
    (path ^id "p2-river" ^label "River" ^role "subject" ^fill_ref "p2-water"
      (M 640 622) (C 560 700 760 760 620 840) (C 500 910 380 960 300 1024)
      (L 620 1024) (C 660 960 800 900 860 840) (C 940 760 700 700 700 622) (Z)))
  (add ^parent "scene" ^placement (last)
    (path ^id "p2-river-glint" ^fill "none" ^stroke "#fff3c4" ^stroke_width 6
      ^stroke_linecap "round" ^opacity 0.7
      (M 660 660) (Q 640 720 700 760)))
  (move ^target "p1-sun" ^delta [-40 -30]))
