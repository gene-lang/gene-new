(patch ^base "r000" ^goal "goal-01" ^id "patch-1" ^schema 1 (intent "Lay down the sky, the setting sun, the ground, and the river as the base composition.") (add ^parent "defs" ^placement (last) (linear_gradient ^id "n1-sky-grad" ^x1 0 ^x2 0 ^y1 0 ^y2 600 (stop ^color "#3b1f5c" ^id "n1-sky-s1" ^offset 0) (stop ^color "#a8457a" ^id "n1-sky-s2" ^offset 0.5) (stop ^color "#f28a3c" ^id "n1-sky-s3" ^offset 0.85) (stop ^color "#ffc46b" ^id "n1-sky-s4" ^offset 1))) (add ^parent "defs" ^placement (last) (linear_gradient ^id "n1-river-grad" ^x1 0 ^x2 0 ^y1 600 ^y2 1024 (stop ^color "#e9a06a" ^id "n1-river-s1" ^offset 0) (stop ^color "#3d4f8a" ^id "n1-river-s2" ^offset 1))) (add ^parent "scene" ^placement (last) (g ^id "n1-sky" ^label "sky" ^role "background" (rect ^fill_ref "n1-sky-grad" ^height 620 ^id "n1-sky-rect" ^width 1024 ^x 0 ^y 0))) (add ^parent "scene" ^placement (last) (g ^id "n1-sun" ^label "setting sun" ^role "subject" ^translate [720 590] (circle ^cx 0 ^cy 0 ^fill "#ffb35c" ^fill_opacity 0.35 ^id "n1-sun-glow" ^r 120) (circle ^cx 0 ^cy 0 ^fill "#ffdf7a" ^id "n1-sun-disc" ^r 70))) (add ^parent "scene" ^placement (last) (g ^id "n1-ground" ^label "ground" ^role "terrain" (path ^fill "#5a3d5e" ^id "n1-hills-far" (M 0 600) (C 200 560 380 590 520 600) (C 700 615 860 570 1024 595) (L 1024 640) (L 0 640) (Z)) (rect ^fill "#3e4a2e" ^height 409 ^id "n1-ground-rect" ^width 1024 ^x 0 ^y 615))) (add ^parent "scene" ^placement (last) (g ^id "n1-river" ^label "river" ^role "subject" (path ^fill_ref "n1-river-grad" ^id "n1-river-body" (M 600 615) (C 640 640 700 670 640 720) (C 560 790 480 840 560 920) (C 600 970 620 1000 640 1024) (L 380 1024) (C 340 960 330 900 400 830) (C 480 760 560 720 560 680) (C 560 650 570 630 580 615) (Z)))))