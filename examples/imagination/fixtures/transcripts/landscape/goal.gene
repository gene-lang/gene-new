(goal ^id "goal-01" ^request "A landscape with one tree, a river, and a setting sun." (requirement ^check "visual" ^id "landscape" ^strength "hard" "The picture shows an outdoor landscape scene with visible ground and sky.") (requirement ^check "visual" ^id "one-tree" ^strength "hard" "Exactly one tree appears in the landscape.") (requirement ^check "visual" ^id "river" ^strength "hard" "A river is visible flowing through the landscape.") (requirement ^check "visual" ^id "setting-sun" ^strength "hard" "A sun is shown low near the horizon, reading as setting.") (requirement ^check "visual" ^id "balance" ^strength "soft" "The tree, river, and sun are arranged so that each is clearly distinguishable and the composition feels balanced.") (requirement ^check "visual" ^id "evening-mood" ^strength "soft" "The scene conveys a calm evening mood.") (preference ^source "agent_interpretation" "Use a warm orange-to-purple sky gradient to emphasize the sunset.") (preference ^source "agent_interpretation" "Show the sun's reflection as a shimmer on the river surface.") (preference ^source "agent_interpretation" "Place the tree on one bank of the river, off-center, with the sun on the opposite side.") (requirement ^check "structural" ^id "medium" ^strength "hard" "All visible content uses the supported SVG subset."))