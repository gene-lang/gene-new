(goal ^id "goal-01" ^request "A stylized cat beside a rainy city window." (requirement ^check "visual" ^id "cat-present" ^strength "hard" "Exactly one cat is shown, drawn in a stylized rather than photorealistic manner.") (requirement ^check "visual" ^id "window-present" ^strength "hard" "A window is clearly visible in the picture.") (requirement ^check "visual" ^id "cat-beside-window" ^strength "hard" "The cat is positioned next to the window, close enough that the two read as together.") (requirement ^check "visual" ^id "rain-visible" ^strength "hard" "Rain is visible at the window, such as falling streaks or drops on the glass.") (requirement ^check "visual" ^id "city-view" ^strength "hard" "A city scene, such as building silhouettes or a skyline, is visible through the window.") (requirement ^check "visual" ^id "cozy-mood" ^strength "soft" "The picture conveys a calm, quiet, slightly cozy mood that contrasts the indoor space with the wet weather outside.") (requirement ^check "visual" ^id "clear-silhouette" ^strength "soft" "The cat's shape stands out clearly against the window and background, with balanced composition.") (preference ^source "agent_interpretation" "Seat the cat on the windowsill, facing or gazing out toward the city.") (preference ^source "agent_interpretation" "Use a cool blue-gray palette outside the window and warm tones for the interior and cat.") (preference ^source "agent_interpretation" "Add a few lit windows in the distant buildings to suggest dusk or evening.") (requirement ^check "structural" ^id "medium" ^strength "hard" "All visible content uses the supported SVG subset."))