(patch ^base "r000" ^goal "goal-01" ^id "patch-1" ^schema 1 (intent "Establish the poster composition: portrait format, dark background, prominent pale headline, city skyline.") (set_canvas ^field "width" ^value 768) (set_canvas ^field "view_box" ^value [0 0 768 1024]) (set_canvas ^field "background" ^value "#1b2533") (add ^parent "defs" ^placement (last) (linear_gradient ^id "n1-sky-grad" ^x1 0 ^x2 0 ^y1 0 ^y2 1024 (stop ^color "#0f1724" ^id "n1-sky-s0" ^offset 0) (stop ^color "#2a3d55" ^id "n1-sky-s1" ^offset 0.55) (stop ^color "#4a5f78" ^id "n1-sky-s2" ^offset 1))) (add ^parent "scene" ^placement (last) (g ^id "n1-bg" ^label "sky background" ^role "background" (rect ^fill_ref "n1-sky-grad" ^height 1024 ^id "n1-bg-rect" ^width 768 ^x 0 ^y 0))) (add ^parent "scene" ^placement (last) (g ^id "n1-skyline" ^label "city skyline" ^role "imagery" ^translate [0 1024] (rect ^fill "#121a26" ^height 300 ^id "n1-b1" ^width 90 ^x 0 ^y -300) (rect ^fill "#151e2b" ^height 420 ^id "n1-b2" ^width 70 ^x 80 ^y -420) (rect ^fill "#121a26" ^height 260 ^id "n1-b3" ^width 100 ^x 145 ^y -260) (rect ^fill "#18222f" ^height 480 ^id "n1-b4" ^width 85 ^x 240 ^y -480) (polygon ^fill "#18222f" ^id "n1-b4-spire" ^points [[270 -480] [282 -540] [294 -480]]) (rect ^fill "#121a26" ^height 340 ^id "n1-b5" ^width 110 ^x 320 ^y -340) (rect ^fill "#151e2b" ^height 440 ^id "n1-b6" ^width 75 ^x 425 ^y -440) (rect ^fill "#121a26" ^height 290 ^id "n1-b7" ^width 95 ^x 495 ^y -290) (rect ^fill "#18222f" ^height 390 ^id "n1-b8" ^width 80 ^x 585 ^y -390) (rect ^fill "#121a26" ^height 250 ^id "n1-b9" ^width 108 ^x 660 ^y -250) (rect ^fill "#0c121b" ^height 40 ^id "n1-ground" ^width 768 ^x 0 ^y -40))) (add ^parent "scene" ^placement (last) (g ^id "n1-headline" ^label "headline" ^role "headline" (text ^anchor "middle" ^fill "#f4f8fc" ^font "sans" ^id "n1-headline-text" ^size 104 ^weight 700 ^x 384 ^y 210 "RAIN CITY") (rect ^fill "#9fb8d4" ^height 6 ^id "n1-headline-rule" ^width 300 ^x 234 ^y 250))))