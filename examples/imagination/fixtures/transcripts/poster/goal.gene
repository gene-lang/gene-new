(goal ^id "goal-01" ^request "A poster with the exact headline \"RAIN CITY\" and readable contrast." (requirement ^check "visual" ^id "poster-format" ^strength "hard" "The picture is laid out as a poster with a clear headline area") (requirement ^check "structural" ^id "headline-present" ^strength "hard" ^text "RAIN CITY" "The picture contains the exact text RAIN CITY") (requirement ^check "visual" ^id "headline-readable" ^strength "hard" "The headline RAIN CITY is fully readable and not clipped or cut off at any edge") (requirement ^check "visual" ^id "headline-contrast" ^strength "hard" "The headline text stands out clearly against the background behind it, with strong light-dark contrast") (requirement ^check "visual" ^id "headline-prominence" ^strength "soft" "The headline is the most prominent element on the poster and draws the eye first") (requirement ^check "visual" ^id "balanced-layout" ^strength "soft" "The poster composition feels balanced, with the headline and any imagery sharing the space without crowding") (preference ^source "agent_interpretation" "Use a rainy city skyline with falling rain streaks as the background imagery") (preference ^source "agent_interpretation" "Use a cool blue and gray palette with white or pale headline text for contrast") (preference ^source "agent_interpretation" "Set the headline in a bold, condensed sans-serif typeface near the top of the poster") (requirement ^check "structural" ^id "medium" ^strength "hard" "All visible content uses the supported SVG subset."))