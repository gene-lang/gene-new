# The Imagination workbench (design section 14), compiled by the web profile.
#
# The server owns every record. This client keeps only view state: which
# project, line, and revision are shown, follow-live, and compare choices.
# Clicking a thumbnail only navigates; choosing a result, starting a run, and
# forking are explicit server operations.
(mod imagination_client ^profile web)

(import ^from "./api.gene" [api hash_value message_of text_or])

# `phase` is the newest phase heard on the socket since the last snapshot;
# `phase_from` and `run_from` are `$time/now` readings the clock counts from.
(type Bench ^props {^token Str ^project Str ^line Str ^viewing Str ^follow Bool
                    ^show_trials Bool ^vector Bool ^last_seq Int ^socket Any ^socket_epoch Int
                    ^job Str ^data Any ^history Any ^revision Any ^refresh_queued Bool
                    ^busy Bool ^dropped Bool ^phase Str ^phase_from F64 ^run_from F64
                    ^ticking Bool ^canvas EventTarget ^notice EventTarget})

(fn say [bench : Bench, tone : Str, text : Str] : Void
  ($dom/set_attribute bench/notice "class" (if (== tone "") "notice" $"notice ${tone}"))
  ($dom/set_text bench/notice text))

(fn notice [bench : Bench, text : Str] : Void
  (say bench "" text))

(fn show_error [bench : Bench, result : Any] : Void
  (say bench "error" (message_of result "The request could not be completed.")))

(fn set_hidden [id : Str, hidden : Bool] : Void
  (var element ($dom/element id))
  (set element/hidden hidden))

(fn project_path [bench : Bench, rest : Str] : Str
  $"/projects/${($url/encode_component bench/project)}${rest}")

(fn digest_hex [digest : Str] : Str
  (var parts : (List Str) (str/split digest ":"))
  (if (== ($size parts) 2) parts/1 digest))

(fn artifact [bench : Bench, render : Str, kind : Str] : Str
  $"/api/v1/projects/${bench/project}/artifacts/${(digest_hex render)}/${kind}")

(fn update_hash [bench : Bench] : Void
  ($browser/replace_url $"/#project=${bench/project}&line=${bench/line}&rev=${bench/viewing}"))

# ── projects and lines ─────────────────────────────────────────────────────

(fn fill_select [select : EventTarget, values : (List Str), chosen : Str] : Void
  ($dom/clear select)
  (for value in values
    (var option ($dom/render `(option ^value %value %value)))
    ($dom/append select option))
  ($dom/set_input_value select chosen))

(fn load_projects [bench : Bench] : Void
  (api bench/token "GET" "/projects" nil
    (fn [status : Int, data : Any] : Void
      (if_yes (!= status 200) (show_error bench data) (return))
      (var names : (List Str) data/projects)
      (var wanted (hash_value ($browser/hash) "project"))
      (var chosen "")
      (for name in names
        (if_yes (|| (== name wanted) (== chosen "")) (set chosen name)))
      (fill_select ($dom/element "project_select") names chosen)
      (if (== chosen "")
        (then
          (set_hidden "new_project" false)
          (notice bench "Describe a picture to start drawing."))
        (else
          (open_project bench chosen (hash_value ($browser/hash) "line")
            (hash_value ($browser/hash) "rev")))))))

(fn open_project [bench : Bench, name : Str, line : Str, revision : Str] : Void
  (set bench/project name)
  (set bench/line (if (== line "") "main" line))
  (set bench/viewing revision)
  # The socket opens after the first snapshot, from its event sequence.
  (set bench/last_seq -1)
  (set bench/job "")
  (set bench/revision nil)
  (set bench/phase "")
  (set bench/phase_from 0.0)
  (refresh bench (== revision "")))

# Whether a project snapshot is loaded. A failed load leaves the previous
# view in place instead of reading fields of an error response.
(fn loaded [bench : Bench] : Bool
  (if_yes ($absent? bench/data) (return false))
  (! ($absent? bench/data/lines)))

(fn line_record [bench : Bench] : Any
  (if_not (loaded bench) (return nil))
  (var lines : (List Any) bench/data/lines)
  (for line in lines
    (var id : Str line/id)
    (if_yes (== id bench/line) (return line)))
  (if (> ($size lines) 0) lines/0 nil))

(fn line_head [bench : Bench] : Str
  (var line (line_record bench))
  (if_yes ($absent? line) (return ""))
  (var head : Str line/head)
  head)

# The goal the shown line is working toward now.
(fn line_goal [bench : Bench] : Any
  (var line : Any (line_record bench))
  (if_yes ($absent? line) (return nil))
  (var goal_id : Str line/goal)
  (var goals : Any bench/data/goals)
  goals/%goal_id)

# The newest run of the shown line: its active run, or the last one to end.
# The snapshot lists runs newest first.
(fn line_run [bench : Bench] : Any
  (if_not (loaded bench) (return nil))
  (var runs : (List Any) bench/data/runs)
  (for run in runs
    (var line : Str run/line)
    (if_yes (== line bench/line) (return run)))
  nil)

# The candidate the line's active run is holding for review, as
# [revision, render bundle], or an empty list.
(fn held [bench : Bench] : (List Str)
  (var none : (List Str) [])
  (var run : Any (line_run bench))
  (if_yes ($absent? run) (return none))
  (var status : Str run/status)
  (var pending : Str (text_or run/pending ""))
  (var render : Str (text_or run/pending_render ""))
  (if_yes (|| (!= status "running") (== pending "") (== render "")) (return none))
  [pending render])

# Following live shows the newest image: the candidate the run is holding for
# review, when there is one, in place of the head it was drawn on.
(fn showing_candidate [bench : Bench] : Bool
  (&& bench/follow (== ($size (held bench)) 2) (== bench/viewing (line_head bench))))

(fn render_project [bench : Bench] : Void
  (var lines : (List Any) bench/data/lines)
  (var names : (List Str) [])
  (for line in lines
    (var id : Str line/id)
    (names .push id))
  (var line (line_record bench))
  (if_yes ($absent? line) (return))
  (var line_id : Str line/id)
  (set bench/line line_id)
  (fill_select ($dom/element "line_select") names line_id)
  (var goal_id : Str line/goal)
  (var goals : Any bench/data/goals)
  (var goal : Any goals/%goal_id)
  (var request : Str (text_or goal/request ""))
  (var goal_text ($dom/element "goal_text"))
  ($dom/set_text goal_text $"${goal_id}: ${request}")
  ($dom/set_attribute goal_text "title" request)
  (var active : Str (text_or line/active_run ""))
  (set bench/job (if (== active "") "" $"${bench/project}.${active}"))
  # The snapshot is newer than any phase heard before it.
  (set bench/phase "")
  (sync_clock bench)
  (render_status bench)
  (render_composer bench)
  (render_choice bench)
  (render_model_view bench)
  (load_activity bench))

# ── run status ─────────────────────────────────────────────────────────────

(fn clock_text [ms : F64] : Str
  (var total : Int ($to_int ($math/floor (/ ($math/max ms 0.0) 1000.0))))
  (var minutes : Int (/ total 60))
  (var seconds : Int (// total 60))
  (var pad (if (< seconds 10) "0" ""))
  $"${minutes}:${pad}${seconds}")

(fn running? [bench : Bench] : Bool
  (var run : Any (line_run bench))
  (if_yes ($absent? run) (return false))
  (var status : Str run/status)
  (== status "running"))

# Model calls take from seconds to a minute. A clock that keeps counting says
# the run is alive when nothing else on the page moves.
(fn tick [bench : Bench] : Void
  (if_not (running? bench)
    (set bench/ticking false)
    ($dom/set_text ($dom/element "run_clock") "")
    (return))
  (var now : F64 ($time/now))
  ($dom/set_text ($dom/element "run_clock")
    $"this step ${(clock_text (- now bench/phase_from))} · run ${(clock_text (- now bench/run_from))}")
  ($time/after 1000.0 (fn [] : Void (tick bench))))

# Take the run's ages from the snapshot. The step clock is only set from it
# when no phase change has been heard on the socket.
(fn sync_clock [bench : Bench] : Void
  (if_not (running? bench)
    (set bench/phase_from 0.0)
    (return))
  (var run : Any (line_run bench))
  (var now : F64 ($time/now))
  (var age : Int run/age_ms)
  (var phase_age : Int run/phase_age_ms)
  (set bench/run_from (- now ($to_float age)))
  (if_yes (== bench/phase_from 0.0)
    (set bench/phase_from (- now ($to_float phase_age))))
  (if_not bench/ticking
    (set bench/ticking true)
    (tick bench)))

(fn render_status [bench : Bench] : Void
  (if_not (loaded bench) (return))
  (var target ($dom/element "run_status"))
  (var strip ($dom/element "run_strip"))
  (var run : Any (line_run bench))
  (if_yes ($absent? run)
    ($dom/set_text target "No run on this line yet.")
    ($dom/set_attribute strip "class" "run_strip")
    (set_hidden "run_queue" true)
    (return))
  (var id : Str run/id)
  (var status : Str run/status)
  (var iteration : Int run/iteration)
  (var accepted : Str (text_or run/accepted ""))
  (var reason : Str (text_or run/reason ""))
  (var usage : Any run/usage)
  (var calls : Int usage/calls)
  (var budgets : Any run/budgets)
  (var limit : Int budgets/max_iterations)
  (var phase : Str (if (== bench/phase "") (text_or run/phase "") bench/phase))
  ($dom/set_attribute strip "class" $"run_strip ${status}")
  (if (== status "running")
    ($dom/set_text target
      $"${id} · ${phase} · edit ${iteration} of ${limit} · last accepted ${accepted} · ${calls} model calls")
    ($dom/set_text target (if (== reason "") $"${id} ${status}" $"${id} ${status} — ${reason}")))
  (var waiting : Str (text_or run/steering ""))
  (set_hidden "run_queue" (|| (!= status "running") (== waiting "")))
  ($dom/set_text ($dom/element "run_queue") $"Waiting for the next step: ${waiting}"))

# ── the composer ───────────────────────────────────────────────────────────

# What the one instruction box does now: "steer" a running drawing, "draw" on
# the line from its head, or "branch" from an older or unaccepted revision.
(fn composer_mode [bench : Bench] : Str
  (if_yes (!= bench/job "") (return "steer"))
  (var head (line_head bench))
  (if (|| (== bench/viewing "") (== bench/viewing head)) "draw" "branch"))

(fn composer_text [] : Str
  (str/trim ($dom/input_value ($dom/element "composer_text"))))

(fn render_composer [bench : Bench] : Void
  (if_not (loaded bench) (return))
  (var mode (composer_mode bench))
  (var text (composer_text))
  (var head (line_head bench))
  (var box ($dom/element "composer_text"))
  (var button ($dom/element "run_button"))
  (var hint ($dom/element "composer_hint"))
  (set_hidden "cancel_button" (!= mode "steer"))
  (set_hidden "budget_label" (== mode "steer"))
  (if (== mode "steer")
    (then
      ($dom/set_text button "Send to the running drawing")
      (set button/disabled (|| bench/busy (== text "")))
      ($dom/set_attribute box "placeholder"
        "Tell the running drawing what to change, e.g. make the sail larger")
      ($dom/set_text hint "It joins the goal at the run's next step."))
    (elif (== mode "draw")
      ($dom/set_text button (if (== text "") "Draw" "Revise and draw"))
      (set button/disabled bench/busy)
      ($dom/set_attribute box "placeholder"
        "What should change? Leave this empty to keep drawing toward the goal.")
      ($dom/set_text hint
        (if (== text "")
          $"Continues line ${bench/line} from ${head}."
          $"Adds this to the goal of line ${bench/line} and draws on from ${head}.")))
    (else
      ($dom/set_text button $"Draw from ${bench/viewing} on a new line")
      (set button/disabled bench/busy)
      ($dom/set_attribute box "placeholder"
        $"What should change from ${bench/viewing}? Leave this empty to keep its goal.")
      ($dom/set_text hint
        $"${bench/viewing} is not the head of ${bench/line} (that is ${head}), so this starts a new line and leaves ${bench/line} alone."))))

(fn set_busy [bench : Bench, busy : Bool] : Void
  (set bench/busy busy)
  (render_composer bench))

# ── refresh ────────────────────────────────────────────────────────────────

(fn refresh [bench : Bench, view_head : Bool] : Void
  (api bench/token "GET" (project_path bench "") nil
    (fn [status : Int, data : Any] : Void
      (if_yes (|| (!= status 200) ($absent? data/lines)) (show_error bench data) (return))
      (set bench/data data)
      (if_yes (< bench/last_seq 0)
        (var latest : Int data/last_event)
        (set bench/last_seq latest)
        (connect bench))
      (render_project bench)
      (load_history bench view_head))))

(fn schedule_refresh [bench : Bench] : Void
  (if_yes bench/refresh_queued (return))
  (set bench/refresh_queued true)
  ($time/after 300.0
    (fn [] : Void
      (set bench/refresh_queued false)
      (refresh bench bench/follow))))

(fn load_history [bench : Bench, view_head : Bool] : Void
  (api bench/token "GET" (project_path bench "/history") nil
    (fn [status : Int, data : Any] : Void
      (if_yes (!= status 200) (show_error bench data) (return))
      (set bench/history data)
      (if (|| view_head (== bench/viewing ""))
        (then
          (var head (line_head bench))
          (if_yes (!= head "") (view_revision bench head)))
        (elif ($absent? bench/revision)
          # A page opened on a revision named in its address has yet to load it.
          (view_revision bench bench/viewing))
        (else
          (render_canvas bench)
          (render_composer bench)
          (render_history bench))))))

# ── activity ───────────────────────────────────────────────────────────────

# What the line's newest run has done, as the server tells it: one line per
# committed step, stamped with the time since the run began.
(fn load_activity [bench : Bench] : Void
  (var list ($dom/element "activity"))
  (var run : Any (line_run bench))
  (if_yes ($absent? run)
    ($dom/clear list)
    ($dom/set_text ($dom/element "activity_run") "")
    ($dom/append list
      ($dom/render `(li ^class_name "muted" "Nothing has run on this line yet.")))
    (return))
  (var id : Str run/id)
  (var project bench/project)
  (api bench/token "GET" $"/jobs/${project}.${id}/activity" nil
    (fn [status : Int, data : Any] : Void
      (if_yes (|| (!= status 200) (!= project bench/project)) (return))
      # Stay at the newest line unless the reader has scrolled back.
      (var at_end ($dom/near_end list 48.0))
      ($dom/clear list)
      ($dom/set_text ($dom/element "activity_run") id)
      (var lines : (List Any) data/lines)
      (for line in lines
        (var at : Str line/at)
        (var tone : Str line/tone)
        (var text : Str line/text)
        ($dom/append list
          ($dom/render `(li ^class_name %tone (span ^class_name "at" %at) (span %text)))))
      (if_yes at_end ($dom/scroll_end list)))))

# ── history graph ──────────────────────────────────────────────────────────

# Position and size through CSSOM properties: the page's content security
# policy refuses inline style attributes. A negative value leaves it unset.
(fn place [element : EventTarget, x : Int, y : Int, width : Int, height : Int] : Void
  (var style : Any element/style)
  (if_yes (>= x 0) (set style/left $"${x}px"))
  (if_yes (>= y 0) (set style/top $"${y}px"))
  (if_yes (>= width 0) (set style/width $"${width}px"))
  (if_yes (>= height 0) (set style/height $"${height}px")))

(fn render_history [bench : Bench] : Void
  (var target ($dom/element "history"))
  (var kept ($dom/scroll_top target))
  (var scroller : Any target)
  (var kept_left : F64 scroller/scrollLeft)
  ($dom/clear target)
  (if_yes ($absent? bench/history) (return))
  (var history : Any bench/history)
  (var width : Int history/width)
  (var height : Int history/height)
  (var edges : Str history/edges_url)
  (var surface ($dom/render `(div ^class_name "graph")))
  (place surface -1 -1 width height)
  (var lines_image ($dom/render `(img ^class_name "edges" ^alt "")))
  ($dom/set_attribute lines_image "src" edges)
  (place lines_image -1 -1 width height)
  ($dom/append surface lines_image)
  (var nodes : (List Any) history/nodes)
  (var selected_result : Str (text_or history/selected ""))
  (var shown_x : Int -1)
  (var shown_y : Int -1)
  (for node in nodes
    (var id : Str node/id)
    (var quality : Str node/quality)
    (var x : Int node/x)
    (var y : Int node/y)
    (var thumbnail : Str node/thumbnail)
    (var intent : Str (text_or node/intent ""))
    (var heads : (List Str) node/heads)
    (var trial (!= quality "accepted"))
    (if_yes (&& trial (! bench/show_trials)) (continue))
    (var cls $"node ${quality}")
    (if_yes (== id bench/viewing)
      (set cls $"${cls} viewing")
      (set shown_x x)
      (set shown_y y))
    (var mark (if (== quality "accepted") "" $" · ${quality}"))
    (var tip (if (== intent "") id $"${id}: ${intent}"))
    (var button
      ($dom/render
        `(button ^type "button" ^class_name %cls ^title %tip
           ^aria-label %$"Revision ${id}, ${quality}"
           ^on_click %(fn [event : Any] : Void
             (set bench/follow false)
             (var follow_box ($dom/element "follow_live"))
             (set follow_box/checked false)
             (view_revision bench id)))))
    (var picture ($dom/render `(img ^alt "")))
    ($dom/set_attribute picture "src" thumbnail)
    ($dom/append button picture)
    # Line heads and the chosen result are tags, so the caption keeps the ID.
    (var tags ($dom/render `(span ^class_name "tags")))
    (for name in heads
      ($dom/append tags ($dom/render `(span ^class_name "tag" %name))))
    (if_yes (== id selected_result)
      ($dom/append tags ($dom/render `(span ^class_name "tag result" "result"))))
    ($dom/append button tags)
    ($dom/append button ($dom/render `(span ^class_name "caption" %$"${id}${mark}")))
    (place button x y -1 -1)
    ($dom/append surface button))
  ($dom/append target surface)
  # Following live keeps the shown revision in sight; otherwise the reader's
  # own scroll position survives the redraw.
  (var box : Any target)
  (if (&& bench/follow (>= shown_y 0))
    (then
      ($dom/set_scroll_top target (- ($to_float shown_y) 150.0))
      (set box/scrollLeft (- ($to_float shown_x) 150.0)))
    (else
      ($dom/set_scroll_top target kept)
      (set box/scrollLeft kept_left))))

# ── the selected revision ──────────────────────────────────────────────────

(fn section [title : Str] : EventTarget
  ($dom/render `(section ^class_name "block" (h3 %title))))

# A collapsed part of the inspector.
(fn fold [title : Str, open : Bool] : EventTarget
  (var block ($dom/render `(details (summary %title))))
  (if_yes open ($dom/set_attribute block "open" ""))
  block)

(fn line_item [text : Str] : EventTarget
  ($dom/render `(li %text)))

# A digest is evidence, not reading matter: its start is shown and the whole
# value is the tooltip.
(fn digest_mark [digest : Str] : EventTarget
  ($dom/render `(span ^class_name "digest" ^title %digest %(digest_hex digest))))

(fn goal_block [title : Str, goal : Any] : EventTarget
  (var block (section title))
  (var goal_id : Str goal/id)
  (var request : Str goal/request)
  ($dom/append block ($dom/render `(p %$"${goal_id}: ${request}")))
  (var requirements : (List Any) goal/requirements)
  (var list ($dom/render `(ul)))
  (for requirement in requirements
    (var rid : Str requirement/id)
    (var strength : Str requirement/strength)
    (var description : Str requirement/description)
    ($dom/append list (line_item $"${rid} (${strength}): ${description}")))
  ($dom/append block list)
  block)

(fn render_inspector [bench : Bench, data : Any] : Void
  (var target ($dom/element "inspector"))
  ($dom/clear target)
  (var id : Str data/id)
  (var quality : Str data/quality)
  (var actor : Str data/actor)
  (var parents : (List Str) data/parents)
  (var run : Str (text_or data/run "no run"))
  ($dom/set_text ($dom/element "inspector_title")
    (if (showing_candidate bench) $"${id} · the last accepted revision" $"${id} · ${quality}"))
  (var facts (section "Revision"))
  (var parent_text (if (== ($size parents) 0) "none (root)" (str/join parents ", ")))
  ($dom/append facts ($dom/render `(p %$"Parent ${parent_text} · ${actor} · ${run}")))
  (var intent : Str (text_or data/intent ""))
  (if_yes (!= intent "") ($dom/append facts ($dom/render `(p ^class_name "intent" %intent))))
  (var summary : Str (text_or data/summary ""))
  (if_yes (!= summary "") ($dom/append facts ($dom/render `(p ^class_name "muted" %summary))))
  ($dom/append target facts)

  (var evaluation : Any data/evaluation)
  (var checks : (List Any) evaluation/checks)
  (var passed 0)
  (for item in checks
    (var outcome : Str item/result)
    (if_yes (== outcome "pass") (set passed (+ passed 1))))
  (var review (section $"Evaluation · ${passed} of ${($size checks)} pass"))
  (var reviewer : Str evaluation/reviewer)
  (var image : Str evaluation/image)
  (var seen ($dom/render `(p ^class_name "muted" %$"Reviewer: ${reviewer} · image ")))
  ($dom/append seen (digest_mark image))
  ($dom/append review seen)
  (var list ($dom/render `(ul ^class_name "checks")))
  (for check in checks
    (var requirement : Str check/requirement)
    (var result : Str check/result)
    (var evidence : Str check/evidence)
    ($dom/append list
      ($dom/render
        `(li ^class_name %$"check ${result}"
           (span ^class_name "badge" %result)
           (span (strong %requirement) %$" — ${evidence}")))))
  ($dom/append review list)
  (var issues : (List Any) evaluation/issues)
  (if_yes (> ($size issues) 0)
    (var issue_list ($dom/render `(ul ^class_name "issues")))
    (for issue in issues
      (var severity : Str issue/severity)
      (var text : Str issue/text)
      ($dom/append issue_list (line_item $"${severity}: ${text}")))
    ($dom/append review issue_list))
  ($dom/append target review)

  # A revision is judged against the goal it was drawn for. When the line has
  # moved on to another goal, that one comes first: it is what a run draws.
  (var goal : Any data/goal_record)
  (var goal_id : Str goal/id)
  (var current : Any (line_goal bench))
  (var moved false)
  (if_not ($absent? current)
    (var current_id : Str current/id)
    (set moved (!= current_id goal_id)))
  (if_yes moved
    ($dom/append target (goal_block $"Goal of line ${bench/line} now" current)))
  ($dom/append target
    (goal_block (if moved "Goal this revision was judged against" "Goal") goal))

  (var changes : (List Str) data/changes)
  (if_yes (> ($size changes) 0)
    (var diff (fold $"Changes from parent (${($size changes)})" (<= ($size changes) 6)))
    (var change_list ($dom/render `(ul)))
    (for change in changes ($dom/append change_list (line_item change)))
    ($dom/append diff change_list)
    ($dom/append target diff))

  (var render_block (fold "Render" false))
  (var profile : Str (text_or data/render_profile ""))
  (var output : (List Int) data/output)
  (var rendered ($dom/render `(p %$"${profile} · ${output/0} × ${output/1} px · observation ")))
  ($dom/append rendered (digest_mark image))
  ($dom/append render_block rendered)
  ($dom/append target render_block)

  (var patch : Str (text_or data/patch ""))
  (if_yes (!= patch "")
    (var details ($dom/render `(details (summary "Patch") (pre %patch))))
    ($dom/append target details)))

(fn render_canvas [bench : Bench] : Void
  (var image ($dom/element "canvas_image"))
  (var label ($dom/element "canvas_label"))
  (if_yes (showing_candidate bench)
    (var candidate (held bench))
    ($dom/set_attribute image "src" (artifact bench candidate/1 "observation.png"))
    ($dom/set_text label $"${candidate/0} · under review")
    (set_hidden "canvas_hint" true)
    (return))
  (if_yes ($absent? bench/revision) (return))
  (var data : Any bench/revision)
  (var artifacts : Any data/artifacts)
  (var png_kind "observation.png")
  (var svg_kind "scene.svg")
  (var observation : Str artifacts/%png_kind)
  (var vector : Str artifacts/%svg_kind)
  ($dom/set_attribute image "src" (if bench/vector vector observation))
  (var id : Str data/id)
  (var quality : Str data/quality)
  # The clean observation PNG is the default and is what the model sees; only
  # the browser's own rendering is called out.
  (var suffix (if bench/vector " · vector preview, browser renderer" ""))
  ($dom/set_text label $"${id} · ${quality}${suffix}")
  (var parents : (List Str) data/parents)
  (var blank (== ($size parents) 0))
  (set_hidden "canvas_hint" (! blank))
  (if_yes blank
    ($dom/set_text ($dom/element "canvas_hint")
      (if (== bench/job "")
        "A blank canvas. Press Draw to start."
        "The first edit is on its way…"))))

(fn render_choice [bench : Bench] : Void
  (if_not (loaded bench) (return))
  (var chosen : Str (text_or bench/data/selected ""))
  (var button ($dom/element "select_button"))
  (var same (&& (!= bench/viewing "") (== bench/viewing chosen)))
  ($dom/set_text button (if same "Chosen as result ✓" "Choose as result"))
  (set button/disabled same))

(fn view_revision [bench : Bench, id : Str] : Void
  (api bench/token "GET" (project_path bench $"/revisions/${id}") nil
    (fn [status : Int, data : Any] : Void
      (if_yes (!= status 200) (show_error bench data) (return))
      (set bench/viewing id)
      (set bench/revision data)
      (render_canvas bench)
      (render_inspector bench data)
      (render_composer bench)
      (render_choice bench)
      (var exports : Str (project_path bench "/exports"))
      (var base : Str $"/api/v1${exports}?revision=${id}")
      ($dom/set_attribute ($dom/element "export_svg") "href" $"${base}&format=svg")
      ($dom/set_attribute ($dom/element "export_pdf") "href" $"${base}&format=pdf")
      ($dom/set_attribute ($dom/element "export_png") "href" $"${base}&format=png")
      (var parents : (List Str) data/parents)
      (if_yes (> ($size parents) 0)
        ($dom/set_input_value ($dom/element "compare_left") parents/0))
      ($dom/set_input_value ($dom/element "compare_right") id)
      (update_hash bench)
      (render_history bench))))

# ── model view ─────────────────────────────────────────────────────────────

(fn render_model_view [bench : Bench] : Void
  (var target ($dom/element "model_view_body"))
  (if_not (loaded bench) (return))
  (var panel ($dom/element "model_view"))
  (var open : Bool panel/open)
  (if_not open (return))
  (var run : Any (line_run bench))
  (if_yes ($absent? run)
    ($dom/clear target)
    ($dom/append target ($dom/render `(p ^class_name "muted" "No model call yet.")))
    (return))
  (var id : Str run/id)
  (load_model_view bench $"${bench/project}.${id}"))

(fn load_model_view [bench : Bench, job : Str] : Void
  (api bench/token "GET" $"/jobs/${job}" nil
    (fn [status : Int, data : Any] : Void
      (var target ($dom/element "model_view_body"))
      ($dom/clear target)
      (if_yes (!= status 200) (return))
      (if_yes ($absent? data/model_view)
        ($dom/append target ($dom/render `(p ^class_name "muted" "No model call yet.")))
        (return))
      (var shown : Any data/model_view)
      (var model : Str (text_or shown/model ""))
      (var usage : Any shown/usage)
      (var input : Int usage/input)
      (var output : Int usage/output)
      ($dom/append target
        ($dom/render `(p %$"${job} · ${model} · ${input} input and ${output} output tokens on the newest call")))
      (var submitted : (List Any) shown/submitted)
      (var table ($dom/render `(ul ^class_name "submitted")))
      (for item in submitted
        (var label : Str item/label)
        (var digest : Str item/digest)
        (var size : Int item/bytes)
        (var transport : Str item/transport)
        (var preprocessing : Str item/preprocessing)
        ($dom/append table
          (line_item $"${label}: ${digest}, ${size} bytes, ${transport}, preprocessing ${preprocessing}")))
      ($dom/append target table))))

# ── events ─────────────────────────────────────────────────────────────────

(fn connect [bench : Bench] : Void
  (set bench/socket_epoch (+ bench/socket_epoch 1))
  (var epoch bench/socket_epoch)
  (if_not ($absent? bench/socket)
    (var old : EventTarget bench/socket)
    ($ws/close old))
  (var origin ($browser/origin))
  (var parts : (List Str) (str/split origin "://"))
  (var scheme (if (== parts/0 "https") "wss" "ws"))
  (var socket
    ($ws/connect $"${scheme}://${parts/1}/api/v1/projects/${bench/project}/events?last=${bench/last_seq}"))
  (set bench/socket socket)
  ($ws/on_open socket
    (fn [] : Void
      (if_yes (&& (== epoch bench/socket_epoch) bench/dropped)
        (set bench/dropped false)
        (notice bench "Reconnected to the application.")
        (refresh bench bench/follow))))
  ($ws/on_text socket
    (fn [text : Str] : Void
      (if_yes (== epoch bench/socket_epoch) (on_event bench text))))
  ($ws/on_close socket
    (fn [] : Void
      (if_yes (!= epoch bench/socket_epoch) (return))
      (set bench/dropped true)
      (say bench "warn" "The connection to the application dropped. Reconnecting…")
      ($time/after 1500.0
        (fn [] : Void
          (if_yes (== epoch bench/socket_epoch) (connect bench)))))))

(fn on_event [bench : Bench, text : Str] : Void
  (var message : Any ($json/parse text))
  (var kind : Str message/kind)
  (if_yes (== kind "resync")
    (set bench/last_seq -1)
    (refresh bench bench/follow)
    (return))
  (var seq_text : Str message/seq)
  (var seq : Int ($json/parse seq_text))
  # Events are replayed after a reconnect; a duplicate is ignored.
  (if_yes (<= seq bench/last_seq) (return))
  (set bench/last_seq seq)
  (var data : Any message/data)
  (var job : Str (text_or message/job ""))
  # Only the shown line's run moves the status strip and the notices.
  (var ours (&& (!= bench/job "") (== job bench/job)))
  (if_yes (== kind "phase_changed")
    (if_yes ours
      (set bench/phase (text_or data/phase ""))
      (set bench/phase_from ($time/now))
      (render_status bench))
    (return))
  (if_yes (&& (== kind "run_note") ours)
    (var noted : Str (text_or data/kind ""))
    (var run_id : Str (text_or message/run ""))
    (var said : Str (text_or data/message ""))
    (if_yes (!= noted "reply_closed")
      (say bench "warn" $"${run_id}: ${said}")))
  (if_yes (&& (== kind "run_finished") ours)
    (var status : Str (text_or data/status ""))
    (var reason : Str (text_or data/reason ""))
    (say bench (if (== status "complete") "" (if (== status "failed") "error" "warn"))
      $"The run finished: ${status}. ${reason}"))
  (schedule_refresh bench))

# ── actions ────────────────────────────────────────────────────────────────

# Start a run on the shown line from its head. A non-empty instruction joins
# the line's goal before the first edit.
(fn start_run [bench : Bench, instruction : Str] : Void
  (var head (line_head bench))
  (var budget : Any ($json/parse ($dom/input_value ($dom/element "max_edits"))))
  (set_busy bench true)
  (notice bench "Starting the run…")
  (api bench/token "POST" (project_path bench "/runs")
    {^line bench/line ^expected_head head ^max_iterations budget ^instruction instruction
     ^idempotency_key ($browser/request_id)}
    (fn [status : Int, data : Any] : Void
      (set bench/busy false)
      (if (== status 202)
        (then
          (var job : Str data/job)
          (set bench/job job)
          (set bench/follow true)
          (set bench/phase_from 0.0)
          (var follow_box ($dom/element "follow_live"))
          (set follow_box/checked true)
          ($dom/set_input_value ($dom/element "composer_text") "")
          (notice bench
            (if (== instruction "")
              $"Started ${job}. Each edit appears here while it is reviewed."
              $"Started ${job}. Your instruction is planned into the goal first."))
          (refresh bench true))
        (elif (== status 409)
          (var problem : Str (message_of data "The line changed."))
          (say bench "error" $"${problem} The page now shows the current state; try again.")
          (refresh bench false))
        (else
          (show_error bench data)
          (render_composer bench))))))

# Draw from the shown revision on a line of its own: the fork, then the run.
(fn branch_and_draw [bench : Bench, instruction : Str] : Void
  (var from bench/viewing)
  (set_busy bench true)
  (notice bench
    (if (== instruction "")
      $"Creating a line from ${from}…"
      $"Planning the new direction from ${from}…"))
  (api bench/token "POST" (project_path bench "/lines")
    {^from from ^name "" ^prompt instruction ^idempotency_key ($browser/request_id)}
    (fn [status : Int, data : Any] : Void
      (if_yes (!= status 201)
        (set_busy bench false)
        (show_error bench data)
        (return))
      (var name : Str data/line)
      (set bench/line name)
      (set bench/data data)
      (start_run bench ""))))

(fn steer [bench : Bench, instruction : Str] : Void
  (set_busy bench true)
  (api bench/token "POST" $"/jobs/${bench/job}/steer"
    {^instruction instruction ^idempotency_key ($browser/request_id)}
    (fn [status : Int, data : Any] : Void
      (set bench/busy false)
      (if (|| (== status 200) (== status 202))
        (then
          ($dom/set_input_value ($dom/element "composer_text") "")
          (notice bench "Your instruction waits for the run's next step.")
          (refresh bench bench/follow))
        (else
          (show_error bench data)
          (render_composer bench))))))

(fn submit_composer [bench : Bench] : Void
  (if_yes (|| bench/busy (! (loaded bench))) (return))
  (var mode (composer_mode bench))
  (var text (composer_text))
  (if (== mode "steer")
    (then
      (if_yes (!= text "") (steer bench text)))
    (elif (== mode "draw")
      (start_run bench text))
    (else
      (branch_and_draw bench text))))

(fn cancel_run [bench : Bench] : Void
  (if_yes (== bench/job "") (return))
  (api bench/token "POST" $"/jobs/${bench/job}/cancel" {^idempotency_key ($browser/request_id)}
    (fn [status : Int, data : Any] : Void
      (if (|| (== status 200) (== status 202))
        (notice bench "Cancelling: the run stops before its next step.")
        (show_error bench data)))))

(fn choose_result [bench : Bench] : Void
  (if_yes (|| (== bench/viewing "") (! (loaded bench))) (return))
  (var version : Int bench/data/metadata_version)
  (api bench/token "POST" (project_path bench "/selection")
    {^revision bench/viewing ^expected_version version ^idempotency_key ($browser/request_id)}
    (fn [status : Int, data : Any] : Void
      (if (== status 200)
        (notice bench $"${bench/viewing} is the chosen result.")
        (show_error bench data))
      (refresh bench false))))

(fn fork_line [bench : Bench] : Void
  (var name : Str ($dom/input_value ($dom/element "fork_name")))
  (var prompt : Str ($dom/input_value ($dom/element "fork_prompt")))
  (if_yes (== bench/viewing "") (notice bench "Choose a revision first.") (return))
  (notice bench (if (== prompt "") "Creating the line…" "Planning the new direction…"))
  (api bench/token "POST" (project_path bench "/lines")
    {^from bench/viewing ^name name ^prompt prompt ^idempotency_key ($browser/request_id)}
    (fn [status : Int, data : Any] : Void
      (if (== status 201)
        (then
          (var created : Str data/line)
          (set bench/line created)
          ($dom/set_input_value ($dom/element "fork_name") "")
          ($dom/set_input_value ($dom/element "fork_prompt") "")
          (notice bench $"Line ${created} continues from ${bench/viewing}. Press Draw to draw on it.")
          (refresh bench false))
        (else (show_error bench data))))))

(fn create_project [bench : Bench] : Void
  (var name : Str (str/trim ($dom/input_value ($dom/element "new_name"))))
  (var prompt : Str ($dom/input_value ($dom/element "new_prompt")))
  (var width : Any ($json/parse ($dom/input_value ($dom/element "new_width"))))
  (var height : Any ($json/parse ($dom/input_value ($dom/element "new_height"))))
  # Planning is a model call: say so, and take one request at a time.
  (var submit ($dom/element "new_project_submit"))
  (set submit/disabled true)
  ($dom/set_text ($dom/element "new_project_note")
    "Planning the goal from your request. This is one model call, usually 10 to 20 seconds.")
  (notice bench "Planning the goal from your request…")
  (api bench/token "POST" "/projects"
    {^name name ^prompt prompt ^width width ^height height ^idempotency_key ($browser/request_id)}
    (fn [status : Int, data : Any] : Void
      (set submit/disabled false)
      ($dom/set_text ($dom/element "new_project_note") "")
      (if (== status 201)
        (then
          (var created : Str data/name)
          (set_hidden "new_project" true)
          ($dom/set_input_value ($dom/element "new_name") "")
          ($dom/set_input_value ($dom/element "new_prompt") "")
          (notice bench $"Created ${created}. Press Draw to start drawing.")
          ($browser/replace_url $"/#project=${created}")
          (load_projects bench))
        (else (show_error bench data))))))

(fn compare [bench : Bench] : Void
  (var left : Str ($dom/input_value ($dom/element "compare_left")))
  (var right : Str ($dom/input_value ($dom/element "compare_right")))
  (api bench/token "GET"
    (project_path bench $"/diff?left=${($url/encode_component left)}&right=${($url/encode_component right)}") nil
    (fn [status : Int, data : Any] : Void
      (var target ($dom/element "compare_body"))
      ($dom/clear target)
      (if_yes (!= status 200) (show_error bench data) (return))
      (var left_side : Any data/left)
      (var right_side : Any data/right)
      (var left_url : Str left_side/observation)
      (var right_url : Str right_side/observation)
      (var pair ($dom/render `(div ^class_name "pair")))
      (var left_image ($dom/render `(img ^alt %$"Revision ${left}")))
      ($dom/set_attribute left_image "src" left_url)
      (var right_image ($dom/render `(img ^alt %$"Revision ${right}")))
      ($dom/set_attribute right_image "src" right_url)
      ($dom/append pair left_image)
      ($dom/append pair right_image)
      ($dom/append target pair)
      (var same : Bool data/same_profile)
      (if_not same
        ($dom/append target
          ($dom/render `(p ^class_name "muted" "These images come from different render profiles; their pixels are not comparable."))))
      (var lines : (List Str) data/lines)
      (var list ($dom/render `(ul)))
      (for line in lines ($dom/append list (line_item line)))
      (if_yes (== ($size lines) 0) ($dom/append list (line_item "No structural change.")))
      ($dom/append target list))))

(fn checkbox [id : Str] : Bool
  (var box ($dom/element id))
  (var checked : Bool box/checked)
  checked)

(fn main [root : EventTarget] : Void
  (var bench
    (Bench ^token ($dom/text ($dom/element "imagination_token")) ^project "" ^line "main"
      ^viewing "" ^^follow ^^show_trials ^!vector ^last_seq 0 ^socket nil
      ^socket_epoch 0 ^job "" ^data nil ^history nil ^revision nil ^!refresh_queued
      ^!busy ^!dropped ^phase "" ^phase_from 0.0 ^run_from 0.0 ^!ticking
      ^canvas ($dom/element "canvas_image") ^notice ($dom/element "notice")))
  ($dom/add_event_listener ($dom/element "project_select") "change"
    (fn [event : Any] : Void
      (open_project bench ($dom/input_value ($dom/element "project_select")) "" "")))
  ($dom/add_event_listener ($dom/element "line_select") "change"
    (fn [event : Any] : Void
      (set bench/line ($dom/input_value ($dom/element "line_select")))
      (set bench/phase_from 0.0)
      (refresh bench true)))
  ($dom/add_event_listener ($dom/element "follow_live") "change"
    (fn [event : Any] : Void
      (set bench/follow (checkbox "follow_live"))
      (if_yes bench/follow (refresh bench true))))
  ($dom/add_event_listener ($dom/element "vector_preview") "change"
    (fn [event : Any] : Void
      (set bench/vector (checkbox "vector_preview"))
      (render_canvas bench)))
  ($dom/add_event_listener ($dom/element "show_trials") "change"
    (fn [event : Any] : Void
      (set bench/show_trials (checkbox "show_trials"))
      (render_history bench)))
  ($dom/add_event_listener ($dom/element "composer_form") "submit"
    (fn [event : Any] : Void
      ($dom/prevent_default event)
      (submit_composer bench)))
  # The button says what it will do, which depends on whether there is text.
  ($dom/add_event_listener ($dom/element "composer_text") "input"
    (fn [event : Any] : Void (render_composer bench)))
  # Return adds a line; with Command or Control it sends.
  ($dom/add_event_listener ($dom/element "composer_text") "keydown"
    (fn [event : Any] : Void
      (var key ($event/key event))
      (var command : Bool event/metaKey)
      (var control : Bool event/ctrlKey)
      (if_yes (&& (== key "Enter") (|| command control))
        ($dom/prevent_default event)
        (submit_composer bench))))
  ($dom/add_event_listener ($dom/element "cancel_button") "click"
    (fn [event : Any] : Void (cancel_run bench)))
  ($dom/add_event_listener ($dom/element "select_button") "click"
    (fn [event : Any] : Void (choose_result bench)))
  ($dom/add_event_listener ($dom/element "fork_form") "submit"
    (fn [event : Any] : Void
      ($dom/prevent_default event)
      (fork_line bench)))
  ($dom/add_event_listener ($dom/element "compare_button") "click"
    (fn [event : Any] : Void (compare bench)))
  ($dom/add_event_listener ($dom/element "model_view") "toggle"
    (fn [event : Any] : Void (render_model_view bench)))
  ($dom/add_event_listener ($dom/element "new_project_button") "click"
    (fn [event : Any] : Void
      (set_hidden "new_project" false)
      ($dom/focus ($dom/element "new_prompt"))))
  ($dom/add_event_listener ($dom/element "new_project_cancel") "click"
    (fn [event : Any] : Void (set_hidden "new_project" true)))
  ($dom/add_event_listener ($dom/element "new_project_form") "submit"
    (fn [event : Any] : Void
      ($dom/prevent_default event)
      (create_project bench)))
  (load_projects bench))
