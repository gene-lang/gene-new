#!/usr/bin/env gene run
# =============================================================================
# Types, protocols, messages, inheritance, and Self
# See docs/spec/protocols.md and docs/spec/protocols.md.
#
# Demonstrates:
#   - inherited type-direct messages and explicit message overrides
#   - inline impls, protocol inheritance, and same-named message identities
#   - declaration-bound Self in parameters, results, and nested functions
#   - inheriting impls (^^override) versus complete impls (no flag)
#   - per-protocol Self bindings and default-body result checks
#   - universal defaults and callable message values
#
# Bare (x .name) and (Self:name x) reach type-direct messages.
# (x .Protocol:name) and (Protocol:name x) reach a protocol message.
# Message names are not automatically bound as bare functions named `name`.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Type inheritance and a protocol implemented on the parent.
# -----------------------------------------------------------------------------

(type Animal ^props {^name Str}
  (message greet [] : Str $"${self/name} looks up"))

(protocol Describable
  (message describe [] : Str))

(impl Describable for Animal
  (message describe [] : Str $"a creature named ${self/name}"))

# Ord includes Comparable's message identity. Dog introduces both conformances,
# so Self in both protocols binds to Dog. The inline impl covers the full closure
# and satisfies ^impl [Comparable] without a separate Comparable impl.
(protocol Comparable
  (message compare [other : Self] : Int))

(protocol Ord ^inherit [Comparable]
  (message bigger [other : Self] : Self))

(type Dog : Animal ^props {^breed Str ^weight Int} ^impl [Comparable]
  (message tag [] : Str $"${self/name} the ${self/breed}")
  # A returned function keeps this declaration's Self = Dog, even when the
  # checker message is inherited by Pup and called on a Pup.
  (message checker [] : (Fn [Self] Bool)
    (fn [other : Self] : Bool (== self/name other/name)))
  (impl Ord
    (message compare [other : Self] : Int (- self/weight other/weight))
    (message bigger [other : Self] : Self
      (if (< (self .Comparable:compare other) 0) other self))))

# -----------------------------------------------------------------------------
# 2. Unrelated same-named messages keep distinct qualified identities.
# -----------------------------------------------------------------------------

(protocol Sized
  (message size_of [] : Int))

(protocol Scored
  (message size_of [] : Int))

(protocol Summary ^inherit [Sized Scored]
  (message blurb [] : Str))

(impl Summary for Dog
  (message Sized:size_of [] : Int self/weight)
  (message Scored:size_of [] : Int (* self/weight 2))
  (message blurb [] : Str
    $"${self/name}: ${(self .Sized:size_of)} lbs, score ${(self .Scored:size_of)}"))

# -----------------------------------------------------------------------------
# 3. Self stays bound to Dog in the inherited Eq contract.
# -----------------------------------------------------------------------------

# Equality in this example compares names within the Dog family.
(protocol Eq
  (message eq [other : Self] : Bool)
  (message label [] : Str "protocol default"))

(impl Eq for Dog
  (message eq [other : Self] : Bool (== self/name other/name))
  (message label [] : Str "Dog implementation"))

(type Pup : Dog ^props {}
  # A type-direct replacement needs a message-level marker. Its signature
  # must match Animal/greet; super enters that original parent definition.
  (message greet [] : Str ^^override
    $"${(super .greet)}, then wags"))

# An inheriting impl supplies replacements and copies omitted ancestor bodies.
# Eq.Self is still Dog. The supplied replacement names Dog explicitly; Self is
# allowed inside its body and means the new body's declaring receiver, Pup.
(impl Eq for Pup ^^override
  (message eq [other : Dog] : Bool
    (let current : Self self)
    (== current/name other/name)))

(type GrandPup : Pup ^props {})
(impl Eq for GrandPup ^^override) # An empty inheriting impl reuses every body.

(type CompletePup : Dog ^props {})
# Without ^^override, every message must have a local body or a protocol default.
# Dog's label body is not copied, so this impl uses Eq's default label.
# This is a new body set, but the established Eq.Self binding still remains Dog.
(impl Eq for CompletePup
  (message eq [other : Dog] : Bool (== self/name other/name)))

(fn compare_dogs [left : Dog right : Dog] : Bool (left .Eq:eq right))

# A separate nominal family gets its own Eq.Self = Point binding.
(type Point ^props {^x Int ^y Int})
(impl Eq for Point
  (message eq [other : Self] : Bool
    (&& (== self/x other/x) (== self/y other/y))))

# Protocol annotations admit either family, but the selected eq body still
# checks its concrete argument contract. They do not make Dog and Point mixable.
(fn compare_eq_values [left : Eq right : Eq] : Bool (left .Eq:eq right))

# -----------------------------------------------------------------------------
# 4. A new child protocol can bind Self differently from its inherited parent.
# -----------------------------------------------------------------------------

(protocol Copyable
  (message copy [] : Self))

(impl Copyable for Dog
  # Returning self exposes the difference between the declared result type
  # (Dog) and the actual object type (which may be Pup).
  (message copy [] : Self self))

(protocol Duplicable ^inherit [Copyable]
  (message duplicate [] : Self (self .Copyable:copy)))

# Copyable.Self stays Dog; the newly introduced Duplicable.Self becomes Pup.
# The reused copy body returns the actual Pup, satisfying duplicate's result.
(impl Duplicable for Pup ^^override)

(type FaultyPup : Dog ^props {})
(impl Duplicable for FaultyPup ^^override
  # Returning Dog satisfies the inherited Copyable contract. It cannot satisfy
  # Duplicable's new Self = FaultyPup promise when the default calls this body.
  (message Copyable:copy [] : Dog
    (Dog ^name self/name ^breed self/breed ^weight self/weight)))

# -----------------------------------------------------------------------------
# 5. Universal defaults need no explicit impl and cannot use abstract Self in
#    annotations. The receiver value self and Self:message syntax are allowed.
# -----------------------------------------------------------------------------

(protocol Greeting ^^universal
  (message greeting [] : Str (Self:greet self)))

# -----------------------------------------------------------------------------
# Run the examples. Expected failures are caught so the whole demo succeeds.
# -----------------------------------------------------------------------------

(fn show [label : Str value : Any] ($println $"${label}: ${value}"))

(let rex (Dog ^name "Rex" ^breed "Labrador" ^weight 70))
(let fido (Dog ^name "Fido" ^breed "Pug" ^weight 18))
(let puppy (Pup ^name "Rex" ^breed "Labrador" ^weight 12))
(let grand_puppy (GrandPup ^name "Rex" ^breed "Labrador" ^weight 8))
(let complete_puppy (CompletePup ^name "Rex" ^breed "Labrador" ^weight 12))
(let faulty_puppy (FaultyPup ^name "Rex" ^breed "Labrador" ^weight 12))
(let point (Point ^x 3 ^y 4))

(show "Inherited type-direct message" (rex .greet))
(show "Dog's own message" (rex .tag))
(show "Type-direct message value" (Self:tag rex))
(show "Inherited protocol impl" (rex .Describable:describe))
(show "Direct override with super" (puppy .greet))
(show "Comparable inherited through Ord" (rex .Comparable:compare fido)) # 52
(show "Ord result followed by another send" ((rex .Ord:bigger fido) .tag))
(show "Same name, separate identities" [(rex .Sized:size_of) (rex .Scored:size_of)]) # [70 140]
(show "Summary" (rex .Summary:blurb))

(show "All Dog/Pup pairs retain the Dog input contract"
  [(compare_dogs rex rex) (compare_dogs rex puppy)
   (compare_dogs puppy rex) (compare_dogs puppy puppy)]) # [true true true true]
(show "Inheriting impl copies the ancestor label" (puppy .Eq:label)) # Dog implementation
(show "Empty inheriting impl" (grand_puppy .Eq:label))               # Dog implementation
(show "Complete impl uses the protocol default" (complete_puppy .Eq:label)) # protocol default
(show "Complete impl still accepts Dog" (complete_puppy .Eq:eq rex)) # true
(show "Unrelated conformance" (point .Eq:eq (Point ^x 3 ^y 4)))       # true

(let held_eq : (Callable [Dog Dog] Bool) Eq:eq)
(show "Held protocol message" (held_eq puppy rex)) # true
(let check_name (puppy .checker))
(show "Escaping checker still accepts Dog" (check_name rex)) # true
(show "Protocol values still enforce concrete inputs"
  (try (compare_eq_values rex point) catch TypeError "rejected Dog/Point pair"))

(show "Inherited copy returns the actual Pup" (same? ($head (puppy .Copyable:copy)) Pup)) # true
(show "Mixed-binding default accepts an actual Pup" (same? ($head (puppy .Duplicable:duplicate)) Pup)) # true
(show "Mixed-binding default rejects a Dog result"
  (try (faulty_puppy .Duplicable:duplicate) catch TypeError "rejected Dog result"))
(show "Universal default dispatches the receiver's direct override" (puppy .Greeting:greeting))

# Declaration mistakes to try separately (each would stop module initialization):
#
# (impl Eq for CompletePup)                      # Missing eq; complete mode cannot copy Dog's body.
# (impl Eq for Point ^^override)                 # No ancestor provider; a default is not a target.
# (impl Eq for Pup ^^override
#   (message eq [other : Self] : Bool true))     # Replacement signatures cannot use contextual Self.
# (impl Eq for Pup ^^override
#   (message eq [other : Pup] : Bool true))      # Explicit narrowing also violates the inherited Dog contract.
# (type UnmarkedPup : Dog ^props {}
#   (message greet [] : Str "hello"))           # A direct replacement requires ^^override on the message.
#
# Replace the corresponding declarations above when trying an impl mistake;
# adding another impl for an already implemented pair is itself a conflict.
