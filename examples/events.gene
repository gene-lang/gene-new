#!/usr/bin/env gene run
# =============================================================================
# Gene event bus tour (docs/proposals/events.md, docs/stdlib.md `event`)
#
# Application pub/sub. An event is an ordinary typed value whose `^is`
# ancestry reaches `event/Event`: its concrete nominal type *is* its identity,
# and that ancestry *is* its matching hierarchy. There is no topic string, no
# topic registry, and no global bus — a bus is a value you make and hold.
#
#   bin/gene run examples/events.gene
#
# Conventions:
#   ($event/Bus)              a new bus; ^error_policy and ^nesting_limit
#   (bus ~ subscribe sel h)   returns an event/Subscription; ^once true
#   (bus ~ publish event)     returns event/PublishResult
#   (bus ~ close)             cancel every subscription, release handlers
#   (sub ~ cancel)            explicit, idempotent
#   ($event/exact T)          selector matching T but not its descendants
#   (sink ~ EventSink:emit e) the one-message sink protocol a bus implements
#
# Everything here is exercised by the "spec — application event bus" suite in
# tests/spec_runner.nim.
# =============================================================================

($println "== gene event bus tour ==")
($println "")

# -----------------------------------------------------------------------------
# 1. A typed event, a bus, a subscriber
#
# The event type is an ordinary declaration. `^is $event/Event` is what makes
# it publishable — and the bus's one inexpensive recognition rule. A domain
# entity does not become an event by adding that: events are snapshots of an
# occurrence, so you declare `OrderPlaced`, not `Order`.
# -----------------------------------------------------------------------------
($println "1. declare, subscribe, publish")

(type OrderPlaced
  ^is $event/Event
  ^props {
    ^order_id Str
    ^total F64
  })

(fn confirm_order [event : OrderPlaced]
  ($println $"   confirming ${event/order_id} for $${event/total}"))

(var bus ($event/Bus))
(var confirm_sub (bus ~ subscribe OrderPlaced confirm_order))

(var receipt (bus ~ publish (OrderPlaced ^order_id "o_1001" ^total 19.95)))
($println $"   matched=${receipt/matched} delivered=${receipt/delivered} failed=${receipt/failed}")
($println "")

# -----------------------------------------------------------------------------
# 2. Several subscribers, in subscription order
#
# Delivery order within one bus is the order the subscriptions were made, and
# it is deterministic. Subscribing the same handler twice is two independent
# subscriptions: the bus does not deduplicate, so it runs twice.
# -----------------------------------------------------------------------------
($println "2. fan-out in subscription order")

(fn reserve_stock [event : OrderPlaced]
  ($println $"   reserving stock for ${event/order_id}"))

(fn email_customer [event : OrderPlaced]
  ($println $"   emailing customer about ${event/order_id}"))

(bus ~ subscribe OrderPlaced reserve_stock)
(bus ~ subscribe OrderPlaced email_customer)

(var fanout (bus ~ publish (OrderPlaced ^order_id "o_1002" ^total 4.50)))
($println $"   ${fanout/delivered} handler(s) ran")
($println "")

# -----------------------------------------------------------------------------
# 3. Event families
#
# Layer events with a namespace and a nominal base type. The convention is the
# whole design: **each family namespace declares its base type as `Event`.**
# Subscribing to a base type matches it and every `^is` descendant, so one
# subscription observes a whole family, and `$event/Event` observes everything.
#
# There is no wildcard spelling. `X/*` already means the import wildcard, and a
# namespace that declared a `*` member would shadow multiplication inside its
# own body.
# -----------------------------------------------------------------------------
($println "3. families: base types match their descendants")

(ns shipping
  (type Event
    ^is $event/Event
    ^props {^order_id Str})

  (type Dispatched
    ^is Event
    ^props {^carrier Str})

  (type Delivered
    ^is Event
    ^props {^signed_by Str}))

(fn audit_shipping [event : shipping/Event]
  ($println $"   audit: shipping event for ${event/order_id}"))

(fn celebrate [event : shipping/Delivered]
  ($println $"   delivered, signed by ${event/signed_by}"))

(var ship_bus ($event/Bus))
(ship_bus ~ subscribe shipping/Event audit_shipping)
(ship_bus ~ subscribe shipping/Delivered celebrate)

(ship_bus ~ publish (shipping/Dispatched ^order_id "o_1001" ^carrier "post"))
(ship_bus ~ publish (shipping/Delivered ^order_id "o_1001" ^signed_by "ada"))
($println "")

# `event/exact` narrows a selector to one concrete type, excluding descendants.
($println "   ($event/exact T) excludes descendants")

(type PriorityDispatched ^is shipping/Dispatched)

(fn only_plain_dispatch [event]
  ($println "   exact handler ran"))

(ship_bus ~ subscribe ($event/exact shipping/Dispatched) only_plain_dispatch)
(ship_bus ~ publish (PriorityDispatched ^order_id "o_1003" ^carrier "air"))
($println "   ^ the exact handler did not run for the descendant")
(ship_bus ~ publish (shipping/Dispatched ^order_id "o_1004" ^carrier "van"))
($println "")

# -----------------------------------------------------------------------------
# 4. Subscription lifetime
#
# A subscription keeps its handler reachable until you cancel it or close the
# bus. Collection never cancels one — relying on nondeterministic collection
# for observable behavior would make delivery unpredictable — so release is
# always something the program did.
# -----------------------------------------------------------------------------
($println "4. cancel and one-shot subscriptions")

($println $"   cancel returned ${(confirm_sub ~ cancel)}")
($println $"   cancel again returned ${(confirm_sub ~ cancel)}   # idempotent")

(type ApplicationReady ^is $event/Event)

(fn warm_cache [event]
  ($println "   warming cache (once)"))

(var ready_bus ($event/Bus))
(ready_bus ~ subscribe ApplicationReady warm_cache ^once true)
(ready_bus ~ publish (ApplicationReady))
(ready_bus ~ publish (ApplicationReady))
($println $"   after two publishes, subscriptions left: ${(ready_bus ~ subscription_count)}")
($println "")

# -----------------------------------------------------------------------------
# 5. An event is a snapshot
#
# `publish` deep-freezes a *copy* before dispatching. Every subscriber sees the
# same frozen value, one handler cannot change what a later handler observes,
# and the publisher may keep mutating its own reference afterwards without any
# of it being visible through the event already delivered.
# -----------------------------------------------------------------------------
($println "5. subscribers receive a frozen snapshot")

(var delivered_event ($cell nil))

(fn remember [event]
  (delivered_event ~ set event))

(var snap_bus ($event/Bus))
(snap_bus ~ subscribe OrderPlaced remember)

(var draft (OrderPlaced ^order_id "o_2001" ^total 10.0))
(snap_bus ~ publish draft)
(set draft/order_id "o_2001_revised")

(var seen (delivered_event ~ get))
($println $"   publisher now holds ${draft/order_id}")
($println $"   subscriber still sees ${seen/order_id}")
($println "")

# -----------------------------------------------------------------------------
# 6. Handler errors
#
# A subscriber error must not silently stop unrelated subscribers. The bus
# attempts every matching handler, then applies its policy:
#
#   $event/raise_after (default) — raise one EventPublishError afterwards
#   $event/collect              — return the failures in the PublishResult
# -----------------------------------------------------------------------------
($println "6. one bad handler does not stop the others")

(type PaymentReceived
  ^is $event/Event
  ^props {^payment_id Str})

(fn flaky_ledger [event]
  (fail (Error ^message "ledger unavailable")))

(fn always_works [event]
  ($println $"   recorded ${event/payment_id}"))

# `collect` hands the failures back instead of raising at the publisher.
(var pay_bus ($event/Bus ^error_policy $event/collect))
(pay_bus ~ subscribe PaymentReceived flaky_ledger)
(pay_bus ~ subscribe PaymentReceived always_works)

(var pay_result (pay_bus ~ publish (PaymentReceived ^payment_id "p_1")))
($println $"   delivered=${pay_result/delivered} failed=${pay_result/failed}")

# The default policy raises after every handler has been attempted, so the
# second handler still ran before the error reached the publisher.
(var strict_bus ($event/Bus))
(strict_bus ~ subscribe PaymentReceived flaky_ledger)
(strict_bus ~ subscribe PaymentReceived always_works)

(var caught
  (try (strict_bus ~ publish (PaymentReceived ^payment_id "p_2"))
    catch (EventPublishError ^failed f) f))
($println $"   raise_after reported ${caught} failure(s), after running both")
($println "")

# -----------------------------------------------------------------------------
# 7. Sinks
#
# `EventSink` has exactly one message, `emit`. A bus implements it, and so do
# the three shipped sinks. Filtering, buffering, retries, and fan-out belong
# behind sink implementations rather than in the protocol.
# -----------------------------------------------------------------------------
($println "7. recording, null, and composite sinks")

# A recording sink is the testing tool: emit into it, then assert on what it
# collected.
(var recorder ($event/RecordingSink))
(recorder ~ EventSink:emit (PaymentReceived ^payment_id "p_10"))
(recorder ~ EventSink:emit (PaymentReceived ^payment_id "p_11"))
($println $"   recorder holds ${((recorder ~ events) ~ size)} event(s)")

# A composite fans one emission out to several sinks in order. The bus below is
# a sink like any other, so an event reaching the composite also reaches every
# subscription on that bus.
(var metrics_bus ($event/Bus))
(fn count_payment [event]
  ($println $"   metrics saw ${event/payment_id}"))
(metrics_bus ~ subscribe PaymentReceived count_payment)

(var sink ($event/CompositeSink [recorder metrics_bus ($event/NullSink)]))
(sink ~ EventSink:emit (PaymentReceived ^payment_id "p_12"))
($println $"   recorder now holds ${((recorder ~ events) ~ size)} event(s)")
($println "")

# -----------------------------------------------------------------------------
# 8. Nested publication
#
# A handler may publish. Nested publication is synchronous and depth-first: the
# inner event's handlers all run before the outer event's remaining handlers
# resume. A configurable `^nesting_limit` (default 16) bounds the recursion.
# -----------------------------------------------------------------------------
($println "8. a handler that publishes (depth-first)")

(type InvoiceRequested ^is $event/Event ^props {^order_id Str})

(var saga_bus ($event/Bus))

(fn request_invoice [event : OrderPlaced]
  ($println "   [outer] handler A starts")
  (saga_bus ~ publish (InvoiceRequested ^order_id event/order_id))
  ($println "   [outer] handler A resumes"))

(fn write_invoice [event : InvoiceRequested]
  ($println $"   [inner] invoice written for ${event/order_id}"))

(fn notify_warehouse [event : OrderPlaced]
  ($println "   [outer] handler B"))

(saga_bus ~ subscribe InvoiceRequested write_invoice)
(saga_bus ~ subscribe OrderPlaced request_invoice)
(saga_bus ~ subscribe OrderPlaced notify_warehouse)

(saga_bus ~ publish (OrderPlaced ^order_id "o_3001" ^total 99.0))
($println "")

# -----------------------------------------------------------------------------
# 9. Closing a bus
#
# `close` cancels every subscription, releases the handler references, and is
# idempotent. Afterwards `subscribe` and `publish` raise EventBusClosedError.
# This is the only deterministic way to release a bus's handlers.
# -----------------------------------------------------------------------------
($println "9. close releases the handlers")

($println $"   before close: ${(bus ~ subscription_count)} subscription(s)")
(bus ~ close)
($println $"   after close:  ${(bus ~ subscription_count)} subscription(s)")
($println
  (try (bus ~ publish (OrderPlaced ^order_id "o_9" ^total 1.0))
    catch (EventBusClosedError ^message m) $"   publish refused: ${m}"))

($println "")
($println "== done ==")
