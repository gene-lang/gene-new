# The Commons world process — docs/proposals/world.md §16.3.
#
#   gene run world create                     create a new world (once)
#   gene run world player add <id> <name...>  provision a human player; prints a login code
#   gene run world run [--port 8096]          serve the world
#   gene run world status                     print the store's summary
#
# Every command takes `--root DIR` (default `data/world`, under the launch
# directory). Creating is explicit: `run` on a missing world fails rather than
# seeding a fresh one, and `create` refuses a directory that already holds a
# world (§12.2). The store is single-writer, so provisioning happens while the
# world is not being served.

(mod world_main)

(import [create_world open_world close_world status_of] ^from "./runtime.gene")
(import [provision_player] ^from "./participants.gene")
(import [open_store close_store] ^from "./persistence.gene")
(import [serve_world] ^from "./host.gene")

(fn usage []
  ($println "usage: gene run world create|run|status [--root DIR] [--port N]")
  ($println "       gene run world player add <player_id> <display name...> [--root DIR]"))

(fn main [argv]
  (let words [])
  (var root "data/world")
  (var port 8096)
  (let args [])
  (for arg in argv (args .push ($to_str arg)))
  (var i 0)
  (while (< i args/.size)
    (let arg args/%i)
    (if (&& (== arg "--root") (< (+ i 1) args/.size))
      (then (set i (+ i 1)) (set root args/%i))
      (elif (&& (== arg "--port") (< (+ i 1) args/.size))
        (set i (+ i 1))
        (set port ($parse/parse_int args/%i)))
      (elif (== arg "--") nil)
      (else (words .push arg)))
    (set i (+ i 1)))
  (if (== words/.size 0) (return (usage)))
  (let command words/0)
  (if (== command "create")
    (do
      (let made (create_world root))
      ($println $"world: created ${made/world_id} (${made/history_id}) at ${root}")
      (return nil)))
  (if (&& (== command "player") (&& (>= words/.size 4) (== words/1 "add")))
    (do
      (let names [])
      (var k 3)
      (while (< k words/.size)
        (names .push words/%k)
        (set k (+ k 1)))
      (let store (open_store root))
      (try
        (let made (provision_player store words/2 ($str/join names " ")))
        ($println (if made/created
                    $"world: player ${words/2} added with avatar ${made/entity_id}"
                    $"world: player ${words/2} exists; issued a new login code"))
        # Printed once, to the operator's terminal, and never stored in clear.
        ($println $"login code: ${made/code}")
        ensure (close_store store))
      (return nil)))
  (if (== command "run")
    (do
      (if (|| (< port 1024) (> port 65535))
        (fail "Choose a port between 1024 and 65535."))
      (serve_world root port)
      (return nil)))
  (if (== command "status")
    (do
      (let w (open_world root))
      (try ($println ($json/stringify (status_of w)))
        ensure (close_world w))
      (return nil)))
  (usage))
