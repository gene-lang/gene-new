# The player page's stylesheet, published by the host as a same-origin asset
# (`$web/stylesheet`), so the page's CSP can forbid inline styles.
(mod page_style)

(var page_styles """
:root {
  color-scheme: light;
  --ink: #1f2a33;
  --muted: #5d6a74;
  --panel: rgba(255, 255, 255, .9);
  --line: #d7dde2;
  --accent: #2f6f6a;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 14px;
  color: var(--ink);
}
* { box-sizing: border-box; }
html, body { margin: 0; height: 100%; overflow: hidden; background: #9ec2f0; }
body.login { overflow: auto; background: #eef3f6; display: grid; place-items: center; }
.login_card { background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 24px 28px; width: min(360px, 92vw); }
.login_card label { display: block; margin: 10px 0; }
.login_card input { display: block; width: 100%; padding: 6px 8px; margin-top: 4px; border: 1px solid var(--line); border-radius: 6px; font: inherit; }
.login_message { color: #9b2c2c; min-height: 1.4em; }
button { font: inherit; cursor: pointer; border: 1px solid var(--line); border-radius: 6px; background: #fff; color: var(--ink); padding: 4px 10px; }
button:hover:not(:disabled) { background: #eef3f6; }
button:disabled { cursor: not-allowed; opacity: .45; }
.hidden { display: none !important; }
#commons_root { position: fixed; inset: 0; }
#stage { display: block; width: 100vw; height: 100vh; cursor: crosshair; }
#topbar { position: fixed; left: 12px; top: 10px; display: flex; gap: 12px; align-items: center; background: var(--panel); padding: 6px 12px; border-radius: 8px; }
#topbar form { margin: 0; }
.state { font-weight: 600; padding: 2px 8px; border-radius: 10px; background: #e3e8ec; }
.state.connected { background: #d5efe2; color: #1d5b3c; }
.state.synchronizing, .state.connecting { background: #fdf1cf; color: #7a5a00; }
.state.disconnected, .state.controlled_elsewhere { background: #f8d9d9; color: #8a1f1f; }
.state.observing { background: #e2e3f7; color: #3a3f8f; }
#hud { position: fixed; left: 12px; bottom: 10px; background: var(--panel); padding: 4px 10px; border-radius: 6px; font: 12px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; white-space: pre; }
#panel { position: fixed; right: 12px; top: 10px; width: 300px; max-height: calc(100vh - 20px); overflow: auto; display: flex; flex-direction: column; gap: 8px; }
#panel section { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 8px 12px; }
#panel h2 { font-size: 12px; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); margin: 0 0 4px; }
.buttons { display: flex; gap: 6px; margin-top: 6px; flex-wrap: wrap; }
#notice { background: #fff8e1; border: 1px solid #f0d890; border-radius: 8px; padding: 6px 10px; }
#notice:empty { display: none; }
#history_list div { border-top: 1px solid var(--line); padding: 3px 0; font-size: 12px; }
#history_list div:first-child { border-top: 0; }
.pending { color: #7a5a00; }
.rejected { color: #8a1f1f; }
.accepted { color: #1d5b3c; }
""")
