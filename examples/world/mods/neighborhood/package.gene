{
  # The Commons' neighborhood content: the ground, trees and building
  # materials the initial scene is made of, and the appearance tiles of the
  # things that live in it — the avatars, the watering can, and the markers
  # the browser draws for a pending destination and a last-saved position.
  # `core/mods.gene` registers it; a saved region keeps node names, so a later
  # module can add content without changing what an existing place means
  # (docs/proposals/world.md §5.3).
  ^format 1
  ^name "commons/neighborhood"
  ^description "Ground, building materials and appearance tiles for the Commons neighborhood"
  ^version "0.2.0"
  ^library {^entry "src/neighborhood.gene"}
}
