# The Commons' neighborhood content (docs/proposals/world.md §2.1): what the
# first scene's ground, trees, homes, paths and roofs are made of, and what its
# inhabitants and objects look like.
#
# Everything here is data a client receives rather than code it runs (§15.6):
# a node's tiles and flags, and appearance tiles an entity names in its
# `core/appearance` component. The scene itself — where the houses stand — is
# world content, laid out by `server/scene.gene` and stored with the world.

(mod neighborhood ^profile web)

(import [Content register_tile register_node] ^from "../../../core/content.gene")
(import [tile_solid tile_overlay] ^from "../../../core/tiles.gene")
(import [draw_liquid] ^from "../../../core/registry.gene")

(fn register_all [content : Content] : Nil
  (setup_tiles content)
  (setup_nodes content))

# `^spread` is how far a texel may wander from the base colour and `^seed`
# picks which noise field, so two tiles of the same colour do not share a
# texture.
(fn setup_tiles [content : Content] : Nil
  # The ground and what grows on it. These keep the colours and seeds of the
  # default content they were first drawn with, so a saved world looks as it
  # did.
  (register_tile content "commons:dirt" ^kind tile_solid
                 ^red 134.0 ^green 102.0 ^blue 72.0 ^spread 22.0 ^seed 10.0)
  (register_tile content "commons:grass_top" ^kind tile_solid
                 ^red 96.0 ^green 152.0 ^blue 72.0 ^spread 26.0 ^seed 40.0)
  # Grass seen from the side: dirt with a band of grass over the top few texels,
  # with a ragged boundary so the two do not meet in a straight line.
  (register_tile content "commons:grass_side" ^kind tile_overlay
                 ^red 96.0 ^green 152.0 ^blue 72.0 ^spread 26.0 ^seed 40.0
                 ^base_red 134.0 ^base_green 102.0 ^base_blue 72.0
                 ^base_spread 22.0 ^base_seed 10.0)
  (register_tile content "commons:sand" ^kind tile_solid
                 ^red 214.0 ^green 200.0 ^blue 152.0 ^spread 18.0 ^seed 60.0)
  # Water is drawn by the opaque pass (see the node below), so it wants a flat
  # surface colour rather than something to see through.
  (register_tile content "commons:water" ^kind tile_solid
                 ^red 46.0 ^green 98.0 ^blue 168.0 ^spread 16.0 ^seed 70.0)
  (register_tile content "commons:tree_top" ^kind tile_solid
                 ^red 122.0 ^green 92.0 ^blue 56.0 ^spread 16.0 ^seed 160.0)
  (register_tile content "commons:tree_side" ^kind tile_solid
                 ^red 104.0 ^green 76.0 ^blue 44.0 ^spread 34.0 ^seed 170.0)
  (register_tile content "commons:leaves" ^kind tile_solid
                 ^red 62.0 ^green 118.0 ^blue 48.0 ^spread 40.0 ^seed 180.0)
  # Bright and near-flat, because a light source that reads as dark stone is
  # confusing in exactly the situation it exists for.
  (register_tile content "commons:lamp" ^kind tile_solid
                 ^red 250.0 ^green 226.0 ^blue 150.0 ^spread 10.0 ^seed 150.0)
  # Building materials.
  (register_tile content "commons:plank" ^kind tile_solid
                 ^red 176.0 ^green 134.0 ^blue 86.0 ^spread 18.0 ^seed 221.0)
  (register_tile content "commons:roof" ^kind tile_solid
                 ^red 140.0 ^green 64.0 ^blue 52.0 ^spread 20.0 ^seed 223.0)
  (register_tile content "commons:path" ^kind tile_solid
                 ^red 190.0 ^green 176.0 ^blue 150.0 ^spread 24.0 ^seed 225.0)
  (register_tile content "commons:garden_soil" ^kind tile_solid
                 ^red 92.0 ^green 64.0 ^blue 42.0 ^spread 26.0 ^seed 227.0)
  # Appearance tiles for entities. An avatar is a person-sized box of its own
  # colour; the watering can is the one unique movable object of Milestone 1.
  (register_tile content "commons:avatar_amber" ^kind tile_solid
                 ^red 222.0 ^green 142.0 ^blue 70.0 ^spread 12.0 ^seed 229.0)
  (register_tile content "commons:avatar_teal" ^kind tile_solid
                 ^red 58.0 ^green 150.0 ^blue 150.0 ^spread 12.0 ^seed 231.0)
  (register_tile content "commons:avatar_violet" ^kind tile_solid
                 ^red 132.0 ^green 96.0 ^blue 184.0 ^spread 12.0 ^seed 233.0)
  (register_tile content "commons:watering_can" ^kind tile_solid
                 ^red 70.0 ^green 130.0 ^blue 196.0 ^spread 10.0 ^seed 235.0)
  # Browser markers (§6.5, §15.3). The pending destination is not arrival, and
  # the last-saved position is not the live one; each has its own look.
  (register_tile content "commons:marker_pending" ^kind tile_solid
                 ^red 250.0 ^green 250.0 ^blue 120.0 ^spread 4.0 ^seed 237.0)
  (register_tile content "commons:marker_saved" ^kind tile_solid
                 ^red 235.0 ^green 235.0 ^blue 235.0 ^spread 4.0 ^seed 239.0)
  (register_tile content "commons:marker_selected" ^kind tile_solid
                 ^red 255.0 ^green 96.0 ^blue 96.0 ^spread 4.0 ^seed 241.0)
  # The fallback for an appearance this client does not know (§15.6).
  (register_tile content "commons:unknown" ^kind tile_solid
                 ^red 255.0 ^green 0.0 ^blue 255.0 ^spread 30.0 ^seed 243.0))

# Almost every node is a solid opaque cube and says nothing about that: the
# defaults are what a node is unless it declares otherwise, which leaves the
# three that are different — water, leaves and the lamp — visibly different
# here.
(fn setup_nodes [content : Content] : Nil
  (register_node content "commons:grass"
                 ^tiles ["commons:grass_top" "commons:grass_side"
                         "commons:dirt"])
  (register_node content "commons:sand" ^tiles ["commons:sand"])
  # Water is registered opaque, and that is a compromise rather than a claim
  # about water: `^opaque` means "hides the face behind it", which puts the
  # pond's surface in the opaque draw pass — visible, and with no faces wasted
  # on its floor.
  (register_node content "commons:water" ^tiles ["commons:water"]
                 ^drawtype draw_liquid
                 ^!solid
                 ^^propagates_light)
  # The trunk shows its rings on the cut faces and its bark on the sides.
  (register_node content "commons:tree"
                 ^tiles ["commons:tree_top" "commons:tree_side"
                         "commons:tree_top"])
  # Leaves let light through and do not hide what is behind them. A face
  # between two leaves shows nothing, so `^merges_same` leaves it undrawn.
  (register_node content "commons:leaves" ^tiles ["commons:leaves"]
                 ^!opaque
                 ^^merges_same
                 ^^propagates_light)
  (register_node content "commons:lamp" ^tiles ["commons:lamp"]
                 ^light_source 14.0)
  # Wooden planks, roof tiles, the packed path and the garden's soil.
  (register_node content "commons:plank" ^tiles ["commons:plank"])
  (register_node content "commons:roof" ^tiles ["commons:roof"])
  (register_node content "commons:path" ^tiles ["commons:path"])
  (register_node content "commons:garden_soil" ^tiles ["commons:garden_soil"]))
