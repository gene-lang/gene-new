# The VM shell for the pointing spec.
#
#   gene run raycast_spec
#
# Pair with `node tools/web_spec.mjs web_raycast_spec` and diff: the two must
# agree exactly.

(mod run_raycast_spec)

(import [report failures] ^from "./raycast_spec.gene")

(fn main [args] : Nil
  ($println (report))
  (var bad (failures))
  ($println "")
  (if (== bad 0.0)
    (then ($println "PASS — every check agrees"))
    (else ($println $"FAIL — ${bad} check(s) failed"))))
