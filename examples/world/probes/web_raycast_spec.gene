# The web-profile shell for the pointing spec.
#
#   gene build --target web probes/web_raycast_spec.gene --out-dir dist
#   node tools/web_spec.mjs web_raycast_spec
#
# Counterpart to `probes/run_raycast_spec.gene`, line for line: the only
# difference is `$console/log` where the VM has `$println`. Both shells add
# nothing to the report, so a difference between the two outputs is a
# difference between the runtimes. The work is in `main` because the web
# profile has no top-level statements — a module exports an entry and the host
# calls it.

(mod web_raycast_spec ^profile web)

(import [report failures] ^from "./raycast_spec.gene")

(fn main [] : Void
  ($console/log (report))
  ($console/log "")
  (var bad (failures))
  (if (== bad 0.0)
    (then ($console/log "PASS — every check agrees"))
    (else ($console/log $"FAIL — ${bad} check(s) failed"))))
