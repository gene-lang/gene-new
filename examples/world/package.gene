{
  # The Commons (docs/proposals/world.md). SOURCES.md has the provenance of the
  # code that was copied from Miclone to start it.
  ^format 1
  ^name "gene/world"
  ^description "The Commons — a shared persistent human–AI world (Gene World)"
  ^version "0.1.0"
  ^library {^entry "core/world.gene"}
  ^applications [
    # The Commons world process (docs/proposals/world.md §16.3).
    (application "world" ^entry "server/main.gene")

    # The web build of every portable module (`gene run build_web`).
    (application "build_web" ^entry "tools/build_web.gene")
  ]
}
