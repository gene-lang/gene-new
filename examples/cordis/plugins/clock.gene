(mod clock_plugin)

(import [PluginSpec] from "../src/plugin_api")
(import [Clock clock_key] from "../src/demo_contract")

(type CounterClock ^props {^counter Cell})
(impl Clock for CounterClock
  (message tick [] : Int
    (var current (self/counter .get))
    (self/counter .set (+ current 1))
    current))

(fn activate [ctx, config]
  (ctx .provide clock_key (CounterClock ^counter ($cell 1))))

(var plugin
  (PluginSpec ^id "core/clock" ^config_schema nil ^requires []
              ^provides [clock_key] ^reload nil ^activate activate))
