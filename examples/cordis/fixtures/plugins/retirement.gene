(mod retirement_provider)
(import [PluginSpec] ^from "../../src/plugin_api")
(import [LoadedValue loaded_key] ^from "../contract")

(type RetiringValue ^props {^n Int ^closed Any})
(impl LoadedValue for RetiringValue
  (message value [] : Int
    ($assert (! (self/closed .get)) "retired provider is closed")
    self/n))

(fn activate [ctx config]
  (let closed ($cell false))
  (ctx .defer (fn [] (closed .set true)))
  (ctx .provide loaded_key (RetiringValue ^n config ^closed closed)))

(var plugin (PluginSpec ^id "fixture/retirement" ^config_schema nil ^requires []
  ^provides [loaded_key] ^reload nil ^activate activate))
