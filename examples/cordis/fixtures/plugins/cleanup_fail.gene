(mod cleanup_fail_provider)

(import [PluginSpec] from "../../src/plugin_api")
(import [LoadedValue loaded_key] from "../contract")

(type CleanupFailure ^props {^message Str} ^impl [Error])
(impl Error for CleanupFailure)

(type CleanupValue ^props {^n Int})
(impl LoadedValue for CleanupValue
  (message value [] : Int self/n))

(fn activate [ctx, config]
  (ctx .defer
    (fn [] (fail (CleanupFailure ^message "retirement failed"))))
  (ctx .provide loaded_key (CleanupValue ^n config)))

(var plugin
  (PluginSpec ^id "fixture/cleanup_fail" ^config_schema nil ^requires []
              ^provides [loaded_key] ^reload nil ^activate activate))
