(mod cordis_quiescence_spec)

(import $test [describe it after_each assert_equal])

(import [HookMode RuntimeOptions PluginSpec PluginCallKind invocation_limits hook_key
         default_plugin_invoker new_runtime invoke_effect_owner]
  ^from "../src/cordis")

(describe "Cordis quiescence"
  (after_each [t]
    (if_not ($absent? t/runtime) t/runtime/.close))

  (it "releases concurrent and cancelled admissions before disposal" [t]
    (let owner ($cell nil))
    (let cleaned ($cell false))
    (let runtime (new_runtime (RuntimeOptions ^logger nil ^invoker (default_plugin_invoker)
      ^default_limits (invocation_limits))))
    (set t/runtime runtime)
    (let plugin (PluginSpec ^id "cancelled-admissions" ^config_schema nil ^requires []
      ^provides [] ^reload nil ^activate (fn [ctx config]
        (ctx .defer (fn [] (cleaned .set true)))
        (ctx .effect "calls" (fn [scope] (owner .set scope))))))
    (let instance (runtime .install runtime/.root plugin nil))
    instance/.await_ready
    (scope
      (let calls [])
      (repeat 24
        (calls .push (spawn ^lane root
          (invoke_effect_owner owner/.get PluginCallKind/operation
            (fn [] ($sleep 20)) []))))
      ($sleep 1)
      (for call in calls call/.cancel)
      (for call in calls call/.join))
    instance/.dispose
    runtime/.await_settled
    ($assert cleaned/.get "cancelled admission kept its owner alive"))

  (it "waits for entered hook calls before running owner cleanup" [t]
    (var hook (hook_key "slow" HookMode/emit))
    (var events ($cell ($thaw #[])))
    (fn record [name : Str] (events/.get .push name))

    (fn slow_handler [payload]
      (record "handler-start")
      ($sleep 20)
      (record "handler-end"))

    (fn activate [ctx, config]
      (ctx .defer (fn [] (record "cleanup")))
      (ctx .on hook slow_handler))

    (var plugin
      (PluginSpec ^id "quiescence" ^config_schema nil ^requires []
                  ^provides [] ^reload nil ^activate activate))
    (var runtime
      (new_runtime
        (RuntimeOptions ^logger nil ^invoker (default_plugin_invoker)
                        ^default_limits (invocation_limits))))
    (set t/runtime runtime)
    (runtime .admit_hook_key hook)
    (var instance (runtime .install runtime/.root plugin nil))
    instance/.await_ready
    (var dispatch
      (spawn ^lane root (runtime/.root .dispatch hook nil)))
    ($sleep 2)
    instance/.dispose
    runtime/.await_settled
    dispatch/.join
    (assert_equal events/.get ["handler-start" "handler-end" "cleanup"]
      "unload must wait for entered calls before running cleanup")))

(describe "Cordis inherited deadlines"
  (it "retires a supervised evaluator before an expired caller returns" []
    (let owner ($cell nil))
    (let runtime (new_runtime (RuntimeOptions ^logger nil ^invoker (default_plugin_invoker)
      ^default_limits (invocation_limits))))
    (let repl ($repl/open (env)))
    (let entered ($cell false))
    (try
      ($repl/eval repl "(var retained 42) (fn wait [] ($sleep 10000))")
      (let plugin (PluginSpec ^id "deadline-owner" ^config_schema nil ^requires []
        ^provides [] ^reload nil ^activate (fn [ctx config]
          (ctx .effect "calls" (fn [scope] (owner .set scope))))))
      (let instance (runtime .install runtime/.root plugin nil))
      instance/.await_ready
      (let invoke ($runtime/bind_call ^policy {^timeout_ms 100}
        (fn [] (invoke_effect_owner owner/.get PluginCallKind/operation
          (fn [] (entered .set true) ($repl/eval repl "(wait)")) [])) []))
      (scope
        (let caller (spawn ^lane root (invoke)))
        (let timeout (spawn ^lane root (do ($sleep 110) caller/.cancel)))
        (try
          (let outcome caller/.join)
          ($assert (!= ($head outcome) TaskOutcome/ok))
          ensure timeout/.cancel timeout/.join))
      # This is refused as busy if invocation cleanup orphaned the evaluator.
      ($assert entered/.get "fixture expired before entering its supervised evaluator")
      (assert_equal ($repl/eval repl "retained") 42)
      instance/.dispose
      runtime/.await_settled
      ensure
        ($repl/close repl)
        runtime/.close)))
