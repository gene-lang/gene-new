(mod cordis_loader_capabilities_spec)

(import $test [describe it after_each assert_equal assert_raises])

(import [ReconcileMode RuntimeOptions LoaderOptions CompositionError
         invocation_limits default_plugin_invoker new_runtime]
  ^from "../src/cordis")

(describe "Cordis loader_capabilities"
  (after_each [t]
    (if_not ($absent? t/runtime) (t/runtime .close)))

  (it "rejects filesystem access without an explicit plugin capability" [t]
    (var runtime
      (new_runtime
        (RuntimeOptions ^logger nil ^invoker (default_plugin_invoker)
                        ^default_limits (invocation_limits))))
    (set t/runtime runtime)
    (var loader
      (runtime .loader
        (LoaderOptions ^plugin_root "fixtures/plugins"
          ^shared ["src/plugin_api.gene"] ^max_namespaces ["fs"]
          ^capability_catalog #{} ^capability_ceiling #[]
          ^default_limits nil ^reload_policy nil)))
    (var manifest
      {^format 1
       ^entries [
         {^id "needs_fs" ^module "needs_fs.gene" ^config nil
          ^namespaces ["fs"] ^capabilities []}
       ]})
    (assert_raises
      (fn [] (loader .reconcile manifest ReconcileMode/staged))
      CompositionError
      "an empty manifest capability row must not inherit host filesystem access")
    (var inspection (loader .inspect))
    (assert_equal inspection/entries #[]
      "a capability-denied staged candidate must leave composition unchanged")
    (loader .dispose)))
