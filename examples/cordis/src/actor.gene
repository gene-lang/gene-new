# Cross-lane service adapter. The actor owns the mutable state and typed,
# bounded mailbox; Cordis owns the supervisor task that keeps it alive.

(mod actor)

(import [PluginCallKind] from "./model")
(import [invoke_effect_owner spawn_effect_call] from "./runtime")

(type GuardedActorHandler
  ^private true
  ^props {^owner Any ^callable Any}
  (impl Callable
    (message apply [self, call]
      (invoke_effect_owner self/owner PluginCallKind/activate
                           self/callable call/body))))

(fn supervise_actor ^^private [ready, initial, handler, mailbox, message_type]
  (scope
    (var actor
      (if ($absent? message_type)
        ($actor/spawn ^mailbox mailbox
          ^init (fn [] initial) ^handle handler)
        ($actor/spawn ^mailbox mailbox ^type message_type
          ^init (fn [] initial) ^handle handler)))
    (ready .send actor)
    # This supervisor is host-owned. Each handler invocation has its own
    # policy; the actor lifetime is not the initialization call's deadline.
    ($sleep 2147483647)))

(fn owned_actor
  [owner, label : Str, init, handler,
   ^mailbox mailbox : Int = 64, ^type message_type = nil]
  (var ready ($channel ^capacity 1))
  (var initial
    (invoke_effect_owner owner PluginCallKind/activate init []))
  (var guarded_handler (GuardedActorHandler ^owner owner ^callable handler))
  (spawn_effect_call owner label supervise_actor
    [ready initial guarded_handler mailbox message_type])
  (ready .recv))
