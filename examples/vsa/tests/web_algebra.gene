# The web-profile shell for the cross-backend algebra spec.
#
#   gene build --target web tests/web_algebra.gene --out-dir dist
#   node -e "import('./dist/web_algebra.mjs').then(m => m.main())"
#
# Counterpart to `tests/run_algebra.gene`. The work is in `main` because the web
# profile has no top-level statements: a module exports an entry and the host
# calls it.

(mod web_algebra ^profile web)

(import [report] from "./algebra.gene")

(fn main [] : Void
  ($console/log (report)))
