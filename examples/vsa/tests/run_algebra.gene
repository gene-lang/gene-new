# The VM shell for the cross-backend algebra spec.
#
#   gene run algebra                                       # this file, VM
#   node -e "import('./dist/algebra_web.mjs').then(m => m.main())"
#
# Counterpart to `tests/web_algebra.gene`, and a line-for-line one: the only
# difference is `$println` where the web profile has `$console/log`, because
# printing is the one thing the shared module cannot do (miclone's design.md
# §14 records the same split). Both shells add nothing to the report, so a
# difference between the two outputs is a difference between the runtimes —
# which is the entire point of running it twice.

(import [report] from "./algebra.gene")

($println (report))
