# Cross-backend spec for the summary codec and the associative index —
# docs/proposals/vsa.md §6.2, §7, and gate G5.
#
# §8 notes that a cleanup memory and an associative index are the same
# structure: keys in, exact values fetched from the Gene store afterwards. So
# this file covers both — the codec's round trip, and retrieval of whole records
# from a *partial* query, which is the first thing in the whole proposal with
# standalone user value.

(mod codec_spec ^profile web)

(import [VsaSpace CleanupMemory] from "../src/space.gene")
(import [MapSpace new_space] from "../src/backends/map.gene")
(import [Codebook new_codebook verify_intact codebook_size]
        from "../src/codebook.gene")
(import [LinearMemory new_memory remember_atoms] from "../src/memory/linear.gene")
(import [encode_pairs encode_head encode_sequence query_role query_position
         filler_names concept_of value_name]
        from "../src/codec/summary.gene")
(import [ScalarEncoder new_encoder encode_number decode_number]
        from "../src/codec/scalar.gene")

(const dim 2048.0)
(const floor 0.15)

(fn ok [lines : (List Str) label : Str pass : Bool] : F64
  (lines ~ push! (if pass $"ok   ${label}" $"FAIL ${label}"))
  (if pass 0.0 1.0))

(fn buf [] : (Buffer F64) ($buffer F64 dim))

(fn abs_f [x : F64] : F64 (if (< x 0.0) (- 0.0 x) x))

# One record: head + its role/filler pairs, as a summary vector.
(fn encode_record [book : Codebook head : Str roles : (List Str)
                   fillers : (List Str) out : (Buffer F64)] : Nil
  (encode_head book head out)
  (encode_pairs book roles fillers out)
  nil)

(fn report [] : Str
  (var lines : (List Str) [])
  (var f 0.0)
  (var s (new_space dim 42.0))
  (var book (new_codebook s))

  # The cleanup memory holds the *filler* vocabulary, which is stored under
  # `vsa/val/` names rather than bare concept names.
  (var concepts : (List Str)
    ["Alice" "Bob" "Carol" "Raleigh" "Durham" "Boston" "AI" "music" "chess"
     "person" "office" "conference"])
  (var vocab (new_memory s))
  (remember_atoms book vocab (filler_names concepts))

  # --- the round trip --------------------------------------------------------

  (var rec (buf))
  (encode_record book "person" ["name" "city" "topic"] ["Alice" "Raleigh" "AI"] rec)

  (var got (buf))
  (query_role book rec "city" got)
  (set f (+ f (ok lines "a role query returns that role's filler"
                  (== (concept_of (vocab ~ CleanupMemory:nearest got floor))
                      "Raleigh"))))

  (query_role book rec "topic" got)
  (set f (+ f (ok lines "and another role returns its own"
                  (== (concept_of (vocab ~ CleanupMemory:nearest got floor))
                      "AI"))))

  (query_role book rec "salary" got)
  (set f (+ f (ok lines "a role the record does not carry returns nothing"
                  (== (vocab ~ CleanupMemory:nearest got floor) ""))))

  # --- the head disambiguates ------------------------------------------------

  (var office (buf))
  (encode_record book "office" ["city"] ["Raleigh"] office)
  (var person (buf))
  (encode_record book "person" ["city"] ["Raleigh"] person)
  (set f (+ f (ok lines "two heads over the same field are different vectors"
                  (< (s ~ VsaSpace:similarity office person) 0.7))))

  # --- ordered items ---------------------------------------------------------

  (var seq (buf))
  (encode_sequence book ["Alice" "Bob" "Carol"] seq)
  (query_position book seq 1.0 got)
  (set f (+ f (ok lines "a positional query returns that position's item"
                  (== (concept_of (vocab ~ CleanupMemory:nearest got floor))
                      "Bob"))))
  (query_position book seq 0.0 got)
  (set f (+ f (ok lines "and position 0 is not position 1"
                  (== (concept_of (vocab ~ CleanupMemory:nearest got floor))
                      "Alice"))))

  (set f (+ f (ok lines "concept_of undoes value_name"
                  (== (concept_of (value_name "Raleigh")) "Raleigh"))))

  # --- gate G5: retrieval from a partial query -------------------------------
  #
  # The index is a cleanup memory whose keys are record ids. A query is a
  # summary built from *some* of the fields, and the right record should come
  # back — that is the whole point of an approximate index.

  (var index (new_memory s))
  (var e1 (buf))
  (encode_record book "person" ["name" "city" "topic"] ["Alice" "Raleigh" "AI"] e1)
  (index ~ CleanupMemory:remember "person_1" e1)

  (var e2 (buf))
  (encode_record book "person" ["name" "city" "topic"] ["Bob" "Durham" "music"] e2)
  (index ~ CleanupMemory:remember "person_2" e2)

  (var e3 (buf))
  (encode_record book "person" ["name" "city" "topic"] ["Carol" "Boston" "chess"] e3)
  (index ~ CleanupMemory:remember "person_3" e3)

  # Two of three fields, no name.
  (var q (buf))
  (encode_record book "person" ["city" "topic"] ["Raleigh" "AI"] q)
  (set f (+ f (ok lines "a 2-of-3 partial query finds its record"
                  (== (index ~ CleanupMemory:nearest q floor) "person_1"))))

  # One field of three.
  (var q1 (buf))
  (encode_record book "person" ["city"] ["Durham"] q1)
  (set f (+ f (ok lines "a 1-of-3 partial query still finds its record"
                  (== (index ~ CleanupMemory:nearest q1 floor) "person_2"))))

  # A query whose fields belong to no stored record should decline rather than
  # return the least-bad match. This is the assertion that separates an index
  # from a random guess.
  (var q2 (buf))
  (encode_record book "person" ["city" "topic"] ["Boston" "music"] q2)
  (var answer (index ~ CleanupMemory:nearest q2 0.6))
  (set f (+ f (ok lines "a query mixing two records does not confidently pick one"
                  (== answer ""))))

  # --- §6.5: a continuous value is not an atom ------------------------------
  #
  # The property that matters is **locality**: similarity has to fall off with
  # distance, or "about this warm" is not a query. Atoms would give ~0 for any
  # two distinct values, which is why numbers get their own encoder.

  (var enc (new_encoder "temp" 0.0 100.0))
  (var at50 (buf))
  (var other (buf))
  (encode_number book enc 50.0 at50)

  (encode_number book enc 50.0 other)
  (set f (+ f (ok lines "a scalar encodes identically to itself"
                  (> (s ~ VsaSpace:similarity at50 other) 0.999))))

  (encode_number book enc 55.0 other)
  (var near (s ~ VsaSpace:similarity at50 other))
  (encode_number book enc 90.0 other)
  (var far (s ~ VsaSpace:similarity at50 other))
  (set f (+ f (ok lines "a near value scores above a far one"
                  (> near far))))
  (set f (+ f (ok lines "a near value is still clearly similar"
                  (> near 0.9))))
  (set f (+ f (ok lines "and a far one has decayed but not to noise"
                  (< far 0.7))))

  # Monotone as the value moves *away in one direction*. Sweeping across the
  # anchor instead measures a rise-then-fall, which is not monotone and is what
  # the first version of this check got wrong.
  (var prev 2.0)
  (var monotone true)
  (var step 0.0)
  (while (< step 6.0)
    (encode_number book enc (+ 50.0 (* step 10.0)) other)
    (var sim (s ~ VsaSpace:similarity at50 other))
    (if (> sim prev) (set monotone false))
    (set prev sim)
    (set step (+ step 1.0)))
  (set f (+ f (ok lines "similarity falls monotonically with distance"
                  monotone)))

  (encode_number book enc 37.0 other)
  (set f (+ f (ok lines "decode recovers the value it encoded"
                  (< (abs_f (- (decode_number book enc other 100.0) 37.0)) 1.0))))

  # Clamping, not raising: a measurement off the end of its range is a real
  # thing and the honest encoding is "at the end".
  (var over (buf))
  (var atmax (buf))
  (encode_number book enc 500.0 over)
  (encode_number book enc 100.0 atmax)
  (set f (+ f (ok lines "a value past the range clamps to the end"
                  (> (s ~ VsaSpace:similarity over atmax) 0.999))))

  # --- §5: the codebook is interned, and interning has one hazard ------------
  #
  # `atom_ref` hands out the codebook's own storage, so a codec that wrote
  # through a borrowed atom would corrupt every later encode — plausible
  # similarities against a wrong vector, and every assertion above would keep
  # passing. Everything in this suite has now run against `book`; each stored
  # atom must still equal what the space generates for its name.
  (set f (+ f (ok lines "the codebook survives a full round trip unwritten"
                  (== (verify_intact book) 0.0))))
  (set f (+ f (ok lines "and it interned enough to be wrong about"
                  (> (codebook_size book) 10.0))))

  (lines ~ push! "")
  (lines ~ push! (if (== f 0.0)
                   "PASS — every check agrees"
                   "FAIL — see the FAIL lines above"))
  ($str/join lines "\n"))
