# Spec for the code-search example — docs/proposals/vsa.md §8 and gate G7.
#
# **VM-only**, like `tests/node.gene`: the search walks nodes, which the web
# profile cannot do (see `src/codec/node.gene`). No web shell, on purpose.
#
# The corpus is a literal here rather than files on disk. That keeps the suite
# deterministic, keeps it from needing filesystem authority, and keeps it
# passing when the package's own source is edited — `gene run code_search` is
# the version that reads real files, and it is a demo rather than a fixture.
#
# What is asserted is **properties, not numbers**: which family ranks first,
# and that an unrelated query declines. The scores themselves move whenever the
# codebook or the codec changes, and pinning them would make this suite a
# tripwire for changes that are fine.

(import [CodeIndex new_code_index index_source indexed_count search search_one
         Calibration calibrate default_floor]
        from "../src/examples/code_search.gene")

(const dim 1024.0)

(fn ok [lines label pass]
  (lines ~ push! (if pass $"ok   ${label}" $"FAIL ${label}"))
  (if pass 0.0 1.0))

# Two families that should stay apart: string name builders, and F64 modular
# arithmetic. Plus loops, so the corpus is not trivially two clusters.
(const names_src "
(fn role_name [role : Str] : Str $\"vsa/role/${role}\")
(fn value_name [v : Str] : Str $\"vsa/val/${v}\")
(fn head_name [] : Str \"vsa/head\")
(fn label_of [x : Str] : Str $\"lbl/${x}\")
")

(const math_src "
(fn wrap32 [x : F64] : F64 (- x (* ($math/floor (/ x m)) m)))
(fn fold [x : F64 by : F64] : F64 (wrap32 (+ x ($math/floor (/ x by)))))
(fn halve [y : F64] : F64 (- y (* ($math/floor (/ y 2.0)) 2.0)))
")

(const loop_src "
(fn gather [xs : (List Str)] : (List Str)
  (var out : (List Str) [])
  (var i 0.0)
  (while (< i 3.0) (out ~ push! xs/%i) (set i (+ i 1.0)))
  out)
(fn total [b : (Buffer F64)] : F64
  (var acc 0.0)
  (var i 0.0)
  (while (< i 8.0) (set acc (+ acc (b ~ get i))) (set i (+ i 1.0)))
  acc)
")

(fn family_of [label : Str] : Str
  (var parts ($str/split label ":"))
  parts/0)

(fn report []
  (var lines [])
  (var f 0.0)

  (var idx (new_code_index dim))
  (var n_names (index_source idx "names" names_src))
  (var n_math (index_source idx "math" math_src))
  (var n_loops (index_source idx "loops" loop_src))

  (set f (+ f (ok lines "only definitions are indexed, and every one of them"
                  (== (indexed_count idx) 9.0))))
  (set f (+ f (ok lines "each source contributes its own definitions"
                  (&& (== n_names 4.0) (&& (== n_math 3.0) (== n_loops 2.0))))))

  # --- calibration -----------------------------------------------------------
  #
  # The point of measuring the floor rather than picking one: two functions are
  # not near-orthogonal the way two atoms are, so the unrelated-pair mean sits
  # well above zero and a cleanup-style 0.15 would admit anything.
  (var cal (calibrate idx))
  (set f (+ f (ok lines "unrelated functions are similar well above zero"
                  (> cal/mean 0.05))))
  (set f (+ f (ok lines "and not so similar that nothing is distinguishable"
                  (< cal/mean 0.5))))
  # The finding that made the floor a constant: on a small clustered corpus
  # `mean + 2sd` lands above every true match, because most pairs here are
  # same-family and the mean tracks the very matches it should be a baseline
  # for. This asserts that failure so the reasoning in `code_search.gene`
  # cannot quietly stop being true.
  (set f (+ f (ok lines "mean + 2sd would reject every real match at this size"
                  (> (+ cal/mean (* 2.0 cal/sd)) 0.5))))
  (set f (+ f (ok lines "the measured floor sits below it"
                  (< default_floor (+ cal/mean (* 2.0 cal/sd))))))

  # --- retrieval by shape ----------------------------------------------------
  #
  # Every query is a function that is *not* in the corpus. That is the claim
  # worth testing: G7's own suite compares three literals against each other,
  # which shows encodings differ but not that an unseen query lands anywhere.

  (var labels [])
  (var scores [])
  (search idx (quote (fn tag_name [tag : Str] : Str $"x/tag/${tag}"))
          3.0 default_floor labels scores)
  (set f (+ f (ok lines "a novel name builder retrieves the name builders"
                  (== (family_of labels/0) "names"))))
  (set f (+ f (ok lines "and its best match clears the floor"
                  (> scores/0 default_floor))))

  (var labels2 [])
  (var scores2 [])
  (search idx (quote (fn clamp32 [y : F64] : F64
                       (- y (* ($math/floor (/ y k)) k))))
          3.0 default_floor labels2 scores2)
  (set f (+ f (ok lines "a novel modular helper retrieves the arithmetic family"
                  (== (family_of labels2/0) "math"))))

  (var labels3 [])
  (var scores3 [])
  (search idx (quote (fn collect [ys : (List Str)] : (List Str)
                       (var acc : (List Str) [])
                       (var j 0.0)
                       (while (< j 5.0) (acc ~ push! ys/%j) (set j (+ j 1.0)))
                       acc))
          3.0 default_floor labels3 scores3)
  (set f (+ f (ok lines "a novel list loop retrieves a loop"
                  (== (family_of labels3/0) "loops"))))

  # Ranking is ordered, which is the difference between a ranking and a set.
  (set f (+ f (ok lines "results come back best first"
                  (if (< (scores ~ size) 2) true (>= scores/0 scores/1)))))

  # --- the decline -----------------------------------------------------------
  #
  # The assertion that separates a search from a guess, and the one the demo
  # got wrong until the floor was measured: with a floor carried over from
  # cleanup, this query returned five confident rows about code the corpus has
  # never contained.
  (var labels4 [])
  (var scores4 [])
  (search idx (quote (fn handle_request [req : Request] : Response
                       (var payload ($json/stringify req/params))
                       (Response ^status 200 ^body payload)))
          5.0 default_floor labels4 scores4)
  (set f (+ f (ok lines "an unrelated query declines rather than guessing"
                  (== (labels4 ~ size) 0))))
  (set f (+ f (ok lines "search_one declines on the same query"
                  (== (search_one idx
                        (quote (fn handle_request [req : Request] : Response
                                 (Response ^status 200)))
                        default_floor)
                      ""))))

  # A node carrying a `body` prop is exactly what broke the walker the first
  # time it met real source: `node/body` answers the prop and `(node ~ body)`
  # answers the anatomy. The query above contains one, so reaching this line at
  # all is the regression test — it used to raise "cannot iterate vkSymbol".
  (set f (+ f (ok lines "a node with head/body/props props still encodes"
                  (> (indexed_count idx) 0.0))))

  (lines ~ push! "")
  (lines ~ push! (if (== f 0.0)
                   "PASS — every check agrees"
                   "FAIL — see the FAIL lines above"))
  ($str/join lines "\n"))
