# Encoding an actual Gene node — docs/proposals/vsa.md §6.1, §6.3, §6.4.
#
# **This module is VM-only, and that is a finding rather than a preference.**
# Two things it needs do not exist in the web profile:
#
#   * **A node's props cannot be enumerated.** `Map` there has `get` and `size`
#     and no `keys`/`values`/`entries`/`pairs`, and `for` refuses to iterate the
#     `Any` that `node/props` types as. So §6.1's normalization — props into
#     relational form — cannot be written portably.
#   * **`match` type patterns are miscompiled.** `(when (s : Str) …)` is emitted
#     as a *node literal* pattern (head `s`, body `[: Str]`), so it matches a
#     2-element node and otherwise falls silently through to `else`. Walking a
#     tree means asking "leaf or node?", and on that backend the answer is
#     always "else".
#
# Which is why `summary.gene` — the *default* codec of §6.2 — takes names rather
# than nodes and is portable. This module is the ingest side: it turns a node
# into the names that codec wants, and it runs where the data lives.

(import [VsaSpace] from "../space.gene")
(import [MapSpace new_space] from "../backends/map.gene")
(import [Codebook atom_ref] from "../codebook.gene")
(import [role_name position_name head_name value_name]
        from "./summary.gene")

# §6.1: `(person ^name "Alice")` is normalized to the relational
# `(person (prop name "Alice"))` before encoding. The lowered form preserves
# that the relation *was* a property, which is what makes it reversible; a codec
# that emitted `(name "Alice")` could not tell a prop from a child.
#
# Returns a list of `[role filler]` pairs, which is exactly what
# `summary.gene`'s `encode_pairs` consumes.
(fn normalize_props [node]
  (var out [])
  (for entry in node/props
    (out ~ push! [$"${entry/0}" entry/1]))
  out)

# §6.4: source and debug metadata is excluded. It does not participate in
# semantic equality and would spend capacity on nothing.
#
# The rule is "exclude source/debug meta", not "exclude meta" — in this repo
# `meta` also carries annotations that *are* semantic, `@route` being the one
# that drives route discovery. So the include list is explicit and empty by
# default rather than the whole map being dropped.
(fn normalize_meta [node include]
  (var out [])
  (if (> (include ~ size) 0)
    (for entry in node/meta
      (var key $"${entry/0}")
      (if (include ~ contains key)
        (out ~ push! [key entry/1]))))
  out)

# A leaf becomes a name. A number becomes a name too, which destroys locality —
# that is what `scalar.gene` is for, and a caller who has continuous quantities
# should encode those fields itself rather than let this flatten them.
(fn leaf_name [v]
  (match v
    (when (s : Str) $"${s}")
    (when (y : Sym) $"${y}")
    (when (b : Bool) (if b "true" "false"))
    (else $"${v}")))

(fn is_node [v] (match v (when (n : Node) true) (else false)))

# §6.3: recursive, and **bounded**. Below the depth limit a child is embedded by
# reference — its own summary is not expanded — which is §6.2's rule applied one
# level down rather than a separate mechanism.
#
# The default depth is 3, measured by gate G3: payload similarity is 71/58/50/44%
# at depths 1..4, and the decay is independent of dimension, so this is a
# structural limit rather than one a bigger space fixes.
(fn encode_node [book node depth out]
  (var space book/space)
  (var dim book/dim)
  # `pair` is the only buffer this call owns and the only one it writes. Roles
  # and leaf fillers are borrowed from the codebook, and a nested child's vector
  # is allocated by `encode_value` rather than cleared here.
  (var pair ($buffer F64 dim))

  # head
  (var head_role (atom_ref book (head_name)))
  (var head_v (atom_ref book (value_name (leaf_name node/head))))
  (space ~ VsaSpace:bind head_role head_v pair)
  (space ~ VsaSpace:bundle_into pair out)

  # props, lowered to relations
  (for entry in (normalize_props node)
    (var role (atom_ref book (role_name entry/0)))
    (var filler (encode_value book entry/1 (- depth 1.0)))
    (space ~ VsaSpace:bind role filler pair)
    (space ~ VsaSpace:bundle_into pair out))

  # body, by position
  (var i 0.0)
  (for item in node/body
    (var role (atom_ref book (position_name i)))
    (var filler (encode_value book item (- depth 1.0)))
    (space ~ VsaSpace:bind role filler pair)
    (space ~ VsaSpace:bundle_into pair out)
    (set i (+ i 1.0)))
  nil)

# The encoded value, **returned rather than written into a caller's buffer**.
#
# This is the one place the package departs from §3.3, and it is departed from
# for a measured reason. The previous shape took an `out` and cleared it on
# entry, because a nested node bundles into it. Clearing a D=512 buffer in a
# Gene loop costs 267 us; allocating a fresh one costs 4.5 us, because the
# allocator hands back zeroed memory and the loop does not — so the clear was
# 59x the thing it replaced. And in the *leaf* case, which is most props, the
# clear was pure waste: the atom overwrote every component anyway.
#
# §3.3's argument is about memory — a returning `bind` would allocate 64 MB to
# bundle a thousand observations — and it still holds for the algebra. Here the
# nested case allocates exactly one buffer either way, and the leaf case now
# allocates none at all.
#
# **The result may be borrowed.** For a leaf it is the codebook's own atom, so
# callers read it and never write it; `encode_node` only ever passes it as an
# input to `bind`.
(fn encode_value [book v depth]
  (if (&& (is_node v) (> depth 0.0))
    (do (var out ($buffer F64 book/dim))
        (encode_node book v depth out)
        out)
    # A leaf, or a node past the depth limit. Past the limit the node is
    # represented by the *name of its head* — a reference, not its contents —
    # which is what keeps a deep tree from spending the whole vector.
    (atom_ref book (value_name (leaf_name (if (is_node v) v/head v))))))

# --- gate G4: the relational codec, for comparison ---------------------------
#
# §11.1's *reference* semantics: a prop is lowered to a `(prop k v)` relation
# and encoded like any other child, so `prop`, the key, and the value are all
# ordinary concepts that reasoning can quantify over. `encode_node` above is the
# optimized **direct** form, which binds the key's role straight to the value
# and never materializes `prop` at all.
#
# §11.2's criterion: the direct codec replaces the reference only if it is at
# least 2x faster to encode at equal top-1 accuracy. Both are here so that is
# measurable rather than asserted.
(fn encode_node_relational [book node depth out]
  (var space book/space)
  (var dim book/dim)
  (var pair ($buffer F64 dim))
  (var kv ($buffer F64 dim))

  (var head_role (atom_ref book (head_name)))
  (var head_v (atom_ref book (value_name (leaf_name node/head))))
  (space ~ VsaSpace:bind head_role head_v pair)
  (space ~ VsaSpace:bundle_into pair out)

  # Each prop becomes `(prop k v)`: bind PROP to the key, bind that to the
  # value. Three atoms and two binds where the direct form uses two and one.
  (var prop_marker (atom_ref book (value_name "prop")))
  (for entry in (normalize_props node)
    (var role (atom_ref book (role_name entry/0)))
    (space ~ VsaSpace:bind prop_marker role kv)
    (var filler (encode_value book entry/1 (- depth 1.0)))
    (space ~ VsaSpace:bind kv filler pair)
    (space ~ VsaSpace:bundle_into pair out))

  (var i 0.0)
  (for item in node/body
    (var role (atom_ref book (position_name i)))
    (var filler (encode_value book item (- depth 1.0)))
    (space ~ VsaSpace:bind role filler pair)
    (space ~ VsaSpace:bundle_into pair out)
    (set i (+ i 1.0)))
  nil)

# The relational form's query: rebuild `bind(PROP, role)` and unbind by it.
(fn query_role_relational [book record role out]
  (var space book/space)
  (var dim book/dim)
  (var kv ($buffer F64 dim))
  (var prop_marker (atom_ref book (value_name "prop")))
  (var role_v (atom_ref book (role_name role)))
  (space ~ VsaSpace:bind prop_marker role_v kv)
  (space ~ VsaSpace:unbind record kv out)
  nil)

# The vocabulary a cleanup memory needs to answer queries against a node's
# encoding: every leaf name and head that appears in it, under `vsa/val/`.
(fn node_vocabulary [node depth]
  (var out [])
  (collect_names node depth out)
  out)

(fn collect_names [node depth out]
  (out ~ push! (value_name (leaf_name node/head)))
  (for entry in (normalize_props node)
    (collect_value entry/1 depth out))
  (for item in node/body
    (collect_value item depth out))
  nil)

(fn collect_value [v depth out]
  (if (&& (is_node v) (> depth 0.0))
    (collect_names v (- depth 1.0) out)
    (out ~ push! (value_name (leaf_name (if (is_node v) v/head v)))))
  nil)
