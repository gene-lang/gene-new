# The reference-plus-summary codec — docs/proposals/vsa.md §6.2, the default.
#
# §6.2 is the recommendation most likely to be skipped, and it is the one that
# keeps the design honest: for anything large, mutable, or more than a couple of
# levels deep, **do not encode the structure into the vector.** Encode a stable
# id and a shallow summary, and keep the exact node in the Gene store.
#
#     exact Gene node  <->  stable id  <->  VSA vector
#
# So this module encodes a *summary*: a bounded set of role/filler name pairs,
# plus optional positional items. It never walks a node. That is not a
# limitation working around the design — it is the design, and it is also what
# makes this half portable, because walking a node is not (see `node.gene`).
#
# Everything here takes names rather than values. Turning a Gene node into names
# is `src/codec/node.gene`'s job, and that module is VM-only.

(mod summary ^profile web)

(import [VsaSpace check_len] from "../space.gene")
(import [MapSpace] from "../backends/map.gene")

# Role vectors for structure. Named with a `vsa/` prefix so a user concept
# called "head" or "pos0" cannot collide with the encoding's own vocabulary —
# atoms come from names (§5), so the namespace *is* the string.
(fn role_name [role : Str] : Str $"vsa/role/${role}")
(fn position_name [i : F64] : Str $"vsa/pos/${i}")
(fn head_name [] : Str "vsa/head")
(fn value_name [v : Str] : Str $"vsa/val/${v}")

# `(role filler)` pairs, superposed. This is one node's worth of summary.
#
#   (person ^name "Alice" ^city "Raleigh")
#     -> roles   ["name" "city"]
#        fillers ["Alice" "Raleigh"]
#
# Capacity is the caller's problem and §9 gives the number: usable capacity is
# about dim/16 pairs, and past it precision collapses fast rather than degrading
# gracefully. A summary is supposed to be small.
(fn encode_pairs [space : MapSpace roles : (List Str) fillers : (List Str)
                  out : (Buffer F64)] : Nil
  (var dim (space ~ VsaSpace:dimension))
  (check_len out dim "encode_pairs")
  (var n (+ 0.0 (roles ~ size)))
  (var role_v ($buffer F64 dim))
  (var filler_v ($buffer F64 dim))
  (var pair ($buffer F64 dim))
  (var i 0.0)
  (while (< i n)
    (space ~ VsaSpace:atom (role_name roles/%i) role_v)
    (space ~ VsaSpace:atom (value_name fillers/%i) filler_v)
    (space ~ VsaSpace:bind role_v filler_v pair)
    (space ~ VsaSpace:bundle_into pair out)
    (set i (+ i 1.0)))
  nil)

# Add a head, so two summaries with the same fields but different types do not
# collide. `(person ^city "Raleigh")` and `(office ^city "Raleigh")` should not
# be the same vector.
(fn encode_head [space : MapSpace head : Str out : (Buffer F64)] : Nil
  (var dim (space ~ VsaSpace:dimension))
  (check_len out dim "encode_head")
  (var h ($buffer F64 dim))
  (var hv ($buffer F64 dim))
  (var bound ($buffer F64 dim))
  (space ~ VsaSpace:atom (head_name) h)
  (space ~ VsaSpace:atom (value_name head) hv)
  (space ~ VsaSpace:bind h hv bound)
  (space ~ VsaSpace:bundle_into bound out)
  nil)

# Ordered items, bound to positional roles (§6.3's explicit-position form). The
# API exposes logical positions; a backend is free to implement them by
# permutation instead.
(fn encode_sequence [space : MapSpace items : (List Str)
                     out : (Buffer F64)] : Nil
  (var dim (space ~ VsaSpace:dimension))
  (check_len out dim "encode_sequence")
  (var n (+ 0.0 (items ~ size)))
  (var pos ($buffer F64 dim))
  (var item ($buffer F64 dim))
  (var bound ($buffer F64 dim))
  (var i 0.0)
  (while (< i n)
    (space ~ VsaSpace:atom (position_name i) pos)
    (space ~ VsaSpace:atom (value_name items/%i) item)
    (space ~ VsaSpace:bind pos item bound)
    (space ~ VsaSpace:bundle_into bound out)
    (set i (+ i 1.0)))
  nil)

# --- reading back ------------------------------------------------------------
#
# §7: decoding is approximate and pattern-guided. You ask for a *known* role and
# get a noisy vector back; a cleanup memory turns that into a name, or declines.
# There is no "decode the whole thing" here on purpose — unrestricted
# reconstruction is what §7 says not to build.

(fn query_role [space : MapSpace record : (Buffer F64) role : Str
                out : (Buffer F64)] : Nil
  (var dim (space ~ VsaSpace:dimension))
  (check_len record dim "query_role")
  (check_len out dim "query_role")
  (var role_v ($buffer F64 dim))
  (space ~ VsaSpace:atom (role_name role) role_v)
  (space ~ VsaSpace:unbind record role_v out)
  nil)

(fn query_position [space : MapSpace record : (Buffer F64) i : F64
                    out : (Buffer F64)] : Nil
  (var dim (space ~ VsaSpace:dimension))
  (check_len record dim "query_position")
  (check_len out dim "query_position")
  (var pos ($buffer F64 dim))
  (space ~ VsaSpace:atom (position_name i) pos)
  (space ~ VsaSpace:unbind record pos out)
  nil)

# The vocabulary a cleanup memory needs in order to answer `query_role`. A
# filler is stored under its `vsa/val/` name, so the memory must hold those
# rather than the bare concept names.
(fn filler_names [values : (List Str)] : (List Str)
  (var out : (List Str) [])
  (var n (+ 0.0 (values ~ size)))
  (var i 0.0)
  (while (< i n)
    (out ~ push! (value_name values/%i))
    (set i (+ i 1.0)))
  out)

# Strip the `vsa/val/` prefix a cleanup answer comes back wearing, so callers
# compare against the name they put in. `$str/split` is one of the six portable
# string functions; the prefix is **two** segments (`vsa`, `val`), so the
# concept starts at index 2 — and a concept name may itself contain slashes,
# which is why this rejoins the tail rather than taking one piece.
(fn concept_of [stored : Str] : Str
  (var parts ($str/split stored "/"))
  (var n (+ 0.0 (parts ~ size)))
  (if (< n 3.0) stored
    (do (var tail : (List Str) [])
        (var i 2.0)
        (while (< i n)
          (tail ~ push! parts/%i)
          (set i (+ i 1.0)))
        ($str/join tail "/"))))
