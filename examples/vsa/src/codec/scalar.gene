# Continuous values — docs/proposals/vsa.md §6.5.
#
# Small categorical integers can use atoms, but a continuous quantity must not:
# atoms are near-orthogonal by construction (§5), so `encode(3.0)` and
# `encode(3.01)` would be as unrelated as `car` and `truck`. **Locality is the
# entire reason this module exists** — similarity has to fall off with distance,
# because that is what makes "about this warm" a query rather than a lookup.
#
# The scheme is a thermometer code. Two anchor atoms, `lo` and `hi`; a value at
# fractional position `p` in its range takes its first `p * dim` components from
# `lo` and the rest from `hi`. Two values then differ in exactly the components
# between their thresholds, so
#
#     similarity(encode(x), encode(y))  ~  1 - 2 * |p_x - p_y|
#
# which is linear in the distance, by construction rather than by tuning. §9's
# locality check measures that it actually holds.
#
# A range is part of the encoder, not the value. Two quantities that mean
# different things — a temperature and a price — should not land in the same
# geometry just because they are both numbers, so each gets its own named
# encoder and therefore its own anchors.

(mod scalar ^profile web)

(import [VsaSpace check_len] from "../space.gene")
(import [MapSpace] from "../backends/map.gene")
(import [Codebook atom_ref] from "../codebook.gene")

(type ScalarEncoder ^props {^name Str ^lo F64 ^hi F64})

(fn new_encoder [name : Str lo : F64 hi : F64] : ScalarEncoder
  (ScalarEncoder ^name name ^lo lo ^hi hi))

(fn lo_name [e : ScalarEncoder] : Str $"vsa/scalar/${e/name}/lo")
(fn hi_name [e : ScalarEncoder] : Str $"vsa/scalar/${e/name}/hi")

# Clamp rather than raise. A measurement that runs off the end of its declared
# range is a real thing that happens, and the honest encoding of it is "at the
# end" — the alternative is that a sensor spike takes down a query.
(fn position [e : ScalarEncoder x : F64] : F64
  (var span (- e/hi e/lo))
  (if (<= span 0.0) 0.0
    (do (var p (/ (- x e/lo) span))
        (if (< p 0.0) 0.0 (if (> p 1.0) 1.0 p)))))

# The two anchors are borrowed, which matters more here than anywhere else in
# the package: `decode_number` calls this once per probe step, so a 100-step
# decode used to generate 202 atoms for two distinct names.
#
# `out` is the caller's and is never one of the anchors — this reads from both
# and writes only to `out`.
(fn encode_number [book : Codebook e : ScalarEncoder x : F64
                   out : (Buffer F64)] : Nil
  (var dim book/dim)
  (check_len out dim "encode_number")
  (var lo (atom_ref book (lo_name e)))
  (var hi (atom_ref book (hi_name e)))
  # The threshold is where the vector switches from `lo` to `hi`. Rounding is
  # deliberate and shared: both backends compute the same integer here because
  # `floor` is exact, which is what keeps two runtimes encoding 21.5 degrees
  # identically.
  (var cut ($math/floor (+ (* (position e x) dim) 0.5)))
  # A thermometer code is literally two ranges, so it is two bulk copies rather
  # than a per-component choice: `lo` below the threshold, `hi` from it up.
  # `decode_number` calls this once per probe step, which is where it pays.
  (out ~ copy_from! lo 0.0 cut 0.0)
  (out ~ copy_from! hi cut dim cut)
  nil)

# The inverse, by search. There is no closed form — the encoding is a threshold,
# so recovering it means finding which threshold best explains the vector.
#
# `steps` is the resolution: the range is probed that many times and the best
# match wins. This is honest about what decoding a scalar is (§7: decoding is
# approximate and returns candidates), and it is why a caller who needs the
# exact number should keep it in the Gene store and use the vector as an
# address (§6.2).
(fn decode_number [book : Codebook e : ScalarEncoder v : (Buffer F64)
                   steps : F64] : F64
  (var space book/space)
  (var dim book/dim)
  (check_len v dim "decode_number")
  (var probe ($buffer F64 dim))
  (var best e/lo)
  (var best_score -2.0)
  (var i 0.0)
  (while (<= i steps)
    (var x (+ e/lo (* (- e/hi e/lo) (/ i steps))))
    (encode_number book e x probe)
    (var s (space ~ VsaSpace:similarity v probe))
    (if (> s best_score)
      (do (set best_score s)
          (set best x)))
    (set i (+ i 1.0)))
  best)
