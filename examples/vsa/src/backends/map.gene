# MAP (Multiply-Add-Permute) over bipolar ±1 vectors — docs/proposals/vsa.md
# §4.1, the first and for now only `VsaSpace`.
#
# Why this family first: **binding is its own inverse.** On ±1 vectors
# `a * a = 1` componentwise, so `unbind` is `bind` — no circular correlation, no
# FFT, no second code path to keep in agreement. HRR/FHRR is meant to arrive as
# a second impl of the same protocol once a workload measures worse here.
#
# Why ±1 stored as F64 rather than packed bits (§3.2): `Int` lowers to `bigint`
# in the web profile, which `examples/miclone/core/exact.gene` measures at
# roughly an order of magnitude slower, and these are the hot vectors of the
# whole design. Integer arithmetic happens *inside* F64, exact below 2^53.

(mod map ^profile web)

(import [VsaSpace check_len check_distinct buffer_len] from "../space.gene")

# A space is its dimension and its codebook seed. Two spaces with the same pair
# generate the same atoms, on either backend; two with different seeds are
# independent concept universes over the same geometry.
(type MapSpace ^props {^dim F64 ^seed F64})

(fn new_space [dim : F64 seed : F64] : MapSpace
  (MapSpace ^dim dim ^seed seed))

# --- deterministic atoms (§5) -------------------------------------------------
#
# Two requirements, and the second is the one that is easy to miss.
#
#   * **Stable across processes.** Derived from the concept's *name*, never from
#     an interned symbol id: `PropEntry.keyId` is an `int32` handed out in
#     encounter order within one process, so hashing it would give two
#     processes different codebooks for the same word.
#   * **Bit-identical across backends.** Only operations IEEE-754 requires to be
#     correctly rounded appear here — `+ - * /` and `floor` — following
#     `examples/miclone/core/exact.gene`. No `sin`, `cos`, `pow`, `exp`, `log`:
#     two conforming runtimes may disagree in the last place on all of those,
#     and a codebook that disagrees is worse than no codebook.
#
# Everything below stays under 2^53, where F64 represents every integer exactly
# and `+ - *` on such values are exact, so this is reproducible by the standard
# rather than by luck.

# `exact.gene`'s bound, which this file obeys everywhere: **wrap to 32 bits
# before multiplying, and multiply only by constants under 2^21.** Then the
# widest intermediate is under 2^53 and every step is exact by the standard
# rather than merely correctly rounded. FNV's 16777619 is 2^24 and would break
# it — the product would round, and rounding before a modulus discards exactly
# the low bits the sign depends on.
(const hash_modulus 4294967296.0)   # 2^32
(const hash_mult 1000003.0)         # prime, < 2^21
(const hash_offset 2166136261.0)

(fn wrap32 [x : F64] : F64
  (- x (* ($math/floor (/ x hash_modulus)) hash_modulus)))

(fn fold [x : F64 by : F64] : F64
  # Add the high bits back into the low ones. This is the step a multiply
  # cannot do for itself: in `x * odd (mod 2^32)` the low bit of the result is
  # the low bit of `x`, so without a fold bit 0 stays a linear function of the
  # input forever. It is what xor provides in FNV and murmur; addition is the
  # version available without leaving F64.
  (wrap32 (+ x ($math/floor (/ x by)))))

(fn scramble [x : F64] : F64
  # One mixing round. The second multiplier is **derived from the data**, and
  # that is the part that matters: multiply-and-fold by constants is affine over
  # the 32-bit state no matter how many rounds are stacked, and an affine
  # function of the index leaves visible structure in every bit. Measured, at
  # dim 1024 over 153 atom pairs: constants only gave worst |sim| 0.34, the
  # data-dependent multiplier gives 0.10 against an expected 3-sigma of ~0.09.
  #
  # `k` is forced odd so the multiply stays a bijection mod 2^32, and held under
  # 2^21 so `state * k` stays under 2^53 and therefore exact (`exact.gene`).
  (var a (fold (wrap32 (* x hash_mult)) 65536.0))
  (var s ($math/floor (/ a 128.0)))
  (var k (+ 1.0 (* 2.0 (- s (* ($math/floor (/ s 1048576.0)) 1048576.0)))))
  (fold (wrap32 (* a k)) 8192.0))

(fn mix [h : F64 byte : F64] : F64
  (scramble (wrap32 (+ h byte))))

(fn hash_name [name : Str] : F64
  # UTF-8 bytes, so the hash is over the encoding rather than over whatever a
  # runtime calls a character. `$str/to_utf8` is one of the six portable string
  # functions, and it is the only one that exposes a name's contents.
  (var bytes ($str/to_utf8 name))
  (var n (+ 0.0 (bytes ~ len)))
  (var h hash_offset)
  (var i 0.0)
  (while (< i n)
    # `(bytes ~ get i)` is an `Int`, which is a `bigint` in the web profile.
    # Widening here keeps the loop in F64; it costs one conversion per byte of a
    # *name*, which happens once per concept and never per component.
    (set h (mix h ($to_float (bytes ~ get i))))
    (set i (+ i 1.0)))
  h)

(fn component [h : F64 i : F64] : F64
  # One ±1 component, so one name hash seeds a whole vector. The index enters
  # multiplied rather than added, which spreads consecutive components across
  # the state instead of stepping through it. `i * hash_mult` stays under 2^41
  # for any dimension up to 2^21, well inside the exact range.
  #
  # The sign is bit 16 rather than bit 0. Bit 0 is where the affine structure
  # survives: the first version of this took it and produced atoms that were all
  # the same vector up to sign — measured worst |sim| 0.95 where ~0.03 was
  # expected. Bit 16 has been through both folds.
  (var m (scramble (wrap32 (+ h (* i hash_mult)))))
  (var high ($math/floor (/ m 65536.0)))
  (if (< (- high (* ($math/floor (/ high 2.0)) 2.0)) 1.0) 1.0 -1.0))

(impl VsaSpace for MapSpace

  (message dimension [] : F64 self/dim)

  (message atom [key : Str out : (Buffer F64)] : Nil
    (check_len out self/dim "atom")
    (var n self/dim)
    (var h (mix (hash_name key) (wrap32 self/seed)))
    (var i 0.0)
    (while (< i n)
      (out ~ set! i (component h i))
      (set i (+ i 1.0))))

  # Elementwise, so `out` may alias either input (§3.3.1).
  (message bind [a : (Buffer F64) b : (Buffer F64) out : (Buffer F64)] : Nil
    (check_len a self/dim "bind")
    (check_len b self/dim "bind")
    (check_len out self/dim "bind")
    (var n self/dim)
    (var i 0.0)
    (while (< i n)
      (out ~ set! i (* (a ~ get i) (b ~ get i)))
      (set i (+ i 1.0))))

  # Self-inverse on ±1, so this is `bind` with the arguments named for what
  # they mean. Kept as its own message because HRR's is not.
  (message unbind [composite : (Buffer F64) role : (Buffer F64)
                   out : (Buffer F64)] : Nil
    (check_len composite self/dim "unbind")
    (check_len role self/dim "unbind")
    (check_len out self/dim "unbind")
    (var n self/dim)
    (var i 0.0)
    (while (< i n)
      (out ~ set! i (* (composite ~ get i) (role ~ get i)))
      (set i (+ i 1.0))))

  # Superposition is addition. The accumulator holds the raw sum rather than a
  # re-clamped ±1, so accumulation can continue after a caller has read a
  # normalized copy out of it (§3.3.1).
  (message bundle_into [v : (Buffer F64) acc : (Buffer F64)] : Nil
    (check_len v self/dim "bundle_into")
    (check_len acc self/dim "bundle_into")
    (var n self/dim)
    (var i 0.0)
    (while (< i n)
      (acc ~ set! i (+ (acc ~ get i) (v ~ get i)))
      (set i (+ i 1.0))))

  # Cyclic shift — the one operation that reads an index it is not writing, so
  # `out` must be a distinct buffer.
  (message permute [v : (Buffer F64) shift : F64 out : (Buffer F64)] : Nil
    (check_len v self/dim "permute")
    (check_len out self/dim "permute")
    (check_distinct v out "permute")
    (var n self/dim)
    # Fold the shift into [0, n) so a negative or oversized rotation is the
    # rotation it names rather than an out-of-range read.
    (var s (- shift (* ($math/floor (/ shift n)) n)))
    (var i 0.0)
    (while (< i n)
      (var from (- (+ i n) s))
      (out ~ set! i (v ~ get (- from (* ($math/floor (/ from n)) n))))
      (set i (+ i 1.0))))

  (message similarity [a : (Buffer F64) b : (Buffer F64)] : F64
    (check_len a self/dim "similarity")
    (check_len b self/dim "similarity")
    (var n self/dim)
    (var dot 0.0)
    (var na 0.0)
    (var nb 0.0)
    (var i 0.0)
    (while (< i n)
      (var av (a ~ get i))
      (var bv (b ~ get i))
      (set dot (+ dot (* av bv)))
      (set na (+ na (* av av)))
      (set nb (+ nb (* bv bv)))
      (set i (+ i 1.0)))
    (var d ($math/sqrt (* na nb)))
    # A zero vector has no direction; 0.0 is the honest answer and keeps this
    # total, which matters because cleanup scans call it in a loop.
    (if (> d 0.0) (/ dot d) 0.0))

  # Project a bundled sum back onto ±1. Zero maps to 1.0 rather than 0.0 so the
  # result really is bipolar — a 0 component would sit in no half of the space
  # and quietly weaken every later comparison.
  (message normalize [v : (Buffer F64) out : (Buffer F64)] : Nil
    (check_len v self/dim "normalize")
    (check_len out self/dim "normalize")
    (var n self/dim)
    (var i 0.0)
    (while (< i n)
      (out ~ set! i (if (< (v ~ get i) 0.0) -1.0 1.0))
      (set i (+ i 1.0)))))
