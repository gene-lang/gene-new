(import [build_tree describe] ^from "./tree")
(import [operation : f_op] ^from "./f/render")
(import [operation : ft_op] ^from "./f/render_typed")
(import [operation : p_op] ^from "./p/root")
(import [operation : pc_op] ^from "./p_closure/root")
(import [operation : pt_op] ^from "./p_typed/root")
(let tree (build_tree))
(fn run [op] (op tree op))
(let a (run (f_op)))
($println [(== a (run (ft_op))) (== a (run (p_op))) (== a (run (pc_op))) (== a (run (pt_op)))])
($println (a .size))
