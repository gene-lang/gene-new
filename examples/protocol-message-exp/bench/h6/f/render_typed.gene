# Control F-typed: the same function with the checked Callable parameter and a
# Str result, so the cost of the view checks can be attributed separately.
(import [Section Article Figure Chart] ^from "../model")

(fn render [node each : (Callable [Any Any] Str)] : Str
  (match node
    (when (s : Section)
      (var out s/title)
      (for child in s/children (set out ($to_str out " / " (each child each))))
      out)
    (when (a : Article) ($to_str "art:" a/title ":" a/text))
    (when (f : Figure) ($to_str "fig:" f/caption))
    (else ($to_str "chart:" node/caption))))

(fn operation [] render)
