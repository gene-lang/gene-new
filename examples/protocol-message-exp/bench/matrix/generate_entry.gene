# Writes entry_worker.gene: rows.gene's text plus an entry main, so the entry
# layout runs byte-identical row code with declarations and sends in the entry
# file. Run from the repository root after editing rows.gene.
(fn main [args] : Int
  (let here ($path/parent this_mod/.path))
  (let rows ($fs/read_text $"${here}/rows.gene"))
  (let entry_main "
(fn main [args] : Int
  ($assert (>= args/body/.size 2) \"usage: ROW ITERATIONS\")
  (let report (timed_row args/body/0 ($parse/parse_int args/body/1)))
  (report .put \"layout\" \"entry\")
  ($println ($json/stringify report))
  0)
")
  ($fs/write_text $"${here}/entry_worker.gene"
    $"# GENERATED by generate_entry.gene from rows.gene - do not edit.\n${rows}${entry_main}")
  0)
