(fn timed_row [row n]
  (run_row row 1000)     # warm the sites outside the window
  (let started ($os/monotonic_ms))
  (let checksum (run_row row n))
  (let elapsed (- ($os/monotonic_ms) started))
  {^row row ^n n ^elapsed_ms elapsed ^checksum checksum
   ^ns_per_op (/ (* elapsed 1000000.0) n)})

(fn main [args] : Int
