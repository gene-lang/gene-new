                "held" "view" "dynamic" "type_direct_alt" "qualified_alt" "held_alt"
                "qualified_overlay"])

(fn run_row [row n]
  (let a (Box ^x 1))
  (let b (Other ^x 1))
  (match row
    (when "empty" (run_empty n a b))
    (when "fn" (run_fn n a b))
    (when "closure" (run_closure n a b))
    (when "type_direct" (run_type_direct n a b))
    (when "qualified" (run_qualified n a b))
