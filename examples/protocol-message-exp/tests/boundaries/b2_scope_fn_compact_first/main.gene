(import [Article] ^from "../shared/model")
(import [Render] ^from "../shared/contracts")
(import [attempt] ^from "../shared/util")
(import [install_plain install_compact render_sibling] ^from "../shared/fns")
(let article (Article ^title "A"))
(install_compact)
($println $"sibling after compact installer: ${(attempt (fn [] (render_sibling article)))}")
($println $"outer module after compact installer: ${(attempt (fn [] article/.Render:render))}")
($println $"competing installer: ${(attempt (fn [] (install_plain)))}")
($println $"after rejected plain: ${(attempt (fn [] (render_sibling article)))}")
