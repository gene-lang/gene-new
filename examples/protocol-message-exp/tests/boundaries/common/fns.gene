# Function-local imports. Each pair belongs to the call that imported it, so
# the two policies never meet and a sibling function sees neither.
(import [Article] ^from "./model")
(import [Render] ^from "./contracts")
(fn render_plain [article]
  (import_impl Render for Article ^from "../common/plain")
  article/.Render:render)
(fn render_compact [article]
  (import_impl Render for Article ^from "../common/compact")
  article/.Render:render)
(fn render_plain_locals [article seed]
  (let label $"seed-${seed}")
  (import_impl Render for Article ^from "../common/plain")
  $"${label} ${article/.Render:render}")
(fn render_sibling [article] article/.Render:render)
