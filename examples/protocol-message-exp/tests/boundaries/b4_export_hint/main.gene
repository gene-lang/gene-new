# The provider is exported. Another module imported it; this module did not.
(import [Article] ^from "./model")
(import [Render] ^from "./contracts")
(import ^from "./importer" [])
(let article (Article ^title "A"))
(fn full_message [thunk] (try (thunk) catch Any $err/message))
($println $"missing import: ${(full_message (fn [] article/.Render:render))}")
