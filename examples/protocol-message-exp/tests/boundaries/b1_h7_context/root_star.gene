(import [Section Figure] ^from "../../../src/model")
(import [Mark RenderBody RenderSep RenderRec RenderTyped Ops] ^from "./contracts")
(import_impl Mark for Figure ^from "./mark_star")
(import_impl RenderBody for Section ^from "./render_body")
(import_impl RenderBody for Figure ^from "./render_body")
(import_impl RenderSep for Section ^from "./render_sep")
(import_impl RenderSep for Figure ^from "./render_sep")
(import_impl RenderRec for Section ^from "./render_rec")
(import_impl RenderRec for Figure ^from "./render_rec")
(import_impl RenderTyped for Section ^from "./render_typed")
(import_impl RenderTyped for Figure ^from "./render_typed")
(fn body_op [] RenderBody:render)
(fn sep_ops [] {^render RenderSep:render ^mark Mark:mark})
(fn raw_ops [] {^render RenderRec:render ^mark Mark:mark})
(fn typed_ops [] (Ops ^render RenderTyped:render ^mark Mark:mark))
# A root that forgets the secondary operation.
(fn raw_ops_missing_mark [] {^render RenderRec:render})
