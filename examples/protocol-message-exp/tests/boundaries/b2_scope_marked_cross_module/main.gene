# The entry lives in another directory from common/marked_lib.gene. A relative
# import_impl path should resolve against the module that contains it.
(import [Article] ^from "../common/model")
(import [attempt] ^from "../common/util")
(import [render_plain] ^from "../common/marked_lib")
(let article (Article ^title "A"))
($println $"marked block in a library function: ${(attempt (fn [] (render_plain article)))}")
