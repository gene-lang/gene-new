# The entry lives in another directory from shared/marked_lib.gene. A relative
# import_impl path should resolve against the module that contains it.
(import [Article] ^from "../shared/model")
(import [attempt] ^from "../shared/util")
(import [render_plain] ^from "../shared/marked_lib")
(let article (Article ^title "A"))
($println $"marked block in a library function: ${(attempt (fn [] (render_plain article)))}")
