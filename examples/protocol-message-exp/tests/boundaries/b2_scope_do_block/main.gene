# A plain `do` at module level is a grouping form, not a policy sandbox: its
# import registers in the module (D1 keeps ordinary module-level imports).
(import [Article] ^from "../common/model")
(import [Render] ^from "../common/contracts")
(import [attempt first_line] ^from "../common/util")
(let article (Article ^title "A"))
(do (import_impl Render for Article ^from "../common/plain"))
($println $"outer module after plain do: ${(attempt (fn [] article/.Render:render))}")
(let competing
  (try (do (import_impl Render for Article ^from "../common/compact") "imported")
    catch Any (first_line $err/message)))
($println $"competing do: ${competing}")
