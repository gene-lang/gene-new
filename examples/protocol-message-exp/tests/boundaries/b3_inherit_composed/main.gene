# Child built on the plain parent (omits `body`), composed with compact Article.
(import [Article Note] ^from "../b3_inheritance/model")
(import [Format] ^from "../b3_inheritance/contracts")
(import [attempt] ^from "../common/util")
(import_impl Format for Article ^from "../b3_inheritance/compact")
(import_impl Format for Note ^from "../b3_inheritance/note_on_plain")
(fn both [value] [value/.Format:head value/.Format:body])
(let article (Article ^title "A"))
(let note (Note ^title "N"))
($println $"article: ${(attempt (fn [] (both article)))}")
($println $"note: ${(attempt (fn [] (both note)))}")
