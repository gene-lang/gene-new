# H2: loading order must not change either policy's output. This process loads the
# compact root first and the plain root second, then interleaves them over one value graph.
(import [operation : first_op] ^from "../../../src/roots/compact_late")
(import [operation : second_op] ^from "../../../src/roots/plain_late")
(import [late_document] ^from "../../../src/documents")
(let tree (late_document))
(let first (first_op))
(let second (second_op))
(fn run [op] (op tree op))
(let a (run first))
(let b (run second))
($println $"compact: ${a}")
($println $"plain: ${b}")
($println $"interleaved stable: ${(&& (== a (run first)) (== b (run second)) (== a (run first)) (== b (run second)))}")
