# One row per fixture directory. `covers` names the plan section / hypothesis.
# `expect` is "ok" (exit 0, stdout compared) or "error" (the entry itself must
# fail; its first stderr line is compared).
(fn ok [id covers] {^id id ^covers covers ^expect "ok"})
(fn error [id covers] {^id id ^covers covers ^expect "error"})

(let cases [
  (ok "b1_recursion" "B1.1-7: recursive root-authored P; H1 H2 H3")
  (ok "b1_body_authored" "B1 failing control: body-authored qualified send")
  (ok "b1_h7_context" "B1/H7: cross-protocol operations (params, raw and checked records)")
  (ok "b1_incomplete_root" "B1: incomplete root, partial effects, reflection pre-flight")
  (ok "b1_load_order_plain_first" "H2: plain root loaded before compact root; repeated interleaving")
  (ok "b1_load_order_compact_first" "H2: compact root loaded before plain root; repeated interleaving")
  (ok "b1_late_operation" "B1.6: late operation as a scoped third-party pair")
  (ok "b2_transport" "B2: authored-scope transport matrix")
  (error "b2_scope_fn_plain_first" "B2/D1: function-local import, plain installer first (baseline: reports/evidence/before)")
  (error "b2_scope_fn_compact_first" "B2/D1: function-local import, compact installer first (baseline: reports/evidence/before)")
  (error "b2_scope_fn_with_locals" "B2/D1: function with local bindings (baseline: reports/evidence/before)")
  (ok "b2_scope_do_block" "B2: plain do is not a sandbox")
  (ok "b2_scope_ns_body" "B2: ns body is not a sandbox")
  (ok "b2_scope_eval_overlay" "B2: eval overlay")
  (ok "b2_scope_marked_cross_module" "B2/D1: marked block in a library function, relative path")
  (ok "b3_canonical_v1" "H4a: scoped plugin against core v1")
  (ok "b3_canonical_v2" "H4a: the same plugin against core v2 (canonical addition)")
  (ok "b3_migration" "H4a: mechanical migration to dedicated policy protocols")
  (ok "b3_message_v1" "B3: contract v1")
  (ok "b3_message_required" "B3: required message added after extensions exist")
  (ok "b3_message_default" "B3: defaulted message added after extensions exist")
  (ok "b3_universal" "B3: universal fallback with scoped specialization")
  (ok "b3_inherit_child_first" "B3: independent child pair, then parent")
  (ok "b3_inherit_parent_first" "B3: parent pair, then independent child")
  (ok "b3_inherit_composed" "B3: child built on plain parent, composed with compact")
  (ok "b4_export_hint" "B4: exported provider misreported as unexported")
  (ok "b4_portable_path" "B4: non-portable absolute path in suggested source")
  (ok "b4_duplicate_scoped" "B4/H4a: duplicate scoped pair origins")
  (error "d1_reject_fn" "D1: fn body")
  (error "d1_reject_fn_locals" "D1: fn body with locals")
  (error "d1_reject_lambda" "D1: lambda body")
  (error "d1_reject_nested_blocks" "D1: nested plain blocks")
  (error "d1_reject_message" "D1: type message body")
  (error "d1_reject_impl_message" "D1: impl message body")
  (error "d1_reject_ctor" "D1: ctor body")
  (error "d1_reject_spawn" "D1: spawn body in a function")
  (error "d1_reject_spawn_toplevel" "D1: top-level spawn body")
  (error "d1_reject_fn_in_marked_block" "D1: fn inside a marked block gets no exemption")
  (ok "d1_marked_scopes" "D1: marked blocks in fn/message/ctor/spawn, isolation, controls")])
