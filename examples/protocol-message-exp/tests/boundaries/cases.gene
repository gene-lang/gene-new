# One row per fixture directory. `covers` names the plan section / hypothesis.
# `expect` is "ok" (exit 0, stdout compared) or "error" (the entry itself must
# fail; its first stderr line is compared).
(fn ok [id covers] {^id id ^covers covers ^expect "ok"})
(fn error [id covers] {^id id ^covers covers ^expect "error"})

(let cases [
  (ok "b1_recursion" "B1.1-7: recursive root-authored P; H1 H2 H3")
  (ok "b1_body_authored" "B1 failing control: body-authored qualified send")
  (ok "b1_h7_context" "B1/H7: cross-protocol operations (params, raw and checked records)")
  (ok "b1_incomplete_root" "B1: incomplete root, partial effects, reflection pre-flight")
  (ok "b1_load_order_plain_first" "H2: plain root loaded before compact root; repeated interleaving")
  (ok "b1_load_order_compact_first" "H2: compact root loaded before plain root; repeated interleaving")
  (ok "b1_late_operation" "B1.6: late operation as a scoped third-party pair")
  (ok "b2_transport" "B2: authored-scope transport matrix")
  (ok "b2_scope_fn_plain_first" "B2: library functions each import a pair; per-call policy, plain first")
  (ok "b2_scope_fn_compact_first" "B2: the same, compact first")
  (ok "b2_scope_fn_with_locals" "B2: function with local bindings")
  (ok "b2_scope_do_block" "B2: plain do is a transparent grouping form")
  (ok "b2_scope_ns_body" "B2: ns body is a scope of its own, as for import")
  (ok "b2_scope_eval_overlay" "B2: eval overlay")
  (ok "b3_canonical_v1" "H4a: scoped plugin against core v1")
  (error "b3_canonical_v2" "H4a: the same plugin against core v2 (canonical addition)")
  (ok "b3_canonical_v2_core" "H4a: core v2 alone keeps its canonical behavior")
  (ok "b3_migration" "H4a: mechanical migration to dedicated policy protocols")
  (ok "b3_message_v1" "B3: contract v1")
  (error "b3_message_required" "B3: required message added after extensions exist")
  (ok "b3_message_default" "B3: defaulted message added after extensions exist")
  (ok "b3_universal" "B3: universal fallback with scoped specialization")
  (ok "b3_universal_default" "B3: universal fallback without the import")
  (error "b3_inherit_child_first" "B3: independent child pair, then parent")
  (error "b3_inherit_parent_first" "B3: parent pair, then independent child")
  (ok "b3_inherit_composed" "B3: child built on plain parent, composed with compact")
  (ok "b4_export_hint" "B4: exported provider misreported as unexported")
  (ok "b4_portable_path" "B4: non-portable absolute path in suggested source")
  (error "b4_duplicate_scoped" "B4/H4a: duplicate scoped pair origins")
  (ok "placement_fn" "placement as import: fn body")
  (ok "placement_fn_locals" "placement as import: fn body with locals")
  (ok "placement_lambda" "placement as import: lambda body")
  (ok "placement_nested_blocks" "placement as import: plain blocks and conditionals inside a fn")
  (ok "placement_message" "placement as import: type message body")
  (ok "placement_impl_message" "placement as import: impl message body")
  (ok "placement_ctor" "placement as import: ctor body")
  (ok "placement_spawn" "placement as import: spawn body in a function")
  (ok "placement_spawn_toplevel" "placement as import: top-level spawn body")
  (ok "placement_marked_block" "placement as import: macro-marked blocks and a closure")
  (ok "placement_conditional" "placement as import: top-level conditional joins the module")
  (ok "placement_late" "placement as import: module-level import after code")
  (ok "placement_declarations" "placement as import: imports among declarations")
  (ok "placement_no_shadow" "placement as import: impls never shadow")])
