# The library whose functions import a pair is rejected as a whole at load,
# before any installer can run.
(import [Article] ^from "../common/model")
(import [Render] ^from "../common/contracts")
(import [attempt] ^from "../common/util")
(import [install_plain install_compact render_sibling] ^from "../common/fns")
(let article (Article ^title "A"))
($println $"before: ${(attempt (fn [] (render_sibling article)))}")
(install_plain)
($println "unreachable")
