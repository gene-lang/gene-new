# F: Weight as explicit entries (one matcher + handler per receiver type).
(import [Section Article Figure] ^from "../model")
(import [Chart] ^from "../extensions/chart")
(import [Table] ^from "../extensions/table")
(import [entry] ^from "./dispatch")
(fn is_section [n] (match n (when (x : Section) true) (else false)))
(fn is_article [n] (match n (when (x : Article) true) (else false)))
(fn is_figure [n] (match n (when (x : Figure) true) (else false)))
(fn is_chart [n] (match n (when (x : Chart) true) (else false)))
(fn is_table [n] (match n (when (x : Table) true) (else false)))
(fn weigh_section [node each]
  (var total 1)
  (for child in node/children (set total (+ total (each child each))))
  total)
(let entries [(entry is_section weigh_section)
              (entry is_article (fn [node each] 3))
              (entry is_figure (fn [node each] 2))
              (entry is_chart (fn [node each] 5))
              (entry is_table (fn [node each] node/rows))])
