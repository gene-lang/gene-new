(import [Section Article Figure] ^from "../../model")
(import [Chart] ^from "../../extensions/chart")
(import [Table] ^from "../../extensions/table")
(import [Render] ^from "./contracts")
(impl Render for Section ^^export
  (message render [each : (Callable [Any Any] Str)] : Str
    (var out self/title)
    (for child in self/children (set out ($to_str out " / " (each child each))))
    out))
(impl Render for Article ^^export
  (message render [each : (Callable [Any Any] Str)] : Str ($to_str self/title ": " self/text)))
(impl Render for Figure ^^export
  (message render [each : (Callable [Any Any] Str)] : Str ($to_str "fig(" self/caption ")")))
(impl Render for Chart ^^export
  (message render [each : (Callable [Any Any] Str)] : Str ($to_str "chart(" self/caption ")")))
(impl Render for Table ^^export
  (message render [each : (Callable [Any Any] Str)] : Str ($to_str "table(" self/title "," self/rows ")")))
