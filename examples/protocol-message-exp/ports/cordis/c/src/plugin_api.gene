# Stable declarations a sandboxed plugin may import through the loader's
# explicit shared-module allowlist. Constructors and runtime mutation handles
# are intentionally absent.

(mod plugin_api)

(import
  Disposable
  EffectOwner
  HookKey
  HookMode
  InstanceState
  InvocationLimits
  PluginCall
  PluginCallKind
  PluginInvoker
  PluginSpec
  Requirement
  ServiceKey
  ^from "./model" ^^export)
