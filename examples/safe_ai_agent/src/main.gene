# An agent whose only way to act is to emit a Gene program.
#
# The loop is: prompt -> LLM -> {^status ... ^code [...]} -> evaluate the code
# with no ambient authority and a fixed set of handed-in tools -> show the
# results -> repeat while the model says it is still working.
#
# The capability rows below are the whole safety story. Model-emitted code
# holds *nothing* by default: a raw ($fs/write_text ...) in generated code is
# refused before it runs, and the refusal names the authority it wanted. The
# only effects it can cause are the ones this file deliberately handed it.
#
# See docs/design.md in this directory.

# The module ceiling bounds everything in this file and everything it calls:
# talk to the model (net/*), read the API key (os/Env), read `workspace/`.
#
# `(fs/ReadDir "workspace")` also re-roots this module's filesystem authority:
# inside it a relative path resolves against `workspace/`, not the launch
# directory. That is why the tool rows below say "." and generated code says
# "notes.txt" (capabilities.md §7.5).
(mod safe_ai_agent
  ^capabilities [net/* os/Env (fs/ReadDir "workspace")])

(import $net/http_client [request])
(import $os [get_env env? read_line])
(import $str [trim starts_with?])
(import $parse [read_all])

# ---------------------------------------------------------------------------
# The tools generated code may call.
#
# Model-emitted code runs with no ambient authority at all, so these functions
# are the entire surface it can act through. Each carries its own declared row,
# and the row is what confines it — not the body, and not a convention about
# how the argument is used.
#
# `read_note` forwards its argument to the filesystem without inspecting it,
# and still cannot be walked out of `workspace/`: `(fs/ReadFile name)` is a
# parameter-dependent row, so the check resolves `name` against the module root
# and refuses `../package.gene` *at the declaration*, before the body runs.
# ---------------------------------------------------------------------------

(fn list_notes [] : Any
  ^capabilities [(fs/ReadDir ".")]
  ($fs/list_dir "."))

(fn read_note [name : Str] : Str
  ^capabilities [(fs/ReadFile name)]
  ($fs/read_text name))

(fn agent_tools [] : Any
  # Handed to `eval` as `^capabilities`. Despite the name, this map is a
  # *binding overlay* — it decides which names generated code can see. The
  # authority behind each name comes from that function's own row above.
  {^list_notes list_notes ^read_note read_note})

(fn tool_summary [] : Str
  "(list_notes) -> the file names in the workspace; (read_note \"name\") -> that file's contents. Nothing else is available: there is no filesystem, network, or environment access outside these two.")

# ---------------------------------------------------------------------------
# Evaluating what the model sent back
# ---------------------------------------------------------------------------

(fn render_form [form] : Str
  # One model-emitted form.
  #
  # A denial is a *value* here, not a crash: the agent renders it, the model
  # sees it in the next turn's history, and it gets to try something else. That
  # is why the refusal names the capability that was missing.
  (try
    $"${(eval form ^in (env ^module this_mod ^capabilities (agent_tools)))}"
    catch (MissingCapability ^capability wanted ^operation operation)
    $"refused: ${operation} needs ${wanted}"
    catch e
    # A denial raised at a declared row — a tool call — arrives as a typed
    # `MissingCapability` and is caught above. One raised by a raw native
    # operation *inside* the evaluated form arrives untyped, carrying the
    # capability name only in its message. Both are refusals; only one is
    # destructurable. See docs/design.md, "Open problems".
    $"refused: ${e/message}"))

(fn run_forms [forms] : Any
  (var results ($cell []))
  (for form in forms
    ((results ~ get) ~ push (render_form form)))
  (results ~ get))

# ---------------------------------------------------------------------------
# Model transport
# ---------------------------------------------------------------------------

(fn stub_reply [task] : Str
  # Offline mode, so the example runs and can be tested without a key.
  # Returns the same shape a real model is asked for.
  #
  # The four branches are the four things worth seeing: a refused raw effect,
  # a granted tool call, a refused attempt to walk out of the workspace, and
  # plain computation that needs no authority at all.
  (if (starts_with? task "write")
    "{^status \"done\" ^response \"Saving that to the workspace.\" ^code [($fs/write_text \"scratch.txt\" \"generated\")]}"
    (if (starts_with? task "read")
      "{^status \"done\" ^response \"Reading the workspace.\" ^code [(list_notes) (read_note \"notes.txt\")]}"
      (if (starts_with? task "escape")
        "{^status \"done\" ^response \"Peeking outside the workspace.\" ^code [(read_note \"../package.gene\")]}"
        "{^status \"done\" ^response \"No tools needed for that.\" ^code [(+ 1 2)]}"))))

(fn system_prompt [] : Str
  $"You are an agent whose only way to act is to emit a Gene program.
Reply with Gene data and nothing else, in exactly this shape:
{^status \"done\"|\"in-progress\" ^code [form1 form2 ...] ^response \"...\"}
^code holds forms to evaluate. Use ^status \"in-progress\" when you need
to see their results before continuing.
The forms may use ordinary pure Gene plus exactly these tools:
$(tool_summary)
A form that reaches past that is refused, and you will see the refusal.
")

(fn call_model [task history] : Str
  (if (env? "GENE_AGENT_STUB")
    (stub_reply task)
    (do
      (var key (get_env "OPENAI_AUTH_TOKEN"))
      (var body
        ($json/stringify
          {^model (if (env? "GENE_AGENT_MODEL")
                    (get_env "GENE_AGENT_MODEL")
                    "openai/gpt-5.6-terra")
           ^messages [
             {^role "system" ^content (system_prompt)}
             {^role "user" ^content $"${task}\n\nPrior results:\n${history}"}
           ]}))
      (var r
        (await (request ^url "https://openrouter.ai/api/v1/chat/completions"
                        ^method "POST"
                        ^headers {^authorization $"Bearer ${key}"
                                  ^content-type "application/json"}
                        ^body body
                        ^timeout_ms 60000)))
      (if_not (== r/status 200)
        (throw $"model returned status ${r/status}"))
      (var parsed ($json/parse r/body))
      parsed/choices/0/message/content)))

# ---------------------------------------------------------------------------
# The two areas: output above, prompt below.
# ---------------------------------------------------------------------------

(fn show [lines] : Void
  (for line in lines ($println "  " line)))

(fn parse_envelope [reply] : Any
  # `read_all` yields a Stream over the forms in the reply; the envelope is the
  # first. A model that answers in prose instead lands in the catch arm.
  (try
    ((read_all reply) ~ next)
    catch _
    nil))

(fn handle_task [task] : Void
  (var history ($cell ""))
  (var turn ($cell 0))
  (var running ($cell true))
  (while (running ~ get)
    (turn ~ set (+ (turn ~ get) 1))
    (var envelope (parse_envelope (call_model task (history ~ get))))
    (if (== envelope nil)
      (do
        ($println "  the model did not return Gene data")
        (running ~ set false))
      (do
        (var response envelope/response)
        (if (!= response nil)
          ($println "  " response))
        (var results (run_forms envelope/code))
        (show results)
        (var prior (history ~ get))
        (history ~ set $"${prior}\n${results}")
        (if_not (== envelope/status "in-progress")
          (running ~ set false))
        (if_yes (>= (turn ~ get) 6)
          ($println "  (turn limit reached)")
          (running ~ set false))))))

(fn main [args]
  ^capabilities *
  ($println "safe_ai_agent — the model's only action is a Gene program")
  ($println "generated code may call: " (tool_summary))
  (if (env? "GENE_AGENT_STUB")
    ($println "offline stub mode (GENE_AGENT_STUB set)"))
  ($println "")
  (var going ($cell true))
  (while (going ~ get)
    ($print "> ")
    (var line (read_line))
    (if (== line nil)
      (going ~ set false)
      (do
        (var task (trim line))
        (if (== task "/quit")
          (going ~ set false)
          (if (!= task "")
            (handle_task task))))))
  ($println "bye")
  0)
