# An agent whose only way to act is to emit a Gene program.
#
# The loop is: prompt -> LLM -> {^status ... ^code (do ...)} -> evaluate the code
# under an explicit ambient grant -> show the result -> repeat while the model
# says it is still working.
#
# The capability rows below are the whole safety story. Generated code calls the
# ordinary standard library, and what it can reach is decided entirely by the
# authority its Env was minted with: two directories, one writable, and nothing
# else. A path outside them is refused before it runs, and the refusal names the
# authority it wanted.
#
# See docs/design.md in this directory.

# The module ceiling bounds everything in this file and everything it calls:
# talk to the model (net/*), read the API key (os/Env), read and write
# `workspace/`.
#
# `(fs/ReadWriteDir "workspace")` also re-roots this module's filesystem
# authority: inside it a relative path resolves against `workspace/`, not the
# launch directory. That is why generated code says "notes.txt"
# (capabilities.md §7.5).
#
# The second filesystem root is the skill directory. It is `^^optional`, so the
# agent starts with or without it, and it is *outside* this package — a module
# row may narrow within what the launcher granted but never widen past it, so
# reading it at all requires the host to say so:
#
#   gene run --allow_read_dir ../../tools/gene-lang-skill src/main.gene
#
# Without that flag the row admits nothing, `skills_available` is false, and the
# two skill tools report that rather than failing. Loading a skill is a grant,
# not a configuration setting.
(mod safe_ai_agent
  ^capabilities [net/* os/Env
                 (fs/ReadWriteDir "workspace")
                 (fs/ReadDir "../../tools/gene-lang-skill" ^^optional)])

(import $net/http_client [request])
(import $os [get_env env? read_line])
(import $str [trim starts_with? contains?])
(import $parse [read_all])

(type AgentError ^props {^message Str} ^impl [Error])

(impl Error for AgentError)

# ---------------------------------------------------------------------------
# What generated code may reach
# ---------------------------------------------------------------------------

# Generated code calls the standard library directly — `$fs/read_text`,
# `$fs/write_text`, `$fs/list_dir` — so there is no bespoke tool surface to
# learn, audit, or keep in sync. What confines it is the ambient authority its
# `Env` is minted with (capabilities.md §14): the row below is resolved against
# *this* module's context when the Env is created, so it can never name more
# than this module already holds.
#
# The narrowing selector is written `../<name>`, not `<name>`: a selector path
# resolves *inside* the active root, so "workspace" under the workspace root
# would mean `workspace/workspace`. `../workspace` canonicalizes back onto the
# root itself from any root that could be active.
#
# The two rows carry different rights. The workspace is read-write; the skill
# directory is `fs/ReadDir` only, so a write under it is refused even though
# this module holds write authority over the other root.

(const WORKSPACE "../workspace")

(const SKILL_ROOT "../../tools/gene-lang-skill")

(fn skills_available [] : Bool
  ($check_capabilities (fs/ReadDir SKILL_ROOT)))

# One declaring reader, used by this module on its own behalf. The row is
# parameter-dependent, so it resolves `name` against whichever root is active
# and refuses anything outside it *at the declaration*, before the body runs.
(fn read_file_at [name : Str] : Str
  ^capabilities [(fs/ReadFile name)]
  ($fs/read_text name))

(fn list_skill_dir [dir : Str] : Any
  ^capabilities [(fs/ReadDir dir)]
  ($fs/list_dir dir))

(fn skill_index [] : Any
  # `SKILL.md` plus everything one level down, so the prompt can name what is
  # readable without spending context on the contents.
  (if_not (skills_available) (return []))
  (with_capabilities [(fs/ReadDir SKILL_ROOT)]
    (var found ($cell []))
    (for entry in (list_skill_dir ".")
      (if (== entry "SKILL.md")
        (then ((found ~ get) ~ push entry))
        (else
          (try
            (for nested in (list_skill_dir entry)
              ((found ~ get) ~ push $"${entry}/${nested}"))
            catch _
            nil))))
    (found ~ get)))

(var eval_depth ($cell 0))

(fn run_note [name : Str] : Str
  # Spelled as a literal, not `WORKSPACE`: a declaration row admits only
  # literals, parameters, or `this`, so a const is out of reach here.
  ^capabilities [(fs/ReadWriteDir "../workspace")]
  # Lets the model test what it just wrote. This adds no authority: the note's
  # forms run through `run_program`, in the same sealed env with the same five
  # tools. Without it the agent writes code it cannot execute, and a file full
  # of runtime errors looks exactly like a file that works.
  #
  # Nesting is refused because the tool is reachable *from* generated code, so
  # a note that runs itself would recurse until the stack goes.
  (if_yes (>= (eval_depth ~ get) 1)
    (fail (AgentError ^message "run_note may not be nested")))
  (eval_depth ~ set (+ (eval_depth ~ get) 1))
  (try
    # The row keeps the whole workspace rather than just this file, because
    # `run_program` mints a fresh Env whose ambient row is resolved against
    # whatever context is active here — narrowing to one file first would leave
    # nothing for the evaluated program to run under.
    (var forms ((read_all ($fs/read_text name)) ~ into []))
    (run_program `(do %forms...))
    ensure
    (eval_depth ~ set (- (eval_depth ~ get) 1))))

(fn agent_tools [] : Any
  # The binding overlay — the only *names* added beyond the `$` standard
  # library. Filesystem access is not here; it comes from the ambient row on the
  # Env below. `run_note` is, because evaluating a note is this agent's own
  # facility rather than something the standard library offers.
  #
  # Evaluated code also sees the scope this `eval` is written in, so it can name
  # any function in this file. That is not the hole it looks like: those calls
  # are ordinary same-module calls, so they inherit the *evaluated* context — the
  # narrow row below — rather than re-applying this module's ceiling. Naming
  # `call_model` gets a program no closer to the API key than calling
  # `($os/get_env ...)` directly does, and both are refused.
  {^run_note run_note ^read_skill read_skill})

(fn read_skill [name : Str] : Str
  # The skill directory cannot also be ambient: two ambient roots would make a
  # relative name like "todo.gene" mean two different host targets, and §6.3
  # rightly refuses to guess. So the writable root is the ambient one — where
  # the model's ordinary `$fs/*` calls land — and the read-only skill is reached
  # through this one reader, which narrows to it for the call.
  (if_not (skills_available) (return "no skill directory was granted"))
  (with_capabilities [(fs/ReadDir SKILL_ROOT)]
    (read_file_at name)))

(fn tool_summary [] : Str
  """Use the standard library directly:
($fs/list_dir ".") -> file names in the workspace
($fs/read_text "name") -> that file's contents
($fs/write_text "name" "text") -> create or overwrite it
($fs/remove "name") -> delete it
($fs/exists? "name") -> true or false
(run_note "name") -> evaluate that note's Gene source and return its result,
  so you can test what you wrote. Cannot be nested.
Two directories are reachable and nothing else: the workspace, read-write, where
relative names like "todo.gene" land; and the loaded skill directory, read-only.
Any other path, and every other kind of authority, is refused.""")

# ---------------------------------------------------------------------------
# Evaluating what the model sent back
# ---------------------------------------------------------------------------

(fn refusal? [message : Str] : Bool
  # A denial raised at a declared row — a tool call — arrives as a typed
  # `MissingCapability`. One raised by a raw native operation *inside* the
  # evaluated form arrives untyped, carrying the capability name only in its
  # message. This recognizes the second kind so both render as refusals, and so
  # an ordinary mistake does not. See docs/design.md, "Open problems".
  (contains? message " requires "))

(fn run_program [program] : Str
  # The model's action is *a program* — one `(do ...)` block, emitted as such.
  # Asking for the block rather than a list of forms the agent staples together
  # means the shape the model writes is the shape that runs, so a reply can
  # define something and then use it without the agent reassembling anything.
  #
  # The cost is that one bad form abandons the rest of the block, and only the
  # final value is returned. Generated code that wants to report more than its
  # last expression can call `($println ...)`.
  #
  # `^bindings` adds names; `^capabilities` is the ambient authority row, and it
  # is resolved against *this* module's context when the Env is minted, so it
  # can never name more than this module already holds (capabilities.md §14).
  # An Env with no row grants nothing at all, which stays the default everywhere
  # else in the runtime.
  (var sandbox
    (env ^bindings (agent_tools)
         ^capabilities [(fs/ReadWriteDir WORKSPACE)]))
  (try
    $"${(eval program ^in sandbox)}"
    catch (MissingCapability ^capability wanted ^operation operation)
    # A denial is a *value* here, not a crash: the agent renders it, the model
    # sees it in the next turn's history, and it gets to try something else.
    # That is why the refusal names the capability that was missing.
    $"refused: ${operation} needs ${wanted}"
    catch e
    (if (refusal? e/message)
      $"refused: ${e/message}"
      $"error: ${e/message}")))

# ---------------------------------------------------------------------------
# Model transport
# ---------------------------------------------------------------------------

(fn stub_reply [task] : Str
  # Offline mode, so the example runs and can be tested without a key.
  # Returns the same shape a real model is asked for.
  #
  # The five branches are the five things worth seeing: a refused raw effect, a
  # granted read, a granted write, a refused attempt to walk out of the
  # workspace, and a program that defines something and then uses it.
  (if (starts_with? task "raw")
    (then
      """{^status "done" ^response "Reading an environment variable." ^code (do ($os/get_env "HOME"))}""")
    (elif (starts_with? task "read")
      """{^status "done" ^response "Reading the workspace." ^code (do ($fs/list_dir ".") ($fs/read_text "notes.txt"))}""")
    (elif (starts_with? task "write")
      """{^status "done" ^response "Saving that to the workspace." ^code (do ($fs/write_text "todo.txt" "buy milk") ($fs/read_text "todo.txt"))}""")
    (elif (starts_with? task "escape")
      """{^status "done" ^response "Peeking outside the workspace." ^code (do ($fs/read_text "../package.gene"))}""")
    (else
      """{^status "done" ^response "Defining and using in one program." ^code (do (var xs [1 2 3]) (var total 0) (for x in xs (set total (+ total x))) total)}""")))

(fn loaded_skill [] : Str
  # The always-loaded half of a skill. `SKILL.md` goes in the prompt; the files
  # it points at stay on disk until the model asks for one, which is the whole
  # point of the format — a skill can be far larger than a prompt budget as long
  # as its entry page says what the rest holds.
  #
  # The skill is written for a coding agent with a shell, so the one thing it
  # cannot carry is how *this* agent runs code. That mapping is stated here
  # rather than by editing the skill, which has its own life outside this file.
  (if_not (skills_available) (return ""))
  (try
    (var body (read_skill "SKILL.md"))
    (var index ($str/join (skill_files) "\n  "))
    $"""
A Gene skill is loaded. Its entry page follows verbatim.

Where it says to check code by running `gene eval` or `gene run`, you instead
write the code to a note and call (run_note "name") — same idea, same purpose:
never report code you have not executed.

--- SKILL.md ---
${body}
--- end SKILL.md ---

Files you can (read_skill "...") on demand:
  ${index}
"""
    catch e
    $"\n(a skill directory was granted but could not be read: ${e/message})\n"))

(fn gene_primer [] : Str
  # The fallback when no skill is granted, and the floor when one is: these are
  # the rules a live model actually got wrong, kept short enough to always
  # afford. Without them it writes Lisp or JavaScript — `(def ...)`,
  # `xs.push(v)`, a chained send with no continuation marker.
  """Gene is not Lisp and not JavaScript. The rules you need:
- Every operator is PREFIX: (+ a 1), (== a b), (!= a b), (< a b). Never (a + 1)
  or (a == b) — that reads as calling `a` with two arguments.
- Comments start with "# " — one hash then a space. "##" is a read error.
- Bind with (var x value). Define with (fn name [a b] body). There is no `def`.
- Call a method by sending: (xs ~ push v), (m ~ get "k"). Never xs.push(v).
  With no arguments the shortcut is xs/~size, but only on a named binding.
- Standard library names need a $ sigil: ($println x), ($str/join xs ", "),
  ($str/trim s). A bare (println ...) is an undefined symbol. Types stay bare:
  Int, Str, List, Map.
- map/filter work on streams, and continuation lines start with `; ~`:
  ((xs ~ to_stream) ~ filter (fn [t] t/done) ; ~ into [])
- Lists are [1 2 3]; (xs ~ push v) appends. Maps are {^key value}; read m/key,
  write (m ~ put "key" v), or (m ~ assoc "key" v) for a new map.
- Only nil, false and void are falsy. "" and 0 and [] are all truthy.
- Strings interpolate with $"text ${expr}". Multi-line strings use triple quotes.
- Conditionals: (if c a b), (if_not c body...), (if_yes c body...),
  (match v (when pat body) (else nil)). Loops: (for x in xs ...), (while c ...).
- A list has no persistent append. (xs ~ push v) mutates xs in place; there is
  no `append` message.
- ^code is ONE (do ...) block, so a form may use what an earlier form defined.
  The value of its last form is what you get back.
- After writing a .gene note, call (run_note "name") to check it actually runs.
  Do not report success for code you have not run.""")

(fn system_prompt [] : Str
  $"""You are an agent whose only way to act is to emit a Gene program.
Reply with Gene data and nothing else, in exactly this shape:
{^status "done"|"in-progress" ^code (do form1 form2 ...) ^response "..."}
^code is one (do ...) block — the whole program, not a list of forms. Use ^status "in-progress" when you need
to see the result before continuing.
The forms may use ordinary pure Gene plus exactly these tools:
${(tool_summary)}
A form that reaches past that is refused, and you will see the refusal.
Anything you want to survive to the next turn must be written to the workspace
with ($fs/write_text ...); bindings do not outlive one reply.

${(gene_primer)}
${(loaded_skill)}
""")

(fn call_model [task history] : Str
  (if (env? "GENE_AGENT_STUB")
    (stub_reply task)
    (do
      (var key (get_env "OPENAI_AUTH_TOKEN"))
      (var model
        (if (env? "GENE_AGENT_MODEL")
          (get_env "GENE_AGENT_MODEL")
          "openai/gpt-5.6-terra"))
      (var body
        ($json/stringify
          {^model model
           ^messages [
             {^role "system" ^content (system_prompt)}
             {^role "user" ^content $"${task}\n\nPrior turns:\n${history}"}
           ]}))
      (var r
        (await (request ^url "https://openrouter.ai/api/v1/chat/completions"
                        ^method "POST"
                        ^headers {^authorization $"Bearer ${key}"
                                  ^content-type "application/json"}
                        ^body body
                        ^timeout_ms 60000)))
      (if_not (== r/status 200)
        (fail (AgentError ^message $"model returned status ${r/status}: ${r/body}")))
      (var parsed ($json/parse r/body))
      parsed/choices/0/message/content)))

# ---------------------------------------------------------------------------
# The two areas: output above, prompt below.
# ---------------------------------------------------------------------------

(fn parse_envelope [reply] : Any
  # `read_all` yields a Stream over the forms in the reply; the envelope is the
  # first. A model that answers in prose instead lands in the catch arm.
  (try
    ((read_all reply) ~ next)
    catch _
    nil))

(fn handle_task [task] : Void
  (var history ($cell ""))
  (var turn ($cell 0))
  (var running ($cell true))
  (while (running ~ get)
    (turn ~ set (+ (turn ~ get) 1))
    (var envelope (parse_envelope (call_model task (history ~ get))))
    (if (== envelope nil)
      (do
        ($println "  the model did not return Gene data")
        (running ~ set false))
      (do
        (var response envelope/response)
        (if (!= response nil)
          ($println "  " response))
        # The code is shown before it runs. `^response` is the model's *claim*
        # about what it is doing, composed before it could know the outcome;
        # printing the program next to it lets a reader check the claim against
        # what will actually execute rather than trusting the prose.
        ($println "  " envelope/code)
        (var result (run_program envelope/code))
        ($println "  " result)
        # The whole reply goes back, not just the result: the model needs to see
        # the code it wrote next to what that code did, or it cannot tell which
        # form drew which complaint and simply repeats the mistake. The task
        # itself is re-sent every turn by `call_model`, so it is not repeated
        # here.
        (var prior (history ~ get))
        (history ~ set $"${prior}\nreply: ${envelope}\noutput: ${result}")
        (if_not (== envelope/status "in-progress")
          (running ~ set false))
        # Only a model that still wants another turn can be cut off by the
        # limit. Announcing it after a reply that already said "done" would
        # blame the ceiling for a loop that ended on its own.
        (if_yes (&& (running ~ get) (>= (turn ~ get) 16))
          ($println "  (turn limit reached)")
          (running ~ set false))))))

(fn main [args]
  ^capabilities *
  ($println "safe_ai_agent — the model's only action is a Gene program")
  ($println "generated code may call:")
  ($println (tool_summary))
  (if (env? "GENE_AGENT_STUB")
    ($println "offline stub mode (GENE_AGENT_STUB set)"))
  ($println "")
  (var going ($cell true))
  (while (going ~ get)
    ($print "> ")
    (var line (read_line))
    (if (== line nil)
      (going ~ set false)
      (do
        (var task (trim line))
        (if (|| (== task "exit") (== task "quit") (== task "/quit"))
          (going ~ set false)
          (if (!= task "")
            (handle_task task))))))
  ($println "bye")
  0)
