(mod calendar)
(import * : p ^from "./persistence")
(fn floor_div [value, divisor]
  (let truncated ($to_int (/ value divisor)))
  (if (< (* truncated divisor) value) truncated
    (if (== (* truncated divisor) value) truncated (- truncated 1))))
(fn modulo [value, divisor] (- value (* divisor (floor_div value divisor))))
(fn leap? [year] (&& (== (modulo year 4) 0) (|| (!= (modulo year 100) 0) (== (modulo year 400) 0))))
(fn days_in_month [year, month]
  (let lengths [31 (if (leap? year) 29 28) 31 30 31 30 31 31 30 31 30 31])
  (if (|| (< month 1) (> month 12)) (p/problem "Invalid calendar month"))
  (let index (- month 1))
  lengths/%index)
(fn day_number [year, month, day]
  (if (|| (< day 1) (> day (days_in_month year month))) (p/problem "Invalid calendar date"))
  (let prior (- year 1))
  (var result (+ (* (- year 1970) 365) (- (floor_div prior 4) 492)
    (- 19 (floor_div prior 100)) (- (floor_div prior 400) 4) (- day 1)))
  (var current 1)
  (while (< current month)
    (set result (+ result (days_in_month year current)))
    (set current (+ current 1)))
  result)
(fn civil [days]
  (var remaining days)
  (var year 1970)
  (while (< remaining 0)
    (set year (- year 1))
    (set remaining (+ remaining (if (leap? year) 366 365))))
  (while (>= remaining (if (leap? year) 366 365))
    (set remaining (- remaining (if (leap? year) 366 365)))
    (set year (+ year 1)))
  (var month 1)
  (while (>= remaining (days_in_month year month))
    (set remaining (- remaining (days_in_month year month)))
    (set month (+ month 1)))
  {^year year ^month month ^day (+ remaining 1) ^weekday (modulo (+ days 4) 7) ^number days})
(fn shift_day [date, direction]
  (var year date/year)
  (var month date/month)
  (var day (+ date/day direction))
  (if_yes (> day (days_in_month year month))
    (set day 1)
    (set month (+ month 1))
    (if_yes (> month 12) (set month 1) (set year (+ year 1))))
  (if_yes (< day 1)
    (set month (- month 1))
    (if_yes (< month 1) (set month 12) (set year (- year 1)))
    (set day (days_in_month year month)))
  {^year year ^month month ^day day ^weekday (modulo (+ date/weekday direction) 7)
   ^number (+ date/number direction)})
(fn decimal [text]
  (let bytes ($binary/from_str text))
  (if (== ($binary/size bytes) 0) (p/problem "Expected a decimal integer"))
  (var result 0)
  (var index 0)
  (while (< index ($binary/size bytes))
    (let byte ($binary/get bytes index))
    (if (|| (< byte 48) (> byte 57)) (p/problem "Expected decimal digits"))
    (set result (+ (* result 10) (- byte 48)))
    (if (> result 1000000) (p/problem "Decimal value exceeds calendar bounds"))
    (set index (+ index 1)))
  result)
(fn local_seconds [date, time]
  (let d ($str/split date "-"))
  (let t ($str/split time ":"))
  (if (|| (!= d/.size 3) (< t/.size 1) (> t/.size 3)) (p/problem "Invalid calendar timestamp"))
  (+ (* (day_number (decimal d/0) (decimal d/1) (decimal d/2)) 86400)
    (* (decimal t/0) 3600) (if (> t/.size 1) (* (decimal t/1) 60) 0)
    (if (> t/.size 2) (decimal t/2) 0)))
