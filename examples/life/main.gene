(mod main)
(import * : runtime ^from "./runtime")
(import * : p ^from "./persistence")
(import * : body ^from "./body")
(import * : brain ^from "./brain")
(import * : organization ^from "./organization")
(import * : code ^from "./code")
(import * : budget ^from "./budget")
(import * : connector ^from "./connector")

(fn inspect [host, prefix = ""]
  (let result {})
  (for key in (p/keys host/store prefix) (result .put key (p/get host/store key)))
  result)

(fn command [host, request]
  (let op request/op)
  (if (== op "chat") (return (body/receive host request/text
    ^speaker (?? request/speaker "visitor") ^conversation (?? request/conversation "garden")
    ^thread (?? request/thread "main") ^external_id (?? request/id nil) ^cursor (?? request/cursor nil))))
  (if (== op "inspect") (return (inspect host (?? request/prefix ""))))
  (if (== op "budget") (return (budget/configure host request/model_calls_per_hour)))
  (if (== op "connect") (return (connector/register host request/connector request/endpoint request/peer_id)))
  (if_yes (["cancel-schedule" "cancel-owner"] .contains? op)
    (let tx (p/begin host/store "operator-cancel"))
    (let meta (p/tx_get tx "meta"))
    (let value (body/apply_operation host tx {^id "operator" ^organization meta/organization}
      (if (== op "cancel-schedule") "cancel" "cancel_owner") request))
    (p/commit tx)
    (return value))
  (if_yes (["register-routine" "cancel-routine"] .contains? op)
    (let tx (p/begin host/store "operator-routine"))
    (let meta (p/tx_get tx "meta"))
    (let value (body/apply_operation host tx {^id "operator" ^organization meta/organization}
      (if (== op "register-routine") "register_routine" "cancel_routine") request))
    (p/commit tx)
    (return value))
  (if_yes (["save-module" "select"] .contains? op)
    (let tx (p/begin host/store "operator-code"))
    (let value (if (== op "save-module")
      (code/module_bundle tx request/name request/files (?? request/entry "main.gene"))
      (organization/request tx request/definition (?? request/migration nil)
        (?? request/queued "defer") (== request/invalidate_inflight true)
        ^recovery (== request/recovery true))))
    (p/commit tx)
    (return value))
  (if_yes (== op "pause") (runtime/pause host) (return "paused"))
  (if_yes (== op "resume") (runtime/resume host) (return "running"))
  (if_yes (== op "tick") (body/tick host (?? request/ms 1000)) (return (p/get host/store "world")))
  (if (== op "decision")
    (then
      ((host/decisions .get) .push (brain/response request/note request/program))
      (let tx (p/begin host/store "operator"))
      (body/event host tx "operator_wake" {})
      (p/commit tx)
      (return "queued")))
  (if (== op "stop") (return "stop"))
  (p/problem "Unknown operator command"))

(fn send_command [home, request]
  (if_not ($fs/exists? $"${home}/inbox") (p/problem "Start the body before sending commands"))
  (let request_id (p/id "request"))
  (request .put "id" (?? request/id request_id))
  (let response $"${home}/replies/${request_id}.json")
  ($fs/write_text_atomic $"${home}/inbox/${request_id}.json" ($json/stringify request))
  (let deadline (+ ($os/monotonic_ms) 5000))
  (while (! ($fs/exists? response))
    (if (> ($os/monotonic_ms) deadline) (p/problem "Receipt not yet confirmed; retain the request ID before retrying"))
    ($sleep 10))
  (let reply ($json/parse ($fs/read_text response)))
  ($println ($json/stringify reply))
  reply)

(fn run_body [home, manual_clock]
  (let host (runtime/open_life home))
  ($fs/make_dir $"${home}/inbox")
  ($fs/make_dir $"${home}/replies")
  ($os/begin_interrupt)
  (var running true)
  (var last ($os/monotonic_ms))
  (let meta (p/get host/store "meta"))
  ($println $"Life ${meta/id} ready. Send commands from another terminal.")
  (try
    (while (&& running (! ($os/take_interrupt)))
      (for name in ($fs/list_dir $"${home}/inbox")
        (if_not ($str/ends_with? name ".json") (continue))
        (let path $"${home}/inbox/${name}")
        (let reply_path $"${home}/replies/${name}")
        # Keep an unacknowledged receipt in the inbox across process failure.
        (if_yes ($fs/exists? reply_path) ($fs/remove path) (continue))
        (let request ($json/parse ($fs/read_text path)))
        (if_yes (== request/op "stop") (set running false) (continue))
        (let reply (try {^ok true ^value (command host request)}
          catch Any {^ok false ^error $err/message}))
        ($fs/write_text_atomic reply_path ($json/stringify reply))
        ($fs/remove path))
      (if_not running (break))
      (runtime/heartbeat host)
      (let now ($os/monotonic_ms))
      (if_yes (&& (! manual_clock) (>= (- now last) 1000))
        (body/tick host (- now last))
        (set last now))
      ($sleep 5))
    (runtime/close_life host)
    # A stop acknowledgment is published only after the consistent checkpoint.
    (for name in ($fs/list_dir $"${home}/inbox")
      (let path $"${home}/inbox/${name}")
      (let request ($json/parse ($fs/read_text path)))
      (if_yes (== request/op "stop")
        ($fs/write_text_atomic $"${home}/replies/${name}" ($json/stringify {^ok true ^value "stopped"}))
        ($fs/remove path)))
    ($println "Life stopped; progress saved.")
    catch Any
      (let failure $err)
      (runtime/abandon host)
      (fail failure)
    ensure ($os/end_interrupt)))

(fn main [arguments]
  (let args arguments/.body)
  (if_yes (< args/.size 2)
    ($println "Usage: gene run examples/life/main.gene create|run|send|command|inspect HOME [TEXT|JSON|PREFIX]")
    (return 2))
  (let action args/0)
  (let home args/1)
  (try
    (if (== action "create")
      (then
        (let host (runtime/open_life home ^create true))
        (let meta (p/get host/store "meta"))
        (runtime/close_life host)
        ($println ($json/stringify {^id meta/id ^home home}))))
    (if (== action "run") (run_body home (== (?? args/2 "") "--manual-clock")))
    (if (== action "send") (send_command home {^op "chat" ^text args/2}))
    (if (== action "command") (send_command home ($json/parse args/2)))
    (if (== action "inspect")
      (then
        (let store (p/open_store home))
        (try
          (let result {})
          (for key in (p/keys store (?? args/2 "")) (result .put key (p/get store key)))
          ($println ($json/stringify result))
          ensure (p/close_store store))))
    0
    catch Any ($println $"Life failed: ${$err/message}") 1))
