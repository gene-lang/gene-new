(mod runtime)
(import * : p ^from "./persistence")
(import * : body ^from "../body/body")
(import * : brain ^from "../brain")
(import * : execution ^from "./execution")
(import * : code ^from "../code/code")
(import * : organization ^from "../code/organization")
(import * : routines ^from "../body/routines")
(import * : recovery ^from "./recovery")
(import * : scheduler ^from "../schedule/scheduler")
(import * : budget ^from "./budget")
(import * : connector ^from "../body/connector")
(import [wall_ms] ^from "./clock")

(type Host
  ^props {^store Any ^clock Any ^worker Str ^brain Any ^decisions Any
          ^active Cell ^thought Cell ^late Cell ^stopped Cell ^calls Cell ^fault Any ^background_dispatches Cell ^network Cell})

(fn initialize [host]
  (let tx (p/begin host/store "create"))
  (let seed "Curiosity about the surroundings and interest in tending a small garden")
  (p/tx_put tx "meta" {^id (p/id "life") ^version 1 ^mode "running" ^clean false
    ^disposition seed ^organization "starter@1" ^model {^provider "fake"}
    ^model_calls_per_hour 100 ^last_wall (host/clock)})
  (p/tx_put tx "organization/starter@1" {^id "starter@1" ^roots ["state/" "memory/"]
    ^code [] ^documentation "Starter keyed state and provenance-bearing memories"})
  (p/tx_put tx "world" {^sim_ms 0 ^position 0 ^orientation "east" ^inventory [] ^held nil
    ^places {^home 0 ^garden 10 ^shade 20}
    ^objects {^plant-a {^id "plant-a" ^position 10 ^status "dry" ^version 1}
              ^watering-can {^id "watering-can" ^position 0 ^version 1}}})
  (body/event host tx "first_start" {^disposition seed})
  (p/commit tx))

(fn restore [host]
  (recovery/validate host/store)
  (let meta (p/get host/store "meta"))
  (let world (p/get host/store "world"))
  (if (|| ($absent? meta) (!= meta/version 1) ($absent? world))
    (p/problem "Missing or incompatible required Life state"))
  (let selected (p/get host/store $"organization/${meta/organization}"))
  (if ($absent? selected) (p/problem "Missing selected organization"))
  (for revision in selected/code
    (code/read host/store revision))
  (let tx (p/begin host/store "recovery"))
  (let interrupted [])
  (for prefix in ["cycle/" "execution/" "job/"]
    (for key in (p/tx_keys tx prefix)
      (let record (p/tx_get tx key))
      (if_yes (["preparing" "thinking" "validating" "queued" "running"] .contains? record/status)
        (if_yes (&& (== prefix "job/") (== record/kind "walk"))
          (if_not (== record/recovery "walk@1") (p/problem "Missing walking recovery contract"))
          (continue))
        (if_yes (&& (!= prefix "cycle/") (== record/status "queued")) (continue))
        (if_not ($absent? record/routine_id)
          (let registration (p/tx_get tx $"routine/${record/routine_id}"))
          (if_yes (&& (! ($absent? registration)) (== registration/status "active")
                       (== registration/spec/recovery "checkpointed")
                       (== registration/generation record/routine_generation))
            (record .put "status" "queued")
            (record .put "recovery" "routine/checkpoint@1")
            (p/tx_put tx key record)
            (continue)))
        (record .put "status" "interrupted")
        (record .put "result" "Process ended; partial effects retained; no automatic replay")
        (p/tx_put tx key record)
        (interrupted .push record/id))))
  (recovery/reconcile_schedules tx)
  (let uncertain (connector/restore host tx))
  (let selection (organization/pending host/store))
  (routines/restore tx)
  (if_yes (&& (! ($absent? selection)) (== selection/status "migrating"))
    (selection .put "status" "interrupted")
    (selection .put "result" "Migration was not published; old selection retained")
    (p/tx_put tx $"selection/${selection/id}" selection)
    (p/tx_put tx "selection/pending" nil)
    (interrupted .push selection/id))
  (body/event host tx "restart" {^clean meta/clean ^interrupted interrupted ^uncertain_deliveries uncertain
    ^downtime_ms ($math/max 0 (- (host/clock) meta/last_wall)) ^sim_ms world/sim_ms})
  (meta .put "clean" false)
  (meta .put "last_wall" (host/clock))
  (p/tx_put tx "meta" meta)
  (p/commit tx))

(fn open_life [home, ^create create = false, ^clock clock = wall_ms,
               ^brain provider = nil, ^decisions decisions = nil,
               ^worker worker = "examples/life/src/worker/worker.gene", ^fault fault = nil]
  (let store (p/open_store home ^create create))
  (let host (Host ^store store ^clock clock ^worker ($fs/real_path worker)
    ^brain provider ^decisions ($cell (?? decisions [])) ^active ($cell nil) ^thought ($cell nil) ^late ($cell [])
    ^stopped ($cell false) ^calls ($cell 0) ^fault fault ^background_dispatches ($cell 0)
    ^network ($cell {^requests {} ^next {} ^lanes {}})))
  (try
    (if create (initialize host) (restore host))
    host
    catch Any
      (p/close_store store)
      (fail $err)))

(fn take_last [items, maximum]
  (let result [])
  (var index ($math/max 0 (- items/.size maximum)))
  (while (< index items/.size)
    (result .push items/%index)
    (set index (+ index 1)))
  result)
(fn context [host, events]
  (let meta (p/get host/store "meta"))
  (let selected [])
  (var focus nil)
  (for item in events
    (if (>= selected/.size 32) (break))
    (selected .push item)
    (if_not ($absent? item/reply_to) (set focus {^event_id item/id ^reply_to item/reply_to})))
  (let notes [])
  (for cycle in (take_last (p/values host/store "cycle/") 8)
    (if_not ($absent? cycle/note)
      (notes .push {^id cycle/id ^note cycle/note ^status cycle/status ^result (?? cycle/result nil)})))
  (let pending [])
  (for job in (p/values host/store "job/") (if_yes (body/queued? job) (pending .push job)))
  (let state {})
  (for key in (take_last (p/keys host/store "state/") 32) (state .put key (p/get host/store key)))
  {^life_id meta/id ^context_id (p/id "context") ^now (host/clock) ^disposition meta/disposition
   ^policy_revisions {^organization meta/organization} ^focus focus ^observations selected
   ^recent_decisions notes ^pending_work pending ^state state
   ^memory_excerpt (take_last (p/values host/store "memory/") 12)
   ^api_documentation "Gene bindings: store, state, memory, body/world, body/chat, scheduler, code, life. See src/worker/api.gene."})

(fn finish [host, record, prefix, status, result]
  (let tx (p/begin host/store record/id))
  (let latest (p/tx_get tx $"${prefix}${record/id}"))
  (if_yes (== latest/cancellation_requested true)
    (for field in ["cancellation_requested" "cancellation_cause" "cancellation_reason"]
      (record .put field (latest .get field))))
  (record .put "status" status)
  (record .put "result" result)
  (p/tx_put tx $"${prefix}${record/id}" record)
  (for event_id in (?? record/events [])
    (let observation (p/tx_get tx $"event/${event_id}"))
    (if (== status "succeeded")
      (then (observation .put "considered_by" record/id))
      (else
        (observation .put "attempts" (+ observation/attempts 1))
        (observation .delete "attention_checked")))
    (p/tx_put tx $"event/${event_id}" observation))
  (scheduler/finish tx record status result)
  (if_yes (&& (! ($absent? record/schedule_id)) (["expired" "failed"] .contains? status))
    (body/event host tx (if (== status "expired") "missed_schedule" "schedule_failed")
      {^id record/schedule_id ^execution_id record/id ^result result} ^cause record/id))
  (if_yes (== prefix "job/")
    (body/event host tx "job_outcome" {^id record/id ^status status ^result result} ^cause record/id))
  (if_yes (&& (== prefix "cycle/") (["failed" "rejected" "invalidated" "interrupted"] .contains? status))
    (let observation (body/event host tx "decision_error"
      {^cycle_id record/id ^status status ^error ($str/slice_bytes ($to_str result) 0 4096)
       ^source_events (?? record/events [])} ^event_id $"decision-error:${record/id}" ^cause record/id))
    # A correction accompanies an already eligible retry or new information.
    # It must not invent a fresh retry budget merely by recording a failure.
    (observation .put "wake_source" false)
    (p/tx_put tx $"event/${observation/id}" observation))
  (if_yes (routines/finish tx record status result)
    (body/event host tx "routine_failed" {^id record/routine_id ^execution_id record/id ^result result} ^cause record/id))
  (p/commit tx))

(fn think [host, events]
  (let snapshot (context host events))
  (let ids [])
  (for observation in snapshot/observations (ids .push observation/id))
  (let cycle {^id (p/id "cycle") ^at (host/clock) ^status "thinking" ^context snapshot
    ^context_id snapshot/context_id ^events ids ^organization snapshot/policy_revisions/organization})
  (let selected (p/get host/store $"organization/${cycle/organization}"))
  (cycle .put "code_revisions" selected/code)
  (if_yes (|| (== selected/context true) (== selected/attention true) (== selected/ownership true))
    (cycle .put "status" "preparing")
    (cycle .put "context_basis" snapshot)
    (cycle .put "program" "nil")
    (p/put host/store $"cycle/${cycle/id}" cycle cycle/id)
    (try
      (let active (execution/launch host cycle "context"))
      (active .put "prefix" "cycle/")
      (host/active .set active)
      catch Any (finish host cycle "cycle/" "rejected" $err/message))
    (return nil))
  (invoke_brain host cycle))

(fn invoke_brain [host, cycle]
  (let snapshot cycle/context)
  (if_not (budget/available? host)
    (let tx (p/begin host/store cycle/id))
    (cycle .put "status" "deferred")
    (cycle .put "result" "Model admission budget exhausted")
    (for event_id in cycle/events
      (let event (p/tx_get tx $"event/${event_id}"))
      (event .delete "attention_checked")
      (p/tx_put tx $"event/${event_id}" event))
    (p/tx_put tx $"cycle/${cycle/id}" cycle)
    (p/commit tx)
    (return nil))
  (cycle .put "status" "thinking")
  (let admission (p/begin host/store cycle/id))
  (cycle .put "model_admission" (budget/reserve host admission cycle/id))
  (p/tx_put admission $"cycle/${cycle/id}" cycle)
  (p/commit admission)
  (let done ($cell nil))
  (let task (spawn ^lane root
    (try
      (host/calls .set (+ (host/calls .get) 1))
      (let raw (if ($absent? host/brain) (brain/fake host/decisions snapshot) (host/brain snapshot)))
      (done .set {^ok true ^raw raw})
      catch Any (done .set {^ok false ^error $err/message}))))
  (host/thought .set {^cycle cycle ^task task ^done done ^started ($os/monotonic_ms)}))

(fn poll_thought [host]
  (let thought (host/thought .get))
  (if ($absent? thought) (return nil))
  (let retained (p/get host/store $"cycle/${thought/cycle/id}"))
  (if_not (== retained/status "thinking")
    ((host/late .get) .push thought)
    (host/thought .set nil)
    (return nil))
  (if_yes (> (- ($os/monotonic_ms) thought/started) 30000)
    (thought/task .cancel)
    (thought/done .set {^ok false ^error "Brain deadline exceeded"}))
  (let reply (thought/done .get))
  (if ($absent? reply) (return nil))
  (let cycle (p/get host/store $"cycle/${thought/cycle/id}"))
  (let meta (p/get host/store "meta"))
  (if_yes (&& (== cycle/status "thinking") (!= meta/mode "running"))
    (cycle .put "status" "superseded")
    (cycle .put "result" "Operator paused before response admission"))
  (if_not (== cycle/status "thinking")
    (cycle .put "diagnostic" ($to_str reply))
    (p/put host/store $"cycle/${cycle/id}" cycle)
    (host/thought .set nil)
    (return nil))
  (if_not ($absent? (host/active .get)) (return nil))
  (host/thought .set nil)
  (try
    (if_not reply/ok (p/problem reply/error))
    (let basis (p/begin host/store "response-admission"))
    (if_not (body/valid_basis basis cycle)
      (cycle .put "diagnostic" ($to_str reply/raw))
      (finish host cycle "cycle/" "invalidated" "A declared ownership generation changed during inference")
      (return nil))
    (let response (brain/decode reply/raw))
    (cycle .put "program" response/program)
    (cycle .put "candidate_note" response/note)
    (cycle .put "diagnostic" ($to_str reply/raw))
    (cycle .put "status" "validating")
    (p/put host/store $"cycle/${cycle/id}" cycle)
    (let active (execution/launch host cycle "validate"))
    (active .put "prefix" "cycle/")
    (host/active .set active)
    catch Any
      (cycle .put "diagnostic" ($to_str reply))
      (finish host cycle "cycle/" "rejected" $err/message)))

(fn poll_late [host]
  (let remaining [])
  (for thought in (host/late .get)
    (if_yes (> (- ($os/monotonic_ms) thought/started) 30000)
      (thought/task .cancel)
      (thought/done .set {^ok false ^error "Superseded request deadline exceeded"}))
    (let reply (thought/done .get))
    (if_yes ($absent? reply) (remaining .push thought) (continue))
    (let cycle (p/get host/store $"cycle/${thought/cycle/id}"))
    (cycle .put "diagnostic" ($to_str reply))
    (cycle .put "late_response" true)
    (p/put host/store $"cycle/${cycle/id}" cycle cycle/id))
  (host/late .set remaining))

(fn start_selection [host, request]
  (if_yes (&& (== request/queued "defer") (organization/has_work? host/store request))
    (organization/reject host/store request "deferred" "Affected queued work requires a disposition")
    (return nil))
  (try
    (request .put "status" "migrating")
    (p/put host/store $"selection/${request/id}" request request/id)
    (let tx (p/begin host/store request/id))
    (let migration (code/read host/store request/migration))
    (let token (p/id "migration-tx"))
    (let record {^id request/id ^organization request/from ^target_organization request/definition/id ^program migration/source
      ^candidate_module (?? request/definition/module nil)
      ^input {^tx token ^from request/from ^to request/definition/id}})
    (let active (execution/launch host record "migration"))
    (active .put "selection" request)
    (active/tx .set tx)
    (active/tx_id .set token)
    (host/active .set active)
    catch Any (organization/reject host/store request "failed" $err/message)))

(fn finish_selection [host, active, result]
  (let request active/selection)
  (let tx (active/tx .get))
  (if_not (== result/status "succeeded")
    (p/abort tx)
    (organization/reject host/store request result/status result/result)
    (return nil))
  (try
    (let meta (p/tx_get tx "meta"))
    (if_not (== meta/organization request/from) (p/problem "Selection base changed"))
    (organization/disposition tx request)
    (let registrations [])
    (for key in (p/tx_keys tx "routine/")
      (let registration (p/tx_get tx key))
      (if_yes (&& (== registration/organization request/definition/id) (== registration/status "active"))
        (registrations .push registration/id)
        (if_not (request/definition/code .contains? registration/code_revision)
          (request/definition/code .push registration/code_revision))))
    (request/definition .put "registrations" registrations)
    (p/tx_put tx $"organization/${request/definition/id}" request/definition)
    (meta .put "organization" request/definition/id)
    (p/tx_put tx "meta" meta)
    (request .put "status" "selected")
    (request .put "result" result/result)
    (request .put "comparison" result/data)
    (p/tx_put tx $"selection/${request/id}" request)
    (p/tx_put tx "selection/pending" nil)
    (body/event host tx "organization_changed" {^from request/from ^to request/definition/id
      ^selection_id request/id} ^cause request/id)
    (if_not ($absent? host/fault) (host/fault "selection_before_commit"))
    (p/commit tx)
    (if_not ($absent? host/fault) (host/fault "selection_after_commit"))
    catch Any
      (p/abort tx)
      (organization/reject host/store request "failed" $err/message)))

(fn finish_active [host, active, result]
  (let record active/record)
  (if_yes (== active/mode "migration") (finish_selection host active result) (return nil))
  (let retained (if (== active/prefix "cycle/") (p/get host/store $"cycle/${record/id}") nil))
  (if_yes (&& (! ($absent? retained)) (== retained/status "superseded"))
    (retained .put "diagnostic" (?? record/diagnostic result/result))
    (p/put host/store $"cycle/${record/id}" retained)
    (return nil))
  (if_yes (== active/mode "context")
    (if (&& (== result/status "succeeded") (== ($head result/data/view) Map)
            (== ($head result/data/event_ids) List)
            (<= ($str/byte_size ($serde/write_data result/data/view)) 65536))
      (then
        (let tx (p/begin host/store record/id))
        (let deferred [])
        (for event_id in record/events
          (let observation (p/tx_get tx $"event/${event_id}"))
          (observation .put "attention_checked" record/organization)
          (p/tx_put tx $"event/${event_id}" observation)
          (if_not (result/data/event_ids .contains? event_id) (deferred .push event_id)))
        (record .put "events" result/data/event_ids)
        (record .put "deferred_events" deferred)
        (record .put "context" result/data/view)
        (record .put "read_revisions" result/read_revisions)
        (record .put "ownership" result/data/ownership)
        (if_not (body/valid_basis tx record)
          (p/abort tx)
          (finish host record "cycle/" "invalidated" "A declared ownership generation changed during context construction")
          (return nil))
        (record .delete "program")
        (record .put "status" (if (== record/events/.size 0) "deferred" "thinking"))
        (p/tx_put tx $"cycle/${record/id}" record)
        (p/commit tx)
        (if (> record/events/.size 0) (invoke_brain host record)))
      (else (finish host record "cycle/" "rejected" $"Context builder failed or exceeded its bound: ${result/result}")))
    (return nil))
  (if_yes (== active/mode "validate")
    (if (== result/status "succeeded")
      (then
        (record .put "note" record/candidate_note)
        (record .delete "candidate_note")
        (record .put "status" "queued")
        (p/put host/store $"cycle/${record/id}" record))
      (else (finish host record "cycle/" "rejected" result/result)))
    (return nil))
  (finish host record active/prefix result/status result/result))

(fn eligible_events [host]
  (let meta (p/get host/store "meta"))
  (let fresh [])
  (let deferred [])
  (for observation in (p/values host/store "event/")
    (if_yes (&& ($absent? observation/considered_by) (< observation/attempts 2))
      (if (|| (== observation/attention_checked meta/organization) (== observation/wake_source false))
        (deferred .push observation) (fresh .push observation))))
  (if (== fresh/.size 0) (return []))
  (for observation in deferred (fresh .push observation))
  fresh)

(fn heartbeat [host]
  (if (host/stopped .get) (return nil))
  (if_not ($absent? (host/store/fault .get))
    (let reason (host/store/fault .get))
    (abandon host)
    (p/problem $"Body stopped after a persistent write failure; reopen for recovery: ${reason}"))
  (connector/tick host)
  (let active (host/active .get))
  (if_not ($absent? active)
    # A known terminal process supplies its actual outcome. A later withdrawal
    # must not relabel completed execution as a successful cancellation.
    (if_yes ($absent? (active/done .get))
      (let admission (p/begin host/store "active-ownership"))
      (if_not (body/valid_basis admission active/record)
        (active .put "cancel_status" "cancelled")
        (execution/cancel active))
      (let cancelled (scheduler/inadmissible admission active/record (host/clock)))
      (if_not ($absent? cancelled)
        (let item (p/tx_get admission $"schedule/${active/record/schedule_id}"))
        (if_not (== item/updated_by active/record/id)
          (active .put "cancel_status" cancelled)
          (execution/cancel active))))
    (let result (execution/poll host active))
    (if_not ($absent? result)
      (host/active .set nil)
      (finish_active host active result)))
  (poll_late host)
  (poll_thought host)
  (let meta (p/get host/store "meta"))
  (let pending (organization/pending host/store))
  (if_yes (!= meta/mode "running")
    (if_yes (&& ($absent? (host/active .get)) (! ($absent? pending)) (== pending/recovery true))
      (start_selection host pending))
    (return nil))
  (if_not ($absent? (host/active .get)) (return nil))
  (if_yes ($absent? pending) (body/due host) (routines/due host))
  # Bounded queue fairness: a stream of successful callbacks cannot prevent
  # attention admission or keep an already accepted decision queued forever.
  (if_yes (&& ($absent? pending) (>= (host/background_dispatches .get) 1) ($absent? (host/thought .get)))
    (let events (eligible_events host))
    (var queued_cycle false)
    (for cycle in (p/values host/store "cycle/")
      (if_yes (== cycle/status "queued") (set queued_cycle true)))
    (if_yes (&& (! queued_cycle) (> events/.size 0) (budget/available? host))
      (think host events)
      (if_not ($absent? (host/active .get)) (return nil))))
  (let order (if (>= (host/background_dispatches .get) 1)
    ["cycle/" "execution/" "job/"] ["execution/" "cycle/" "job/"]))
  (for prefix in (if ($absent? pending) order ["cycle/"])
    (for record in (p/values host/store prefix)
      (if_yes (&& (== record/status "queued") (!= record/kind "walk"))
        (let tx (p/begin host/store "admission"))
        (if (|| (! (body/valid_basis tx record)) (!= record/organization meta/organization)
                (! (routines/admitted? tx record)))
          (then (finish host record prefix "invalidated" "Ownership or organization changed") (continue)))
        (let admission (scheduler/inadmissible tx record (host/clock) ^dispatch true))
        (if_not ($absent? admission)
          (finish host record prefix admission "Schedule changed or its dispatch window expired")
          (continue))
        (record .put "status" "running")
        (p/put host/store $"${prefix}${record/id}" record record/id)
        (host/background_dispatches .set (if (== prefix "cycle/") 0 (+ (host/background_dispatches .get) 1)))
        (let execution (execution/launch host record (if (== record/kind "routine") "routine" "run")))
        (execution .put "prefix" prefix)
        (host/active .set execution)
        (return nil))))
  (if_not ($absent? (host/thought .get)) (return nil))
  (if_not ($absent? pending) (start_selection host pending) (return nil))
  (let eligible (eligible_events host))
  (if (&& (> eligible/.size 0) (budget/available? host)) (think host eligible)))

(fn settle [host]
  (let deadline (+ ($os/monotonic_ms) 15000))
  (loop
    (heartbeat host)
    ($sleep 5)
    (let meta (p/get host/store "meta"))
    (if (!= meta/mode "running") (return nil))
    (if (> ($os/monotonic_ms) deadline) (p/problem "Settle deadline exceeded"))
    (var pending false)
    (if_not ($absent? (organization/pending host/store)) (set pending true))
    (let eligible (eligible_events host))
    (if_yes (&& (> eligible/.size 0) (budget/available? host)) (set pending true))
    (for prefix in ["cycle/" "execution/" "job/"]
      (for item in (p/values host/store prefix)
        (if_yes (&& (== item/status "queued") (!= item/kind "walk")) (set pending true))))
    (if (&& (! pending) ($absent? (host/active .get)) ($absent? (host/thought .get))) (return nil))))

(fn pause [host]
  (let meta (p/get host/store "meta"))
  (meta .put "mode" "paused")
  (p/put host/store "meta" meta "pause-request")
  (let active (host/active .get))
  (if_not ($absent? active)
    (execution/cancel active)
    (while (! ($absent? (host/active .get))) (heartbeat host) ($sleep 5)))
  (for cycle in (p/values host/store "cycle/")
    (if_yes (["thinking" "queued"] .contains? cycle/status)
      (cycle .put "status" "superseded")
      (cycle .put "result" "Operator paused")
      (p/put host/store $"cycle/${cycle/id}" cycle "pause")))
  (p/put host/store "meta" meta "pause-settled"))
(fn resume [host]
  (let tx (p/begin host/store "resume"))
  (let meta (p/tx_get tx "meta"))
  (meta .put "mode" "running")
  (p/tx_put tx "meta" meta)
  (body/event host tx "resume" {})
  (p/commit tx))
(fn abandon [host]
  # Release transient handles without claiming a clean, durable stop. This path
  # remains usable when persistence itself cannot record execution outcomes.
  (connector/stop host)
  (let active (host/active .get))
  (if_not ($absent? active)
    (execution/cancel active)
    (active/task .join)
    (active/monitor .join)
    (if_not ($absent? (active/tx .get)) (p/abort (active/tx .get)))
    (host/active .set nil))
  (let thought (host/thought .get))
  (if_not ($absent? thought) (thought/task .cancel) (thought/task .join))
  (for late in (host/late .get) (late/task .cancel) (late/task .join))
  (host/stopped .set true)
  (p/close_store host/store))

(fn clean_stop [host]
  (let meta (p/get host/store "meta"))
  (let mode meta/mode)
  (pause host)
  (connector/stop host)
  (let thought (host/thought .get))
  (if_not ($absent? thought) (thought/task .cancel) (thought/task .join))
  (for late in (host/late .get) (late/task .cancel) (late/task .join))
  (meta .put "mode" mode)
  (meta .put "clean" true)
  (meta .put "last_wall" (host/clock))
  (p/put host/store "meta" meta "clean-stop")
  (host/stopped .set true)
  (p/close_store host/store))

(fn close_life [host]
  (try (clean_stop host)
    catch Any
      (let failure $err)
      (abandon host)
      (fail failure)))
