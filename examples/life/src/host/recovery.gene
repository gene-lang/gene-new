# Validate stable host and adapter contracts, never the brain's cognitive schema.
(mod recovery)
(import * : p ^from "./persistence")
(import * : scheduler ^from "../schedule/scheduler")
(import * : timezone ^from "../schedule/timezone")

(fn require [condition, message]
  (if_not condition (p/problem $"Recovery failure: ${message}")))
(fn string? [value] (&& (== ($head value) Str) (!= value "")))
(fn number? [value] ([Int Float] .contains? ($head value)))

(fn validate [store]
  (let meta (p/get store "meta"))
  (require (&& (== ($head meta) Map) (string? meta/id) (== meta/version 1)
               (["running" "paused"] .contains? meta/mode) (== ($head meta/clean) Bool)
               (string? meta/organization) (number? meta/last_wall)) "incompatible identity or control state")
  (let profile (?? meta/world_profile "local"))
  (require (["local" "network"] .contains? profile) "unknown world profile")
  (if (== profile "network") (validate_network store) (validate_local store))
  (for chat in (p/values store "conversation/")
    (require (&& (string? chat/id) (== ($head chat/messages) List) (== ($head chat/participants) List)
                 (== ($head chat/pending) List)) "incomplete conversation checkpoint")
    (let messages [])
    (for message in chat/messages
      (require (&& (string? message/id) (string? message/speaker) (string? message/thread)
                   (== ($head message/text) Str)) "incomplete retained message")
      (messages .push message/id))
    (for pending in chat/pending (require (messages .contains? pending) "pending reply lost its retained message")))
  (for schedule in (p/values store "schedule/")
    (if_not ($absent? schedule/recurrence)
      (timezone/check (p/get store $"timezone/${schedule/timezone/revision}") schedule/timezone/revision)))
  nil)

# The local world is a checkpoint this Life owns, so it must agree with itself.
(fn validate_local [store]
  (let world (p/get store "world"))
  (require (&& (== ($head world) Map) (number? world/position)
               (string? world/orientation) (== ($head world/inventory) List)
               (== ($head world/sim_ms) Int) (>= world/sim_ms 0)
               (== ($head world/places) Map) (== ($head world/objects) Map)) "incomplete world checkpoint")
  (if_not ($absent? world/held)
    (require (&& (string? world/held) (world/inventory .contains? world/held)) "held object is absent from inventory"))
  (for object_id in world/inventory (require (string? object_id) "invalid inventory identity"))
  (for pair in world/places (require (number? pair/1) "invalid retained place"))
  (for pair in world/objects
    (let object pair/1)
    (require (&& (== object/id ($to_str pair/0)) (number? object/position)
                 (== ($head object/version) Int) (> object/version 0)) "invalid retained world object"))
  (var walking 0)
  (for job in (p/values store "job/")
    (validate_job job)
    (if_yes (&& (== job/kind "walk") (["queued" "running"] .contains? job/status))
      (set walking (+ walking 1))
      (require (== ($to_float job/position) ($to_float world/position)) "world and walking checkpoint disagree")))
  (require (<= walking 1) "multiple authoritative walking activities"))

# A shared world is not this Life's to validate: its view is only what it last
# observed. Its own records — cursors, outbox, results, continuations — must
# be complete, and it has no local walks.
(fn validate_network [store]
  (require ($absent? (p/get store "world")) "a networked Life has no local world checkpoint")
  (let cursor (p/get store "world_cursor"))
  (require (&& (== ($head cursor) Map) (== ($head cursor/received) Int) (== ($head cursor/routed) Int)
               (>= cursor/routed 0) (<= cursor/routed cursor/received)) "incomplete world cursors")
  (let routing (p/get store "world_routing"))
  (require (== ($head routing/pending) List) "incomplete world routing markers")
  (let dispatcher (p/get store "world_dispatcher"))
  (require (== dispatcher/id "world-result-dispatcher") "missing world result dispatcher")
  (for op in (p/values store "world_op/")
    (require (&& (string? op/id) (string? op/operation) (== ($head op/input) Map)
      (["pending" "attempting" "reconciling" "needs_reconciliation" "settled" "cancelled"] .contains? op/status))
      "incomplete world request"))
  (for cont in (p/values store "world_cont/")
    (require (&& (string? cont/operation_id) (string? cont/code_revision)
      (["waiting" "ready" "running" "completed" "failed" "cancelled" "interrupted" "invalidated"] .contains? cont/status))
      "incomplete world continuation"))
  (for job in (p/values store "job/")
    (validate_job job)
    (require (!= job/kind "walk") "a networked Life cannot hold a local walk")))

(fn validate_job [job]
  (require (&& (string? job/id) (string? job/organization) (["walk" "gene"] .contains? job/kind)
    (["queued" "running" "succeeded" "failed" "interrupted" "invalidated" "cancelled"] .contains? job/status))
    "incomplete retained activity")
  (if (== job/kind "walk")
    (require (&& (== job/recovery "walk@1") (number? job/position) (number? job/destination)
                 (== ($head job/steps) Int) (>= job/steps 0)) "missing walk continuation contract")
    (require (string? job/program) "missing arbitrary job source")))

(fn reconcile_schedules [tx]
  (for key in (p/tx_keys tx "schedule/")
    (let schedule (p/tx_get tx key))
    (if_not (== schedule/status "running") (continue))
    (var linked nil)
    (for run_key in (p/tx_keys tx "execution/")
      (let run (p/tx_get tx run_key))
      (if_yes (== run/schedule_id schedule/id) (set linked run)))
    (if ($absent? linked)
      (then
        (schedule .put "status" "interrupted")
        (schedule .put "result" "Published schedule has no retained execution; do not replay blindly"))
      (else
        (schedule .put "execution_id" linked/id)
        (if_not (== linked/status "queued")
          (schedule .put "status" linked/status)
          (schedule .put "result" (?? linked/result nil)))))
    (p/tx_put tx key schedule)
    (if_yes (&& (! ($absent? linked)) (!= linked/status "queued") (! ($absent? schedule/recurrence)))
      (schedule .put "status" "running")
      (p/tx_put tx key schedule)
      (scheduler/finish tx linked linked/status (?? linked/result "Interrupted recurrence")))))
