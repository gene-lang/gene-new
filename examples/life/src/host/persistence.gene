(mod persistence)
(import $db/sqlite [open open_file Db])
(import $serde [write_data read_data])

(type LifeError ^props {^message Str} ^impl [Error])
(impl Error for LifeError)
(fn problem [message] (fail (LifeError ^message message)))
(fn copy [value] (read_data (write_data value)))
(fn id [prefix] $"${prefix}-${($crypto/random_hex 12)}")

# `records` is the head of every record the Life works with, in memory, by
# key. A commit replaces the entries it wrote and leaves the rest alone, so a
# transaction costs what it reads and writes, not what the Life has retained.
# Commit receipts are the exception: one is written by every commit and almost
# none is read again, so they stay in the database and are read from there.
#
# `groups` lists the keys of `records` by their part up to the first "/", in
# the order they were first written, so a scan under "cycle/" visits the
# cycles and nothing else.
#
# `latest` is the newest revision this connection has published and `born` the
# revision at which a key first appeared since the store was opened. They let
# a transaction see the store as it was when it began without copying it.
(type DurableStore
  ^props {^db Any ^claim Any ^home Str ^backend Str ^records Cell ^groups Any ^latest Cell ^born Any
          ^closed Cell ^fail_next Cell ^fault Cell})

# Two storage backends behind one interface, chosen when a Life is created and
# recognized afterwards by which file exists:
#
#   "image" — life.sqlite through `$db/sqlite/open`: a connection-local image
#             republished whole and atomically on every COMMIT. The original
#             local profile; the failed-publication contract below is its own.
#   "file"  — life.db through `$db/sqlite/open_file`: SQLite's pager and WAL
#             write only the changed pages (docs/proposals/world.md §12.8).
#             WAL, synchronous=FULL and fullfsync; a commit is durable when
#             COMMIT returns. Networked Lives use it.
#
# Both publish records, head moves and the commit receipt in one transaction.
(let backend_files {^image "life.sqlite" ^file "life.db"})
(fn storage_settings [store]
  (if (== store/backend "file")
    {^backend "sqlite/open_file" ^file "life.db" ^journal_mode "wal" ^synchronous "full"
     ^fullfsync "on" ^busy_timeout_ms 5000}
    {^backend "sqlite/open" ^file "life.sqlite" ^publication "whole image per commit"}))

(fn detect_backend [home]
  (let image ($fs/exists? $"${home}/life.sqlite"))
  (let file ($fs/exists? $"${home}/life.db"))
  (if (&& image file) (problem "Life has both an image and a file database; refusing to guess"))
  (if file "file" (if image "image" nil)))
# `snapshot` is the store's newest revision when the transaction began; `seen`
# keeps each record it has read, as it was then.
(type Transaction
  ^props {^store DurableStore ^snapshot Int ^seen Any ^reads Any ^writes Any ^cause Str ^closed Cell})

# Receipts are `commit/<id>`; `receipts_end` is the first key after all of them.
(let receipts "commit/")
(let receipts_end "commit0")
(fn receipt? [key] ($str/starts_with? key receipts))
(fn spans_receipts? [prefix]
  (|| ($str/starts_with? receipts prefix) ($str/starts_with? prefix receipts)))
(fn absent [] {^revision nil ^value nil})
# "cycle/" for "cycle/abc" and for the prefix "cycle/ab"; nil without a "/".
(fn group_of [key]
  (let parts ($str/split key "/"))
  (if (> parts/.size 1) $"${parts/0}/" nil))
(fn enlist [groups, key]
  (let group (group_of key))
  (if ($absent? group) (return nil))
  (let listed (groups .get group))
  (if (== listed void) (groups .put group [key]) (listed .push key)))

(fn open_store [home, ^create create = false, ^backend requested = "image"]
  (if create ($fs/make_dir home)
    (if_not ($fs/exists? home) (problem "Life does not exist; create it explicitly")))
  (let claim ($fs/try_lock $"${home}/writer.lock"))
  (if ($absent? claim) (problem "Life already has an active writer"))
  (try
    (let found (detect_backend home))
    (if (&& create (! ($absent? found))) (problem "Life already exists"))
    (if (&& (! create) ($absent? found)) (problem "Missing Life database"))
    (let backend (if create requested found))
    (if_not (["image" "file"] .contains? backend) (problem "Unknown Life storage backend"))
    (let path $"${home}/$(backend_files .get backend)")
    (let db (if (== backend "file")
      (open_file path ^create create ^busy_timeout_ms 5000)
      (open path)))
    (try
      (if_yes (== backend "file")
        (let mode (db .Db:query "PRAGMA journal_mode=WAL"))
        (if_not (== mode/0/journal_mode "wal") (problem "Life store could not enter WAL mode"))
        (db .Db:exec "PRAGMA synchronous=FULL")
        (db .Db:exec "PRAGMA fullfsync=ON")
        (db .Db:exec "PRAGMA checkpoint_fullfsync=ON"))
      # `records_by_key` finds an earlier revision of one key (see `stored`). A
      # store created before it existed works without it, only more slowly there.
      (if_yes create
        (db .Db:exec "BEGIN; CREATE TABLE records (revision INTEGER PRIMARY KEY AUTOINCREMENT,
          key TEXT NOT NULL, value TEXT NOT NULL, cause TEXT NOT NULL);
          CREATE TABLE heads (key TEXT PRIMARY KEY, revision INTEGER NOT NULL);
          CREATE INDEX records_by_key ON records(key, revision);
          PRAGMA user_version=1; COMMIT;"))
      (let version (db .Db:query "PRAGMA user_version"))
      (if_not (== version/0/user_version 1) (problem "Unsupported storage version"))
      (let health (db .Db:query "PRAGMA quick_check"))
      (if_not (== health/0/quick_check "ok") (problem "Life database failed integrity validation"))
      (let missing (db .Db:query "SELECT count(*) AS missing FROM heads h LEFT JOIN records r ON h.revision=r.revision WHERE r.revision IS NULL OR h.key != r.key"))
      (if_not (== missing/0/missing 0) (problem "Life database contains missing or mismatched head revisions"))
      (let records {})
      (let groups {})
      (for row in (db .Db:query "SELECT r.key,r.revision,r.value FROM heads h JOIN records r ON h.revision=r.revision
          WHERE h.key < ? OR h.key >= ? ORDER BY h.rowid" receipts receipts_end)
        (records .put row/key {^revision row/revision ^value (read_data row/value)})
        (enlist groups row/key))
      (let newest (db .Db:query "SELECT coalesce(max(revision),0) AS revision FROM records"))
      (DurableStore ^db db ^claim claim ^home home ^backend backend ^records ($cell records)
        ^groups groups ^latest ($cell newest/0/revision) ^born {}
        ^closed ($cell false) ^fail_next ($cell false) ^fault ($cell nil))
      catch Any
        db/.Db:close
        (fail $err))
    catch Any
      claim/.close
      (fail $err)))

# Reads from the database never go past `limit`: a publication that failed can
# leave rows in the connection that were never part of the store.
(fn receipt [store, key, limit]
  (let rows (store/db .Db:query "SELECT r.revision,r.value FROM heads h JOIN records r ON h.revision=r.revision
      WHERE h.key=? AND h.revision<=?" key limit))
  (if (== rows/.size 0) (absent) {^revision rows/0/revision ^value (read_data rows/0/value)}))
# Receipts under `prefix`, oldest first, as {^key ^revision ^value} rows.
(fn receipt_rows [store, prefix, limit]
  (if_not (spans_receipts? prefix) (return []))
  (let from (if ($str/starts_with? prefix receipts) prefix receipts))
  (let out [])
  (for row in (store/db .Db:query "SELECT r.key,r.revision,r.value FROM heads h JOIN records r ON h.revision=r.revision
      WHERE h.key>=? AND h.key<? AND h.revision<=? ORDER BY h.revision" from receipts_end limit)
    (if_yes ($str/starts_with? row/key prefix)
      (out .push {^key row/key ^revision row/revision ^value (read_data row/value)})))
  out)
# The newest revision of `key` no later than `limit`.
(fn stored [store, key, limit]
  (let rows (store/db .Db:query
    "SELECT revision,value FROM records WHERE key=? AND revision<=? ORDER BY revision DESC LIMIT 1" key limit))
  (if (== rows/.size 0) (absent) {^revision rows/0/revision ^value (read_data rows/0/value)}))

# A key may be given as a Str or as the Sym a Map iteration yields.
(fn read [store, name]
  (if store/closed/.get (problem "Store is closed"))
  (let key ($to_str name))
  (if (receipt? key) (return (receipt store key store/latest/.get)))
  (let head (store/records/.get .get key))
  (if (== head void) (absent) (copy head)))
(fn get [store, key] (let row (read store key)) row/value)
# The keys of `records` that begin with `prefix`, oldest first. The result may
# be the store's own list: read it, do not change it.
(fn head_keys [store, prefix]
  (let group (group_of prefix))
  (if_not ($absent? group)
    (let listed (store/groups .get group))
    (if (== listed void) (return []))
    (if (== prefix group) (return listed))
    (let within [])
    (for key in listed (if_yes ($str/starts_with? key prefix) (within .push key)))
    (return within))
  (let out [])
  (for pair in store/records/.get
    (if_yes ($str/starts_with? ($to_str pair/0) prefix) (out .push ($to_str pair/0))))
  out)
(fn keys [store, prefix = ""]
  (if store/closed/.get (problem "Store is closed"))
  (let result [])
  (for key in (head_keys store prefix) (result .push key))
  (for row in (receipt_rows store prefix store/latest/.get) (result .push row/key))
  result)
(fn values [store, prefix = ""]
  (if store/closed/.get (problem "Store is closed"))
  (let records store/records/.get)
  (let result [])
  (for key in (head_keys store prefix)
    (let head (records .get key))
    (result .push (copy head/value)))
  (for row in (receipt_rows store prefix store/latest/.get) (result .push row/value))
  result)
# The committed records under a prefix that satisfy `predicate`, uncopied.
# `predicate` and the caller only read them; `values_where` returns copies, and
# anything a transaction intends to change it reads for itself first.
(fn peek_where [store, prefix, predicate]
  (if store/closed/.get (problem "Store is closed"))
  (let records store/records/.get)
  (let out [])
  (for key in (head_keys store prefix)
    (let head (records .get key))
    (if_yes (&& (! ($absent? head/value)) (predicate head/value)) (out .push head/value)))
  (for row in (receipt_rows store prefix store/latest/.get)
    (if_yes (predicate row/value) (out .push row/value)))
  out)
(fn count_where [store, prefix, predicate]
  (let found (peek_where store prefix predicate))
  found/.size)
# Copies of the committed records under a prefix that satisfy `predicate`.
(fn values_where [store, prefix, predicate]
  (let out [])
  (for value in (peek_where store prefix predicate) (out .push (copy value)))
  out)
(fn require_writable [store]
  (if store/closed/.get (problem "Store is closed"))
  (if_not ($absent? store/fault/.get)
    (problem $"Store requires recovery after a persistent write failure: ${store/fault/.get}")))
(fn begin [store, cause]
  (require_writable store)
  (Transaction ^store store ^cause cause ^snapshot store/latest/.get
    ^seen {} ^reads {} ^writes {} ^closed ($cell false)))
# `key` as the store had it at revision `snapshot`. The head in memory is that
# record unless a later commit has replaced it; only then is the earlier
# revision read back from the database.
(fn at_snapshot [store, key, snapshot]
  (if (receipt? key) (return (receipt store key snapshot)))
  (let head (store/records/.get .get key))
  (if (== head void) (return (absent)))
  (if (<= head/revision snapshot) head (stored store key snapshot)))
# `key` as the transaction sees it. A commit installs a new record instead of
# changing one, so what was found first stays true for the transaction.
(fn view [tx, key]
  (let known (tx/seen .get key))
  (if (!= known void) (return known))
  (let record (at_snapshot tx/store key tx/snapshot))
  (tx/seen .put key record)
  record)
# Whether a key in `records` was already there at revision `snapshot`.
(fn present_at? [store, key, snapshot]
  (let born (store/born .get key))
  (|| (== born void) (<= born snapshot)))
(fn tx_get [tx, name]
  (if tx/closed/.get (problem "Transaction handle is no longer active"))
  (let key ($to_str name))
  (let record (view tx key))
  (tx/reads .put key record/revision)
  (let staged (tx/writes .get key))
  (copy (if (!= staged void) staged record/value)))
(fn tx_put [tx, name, value]
  (let key ($to_str name))
  (if (receipt? key) (problem "Commit receipts are written by the store itself"))
  (tx_get tx key)
  (tx/writes .put key (copy value))
  (copy value))
(fn tx_keys [tx, prefix = ""]
  (let store tx/store)
  (let records store/records/.get)
  (let result [])
  (for key in (head_keys store prefix)
    (if_yes (present_at? store key tx/snapshot) (result .push key)))
  (for row in (receipt_rows store prefix tx/snapshot) (result .push row/key))
  (for pair in tx/writes
    (let key ($to_str pair/0))
    (if_yes (&& ($str/starts_with? key prefix)
                (|| (== (records .get key) void) (! (present_at? store key tx/snapshot))))
      (result .push key)))
  result)
# The keys under `prefix` whose record, as the transaction sees it, satisfies
# `predicate`. Nothing is copied and nothing counts as read: `tx_get` the keys
# returned before acting on them.
(fn tx_keys_where [tx, prefix, predicate]
  (if tx/closed/.get (problem "Transaction handle is no longer active"))
  (let out [])
  (for key in (tx_keys tx prefix)
    (let staged (tx/writes .get key))
    (let record (view tx key))
    (let value (if (!= staged void) staged record/value))
    (if_yes (&& (! ($absent? value)) (predicate value)) (out .push key)))
  out)
(fn abort [tx] (tx/closed .set true))
(fn head_revision [store, key]
  (if_yes (receipt? key)
    (let found (receipt store key store/latest/.get))
    (return found/revision))
  (let head (store/records/.get .get key))
  (if (== head void) nil head/revision))
(fn commit [tx]
  (if tx/closed/.get (problem "Transaction handle is no longer active"))
  (tx/closed .set true)
  (let store tx/store)
  (require_writable store)
  (for pair in tx/reads
    (if_not (== (head_revision store ($to_str pair/0)) pair/1)
      (problem $"Revision conflict: ${pair/0}")))
  (let db store/db)
  (let revisions {})
  (let published [])
  (try
    (db .Db:exec "BEGIN")
    (if_yes store/fail_next/.get
      (store/fail_next .set false)
      (problem "Injected persistent write failure"))
    (for pair in tx/writes
      (let key ($to_str pair/0))
      (let text (write_data pair/1))
      (db .Db:execute "INSERT INTO records(key,value,cause) VALUES(?,?,?)" key text tx/cause)
      (let row (db .Db:query "SELECT last_insert_rowid() AS revision"))
      (let revision row/0/revision)
      (db .Db:execute "INSERT OR REPLACE INTO heads(key,revision) VALUES(?,?)" key revision)
      (published .push {^key key ^record {^revision revision ^value (read_data text)}})
      (revisions .put pair/0 revision))
    # Publish the commit's identity and exact write revisions in the same image.
    # An interrupted caller can inspect this receipt without replaying its code.
    (let commit_id (id "commit"))
    (let commit_key $"commit/${commit_id}")
    (let receipt {^id commit_id ^cause tx/cause ^writes (copy revisions)})
    (db .Db:execute "INSERT INTO records(key,value,cause) VALUES(?,?,?)" commit_key (write_data receipt) tx/cause)
    (let receipt_row (db .Db:query "SELECT last_insert_rowid() AS revision"))
    (db .Db:execute "INSERT INTO heads(key,revision) VALUES(?,?)" commit_key receipt_row/0/revision)
    # The image backend atomically republishes its file on COMMIT; the file
    # backend's COMMIT returns once its WAL frames are synchronized.
    (db .Db:exec "COMMIT")
    # Only now do the new heads replace the old ones in memory.
    (let records store/records/.get)
    (for item in published
      (if_yes (== (records .get item/key) void)
        (store/born .put item/key item/record/revision)
        (enlist store/groups item/key))
      (records .put item/key item/record))
    (store/latest .set receipt_row/0/revision)
    revisions
    catch Any
      (let failure $err)
      (store/fault .set failure/message)
      (try (db .Db:exec "ROLLBACK") catch Any nil)
      # A failed publication can leave the backend's connection-local image
      # ahead of its file. Never reuse it, even if a later write could succeed.
      (fail failure)))
(fn put [store, key, value, cause = "host"]
  (let tx (begin store cause))
  (tx_put tx key value)
  (commit tx))
(fn revision [store, number]
  (require_writable store)
  (let rows (store/db .Db:query "SELECT key,value,cause FROM records WHERE revision=?" number))
  (if (== rows/.size 0) (problem "Missing immutable revision"))
  {^key rows/0/key ^value (read_data rows/0/value) ^cause rows/0/cause})
(fn close_store [store]
  (if_not store/closed/.get
    store/db/.Db:close
    store/claim/.close
    (store/closed .set true)))
