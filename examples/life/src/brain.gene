(mod brain)
(import * : p ^from "./host/persistence")

(fn response [note, program] {^note note ^program program})
(fn decode [value]
  (if (== ($head value) Str)
    (then
      (if (> ($str/byte_size value) 131072) (p/problem "Brain response exceeds limit"))
      (let parts ($str/split ($str/trim value) "```"))
      (if_not (== parts/.size 5) (p/problem "Expected one text fence followed by one gene fence"))
      (if (|| (!= ($str/trim parts/0) "") (!= ($str/trim parts/2) "") (!= ($str/trim parts/4) ""))
        (p/problem "Only whitespace may surround response fences"))
      (if_not (&& ($str/starts_with? parts/1 "text\n") ($str/starts_with? parts/3 "gene\n"))
        (p/problem "Expected text then gene fences"))
      (return (decode (response ($str/trim ($str/slice_bytes parts/1 5 ($str/byte_size parts/1)))
                               ($str/trim ($str/slice_bytes parts/3 5 ($str/byte_size parts/3))))))))
  (if (|| ($absent? value/note) ($absent? value/program)) (p/problem "Missing note or program"))
  (if (|| (== ($str/trim value/note) "") (== ($str/trim value/program) ""))
    (p/problem "Complete note and program are required"))
  value)

(fn fake [decisions, context]
  (let items (decisions .get))
  (if (> items/.size 0)
    (then
      (let first items/0)
      (let remaining [])
      (var index 1)
      (while (< index items/.size)
        (remaining .push items/%index)
        (set index (+ index 1)))
      (decisions .set remaining)
      (return first)))
  (if (== context/world_profile "network") (return (network_fake context)))
  (for observation in context/observations
    (if_yes (== observation/kind "first_start")
      (return (response "I am curious about the garden. I will inspect it and revisit later."
        "(do (memory .remember {^kind \"first_observation\" ^world (body/world .observe)})
          (scheduler .wake_after 60000 \"Revisit the garden\") nil)"))))
  (response "I have considered the observations and will remain quiet for now." "nil"))

# The same deterministic fixture in a shared world: on first start it walks to
# the garden and leaves a data continuation that says so on arrival — no model
# call and no waiting program (docs/proposals/world.md §8.4). It acknowledges a
# person who speaks to it, and never answers another Life, so two fixtures
# cannot talk forever. It is a fixture, not a conversational model.
(fn network_fake [context]
  (for observation in context/observations
    (if_yes (== observation/kind "first_start")
      (return (response "I am new to the Commons. I will walk to the garden and say so when I arrive."
        "(do
          (let arrival (code .save \"announce-arrival\"
            \"(fn [api input] (if (== input/result/status \\\"completed\\\") (api/body/world .say \\\"I have reached the garden.\\\") input/result/status))\"))
          (store .commit (fn [tx]
            (let walk (body/world .start_walk \"garden\" ^tx tx))
            (body/world .on_result walk arrival {} ^tx tx)
            walk/operation_id)))"))))
  (for observation in context/observations
    (if_yes (&& (== observation/kind "chat") (== observation/data/source "world")
                (== observation/data/speaker_kind "human"))
      (return (response "Someone spoke to me. I will acknowledge them."
        "(do
          (let focus context/focus)
          (body/chat .send focus/reply_to \"I heard you. I am a fake-brain Life, so I can only acknowledge.\"
            ^in_reply_to [focus/event_id]))"))))
  (response "I have considered the observations and will remain quiet for now." "nil"))
