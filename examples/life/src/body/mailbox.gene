# Versioned HTTP wire adapter. No credentials or remote diagnostics enter records.
(mod mailbox)
(import $net/http_client [request])

(fn launch [endpoint, route, payload]
  (let done ($cell nil))
  (let task (request ^method "POST" ^url $"${endpoint}${route}"
    ^headers {^content-type "application/json"} ^body payload ^timeout_ms 2000 ^max_bytes 1048576))
  (let monitor (spawn ^lane root (do
    (let outcome (task .join))
    (let result (match outcome
      (when (TaskOutcome/ok response)
        (if (&& (== response/status 200) (! response/truncated))
          (try {^ok true ^value ($json/parse response/body)} catch Any {^ok false})
          {^ok false}))
      (else {^ok false})))
    (done .set result))))
  {^task task ^monitor monitor ^done done})

(fn stop [request]
  (request/task .cancel)
  (request/task .join)
  (request/monitor .join))