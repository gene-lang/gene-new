(mod cron)
(import * : p ^from "./persistence")
(import * : calendar ^from "./calendar")
(import * : timezone ^from "./timezone")

(fn words [text]
  (let result [])
  (var word "")
  (let bytes ($binary/from_str text))
  (var index 0)
  (while (< index ($binary/size bytes))
    (let byte ($binary/get bytes index))
    (if ([9 10 13 32] .contains? byte)
      (then (if_yes (!= word "") (result .push word) (set word "")))
      (else (set word $"${word}${($str/slice_bytes text index 1)}")))
    (set index (+ index 1)))
  (if (!= word "") (result .push word))
  result)
(fn number [text, names]
  (let named (names .get ($str/lower text)))
  (if ($absent? named) (calendar/decimal text) named))
(fn field [text, low, high, names = {}]
  (let included {})
  (for part in ($str/split text ",")
    (let steps ($str/split part "/"))
    (if (> steps/.size 2) (p/problem "Invalid cron step"))
    (let step (if (== steps/.size 2) (calendar/decimal steps/1) 1))
    (if (<= step 0) (p/problem "Cron step must be positive"))
    (var first low)
    (var last high)
    (if_not (== steps/0 "*")
      (let bounds ($str/split steps/0 "-"))
      (if (> bounds/.size 2) (p/problem "Invalid cron range"))
      (set first (number bounds/0 names))
      (set last (if (== bounds/.size 2) (number bounds/1 names)
        (if (== steps/.size 2) high first))))
    (if (|| (< first low) (> last high) (> first last)) (p/problem "Cron field is outside its range"))
    (var value first)
    (while (<= value last)
      (included .put ($to_str value) true)
      (set value (+ value step))))
  (let values [])
  (var value low)
  (while (<= value high)
    (if_yes (== (included .get ($to_str value)) true) (values .push value))
    (set value (+ value 1)))
  values)
(fn compile [expression]
  (if (|| (!= ($head expression) Str) (> ($str/byte_size expression) 256)) (p/problem "Cron expression exceeds the local limit"))
  (let parts (words expression))
  (if_not (== parts/.size 5) (p/problem "Cron requires minute hour day-of-month month day-of-week"))
  (let weekdays (field parts/4 0 7 {^sun 0 ^mon 1 ^tue 2 ^wed 3 ^thu 4 ^fri 5 ^sat 6}))
  (if_yes (&& (weekdays .contains? 7) (! (weekdays .contains? 0))) (weekdays .push 0))
  {^expression expression ^minutes (field parts/0 0 59) ^hours (field parts/1 0 23)
   ^days (field parts/2 1 31) ^months (field parts/3 1 12
      {^jan 1 ^feb 2 ^mar 3 ^apr 4 ^may 5 ^jun 6 ^jul 7 ^aug 8 ^sep 9 ^oct 10 ^nov 11 ^dec 12})
   ^weekdays weekdays ^day_wild ($str/starts_with? parts/2 "*")
   ^weekday_wild ($str/starts_with? parts/4 "*")})
(fn matches_day? [pattern, date]
  (if_not (pattern/months .contains? date/month) (return false))
  (let day (pattern/days .contains? date/day))
  (let weekday (pattern/weekdays .contains? date/weekday))
  (if (|| pattern/day_wild pattern/weekday_wild) (&& day weekday) (|| day weekday)))
(fn reverse [items]
  (let result [])
  (var index (- items/.size 1))
  (while (>= index 0) (result .push items/%index) (set index (- index 1)))
  result)
(fn find_occurrence [pattern, rules, instant_ms, direction]
  (let second (calendar/floor_div instant_ms 1000))
  (let offset (timezone/offset_at rules second))
  (var date (calendar/civil (calendar/floor_div (+ second offset) 86400)))
  (let hours (if (> direction 0) pattern/hours (reverse pattern/hours)))
  (let minutes (if (> direction 0) pattern/minutes (reverse pattern/minutes)))
  (var minimum rules/initial)
  (var maximum rules/initial)
  (for candidate in rules/offsets
    (set minimum ($math/min minimum candidate)) (set maximum ($math/max maximum candidate)))
  (var searched 0)
  (while (< searched 2930)
    (if_yes (matches_day? pattern date)
      (for hour in hours
        (for minute in minutes
          (let local (+ (* date/number 86400) (* hour 3600) (* minute 60)))
          (if_yes (&& (> direction 0) (<= (- local minimum) second)) (continue))
          (if_yes (&& (< direction 0) (> (- local maximum) second)) (continue))
          (let candidate (timezone/first_instant rules local))
          (if_not ($absent? candidate)
            (let at (* candidate 1000))
            (if (if (> direction 0) (> at instant_ms) (<= at instant_ms)) (return at))))))
    (set date (calendar/shift_day date direction))
    (set searched (+ searched 1))
    (if (|| (< (* date/number 86400) (- rules/from 86400))
            (>= (* date/number 86400) (+ rules/until 86400)))
      (p/problem "Cron occurrence exceeds the retained timezone horizon")))
  (p/problem "Cron has no occurrence within the eight-year search bound"))
(fn next [pattern, rules, after] (find_occurrence pattern rules after 1))
(fn previous [pattern, rules, at] (find_occurrence pattern rules at -1))
