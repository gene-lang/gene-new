{^format 1
 ^name "genex/life"
 ^description "A persistent individual with a replaceable brain and evolving Gene behavior"
 ^version "0.1.0"
 ^library {^entry "src/host/runtime.gene"}
 ^applications [(application "life" ^entry "src/main.gene")
                (application "life_demo" ^entry "src/demo.gene")]
 # The networked world profile's native client (docs/proposals/world.md §9.7).
 ^dependencies {
   ^websocket (dep "genex/websocket" "0.1.0" ^path "../../src/genex/websocket")}}
