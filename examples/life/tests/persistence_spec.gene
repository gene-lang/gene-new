(import $test [describe it assert_equal assert_raises])
(import * : p ^from "../src/host/persistence")

(describe "Life durable storage"
  (it "commits snapshots and retains immutable revisions" []
    (let name (p/id "store"))
    (let home $"examples/life/tmp/${name}")
    (let store (p/open_store home ^create true))
    (try
      (let value {^nested [1]})
      (let revisions (p/put store "custom" value))
      (value/nested .push 2)
      (assert_equal (p/get store "custom") {^nested [1]})
      (let tx (p/begin store "test"))
      (p/tx_put tx "custom" 3)
      (p/tx_put tx "prepared" true)
      (store/fail_next .set true)
      (assert_raises (fn [] (p/commit tx)) p/LifeError)
      (assert_equal (p/get store "custom") {^nested [1]})
      (assert_equal (p/get store "prepared") nil)
      (assert_raises (fn [] (p/put store "custom" 4)) p/LifeError)
      (assert_raises (fn [] (p/open_store home)) p/LifeError)
      ensure (p/close_store store))
    (let restored (p/open_store home))
    (let prior (p/revision restored revisions/custom))
    (assert_equal prior/value {^nested [1]})
    (p/put restored "custom" 4)
    (assert_equal (p/get restored "custom") 4)
    (p/close_store restored))

  (it "rejects an optimistic conflict without publishing either grouped record" []
    (let name (p/id "conflict"))
    (let store (p/open_store $"examples/life/tmp/${name}" ^create true))
    (try
      (p/put store "a" 1)
      (let tx (p/begin store "old-view"))
      (p/tx_put tx "a" 2)
      (p/tx_put tx "b" 3)
      (p/put store "a" 4)
      (assert_raises (fn [] (p/commit tx)) p/LifeError)
      (assert_equal (p/get store "a") 4)
      (assert_equal (p/get store "b") nil)
      (assert_equal (store/fault .get) nil)
      (p/put store "after-conflict" true)
      ensure (p/close_store store))))
