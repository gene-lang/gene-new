(import * : p ^from "../persistence")
(import * : runtime ^from "../runtime")
(import * : body ^from "../body")
(import * : brain ^from "../brain")
(import * : timezone ^from "../timezone")
(fn die [] ($os/exec ^cmd "/bin/kill" ^args ["-KILL" ($to_str ($os/process_id))]))
(fn main [args]
  (let now ($cell 1000))
  (let host (runtime/open_life args/0 ^create true ^clock (fn [] (now .get))
    ^decisions [(brain/response "Quiet" "nil")]))
  (runtime/settle host)
  (let tx (p/begin host/store "cron-fixture"))
  (let zone (timezone/prepare tx "UTC"))
  (let source (if (== args/1 "queued")
    "(state .put \"attempts\" (+ 1 (?? (state .get \"attempts\") 0)))"
    "(do (let attempt (+ 1 (?? (state .get \"attempts\") 0)))
      (state .put \"attempts\" attempt) (if (== attempt 1) ($sleep 60000) nil))"))
  (body/apply_operation host tx {^id "fixture" ^organization "starter@1"} "cron"
    {^expression "* * * * *" ^timezone zone ^source source ^missed "coalesce_once"})
  (p/commit tx)
  (now .set 60000)
  (body/due host)
  (if_yes (== args/1 "queued") (die))
  (let deadline (+ ($os/monotonic_ms) 5000))
  (while (!= (p/get host/store "state/attempts") 1)
    (runtime/heartbeat host) ($sleep 5)
    (if (> ($os/monotonic_ms) deadline) (p/problem "Cron invocation did not start")))
  (die)
  nil)
