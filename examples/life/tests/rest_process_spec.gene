(import $test [describe it assert_equal])
(import * : p ^from "../src/host/persistence")
(import * : runtime ^from "../src/host/runtime")
(import * : body ^from "../src/body/body")

(fn crash [stage, point]
  (let name (p/id "rest-crash"))
  (let home $"examples/life/tmp/${name}")
  (let result ($os/exec ^cmd ($os/executable_path)
    ^args ["run" "examples/life/tests/rest_crash_fixture.gene" home stage point]
    ^timeout_ms 10000 ^max_bytes 16384))
  ($assert (!= result/status 0) "Crash fixture did not exit unexpectedly")
  ($assert ($fs/exists? home) result/stderr)
  (runtime/open_life home ^clock (fn [] 3601000)))

(describe "Sleep checkpoint process recovery"
  (it "publishes its model, activity and registration together when entering sleep" []
    (let before (crash "entry" "before_commit"))
    (try
      (assert_equal (p/get before/store "model/rest") nil)
      (assert_equal (p/values before/store "routine/") [])
      (assert_equal (before/calls .get) 0)
      ensure (runtime/close_life before))
    (let after (crash "entry" "after_commit"))
    (try
      (let model (p/get after/store "model/rest"))
      (assert_equal model/mode "sleeping")
      (assert_equal model/energy 24.0)
      (assert_equal model/sleep_activity/registration "rest/recovery")
      (let registrations (p/values after/store "routine/"))
      (assert_equal registrations/.size 1)
      (assert_equal registrations/0/generation 1)
      (assert_equal (after/calls .get) 0)
      (body/tick after 60000)
      (runtime/settle after)
      (let continued (p/get after/store "model/rest"))
      (assert_equal continued/energy 26.0)
      ensure (runtime/close_life after)))

  (it "resumes a declared checkpointed handler once across kills before and after its commit" []
    (for point in ["before_commit" "after_commit"]
      (let host (crash "recovery" point))
      (try
        (let registration (p/get host/store "routine/rest/recovery"))
        (assert_equal registration/status "active")
        (assert_equal registration/dispatches 1)
        ($assert (! ($absent? registration/pending)))
        (let model (p/get host/store "model/rest"))
        (assert_equal model/energy (if (== point "before_commit") 24.0 42.0))
        (assert_equal (host/calls .get) 0)
        (runtime/settle host)
        (let continued (p/get host/store "model/rest"))
        (assert_equal continued/energy 42.0)
        (assert_equal continued/last_accounted_sim_ms 540000)
        (let finished (p/get host/store "routine/rest/recovery"))
        (assert_equal finished/dispatches 1)
        (assert_equal finished/last_outcome/execution_id registration/pending)
        (assert_equal finished/pending nil)
        (assert_equal (host/calls .get) 0)
        ensure (runtime/close_life host)))))
