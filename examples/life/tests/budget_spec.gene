(import $test [describe it assert_equal])
(import * : runtime ^from "../runtime")
(import * : p ^from "../persistence")
(import * : body ^from "../body")
(import * : brain ^from "../brain")
(import * : budget ^from "../budget")

(describe "Life host inference budget"
  (it "retains events and maintenance after the budget is used, and admits fresh context after restart in a new window" []
    (let name (p/id "budget"))
    (let now ($cell 1000))
    (let host (runtime/open_life $"examples/life/tmp/${name}" ^create true ^clock (fn [] (now .get))
      ^decisions [(brain/response "First admission" "nil")]))
    (budget/configure host 2)
    (runtime/settle host)
    (body/receive host "Second admission")
    (runtime/settle host)
    (let held (body/receive host "Retained after the budget"))
    (runtime/settle host)
    (assert_equal (host/calls .get) 2)
    (let event (p/get host/store $"event/${held/id}"))
    (assert_equal event/considered_by nil)
    (let tx (p/begin host/store "maintenance"))
    (body/apply_operation host tx {^id "maintenance" ^organization "starter@1"} "after"
      {^delay 0 ^source "(state .put \"maintained\" true)" ^missed {^run_within_ms 1000 ^otherwise "expire"}})
    (p/commit tx)
    (runtime/settle host)
    (assert_equal (p/get host/store "state/maintained") true)
    (assert_equal (host/calls .get) 2)
    (let home host/store/home)
    (runtime/close_life host)
    (let restored (runtime/open_life home ^clock (fn [] (now .get))))
    (try
      (runtime/settle restored)
      (assert_equal (restored/calls .get) 0)
      (let retained (budget/state restored))
      (assert_equal retained/admitted 2)
      (now .set 3601000)
      (runtime/settle restored)
      (assert_equal (restored/calls .get) 1)
      (let considered (p/get restored/store $"event/${held/id}"))
      ($assert (! ($absent? considered/considered_by)))
      (let cycle (p/get restored/store $"cycle/${considered/considered_by}"))
      (assert_equal cycle/context/now 3601000)
      (assert_equal cycle/model_admission/number 1)
      ensure (runtime/close_life restored))))
