(import $test [describe it assert_equal])
(import * : p ^from "../persistence")
(import * : code ^from "../code")
(import * : organization ^from "../organization")
(import * : runtime ^from "../runtime")
(import * : body ^from "../body")
(import * : brain ^from "../brain")

(fn fixture []
  (let name (p/id "rest"))
  (let host (runtime/open_life $"examples/life/tmp/${name}" ^create true ^clock (fn [] 1000)
    ^decisions [(brain/response "Quiet start" "nil")]))
  (runtime/settle host)
  (let tx (p/begin host/store "rest-candidate"))
  (let source ($fs/read_text "examples/life/body/rest.gene"))
  (let revision (code/module_bundle tx "invented rest model" {^main.gene source} "main.gene"))
  (organization/request tx {^id "rest@1" ^module revision ^code [revision] ^roots ["model/" "state/" "memory/"]
    ^attention true ^documentation "Optional rest model; rest.sleep enters a checkpointed simulation-time activity."}
    "nil" "invalidate" false)
  (p/commit tx)
  (runtime/settle host)
  (let meta (p/get host/store "meta"))
  ($assert (== meta/organization "rest@1") ($to_str (p/values host/store "selection/")))
  {^host host ^revision revision})
(fn decide [host, source]
  ((host/decisions .get) .push (brain/response "Rest experiment" source))
  (body/receive host "Consider resting")
  (runtime/settle host))
(fn rest [host] (p/get host/store "model/rest"))
(fn duplicate [host, revision, at]
  (let literal ($json/stringify revision))
  (let source $"(do (let controller (code .load ${literal}))
    (controller/recover {^store store ^routines routines ^scheduler scheduler}
      {^now ${at} ^bindings {^key \"model/rest\"}}))")
  (let tx (p/begin host/store "duplicate-timer-fixture"))
  (body/apply_operation host tx {^id "duplicate-fixture" ^organization "rest@1"} "after"
    {^delay 0 ^source source ^missed {^run_within_ms 1000 ^otherwise "expire"}})
  (p/commit tx)
  (runtime/settle host))

(describe "Gene-defined energy and sleep"
  (it "restores sleep at energy 42, accounts duplicate timers once, and retains one wake transition" []
    (let setup (fixture))
    (let host setup/host)
    (let revision ($json/stringify setup/revision))
    (decide host $"(do (rest .sleep ${revision}) (rest .sleep ${revision}))")
    (let asleep (rest host))
    (assert_equal asleep/mode "sleeping")
    (let registrations (p/values host/store "routine/"))
    (assert_equal registrations/.size 1)
    (assert_equal registrations/0/generation 1)
    (let calls (host/calls .get))
    (set host/brain (fn [snapshot] (p/problem "Model unavailable")))
    (body/receive host "Please remember this while resting")
    (body/tick host 540000)
    (runtime/settle host)
    (let midway (rest host))
    (assert_equal midway/energy 42.0)
    (assert_equal midway/mode "sleeping")
    (assert_equal (host/calls .get) calls)
    (duplicate host setup/revision 540000)
    (duplicate host setup/revision 300000)
    (assert_equal (rest host) midway)
    (let checkpoint (p/get host/store "routine/rest/recovery"))
    (assert_equal checkpoint/dispatches 1)
    (let home host/store/home)
    (runtime/close_life host)
    (let restored (runtime/open_life home ^clock (fn [] 3601000)))
    (try
      (assert_equal (rest restored) midway)
      (assert_equal (p/get restored/store "routine/rest/recovery") checkpoint)
      (assert_equal (restored/calls .get) 0)
      (runtime/settle restored)
      (assert_equal (restored/calls .get) 0)
      (body/receive restored "Another retained message during sleep")
      (runtime/settle restored)
      (assert_equal (restored/calls .get) 0)
      (body/tick restored 840000)
      (runtime/settle restored)
      (let awake (rest restored))
      (assert_equal awake/energy 70.0)
      (assert_equal awake/mode "awake")
      (assert_equal awake/sleep_activity/status "completed")
      (let retired (p/get restored/store "routine/rest/recovery"))
      (assert_equal retired/status "retired")
      (assert_equal (restored/calls .get) 1)
      (var wakes 0)
      (for event in (p/values restored/store "event/")
        (if_yes (== event/kind "wake") (set wakes (+ wakes 1)))
        (if_yes (== event/kind "chat") ($assert (! ($absent? event/considered_by)))))
      (assert_equal wakes 1)
      (let chats (p/get restored/store "conversation/garden"))
      (assert_equal chats/messages/.size 3)
      (body/tick restored 60000)
      (runtime/settle restored)
      (assert_equal (rest restored) awake)
      (assert_equal (restored/calls .get) 1)
      ensure (runtime/close_life restored)))

  (it "gives energy behavioral meaning by charging activity outcomes and entering rest" []
    (let setup (fixture))
    (let host setup/host)
    (let revision ($json/stringify setup/revision))
    (p/put host/store "model/rest" {^energy 30.0 ^capacity 100.0 ^mode "awake"
      ^recovery_per_sim_minute 2.0 ^wake_at_energy 70.0 ^last_accounted_sim_ms 0
      ^sleep_activity nil ^charged_events []})
    (decide host $"(do (rest .account_for_activities ${revision}) (body/world .start_walk \"garden\"))")
    (let calls (host/calls .get))
    (try
      (body/tick host 10000)
      (runtime/settle host)
      (let model (rest host))
      (assert_equal model/energy 22.0)
      (assert_equal model/mode "sleeping")
      (assert_equal model/charged_events/.size 1)
      (assert_equal (host/calls .get) calls)
      (let cost (p/get host/store "routine/rest/activity-costs"))
      (assert_equal cost/status "active")
      (assert_equal cost/dispatches 1)
      (body/tick host 1440000)
      (runtime/settle host)
      (let awake (rest host))
      (assert_equal awake/energy 70.0)
      (assert_equal awake/mode "awake")
      ensure (runtime/close_life host))))
