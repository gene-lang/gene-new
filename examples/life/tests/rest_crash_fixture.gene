(import * : runtime ^from "../runtime")
(import * : body ^from "../body")
(import * : brain ^from "../brain")
(import * : p ^from "../persistence")
(import * : code ^from "../code")
(import * : organization ^from "../organization")

(fn die [] ($os/exec ^cmd "/bin/kill" ^args ["-KILL" ($to_str ($os/process_id))]))
(fn main [args]
  (let home args/0)
  (let stage args/1)
  (let point args/2)
  (let armed ($cell false))
  (let host (runtime/open_life home ^create true ^clock (fn [] 1000)
    ^decisions [(brain/response "Quiet start" "nil")]
    ^fault (fn [phase] (if_yes (&& (armed .get) (== phase point)) (die)))))
  (runtime/settle host)
  (let tx (p/begin host/store "rest-candidate"))
  (let source ($fs/read_text "examples/life/body/rest.gene"))
  (let revision (code/module_bundle tx "rest" {^main.gene source} "main.gene"))
  (organization/request tx {^id "rest@1" ^module revision ^code [revision] ^roots ["model/"]
    ^attention true ^documentation "Rest crash fixture"} "nil" "invalidate" false)
  (p/commit tx)
  (runtime/settle host)
  (let literal ($json/stringify revision))
  ((host/decisions .get) .push (brain/response "Enter sleep" $"(rest .sleep ${literal})"))
  (body/receive host "Please rest" ^external_id "rest-request")
  (if_yes (== stage "entry") (armed .set true))
  (runtime/settle host)
  (body/tick host 540000)
  (armed .set true)
  (runtime/settle host)
  (p/problem "Expected injected process exit")
  nil)
