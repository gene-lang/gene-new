(import $test [describe it assert_equal])
(import * : p ^from "../persistence")
(import * : code ^from "../code")
(import * : routines ^from "../routines")
(import * : runtime ^from "../runtime")
(import * : body ^from "../body")
(import * : brain ^from "../brain")
(import * : organization ^from "../organization")
(import * : operator ^from "../main")

(fn fixture []
  (let name (p/id "routines"))
  (let host (runtime/open_life $"examples/life/tmp/${name}" ^create true ^clock (fn [] 1000)
    ^decisions [(brain/response "Quiet" "nil")]))
  (runtime/settle host)
  host)
(fn register [host, id, source, clock = "simulation", events = []]
  (let tx (p/begin host/store "routine-fixture"))
  (let revision (code/expression tx id source))
  (routines/register host tx {^id "fixture" ^organization "starter@1"}
    {^id id ^revision revision ^clock clock ^every_ms 1000 ^events events})
  (p/commit tx)
  revision)

(describe "Life persistent routines"
  (it "coalesces clock firings without a model call and restores one registration" []
    (let host (fixture))
    (register host "counter" "(fn [api input] (api/state .put \"tick\" {^at input/now ^elapsed input/elapsed_ms}))")
    (let calls (host/calls .get))
    (body/tick host 5000)
    (runtime/settle host)
    (assert_equal (host/calls .get) calls)
    (assert_equal (p/get host/store "state/tick") {^at 5000 ^elapsed 5000})
    (let before (p/get host/store "routine/counter"))
    (assert_equal before/dispatches 1)
    (let home host/store/home)
    (runtime/close_life host)
    (let restored (runtime/open_life home ^clock (fn [] 3601000)))
    (try
      (assert_equal (p/get restored/store "routine/counter") before)
      (body/tick restored 1000)
      (runtime/settle restored)
      (assert_equal (p/get restored/store "state/tick") {^at 6000 ^elapsed 1000})
      (let registrations (p/values restored/store "routine/"))
      (assert_equal registrations/.size 1)
      ensure (runtime/close_life restored)))

  (it "delivers subscribed events once and preserves a queued invocation across restart" []
    (let host (fixture))
    (register host "listener" "(fn [api input] (api/state .put \"messages\" input/events))" "events" ["chat"])
    (body/receive host "first")
    (body/receive host "second")
    (routines/due host)
    (let queued (p/get host/store "routine/listener"))
    ($assert (! ($absent? queued/pending)))
    (let home host/store/home)
    (runtime/close_life host)
    (let restored (runtime/open_life home ^clock (fn [] 1000)))
    (try
      (let retained (p/get restored/store "routine/listener"))
      (assert_equal retained/pending queued/pending)
      (runtime/settle restored)
      (let messages (p/get restored/store "state/messages"))
      (assert_equal messages/.size 2)
      (let finished (p/get restored/store "routine/listener"))
      (assert_equal finished/dispatches 1)
      (assert_equal finished/pending nil)
      (assert_equal finished/last_outcome/execution_id queued/pending)
      ensure (runtime/close_life restored)))

  (it "suspends a failed routine while retaining its partial writes and newer conversations" []
    (let host (fixture))
    (register host "broken" "(fn [api input] (api/state .put \"partial\" true) ($sleep 100) (panic \"broken routine\"))")
    (body/tick host 1000)
    (runtime/heartbeat host)
    (body/receive host "New conversation while routine runs")
    (try
      (runtime/settle host)
      (let registration (p/get host/store "routine/broken"))
      (assert_equal registration/status "suspended" ($to_str registration))
      (assert_equal (p/get host/store "state/partial") true)
      (let chat (p/get host/store "conversation/garden"))
      (assert_equal chat/messages/.size 1)
      (body/tick host 10000)
      (runtime/settle host)
      (let still (p/get host/store "routine/broken"))
      (assert_equal still/dispatches 1)
      (register host "broken" "(fn [api input] (api/state .put \"repaired\" true))")
      (body/tick host 1000)
      (runtime/settle host)
      (assert_equal (p/get host/store "state/repaired") true)
      (let repaired (p/get host/store "routine/broken"))
      (assert_equal repaired/generation 2)
      (assert_equal repaired/status "active")
      ensure (runtime/close_life host)))

  (it "atomically replaces registrations during organization migration and never runs their old queued code" []
    (let host (fixture))
    (register host "evolving" "(fn [api input] (api/state .put \"old-handler\" true))")
    (body/tick host 1000)
    (routines/due host)
    (let before (p/get host/store "routine/evolving"))
    (let tx (p/begin host/store "new-handler"))
    (let revision (code/expression tx "new handler" "(fn [api input] (api/state .put \"new-handler\" true))"))
    (let literal ($json/stringify revision))
    (organization/request tx {^id "routines@2" ^code [] ^roots ["state/"]
      ^documentation "Same data, replaced handler"}
      $"(routines .register \"evolving\" ${literal} ^every_ms 1000 ^tx input/tx)" "invalidate" false)
    (p/commit tx)
    (try
      (runtime/settle host)
      (let selected (p/get host/store "organization/routines@2"))
      (assert_equal selected/registrations ["evolving"])
      ($assert (selected/code .contains? revision))
      (let old (p/get host/store $"execution/${before/pending}"))
      (assert_equal old/status "invalidated")
      (assert_equal (p/get host/store "state/old-handler") nil)
      (let registration (p/get host/store "routine/evolving"))
      (assert_equal registration/generation 2)
      (assert_equal registration/organization "routines@2")
      (body/tick host 1000)
      (runtime/settle host)
      (assert_equal (p/get host/store "state/new-handler") true)
      ensure (runtime/close_life host)))

  (it "does not let a backlog of routine invocations monopolize attention" []
    (let host (fixture))
    (for name in ["a" "b" "c" "d"]
      (register host name "(fn [api input]
        (api/state .put \"completed\" (+ 1 (?? (api/state .get \"completed\") 0))))"))
    (let observed ($cell nil))
    (set host/brain (fn [snapshot]
      (observed .set (p/get host/store "state/completed"))
      (brain/response "Received attention alongside routine work" "nil")))
    (body/tick host 1000)
    (body/receive host "New message alongside routines")
    (try
      (runtime/settle host)
      ($assert (<= (observed .get) 1))
      (assert_equal (p/get host/store "state/completed") 4)
      ensure (runtime/close_life host)))

  (it "repairs and cancels a registration through operator commands while paused" []
    (let host (fixture))
    (runtime/pause host)
    (let tx (p/begin host/store "operator-fixture"))
    (let revision (code/expression tx "operator-handler" "(fn [api input] (api/state .put \"operator-repaired\" true))"))
    (p/commit tx)
    (operator/command host {^op "register-routine" ^id "operator-repair" ^revision revision
      ^clock "simulation" ^every_ms 1000})
    (runtime/heartbeat host)
    (assert_equal (p/get host/store "state/operator-repaired") nil)
    (runtime/resume host)
    (body/tick host 1000)
    (try
      (runtime/settle host)
      (assert_equal (p/get host/store "state/operator-repaired") true)
      (runtime/pause host)
      (operator/command host {^op "cancel-routine" ^id "operator-repair"})
      (let registration (p/get host/store "routine/operator-repair"))
      (assert_equal registration/status "retired")
      (let meta (p/get host/store "meta"))
      (assert_equal meta/mode "paused")
      ensure (runtime/close_life host)))

  (it "cancels an active owned handler before a waiting adapter can make later effects" []
    (let host (fixture))
    (let tx (p/begin host/store "owned-fixture"))
    (let owner (body/apply_operation host tx {^id "fixture" ^organization "starter@1"} "owner" {^id "owned"}))
    (let revision (code/expression tx "owned-handler"
      "(fn [api input] ($sleep 60000) (api/state .put \"late-effect\" true))"))
    (routines/register host tx {^id "fixture" ^organization "starter@1"}
      {^id "owned-handler" ^revision revision ^owner owner ^every_ms 1000})
    (p/commit tx)
    (body/tick host 1000)
    (runtime/heartbeat host)
    ($assert (! ($absent? (host/active .get))))
    (let cancel (p/begin host/store "withdrawal"))
    (body/apply_operation host cancel {^id "withdrawal" ^organization "starter@1"} "cancel_owner" {^id "owned"})
    (p/commit cancel)
    (let at ($os/monotonic_ms))
    (try
      (runtime/settle host)
      ($assert (< (- ($os/monotonic_ms) at) 1500))
      (assert_equal (p/get host/store "state/late-effect") nil)
      (let registration (p/get host/store "routine/owned-handler"))
      (assert_equal registration/status "cancelled")
      (assert_equal registration/last_outcome/status "cancelled")
      ensure (runtime/close_life host)))

  (it "preserves compatible timer and event registrations with their queued inputs and generations" []
    (let host (fixture))
    (register host "timer" "(fn [api input] (api/state .put \"timer-at\" input/now))")
    (register host "events" "(fn [api input] (api/state .put \"event-count\" input/events/.size))" "events" ["chat"])
    (body/tick host 1000)
    (body/receive host "Retain this queued event")
    (routines/due host)
    (let before_timer (p/get host/store "routine/timer"))
    (let before_events (p/get host/store "routine/events"))
    (let tx (p/begin host/store "compatible-routines"))
    (organization/request tx {^id "compatible-routines@2" ^roots ["state/"] ^code []
      ^compatible ["starter@1"] ^documentation "Unchanged callback and data contracts"}
      "nil" "compatible" false)
    (p/commit tx)
    (try
      (runtime/settle host)
      (let timer (p/get host/store "routine/timer"))
      (let events (p/get host/store "routine/events"))
      (assert_equal timer/generation before_timer/generation)
      (assert_equal events/generation before_events/generation)
      (assert_equal timer/last_outcome/execution_id before_timer/pending)
      (assert_equal events/last_outcome/execution_id before_events/pending)
      (assert_equal events/seen_events before_events/seen_events)
      (assert_equal timer/spec/organization "compatible-routines@2")
      (assert_equal (p/get host/store "state/timer-at") 1000)
      (assert_equal (p/get host/store "state/event-count") 1)
      ensure (runtime/close_life host))))
