(import $test [describe it assert_equal])
(import * : p ^from "../src/host/persistence")
(import * : code ^from "../src/code/code")
(import * : organization ^from "../src/code/organization")
(import * : runtime ^from "../src/host/runtime")
(import * : body ^from "../src/body/body")
(import * : brain ^from "../src/brain")

(fn fixture [^provider provider = nil]
  (let name (p/id "organization"))
  (runtime/open_life $"examples/life/tmp/${name}" ^create true ^clock (fn [] 1000)
    ^decisions [(brain/response "Quiet first start" "nil")] ^brain provider))
(fn candidate [host, name = "visitors@2"]
  (let tx (p/begin host/store "candidate"))
  (let source ($fs/read_text "examples/life/src/organizations/visitor_memory.gene"))
  (let revision (code/module_bundle tx "visitor memory" {^main.gene source} "main.gene"))
  (p/commit tx)
  {^id name ^module revision ^code [revision] ^roots ["mind/"] ^context true
   ^documentation "A visitor document, episode list and a shared working document; provenance remains with each observation."})
(fn migration []
  "(do
    (let preference (store .get \"state/preference\" ^tx input/tx))
    (let work (store .get \"state/commitment\" ^tx input/tx))
    (store .put \"mind/visitor\" {^preference preference ^source \"visitor-event\"} ^tx input/tx)
    (store .put \"mind/working\" {^commitment work} ^tx input/tx)
    (let after (store .get \"mind/visitor\" ^tx input/tx))
    ($assert (== preference after/preference))
    {^before preference ^after after/preference ^retained_source after/source})")
(fn request [host, definition, source, ^invalidate invalidate = false, ^queued queued = "invalidate"]
  (let tx (p/begin host/store "test-selection"))
  (let id (organization/request tx definition source queued invalidate))
  (p/commit tx)
  id)
(fn selected [host] (let meta (p/get host/store "meta")) meta/organization)
(fn await_selected [host, id]
  (let deadline (+ ($os/monotonic_ms) 5000))
  (while (!= (selected host) id)
    (runtime/heartbeat host)
    ($sleep 5)
    (if_yes (> ($os/monotonic_ms) deadline)
      (p/problem ($to_str (p/values host/store "selection/"))))))

(describe "Life cognitive organization replacement"
  (it "selects code and migrated data together after the requesting program settles" []
    (let host (fixture))
    (runtime/settle host)
    (p/put host/store "state/preference" "shade")
    (let definition (candidate host))
    (let literal ($to_str definition))
    (let migrate (migration))
    ((host/decisions .get) .push (brain/response "Reorganize retained memory"
      $"(do (code .select ${literal} ^migration (quote ${migrate}) ^queued \"invalidate\")
        (state .put \"commitment\" {^status \"unfinished\" ^owner \"garden-plan\"}))"))
    (body/receive host "Reorganize")
    (try
      (runtime/settle host)
      (assert_equal (selected host) definition/id ($to_str (p/values host/store "selection/")))
      (let work (p/get host/store "mind/working"))
      (assert_equal work/commitment/status "unfinished")
      (let visitor (p/get host/store "mind/visitor"))
      (assert_equal visitor/preference "shade")
      ((host/decisions .get) .push (brain/response "Use the selected library"
        "(do (state .put \"recalled\" (memory .recall \"visitor\")) nil)"))
      (body/receive host "Recall")
      (runtime/settle host)
      (let changed (p/get host/store "mind/working"))
      (assert_equal changed/recalled/0/preference "shade")
      (assert_equal (p/get host/store "state/recalled") nil)
      (var seen false)
      (for cycle in (p/values host/store "cycle/")
        (if_yes (&& (== cycle/organization definition/id) (== cycle/status "succeeded"))
          (assert_equal cycle/context/visitor/preference "shade")
          (assert_equal cycle/code_revisions definition/code)
          ($assert (! ($absent? cycle/read_revisions)))
          (set seen true)))
      ($assert seen)
      ensure (runtime/close_life host))
    (let restored (runtime/open_life host/store/home ^clock (fn [] 1000)))
    (try
      (assert_equal (selected restored) definition/id)
      (assert_equal (restored/calls .get) 0)
      (let restored_visitor (p/get restored/store "mind/visitor"))
      (assert_equal restored_visitor/preference "shade")
      (runtime/settle restored)
      ensure (runtime/close_life restored)))

  (it "finishes a still-valid old response before selecting the replacement" []
    (let release ($cell false))
    (let count ($cell 0))
    (let host (fixture ^provider (fn [snapshot]
      (count .set (+ (count .get) 1))
      (if_yes (== (count .get) 1)
        (while (! (release .get)) ($sleep 5))
        (return (brain/response "Old organization still valid" "(state .put \"preference\" \"shade\")")))
      (brain/response "New organization" "nil"))))
    (runtime/heartbeat host)
    ($sleep 5)
    (let definition (candidate host))
    (request host definition (migration))
    (runtime/heartbeat host)
    (assert_equal (selected host) "starter@1")
    (body/receive host "Arrived while waiting" ^speaker "second visitor")
    (release .set true)
    (try
      (runtime/settle host)
      (assert_equal (selected host) definition/id)
      (let visitor (p/get host/store "mind/visitor"))
      (assert_equal visitor/preference "shade")
      (let chat (p/get host/store "conversation/garden"))
      (assert_equal chat/participants ["second visitor"])
      ensure (runtime/close_life host)))

  (it "retains an explicitly invalidated late response without any effects after selection" []
    (let release ($cell false))
    (let count ($cell 0))
    (let host (fixture ^provider (fn [snapshot]
      (count .set (+ (count .get) 1))
      (if_yes (== (count .get) 1)
        (while (! (release .get)) ($sleep 5))
        (return (brain/response "Stale response" "(state .put \"stale\" true)")))
      (brain/response "Fresh response" "nil"))))
    (runtime/heartbeat host)
    ($sleep 5)
    (p/put host/store "state/preference" "shade")
    (let thought (host/thought .get))
    (let definition (candidate host))
    (request host definition (migration) ^invalidate true)
    (try
      (await_selected host definition/id)
      (assert_equal (release .get) false)
      (release .set true)
      (runtime/settle host)
      (runtime/heartbeat host)
      (let old (p/get host/store $"cycle/${thought/cycle/id}"))
      (assert_equal old/status "superseded")
      (assert_equal old/late_response true)
      ($assert ($str/contains? old/diagnostic "Stale response"))
      (assert_equal (p/get host/store "state/stale") nil)
      (let work (p/get host/store "mind/working"))
      ($assert ($absent? work/stale))
      ($assert (> (host/calls .get) 1))
      ensure (release .set true) (runtime/close_life host)))

  (it "rolls back a failed migration and keeps later conversations and memories" []
    (let host (fixture))
    (runtime/settle host)
    (p/put host/store "state/preference" "shade")
    (let definition (candidate host))
    (let id (request host definition
      "(do (store .put \"mind/partial\" true ^tx input/tx) ($sleep 100) (panic \"migration failed\"))"))
    (runtime/heartbeat host)
    (body/receive host "Do not lose this later conversation")
    (p/put host/store "memory/later" {^text "Later retained evidence"})
    (try
      (runtime/settle host)
      (assert_equal (selected host) "starter@1")
      (assert_equal (p/get host/store "mind/partial") nil)
      (let result (p/get host/store $"selection/${id}"))
      (assert_equal result/status "failed")
      (let chat (p/get host/store "conversation/garden"))
      (assert_equal chat/messages/.size 1)
      (assert_equal (p/get host/store "memory/later") {^text "Later retained evidence"})
      ensure (runtime/close_life host)))

  (it "invalidates queued old-layout code while preserving ownership and commitments" []
    (let host (fixture))
    (runtime/settle host)
    (let tx (p/begin host/store "queued-fixture"))
    (let owner (body/apply_operation host tx {^id "fixture" ^organization "starter@1"}
      "owner" {^id "intention"}))
    (let schedule (body/apply_operation host tx {^id "fixture" ^organization "starter@1"}
      "after" {^delay 0 ^source "(state .put \"wrong-layout\" true)" ^owner owner
        ^missed {^run_within_ms 60000 ^otherwise "expire"}}))
    (p/tx_put tx "state/commitment" {^owner owner ^status "unfinished"})
    (p/commit tx)
    (let definition (candidate host))
    (request host definition (migration))
    (try
      (runtime/settle host)
      (let queued (p/get host/store $"schedule/${schedule}"))
      (assert_equal queued/status "invalidated")
      (assert_equal queued/owner owner)
      (assert_equal queued/original_organization "starter@1")
      (assert_equal (p/get host/store "state/wrong-layout") nil)
      (let work (p/get host/store "mind/working"))
      (assert_equal work/commitment/status "unfinished")
      ensure (runtime/close_life host)))

  (it "requires an explicit compatible or invalidated disposition for queued work" []
    (let host (fixture))
    (runtime/settle host)
    (let tx (p/begin host/store "queued-fixture"))
    (let schedule (body/apply_operation host tx {^id "fixture" ^organization "starter@1"}
      "after" {^delay 0 ^source "(state .put \"compatible\" true)"
        ^missed {^run_within_ms 1000 ^otherwise "expire"}}))
    (p/commit tx)
    (let definition {^id "compatible@2" ^roots ["state/" "memory/"] ^code []
      ^compatible ["starter@1"] ^documentation "Same layout and access functions"})
    (let deferred (request host definition "nil" ^queued "defer"))
    (runtime/heartbeat host)
    (let rejected (p/get host/store $"selection/${deferred}"))
    (assert_equal rejected/status "deferred")
    (assert_equal (selected host) "starter@1")
    (request host definition "nil" ^queued "compatible")
    (try
      (runtime/settle host)
      (assert_equal (selected host) "compatible@2")
      (assert_equal (p/get host/store "state/compatible") true)
      (let work (p/get host/store $"schedule/${schedule}"))
      (assert_equal work/original_organization "starter@1")
      (assert_equal work/organization "compatible@2")
      ensure (runtime/close_life host)))

  (it "repairs broken selected cognitive code while paused through the stable host" []
    (let host (fixture))
    (runtime/settle host)
    (let tx (p/begin host/store "bad-context-fixture"))
    (let revision (code/module_bundle tx "bad-context" {^main.gene
      "(mod bad) (fn bind [api] {}) (fn context [api basis] (panic \"broken context\"))"} "main.gene"))
    (p/commit tx)
    (request host {^id "broken@2" ^module revision ^code [revision] ^roots ["state/"]
      ^context true ^documentation "Broken candidate fixture"} "nil")
    (runtime/settle host)
    (assert_equal (selected host) "broken@2")
    (body/receive host "Latest conversation survives repair")
    (p/put host/store "memory/latest" {^text "Latest memory survives repair"})
    (runtime/pause host)
    (let repair (p/begin host/store "operator-repair"))
    (let request_id (organization/request repair {^id "repaired@3" ^roots ["state/" "memory/"]
      ^code [] ^documentation "Restore starter access against latest retained data"} "nil" "invalidate" true ^recovery true))
    (p/commit repair)
    (try
      (await_selected host "repaired@3")
      (let meta (p/get host/store "meta"))
      (assert_equal meta/mode "paused")
      (let chat (p/get host/store "conversation/garden"))
      (assert_equal chat/messages/0/text "Latest conversation survives repair")
      (assert_equal (p/get host/store "memory/latest") {^text "Latest memory survives repair"})
      (runtime/resume host)
      (runtime/settle host)
      (let selection (p/get host/store $"selection/${request_id}"))
      (assert_equal selection/status "selected")
      ensure (runtime/close_life host)))

  (it "builds context from one immutable read view while new data and messages arrive" []
    (let host (fixture))
    (runtime/settle host)
    (p/put host/store "state/counter" 1)
    (let original (p/read host/store "state/counter"))
    (let tx (p/begin host/store "context-fixture"))
    (let revision (code/module_bundle tx "snapshot-context" {^main.gene
      "(mod snapshot_context)
       (fn bind [api] {})
       (fn context [api basis]
         (let first (api/store .get \"state/counter\"))
         ($sleep 100)
         (let second (api/store .get \"state/counter\"))
         {^observations basis/observations ^focus basis/focus ^first first ^second second})"} "main.gene"))
    (p/commit tx)
    (request host {^id "snapshot@2" ^module revision ^code [revision] ^roots ["state/"]
      ^context true ^documentation "Snapshot context fixture"} "nil")
    (await_selected host "snapshot@2")
    (let deadline (+ ($os/monotonic_ms) 5000))
    (var building nil)
    (loop
      (runtime/heartbeat host)
      ($sleep 5)
      (let active (host/active .get))
      (if_yes (&& (! ($absent? active)) (== active/mode "context")
                   (! ($absent? (active/read_view/reads .get "state/counter"))))
        (set building active/record/id)
        (break))
      (if (> ($os/monotonic_ms) deadline) (p/problem "Context did not begin")))
    (p/put host/store "state/counter" 2)
    (body/receive host "New arrival during context construction")
    (try
      (runtime/settle host)
      (let cycle (p/get host/store $"cycle/${building}"))
      (assert_equal cycle/status "succeeded" cycle/result)
      (assert_equal cycle/context/first 1)
      (assert_equal cycle/context/second 1)
      (assert_equal (cycle/read_revisions .get "state/counter") original/revision)
      (let retained (p/revision host/store original/revision))
      (assert_equal retained/value 1)
      (assert_equal (p/get host/store "state/counter") 2)
      ensure (runtime/close_life host))))
