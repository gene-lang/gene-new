(import $test [describe it assert_equal assert_raises])
(import * : p ^from "../src/host/persistence")
(import * : runtime ^from "../src/host/runtime")
(import * : body ^from "../src/body/body")
(import * : brain ^from "../src/brain")
(import $db/sqlite [Db])

(fn fixture [clock = nil]
  (let name (p/id "continuity-edge"))
  (let host (runtime/open_life $"examples/life/tmp/${name}" ^create true
    ^clock (?? clock (fn [] 1000)) ^decisions [(brain/response "Quiet" "nil")]))
  (runtime/settle host)
  host)
(fn decide [host, note, source]
  ((host/decisions .get) .push (brain/response note source))
  (let observation (body/receive host note))
  (runtime/settle host)
  (for cycle in (p/values host/store "cycle/")
    (if_yes (&& (cycle/events .contains? observation/id) (== cycle/note note)) (return cycle))))

(describe "Life continuity edge cases"
  (it "repairs a cognitive link after standalone job publication without creating another job" []
    (let host (fixture))
    (try
      (let failed (decide host "Walk before the link is saved"
        "(do (body/world .start_walk \"garden\") (panic \"before cognitive link\"))"))
      (assert_equal failed/status "failed")
      (let before (p/values host/store "job/"))
      (assert_equal before/.size 1)
      (assert_equal (p/get host/store "state/activity") nil)
      (body/tick host 3000)
      (let repaired (decide host "Recover the actual published job"
        "(for pair in (store .roots)
          (if_yes ($str/starts_with? ($to_str pair/0) \"job/\")
            (let job pair/1)
            (if_yes (== job/kind \"walk\") (state .put \"activity\" job/id))))"))
      (assert_equal repaired/status "succeeded" repaired/result)
      (let after (p/values host/store "job/"))
      (assert_equal after/.size 1)
      (assert_equal after/0/id before/0/id)
      (assert_equal after/0/position 3.0)
      (assert_equal (p/get host/store "state/activity") before/0/id)
      ensure (runtime/close_life host)))

  (it "checks the current world when a decision's precondition changed during inference" []
    (let host (fixture))
    (let world (p/get host/store "world"))
    (world .put "position" 10)
    (p/put host/store "world" world)
    (let release ($cell false))
    (let count ($cell 0))
    (set host/brain (fn [snapshot]
      (count .set (+ (count .get) 1))
      (if_yes (== (count .get) 1)
        (while (! (release .get)) ($sleep 5))
        (return (brain/response "Water the observed dry plant"
          "(body/world .water \"plant-a\" ^expected 1)")))
      (brain/response "Consider the updated outcome" "nil")))
    (body/receive host "Please water the plant")
    (runtime/heartbeat host)
    ($sleep 5)
    (let thought (host/thought .get))
    (let tx (p/begin host/store "other-world-actor"))
    (body/apply_operation host tx {^id "other-world-actor" ^organization "starter@1"}
      "water" {^id "plant-a" ^expected 1})
    (body/event host tx "world_changed" {^plant "plant-a"})
    (p/commit tx)
    (release .set true)
    (try
      (runtime/settle host)
      (let cycle (p/get host/store $"cycle/${thought/cycle/id}"))
      (assert_equal cycle/status "failed")
      ($assert ($str/contains? cycle/result "precondition") cycle/result)
      (let actual (p/get host/store "world"))
      (assert_equal actual/objects/plant-a/version 2)
      (let outcomes (p/values host/store "outcome/"))
      (assert_equal outcomes/.size 1)
      (assert_equal outcomes/0/cause "other-world-actor")
      ensure (release .set true) (runtime/close_life host)))

  (it "uses fresh context and lateness rules on resume without executing a late paused response" []
    (let now ($cell 1000))
    (let host (fixture (fn [] (now .get))))
    (let tx (p/begin host/store "pause-fixture"))
    (let late (body/apply_operation host tx {^id "fixture" ^organization "starter@1"} "after"
      {^delay 1000 ^source "(state .put \"expired\" true)" ^missed {^run_within_ms 100 ^otherwise "expire"}}))
    (let allowed (body/apply_operation host tx {^id "fixture" ^organization "starter@1"} "after"
      {^delay 1000 ^source "(state .put \"resumed\" true)" ^missed {^run_within_ms 60000 ^otherwise "expire"}}))
    (p/commit tx)
    (let release ($cell false))
    (let count ($cell 0))
    (set host/brain (fn [snapshot]
      (count .set (+ (count .get) 1))
      (if_yes (== (count .get) 1)
        (while (! (release .get)) ($sleep 5))
        (return (brain/response "Late paused response" "(state .put \"stale\" true)")))
      (brain/response "Fresh resume context" "nil")))
    (body/receive host "Start deliberation")
    (runtime/heartbeat host)
    ($sleep 5)
    (let thought (host/thought .get))
    (runtime/pause host)
    (let before (p/get host/store "world"))
    (body/tick host 1000)
    (assert_equal (p/get host/store "world") before)
    (now .set 5000)
    (body/receive host "Retained during pause")
    (runtime/resume host)
    (runtime/settle host)
    (release .set true)
    (try
      (let deadline (+ ($os/monotonic_ms) 2000))
      (loop
        (runtime/heartbeat host)
        ($sleep 5)
        (let old (p/get host/store $"cycle/${thought/cycle/id}"))
        (if_yes (== old/late_response true) (break))
        (if (> ($os/monotonic_ms) deadline) (p/problem "Late response was not retained")))
      (assert_equal (p/get host/store "state/stale") nil)
      (assert_equal (p/get host/store "state/expired") nil)
      (assert_equal (p/get host/store "state/resumed") true)
      (let schedule (p/get host/store $"schedule/${late}"))
      (assert_equal schedule/status "expired")
      (let old_cycle (p/get host/store $"cycle/${thought/cycle/id}"))
      (assert_equal old_cycle/status "superseded")
      (var fresh false)
      (for cycle in (p/values host/store "cycle/")
        (if_yes (== cycle/note "Fresh resume context")
          ($assert (!= cycle/context_id old_cycle/context_id))
          (assert_equal cycle/context/now 5000)
          (set fresh true)))
      ($assert fresh)
      ensure (release .set true) (runtime/close_life host)))

  (it "rejects inconsistent world/activity checkpoints without creating another Life" []
    (let host (fixture))
    (decide host "Walk" "(body/world .start_walk \"garden\")")
    (body/tick host 2000)
    (let meta (p/get host/store "meta"))
    (let world (p/get host/store "world"))
    (world .put "position" 9)
    (p/put host/store "world" world)
    (let home host/store/home)
    (runtime/close_life host)
    (assert_raises (fn [] (runtime/open_life home)) p/LifeError)
    (let raw (p/open_store home))
    (try
      (let retained (p/get raw "meta"))
      (assert_equal retained/id meta/id)
      (let actual (p/get raw "world"))
      (assert_equal actual/position 9)
      ensure (p/close_store raw)))

  (it "rejects a missing immutable head and incompatible storage version" []
    (for fault in ["head" "version"]
      (let host (fixture))
      (let home host/store/home)
      (if (== fault "head")
        (host/store/db .Db:exec "UPDATE heads SET revision=99999999 WHERE key='world'")
        (host/store/db .Db:exec "PRAGMA user_version=99"))
      (runtime/abandon host)
      (assert_raises (fn [] (runtime/open_life home)) p/LifeError)))

  (it "keeps a completed process outcome distinct from a later cancellation request" []
    (let host (fixture))
    (let tx (p/begin host/store "completion-fixture"))
    (let owner (body/apply_operation host tx {^id "fixture" ^organization "starter@1"} "owner" {^id "completed-work"}))
    (let job (body/apply_operation host tx {^id "fixture" ^organization "starter@1"} "start_job"
      {^source "nil" ^owner owner}))
    (p/commit tx)
    (runtime/heartbeat host)
    (let active (host/active .get))
    (let deadline (+ ($os/monotonic_ms) 5000))
    (while ($absent? (active/done .get))
      ($sleep 5)
      (if (> ($os/monotonic_ms) deadline) (p/problem "Process did not complete")))
    (let request (p/begin host/store "late-withdrawal"))
    (body/apply_operation host request {^id "late-withdrawal" ^organization "starter@1"} "cancel_owner" {^id "completed-work"})
    (p/commit request)
    (try
      (runtime/settle host)
      (let result (p/get host/store $"job/${job/id}"))
      (assert_equal result/status "succeeded")
      (assert_equal result/cancellation_requested true)
      (assert_equal result/cancellation_cause "late-withdrawal")
      ensure (runtime/close_life host))))
