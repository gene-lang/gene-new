(import $test [describe it assert_equal assert_raises])
(import * : runtime ^from "../runtime")
(import * : connector ^from "../connector")
(import * : chat ^from "../chat")
(import * : body ^from "../body")
(import * : p ^from "../persistence")
(import * : mailbox ^from "./mailbox_support")
(import * : support ^from "./connector_crash_fixture")

(describe "Life HTTP connector"
  (it "polls while idle or paused without spending brain budget and retains speakers and threads" []
    (let fixture (mailbox/start))
    (try
      (let host (support/open_host fixture))
      (try
        (let registration (p/get host/store "connector/mailbox"))
        (assert_equal registration/id "mailbox")
        (assert_equal registration/peer_id "test-peer")
        (assert_equal registration/status "active")
        (assert_equal registration/cursor 0)
        (assert_equal registration/endpoint fixture/endpoint)
        ($assert (! ($absent? registration/adapter_revision)))
        (support/wait_for host (fn [] (let remote (mailbox/call fixture "/inspect" {}))
          (>= remote/polls 3)) "idle polls")
        (assert_equal (support/observations host) [])
        (assert_equal (host/calls .get) 0)
        (support/inject fixture "alice-1" "Alice" "watering")
        (support/inject fixture "bob-1" "Bob" "pruning")
        (support/inject fixture "carol-1" "Carol" "reading" ^conversation "library")
        (support/inject fixture "alice-1" "Alice" "watering")
        (support/wait_cursor host 4)
        (assert_equal ((support/observations host) .size) 3)
        (let alice (support/incoming host "alice-1"))
        (let bob (support/incoming host "bob-1"))
        (let carol (support/incoming host "carol-1"))
        (assert_equal alice/reply_to/adapter "http")
        (assert_equal alice/reply_to/connector "mailbox")
        (assert_equal alice/reply_to/conversation "garden")
        (assert_equal alice/reply_to/thread "watering")
        (assert_equal bob/reply_to/thread "pruning")
        (assert_equal carol/reply_to/conversation "library")
        (let garden (support/transcript host alice/reply_to))
        (assert_equal garden/participants ["Alice" "Bob"])
        (assert_equal garden/messages/.size 2)
        (assert_equal garden/pending [alice/id bob/id])
        (let library (support/transcript host carol/reply_to))
        (assert_equal library/participants ["Carol"])
        (assert_equal library/messages/.size 1)
        (runtime/pause host)
        (support/inject fixture "dave-1" "Dave" "watering")
        (support/wait_cursor host 5)
        (support/pump host)
        (assert_equal ((support/observations host) .size) 4)
        (assert_equal (host/calls .get) 0)
        (assert_equal (p/values host/store "delivery/") [])
      ensure (support/close_host host))
    ensure (mailbox/stop fixture)))

  (it "reconnects from its retained cursor and deduplicates replayed external IDs" []
    (let fixture (mailbox/start))
    (try
      (let host (support/open_host fixture))
      (let home host/store/home)
      (var accepted nil)
      (try
        (set accepted (support/seed host fixture))
      ensure (support/close_host host))
      (support/inject fixture "crash-input" "Alice" "watering" ^text "Please water later")
      (support/inject fixture "missed-1" "Bob" "pruning" ^text "While you were away")
      (support/inject fixture "missed-2" "Carol" "watering")
      (let restored (runtime/open_life home ^clock (fn [] 1000)))
      (try
        (assert_equal (support/cursor restored) 1)
        (support/wait_cursor restored 4)
        (assert_equal ((support/observations restored) .size) 3)
        (assert_equal ((support/incoming restored "crash-input") .get "id") accepted/id)
        (let retained (support/transcript restored accepted/reply_to))
        (assert_equal retained/messages/.size 3)
        (assert_equal retained/pending/.size 3)
        (assert_equal retained/participants ["Alice" "Bob" "Carol"])
        (support/pump restored)
        (assert_equal ((support/observations restored) .size) 3)
        (assert_equal (restored/calls .get) 0)
      ensure (support/close_host restored))
    ensure (mailbox/stop fixture)))

  (it "runs delayed ordinary Gene against a saved destination and clears only that thread's pending reply" []
    (let fixture (mailbox/start))
    (try
      (let now ($cell 1000))
      (let host (support/open_host fixture ^clock (fn [] (now .get))))
      (try
        (support/inject fixture "reply-a" "Alice" "watering")
        (support/inject fixture "reply-b" "Bob" "pruning")
        (support/wait_cursor host 2)
        (let alice (support/incoming host "reply-a"))
        (let bob (support/incoming host "reply-b"))
        (let tx (p/begin host/store "delayed-reply"))
        (p/tx_put tx "state/reply-destination" alice/reply_to)
        # Even an overbroad reply list must not acknowledge another thread.
        (p/tx_put tx "state/reply-events" [alice/id bob/id])
        (let scheduled (body/apply_operation host tx
          {^id "test" ^organization "starter@1" ^events [alice/id] ^owner nil} "after"
          {^delay 100 ^missed {^run_within_ms 1000 ^otherwise "expire"}
           ^source "(body/chat .send (state .get \"reply-destination\") \"Watered later\" ^in_reply_to (state .get \"reply-events\"))"}))
        (p/commit tx)
        (support/pump host)
        (assert_equal (p/values host/store "delivery/") [])
        (let before (support/transcript host alice/reply_to))
        (assert_equal before/pending [alice/id bob/id])
        (now .set 1100)
        (runtime/settle host)
        (let deliveries (p/values host/store "delivery/"))
        (assert_equal deliveries/.size 1)
        (let delivered (support/wait_delivered host deliveries/0/id))
        (assert_equal delivered/destination alice/reply_to)
        (assert_equal delivered/text "Watered later")
        (let after (support/transcript host alice/reply_to))
        (assert_equal after/pending [bob/id])
        (assert_equal after/messages/.size 3)
        (assert_equal after/messages/2/speaker "life")
        (assert_equal after/messages/2/thread "watering")
        (let remote (mailbox/call fixture "/inspect" {}))
        (assert_equal remote/effects 1)
        (assert_equal remote/sends 1)
        (assert_equal remote/sent/0/conversation "garden")
        (assert_equal remote/sent/0/thread "watering")
        (assert_equal remote/sent/0/text "Watered later")
        (let schedule (p/get host/store $"schedule/${scheduled}"))
        (assert_equal schedule/status "succeeded")
        (assert_equal (host/calls .get) 0)
      ensure (support/close_host host))
    ensure (mailbox/stop fixture)))

  (it "does not send a staged delivery before commit or after its commit fails" []
    (let fixture (mailbox/start))
    (try
      (let host (support/open_host fixture))
      (let home host/store/home)
      (var staged nil)
      (try
        (let observation (support/seed host fixture))
        (let record {^id "test" ^events [observation/id] ^owner nil})
        (let data {^destination observation/reply_to ^text "Must not escape" ^in_reply_to [observation/id]
          ^operation_id "failed-publication"})
        (let tx (p/begin host/store "failed-send-publication"))
        (set staged (chat/prepare host tx record data))
        (support/pump host)
        (let before (mailbox/call fixture "/inspect" {}))
        (assert_equal before/sends 0)
        (assert_equal (p/values host/store "delivery/") [])
        # Polling may revise a transaction's connector read. Use a fresh
        # snapshot so the next failure is publication, not an optimistic conflict.
        (p/abort tx)
        (let failing (p/begin host/store "failed-send-publication"))
        (set staged (chat/prepare host failing record data))
        (host/store/fail_next .set true)
        (assert_raises (fn [] (p/commit failing)) p/LifeError)
        ($assert (! ($absent? (host/store/fault .get))))
        (assert_equal (support/delivery host staged/id) nil)
        (assert_raises (fn [] (runtime/heartbeat host)) p/LifeError)
        (let failed (mailbox/call fixture "/inspect" {}))
        (assert_equal failed/sends 0)
        (assert_equal failed/effects 0)
      ensure (if_not (host/store/closed .get) (runtime/abandon host)))
      (let restored (runtime/open_life home ^clock (fn [] 1000)))
      (try
        (support/pump restored)
        (assert_equal (support/delivery restored staged/id) nil)
        (let remote (mailbox/call fixture "/inspect" {}))
        (assert_equal remote/sends 0)
      ensure (support/close_host restored))
    ensure (mailbox/stop fixture)))

  (it "leaves the cursor and ingress unpublished when the poll commit fails" []
    (let fixture (mailbox/start))
    (try
      (let current ($cell nil))
      (let host (support/open_host fixture ^fault (fn [at]
        (if_yes (== at "connector_before_commit")
          (let target (current .get))
          (target/store/fail_next .set true)))))
      (current .set host)
      (let home host/store/home)
      (try
        (let image ($fs/read_bytes $"${home}/life.sqlite"))
        (support/inject fixture "unpublished" "Alice" "watering")
        (let deadline (+ ($os/monotonic_ms) 5000))
        (while ($absent? (host/store/fault .get))
          (if (>= ($os/monotonic_ms) deadline) (p/problem "Poll publication did not fail"))
          (try (connector/tick host) catch p/LifeError nil)
          ($sleep 5))
        (assert_equal (support/cursor host) 0)
        (assert_equal (support/observations host) [])
        (assert_equal (p/values host/store "conversation/") [])
        (assert_equal ($fs/read_bytes $"${home}/life.sqlite") image)
      ensure (runtime/abandon host))
      (let restored (runtime/open_life home ^clock (fn [] 1000)))
      (try
        (assert_equal (support/cursor restored) 0)
        (support/wait_cursor restored 1)
        (assert_equal ((support/observations restored) .size) 1)
        (support/pump restored)
        (assert_equal ((support/observations restored) .size) 1)
      ensure (support/close_host restored))
    ensure (mailbox/stop fixture)))

  (it "cancels in-flight handles on close and reconciles a possible remote effect without resending" []
    (let fixture (mailbox/start))
    (try
      (let host (support/open_host fixture))
      (let home host/store/home)
      (var staged nil)
      (var observation nil)
      (try
        (set observation (support/seed host fixture))
        (mailbox/call fixture "/configure" {^delay_ms {^poll 1000 ^send 1000}})
        (set staged (support/stage host observation "cancelled-in-flight"))
        (support/wait_for host (fn [] (let remote (mailbox/call fixture "/inspect" {}))
          (== remote/sends 1)) "remote send launch")
        (let attempting (support/delivery host staged/id))
        (assert_equal attempting/status "attempting")
        (assert_equal attempting/receipt nil)
      ensure (support/close_host host))
      # No host heartbeat runs while the separate mailbox completes its request.
      (let deadline (+ ($os/monotonic_ms) 5000))
      (loop
        (let remote (mailbox/call fixture "/inspect" {}))
        (if (== remote/effects 1) (break))
        (if (>= ($os/monotonic_ms) deadline) (p/problem "Remote effect did not finish"))
        ($sleep 10))
      (mailbox/call fixture "/configure" {^delay_ms 0})
      (let restored (runtime/open_life home ^clock (fn [] 1000)))
      (try
        (let uncertain (support/delivery restored staged/id))
        (assert_equal uncertain/status "needs_reconciliation")
        (assert_equal uncertain/receipt nil)
        (let before (support/transcript restored observation/reply_to))
        (assert_equal before/messages/.size 1)
        (assert_equal before/pending [observation/id])
        (support/wait_delivered restored staged/id)
        (support/pump restored)
        (let reconciled_remote (mailbox/call fixture "/inspect" {}))
        (assert_equal reconciled_remote/effects 1)
        (assert_equal reconciled_remote/sends 1)
        ($assert (> reconciled_remote/receipts 0))
        (let after (support/transcript restored observation/reply_to))
        (assert_equal after/messages/.size 2)
        (assert_equal after/pending [])
      ensure (support/close_host restored))
    ensure (mailbox/stop fixture))))