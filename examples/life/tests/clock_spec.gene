(import $test [describe it])
(import [wall_ms] ^from "../clock")

(describe "Life wall clock"
  (it "matches Unix time for the current local timezone" []
    (let response ($os/exec ^cmd "/bin/date" ^args ["+%s"]))
    (let expected (* ($json/parse ($str/trim response/stdout)) 1000))
    ($assert (< ($math/abs (- (wall_ms) expected)) 2000))))
