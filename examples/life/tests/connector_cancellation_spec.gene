(import $test [describe it assert_equal assert_raises])
(import * : runtime ^from "../runtime")
(import * : connector ^from "../connector")
(import * : chat ^from "../chat")
(import * : body ^from "../body")
(import * : p ^from "../persistence")
(import * : mailbox ^from "./mailbox_support")
(import * : support ^from "./connector_crash_fixture")

(fn stage_owned [host, observation, operation]
  (let tx (p/begin host/store "owned-delivery"))
  (let record {^id "owned-test" ^organization "starter@1" ^events [observation/id]})
  (let owner (body/apply_operation host tx record "owner" {^id "reply-owner"}))
  (let delivery (chat/prepare host tx record
    {^operation_id operation ^destination observation/reply_to ^text "Owned reply"
     ^owner owner ^in_reply_to [observation/id]}))
  (p/commit tx)
  delivery)

(fn retire_owner [host]
  (let tx (p/begin host/store "withdraw-reply"))
  (body/apply_operation host tx {^id "withdraw-reply" ^organization "starter@1"}
    "cancel_owner" {^id "reply-owner"})
  (p/commit tx))

(fn assert_unconfirmed [host, delivery, observation]
  (let retained (support/delivery host delivery/id))
  (assert_equal retained/status "needs_reconciliation")
  (assert_equal retained/needs_reconciliation true)
  (assert_equal retained/cancellation_requested true)
  (assert_equal retained/receipt nil)
  (assert_equal retained/attempts 1)
  (let transcript (support/transcript host observation/reply_to))
  (assert_equal transcript/messages/.size 1)
  (assert_equal transcript/pending [observation/id]))

# Keep admitting work faster than one connector can drain it. Both phases
# have a bounded number of ticks, rather than waiting for the queue to empty.
(fn stream_until [host, observation, predicate, label]
  (var count 0)
  (let deadline (+ ($os/monotonic_ms) 10000))
  (while (! (predicate))
    (if (|| (>= count 128) (>= ($os/monotonic_ms) deadline))
      (p/problem $"No bounded progress for ${label} under pending traffic"))
    (let operation (p/id "stream"))
    (support/stage host observation operation)
    (runtime/heartbeat host)
    ($sleep 20)
    (set count (+ count 1))))

(describe "Life connector cancellation and fairness"
  (it "retires a queued owner's delivery before any HTTP send" []
    (let fixture (mailbox/start))
    (try
      (let host (support/open_host fixture))
      (try
        (let observation (support/seed host fixture))
        (let staged (stage_owned host observation "cancel-queued"))
        (assert_equal staged/status "pending")
        (retire_owner host)
        (support/pump host)
        (let retained (support/delivery host staged/id))
        (assert_equal retained/status "cancelled")
        (assert_equal retained/attempts 0)
        (assert_equal retained/needs_reconciliation false)
        (assert_equal retained/receipt nil)
        (let remote (mailbox/call fixture "/inspect" {}))
        (assert_equal remote/sends 0)
        (assert_equal remote/effects 0)
        (assert_equal remote/receipts 0)
        (let transcript (support/transcript host observation/reply_to))
        (assert_equal transcript/messages/.size 1)
        (assert_equal transcript/pending [observation/id])
      ensure (support/close_host host))
    ensure (mailbox/stop fixture)))

  (it "cancels an in-flight send handle promptly but retains uncertainty until its receipt arrives" []
    (let fixture (mailbox/start))
    (try
      (let host (support/open_host fixture))
      (try
        (let observation (support/seed host fixture))
        (mailbox/call fixture "/configure"
          {^delay_ms {^send 1800} ^unknown_receipts true ^drop_send_response true})
        (let staged (stage_owned host observation "cancel-attempted"))
        (support/wait_for host (fn [] (let launched (mailbox/call fixture "/inspect" {}))
          (== launched/sends 1)) "delayed send launch")
        (let network (host/network .get))
        (let request (network/requests .get "delivery:mailbox"))
        (assert_equal request/kind "send")
        (assert_equal (request/done .get) nil)
        (let started ($os/monotonic_ms))
        (retire_owner host)
        (support/wait_for host (fn [] (let retained (support/delivery host staged/id))
          (&& (== retained/status "needs_reconciliation") (! ($absent? (request/done .get)))))
          "owner-cancelled HTTP task" ^timeout_ms 1000)
        # This must beat both the 1800ms remote response and the 2000ms HTTP timeout.
        ($assert (< (- ($os/monotonic_ms) started) 1000))
        (let stopped (request/done .get))
        (assert_equal stopped/ok false)
        (assert_unconfirmed host staged observation)
        (support/wait_for host (fn [] (let unknown (mailbox/call fixture "/inspect" {}))
          (>= unknown/receipts 2)) "unknown receipts after owner retirement")
        (assert_unconfirmed host staged observation)
        # Cancelling the local task does not retract an already launched remote effect.
        (support/wait_for host (fn [] (let completed (mailbox/call fixture "/inspect" {}))
          (== completed/effects 1)) "remote effect after local cancellation")
        (assert_unconfirmed host staged observation)
        (mailbox/call fixture "/configure"
          {^unknown_receipts false ^drop_send_response false ^delay_ms 0})
        (let delivered (support/wait_delivered host staged/id))
        (assert_equal delivered/cancellation_requested true)
        (assert_equal delivered/needs_reconciliation false)
        (assert_equal delivered/attempts 1)
        (assert_equal delivered/receipt/operation_id staged/id)
        (assert_equal delivered/receipt/digest staged/digest)
        (support/pump host)
        (let remote (mailbox/call fixture "/inspect" {}))
        (assert_equal remote/sends 1)
        (assert_equal remote/effects 1)
        (let transcript (support/transcript host observation/reply_to))
        (assert_equal transcript/messages/.size 2)
        (assert_equal transcript/messages/1/id staged/id)
        (assert_equal transcript/pending [])
      ensure (support/close_host host))
    ensure (mailbox/stop fixture)))

  (it "cancels an attempted retired operation only after a definitive not_found receipt" []
    (let fixture (mailbox/start))
    (try
      (let armed ($cell false))
      (let host (support/open_host fixture ^fault (fn [phase]
        (if_yes (&& (armed .get) (== phase "delivery_before_send"))
          (p/problem "Test stops after attempt publication but before HTTP launch")))))
      (try
        (let observation (support/seed host fixture))
        (let staged (stage_owned host observation "cancel-before-launch"))
        (armed .set true)
        (assert_raises (fn [] (connector/tick host)) p/LifeError)
        (armed .set false)
        (let attempted (support/delivery host staged/id))
        (assert_equal attempted/status "attempting")
        (assert_equal attempted/attempts 1)
        (assert_equal attempted/needs_reconciliation true)
        (retire_owner host)
        (connector/failed host {^kind "send" ^id staged/id})
        (mailbox/call fixture "/configure" {^unknown_receipts true})
        (support/wait_for host (fn [] (let inspected (mailbox/call fixture "/inspect" {}))
          (>= inspected/receipts 2)) "unknown receipt for an unlaunched attempt")
        (assert_unconfirmed host staged observation)
        (mailbox/call fixture "/configure" {^unknown_receipts false})
        (support/wait_for host (fn [] (let retained (support/delivery host staged/id))
          (== retained/status "cancelled")) "definitive absence receipt")
        (let cancelled (support/delivery host staged/id))
        (assert_equal cancelled/needs_reconciliation false)
        (assert_equal cancelled/cancellation_requested true)
        (assert_equal cancelled/receipt nil)
        (assert_equal cancelled/attempts 1)
        (support/pump host)
        (let remote (mailbox/call fixture "/inspect" {}))
        (assert_equal remote/sends 0)
        (assert_equal remote/effects 0)
        (let transcript (support/transcript host observation/reply_to))
        (assert_equal transcript/messages/.size 1)
        (assert_equal transcript/pending [observation/id])
      ensure (support/close_host host))
    ensure (mailbox/stop fixture)))

  (it "keeps heartbeat, pause, local body work, and receive responsive during a slow poll" []
    (let fixture (mailbox/start))
    (try
      (mailbox/call fixture "/configure" {^delay_ms {^poll 1500}})
      (support/inject fixture "slow-incoming" "Alice" "watering")
      (let host (support/open_host fixture))
      (try
        (let launch_started ($os/monotonic_ms))
        (runtime/heartbeat host)
        ($assert (< (- ($os/monotonic_ms) launch_started) 1000))
        (support/wait_for host (fn [] (let inspected (mailbox/call fixture "/inspect" {}))
          (> inspected/polls 0)) "slow poll launch")
        (let network (host/network .get))
        (let poll (network/requests .get "poll:mailbox"))
        (assert_equal (poll/done .get) nil)
        (let started ($os/monotonic_ms))
        (runtime/heartbeat host)
        (runtime/pause host)
        (let local (body/receive host "Still responsive" ^speaker "Operator"
          ^conversation "local" ^thread "control"))
        (let tx (p/begin host/store "body-during-poll"))
        (body/apply_operation host tx {^id "body-during-poll" ^organization "starter@1"}
          "take" {^id "watering-can"})
        (p/commit tx)
        (runtime/heartbeat host)
        ($assert (< (- ($os/monotonic_ms) started) 1000))
        (assert_equal (poll/done .get) nil)
        (let meta (p/get host/store "meta"))
        (assert_equal meta/mode "paused")
        (let world (p/get host/store "world"))
        (assert_equal world/held "watering-can")
        (assert_equal world/inventory ["watering-can"])
        (let transcript (support/transcript host local/reply_to))
        (assert_equal transcript/messages/0/text "Still responsive")
        (support/wait_cursor host 1)
        (let remote_message (support/incoming host "slow-incoming"))
        (assert_equal remote_message/data/speaker "Alice")
        (assert_equal (host/calls .get) 0)
      ensure (support/close_host host))
    ensure (mailbox/stop fixture)))

  (it "does not let the first unresolved operation block a later pending send" []
    (let fixture (mailbox/start))
    (try
      (let host (support/open_host fixture))
      (try
        (let observation (support/seed host fixture))
        (mailbox/call fixture "/configure" {^drop_send_response true ^unknown_receipts true})
        (let first (support/stage host observation "unresolved-first"))
        (support/wait_for host (fn [] (let retained (support/delivery host first/id))
          (== retained/status "needs_reconciliation")) "first unknown operation")
        (mailbox/call fixture "/configure" {^drop_send_response false})
        (let later (support/stage host observation "later-pending"))
        (support/wait_delivered host later/id)
        (let unresolved (support/delivery host first/id))
        (assert_equal unresolved/status "needs_reconciliation")
        (assert_equal unresolved/needs_reconciliation true)
        (assert_equal unresolved/attempts 1)
        (assert_equal unresolved/receipt nil)
        (let remote (mailbox/call fixture "/inspect" {}))
        (assert_equal remote/sends 2)
        (assert_equal remote/effects 2)
        (assert_equal remote/sent/0/operation_id first/id)
        (assert_equal remote/sent/1/operation_id later/id)
      ensure (support/close_host host))
    ensure (mailbox/stop fixture)))

  (it "makes receipt progress for an attempted unknown operation under a continuous pending stream" []
    (let fixture (mailbox/start))
    (try
      (let host (support/open_host fixture))
      (try
        (let observation (support/seed host fixture))
        (mailbox/call fixture "/configure" {^drop_send_response true ^unknown_receipts true})
        (let first (support/stage host observation "unknown-under-load"))
        (support/wait_for host (fn [] (let retained (support/delivery host first/id))
          (== retained/status "needs_reconciliation")) "initial uncertain operation")
        (mailbox/call fixture "/configure" {^drop_send_response false})
        (for index in [1 2 3 4]
          (let operation $"backlog:${index}")
          (support/stage host observation operation))
        (let before (mailbox/call fixture "/inspect" {}))
        (stream_until host observation (fn [] (let progress (mailbox/call fixture "/inspect" {}))
          (&& (> progress/receipts before/receipts) (> progress/sends before/sends)))
          "both send and unknown-receipt lanes")
        (let unresolved (support/delivery host first/id))
        (assert_equal unresolved/status "needs_reconciliation")
        (assert_equal unresolved/receipt nil)
        (mailbox/call fixture "/configure" {^unknown_receipts false})
        (stream_until host observation (fn [] (let confirmed (support/delivery host first/id))
          (== confirmed/status "delivered")) "confirmed receipt lane")
        (let delivered (support/delivery host first/id))
        (assert_equal delivered/attempts 1)
        (assert_equal delivered/needs_reconciliation false)
        (assert_equal delivered/receipt/digest first/digest)
        (var pending 0)
        (for delivery in (p/values host/store "delivery/")
          (if_yes (== delivery/status "pending") (set pending (+ pending 1))))
        ($assert (> pending 0) "Receipt progress must not require draining pending work")
        (let transcript (support/transcript host observation/reply_to))
        (var replies 0)
        (for message in transcript/messages
          (if_yes (== message/id first/id) (set replies (+ replies 1))))
        (assert_equal replies 1)
        (let remote (mailbox/call fixture "/inspect" {}))
        (var effects 0)
        (for sent in remote/sent
          (if_yes (== sent/operation_id first/id) (set effects (+ effects 1))))
        (assert_equal effects 1)
      ensure (support/close_host host))
    ensure (mailbox/stop fixture))))