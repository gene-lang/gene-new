(import $test [describe it assert_equal])
(import * : mailbox ^from "./mailbox_support")

(fn payload [operation]
  {^operation_id operation ^life_id "test-life" ^peer_id "test-peer"
   ^conversation "garden" ^thread "watering" ^text "Watered the plants"})
(fn receipt_query [operation raw]
  {^peer_id "test-peer" ^operation_id operation ^digest ($crypto/sha256 raw)})

(describe "Gene HTTP mailbox fixture"
  (it "counts attempts separately, hashes raw bytes, and verifies receipts" []
    (let fixture (mailbox/start))
    (try
      (assert_equal ($fs/read_text $"${fixture/home}/ready.data") fixture/endpoint)
      (let raw ($json/stringify (payload "send-1")))
      (let first (mailbox/call fixture "/send" raw))
      (assert_equal first/status "delivered")
      (assert_equal first/peer_id "test-peer")
      (assert_equal first/operation_id "send-1")
      (assert_equal first/digest ($crypto/sha256 raw))
      (assert_equal first/receipt "receipt:send-1")
      (assert_equal (mailbox/call fixture "/send" raw) first)
      # Semantically equal JSON, but not the same bytes: this must conflict.
      (mailbox/call fixture "/send" $"${raw} " ^status 409)
      (let inspected (mailbox/call fixture "/inspect" {}))
      (assert_equal inspected/sends 3)
      (assert_equal inspected/effects 1)
      (assert_equal inspected/sent/.size 1)
      (assert_equal inspected/sent/0/thread "watering")
      (let query (receipt_query "send-1" raw))
      (assert_equal (mailbox/call fixture "/receipt" query) first)
      (mailbox/call fixture "/receipt" (receipt_query "send-1" "different") ^status 409)
      (let missing (mailbox/call fixture "/receipt" (receipt_query "absent" raw)))
      (assert_equal missing/status "not_found")
      (mailbox/call fixture "/configure" {^unknown_receipts true})
      (let unknown (mailbox/call fixture "/receipt" query))
      (assert_equal unknown/status "unknown")
      (let unknown_missing (mailbox/call fixture "/receipt" (receipt_query "absent" raw)))
      (assert_equal unknown_missing/status "unknown")
    ensure (mailbox/stop fixture)))

  (it "retains a committed send after a dropped response and process restart" []
    (let fixture (mailbox/start))
    (let raw ($json/stringify (payload "lost-response")))
    (try
      (mailbox/call fixture "/configure" {^drop_send_response true ^unknown_receipts true})
      (mailbox/call fixture "/send" raw ^status 503)
      (let inspected (mailbox/call fixture "/inspect" {}))
      (assert_equal inspected/effects 1)
      (assert_equal inspected/sends 1)
    ensure (mailbox/stop fixture))
    (let restarted (mailbox/start fixture/home))
    (try
      (let query (receipt_query "lost-response" raw))
      (let unknown (mailbox/call restarted "/receipt" query))
      (assert_equal unknown/status "unknown")
      (mailbox/call restarted "/configure" {^drop_send_response false ^unknown_receipts false})
      (let receipt (mailbox/call restarted "/receipt" query))
      (assert_equal receipt/status "delivered")
      (assert_equal receipt/receipt "receipt:lost-response")
      (assert_equal (mailbox/call restarted "/send" raw) receipt)
      (let after_restart (mailbox/call restarted "/inspect" {}))
      (assert_equal after_restart/effects 1)
      (assert_equal after_restart/sends 2)
      (assert_equal after_restart/sent/.size 1)
    ensure (mailbox/stop restarted)))

  (it "replays bounded pages, duplicate IDs, and retention gaps across restart" []
    (let fixture (mailbox/start))
    (try
      (let empty (mailbox/call fixture "/poll" {^peer_id "test-peer" ^cursor 0 ^limit 32}))
      (assert_equal empty/cursor 0)
      (assert_equal empty/messages [])
      (assert_equal empty/gap nil)
      (for index in ($range 0 34)
        (let message (mailbox/call fixture "/inject"
          {^id (if (< index 2) "duplicate" $"message-${index}") ^speaker $"visitor-${index}"
           ^text $"Hello ${index}" ^conversation "garden" ^thread $"thread-${index}"}))
        (assert_equal message/cursor (+ index 1)))
      (let page (mailbox/call fixture "/poll" {^peer_id "test-peer" ^cursor 0 ^limit 32}))
      (assert_equal page/cursor 32)
      (assert_equal page/messages/.size 32)
      (assert_equal page/messages/0/id page/messages/1/id)
      (assert_equal page/gap nil)
      (let tail (mailbox/call fixture "/poll" {^peer_id "test-peer" ^cursor 32 ^limit 32}))
      (assert_equal tail/cursor 34)
      (assert_equal tail/messages/.size 2)
      (mailbox/call fixture "/configure" {^floor 32})
    ensure (mailbox/stop fixture))
    (let restarted (mailbox/start fixture/home))
    (try
      (let gap (mailbox/call restarted "/poll" {^peer_id "test-peer" ^cursor 0 ^limit 32}))
      (assert_equal gap/peer_id "test-peer")
      (assert_equal gap/gap/from 0)
      (assert_equal gap/gap/to 32)
      (assert_equal gap/gap/reason "retention")
      (assert_equal gap/cursor 34)
      (assert_equal gap/messages/.size 2)
      (assert_equal gap/messages/0/cursor 33)
      (mailbox/call restarted "/configure" {^floor 34})
      (let gone (mailbox/call restarted "/poll" {^peer_id "test-peer" ^cursor 32 ^limit 32}))
      (assert_equal gone/cursor 34)
      (assert_equal gone/messages [])
      (assert_equal gone/gap/to 34)
    ensure (mailbox/stop restarted)))

  (it "honors configured route delays and validates HTTP failures" []
    (let fixture (mailbox/start))
    (try
      (mailbox/call fixture "/configure" {^delay_ms {^poll 25 ^send 25}})
      (let before_poll ($os/monotonic_ms))
      (mailbox/call fixture "/poll" {^peer_id "test-peer" ^cursor 0 ^limit 32})
      ($assert (>= (- ($os/monotonic_ms) before_poll) 25))
      (let before_send ($os/monotonic_ms))
      (mailbox/call fixture "/send" (payload "delayed"))
      ($assert (>= (- ($os/monotonic_ms) before_send) 25))
      (mailbox/call fixture "/configure" {^delay_ms 0})
      (mailbox/call fixture "/poll" {^peer_id "test-peer" ^cursor -1 ^limit 32} ^status 400)
      (mailbox/call fixture "/missing" {} ^status 404)
      (let rejected ($cell false))
      (try (mailbox/call fixture "/missing" {})
        catch mailbox/MailboxError (rejected .set true))
      ($assert (rejected .get))
    ensure (mailbox/stop fixture))))