(import $test [describe it assert_equal assert_raises])
(import * : runtime ^from "../src/host/runtime")
(import * : p ^from "../src/host/persistence")
(import * : body ^from "../src/body/body")
(import * : brain ^from "../src/brain")
(import * : seeds ^from "../src/seeds")

# docs/proposals/world.md §3.5: the creation seed is provenance, the current
# disposition is the Life's own data, and contexts are built from the latter.

(fn home [] (let name (p/id "seed")) $"examples/life/tmp/${name}")
(fn decide [host, source, note]
  (host/decisions/.get .push (brain/response note source))
  (let observation (body/receive host "Please consider"))
  (runtime/settle host)
  (for cycle in (p/values host/store "cycle/")
    (if_yes (&& (cycle/events .contains? observation/id) (== cycle/note note)) (return cycle)))
  (p/problem "No accepted test decision"))

(describe "Life creation seed and current disposition"
  (it "keeps the seed as provenance and builds contexts from the disposition the Life has now" []
    (let path (home))
    (let aster (seeds/named "aster"))
    (let host (runtime/open_life path ^^create ^clock (fn [] 1000) ^seed "aster"
      ^decisions [(brain/response "Quiet first start" "nil")]))
    (var first nil)
    (try
      (runtime/settle host)
      (let creation (p/get host/store "creation"))
      (assert_equal creation/seed aster)
      (assert_equal (p/get host/store "state/disposition") aster/inclination)
      (let meta (p/get host/store "meta"))
      (assert_equal creation/life_id meta/id)
      ($assert ($absent? meta/disposition) "The seed is not an operational setting")
      (set first (decide host "(state .put \"disposition\" \"I would now rather spend my days in the workshop.\")"
        "I have changed what I want."))
      (assert_equal first/status "succeeded" first/result)
      (assert_equal first/context/disposition aster/inclination)
      # The next decision is made by who the Life is now, not who it was told to be.
      (let later (decide host "nil" "Considering again."))
      (assert_equal later/context/disposition "I would now rather spend my days in the workshop.")
      (assert_equal (p/get host/store "creation") creation)
      # A program cannot rewrite where it came from.
      (let forged (decide host "(store .put \"creation\" {^seed \"someone else\"})" "Trying to rewrite my origin."))
      (assert_equal forged/status "failed" forged/result)
      (assert_equal (p/get host/store "creation") creation)
      ensure (runtime/close_life host))
    (let restored (runtime/open_life path ^clock (fn [] 1000)))
    (try
      (let again (decide restored "nil" "After a restart."))
      (assert_equal again/context/disposition "I would now rather spend my days in the workshop.")
      (let kept (p/get restored/store "creation"))
      (assert_equal kept/seed aster)
      ensure (runtime/close_life restored)))

  (it "offers the four Commons seeds beside the garden one and refuses an unknown name" []
    (assert_equal (seeds/names) ["garden" "aster" "brin" "cove" "dara"])
    (for name in (seeds/names)
      (let seed (seeds/named name))
      (assert_equal seed/revision seeds/revision)
      ($assert (> ($str/byte_size seed/inclination) 40) name))
    (assert_raises (fn [] (seeds/named "eve")) p/LifeError)
    (assert_raises (fn [] (runtime/open_life (home) ^^create ^seed "eve")) p/LifeError))

  (it "gives a Life created before the split one creation record and the same disposition" []
    (let path (home))
    (let host (runtime/open_life path ^^create ^clock (fn [] 1000)
      ^decisions [(brain/response "Quiet first start" "nil")]))
    (try
      (runtime/settle host)
      # As such a Life was stored: the text in `meta`, and nothing else.
      (let tx (p/begin host/store "older-layout"))
      (let meta (p/tx_get tx "meta"))
      (meta .put "disposition" "An older Life's only disposition")
      (p/tx_put tx "meta" meta)
      (p/tx_put tx "creation" nil)
      (p/tx_put tx "state/disposition" nil)
      (p/commit tx)
      ensure (runtime/close_life host))
    (let restored (runtime/open_life path ^clock (fn [] 1000)))
    (try
      (let creation (p/get restored/store "creation"))
      (assert_equal creation/seed/inclination "An older Life's only disposition")
      (assert_equal creation/recovered true)
      (assert_equal (p/get restored/store "state/disposition") "An older Life's only disposition")
      (let cycle (decide restored "nil" "Still myself."))
      (assert_equal cycle/context/disposition "An older Life's only disposition")
      ensure (runtime/close_life restored))))
