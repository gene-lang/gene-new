# Historical filename: strict module modes are removed in version 1.
# Required blocks and optional callable requests express the actual boundaries.
(fn optional_http []
  ^capabilities [(net/Http ^^optional)]
  (var op ($net/http_client/describe_operation
    ($net/http_client/prepare "GET" "https://example.com/")))
  (var decision ($capabilities/check_operation op))
  decision/allowed)
(fn main []
  ($assert (not (optional_http)))
  ($assert (try (require_capabilities [net/Http] 1)
    false catch MissingCapability true))
  0)
