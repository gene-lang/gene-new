# Mandatory admission precedes the body. Literal roots use this module's base.
(var entered ($cell 0))
(fn save_report [path content]
  ^capabilities [(fs/Write "reports")]
  (entered .set (+ (entered .get) 1))
  ($fs/write_text path content))
(fn main []
  (save_report "reports/ok.txt" "inside the requested tree")
  ($assert (try (with_capabilities []
    (save_report "reports/denied.txt" "forbidden"))
    false catch MissingCapability true))
  ($assert (== (entered .get) 1))
  0)
