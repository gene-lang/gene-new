# Operation-relative paths remain launch-relative; bounds never rebase paths.
(fn render [path] ($fs/write_text path "rendered"))
(fn main []
  (render "out/private.txt")
  (with_capabilities [(fs/Write "out/public")]
    (render "out/public/inside.txt")
    ($assert (try (render "out/private_again.txt")
      false catch MissingCapability true)))
  (render "out/after.txt")
  0)
