# Env bindings are ordinary values. Capability rows retain separate ceilings.
(fn can_read [path]
  (try ($fs/read_text path) true catch MissingCapability false))
(fn main []
  (let path "README.md")
  (let plain (env ^bindings {^input "hello"}))
  (let saved (env ^capabilities [fs/Read]))
  (let empty (env ^capabilities []))
  (let extended (empty .extend {^input "hello"}))
  (let read (quote (can_read path)))
  ($assert (== (eval (quote input) ^in plain) "hello"))
  ($assert (eval read ^in plain))
  ($assert (not (eval read ^in empty)))
  ($assert (not (eval read ^in extended)))
  ($assert (not (with_capabilities [] (eval read ^in saved))))
  (let retained (with_capabilities []
    (eval (quote (fn [] (can_read path))) ^in saved)))
  ($assert (not (retained)))
  ($assert (can_read path))
  0)
