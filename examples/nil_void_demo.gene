# nil is Gene's one absence value. A missing read yields nil; presence of a key
# is a separate question, answered by $has_key?.
(fn show [label value] ($println label ": " value))

(fn age_label [age : Int?] : Str
  (if ($absent? age) "unknown" $"${age}"))
(show "Omitted optional argument" (age_label))
(show "Supplied value" (age_label 25))

(type Person ^props {^age Int?})
(let missing_age (Person))
(let nil_age (Person ^age nil))
(show "Missing field reads nil" missing_age/age)
(show "Missing and stored nil differ in presence"
  [($has_key? missing_age "age") ($has_key? nil_age "age")])

(fn keep_positive [x : Int] : Int?
  (if (> x 0) x nil))
(show "map keeps one result per input" ($map [-1 2] keep_positive))
(show "filter_map drops nil results" ($filter_map [-1 2] keep_positive))

(let fields {^age 37 ^name "Ada"})
(fields .put "age" nil)
(show "Writing nil stores nil" [fields/age ($has_key? fields "age")])
(fields .delete "age")
(show "delete removes the key" ($has_key? fields "age"))
(show "dissoc builds a new map" ({^a 1 ^b 2} .dissoc "a"))
(show "json keeps null, ^^omit_nil drops it"
  [($json/stringify {^a nil ^b 1}) ($json/stringify {^a nil ^b 1} ^^omit_nil)])
