(alias Child (| Tag Str))
(alias Attrs (Map Sym Str))

(type Tag
  ^props {^name Str ^attrs Attrs?}
  ^body [Child...]

  (message render [] : Str
    (let inner
      ($str/join
        ($map ($body self)
          (fn [child]
            (match child
              (when (tag : Tag) tag/.render)
              (when (text : Str) text)
              (else ""))))
        ""))
    $"<${self/name}${self/.attrs_to_html}>${inner}</${self/name}>")

  (message attrs_to_html [] : Str
    (if ($map_empty? self/attrs)
      (then "")
      (else
        (var s (StrBuilder))
        (map_for [name value] in self/attrs
          (s .append " " ($to_str name) "=\"" value "\"")
        )
        s/.to_str))))

(for name in ["div" "strong"]
  (fn $ns/%name [^attrs... body...]
    (Tag ^name name ^attrs attrs body...)))

(let page
  (div ^class "card"
    "Hello "
    (strong "world")))

($println (page .render))
