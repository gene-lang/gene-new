(import [Outcome OutcomeError TurnClosed new_turn_items append_prompt_at append_plugin_prompt
         validate_outcome render_request rewrite_prompt_calls]
  ^from "../src/agents/outcome")
(import [split_response] ^from "../src/agents/response")
(import [evaluate_response] ^from "../src/agents/eval_site")

(fn main [args]
  (let console ($cell []))
  (let turn (new_turn_items 1 ^console (fn [text] ((console .get) .push text))))
  (let environment (env ^bindings {^Outcome Outcome ^append_prompt_at
    (fn [label line form value] (append_prompt_at turn label line form value))}))
  (let response (split_response "# goal\n# step\n\n(append_prompt \"x\" (+ 1 2))\n(append_prompt \"x\" \"again\")\n(Outcome ^prompt \"next\")"))
  (let forms (rewrite_prompt_calls response/forms))
  (let value (evaluate_response `(do %forms...) environment))
  (let validated (validate_outcome turn value))
  (let request (render_request turn validated ^result_line 6))
  ($assert ($str/contains? request "[1.x] line 4: (append_prompt \"x\" (+ 1 2))\n3") "line/form correlation changed")
  ($assert ($str/contains? request "[1.x#2] line 5:") "duplicate label lost its suffix")
  ($assert ($str/contains? request "[1.result] line 6: Outcome ^prompt\nnext") "Outcome prompt header is wrong")
  ($assert (! ($str/contains? request "@line")) "reader metadata leaked into the displayed form")
  (let collision (new_turn_items 8))
  (append_prompt_at collision "result" 1 (quote 1) 1)
  (let collision_value (validate_outcome collision (Outcome ^prompt "next")))
  (let collision_request (render_request collision collision_value))
  ($assert ($str/contains? collision_request "[8.result#2]") "implicit result id collided with a labeled output")
  ($assert (== collision_request (render_request collision collision_value)) "rendering changed output ids")
  (let plain (validate_outcome (new_turn_items 2) 42))
  ($assert (== plain/outcome/prompt 42) "plain result did not continue")
  ($assert (try (validate_outcome (new_turn_items 3) (Outcome ^^done)) false catch OutcomeError true)
    "done without reply was accepted")
  ($assert (try (validate_outcome (new_turn_items 3) (Outcome)) false catch OutcomeError true)
    "empty continuation was accepted")
  (let done (validate_outcome turn (Outcome ^^done ^reply "finished")))
  ($assert (== done/kind "done") "done did not finish")
  ($assert (== ($size (turn/items .get)) 0) "done retained appended items")
  ($assert (== ($size (console .get)) 1) "done did not note dropped items")
  ($runtime/with_context {^turn turn ^function "plugin_fn"}
    (fn [] (append_plugin_prompt "plugin" "body")))
  ($assert ($str/contains? (render_request turn nil) "fn plugin_fn") "plugin output lost function attribution")
  (turn/state .set "closed")
  ($assert (try (append_prompt_at turn "late" 1 (quote 1) 1) false catch TurnClosed true)
    "closed turn accepted an output")
  ($assert (try (rewrite_prompt_calls [(quote (append_prompt label 1))]) false catch OutcomeError true)
    "dynamic output label was accepted")
  ($println "outcome: completion, continuation, correlated labels, plugin output and closed turns passed"))
