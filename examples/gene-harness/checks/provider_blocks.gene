(import ^from "../src/agents/response" [split_response])
(import ^from "../src/agents/model_client" [completion_text response_text])
(import ^from "../src/agents/claude" [anthropic_text claude_text])
(fn main [args]
  (for text in ["\n(+ 1 2)\n<<<raw END\nexact body\nEND"
                "*** Begin Patch\n*** Add File: model.txt\n+ok\n*** End Patch"]
    (let outputs [
      (response_text {^status "completed" ^output [{^type "message" ^role "assistant" ^content [{^type "output_text" ^text text}]}]})
      (completion_text "openrouter" {^status 200 ^body ($json/stringify {^choices [{^message {^content text}}]})})
      (anthropic_text {^status 200 ^body ($json/stringify {^type "message" ^role "assistant" ^stop_reason "end_turn" ^content [{^type "text" ^text text}]})})
      (claude_text {^status 0 ^stdout ($json/stringify {^type "result" ^subtype "success" ^is_error false ^result text})})])
    (for output in outputs
      ($assert (== output text) "provider changed raw response bytes")
      (split_response output)
      (split_response ($str/trim output))))
  ($println "provider blocks: all transports preserve raw bytes and accept an EOF terminator"))
