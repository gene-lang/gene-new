(import ^from "../src/runtime/bootstrap" [open_runtime close_runtime])
(import ^from "../src/profiles/baseline" [baseline_profile])
(import ^from "../src/runtime/sessions" [create_session load_session])
(import ^from "../src/runtime/round_controller" [new_round_controller save_round round_receipt])
(import ^from "../src/storage/state" [append_core_event flush_event_store events_for])
(fn main [args]
  (let runtime (open_runtime args/0 "default" (baseline_profile)))
  (let root runtime/root)
  (create_session runtime/sessions ^id "recover")
  (let controller (new_round_controller runtime (fn [request] "")))
  (save_round controller "recover" {^id "r1" ^request_id "u1" ^submission_seq 1 ^state "running"
    ^prompt "test" ^digest "test" ^last_turn 1})
  (append_core_event runtime/events "session" "recover" {^type "turn/start" ^turn 1 ^round "r1"})
  (flush_event_store runtime/events)
  # Simulate loss of a running task without altering its durable metadata.
  (let loaded (load_session runtime/sessions "recover"))
  ((loaded/round .get) .put "state" "done")
  (close_runtime runtime)
  (let reopened (open_runtime root "default" (baseline_profile)))
  (try
    (let fresh (new_round_controller reopened (fn [request] "")))
    (let receipt (round_receipt fresh "recover" "r1"))
    ($assert (== receipt/state "interrupted") "historical receipt was not repaired")
    (let restored (load_session reopened/sessions "recover"))
    (let current (restored/round .get))
    ($assert (== current/state "interrupted") "blobbed current round was not repaired")
    (let endings [])
    (for event in (events_for reopened/events "session" "recover")
      (if (== event/type "turn/end") (endings .push event/payload/reason)))
    ($assert (== endings ["interrupted"]) "recovery did not close the open turn once")
    ($println "round recovery: current and historical blobbed receipts interrupt without replay")
    ensure (close_runtime reopened)))
