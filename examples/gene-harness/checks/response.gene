(import [split_response ResponseReadError] ^from "../src/agents/response")
(import [evaluate_response] ^from "../src/agents/eval_site")

(fn rejected? [text]
  (try (split_response text) false catch Any true))

(fn main [args]
  (let response (split_response "# finish\n(+ 1 2)\n<<<data END\n\\d+ \"quoted\"\nEND\n"))
  ($assert (== response/code "# finish\n(+ 1 2)\n") "code prefix changed")
  ($assert (== response/attachments/data "\\d+ \"quoted\"\n") "attachment bytes changed")
  (let forms response/forms)
  ($assert (== (evaluate_response `(do %forms...) (env)) 3) "forms did not evaluate")
  (let embedded (split_response "(let text \"hello\n<<<not a block\nbye\")\ntext\n"))
  ($assert (== ($size embedded/attachments) 0) "a string was split as a block")
  ($assert (== embedded/forms/.size 2) "multiline string code did not read")
  ($assert (rejected? "(+ 1") "unreadable code was accepted")
  ($assert (rejected? "<<<x STOP\nbody\n") "unterminated attachment was accepted")
  ($assert (rejected? "<<<x STOP\na\nSTOP\n<<<x DONE\nb\nDONE\n") "duplicate name was accepted")
  ($assert (rejected? "*** Begin Patch\n*** End Patch\n*** Begin Patch\n*** End Patch\n")
    "second patch was accepted")
  ($assert (rejected? "<<<x STOP\na\nSTOP\n(+ 1 2)\n") "code after a block was accepted")
  (let patch (split_response "*** Begin Patch\n*** Add File: a.txt\n+hello\n*** End Patch\n"))
  ($assert (== patch/forms/.size 0) "patch-only response was rejected")
  ($assert (! ($absent? patch/patch)) "patch-only response lost its patch")
  (let located (split_response "\n\n(+ 1 2)"))
  (let form located/forms/0)
  (let meta ($node/meta form))
  ($assert (== meta/line 3) "response line metadata was lost")
  # The evaluation site must not expose a controller's lexical h binding.
  ($assert (== (evaluate_response (quote (do (let h 7) h)) (env)) 7)
    "response local collided with Harness internals")
  ($println "response: code, raw blocks, read errors, locations and isolated evaluation passed"))
