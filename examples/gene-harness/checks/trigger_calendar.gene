(import ^from "../src/runtime/triggers" [at_ms validate_definition])
(import * : cron ^from "../src/runtime/schedule/cron")
(import * : timezone ^from "../src/runtime/schedule/timezone")
(fn main [args]
  (let rules (timezone/system_rules "America/New_York" 2100))
  (let daily (cron/compile "30 2 * * *"))
  ($assert (== (cron/next daily rules (at_ms "2026-03-08T00:00:00Z"))
               (at_ms "2026-03-09T06:30:00Z")) "cron did not skip the nonexistent spring minute")
  (let repeated (cron/compile "30 1 * * *"))
  ($assert (== (cron/next repeated rules (at_ms "2026-11-01T00:00:00Z"))
               (at_ms "2026-11-01T05:30:00Z")) "cron did not choose the earlier repeated minute")
  ($assert (== (cron/next repeated rules (at_ms "2026-11-01T05:30:00Z"))
               (at_ms "2026-11-02T06:30:00Z")) "cron ran twice during the fall transition")
  (let utc (timezone/system_rules "UTC" 2100))
  (let named (cron/compile "0 3 * jan mon"))
  ($assert (== (cron/next named utc (at_ms "2026-01-01T00:00:00Z"))
               (at_ms "2026-01-05T03:00:00Z")) "named cron fields did not match")
  ($assert (try (at_ms "2026-01-01T24:00:00Z") false catch Any true) "invalid scheduled hour was accepted")
  ($assert (try (validate_definition {^id "../escape" ^kind "scheduled" ^at 0 ^request "x"} 0) false catch Any true)
    "trigger id escaped the definition directory")
  ($println "trigger calendar: five fields, names, UTC timestamps, spring gaps and fall duplicate avoidance"))
