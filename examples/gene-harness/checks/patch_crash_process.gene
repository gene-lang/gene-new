(import ^from "../src/runtime/bootstrap" [open_runtime close_runtime])
(import ^from "../src/profiles/baseline" [baseline_profile])
(import ^from "../src/runtime/round_controller" [new_round_controller save_round])
(import ^from "../src/runtime/sessions" [require_record])
(import ^from "../src/storage/state" [append_core_event record_core_state flush_event_store core_state events_for])
(import ^from "../src/agents/harness_turn" [evaluate_harness_turn])

(fn hold_patch [root]
  (let runtime (open_runtime root "default" (baseline_profile)))
  (let controller (new_round_controller runtime (fn [request] "")))
  (save_round controller "default" {^id "p1" ^request_id "p1" ^submission_seq 1 ^state "running" ^last_turn 1})
  (append_core_event runtime/events "session" "default" {^type "turn/start" ^turn 1 ^round "p1"})
  ($fs/write_text "a.txt" "a0\n")
  ($fs/write_text "b.txt" "b0\n")
  (evaluate_harness_turn runtime/h 1 root
    "(Outcome ^done true ^reply \"patched\")\n*** Begin Patch\n*** Update File: a.txt\n@@\n-a0\n+a1\n*** Update File: b.txt\n@@\n-b0\n+b1\n*** End Patch\n"
    ^record (fn [kind data]
      (if (== kind "turn/response")
        (then
          (append_core_event runtime/events "session" "default"
            {^type "turn/response" ^turn 1 ^round "p1" ^text "two-file patch" ^blobs {} ^patch_files data/patch_files})
          (record_core_state runtime/events "session" "default" "session/state" "patch/1"
            {^files data/patch_files ^state "started" ^round "p1" ^turn 1})
          (flush_event_store runtime/events))))
    ^after_patch_rename (fn [number]
      (if_yes (== number 1)
        ($fs/write_text_atomic "owner-pid" ($to_str ($os/process_id)))
        ($sleep 60000)))))

(fn main [args]
  ($fs/make_dir args/0)
  (let root ($fs/real_path args/0))
  (if (== args/1 "hold") (return (do (hold_patch root) 0)))
  (let child ($os/exec_async ^cmd ($os/executable_path)
    ^args ["run" this_mod/.path root "hold"] ^timeout_ms 15000))
  (try
    (let marker ($path/join root "owner-pid"))
    (let deadline (+ ($os/monotonic_ms) 10000))
    (while (&& (! ($fs/exists? marker)) (< ($os/monotonic_ms) deadline)) ($sleep 5))
    ($assert ($fs/exists? marker) "patch did not reach the first commit rename")
    (let killed (await ($os/exec_async ^cmd "/bin/kill" ^args ["-9" ($str/trim ($fs/read_text marker))])))
    ($assert (== killed/status 0) "patch child could not be killed")
    (await child)
    (let reopened (open_runtime root "default" (baseline_profile)))
    (try
      (let recovery (core_state reopened/events "session" "default" "recovery"))
      ($assert ($str/contains? recovery/warnings/0 "a.txt, b.txt") "interrupted turn omitted affected patch paths")
      ($assert (== ($fs/read_text "a.txt") "a1\n") "first file did not commit before the crash")
      ($assert (== ($fs/read_text "b.txt") "b0\n") "recovery silently committed the second file")
      ($assert (! ($fs/exists? ".b.txt.gene-harness-tmp")) "recovery retained staging files")
      (let session (require_record reopened/sessions "default"))
      ($assert (== session/status "interrupted") "crashed round was replayed or lost")
      ($assert session/attention "partial patch did not set attention")
      (var noted false)
      (for event in (events_for reopened/events "session" "default")
        (if (&& (== event/type "trace") ($str/contains? event/payload/text "patch may be partially applied")) (set noted true)))
      ($assert noted "partial patch warning was absent from the transcript")
      ($println "patch crash: SIGKILL between real renames, interrupted transcript, attention and staging cleanup")
    ensure (close_runtime reopened))
  ensure (if_not (child .done?) (child .cancel) (child .join))))
