# Model-free package acceptance. Each child owns its own fresh workspace.
(type CheckError ^props {^message Str} ^impl [Error])
(impl Error for CheckError)
(fn main [args]
  (let directory ($path/parent this_mod/.path))
  (let executable ($os/executable_path))
  (let chosen (?? args/0 $"check-workspaces-${($crypto/random_hex 8)}"))
  ($fs/make_dir chosen)
  (let root ($fs/real_path chosen))
  (for name in ["activation" "event_store" "workspace_lock" "sessions" "composition" "leased_composition"
               "response" "outcome" "questions" "patch" "turn_eval" "plugin_v2" "turn_loop" "web_turn_loop" "history" "compaction"
               "message_transport" "kernel_snapshots" "round_concurrency" "round_recovery"
               "patch_recovery" "shared_runtime" "commands" "auth_restart" "stop_restart"
               "async_cli" "triggers" "trigger_recovery" "trigger_policies"
               "trigger_queue_restart" "trigger_calendar" "retention" "live_transcript" "late_console" "web_metadata" "web_paging" "responsiveness" "stop_grace" "provider_prefix" "plugin_command" "patch_transcript" "mid_turn" "command_edges" "patch_crash_process"]
    (let workspace $"${root}/${name}")
    (if ($fs/exists? $"${workspace}/.gene-harness")
      (fail (CheckError ^message $"Acceptance needs a fresh workspace: ${workspace}")))
    ($fs/make_dir workspace)
    ($println $"Checking ${name}...")
    (let result (await ($os/exec_async ^cmd executable
      ^args ["run" $"${directory}/${name}.gene" workspace] ^timeout_ms 120000 ^max_bytes 1048576)))
    ($print result/stdout)
    (if (!= result/status 0) (fail (CheckError ^message $"${name} failed: ${result/stderr}"))))
  ($println "Harness package checks passed."))
