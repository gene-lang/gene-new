(import [open_session_host close_session_host create_session ensure_runtime list_sessions submit
         host_busy? run_receipt]
  ^from "../src/runtime/session_host")
(import [append_core_event events_for unload_event_stream]
  ^from "../src/storage/state")
(import [unload_session load_session] ^from "../src/runtime/sessions")

(fn lifecycle_count [host]
  (var count 0)
  (for event in (events_for host/events "workspace" "workspace")
    (if (== event/type "lifecycle") (set count (+ count 1))))
  count)

(fn main [args]
  (let host (open_session_host ^workspace args/0 ^^offline))
  (try
    (let runtime (host/runtime .get))
    (let before (lifecycle_count host))
    (let a (create_session host ^title "Alpha"))
    (let b (create_session host ^title "Beta"))
    (for record in [a b]
      (append_core_event host/events "session" record/id
        {^type "trace" ^text record/title ^^ignorable}))
    (ensure_runtime host a)
    ($assert (same? (host/runtime .get) runtime) "opening a replaced the runtime")
    (ensure_runtime host b)
    ($assert (same? (host/runtime .get) runtime) "opening b replaced the runtime")
    (ensure_runtime host a)
    ($assert (== (lifecycle_count host) before) "session load reactivated plugins")
    (let submitted_a (submit host a/id "shared-a" 1 "/status"))
    (while (host_busy? host) ($sleep 1))
    (let finished_a (run_receipt host a/id submitted_a/id))
    ($assert (== finished_a/status "completed") "a round did not complete")
    (let submitted_b (submit host b/id "shared-b" 1 "/status"))
    (while (host_busy? host) ($sleep 1))
    (let finished_b (run_receipt host b/id submitted_b/id))
    ($assert (== finished_b/status "completed") "b round did not complete")
    ($assert (same? (host/runtime .get) runtime) "round submission replaced the runtime")
    (let loaded_a (load_session host/sessions a/id))
    (let loaded_b (load_session host/sessions b/id))
    ($assert (same? loaded_a/runtime loaded_b/runtime) "sessions do not share the workspace runtime")
    (let history_a (loaded_a/history .get))
    (let history_b (loaded_b/history .get))
    ($assert (unload_session host/sessions a/id) "a did not unload")
    ($assert (unload_session host/sessions b/id) "b did not unload")
    (let reloaded_a (load_session host/sessions a/id))
    (let reloaded_b (load_session host/sessions b/id))
    ($assert (== (reloaded_a/history .get) history_a) "a history changed on reload")
    ($assert (== (reloaded_b/history .get) history_b) "b history changed on reload")
    (unload_session host/sessions a/id)
    (unload_session host/sessions b/id)
    (list_sessions host)
    ($assert (== ((host/events/streams .get) .get $"session:${a/id}") void)
      "listing opened a stream")
    ($assert (== ((host/events/streams .get) .get $"session:${b/id}") void)
      "listing opened b's stream")
    ($assert (== (lifecycle_count host) before) "listing activated a plugin")
    ($println "shared runtime: two sessions load, unload and reload without plugin activation")
    ensure (close_session_host host)))
