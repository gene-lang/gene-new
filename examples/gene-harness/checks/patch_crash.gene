(import [prepare_patch commit_patch recover_patch_temporaries] ^from "../src/runtime/patch")

(fn main [args]
  ($fs/make_dir args/0)
  (let root ($fs/real_path args/0))
  (if (== args/1 "hold")
    (then
      ($fs/write_text ($path/join root "a.txt") "a0\n")
      ($fs/write_text ($path/join root "b.txt") "b0\n")
      (let plan (prepare_patch root "*** Begin Patch\n*** Update File: a.txt\n@@\n-a0\n+a1\n*** Update File: b.txt\n@@\n-b0\n+b1\n*** End Patch\n"))
      ($fs/write_text_atomic ($path/join root "response.gene") ($serde/write_data {^files plan/files}))
      (commit_patch plan ^after_rename (fn [number]
        (if (== number 1)
          (then
            ($fs/write_text ($path/join root "owner-pid") ($to_str ($os/process_id)))
            ($sleep 60000))))))
    (else
      (let saved ($serde/read_data ($fs/read_text ($path/join root "response.gene"))))
      (let note (recover_patch_temporaries root saved/files))
      ($assert ($str/contains? note "patch may be partially applied: a.txt, b.txt") "recovery omitted the file warning")
      ($assert (== ($fs/read_text ($path/join root "a.txt")) "a1\n") "first rename did not precede the crash")
      ($assert (== ($fs/read_text ($path/join root "b.txt")) "b0\n") "second rename happened before the crash")
      ($assert (! ($fs/exists? ($path/join root ".b.txt.gene-harness-tmp"))) "crash recovery retained a temporary")
      ($println "patch crash: partial commit is reported and staging files are removed"))))
