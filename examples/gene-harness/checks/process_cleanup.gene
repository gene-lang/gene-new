(fn hold [root, mode]
  (let channel ($channel ^capacity 1))
  (let process ($os/exec_stream_async ^cmd "/bin/sh" ^args ["-c" "echo $$; exec sleep 30"] ^stdout_chan channel))
  (let pid (channel .recv))
  ($fs/write_text_atomic $"${root}/gene.pid" ($to_str ($os/process_id)))
  ($fs/write_text_atomic $"${root}/child.pid" pid)
  (if (== mode "exit") ($os/exit 0))
  (await process))
(fn main [args]
  ($fs/make_dir args/0)
  (let root ($fs/real_path args/0))
  (if_not ($absent? args/1) (hold root args/1) (return 0))
  (for mode in ["INT" "TERM" "HUP" "exit"]
    (let directory ($path/join root mode))
    ($fs/make_dir directory)
    (let process ($os/exec_async ^cmd ($os/executable_path) ^args ["run" this_mod/.path directory mode] ^timeout_ms 10000))
    (try
      (let ready $"${directory}/child.pid")
      (let deadline (+ ($os/monotonic_ms) 7000))
      (while (&& (! ($fs/exists? ready)) (< ($os/monotonic_ms) deadline)) ($sleep 5))
      ($assert ($fs/exists? ready) "captured child never became ready")
      (let child ($str/trim ($fs/read_text ready)))
      (if_not (== mode "exit")
        (let parent ($str/trim ($fs/read_text $"${directory}/gene.pid")))
        (let killed (await ($os/exec_async ^cmd "/bin/kill" ^args [($ "-" mode) ($ "-" parent)])))
        ($assert (== killed/status 0) "signal could not reach the Gene process group"))
      (let result (await process))
      ($assert (if (== mode "exit") (== result/status 0) (!= result/status 0)) $"wrong process exit for ${mode}")
      (var alive ($os/exec ^cmd "/bin/kill" ^args ["-0" child]))
      (let gone (+ ($os/monotonic_ms) 3000))
      (while (&& (== alive/status 0) (< ($os/monotonic_ms) gone))
        ($sleep 10)
        (set alive ($os/exec ^cmd "/bin/kill" ^args ["-0" child])))
      ($assert (!= alive/status 0) $"${mode} orphaned captured process ${child}")
    ensure (if_not (process .done?) (process .cancel) (process .join))))
  ($println "process cleanup: INT/TERM/HUP and normal exit terminate live captured groups"))
