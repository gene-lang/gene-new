(import ^from "../src/runtime/bootstrap" [open_runtime close_runtime])
(import ^from "../src/profiles/baseline" [baseline_profile])
(import ^from "../src/runtime/commands" [submit_command command_receipt cancel_command])
(import ^from "../src/agents/history" [recall_body])
(fn wait_command [manager, id]
  (manager/watchers .get; .get $"default:${id}"; .join)
  (command_receipt manager "default" id))
(fn main [args]
  (let runtime (open_runtime args/0 "default" (baseline_profile)))
  (let manager runtime/commands)
  (try
    (let large (submit_command manager "default" "/sh head -c 2097152 /dev/zero | tr '\\0' x"))
    (let capped (wait_command manager large/id))
    ($assert (== capped/exit 0) $"large shell command failed: ${capped}")
    (let body (recall_body runtime "default" $"${large/id}.sh"))
    ($assert (== ($str/byte_size body) 1048576) "stored shell output was not capped at 1 MiB")
    ($assert (< ($str/byte_size capped/display) 20000) "display was not elided")
    (let slow (submit_command manager "default" "/sh echo $$ > parent.pid; sleep 60 & echo $! > child.pid; wait"))
    (let deadline (+ ($os/monotonic_ms) 3000))
    (while (&& (! ($fs/exists? "child.pid")) (< ($os/monotonic_ms) deadline)) ($sleep 1))
    ($assert ($fs/exists? "child.pid") "shell child never started")
    (let parent ($str/trim ($fs/read_text "parent.pid")))
    (let child ($str/trim ($fs/read_text "child.pid")))
    (cancel_command manager "default" slow/id)
    (let cancelled (wait_command manager slow/id))
    ($assert (== cancelled/status "cancelled") "command ignored cancellation")
    (for pid in [parent child]
      (var alive ($os/exec ^cmd "/bin/kill" ^args ["-0" pid]))
      (let reap_deadline (+ ($os/monotonic_ms) 2000))
      (while (&& (== alive/status 0) (< ($os/monotonic_ms) reap_deadline))
        ($sleep 10)
        (set alive ($os/exec ^cmd "/bin/kill" ^args ["-0" pid])))
      ($assert (!= alive/status 0) $"cancel retained process ${pid}"))
    ($fs/make_dir "folder")
    ($fs/write_bytes "binary" ($binary/from_list [0 1 255]))
    (let directory (wait_command manager (/id (submit_command manager "default" "/view folder"))))
    (let binary (wait_command manager (/id (submit_command manager "default" "/view binary"))))
    ($assert (== directory/view/kind "directory") "directory view was not classified")
    ($assert (== binary/view/kind "binary") "binary view tried to display text")
    ($assert (== binary/view/bytes 3) "binary view omitted size")
    ($println "command edges: 1 MiB cap, recall, process-group cancellation, directory and binary views")
  ensure (close_runtime runtime)))
