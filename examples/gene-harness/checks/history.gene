(import ^from "../src/runtime/bootstrap" [open_runtime close_runtime])
(import ^from "../src/profiles/baseline" [baseline_profile])
(import ^from "../src/agents/history"
  [
    bounded_request
    recall_body
    append_message
    provider_context
    elide_response
    history_state
    compact_history])
(import ^from "../src/runtime/sessions" [create_session])
(fn main [args]
  (let runtime (open_runtime args/0 "default" (baseline_profile)))
  (let workspace_root runtime/root)
  (try
    (let parts ["A"])
    (repeat i in 5000
      (parts .push "🙂"))
    (parts .push "Z")
    (let original ($str/join parts ""))
    (let requests
      (bounded_request
        runtime
        "default"
        [{^id "1.large" ^header "[1.large] line 2: output" ^value original}]))
    ($assert (< ($str/byte_size requests/full) 16384) "large item was not shortened")
    ($assert ($str/starts_with? requests/full "[1.large]") "item header was lost")
    ($assert ($str/contains? requests/full "recall \"1.large\"") "elision omitted recall")
    ($assert (== (recall_body runtime "default" "1.large") original) "recall changed Unicode bytes")
    ($assert
      (! ($str/contains? requests/settled "🙂"))
      "settled request retained a body over 2 KiB")
    (let items [])
    (let ascii [])
    (repeat position in 12000
      (ascii .push "x"))
    (let large ($str/join ascii ""))
    (repeat item_index in 8
      (items .push {^id $"2.output${item_index}" ^header $"[2.output${item_index}]" ^value large}))
    (let capped (bounded_request runtime "default" items))
    ($assert (<= ($str/byte_size capped/full) 65536) "whole request exceeded 64 KiB")
    ($assert ($str/contains? capped/full "recall \"2.output7\"") "overflow item lacked a stub")
    ($assert (== (recall_body runtime "default" "2.output7") large) "overflow body was lost")
    (append_message ^round "r1" runtime "default" "user" "initial")
    (append_message ^round "r1" ^turn 1 runtime "default" "assistant" "response1")
    (append_message ^settled requests/settled ^round "r1" ^turn 1
      runtime
      "default"
      "user"
      requests/full)
    (let context1 (provider_context runtime "default" "instructions"))
    (append_message ^round "r1" ^turn 2 runtime "default" "assistant" "response2")
    (append_message ^round "r1" ^turn 2 runtime "default" "user" "request2")
    (let context2 (provider_context runtime "default" "instructions"))
    (let prefix1 [context1/0 context1/1 context1/2])
    (let prefix2 [context2/0 context2/1 context2/2])
    ($assert
      (== ($json/stringify prefix1) ($json/stringify prefix2))
      "serialized prefix changed before the previous assistant boundary")
    ($assert (!= context1/3/content context2/3/content) "last full request did not settle")
    ($assert (== context2/3/content requests/settled) "older request settled more than once")
    (let saved (history_state runtime "default"))
    ($assert
      (== saved/messages/1/content "response1")
      "assistant history changed during settlement")
    (let response
      (elide_response
        runtime
        "default"
        3
        ($
          """(Outcome ^prompt "next")
<<<asset END
"""
          large
          """
END
""")))
    ($assert (! ($str/contains? response/text large)) "assistant attachment was not elided")
    ($assert
      (==
        (recall_body runtime "default" "3.attachment.asset")
        ($
          large
          """
"""))
      "attachment recall lost its newline")
    ($println "history: UTF-8 bounds, 16/64 KiB caps, recall, assistant elision and stable prefix")
  ensure
    (close_runtime runtime))
  (let reopened (open_runtime workspace_root "default" (baseline_profile)))
  (try
    ($assert
      (== ($str/byte_size (recall_body reopened "default" "2.output7")) 12000)
      "recall did not survive restart")
    ($println "history: recall survived restart")
  ensure
    (close_runtime reopened)))
