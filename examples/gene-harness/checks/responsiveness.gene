(import ^from "../src/web/session_service" [open_session_service close_session_service list_sessions])
(import ^from "../src/runtime/sessions" [create_session])
(import ^from "../src/runtime/round_controller" [submit_round cancel_round round_receipt])
(import ^from "../src/runtime/triggers" [create_trigger list_occurrences delete_trigger])
(import $net/http [listen serve stop json])
(import $net/http_client [request])
(fn main [args]
  (let entered ($cell false))
  (let code ($cell ""))
  (let ticks ($cell 0))
  (let service (open_session_service ^workspace args/0 ^provider (fn [context]
    (if (== context/session "busy") (code .get) "(Outcome ^done true ^reply \"done\")"))))
  (service/runtime/functions .put "entered" (fn [] (entered .set true)))
  (service/runtime/functions .put "work_tick" (fn [] (ticks .set (+ (ticks .get) 1))))
  (create_session service/sessions ^id "busy")
  (create_session service/sessions ^id "other")
  (let server (listen ^host "127.0.0.1" ^port 0))
  # Serve owns the root event loop, as it does in the browser host. Drive the
  # scenarios from a sibling task so the host can dispatch their requests.
  (let tester (spawn ^lane root (try
    (let port server/port)
    (let url $"http://127.0.0.1:${port}/api/v4/sessions")
    # Initialize the native client before timing the server's response path.
    (await (request ^url url ^timeout_ms 1000))
    (var sequence 0)
    (for scenario in [
      "(entered) (while true (work_tick))"
      "(entered) ($map [1] (fn [n] (while true (work_tick))))"
      "(entered) ($os/exec ^cmd \"sleep\" ^args [\"30\"]) (Outcome ^done true ^reply \"done\")"]
      (set sequence (+ sequence 1))
      (entered .set false)
      (code .set scenario)
      (let slow (submit_round service/controller "busy" ($to_str sequence) sequence "work"))
      (while (! (entered .get)) ($sleep 1))
      (let trigger $"responsive-${sequence}")
      (create_trigger service/runtime/triggers {^id trigger ^kind "heartbeat" ^every_ms 20 ^request "tick"})
      (let fast (submit_round service/controller "other" ($to_str sequence) sequence "finish"))
      (service/controller/watchers .get; .get "other"; .join)
      ($assert (== (/state (round_receipt service/controller "other" fast/id)) "done") "busy response blocked another session")
      (var fired false)
      (let until (+ ($os/monotonic_ms) 2000))
      (while (&& (! fired) (< ($os/monotonic_ms) until))
        (for occurrence in (list_occurrences service/runtime/triggers ^trigger trigger)
          (if (== occurrence/state "finished") (set fired true)))
        (if_not fired ($sleep 1)))
      ($assert fired "busy response blocked a heartbeat")
      (delete_trigger service/runtime/triggers trigger)
      (let before ($os/monotonic_ms))
      (let response (await (request ^url url ^timeout_ms 1000)))
      (let latency (- ($os/monotonic_ms) before))
      ($assert (== response/status 200) "HTTP listing failed during busy response")
      ($assert (< latency 100) $"HTTP listing took ${latency} ms")
      (let cancellation ($os/monotonic_ms))
      (let active ((service/controller/active .get) .get "busy"))
      ($assert (! (active .done?)) "responsiveness fixture completed before the cancel request")
      (cancel_round service/controller "busy" slow/id)
      (active .join)
      (let stopped_after (- ($os/monotonic_ms) cancellation))
      (let stopped_ticks (ticks .get))
      ($sleep 30)
      ($assert (== (ticks .get) stopped_ticks) "response work outlived its cancelled round")
      (service/controller/watchers .get; .get "busy"; .join)
      (let delay (- ($os/monotonic_ms) cancellation))
      ($println $"cancellation work: ${stopped_after} ms; receipt: ${delay} ms")
      ($assert (< stopped_after 100) $"response work took ${stopped_after} ms to cancel")
      ($assert (== (/state (round_receipt service/controller "busy" slow/id)) "cancelled") "busy response ignored cancellation")
      ($println $"responsive scenario ${sequence}: HTTP ${latency} ms, cancellation ${stopped_after} ms"))
  ensure
    (stop server)
    (close_session_service service))))
  (serve server ^tick_ms 1 ^on_tick (fn [] nil) ^handler (fn [request]
    (json 200 ($json/stringify (list_sessions service)))))
  (let outcome (tester .join))
  (match outcome
    (when (TaskOutcome/ok value) value)
    (when (TaskOutcome/error error) (fail error))
    (else ($assert false $"responsiveness task did not finish: ${outcome}"))))
