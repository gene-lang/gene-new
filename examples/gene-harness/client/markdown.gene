(mod harness_markdown ^profile web)

(import [code_view] ^from "./highlight.gene")

# A small, text-only Markdown renderer. Every node is built through $dom;
# source HTML is text and links accept only explicit safe URL forms.
(fn text_at [parts : (List Str), index : Int] : Str parts/%index)

(fn slice_text [chars : (List Str), start : Int, end : Int] : Str
  (var parts : (List Str) [])
  (var i start)
  (while (< i end) (parts .push chars/%i) (set i (+ i 1)))
  (str/join parts ""))

(fn safe_link [url : Str] : Bool
  (|| (str/starts_with? url "https://") (str/starts_with? url "http://")
      (str/starts_with? url "mailto:") (str/starts_with? url "#")))

# Reverse lookup tables make unmatched delimiters linear in input size too.
(fn next_delimiters [chars : (List Str), marker : Str, double : Bool] : (List Int)
  (var result : (List Int) [])
  (var n ($size chars))
  (var next n)
  (var i (- n 1))
  (while (>= i 0)
    (result .push next)
    (if_yes (&& (== chars/%i marker)
      (|| (! double) (&& (< (+ i 1) n) (== (text_at chars (+ i 1)) marker))))
      (set next i))
    (set i (- i 1)))
  result)

(fn next_after [positions : (List Int), from : Int] : Int
  (var n ($size positions))
  (if_yes (>= from n) (return n))
  (var index (- (- n 1) from))
  positions/%index)

(fn inline_text [parent : EventTarget, text : Str] : Void
  (var chars : (List Str) (str/split text ""))
  (var n ($size chars))
  (var ticks (next_delimiters chars "`" false))
  (var stars (next_delimiters chars "*" false))
  (var doubles (next_delimiters chars "*" true))
  (var brackets (next_delimiters chars "]" false))
  (var parens (next_delimiters chars ")" false))
  (var i 0)
  (var plain "")
  (while (< i n)
    (var char : Str chars/%i)
    (var width 1)
    (var end (+ i 1))
    (var node : Any nil)
    (if_yes (|| (== char "`") (== char "*"))
      (if_yes (&& (== char "*") (< (+ i 1) n) (== (text_at chars (+ i 1)) "*"))
        (set width 2))
      (set end (if (== char "`") (next_after ticks i)
        (if (== width 2) (next_after doubles (+ i 1)) (next_after stars i))))
      (if_yes (&& (< end n) (> end (+ i width)))
        (var content (slice_text chars (+ i width) end))
        (set node
          (if (== char "`") ($dom/render `(code %content))
            (if (== width 2) ($dom/render `(strong %content)) ($dom/render `(em %content)))))
        (set end (+ end width))))
    (if_yes (== char "[")
      (set end (next_after brackets i))
      (if_yes (&& (< (+ end 1) n) (== (text_at chars (+ end 1)) "("))
        (var close (next_after parens (+ end 1)))
        (if_yes (< close n)
          (var url (slice_text chars (+ end 2) close))
          (if_yes (safe_link url)
            (var label (slice_text chars (+ i 1) end))
            (set node ($dom/render `(a ^href %url ^target "_blank" ^rel "noopener noreferrer" %label)))
            (set end (+ close 1))))))
    (if ($absent? node)
      (then (set plain ($ plain char)) (set i (+ i 1)))
      (else
        (if_yes (!= plain "") ($dom/append parent ($dom/render `(span %plain))))
        (set plain "")
        ($dom/append parent node)
        (set i end))))
  (if_yes (!= plain "") ($dom/append parent ($dom/render `(span %plain)))))

(fn table_cells [line : Str] : (List Str)
  (var parts : (List Str) (str/split (str/trim line) "|"))
  (var cells : (List Str) [])
  (var i 0)
  (for part in parts
    (var value (str/trim part))
    (if_not (&& (== value "") (|| (== i 0) (== i (- ($size parts) 1))))
      (cells .push value))
    (set i (+ i 1)))
  cells)

(fn table_separator [line : Str] : Bool
  (if_not (str/contains? line "|") (return false))
  (var cells (table_cells line))
  (if_yes (== ($size cells) 0) (return false))
  (for cell in cells
    (var dashes 0)
    (for char in (str/split cell "")
      (if (== char "-") (set dashes (+ dashes 1))
        (if (!= char ":") (return false))))
    (if_yes (< dashes 3) (return false)))
  true)

(fn list_item [line : Str] : Any
  (var chars : (List Str) (str/split (str/trim line) ""))
  (var n ($size chars))
  (if_yes (&& (>= n 2) (== chars/1 " ")
              (|| (== chars/0 "-") (== chars/0 "*") (== chars/0 "+")))
    (return {^ordered false ^text (slice_text chars 2 n)}))
  (var i 0)
  (while (&& (< i n) (str/contains? "0123456789" chars/%i)) (set i (+ i 1)))
  (if_yes (&& (> i 0) (< (+ i 1) n) (== chars/%i ".") (== (text_at chars (+ i 1)) " "))
    (return {^ordered true ^text (slice_text chars (+ i 2) n)}))
  nil)

(fn markdown_view [text : Str] : EventTarget
  (var root ($dom/render `(div ^class_name "markdown")))
  (var lines : (List Str) (str/split text "\n"))
  (var count ($size lines))
  (var i 0)
  (while (< i count)
    (var line : Str (str/trim lines/%i))
    (if (== line "") (then (set i (+ i 1)))
      (elif (|| (str/starts_with? line "```") (str/starts_with? line "~~~"))
        (var fence (if (str/starts_with? line "```") "```" "~~~"))
        (var info (str/trim (slice_text (str/split line "") 3 ($size line))))
        (var language : Str "")
        (for char in (str/split info "")
          (if_yes (|| (== char " ") (== char "\t")) (break))
          (set language ($ language char)))
        (var code : (List Str) [])
        (set i (+ i 1))
        (while (&& (< i count) (! (str/starts_with? (str/trim lines/%i) fence)))
          (code .push lines/%i) (set i (+ i 1)))
        (var pre ($dom/render `(pre)))
        ($dom/append pre (code_view (str/join code "\n") (== (str/lower language) "gene")))
        ($dom/append root pre)
        (if_yes (< i count) (set i (+ i 1))))
      (elif (&& (< (+ i 1) count) (str/contains? line "|") (table_separator (text_at lines (+ i 1))))
        (var headers (table_cells line))
        (var alignments (table_cells (text_at lines (+ i 1))))
        (var wrap ($dom/render `(div ^class_name "table_scroll")))
        (var table ($dom/render `(table)))
        (var head ($dom/render `(thead)))
        (var header_row ($dom/render `(tr)))
        (for header in headers
          (var header_cell ($dom/render `(th)))
          (inline_text header_cell header) ($dom/append header_row header_cell))
        ($dom/append head header_row) ($dom/append table head)
        (var body ($dom/render `(tbody)))
        (set i (+ i 2))
        (while (&& (< i count) (str/contains? lines/%i "|") (!= (str/trim lines/%i) ""))
          (var values (table_cells lines/%i))
          (var row ($dom/render `(tr)))
          (var column 0)
          (for header in headers
            (var value (if (< column ($size values)) values/%column ""))
            (var align (if (< column ($size alignments)) alignments/%column ""))
            (var cls (if (str/ends_with? align ":")
              (if (str/starts_with? align ":") "align_center" "align_right") ""))
            (var cell ($dom/render `(td ^class_name %cls)))
            (inline_text cell value) ($dom/append row cell)
            (set column (+ column 1)))
          ($dom/append body row) (set i (+ i 1)))
        ($dom/append table body) ($dom/append wrap table) ($dom/append root wrap))
      (else
        (var chars : (List Str) (str/split line ""))
        (var level 0)
        (while (&& (< level ($size chars)) (< level 6) (== chars/%level "#"))
          (set level (+ level 1)))
        (var item (list_item line))
        (if (&& (> level 0) (< level ($size chars)) (== chars/%level " "))
          (then
            (var heading (if (== level 1) ($dom/render `(h1))
              (if (== level 2) ($dom/render `(h2))
                (if (== level 3) ($dom/render `(h3))
                  (if (== level 4) ($dom/render `(h4))
                    (if (== level 5) ($dom/render `(h5)) ($dom/render `(h6))))))))
            (inline_text heading (slice_text chars (+ level 1) ($size chars)))
            ($dom/append root heading) (set i (+ i 1)))
          (elif (! ($absent? item))
            (var ordered : Bool item/ordered)
            (var list (if ordered ($dom/render `(ol)) ($dom/render `(ul))))
            (while (< i count)
              (var entry (list_item lines/%i))
              (if_yes ($absent? entry) (break))
              (var entry_ordered : Bool entry/ordered)
              (if_yes (!= entry_ordered ordered) (break))
              (var child ($dom/render `(li)))
              (var item_text : Str entry/text)
              (inline_text child item_text) ($dom/append list child)
              (set i (+ i 1)))
            ($dom/append root list))
          (else
            (var paragraph ($dom/render `(p)))
            (inline_text paragraph lines/%i)
            ($dom/append root paragraph) (set i (+ i 1)))))))
  root)
