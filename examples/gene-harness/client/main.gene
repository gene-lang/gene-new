(mod harness_client ^profile web)

(import [terminal merge_blocks query_value draft_key bounded_blocks step_key step_block marker_block run_label] ^from "./state.gene")
(import [protocol_version] ^from "../src/web/contract.gene")
(import [block_view step_view run_status_view not_durable] ^from "./view.gene")

(type Client ^props {
  ^selected Str ^csrf Str ^cursor Str ^next_seq Str ^epoch Str
  ^ready Bool ^connected Bool ^server_busy Bool ^awaiting Str ^awaiting_session Str ^queued_prompt Str
  ^message_sequence Int ^sending Bool ^busy Bool ^autoscroll Bool
  ^has_older Bool ^loading_older Bool ^socket_epoch Int ^viewing_history Bool
  ^generation Int ^records (List Any) ^preview (List Any) ^sessions (List Any)
  ^expanded (List Str) ^runs (List Any)
  ^input_id Str ^answering Bool
  ^run Any ^pending Any ^status Any ^socket Any ^session_revision Str
  ^root EventTarget ^list EventTarget ^transcript EventTarget
  ^prompt EventTarget ^notice EventTarget ^title EventTarget})

(fn notice [client : Client, text : Str] : Void
  ($dom/set_text client/notice text))

(fn set_hidden [id : Str, hidden : Bool] : Void
  (var element ($dom/element id))
  (set element/hidden hidden))

(fn string_or [value : Any, fallback : Str] : Str
  (if_yes ($absent? value) (return fallback))
  (var text : Str value)
  text)

(fn api [client : Client, method : Str, path : Str, payload : Any,
         done : (Fn [Int Any] Void)] : Void
  ($http/request method path ($json/stringify payload)
    {^content-type "application/json" ^x-csrf-token client/csrf}
    (fn [status : Int, body : Str] : Void
      (var result : Any
        (if (== body "") {^code "disconnected" ^message "Connection lost. Your draft is saved."}
          (try ($json/parse body)
            catch Any {^code "invalid_response" ^message "The Harness returned an unreadable response."})))
      (done status result))))

(fn show_error [client : Client, result : Any] : Void
  (var message (string_or result/message "The request could not be completed."))
  (notice client message))

(fn remember_draft [client : Client] : Void
  (if_yes (! client/ready) (return))
  (if_yes (&& (!= client/selected "") (== client/generation 0)) (return))
  (var key (draft_key (if (== client/selected "") "new" client/selected)))
  (if_not ($session_storage/set key ($dom/input_value client/prompt))
    (notice client "Browser storage is unavailable. Keep this tab open to preserve your draft.")))

(fn controls [client : Client] : Void
  (var send ($dom/element "send"))
  (var stop ($dom/element "stop"))
  ($dom/set_class client/root "working" client/busy)
  ($dom/set_class client/root "sending" client/sending)
  (set send/disabled (|| (! client/ready) (! client/connected) client/sending client/busy (!= client/input_id "")))
  (var rename ($dom/element "rename_session"))
  (set rename/disabled (|| (! client/ready) (! client/connected) (== client/selected "") client/busy))
  (var create_button ($dom/element "create_session"))
  (set create_button/disabled (|| (! client/ready) (! client/connected) client/sending client/busy))
  (set client/prompt/disabled (! client/ready))
  (set stop/hidden (! client/server_busy))
  (set stop/disabled (! client/ready))
  (for id in ["input_submit" "input_yes" "input_no" "input_cancel"]
    (var button ($dom/element id))
    (set button/disabled (|| client/answering (! client/ready) (! client/connected) client/server_busy)))
  (set send/text_content
    (if client/sending "Sending…" (if ($absent? client/pending) "Send" "Resolve")))
  (var mode "Local workspace")
  (if_not ($absent? client/status)
    (var model : Str client/status/model)
    (var provider : Str client/status/provider)
    (set mode (if client/status/offline "Command demo · no model" $"${model} · ${provider}")))
  (set_hidden "offline_notice" (|| ($absent? client/status) (! client/status/offline)))
  ($dom/set_text ($dom/element "mode") mode))

(fn render_input [client : Client] : Void
  (var request : Any nil)
  (if_not ($absent? client/run)
    (var status : Str client/run/status)
    (if_yes (== status "waiting_input") (set request client/run/input)))
  (var id (if ($absent? request) "" (string_or request/id "")))
  (set_hidden "input_panel" (== id ""))
  (if_yes (== id client/input_id) (return))
  (set client/input_id id)
  (if_yes (== id "") (return))
  (var prompt : Str request/prompt)
  (var kind : Str request/kind)
  ($dom/set_text ($dom/element "input_question") prompt)
  (var fields ($dom/element "input_fields"))
  ($dom/clear fields)
  (set_hidden "input_submit" (== kind "confirm"))
  (set_hidden "input_yes" (!= kind "confirm"))
  (set_hidden "input_no" (!= kind "confirm"))
  (if (== kind "select")
    (then
      (var options : (List Str) request/options)
      (var multi : Bool request/multi)
      (if multi
        (then
          (var defaults : (List Str) [])
          (if_not ($absent? request/default) (set defaults request/default))
          (var i 0)
          (for option in options
            (var option_id $"input_option_${i}")
            (var selected false)
            (for value in defaults (if_yes (== value option) (set selected true)))
            ($dom/append fields ($dom/render `(label ^class_name "input_option"
              (input ^id %option_id ^type "checkbox" ^checked %selected) %option)))
            (set i (+ i 1))))
        (else
          (var select ($dom/render `(select ^id "input_answer" ^aria-label %prompt)))
          (for option in options ($dom/append select ($dom/render `(option ^value %option %option))))
          ($dom/append fields select)
          (if_not ($absent? request/default)
            (var choice : Str request/default) ($dom/set_input_value select choice)))))
      (elif (!= kind "confirm")
        (var answer ($dom/render `(textarea ^id "input_answer" ^rows "2" ^aria-label %prompt)))
        ($dom/append fields answer)
        (if_not ($absent? request/default)
          (var initial : Str request/default) ($dom/set_input_value answer initial)))
      (elif (! ($absent? request/default))
        (var suggested : Bool request/default)
        ($dom/append fields ($dom/render `(p ^class_name "muted"
          %(if suggested "Suggested answer: Yes" "Suggested answer: No"))))))
  (controls client))

(fn send_input_reply [client : Client, payload : Any] : Void
  (if_yes (|| client/answering (! client/connected)) (return))
  (set client/answering true)
  (for id in ["input_submit" "input_yes" "input_no" "input_cancel"]
    (var button ($dom/element id)) (set button/disabled true))
  ($session_storage/set "gene-harness/input-reply" ($json/stringify payload))
  (var session : Str payload/session)
  (api client "POST" $"/api/v1/sessions/${session}/input" payload
    (fn [code : Int, data : Any] : Void
      (set client/answering false)
      (for id in ["input_submit" "input_yes" "input_no" "input_cancel"]
        (var button ($dom/element id)) (set button/disabled false))
      (controls client)
      (if (&& (>= code 200) (< code 300))
        (then ($session_storage/remove "gene-harness/input-reply") (notice client ""))
        (elif (&& (>= code 400) (< code 500))
          ($session_storage/remove "gene-harness/input-reply") (show_error client data))
        (else
          (notice client "Your answer is saved. Reconnecting to confirm it…")
          (connect_socket client))))))

(fn answer_question [client : Client, value : Any, cancelled : Bool] : Void
  (if_yes (== client/input_id "") (return))
  (send_input_reply client {^session client/selected ^input_id client/input_id
    ^value value ^cancelled cancelled}))

(fn read_answer [client : Client] : Void
  (if_yes (== client/input_id "") (return))
  (var request : Any client/run/input)
  (var kind : Str request/kind)
  (var multi false)
  (if_yes (== kind "select") (set multi request/multi))
  (if (&& (== kind "select") multi)
    (then
      (var values : (List Str) [])
      (var options : (List Str) request/options)
      (var i 0)
      (for option in options
        (var box ($dom/element $"input_option_${i}"))
        (var checked : Bool box/checked)
        (if_yes checked (values .push option))
        (set i (+ i 1)))
      (answer_question client values false))
    (else (answer_question client ($dom/input_value ($dom/element "input_answer")) false))))

(fn render_sessions [client : Client] : Void
  ($dom/clear client/list)
  (var filter : Str (str/lower ($dom/input_value ($dom/element "session_filter"))))
  (for session in client/sessions
    (var title : Str session/title)
    (var id : Str session/id)
    (if_yes (|| (== filter "") (str/contains? (str/lower title) filter))
      (var cls (if (== id client/selected) "session selected" "session"))
      (var subtitle : Str "Conversation")
      (if_not ($absent? session/last_run)
        (set subtitle (run_label session/last_run)))
      (var button : EventTarget
        ($dom/render
          `(button ^type "button" ^class_name %cls
             ^on_click %(fn [event : Any] : Void (select_session client id))
             (span ^class_name "session_name" %title)
             (span ^class_name "session_meta" %subtitle))))
      (set button/title title)
      ($dom/append client/list button)))
  (if_yes (== ($size client/sessions) 0)
    ($dom/append client/list
      ($dom/render `(p ^class_name "sidebar_empty" "Your conversations will appear here.")))))

(fn expanded_block [client : Client, id : Str] : Bool
  (for previous in client/expanded (if_yes (== previous id) (return true)))
  false)

(fn toggle_block [client : Client, id : Str, opened : Bool] : Void
  (var kept : (List Str) [])
  (for previous in client/expanded (if_yes (!= previous id) (kept .push previous)))
  (if_yes opened (kept .push id))
  (set client/expanded kept))

(fn copy_text [client : Client, text : Str] : Void
  ($browser/copy text (fn [copied : Bool] : Void
    (notice client (if copied "Copied." "Select the text to copy it.")))))

(fn edit_prompt [client : Client, text : Str] : Void
  (if_yes (! ($absent? client/pending))
    (notice client "Resolve the pending submission before editing another prompt.") (return))
  ($dom/set_input_value client/prompt text)
  (remember_draft client)
  (render_commands client)
  ($dom/focus client/prompt))

(fn render_block [client : Client, target : EventTarget, block : Any] : Void
  (var id : Str block/id)
  (var generation client/generation)
  ($dom/append target
    (block_view block (not_durable block)
      (fn [text : Str] : Void (copy_text client text))
      (expanded_block client id)
      (fn [opened : Bool] : Void
        (if_yes (== generation client/generation) (toggle_block client id opened))))))

(fn render_run [client : Client, blocks : (List Any), run : Any] : Void
  (var target ($dom/render `(section ^class_name "run")))
  (var prompt "")
  (var i 0)
  (var generation client/generation)
  (while (< i ($size blocks))
    (var block : Any blocks/%i)
    (var role : Str block/role)
    (if_yes (== role "user") (set prompt block/text))
    (if (marker_block block) (then (set i (+ i 1)))
      (elif (step_block block)
        (var key (step_key block))
        (var step : (List Any) [])
        (while (< i ($size blocks))
          (var next : Any blocks/%i)
          (if (marker_block next) (then (set i (+ i 1)))
            (elif (&& (step_block next) (== (step_key next) key))
              (step .push next) (set i (+ i 1)))
            (else (break))))
        (var active false)
        (if_not ($absent? run)
          (var status : Str run/status)
          (set active (&& (! (terminal status)) (== i ($size blocks)))))
        ($dom/append target
          (step_view step (expanded_block client key) active
            (fn [text : Str] : Void (copy_text client text))
            (fn [id : Str] : Bool (expanded_block client id))
            (fn [id : Str, opened : Bool] : Void
              (if_yes (== generation client/generation) (toggle_block client id opened))))))
      (else (render_block client target block) (set i (+ i 1)))))
  (if_not ($absent? run)
    ($dom/append target
      (run_status_view run prompt (fn [text : Str] : Void (edit_prompt client text)))))
  ($dom/append client/transcript target))

(fn render_transcript [client : Client, ^prepend prepend : Bool = false] : Void
  (var old_top ($dom/scroll_top client/transcript))
  (var old_height ($dom/scroll_height client/transcript))
  (var follow (&& (! client/viewing_history)
    (|| client/autoscroll ($dom/near_end client/transcript 80.0))))
  # Keep expansion state only for retained blocks, across preview-to-durable
  # replacement and transcript refreshes. New model steps start collapsed.
  (var expanded : (List Str) [])
  (for id in client/expanded
    (var retained false)
    (for block in client/records
      (var block_id : Str block/id)
      (if_yes (|| (== block_id id) (== (step_key block) id)) (set retained true)))
    (for block in client/preview
      (var block_id : Str block/id)
      (if_yes (|| (== block_id id) (== (step_key block) id)) (set retained true)))
    (if_yes retained (expanded .push id)))
  (set client/expanded expanded)
  ($dom/clear client/transcript)
  (if_yes client/has_older
    ($dom/append client/transcript
      ($dom/render
        `(button ^type "button" ^class_name "older_messages" ^disabled %client/loading_older
           ^on_click %(fn [event : Any] : Void (load_older client))
           %(if client/loading_older "Loading…" "Load earlier messages")))))
  (if (&& (== ($size client/records) 0) (== ($size client/preview) 0))
    ($dom/append client/transcript
      ($dom/render
        `(div ^class_name "empty_state"
           (h2 "What would you like to work on?")
           (p "Start with an idea, a question, or a task.")
           (div ^class_name "suggestions"
             (button ^type "button"
               ^on_click %(fn [event : Any] : Void
                 ($dom/set_input_value client/prompt "What can you help me with?")
                 ($dom/focus client/prompt)) "Explore ideas"
               (span ^class_name "suggestion_symbol" ^aria-hidden "true" "→"))
             (button ^type "button"
               ^on_click %(fn [event : Any] : Void
                 ($dom/set_input_value client/prompt "/help")
                 ($dom/focus client/prompt)) "Browse commands"
               (span ^class_name "suggestion_symbol" ^aria-hidden "true" "/")))))))
  (var visible : (List Any) client/records)
  # Durable records lead; append previews only when no durable version exists.
  (for block in client/preview
    (var found false)
    (for record in client/records (if_yes (== record/id block/id) (set found true)))
    (if_not found (set visible (merge_blocks visible [block]))))
  (var i 0)
  (var current_shown false)
  (while (< i ($size visible))
    (var first : Any visible/%i)
    (var id : Str first/run_id)
    (var blocks : (List Any) [])
    (while (< i ($size visible))
      (var block : Any visible/%i)
      (var block_run : Str block/run_id)
      (if_yes (!= block_run id) (break))
      (blocks .push block) (set i (+ i 1)))
    (var run : Any nil)
    (for receipt in client/runs
      (var receipt_id : Str receipt/id)
      (if_yes (== receipt_id id) (set run receipt)))
    (if_not ($absent? client/run)
      (var current_id : Str client/run/id)
      (if_yes (== current_id id) (set run client/run) (set current_shown true)))
    (render_run client blocks run))
  (if_yes (&& (! ($absent? client/run)) (! current_shown))
    (var status : Str client/run/status)
    (if_not (terminal status) (render_run client [] client/run)))
  (if follow
    (then ($dom/scroll_end client/transcript)
      (set_hidden "new_output" true))
    (else
      ($dom/set_scroll_top client/transcript
        (if prepend (+ old_top (- ($dom/scroll_height client/transcript) old_height)) old_top))
      ($dom/set_text ($dom/element "new_output")
        (if client/viewing_history "Return to latest ↓" "New output ↓"))
      (set_hidden "new_output" false))))

(fn update_controls [client : Client] : Void
  (render_input client)
  (set client/busy (|| client/server_busy (!= client/awaiting "")))
  (controls client))

(fn acknowledge_run [client : Client, run : Any, session : Str] : Void
  (if_yes ($absent? run) (return))
  (var request_id (string_or run/request_id ""))
  (if_yes (&& (== session client/awaiting_session) (== request_id client/awaiting))
    (set client/awaiting "") (set client/awaiting_session "")))

(fn apply_status [client : Client, data : Any] : Void
  (var unchanged (== ($json/stringify client/status) ($json/stringify data)))
  (set client/status data)
  (set client/server_busy data/busy)
  (update_controls client)
  (if_yes unchanged (return))
  (var drawer ($dom/element "status_content"))
  ($dom/clear drawer)
  (var profile : Str data/profile)
  ($dom/append drawer ($dom/render `(p "Profile: " %profile)))
  (var model : Str data/model)
  (var provider : Str data/provider)
  ($dom/append drawer ($dom/render `(p "Model: " %model)))
  ($dom/append drawer ($dom/render `(p "Provider: " %provider)))
  (var plugins : (List Any) data/plugins)
  (for plugin in plugins
    (var id : Str plugin/id)
    (var state : Str plugin/state)
    ($dom/append drawer
      ($dom/render `(div ^class_name "plugin_status" (span %id) (span %state)))))
  (render_commands client))

(fn render_commands [client : Client] : Void
  (var picker ($dom/element "commands"))
  ($dom/clear picker)
  (var text ($dom/input_value client/prompt))
  (var parts : (List Str) (str/split text " "))
  (var show (&& (str/starts_with? text "/") (== ($size parts) 1)
                (! (str/contains? text "\n")) (! (str/contains? text "\t"))))
  (set picker/hidden (! show))
  (if_yes (|| (! show) ($absent? client/status)) (return))
  (var commands : (List Any) client/status/commands)
  (var matched false)
  (for command in commands
    (var name : Str command/name)
    (var doc : Str command/doc)
    (if_yes (str/starts_with? ($ "/" name) (str/lower text))
      (set matched true)
      ($dom/append picker
        ($dom/render
          `(button ^type "button" ^class_name "command"
             ^on_click %(fn [event : Any] : Void
               ($dom/set_input_value client/prompt $"/${name} ")
               (remember_draft client)
               ($dom/focus client/prompt)
               (set picker/hidden true))
             (strong %($ "/" name)) (span %doc))))))
  (if_not matched
    ($dom/append picker ($dom/render `(p ^class_name "muted"
      %(if (== ($size commands) 0) "Use /help to load available commands." "No matching commands. Use /help for the full list."))))))

(fn upsert_session [client : Client, session : Any] : Void
  (set client/sessions (merge_blocks client/sessions [session]))
  (render_sessions client))

(fn sessions_page [client : Client, after : Str] : Void
  (var epoch client/socket_epoch)
  (api client "GET" $"/api/v1/sessions?after=${after}" nil
    (fn [code : Int, data : Any] : Void
      (if_yes (!= epoch client/socket_epoch) (return))
      (if (== code 200)
        (then
          (var page : (List Any) data/sessions)
          # Live pushes may already hold a newer version of an existing row.
          (var additions : (List Any) [])
          (for entry in page
            (var found false)
            (for existing in client/sessions
              (if_yes (== entry/id existing/id) (set found true)))
            (if_not found (additions .push entry)))
          (set client/sessions (merge_blocks client/sessions additions))
          (render_sessions client)
          (var next (string_or data/next ""))
          (if_yes (!= next "") (sessions_page client next)))
        (else (show_error client data))))))

(fn load_older [client : Client] : Void
  (if_yes (|| client/loading_older (== ($size client/records) 0)) (return))
  (set client/loading_older true)
  (var generation client/generation)
  (var first : Any client/records/0)
  (var before : Str first/seq)
  (api client "GET" $"/api/v1/sessions/${client/selected}/snapshot?before=${before}" nil
    (fn [code : Int, data : Any] : Void
      (if_yes (!= generation client/generation) (return))
      (set client/loading_older false)
      (if (== code 200)
        (then
          (var older : (List Any) data/records)
          (var empty_runs : (List Any) [])
          (var raw_runs : Any (?? data/runs empty_runs))
          (var runs : (List Any) raw_runs)
          (set client/runs (merge_blocks client/runs runs))
          (set client/records (bounded_blocks (merge_blocks older client/records) false))
          (set client/has_older data/has_older)
          (set client/autoscroll false)
          (set client/viewing_history true)
          (set client/preview [])
          (render_transcript client ^prepend true))
        (else (show_error client data))))))

(fn apply_snapshot [client : Client, data : Any] : Void
  (if_not client/viewing_history
    (var records : (List Any) data/records)
    (set client/records (bounded_blocks records true))
    (set client/preview data/preview)
    (set client/has_older data/has_older))
  (set client/run data/run)
  (var empty_runs : (List Any) [])
  (var raw_runs : Any (?? data/runs empty_runs))
  (var runs : (List Any) raw_runs)
  (set client/runs (merge_blocks client/runs runs))
  (acknowledge_run client data/run client/selected)
  (set client/cursor data/cursor)
  (set client/next_seq data/next_submission_seq)
  (set client/session_revision data/session/revision)
  (var title : Str data/session/title)
  ($dom/set_text client/title title)
  (render_transcript client)
  (update_controls client))

(fn apply_records [client : Client, incoming : (List Any), cursor : Str] : Void
  (if_not client/viewing_history
    (var merged (merge_blocks client/records incoming))
    (if_yes (> ($size merged) 600) (set client/has_older true))
    (set client/records (bounded_blocks merged true))
    (var preview : (List Any) [])
    (for block in client/preview
      (var found false)
      (for record in incoming (if_yes (== block/id record/id) (set found true)))
      (if_not found (preview .push block)))
    (set client/preview preview))
  (if_yes (!= cursor "") (set client/cursor cursor))
  (render_transcript client))

(fn apply_record [client : Client, record : Any] : Void
  (if_not client/viewing_history
    (var found false)
    (for saved in client/records (if_yes (== saved/id record/id) (set found true)))
    (if_not found (set client/preview (bounded_blocks (merge_blocks client/preview [record]) true))))
  (render_transcript client))

(fn apply_run [client : Client, session : Str, data : Any] : Void
  (upsert_session client data/session)
  (acknowledge_run client data/session/last_run session)
  (if_yes (== session client/selected)
    (set client/run data/session/last_run)
    (if_not ($absent? client/run)
      (set client/runs (bounded_blocks (merge_blocks client/runs [client/run]) true)))
    (set client/next_seq data/next_submission_seq)
    (set client/session_revision data/session/revision)
    (var title : Str data/session/title)
    ($dom/set_text client/title title)
    (if_not ($absent? client/run)
      (var status : Str client/run/status)
      (if_yes (terminal status) (set client/preview [])))
    (render_transcript client))
  (apply_status client data/status))

(fn select_session [client : Client, id : Str] : Void
  (if_yes client/sending (notice client "Resolving your submission…") (return))
  (remember_draft client)
  (set client/selected id)
  (set client/queued_prompt "")
  (set client/cursor "")
  (set client/next_seq "1")
  (set client/records [])
  (set client/preview [])
  (set client/expanded [])
  (set client/run nil)
  (set client/runs [])
  (set client/has_older false)
  (set client/loading_older false)
  (set client/viewing_history false)
  (set client/autoscroll true)
  (set client/generation (+ client/generation 1))
  ($dom/set_input_value client/prompt (?? ($session_storage/get (draft_key id)) ""))
  ($browser/replace_url $"/?session=${($url/encode_component id)}")
  ($dom/set_class client/root "menu_open" false)
  (notice client "")
  (render_sessions client)
  (render_transcript client)
  (connect_socket client))

(fn create [client : Client] : Void
  (var draft (if (== client/selected "") ($dom/input_value client/prompt)
    (?? ($session_storage/get (draft_key "new")) "")))
  (api client "POST" "/api/v1/sessions" {^title "New conversation"}
    (fn [code : Int, data : Any] : Void
      (if (== code 201)
        (then
          (var id : Str data/id)
          (select_session client id)
          (if_yes (!= draft "")
            ($dom/set_input_value client/prompt draft)
            (remember_draft client))
          ($session_storage/remove (draft_key "new")))
        (else (show_error client data))))))

(fn send_pending [client : Client] : Void
  (if_yes (|| ($absent? client/pending) client/sending (! client/connected)) (return))
  (var pending : Any client/pending)
  (var session : Str pending/session)
  (var request_id : Str pending/request_id)
  (var already_seen false)
  (if_not ($absent? client/run)
    (set already_seen (&& (== session client/selected)
      (== (string_or client/run/request_id "") request_id))))
  (if_not already_seen
    (set client/awaiting request_id) (set client/awaiting_session session))
  (set client/sending true)
  (update_controls client)
  (api client "POST" $"/api/v1/sessions/${session}/runs" pending
    (fn [code : Int, data : Any] : Void
      (set client/sending false)
      (if (== code 202)
        (then
          # POST acknowledges admission. A newer WebSocket completion must
          # never be overwritten by this potentially late accepted response.
          (var status : Str data/status)
          (if_yes (terminal status) (acknowledge_run client data session))
          ($session_storage/remove "gene-harness/pending")
          (var submitted : Str pending/text)
          (if (== session client/selected)
            (then
              (if (== ($dom/input_value client/prompt) submitted)
                (then ($dom/set_input_value client/prompt "")
                  ($session_storage/remove (draft_key session)))
                (else (remember_draft client))))
            (else
              (if_yes (== (?? ($session_storage/get (draft_key session)) "") submitted)
                ($session_storage/remove (draft_key session)))))
          (set client/pending nil)
          (set_hidden "commands" true)
          (notice client ""))
        (else
          (if_yes (&& (== client/awaiting_session session) (== client/awaiting request_id))
            (set client/awaiting "") (set client/awaiting_session ""))
          (var error_code (string_or data/code ""))
          (if_yes (|| (== code 400) (== code 404) (== code 409) (== code 410) (== code 413)
                      (&& (== code 503)
                        (|| (== error_code "recovery_required") (== error_code "unavailable"))))
            ($session_storage/remove "gene-harness/pending")
            (set client/pending nil))
          (show_error client data)
          (if (== code 401)
            (then
              (set client/ready false)
              (set client/connected false)
              (set_hidden "auth_notice" false))
            (elif ($absent? client/pending) (connect_socket client))
            (else
              # Unknown outcomes keep their idempotency key. Reconnect checks
              # authentication and backs off before resolving the submission.
              (set client/connected false)
              (if_not ($absent? client/socket)
                (var socket : EventTarget client/socket)
                ($ws/close socket))))))
      (set_hidden "resolve_submission" ($absent? client/pending))
      (update_controls client))))

(fn stage_submission [client : Client, text : Str] : Void
  (set client/pending {^session client/selected ^request_id ($browser/request_id)
    ^submission_seq client/next_seq ^text text})
  (if_not ($session_storage/set "gene-harness/pending" ($json/stringify client/pending))
    (set client/pending nil)
    (notice client "Browser storage is required to safely recover a submission. Enable it and try again.")
    (return))
  (send_pending client))

(fn send [client : Client] : Void
  (if_yes (!= client/input_id "")
    (notice client "Answer or cancel the pending question first.") (return))
  (if_yes (|| (! client/ready) (! client/connected) client/sending client/busy) (return))
  (if_yes (! ($absent? client/pending)) (send_pending client) (return))
  (var text ($dom/input_value client/prompt))
  (if_yes (== (str/trim text) "") (return))
  (remember_draft client)
  (if_yes (== client/selected "")
    (set client/sending true)
    (update_controls client)
    (api client "POST" "/api/v1/sessions" {^title "New conversation"}
      (fn [code : Int, data : Any] : Void
        (set client/sending false)
        (if (== code 201)
          (then
            (var id : Str data/id)
            (select_session client id)
            (set client/queued_prompt text)
            ($dom/set_input_value client/prompt text)
            (remember_draft client)
            ($session_storage/remove (draft_key "new")))
          (else (show_error client data)))
        (update_controls client)))
    (return))
  (stage_submission client text))

(fn stop [client : Client] : Void
  (if_yes ($absent? client/status) (return))
  (var active_session (string_or client/status/session ""))
  (if_yes (!= active_session client/selected)
    (select_session client active_session)
    (notice client "The active conversation is shown. Press Stop to stop it.")
    (return))
  (if_yes ($absent? client/run) (return))
  (var id : Str client/run/id)
  (api client "POST" $"/api/v1/sessions/${client/selected}/runs/${id}/cancel" {}
    (fn [code : Int, data : Any] : Void
      (if (== code 200)
        (then (notice client "Stop requested."))
        (else (show_error client data))))))

(fn socket_message [client : Client, text : Str] : Void
  (try
    (var message : Any ($json/parse text))
    (var version : Int message/protocol)
    (if_yes (!= version protocol_version)
      (set client/ready false)
      (set client/connected false)
      (update_controls client)
      (notice client "Reload the page to use the current server version.")
      (return))
    (var sequence_text : Str message/sequence)
    (var sequence : Int ($json/parse sequence_text))
    (if_yes (!= sequence (+ client/message_sequence 1))
      (connect_socket client)
      (return))
    (set client/message_sequence sequence)
    (set client/epoch message/epoch)
    (var kind : Str message/type)
    (var session : Str message/session)
    (var data : Any message/data)
    (if (== kind "status") (then (apply_status client data))
      (elif (== kind "sessions")
        (set client/sessions data/sessions)
        (render_sessions client)
        (var next (string_or data/next ""))
        (if_yes (!= next "") (sessions_page client next)))
      (elif (== kind "session")
        (upsert_session client data)
        (if_yes (== session client/selected)
          (set client/session_revision data/revision)
          (var title : Str data/title)
          ($dom/set_text client/title title)))
      (elif (== kind "snapshot")
        (if_yes (== session client/selected) (apply_snapshot client data)))
      (elif (== kind "record")
        (if_yes (== session client/selected) (apply_record client data)))
      (elif (== kind "records")
        (if_yes (== session client/selected)
          (var records : (List Any) data/records)
          (var cursor : Str data/cursor)
          (apply_records client records cursor)))
      (elif (== kind "run") (apply_run client session data))
      (elif (== kind "error") (show_error client data))
      (elif (== kind "resync")
        (var socket : EventTarget client/socket)
        ($ws/close socket))
      (elif (== kind "ready")
        (set client/connected true)
        (var current_notice ($dom/text client/notice))
        (if_yes (|| (== current_notice "Reconnecting… Your draft is saved.")
                    (== current_notice "Refreshing the live connection…"))
          (notice client ""))
        (update_controls client)
        (var saved (?? ($session_storage/get "gene-harness/input-reply") ""))
        (if_yes (!= saved "")
          (var payload : Any ($json/parse saved))
          (var reply_session : Str payload/session)
          (var input_id : Str payload/input_id)
          (if_yes (== reply_session client/selected)
            (if (== input_id client/input_id)
              (send_input_reply client payload)
              ($session_storage/remove "gene-harness/input-reply"))))
        (if_not ($absent? client/pending) (send_pending client))
        (if_yes (!= client/queued_prompt "")
          (var queued client/queued_prompt)
          (set client/queued_prompt "")
          (stage_submission client queued))))
  catch Any
    (notice client "Refreshing the live connection…")
    (connect_socket client)))

(fn reconnect_socket [client : Client, epoch : Int] : Void
  ($time/after 2500.0 (fn [] : Void
    (if_yes (|| (! client/ready) (!= epoch client/socket_epoch)) (return))
    # Only disconnection recovery uses an HTTP status check, including cookie
    # expiry. There is no timer polling while the WebSocket is connected.
    (api client "GET" "/api/v1/status" nil
      (fn [code : Int, data : Any] : Void
        (if_yes (!= epoch client/socket_epoch) (return))
        (if (== code 200)
          (then (set client/csrf data/csrf) (connect_socket client))
          (elif (== code 401)
            (set client/ready false)
            (set_hidden "auth_notice" false)
            (show_error client data)
            (update_controls client))
          (else (reconnect_socket client epoch))))))))

(fn connect_socket [client : Client] : Void
  (if_yes (! client/ready) (return))
  (set client/socket_epoch (+ client/socket_epoch 1))
  (var epoch client/socket_epoch)
  (set client/connected false)
  (set client/message_sequence 0)
  (update_controls client)
  (if_not ($absent? client/socket)
    (var old : EventTarget client/socket)
    ($ws/close old))
  (var origin ($browser/origin))
  (var parts : (List Str) (str/split origin "://"))
  (var scheme (if (== parts/0 "https") "wss" "ws"))
  (var socket ($ws/connect $"${scheme}://${parts/1}/api/v1/events?session=${($url/encode_component client/selected)}"))
  (set client/socket socket)
  ($time/after 10000.0 (fn [] : Void
    (if_yes (&& client/ready (== epoch client/socket_epoch) (! client/connected))
      ($ws/close socket))))
  ($ws/on_text socket (fn [text : Str] : Void
    (if_yes (== epoch client/socket_epoch) (socket_message client text))))
  ($ws/on_close socket (fn [] : Void
    (if_yes (!= epoch client/socket_epoch) (return))
    (set client/connected false)
    (update_controls client)
    (if_yes (! client/ready) (return))
    (notice client "Reconnecting… Your draft is saved.")
    (reconnect_socket client epoch))))

(fn authenticated [client : Client, data : Any] : Void
  (set client/csrf data/csrf)
  (set client/ready true)
  (set_hidden "auth_notice" true)
  (var saved : Str (?? ($session_storage/get "gene-harness/pending") ""))
  (if_yes (!= saved "")
    (set client/pending (try ($json/parse saved) catch Any nil)))
  (if_not ($absent? client/pending)
    (var id : Str client/pending/session)
    (set client/selected id))
  # A direct conversation URL needs the same draft initialization as navigation.
  (if_yes (== client/generation 0)
    (set client/generation 1)
    (var key (draft_key (if (== client/selected "") "new" client/selected)))
    ($dom/set_input_value client/prompt (?? ($session_storage/get key) "")))
  (connect_socket client))

(fn authenticate [client : Client] : Void
  (var token (query_value ($browser/hash) "token"))
  ($browser/replace_url (if (== client/selected "") "/" $"/?session=${client/selected}"))
  (if (!= token "")
    (api client "POST" "/api/v1/auth/exchange" {^token token}
      (fn [code : Int, data : Any] : Void
        (if (== code 200)
          (then (authenticated client data))
          (else (show_error client data) (set_hidden "auth_notice" false)))))
    (api client "GET" "/api/v1/status" nil
      (fn [code : Int, data : Any] : Void
        (if (== code 200)
          (then (authenticated client data))
          (else (show_error client data) (set_hidden "auth_notice" false)))))))

(fn main [root : EventTarget] : Void
  (var client (Client ^selected (query_value ($browser/search) "session")
    ^csrf "" ^cursor "" ^next_seq "1" ^epoch "" ^ready false ^sending false
    ^connected false ^server_busy false ^awaiting "" ^awaiting_session "" ^queued_prompt "" ^message_sequence 0
    ^busy false ^autoscroll true ^generation 0
    ^has_older false ^loading_older false ^socket_epoch 0 ^viewing_history false
    ^records [] ^preview [] ^sessions [] ^expanded [] ^runs [] ^input_id "" ^answering false ^run nil ^pending nil ^status nil
    ^socket nil ^session_revision "1" ^root root ^list ($dom/element "sessions")
    ^transcript ($dom/element "transcript") ^prompt ($dom/element "prompt")
    ^notice ($dom/element "notice") ^title ($dom/element "conversation_title")))
  ($dom/add_event_listener ($dom/element "composer") "submit"
    (fn [event : Any] : Void ($dom/prevent_default event) (send client)))
  ($dom/add_event_listener ($dom/element "input_form") "submit"
    (fn [event : Any] : Void ($dom/prevent_default event) (read_answer client)))
  ($dom/add_event_listener ($dom/element "input_yes") "click"
    (fn [event : Any] : Void (answer_question client true false)))
  ($dom/add_event_listener ($dom/element "input_no") "click"
    (fn [event : Any] : Void (answer_question client false false)))
  ($dom/add_event_listener ($dom/element "input_cancel") "click"
    (fn [event : Any] : Void (answer_question client nil true)))
  ($dom/add_event_listener client/prompt "keydown"
    (fn [event : Any] : Void
      (if_yes (== ($event/key event) "Escape") (set_hidden "commands" true))
      (if_yes (&& (== ($event/key event) "Enter") (! ($event/shift_key event))
                  (! ($event/is_composing event)))
        ($dom/prevent_default event)
        (send client))))
  ($dom/add_event_listener client/prompt "input"
    (fn [event : Any] : Void
      (remember_draft client)
      (render_commands client)))
  ($dom/add_event_listener ($dom/element "create_session") "click"
    (fn [event : Any] : Void (create client)))
  ($dom/add_event_listener ($dom/element "session_filter") "input"
    (fn [event : Any] : Void (render_sessions client)))
  ($dom/add_event_listener ($dom/element "stop") "click"
    (fn [event : Any] : Void (stop client)))
  ($dom/add_event_listener ($dom/element "resolve_submission") "click"
    (fn [event : Any] : Void (send_pending client)))
  ($dom/add_event_listener ($dom/element "new_output") "click"
    (fn [event : Any] : Void
      (if client/viewing_history
        (select_session client client/selected)
        (do ($dom/scroll_end client/transcript) (set_hidden "new_output" true)))))
  ($dom/add_event_listener client/transcript "scroll"
    (fn [event : Any] : Void
      (set client/autoscroll ($dom/near_end client/transcript 80.0))))
  ($dom/add_event_listener ($dom/element "menu") "click"
    (fn [event : Any] : Void ($dom/set_class root "menu_open" true)))
  ($dom/add_event_listener ($dom/element "close_menu") "click"
    (fn [event : Any] : Void ($dom/set_class root "menu_open" false)))
  ($dom/add_event_listener ($dom/element "status_button") "click"
    (fn [event : Any] : Void
      (var drawer ($dom/element "status_drawer"))
      (var hidden : Bool drawer/hidden)
      (set drawer/hidden (! hidden))))
  ($dom/add_event_listener ($dom/element "close_status") "click"
    (fn [event : Any] : Void
      (set_hidden "status_drawer" true)
      ($dom/focus ($dom/element "status_button"))))
  ($dom/add_event_listener ($dom/element "rename_session") "click"
    (fn [event : Any] : Void
      (set_hidden "rename_form" false)
      ($dom/set_input_value ($dom/element "rename_title") ($dom/text client/title))
      ($dom/focus ($dom/element "rename_title"))))
  ($dom/add_event_listener ($dom/element "rename_form") "submit"
    (fn [event : Any] : Void
      ($dom/prevent_default event)
      (api client "PATCH" $"/api/v1/sessions/${client/selected}"
        {^title ($dom/input_value ($dom/element "rename_title")) ^revision client/session_revision}
        (fn [code : Int, data : Any] : Void
          (if (== code 200)
            (then (set_hidden "rename_form" true))
            (else (show_error client data)))))))
  ($dom/add_event_listener ($dom/window) "focus"
    (fn [event : Any] : Void
      (if_yes (&& client/ready (! client/sending)) (connect_socket client))))
  ($dom/add_event_listener ($dom/window) "hashchange"
    (fn [event : Any] : Void
      (if_yes (!= (query_value ($browser/hash) "token") "") (authenticate client))))
  (render_transcript client)
  (if_yes (== client/selected "")
    ($dom/set_input_value client/prompt (?? ($session_storage/get (draft_key "new")) "")))
  (controls client)
  (authenticate client))
