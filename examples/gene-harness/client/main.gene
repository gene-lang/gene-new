(fn ensure_feature_host [client : Client] : Nil
  (if ($present? client/services) (return))
  (set client/services (FeatureHost
    ^api (fn [method : Str, path : Str, payload : Any, done : (Fn [Int Any] Nil)] : Nil (api client method path payload done))
    ^error (fn [data : Any, session : Str] : Nil (show_error client data ^session session))
    ^feedback (fn [key : Str, message : Str, sticky : Bool] : Nil (notice client message ^key key ^sticky sticky))
    ^controls (fn [] : Nil (update_controls client))
    ^select (fn [id : Str] : Nil (select_session client id))
    ^refresh (fn [] : Nil (refresh_sessions client))
    ^tab (fn [id : Str] : Any (session_tab client id))
    ^upsert (fn [data : Any] : Nil (upsert_session client data))
    ^remember (fn [] : Nil (remember_draft client))
    ^apply_run (fn [session : Str, data : Any] : Nil (apply_run client session data))
    ^emit (fn [kind : Str, session : Str, data : Any] : Nil (browser_event client kind session data))
    ^render (fn [] : Nil (render_transcript client))))
  (initialize_delegation client))

(fn render_session_title [client : Client, text : Str, shared : Any] : Nil
  (ensure_feature_host client) (slack_title client text shared))
(fn resolve_slack_author [client : Client, source : Any, target : EventTarget] : Nil
  (ensure_feature_host client) (slack_author client source target))
(fn add_session_to_slack [client : Client] : Nil (ensure_feature_host client) (slack_share client))
(fn voice_pending? [client : Client] : Bool (ensure_feature_host client) (pending_voice client))
(fn voice_replay_handler [client : Client] : Any (ensure_feature_host client) (replay_voice client))
(fn voice_rounds [client : Client] : RoundClient (ensure_feature_host client) (rounds_voice client))
(fn voice_review_key [client : Client, session : Str] : Str (ensure_feature_host client) (review_key_voice client session))
(fn reviewed_voice_input [client : Client, session : Str, value : Str] : Any (ensure_feature_host client) (input_voice client session value))
(fn voice_submit [client : Client, session : Str, value : Str, input : Any, done : (Fn [Int Any] Nil)] : Nil
  (ensure_feature_host client) (submit_voice client session value input done))

(fn live_store [client : Client] : LiveOutput
  (if ($absent? client/live_output) (set client/live_output (create_output)))
  (var raw : Any client/live_output)
  (var store : LiveOutput raw) store)

(fn refresh_live_output [client : Client] : Nil
  (var store (live_store client))
  (for mount in store/mounts
    (var entry : Any (output_entry store (string_or mount/key "")))
    (var command : Any mount/command)
    (var pre : EventTarget mount/pre)
    (var value (if ($absent? command) (output_text entry) else (command_output_text entry command)))
    (if (!= value (string_or mount/text ""))
      ($dom/set_text pre value)
      (set mount/text value))
    (if ($present? command) (continue))
    (var panel : EventTarget mount/panel) (var summary : EventTarget mount/summary)
    (if (! (same? entry mount/entry))
      (set panel/open (output_open entry (launcher_flag mount/default_open)))
      (set mount/entry entry))
    (set panel/hidden ($absent? entry))
    (var label (if (launcher_flag entry/late) "Output · live · Late output" else "Output · live"))
    (if (!= label (string_or mount/label ""))
      ($dom/set_text summary label)
      (set mount/label label))))

(fn schedule_live_output [client : Client] : Nil
  (var store (live_store client))
  (if store/scheduled (return))
  (set store/scheduled true)
  ($time/after 40.0 (fn [] : Nil
    (set store/scheduled false)
    (refresh_live_output client)
    (var notify (&& (!= store/notify_session "") (== store/notify_session client/selected)))
    (set store/notify_session "")
    (if notify
      (if (&& (! client/viewing_history) client/autoscroll)
        ($dom/scroll_end client/transcript)
      else
        ($dom/set_text ($dom/element "new_output_label") "New output")
        (set_hidden "new_output" false))))))

(fn live_console [client : Client, session : Str, data : Any] : Nil
  (var store (live_store client))
  (if (receive_output store session data)
    (if (== session client/selected) (set store/notify_session session))
    (schedule_live_output client)))

(fn begin_output_render [client : Client] : Nil
  (var store (live_store client))
  (for mount in store/mounts
    (if ($present? mount/command) (continue))
    (var entry : Any (output_entry store (string_or mount/key "")))
    (if (&& ($present? entry) (same? entry mount/entry))
      (var panel : EventTarget mount/panel)
      (set entry/open panel/open)))
  (set store/mounts []))

(fn live_output_view [client : Client, key : Str, ^default_open default_open : Bool = false,
  ^command command : Any = nil] : EventTarget
  (var store (live_store client))
  (var entry : Any (output_entry store key))
  (if ($present? command)
    (var combined_pre ($dom/render `(pre ^class_name "command_output")))
    (var value (command_output_text entry command))
    ($dom/set_text combined_pre value)
    (store/mounts .push {^key key ^pre combined_pre ^text value ^command command})
    (return combined_pre))
  (var pre ($dom/render `(pre)))
  (var label "Output · live")
  (var summary ($dom/render `(summary %label)))
  (var panel ($dom/render `(details ^class_name "execution live_output"
    ^open %(output_open entry default_open) ^hidden %($absent? entry)
    ^on_toggle %(fn [event : Any] : Nil
      (var current : Any (output_entry store key))
      (if ($present? current) (set current/open event/current_target/open))))))
  ($dom/append panel summary)
  ($dom/append panel ($dom/render `(button ^type "button" ^class_name "copy"
    ^on_click %(fn [event : Any] : Nil
      (copy_text client (output_text (output_entry store key)))) "Copy")))
  ($dom/append panel pre)
  (store/mounts .push {^key key ^panel panel ^pre pre ^summary summary ^text "" ^label label ^entry entry
    ^default_open default_open ^command command})
  panel)

(fn client_page_id [client : Client] : Str
  (if ($absent? client/page_id) (set client/page_id ($browser/request_id)))
  (string_or client/page_id ""))

(fn client_events [client : Client] : FeatureEvents
  (if ($absent? client/feature_events) (set client/feature_events (create_feature_events)))
  (var raw : Any client/feature_events)
  (var events : FeatureEvents raw)
  events)

(fn browser_event [client : Client, kind : Str, session : Str, data : Any] : Nil
  (emit_feature_event (client_events client) kind session data))

(fn subscribe_browser [client : Client, owner : Str, callback : (Fn [Str Str Any] Nil)] : (Fn [] Nil)
  (var dispose (subscribe_feature (client_events client) callback ^owner owner))
  (if client/ready (render_transcript client))
  (fn [] : Nil
    (dispose)
    (if client/ready (render_transcript client))))

(fn creation_outcome [client : Client, code : Int] : Nil
  (if (|| (== code 0) (>= code 500)) (set client/creation_unknown true))
  (if (== code 201) (set client/creation_unknown false))
  (var unknown (launcher_flag client/creation_unknown))
  (set_hidden "session_creation_recovery" (! unknown))
  (notice ^key "creation-recovery" ^sticky unknown client
    (if unknown "Conversation creation is unknown. Inspect your conversations, then acknowledge it in the host controls before creating another." else "")))

(fn acknowledge_creation [client : Client] : Nil
  (if client/sending (return))
  (set client/creation_unknown false)
  (set_hidden "session_creation_recovery" true)
  (var recovery ($dom/element "session_creation_recovery"))
  (set recovery/open false)
  (notice ^key "creation-recovery" client "Creation uncertainty acknowledged after inspection. No creation was replayed."))

(fn request_session [client : Client, title : Str, done : (Fn [Int Any] Nil)] : Nil
  (if client/sending
    (done 409 {^^not_sent ^message "Wait for the current submission to resolve."})
    (return))
  (if (launcher_flag client/creation_unknown)
    (done
      409
      {
        ^^not_sent
        ^message "Inspect your conversations and acknowledge the unresolved creation in the host controls first."})
    (return))
  (set client/sending true) (update_controls client)
  (api client "POST" $"${(api_root)}/sessions" {^title title}
    (fn [code : Int, data : Any] : Nil
      (set client/sending false)
      (creation_outcome client code)
      (if (== code 201) (transfer_model_draft client (string_or data/id "")))
      (update_controls client)
      (done code data))))

(fn launcher_command [client : Client, session : Str, text : Str, expected : Any,
                      done : (Fn [Int Any] Nil)] : Nil
  (if (|| (! client/ready) client/sending)
    (done 409 {^message "Wait for the current submission to resolve."})
    (return))
  (if (== session "")
    (var draft ($dom/input_value client/prompt))
    (request_session
      client
      "Plugin tools"
      (fn [code : Int, data : Any] : Nil
        (if (== code 201)
          (var target : Str data/id)
          (select_session client target)
          ($dom/set_input_value client/prompt draft)
          (remember_draft client)
          (launcher_command client target text expected done)
        else
          (done code data))))
    (return))
  (set client/sending true) (update_controls client)
  (var commands : CommandClient client/command_client)
  (dispatch_command commands session text expected
    (fn [code : Int, data : Any] : Nil
      (set client/sending false) (update_controls client)
      (done code data)
      (if (== code 202) ($dom/focus client/prompt)))))

(fn launcher_navigate [client : Client, item : Any, done : (Fn [Int Any] Nil)] : Nil
  (if client/sending
    (done 409 {^message "Resolving your submission…"})
    (return))
  (var kind (string_or item/kind ""))
  (var ui : UiClient client/ui)
  (if (== kind "view")
    (if (navigate ui (string_or item/view ""))
      (done 200 {})
      ($dom/focus ($dom/element "ui_view_picker"))
    else
      (done 409 {^message "This view is unavailable."}))
    (return))
  (if (== kind "conversation")
    (var target (string_or item/session ""))
    (api
      client
      "GET"
      $"${(api_root)}/sessions/${target}/snapshot"
      nil
      (fn [code : Int, data : Any] : Nil
        (if (|| (!= code 200) client/sending)
          (done 409 {^message "This conversation is unavailable or a submission is resolving."})
          (return))
        (select_session ^snapshot data client target)
        (navigate ui "harness")
        (done 200 data)
        ($dom/focus client/prompt)))
    (return))
  (if (== (string_or item/action "") "attention")
    (done 200 {})
    (var center : NotificationCenter client/center)
    (toggle_center center true)
    (return))
  (var draft (if (== client/selected "") ($dom/input_value client/prompt)
    else (?? (storage_get (draft_key "new")) "")))
  (request_session client "New conversation"
    (fn [code : Int, data : Any] : Nil
      (if (== code 201)
        (var target : Str data/id)
        (var attachments : MediaComposer client/media)
        (media_move attachments "" target)
        (select_session client target)
        (navigate ui "harness")
        (if (!= draft "")
          ($dom/set_input_value client/prompt draft)
          (remember_draft client))
        (storage_remove (draft_key "new"))
        (done code data)
        ($dom/focus client/prompt)
      else
        (done code data)))))

(fn view_state_save [client : Client, changes : Any] : Nil
  # Browser-owned views keep selection and display preferences in the same
  # scalar view state rendered views use, so they survive a view switch.
  (if ($absent? client/ui) (return))
  (var ui : UiClient client/ui)
  (if ($absent? ui/descriptor) (return))
  (var declared : PropMap (if ($absent? ui/descriptor/view_state) {} else ui/descriptor/view_state))
  (var entries : PropMap (if ($absent? changes) {} else changes))
  (map_for [raw_key value] in entries
    (var key ($to_str raw_key))
    (if (&& ($present? declared/%key) ($leaf? value))
      (set ui/state/%key value)))
  (persist_view ui))

(fn outlet_context [client : Client] : Any
  (var ui : UiClient client/ui)
  {^workspace ui/workspace
   ^view_name (string_or ui/descriptor/name "")
   ^view {^title (string_or ui/descriptor/title "")
          ^presentation (string_or ui/navigation/presentation "")
          ^state_version (string_or ui/descriptor/state_version "1")}
   ^view_state (copy_map ui/state)
   ^save (fn [changes : Any] : Nil (view_state_save client changes))
   ^status client/status})

(fn sync_outlets [client : Client] : Nil
  (if (|| ($absent? client/ui) ($absent? client/browser_clients)) (return))
  (var ui : UiClient client/ui)
  (var browsers : BrowserClients client/browser_clients)
  (update_outlets browsers (outlet_nodes ui) (outlet_context client)))

(fn browser_bridge [client : Client] : Any
  # Contributions receive a shallow copy of this bridge. `shared` is copied by
  # reference, so one client can publish an opener another client (Search)
  # invokes without reaching into the other client's private bridge.
  {^shared {}
   ^toolbar ($dom/element "browser_client_toolbar")
   ^composer_actions ($dom/element "browser_client_composer_actions")
   ^state (fn [] : Any
     (var ui : UiClient client/ui)
     (var commands : CommandClient client/command_client)
     (var tab : Any (if (== client/selected "") nil else (session_tab client client/selected)))
     {^session client/selected ^title ($dom/text client/title)
      ^ready client/ready ^connected client/connected ^sending client/sending
      ^commands (launcher_items client/status/commands) ^views (launcher_items ui/navigation/views)
      ^pending_command commands/pending ^client_id (client_page_id client) ^csrf client/csrf
      ^busy client/busy ^round client/round
      ^model client/status/model ^catalog_revision client/status/catalog_revision
      ^model_settings tab/cache/session/model_settings
      ^workspace (string_or client/status/workspace "")})
   ^api (fn [method : Str, path : Str, payload : Any, done : (Fn [Int Any] Nil)] : Nil
     (api client method path payload done))
   ^command (fn [session : Str, text : Str, expected : Any, done : (Fn [Int Any] Nil)] : Nil
     (launcher_command client session text expected done))
   ^attach (fn [text : Str] : Bool
     (if (&& client/ready client/connected (! client/sending))
       (stage_prompt client text)
       true
     else
       false))
   ^navigate (fn [item : Any, done : (Fn [Int Any] Nil)] : Nil (launcher_navigate client item done))
   ^keyboard_owned (fn [] : Bool (keyboard_owned?))
   ^ensure_session (fn [done : (Fn [Int Any] Nil)] : Nil
     (if (!= client/selected "")
       (done 200 {^id client/selected})
       else (request_session client "New conversation"
         (fn [code : Int, data : Any] : Nil
           (if (== code 201) (select_session client (string_or data/id "")))
           (done code data)))))
   ^capabilities_for (fn [name : Str] : Any
     (if (== name "models")
       (model_capabilities client (fn [] : Nil (send client)))
       else (voice_capabilities client name)))
   ^subscribe (fn [callback : (Fn [Str Str Any] Nil)] : (Fn [] Nil)
     (subscribe_browser client "" callback))
   ^subscribe_owned (fn [owner : Str, callback : (Fn [Str Str Any] Nil)] : (Fn [] Nil)
     (subscribe_browser client owner callback))
   ^claim (fn [owner : Str, panel : EventTarget, close : (Fn [Bool] Nil), fallback : EventTarget] : Bool
     (claim_modal owner client/root panel close fallback))
   ^release (fn [owner : Str, restore : Bool] : Nil (release_modal owner restore))})

(fn render_plugin_slot [client : Client, target : EventTarget, slot : Str] : Bool
  (var components client/components)
  (var buttons : (List Any) [])
  (if ($absent? client/component_buttons) (set client/component_buttons {}))
  (set client/component_buttons/%slot buttons)
  (render_slot
    target
    components
    slot
    (fn [text : Str] : Nil
      (component_command client text))
    (fn [text : Str] : Nil
      (if (&& client/ready client/connected (! client/sending)) (stage_prompt client text)))
    (fn [target : Str, presentation : Str] : Nil
      (var ui : UiClient client/ui)
      (navigate ui target presentation))
    (&& client/ready client/connected (! client/sending))
    buttons))

(fn render_extensions [client : Client] : Nil
  (if ($present? client/ui)
    (var sidebar_ui : UiClient client/ui)
    (update_sidebar sidebar_ui/navigation/sidebar client/components
      (fn [text : Str] : Nil (component_command client text))
      (fn [text : Str] : Nil
        (if (&& client/ready client/connected (! client/sending)) (stage_prompt client text)))
      (fn [target : Str, presentation : Str] : Nil (navigate sidebar_ui target presentation))
      (&& client/ready client/connected (! client/sending))))
  (for slot in ["sidebar" "toolbar" "composer" "composer_actions" "status"]
    (var target ($dom/element $"web_${slot}"))
    ($dom/clear target)
    (render_plugin_slot client target slot))
  (if ($present? client/component_buttons)
    (var slots : PropMap client/component_buttons)
    (map_for [slot entries] in slots
      (var buttons : (List Any) entries)
      (for item in buttons
        (var button : EventTarget item/element)
        (var disabled : Bool item/disabled)
        (set button/disabled (|| disabled (! client/ready) (! client/connected) client/sending))))))

(fn component_command [client : Client, text : Str] : Nil
  (if (|| (! client/ready) (! client/connected) client/sending) (return))
  (launcher_command client client/selected text nil
    (fn [code : Int, data : Any] : Nil
      (if (!= code 202) (show_error client data)))))

(fn notice [client : Client, text : Str, ^key key : Str = "feedback", ^scope scope : Str = "", ^sticky sticky : Bool = false, ^severity severity : Str = "info"] : Nil
  (put_notice client/notices client/notice "host" scope key text severity sticky {^session scope}))

(fn set_hidden [id : Str, hidden : Bool] : Nil
  (var element ($dom/element id))
  (set element/hidden hidden))

(fn string_or [value : Any, fallback : Str] : Str
  (if ($absent? value) (return fallback))
  (var text : Str value)
  text)

(fn int_or [value : Any, fallback : Int] : Int
  (if ($absent? value) (return fallback))
  (var number : Int value)
  number)

(fn api [client : Client, method : Str, path : Str, payload : Any, done : (Fn [Int Any] Nil)] : Nil
  (var address
    (if client/safe_ui
      ($to_str path (if (str/contains? path "?") "&ui=default" else "?ui=default"))
      else path))
  ($http/request
    method
    address
    ($json/stringify payload)
    {^content-type "application/json" ^x-csrf-token client/csrf}
    (fn [status : Int, body : Str] : Nil
      (var result
        :
        Any
        (if (== body "")
          {^code "disconnected" ^message "Connection lost. Your draft is saved."}
          else (try
            ($json/parse body)
          catch Error
            {^code "invalid_response" ^message "The Harness returned an unreadable response."})))
      (done status result))))

(fn show_error [client : Client, result : Any, ^session session : Str = ""] : Nil
  (var message (string_or result/message "The request could not be completed."))
  (notice ^key "request-error" ^scope session ^^sticky ^severity "error" client message))

(fn session_tab [client : Client, id : Str] : SessionTab
  (for tab in client/tabs
    (if (== tab/id id) (return tab)))
  (var empty : (List Any) [])
  (var tab
    (SessionTab ^id id ^title "Loading…" ^socket nil ^socket_epoch 0 ^sequence 0 ^!connected ^!closed ^expanded [] ^server_epoch "" ^cache {^session {^id id ^title "Loading…" ^revision "0"} ^records empty ^preview empty ^rounds empty ^cursor "" ^next_submission_seq "1" ^round nil ^questions nil ^!has_older}))
  (client/tabs .push tab)
  tab)

(fn save_tab [client : Client] : Nil
  (var tab (session_tab client client/selected))
  (var cache : Any tab/cache)
  (set cache/records client/records)
  (set cache/preview client/preview)
  (set cache/rounds client/rounds)
  (set cache/round client/round)
  (set cache/mode client/mode)
  (set cache/cursor client/cursor)
  (set cache/next_submission_seq client/next_seq)
  (set cache/has_older client/has_older)
  (set cache/delegation_recovery (delegation_recovery client))
  (if (== (string_or client/status/status_session "") client/selected)
    (set cache/status client/status))
  (set tab/expanded client/expanded))

(fn render_tabs [client : Client] : Nil
  (var target ($dom/element "session_tabs"))
  ($dom/clear target)
  (for tab in client/tabs
    (if (&& (! tab/closed) (!= tab/id ""))
      (var id tab/id)
      (var title tab/title)
      (var state : Str "")
      (var cache : Any tab/cache)
      (if ($present? cache/round) (set state cache/round/state))
      (if ($present? cache/mode) (set state cache/mode/label))
      ($dom/append
        target
        ($dom/render
          `(div ^class_name %(if (== id client/selected) "session_tab selected" else "session_tab")
             (button ^type "button" ^on_click %(fn [event : Any] : Nil (select_session client id))
               %title
               (small %state))
             (button ^type "button" ^aria-label %$"Close ${title}" ^on_click %(fn [event : Any] : Nil (close_tab client id))
               (span ^class "icon" ^data-icon "close" ^aria-hidden "true"))))))))

(fn close_tab [client : Client, id : Str, ^navigate navigate : Bool = true] : Nil
  (clear_session_output (live_store client) id)
  (browser_event client "session/close" id nil)
  (var tab (session_tab client id))
  (set tab/closed true)
  (set tab/socket_epoch (+ tab/socket_epoch 1))
  (if ($present? tab/socket)
    (var socket : EventTarget tab/socket)
    ($ws/close socket))
  (if (&& navigate (== id client/selected))
    (var next "")
    (for candidate in client/tabs
      (if (&& (! candidate/closed) (!= candidate/id ""))
        (set next candidate/id)
        (break)))
    (select_session client next))
  (render_tabs client))

(fn remember_draft [client : Client] : Nil
  (if (! client/ready) (return))
  (if (&& (!= client/selected "") (== client/generation 0)) (return))
  (reviewed_voice_input client client/selected ($dom/input_value client/prompt))
  (var key (draft_key (if (== client/selected "") "new" else client/selected)))
  (if (storage_set key ($dom/input_value client/prompt))
    (notice ^key "draft-storage" ^scope client/selected client "")
    else (notice ^key "draft-storage" ^scope client/selected ^^sticky ^severity "error"
      client
      "Browser storage is unavailable. Keep this tab open to preserve your draft.")))

(fn controls [client : Client] : Nil
  (if ($present? client/inbox)
    (var inbox : ProducerInbox client/inbox)
    (producer_ready inbox (&& client/ready client/connected) client/selected))
  (if ($present? client/questions)
    (var questions : QuestionEditors client/questions)
    (question_ready questions (&& client/ready client/connected)))
  (if ($present? client/center)
    (var center : NotificationCenter client/center)
    (center_ready center (&& client/ready client/connected)))
  (var send ($dom/element "send"))
  (var in_mode ($present? client/mode))
  (var executing (if in_mode ($present? client/mode/running) else client/server_busy))
  (var attachments : MediaComposer client/media)
  (media_controls attachments (&& client/ready client/connected (! client/sending)
    ($absent? client/pending) (! in_mode)))
  (if (&& client/was_executing (! executing))
    (set client/action_cooldown true)
    ($time/after 250.0 (fn [] : Nil (set client/action_cooldown false) (update_controls client))))
  (set client/was_executing executing)
  ($dom/set_class client/root "working" client/busy)
  ($dom/set_class client/root "sending" client/sending)
  ($dom/set_class client/root "input_mode" in_mode)
  (var command
    (&&
      (str/starts_with? ($dom/input_value client/prompt) "/")
      (! (str/starts_with? ($dom/input_value client/prompt) "//"))))
  (set send/disabled
    (||
      (! client/ready)
      (! client/connected)
      client/sending
      client/action_cooldown
      (&& (! executing) (media_blocked attachments))
      (&& (! executing) (! in_mode) (! command) (|| client/busy (!= client/input_id "")))))
  (var rename ($dom/element "rename_session"))
  (set rename/disabled
    (|| (! client/ready) (! client/connected) (== client/selected "") client/busy))
  (var session : Any nil)
  (for selected_tab in client/tabs
    (if (== selected_tab/id client/selected) (set session selected_tab/cache/session)))
  (var share_button ($dom/element "add_to_slack"))
  (set share_button/hidden (|| (== client/selected "") (! (can_share_session? session))))
  (var sharing (|| (== (slack_pending client) client/selected) (session_share_pending? session)))
  (set share_button/disabled (|| (! client/ready) (! client/connected) client/busy sharing
    (session_share_busy? session) (!= (slack_pending client) "")))
  ($dom/set_text share_button (if sharing "Adding to Slack…" else (session_share_label session)))
  (var pin ($dom/element "pin_session"))
  (set pin/disabled (|| (! client/ready) (! client/connected) (== client/selected "")))
  (var create_button ($dom/element "create_session"))
  (set create_button/disabled (|| (! client/ready) (! client/connected) client/sending))
  (set client/prompt/disabled (! client/ready))
  (set_hidden "leave_mode" (! in_mode))
  (var mode_label : Str (if in_mode client/mode/label else "mode"))
  (var mode_prompt : Str (if in_mode client/mode/prompt else "Ask a question or describe a task…"))
  ($dom/set_text ($dom/element "leave_mode") $"Leave ${mode_label}")
  (set client/prompt/placeholder mode_prompt)
  ($dom/set_text ($dom/element "input_mode_label") (if in_mode client/mode/label else ""))
  ($dom/set_text
    ($dom/element "composer_hint")
    (if in_mode
      client/mode/hint
      else "Shift+Enter for a new line · / for commands"))
  (set send/text_content
    (if client/sending
      "Sending…"
      elif executing "Stop"
      elif in_mode client/mode/submit_label
      elif ($absent? client/pending) "Send"
      else "Resolve"))
  ($dom/set_class send "stop" executing)
  (var mode "Local workspace")
  (if ($present? client/status)
    (var model : Str client/status/model/model)
    (var provider : Str client/status/model/provider)
    (set mode (if client/status/offline "Command demo · no model" else $"${model} · ${provider}"))
    (if (&& (! client/status/offline) ($present? client/status/model/effort))
      (var effort : Str client/status/model/effort)
      (set mode $"${mode} · ${effort}")))
  (set_hidden "offline_notice" (|| ($absent? client/status) (! client/status/offline)))
  ($dom/set_text ($dom/element "mode") mode)
  (render_extensions client)
  (if ($present? client/ui)
    (var ui : UiClient client/ui)
    (ui_controls ui (&& client/ready client/connected) client/selected)))

(fn render_input [client : Client] : Nil
  (var batch (waiting_batch {^round client/round}))
  (set client/input_id (if ($absent? batch) "" else (string_or batch/id "")))
  (set_hidden "input_panel" (== client/input_id ""))
  (if ($present? client/questions)
    (var questions : QuestionEditors client/questions)
    (mount_question questions client/selected batch ($dom/element "input_fields") "conversation")))

(fn render_sessions [client : Client] : Nil
  (var focused ($dom/active_element))
  (set client/list/harness_focus_session
    (if ($dom/contains? client/list focused) (string_or focused/harness_session "") else ""))
  (if ($present? client/session_menu)
    (var active_raw : Any client/session_menu)
    (var active_menu : SessionMenu active_raw) (set active_menu/anchor nil))
  ($dom/clear client/list)
  (var attention ($dom/element "attention_sessions"))
  ($dom/clear attention)
  (if ($present? client/center)
    (var center : NotificationCenter client/center)
    (center_sessions center client/sessions client/needs_attention))
  (var visible 0)
  (for session in client/sessions
    (if (== (string_or session/kind "") "child") (continue))
    (render_session_button client client/list session)
    (set visible (+ visible 1)))
  (if (== visible 0)
    ($dom/append
      client/list
      ($dom/render `(p ^class_name "sidebar_empty" "Your conversations will appear here."))))
  (if ($present? client/session_menu)
    (var menu_raw : Any client/session_menu)
    (var menu : SessionMenu menu_raw) (finish_session_menu_render menu)))

(fn render_session_button [client : Client, target : EventTarget, session : Any] : Nil
  (var title : Str session/title)
  (var id : Str session/id)
  (var kind : Str session/kind)
  (var status : Str session/status)
  (var metadata $"${kind} · ${status}")
  (if (== (string_or session/channel/transport "") "slack")
    (var destination : Str session/channel/channel)
    (set metadata $"Slack ${destination} · ${metadata}"))
  (var cls (if (== id client/selected) "session selected" else "session"))
  (var row ($dom/render `(div ^class_name %(if (== id client/selected) "session_row selected" else "session_row"))))
  ($dom/append
    row
    ($dom/render
      `(button ^type "button" ^class_name %cls ^on_click %(fn [event : Any] : Nil (select_session client id))
         (span ^class_name "session_name" %title)
         (span ^class_name "session_meta" %metadata))))
  (var more ($dom/render `(button ^type "button" ^class_name "session_more"
    ^aria-label %$"Actions for ${title}" ^aria-haspopup "menu" ^aria-expanded "false"
    ^disabled %(! client/ready)
    ^on_click %(fn [event : Any] : Nil
      ($dom/stop_propagation event)
      (if (keyboard_owned?) (return))
      (var anchor : EventTarget event/current_target)
      (open_session_menu (conversation_menu client) anchor session)) (span ^class "icon" ^data-icon "more" ^aria-hidden "true"))))
  ($dom/append row more) ($dom/append target row)
  (set more/harness_session id)
  (bind_session_menu (conversation_menu client) more session)
  (if (== id (string_or client/list/harness_focus_session "")) ($dom/focus more)))

(fn conversation_menu [client : Client] : SessionMenu
  (if ($absent? client/session_menu)
    (set client/session_menu (create_session_menu
      (fn [method : Str, path : Str, data : Any, done : (Fn [Int Any] Nil)] : Nil
        (api client method path data done))
      (fn [record : Any] : Nil (session_edited client record))
      (fn [ids : (List Any)] : Nil
        (for value in ids (var id : Str value) (forget_session client id))
        (refresh_sessions client)))))
  (var raw : Any client/session_menu) (var menu : SessionMenu raw) menu)

(fn session_edited [client : Client, record : Any] : Nil
  (var id : Str record/id)
  (var received_revision : Int ($json/parse (string_or record/revision "0")))
  (for tab in client/tabs
    (if (== tab/id id)
      (var cached_revision : Int ($json/parse (string_or tab/cache/session/revision "0")))
      (if (< received_revision cached_revision) (return))))
  (var roots : (List Any) [])
  (for existing in client/sessions
    (if (== (string_or existing/id "") id)
      (if (&& ($absent? record/children) ($present? existing/children))
        (set record/children existing/children))
      (roots .push record)
    else
      (var children (dlist existing/children))
      (for child in children
        (if (== (string_or child/id "") id)
          (set existing/children (merge_blocks children [record]))))
      (roots .push existing)))
  (set client/sessions roots)
  (for tab in client/tabs
    (if (== tab/id id)
      (set tab/title record/title)
      (var cache : Any tab/cache)
      (set cache/session record)))
  (if (== id client/selected)
    (set client/session_revision record/revision)
    (render_session_title client (string_or record/title "") record/channel)
    ($dom/set_text
      ($dom/element "pin_session")
      (if (launcher_flag record/pinned) "Unpin" else "Pin")))
  (render_sessions client) (render_tabs client) (refresh_sessions client) (update_controls client))

(fn forget_session [client : Client, id : Str] : Nil
  (var ids : (List Str) [id])
  (for tab in client/tabs
    (if (== (string_or tab/cache/session/parent/session "") id) (ids .push tab/id)))
  (var selected false)
  (for removed in ids
    (if (== removed client/selected) (set selected true))
    (if (has_tab? client removed) (close_tab ^navigate false client removed)))
  (var kept : (List Any) [])
  (for record in client/sessions
    (if (== (string_or record/id "") id) (continue))
    (var children : (List Any) [])
    (for child in (dlist record/children)
      (if (!= (string_or child/id "") id) (children .push child)))
    (set record/children children) (kept .push record))
  (set client/sessions kept)
  (if selected
    (var next "")
    (for candidate in client/tabs
      (if (&& (! candidate/closed) (!= candidate/id ""))
        (set next candidate/id)
        (break)))
    (select_session ^^force client next))
  (for removed in ids
    (storage_remove (draft_key removed))
    (storage_remove (mode_pending_key removed)))
  (render_sessions client) (render_tabs client))

(fn refresh_sessions [client : Client] : Nil
  (if_not client/ready (return))
  (set client/filter_epoch (+ client/filter_epoch 1))
  (var epoch client/filter_epoch)
  (var query "?")
  (for row in [["q" "session_filter"] ["kind" "kind_filter"] ["status" "status_filter"] ["trigger" "trigger_filter"] ["since" "since_filter"] ["until" "until_filter"]]
    (var name : Str row/0)
    (var id : Str row/1)
    (var value ($dom/input_value ($dom/element id)))
    (if (!= value "") (set query $"${query}${name}=${($url/encode_component value)}&")))
  (api
    client
    "GET"
    $"${(api_root)}/sessions${query}"
    nil
    (fn [code : Int, data : Any] : Nil
      (if (!= epoch client/filter_epoch) (return))
      (if (== code 200)
        (set client/sessions data/sessions)
          (set client/needs_attention data/needs_attention)
          (render_sessions client)
        else
          (show_error client data)))))

(fn expanded_block [client : Client, id : Str] : Bool
  (for previous in client/expanded
    (if (== previous id) (return true)))
  false)

(fn toggle_block [client : Client, id : Str, opened : Bool] : Nil
  (var kept : (List Str) [])
  (for previous in client/expanded
    (if (!= previous id) (kept .push previous)))
  (if opened (kept .push id))
  (set client/expanded kept))

(fn copy_text [client : Client, text : Str] : Nil
  ($browser/copy
    text
    (fn [copied : Bool] : Nil
      (notice client (if copied "Copied." else "Select the text to copy it.")))))

(fn edit_prompt [client : Client, text : Str] : Nil
  (if ($present? client/pending)
    (notice client "Resolve the pending submission before editing another prompt.")
    (return))
  ($dom/set_input_value client/prompt text)
  (remember_draft client)
  (render_commands client)
  ($dom/focus client/prompt))

(fn stage_prompt [client : Client, text : Str] : Nil
  (var ui : UiClient client/ui)
  (navigate ui "harness")
  (var draft ($dom/input_value client/prompt))
  (if (|| (== draft "") (== draft text))
    (edit_prompt client text)
    (return))
  (var offer ($dom/element "prompt_offer"))
  ($dom/clear offer)
  (set offer/hidden false)
  ($dom/append offer ($dom/render
    `(div
      (p "A view offered a prompt. Keep your current draft, replace it, or append the offered text.")
      (pre %text)
      (button ^type "button" ^on_click %(fn [event : Any] : Nil
        (edit_prompt client text) (set offer/hidden true)) "Replace draft")
      (button ^type "button" ^on_click %(fn [event : Any] : Nil
        (edit_prompt client ($to_str ($dom/input_value client/prompt) "\n\n" text))
        (set offer/hidden true)) "Append to draft")
      (button ^type "button" ^on_click %(fn [event : Any] : Nil
        (set offer/hidden true) ($dom/focus client/prompt)) "Keep draft")))))

(fn card_owned [client : Client, card : Any] : Bool
  (if ($absent? client/round) (return false))
  (var round_id : Str client/round/id)
  (var round_state : Str client/round/state)
  (var card_round (string_or card/round ""))
  (&& (== round_state "running") (== round_id card_round)))

(fn render_block [client : Client, target : EventTarget, block : Any] : Nil
  (var block_phase : Str block/phase)
  (if (render_delegation client target block) (return))
  (if (== block_phase "card")
    (var host : CardHost client/cards)
    ($dom/append
      target
      (card_view host client/selected block/card (card_owned client block/card) client/safe_ui))
    (return))
  (if (== block_phase "card/update")
    ($dom/append target (card_update_line block))
    (return))
  (if (== block_phase "questions")
    ($dom/append
      target
      (answered_view ^resolve_author (fn [source : Any, target : EventTarget] : Nil (resolve_slack_author client source target))
        block
        (fn [text : Str] : Nil
          (stage_prompt client text))))
    (return))
  (var id : Str block/id)
  (var generation client/generation)
  (var combined (&& (== block_phase "command") (execution_command block)))
  (if combined
    (var article
      ($dom/render `(article ^class_name "message agent" (div ^class_name "speaker" "Agent"))))
    ($dom/append
      article
      (live_output_view ^command block
        client
        (command_output_key client/selected (string_or block/command_id ""))))
    ($dom/append target article)
  else
    ($dom/append
      target
      (block_view ^resolve_author (fn [source : Any, target : EventTarget] : Nil (resolve_slack_author client source target)) ^on_speak (voice_replay_handler client)
        block
        (not_durable block)
        (fn [text : Str] : Nil
          (copy_text client text))
        (expanded_block client id)
        (fn [opened : Bool] : Nil
          (if (== generation client/generation) (toggle_block client id opened))))))
  (var phase : Str block/phase)
  (if (&& (== phase "command") (! combined) ($absent? block/mode_instance))
    (var output_parts : (List Str) (str/split id "/"))
    ($dom/append
      target
      (live_output_view
        client
        (command_output_key client/selected (string_or block/command_id output_parts/1)))))
  (var status (string_or block/status ""))
  (if (&& (== phase "command") (== status "running") ($absent? block/mode_instance))
    (var parts : (List Str) (str/split id "/"))
    (var command_id : Str parts/1)
    ($dom/append
      target
      ($dom/render
        `(button ^type "button" ^on_click %(fn [event : Any] : Nil (api client "POST" $"${(api_root)}/sessions/${client/selected}/commands/${command_id}/cancel" {} (fn [code : Int, data : Any] : Nil (if (!= code 200) (show_error client data))))) "Cancel command"))))
  (var view : Any block/view)
  (if ($present? view)
    (var next : Any view/next)
    (if ($present? next)
      (var path : Str view/path)
      (var first : Int next)
      ($dom/append
        target
        ($dom/render
          `(button ^type "button" ^on_click %(fn [event : Any] : Nil (send_command client $"/view ${path}:${first}")) "Next page")))))
  (if (&& (== (string_or view/kind "") "gene") ($present? client/editor))
    (var raw_panel : Any client/editor)
    (var panel : EditorPanel raw_panel)
    (if (editor_available? panel)
      (var editor_path : Str view/path)
      (var editor_from (int_or view/from 1))
      (var editor_to (int_or view/to editor_from))
      ($dom/append
        target
        ($dom/render
          `(button ^type "button" ^on_click %(fn [event : Any] : Nil (open_editor ^from editor_from ^to editor_to panel editor_path)) "Open in Gene editor"))))))

(fn render_run [client : Client, blocks : (List Any), run : Any] : Nil
  (var target ($dom/render `(section ^class_name "run")))
  (var prompt "")
  (var generation client/generation)
  (var groups (conversation_groups blocks))
  (for group in groups
    (if (== (string_or group/kind "") "block")
      (var block : Any group/block)
        (if (== (string_or block/role "") "user") (set prompt block/text))
        (render_block client target block)
      else
        (var step : (List Any) group/blocks)
        (var block : Any step/0)
        (var key : Str group/key)
        (var active (&& ($present? run) (! (terminal (string_or run/state "")))))
        ($dom/append target
          (step_view step (expanded_block client key) active
            (fn [text : Str] : Nil (copy_text client text))
            (fn [id : Str] : Bool (expanded_block client id))
            (fn [id : Str, opened : Bool] : Nil
              (if (== generation client/generation) (toggle_block client id opened)))
            ^on_speak (voice_replay_handler client)
            ^output_view (live_output_view client (turn_output_key client/selected (string_or block/round_id "") (dint block/turn)))
            ^render_extra (fn [content : EventTarget, item : Any] : Nil (render_block client content item))))))
  (if (&& ($present? run) (!= (run_label run) "Completed"))
    (var on_continue : Any nil)
    (if (== (string_or run/id "") (string_or client/round/id ""))
      (var session client/selected)
      (var source : Str run/id)
      (set on_continue
        (fn [mode : Str] : Nil
          (var payload : Any {^mode mode})
          (attach_model_draft client payload session)
          (api
            client
            "POST"
            $"${(api_root)}/sessions/${session}/rounds/${source}/continue"
            payload
            (fn [code : Int, data : Any] : Nil
              (if (== code 202)
                (model_draft_admitted client session payload)
                (apply_run client session data)
              else
                (show_error ^session session client data)
                (if (== session client/selected) (render_transcript client))))))))
    ($dom/append
      target
      (run_status_view ^on_continue on_continue
        run
        prompt
        (fn [text : Str] : Nil
          (edit_prompt client text)))))
  ($dom/append client/transcript target))

(fn render_transcript [client : Client, ^prepend prepend : Bool = false] : Nil
  (begin_output_render client)
  (ensure_feature_host client)
  (begin_delegation_render client)
  (var old_top ($dom/scroll_top client/transcript))
  (var old_height ($dom/scroll_height client/transcript))
  (var follow (&& (! client/viewing_history)
    (|| client/autoscroll ($dom/near_end client/transcript 80.0))))
  # Keep expansion state only for retained blocks, across preview-to-durable
  # replacement and transcript refreshes. New model steps start collapsed.
  (var expanded : (List Str) [])
  (for id in client/expanded
    (var retained false)
    (for block in client/records
      (var block_id : Str block/id)
      (if (|| (== block_id id) (== (step_key block) id) (== $"collapsed/${block_id}" id)) (set retained true)))
    (for block in client/preview
      (var block_id : Str block/id)
      (if (|| (== block_id id) (== (step_key block) id) (== $"collapsed/${block_id}" id)) (set retained true)))
    (if retained (expanded .push id)))
  (set client/expanded expanded)
  ($dom/clear client/transcript)
  (var all_visible : (List Any) client/records)
  # Durable records lead; append previews only when no durable version exists.
  (for block in client/preview
    (var found false)
    (for record in client/records (if (== record/id block/id) (set found true)))
    (if_not found (set all_visible (merge_blocks all_visible [block]))))
  (var tab (session_tab client client/selected))
  (var cache : Any tab/cache)
  (var first : Any (first_prompt_block cache/session client/records client/preview))
  (if_not client/viewing_history
    (var runs : (List Any) client/rounds)
    (if ($present? client/round) (set runs (merge_blocks runs [client/round])))
    (set all_visible (submission_blocks client/selected client/pending runs all_visible
      ^shown_round (if ($absent? first) "" else (string_or first/round_id "")))))
  (append_history_start client/transcript cache/session client/records client/preview
    client/has_older client/loading_older
    (fn [text : Str] : Nil (copy_text client text))
    (fn [] : Nil (load_older client)))
  (if (&& (== all_visible/.size 0) (== (string_or cache/session/first_request "") ""))
    (if_not (render_plugin_slot client client/transcript "welcome")
      ($dom/append client/transcript
      ($dom/render
        `(div ^class_name "empty_state"
           (h2 "What would you like to work on?")
           (p "Start with an idea, a question, or a task.")
           (div ^class_name "suggestions"
             (button ^type "button"
               ^on_click %(fn [event : Any] : Nil
                 ($dom/set_input_value client/prompt "What can you help me with?")
                 ($dom/focus client/prompt)) "Explore ideas"
               (span ^class_name "icon" ^data-icon "chevron-right" ^aria-hidden "true"))
             (button ^type "button"
               ^on_click %(fn [event : Any] : Nil
                 ($dom/set_input_value client/prompt "/help")
                 ($dom/focus client/prompt)) "Browse commands"
               (span ^class_name "suggestion_symbol" ^aria-hidden "true" "/"))))))))
  (var visible : (List Any) (historical_records all_visible))
  (var i 0)
  (var current_shown false)
  (var seen_rounds : (List Str) [])
  (while (< i ($size visible))
    (var first : Any visible/%i)
    (var id : Str first/round_id)
    (var blocks : (List Any) [])
    (if (!= id "")
      (set i (+ i 1))
        (var shown false)
        (for seen in seen_rounds (if (== seen id) (set shown true)))
        (if shown (continue))
        (seen_rounds .push id)
        (for record in visible
          (if (== (string_or record/round_id "") id) (blocks .push record)))
      else
        (while (< i ($size visible))
          (var block : Any visible/%i)
          (var block_run : Str block/round_id)
          (if (!= block_run id) (break))
          (blocks .push block) (set i (+ i 1))))
    (var run : Any nil)
    (for receipt in client/rounds
      (var receipt_id : Str receipt/id)
      (if (== receipt_id id) (set run receipt)))
    (if ($present? client/round)
      (var current_id : Str client/round/id)
      (if (== current_id id)
        (set run client/round)
        (set current_shown true)))
    (render_run client blocks run))
  (if (&& ($present? client/round) (! current_shown))
    (var status : Str client/round/state)
    (if_not (terminal status) (render_run client [] client/round)))
  (render_delegation_recovery client client/transcript)
  (refresh_live_output client)
  (if follow
    (if (&& (== client/records/.size 0) (== client/preview/.size 0))
        ($dom/set_scroll_top client/transcript 0.0)
        else ($dom/scroll_end client/transcript))
      (set_hidden "new_output" true)
    else
      ($dom/set_scroll_top client/transcript
        (if prepend (+ old_top (- ($dom/scroll_height client/transcript) old_height)) else old_top))
      ($dom/set_text ($dom/element "new_output_label")
        (if client/viewing_history "Return to latest" else "New output"))
      (set_hidden "new_output" false)))

(fn update_controls [client : Client] : Nil
  (var state : Str (if ($absent? client/round) "" else client/round/state))
  (set client/server_busy (|| (== state "running")
    (&& (== state "waiting") ($present? client/round/delegation_wait))
    (&& (== state "paused") (== (string_or client/round/continuation_mode "") "automatic")
      ($absent? client/round/continuation_stop))))
  (if ($absent? client/mode)
    (render_input client)
    else (set_hidden "input_panel" true))
  (set client/busy
    (if ($absent? client/mode)
      (|| client/server_busy (!= client/awaiting ""))
      else ($present? client/mode/running)))
  (controls client))

(fn acknowledge_run [client : Client, run : Any, session : Str] : Nil
  (if ($absent? run) (return))
  (var request_id (string_or run/request_id ""))
  (if (&& (== session client/awaiting_session) (== request_id client/awaiting))
    (set client/awaiting "")
    (set client/awaiting_session "")))

(fn refresh_status [client : Client] : Nil
  (if_not client/ready (return))
  (set client/status_generation (+ client/status_generation 1))
  (var generation client/status_generation)
  (var session client/selected)
  # Coalesce a publication's invalidations and drop late requests after a tab
  # switch or another workspace update. This is event-driven, not polling.
  ($time/after 25.0 (fn [] : Nil
    (if (!= generation client/status_generation) (return))
    (api client "GET" $"${(api_root)}/status?session=${($url/encode_component session)}" nil
      (fn [code : Int, data : Any] : Nil
        (if (|| (!= generation client/status_generation) (!= session client/selected)) (return))
        (if (== code 200) (apply_status client data) else (show_error client data)))))))

(fn invalidate_status [client : Client, epoch : Str, revision : Str] : Nil
  (if (&& (== epoch client/status_epoch) (! (revision_before client/status_revision revision)))
    (return))
  (set client/status_epoch epoch)
  (set client/status_revision revision)
  (refresh_status client))

(fn apply_appearance [client : Client, mode : Str] : Nil
  (if (&& (!= mode "light") (!= mode "dark")) (return))
  (set client/appearance mode)
  ($dom/set_attribute ($dom/element "harness_document") "data-mode" mode)
  (if ($present? client/ui)
    (var ui : UiClient client/ui)
    (ui_appearance ui mode)))

# Plugin style contributions from slot components and views, one <style> each.
# Recovery views mount none.
(fn sync_plugin_styles [client : Client] : Nil
  (var entries : (List Any) [])
  (if_not client/safe_ui
    (for component in client/components
      (if ($present? component/style)
        (entries .push {^name (string_or component/name "") ^css (string_or component/style "")})))
    (if ($present? client/ui)
      (var ui : UiClient client/ui)
      (for view in ui/navigation/views
        (if ($present? view/style)
          (entries .push {^name (string_or view/name "") ^css (string_or view/style "")})))))
  (var signature ($json/stringify entries))
  (if (== signature client/style_signature) (return))
  (set client/style_signature signature)
  (var target ($dom/element "plugin_styles"))
  ($dom/clear target)
  (for entry in entries
    (var element ($dom/create_element "style"))
    (var name : Str entry/name)
    (var css : Str entry/css)
    ($dom/set_attribute element "data-component" name)
    ($dom/set_text element css)
    ($dom/append target element)))

(fn apply_status [client : Client, data : Any] : Nil
  (if_not (status_is_current data client/status client/selected client/epoch client/status_epoch client/status_revision)
    (return))
  (var epoch (string_or data/epoch ""))
  (var revision (string_or data/status_revision ""))
  (set client/status_epoch epoch)
  (set client/status_revision revision)
  (var status_ui : UiClient client/ui)
  (if ($present? data/keyboard) (set status_ui/keyboard (copy_map data/keyboard)))
  (var unchanged (== ($json/stringify client/status) ($json/stringify data)))
  (set client/status data)
  (configure_voice client data)
  (if ($present? client/command_client)
    (var commands : CommandClient client/command_client)
    (configure_commands commands (string_or data/workspace "")))

  (if ($present? client/editor)
    (do
      (var raw_panel : Any client/editor)
      (var panel : EditorPanel raw_panel)
      (var was_available (editor_available? panel))
      (configure_editor panel data/plugins)
      (if (&& (!= was_available (editor_available? panel)) (! (editor_open? panel)))
        (render_transcript client))))
  (if ($present? client/ui)
    (var ui : UiClient client/ui)
    (update_ui ui data/ui))
  (if ($present? client/browser_clients)
    (var browsers : BrowserClients client/browser_clients)
    (update_clients browsers (launcher_items data/browser_clients) data))
  (sync_outlets client)
  (var components : (List Any) [])
  (if ($present? data/web_components) (set components data/web_components))
  (var components_changed (!= ($json/stringify client/components) ($json/stringify components)))
  (set client/components components)
  (sync_plugin_styles client)
  (update_controls client)
  (if unchanged (return))
  (var drawer ($dom/element "status_content"))
  ($dom/clear drawer)
  (var summary ($dom/create_element "div"))
  ($dom/append drawer summary)
  (if_not (render_plugin_slot client summary "status_summary")
    (var profile : Str data/profile)
    ($dom/append drawer ($dom/render `(p "Profile: " %profile)))
    (var model : Str data/model/model)
    (var provider : Str data/model/provider)
    ($dom/append drawer ($dom/render `(p "Model: " %model)))
    ($dom/append drawer ($dom/render `(p "Provider: " %provider)))
    (if ($present? data/model/effort)
      (var effort : Str data/model/effort)
      ($dom/append drawer ($dom/render `(p "Reasoning effort: " %effort)))))
  (var plugins : (List Any) data/plugins)
  (for plugin in plugins
    (var id : Str plugin/id)
    (var state : Str plugin/state)
    ($dom/append drawer ($dom/render `(div ^class_name "plugin_status" (span %id) (span %state)))))
  (for component in components
    (if ($present? component/error)
      (var name : Str component/name)
      (var error : Str component/error)
      ($dom/append drawer ($dom/render `(p ^class_name "web_muted" %$"${name}: ${error}")))))
  (render_commands client)
  (if (&& components_changed (== client/records/.size 0) (== client/preview/.size 0))
    (render_transcript client)))

(fn render_commands [client : Client] : Nil
  (var picker ($dom/element "commands"))
  (if ($present? client/mode)
    (set picker/hidden true)
    (return))
  ($dom/clear picker)
  (var text ($dom/input_value client/prompt))
  (var parts : (List Str) (str/split text " "))
  (var show
    (&&
      (str/starts_with? text "/")
      (== ($size parts) 1)
      (!
        (str/contains?
          text
          """
"""))
      (! (str/contains? text "\t"))))
  (set picker/hidden (! show))
  (if (|| (! show) ($absent? client/status)) (return))
  (var commands : (List Any) client/status/commands)
  (var matched false)
  (for command in commands
    (var name : Str command/name)
    (var doc : Str command/doc)
    (if (str/starts_with? $"/${name}" (str/lower text))
      (set matched true)
      ($dom/append
        picker
        ($dom/render
          `(button ^type "button" ^class_name "command" ^on_click %(fn [event : Any] : Nil ($dom/set_input_value client/prompt $"/${name} ") (remember_draft client) ($dom/focus client/prompt) (set picker/hidden true))
             (strong %$"/${name}")
             (span %doc))))))
  (if_not matched
    ($dom/append
      picker
      ($dom/render
        `(p ^class_name "muted"
           %(if (== ($size commands) 0)
              "Use /help to load available commands."
              else "No matching commands. Use /help for the full list."))))))

(fn upsert_session [client : Client, session : Any] : Nil
  (set client/sessions (merge_blocks client/sessions [session]))
  (render_sessions client))

(fn sessions_page [client : Client, after : Str] : Nil
  (var epoch client/socket_epoch)
  (api client "GET" $"${(api_root)}/sessions?after=${after}" nil
    (fn [code : Int, data : Any] : Nil
      (if (!= epoch client/socket_epoch) (return))
      (if (== code 200)
        (var page : (List Any) data/sessions)
          # Live pushes may already hold a newer version of an existing row.
          (var additions : (List Any) [])
          (for entry in page
            (var found false)
            (for existing in client/sessions
              (if (== entry/id existing/id) (set found true)))
            (if_not found (additions .push entry)))
          (set client/sessions (merge_blocks client/sessions additions))
          (render_sessions client)
          (var next (string_or data/next ""))
          (if (!= next "") (sessions_page client next))
        else (show_error client data)))))

(fn load_older [client : Client] : Nil
  (if (|| client/loading_older (== ($size client/records) 0)) (return))
  (set client/loading_older true)
  (var generation client/generation)
  (var first : Any client/records/0)
  (var tab (session_tab client client/selected))
  (var before (string_or tab/cache/before_cursor (string_or first/seq "")))
  (api
    client
    "GET"
    $"${(api_root)}/sessions/${client/selected}/snapshot?before=${before}"
    nil
    (fn [code : Int, data : Any] : Nil
      (if (!= generation client/generation) (return))
      (set client/loading_older false)
      (if (== code 200)
        (var older : (List Any) data/records)
          (var empty_runs : (List Any) [])
          (var raw_runs : Any (?? data/rounds empty_runs))
          (var runs : (List Any) raw_runs)
          (set client/rounds (merge_blocks client/rounds runs))
          (set client/records (bounded_blocks (merge_blocks older client/records) false))
          (set client/has_older data/has_older)
          (set tab/cache/before_cursor data/before_cursor)
          (set client/autoscroll false)
          (set client/viewing_history true)
          (set client/preview [])
          (render_transcript ^^prepend client)
        else
          (show_error client data)))))

(fn apply_snapshot [client : Client, data : Any] : Nil
  (if (== (string_or data/status/epoch client/epoch) client/epoch)
    (var before_sequence : Int 0)
    (var next_sequence : Int 0)
    (if ($present? client/round/submission_seq)
      (set before_sequence client/round/submission_seq))
    (if ($present? data/round/submission_seq) (set next_sequence data/round/submission_seq))
    (if (|| (> before_sequence next_sequence) (&& (== before_sequence next_sequence) ($present? client/round) (terminal (string_or client/round/state "")) (== (string_or data/round/state "") "running")))
      (set data/round client/round)))
  (if client/viewing_history
    (var current_tab (session_tab client client/selected))
    (set data/before_cursor current_tab/cache/before_cursor))
  (output_epoch (live_store client) (string_or data/status/epoch ""))
  (observe_output (live_store client) client/selected "snapshot" data)
  (set data/records (historical_records data/records))
  (set data/preview (historical_records data/preview))
  (if_not client/viewing_history
    (var cursor_text (string_or data/cursor "0"))
    (if (== cursor_text "") (set cursor_text "0"))
    (var cursor : Int ($json/parse cursor_text))
    (for previous in [client/records client/preview]
      (for record in previous
        (if (> (record_sequence record) cursor)
          (var incoming : (List Any) data/records)
          (var present false)
          (for item in incoming
            (if (== item/id record/id) (set present true)))
          (if present
            (set data/records (merge_blocks incoming [record]))
          else
            (var preview : (List Any) data/preview)
            (set data/preview (merge_blocks preview [record])))))))
  (if ($present? data/status) (apply_status client data/status))
  (if_not client/viewing_history
    (var records : (List Any) (historical_records data/records))
    (set client/records (bounded_blocks (delegation_snapshot records client/records) true))
    (set client/preview (historical_records data/preview))
    (set client/has_older data/has_older))
  (set client/round data/round)
  (set_delegation_recovery client (?? data/delegation_recovery nil))
  (set client/mode (?? data/mode nil))
  (resolve_mode_receipt client data/records)
  (var empty_runs : (List Any) [])
  (var raw_runs : Any (?? data/rounds empty_runs))
  (var runs : (List Any) raw_runs)
  (set client/rounds (merge_blocks client/rounds runs))
  (acknowledge_run client data/round client/selected)
  (set client/cursor data/cursor)
  (set client/next_seq data/next_submission_seq)
  (set client/session_revision data/session/revision)
  (var title : Str data/session/title)
  (render_session_title client title data/session/channel)
  (var raw_delivery : Any (?? data/channel_delivery empty_runs))
  (var delivery_issues : (List Any) raw_delivery)
  (set_hidden "channel_delivery" (== delivery_issues/.size 0))
  (var delivery_lines : (List Str) [])
  (for issue in delivery_issues
    (var delivery_id : Str issue/id)
    (var delivery_state : Str issue/status)
    (delivery_lines .push $"Slack ${delivery_state}: ${delivery_id}. The host owner must review and resolve it; work is saved in Harness."))
  ($dom/set_text ($dom/element "channel_delivery") ($str/join delivery_lines "\n"))
  (var origin ($dom/element "child_origin"))
  ($dom/clear origin)
  (set_hidden "child_origin" ($absent? data/session/parent))
  (if ($present? data/session/parent)
    (var parent : Str data/session/parent/session)
    (var parent_title (string_or data/session/parent_title parent))
    (var turn (dint data/session/parent/turn))
    ($dom/append origin (session_link parent $"Delegated by ${parent_title} · turn ${turn}"
      (fn [id : Str] : Nil (select_session client id)))))
  (var tab (session_tab client client/selected))
  (set tab/title title)
  (set tab/cache data)
  (var pinned : Bool false)
  (if ($present? data/session/pinned) (set pinned data/session/pinned))
  ($dom/set_text ($dom/element "pin_session") (if pinned "Unpin" else "Pin"))
  (set_hidden "pin_session" ($present? data/session/parent))
  (render_transcript client)
  (render_tabs client)
  (update_controls client))

(fn apply_records [client : Client, incoming : (List Any), cursor : Str] : Nil
  (if_not client/viewing_history
    (var merged (merge_blocks client/records (historical_records incoming)))
    (if (> ($size merged) client_record_limit) (set client/has_older true))
    (set client/records (bounded_blocks merged true))
    (var preview : (List Any) [])
    (for block in client/preview
      (var found false)
      (for record in incoming
        (if (== block/id record/id) (set found true)))
      (if_not found (preview .push block)))
    (set client/preview preview))
  (if (!= cursor "") (set client/cursor cursor))
  (render_transcript client))

(fn apply_record [client : Client, record : Any] : Nil
  (if (== (string_or record/phase "") "console") (return))
  (if (&& (== (string_or record/phase "") "turn/start")
    (== (string_or record/round_id "") (string_or client/round/id "")))
    (set client/round/task_turns record/task_turns))
  (if_not client/viewing_history
    (var found false)
    (for saved in client/records
      (if (== saved/id record/id)
        (set found true)
        (var incoming_seq : Int ($json/parse (string_or record/seq "0")))
        (var saved_seq : Int ($json/parse (string_or saved/seq "0")))
        (if (>= incoming_seq saved_seq) (set client/records (merge_blocks client/records [record])))))
    (if_not found (set client/preview (bounded_blocks (merge_blocks client/preview [record]) true))))
  (render_transcript client))

(fn apply_run [client : Client, session : Str, data : Any] : Nil
  (acknowledge_run client data session)
  (if (== session client/selected)
    (var current_sequence : Int 0)
    (var incoming_sequence : Int 0)
    (if ($present? client/round/submission_seq)
      (set current_sequence client/round/submission_seq))
    (if ($present? data/submission_seq) (set incoming_sequence data/submission_seq))
    (if (>= incoming_sequence current_sequence) (set client/round data))
    (set client/rounds (bounded_blocks (merge_blocks client/rounds [data]) true))
    (render_transcript client))
  (update_controls client))

# Existing caches may contain frames delivered after a navigation snapshot was
# taken, even when their stream has since disconnected or the tab was closed.
(fn has_tab? [client : Client, id : Str] : Bool
  (for tab in client/tabs
    (if (== tab/id id) (return true)))
  false)

(fn select_session [client : Client, id : Str, ^snapshot snapshot : Any = nil, ^force force : Bool = false] : Nil
  (if (&& client/sending (! force))
    (notice client "Resolving your submission…")
    (return))
  (remember_draft client)
  # Supplied snapshots seed new tabs; connection state cannot prove freshness.
  (var initial : Any (if (has_tab? client id) nil else snapshot))
  (var refresh (&& ($absent? initial) (== id client/selected) client/viewing_history))
  (save_tab client)
  (set client/selected id)
  (browser_event client "session/change" id nil)
  (var attachments : MediaComposer client/media)
  (media_select attachments id)
  (set client/queued_prompt "")
  (set client/queued_submit false)
  (set client/cursor "")
  (set client/next_seq "1")
  (set client/records [])
  (set client/preview [])
  (set client/expanded [])
  (set client/components [])
  (set client/round nil)
  (set_hidden "channel_delivery" true)
  (set client/mode nil)
  (set client/mode_pending nil)
  (set client/rounds [])
  (set client/has_older false)
  (set client/loading_older false)
  (set client/viewing_history false)
  (set client/autoscroll true)
  (set client/generation (+ client/generation 1))
  ($dom/set_input_value client/prompt (?? (storage_get (draft_key id)) ""))
  ($browser/replace_url
    (view_url id ((Path "navigation" "active") client/ui)
      ((Path "navigation" "presentation") client/ui) client/safe_ui))
  (var sidebar_ui : UiClient client/ui)
  (close_mobile_sidebar sidebar_ui/navigation/sidebar)
  (notice client "")
  (render_sessions client)
  (var tab (session_tab client id))
  (set tab/closed false)
  (set client/connected tab/connected)
  (set client/socket tab/socket)
  (set client/socket_epoch tab/socket_epoch)
  (set client/message_sequence tab/sequence)
  (apply_snapshot client (if ($absent? initial) tab/cache else initial))
  (refresh_status client)
  (set client/expanded tab/expanded)
  (render_transcript client)
  (render_tabs client)
  (if_not tab/connected (connect_stream client tab))
  (if (&& refresh tab/connected (!= id ""))
    (api
      client
      "GET"
      $"${(api_root)}/sessions/${id}/snapshot"
      nil
      (fn [code : Int, data : Any] : Nil
        (if (== id client/selected)
          (if (== code 200)
            (apply_snapshot client data)
            else (show_error client data))))))
  (if (!= id "")
    (api
      client
      "POST"
      $"${(api_root)}/sessions/${id}/open"
      {}
      (fn [code : Int, data : Any] : Nil
        (if (!= code 200) (show_error client data))))))

(fn pin_session [client : Client] : Nil
  (var id client/selected)
  (if (== id "") (return))
  (var tab (session_tab client id))
  (var cache : Any tab/cache)
  (var pinned : Bool false)
  (if ($present? cache/session/pinned) (set pinned cache/session/pinned))
  (api
    client
    "PATCH"
    $"${(api_root)}/sessions/${id}"
    {^pinned (! pinned) ^revision client/session_revision}
    (fn [code : Int, data : Any] : Nil
      (if (== code 200)
        (set cache/session data)
          (if (== id client/selected)
            (set client/session_revision data/revision)
            ($dom/set_text ($dom/element "pin_session") (if pinned "Pin" else "Unpin")))
        else
          (show_error client data)))))

(fn create [client : Client] : Nil
  (var draft
    (if (== client/selected "")
      ($dom/input_value client/prompt)
      else (?? (storage_get (draft_key "new")) "")))
  (request_session client "New conversation"
    (fn [code : Int, data : Any] : Nil
      (if (== code 201)
        (var id : Str data/id)
          (var attachments : MediaComposer client/media)
          (media_move attachments "" id)
          (select_session client id)
          (if (!= draft "")
            ($dom/set_input_value client/prompt draft)
            (remember_draft client))
          (storage_remove (draft_key "new"))
        else
          (show_error client data)))))

(fn send_pending [client : Client] : Nil
  (if (|| ($absent? client/pending) client/sending (! client/connected)) (return))
  (var pending : Any client/pending)
  (var session : Str pending/session)
  (var request_id : Str pending/request_id)
  (var already_seen false)
  (if ($present? client/round)
    (set already_seen (&& (== session client/selected)
      (== (string_or client/round/request_id "") request_id))))
  (if_not already_seen
    (set client/awaiting request_id) (set client/awaiting_session session))
  (set client/sending true)
  (update_controls client)
  (api client "POST" $"${(api_root)}/sessions/${session}/rounds" pending
    (fn [code : Int, data : Any] : Nil
      (set client/sending false)
      (if (== code 202)

          # POST acknowledges admission. A newer WebSocket completion must
          # never be overwritten by this potentially late accepted response.
          (var status : Str data/state)
          (if (terminal status) (acknowledge_run client data session))
          (if (== session client/selected)
            (var install ($absent? client/round))
            (if_not install
              (var current_seq : Int client/round/submission_seq)
              (var accepted_seq : Int data/submission_seq)
              (set install (< current_seq accepted_seq)))
            (if install (apply_run client session data)))
          (storage_remove "gene-harness/pending")
          (model_draft_admitted client session pending)
          (var submitted : Str pending/text)
          (var attachments : MediaComposer client/media)
          (var submitted_media : (List Any) [])
          (if ($present? pending/media) (set submitted_media pending/media))
          (media_admitted attachments session submitted_media)
          (if (== session client/selected)
            (if (== ($dom/input_value client/prompt) submitted)
                ($dom/set_input_value client/prompt "")
                  (storage_remove (draft_key session))
                else (remember_draft client))
            else
              (if (== (?? (storage_get (draft_key session)) "") submitted)
                (storage_remove (draft_key session))))
          (set client/pending nil)
          (set_hidden "commands" true)
          (notice client "")
        else
          (if (&& (== client/awaiting_session session) (== client/awaiting request_id))
            (set client/awaiting "")
            (set client/awaiting_session ""))
          (var error_code (string_or data/code ""))
          (if (|| (== code 400) (== code 404) (== code 409) (== code 410) (== code 413) (&& (== code 503) (|| (== error_code "recovery_required") (== error_code "unavailable"))))
            (storage_remove "gene-harness/pending")
            (set client/pending nil))
          (show_error client data)
          (if (== code 401)
            (set client/ready false)
              (set client/connected false)
              (set_hidden "auth_notice" false)
            elif ($absent? client/pending) (connect_socket client)
            else
              # Unknown outcomes keep their idempotency key. Reconnect checks
              # authentication and backs off before resolving the submission.
              (set client/connected false)
              (if ($present? client/socket)
                (var socket : EventTarget client/socket)
                ($ws/close socket))))
      (set_hidden "resolve_submission" ($absent? client/pending))
      (render_transcript client)
      (update_controls client))))

(fn stage_submission [client : Client, text : Str] : Nil
  (if (voice_pending? client)
    (notice client "Resolve the pending voice submission before sending another prompt.")
    (return))
  (var attachments : MediaComposer client/media)
  (set client/pending
    {
      ^session client/selected
      ^request_id ($browser/request_id)
      ^submission_seq client/next_seq
      ^text text ^media (media_ids attachments)})
  (attach_model_draft client client/pending client/selected)
  (if_not (storage_set "gene-harness/pending" ($json/stringify client/pending))
    (set client/pending nil)
    (notice
      client
      "Browser storage is required to safely recover a submission. Enable it and try again.")
    (return))
  (render_transcript client)
  (send_pending client))

# A card's Send submits a chat message with the card revisions the user saw;
# the host attaches that exact state, or refuses a changed card.
(fn stage_card_send [client : Client, text : Str, card : Any] : Nil
  (if (|| ($present? client/pending) client/sending)
    (notice client "Resolve the pending submission before sending a card.")
    (return))
  (var no_media : (List Any) [])
  (set client/pending
    {
      ^session client/selected
      ^request_id ($browser/request_id)
      ^submission_seq client/next_seq
      ^text text ^media no_media ^card card})
  (attach_model_draft client client/pending client/selected)
  (if_not (storage_set "gene-harness/pending" ($json/stringify client/pending))
    (set client/pending nil)
    (notice
      client
      "Browser storage is required to safely recover a submission. Enable it and try again.")
    (return))
  (render_transcript client)
  (send_pending client))

# A live card update replaces its block in place; a new card is appended.
(fn apply_card [client : Client, session : Str, card : Any] : Nil
  (if (!= session client/selected) (return))
  (var id (string_or card/id ""))
  (var created_seq : Int 0)
  (if ($present? card/created_seq) (set created_seq card/created_seq))
  (var block
    {^id $"${session}/card/${id}" ^seq ($to_str created_seq)
     ^round_id (string_or card/placement_round "") ^turn card/turn
     ^role "assistant" ^phase "card" ^kind "card" ^text ""
     ^card card ^order card/created_ms ^^durable})
  (var records : (List Any) [])
  (var found false)
  (for record in client/records
    (var record_id : Str record/id)
    (if (== record_id $"${session}/card/${id}")
      (set found true)
      (var previous : Any record/card)
      (var previous_definition : Int previous/definition_revision)
      (var previous_revision : Int previous/revision)
      (var next_definition : Int card/definition_revision)
      (var next_revision : Int card/revision)
      (if (|| (> next_definition previous_definition) (&& (== next_definition previous_definition) (>= next_revision previous_revision)))
        (records .push block)
      else
        (records .push record))
    else
      (records .push record)))
  (if_not found (records .push block))
  (set client/records records)
  (render_transcript client))

(fn apply_card_message [client : Client, session : Str, data : Any] : Nil
  (var card : Any data/card)
  (var event (string_or data/event ""))
  (var host : CardHost client/cards)
  (card_observed host session card)
  (if (== event "defined") (card_defined host session card))
  (if (!= session client/selected) (return))
  (var turn : Int card/turn)
  (var updated_turn : Int card/updated_turn)
  (if (&& (== event "defined") (!= turn updated_turn))
    (var card_id (string_or card/id ""))
    (var definition : Int card/definition_revision)
    (set client/records
      (merge_blocks
        client/records
        [
          {
            ^id $"${session}/card-update/${card_id}/${definition}"
            ^seq "0"
            ^round_id (string_or card/round "")
            ^turn updated_turn
            ^role "assistant"
            ^phase "card/update"
            ^kind "card/update"
            ^text (string_or card/title "")
            ^card_id card_id
            ^order card/updated_ms
            ^^durable}])))
  (apply_card client session card))

(fn send_command [client : Client, text : Str, ^clear clear : Bool = true, ^card card : Any = nil] : Nil
  (var session client/selected)
  (set client/sending true)
  (update_controls client)
  (var commands : CommandClient client/command_client)
  (dispatch_command ^card card ^clear_composer clear commands session text nil
    (fn [code : Int, data : Any] : Nil
      (set client/sending false)
      (if (!= code 202) (show_error client data))
      (update_controls client))))

(fn command_settled [client : Client, envelope : Any, receipt : Any] : Nil
  (if (&& (launcher_flag envelope/clear_composer) (== (string_or envelope/session "") client/selected) (== (string_or envelope/text "") ($dom/input_value client/prompt)))
    ($dom/set_input_value client/prompt "")
    (remember_draft client)
    (render_commands client)))

(fn execution_command [data : Any] : Bool
  (var name (string_or data/name ""))
  (|| (== name "sh") (== name "run") (== name "repl")))

(fn apply_command [client : Client, session : Str, data : Any] : Nil
  (if (!= session client/selected) (return))
  (var id : Str data/id)
  (var status : Str data/status)
  (var block_id $"${session}/${id}")
  (var text : Str (string_or data/display (string_or data/text "")))
  (if (&& (! (execution_command data)) (== text "") ($present? data/raw))
    (var command_name : Str (string_or data/name "command"))
    (var command_raw : Str (string_or data/raw ""))
    (set text $"/${command_name} ${command_raw}"))
  (if (&& (== status "running") (! (execution_command data)))
    (for previous in client/preview
      (var previous_id : Str previous/id)
      (if (== previous_id block_id)
        (var prior : Str previous/text)
        (set text ($to_str prior text)))))
  (apply_record
    client
    {
      ^id block_id
      ^round_id ""
      ^turn 0
      ^role "assistant"
      ^phase "command"
      ^input_id data/input_id
      ^mode_instance data/mode_instance
      ^name data/name ^raw data/raw ^command_id id
      ^exit data/exit ^seq ($to_str (dint data/start_seq))
      ^text text
      ^status status
      ^view data/view
      ^!durable})
  (if (!= status "running") (resolve_mode_receipt client [data]))
  (render_transcript client))

(fn mode_pending_key [session : Str] : Str
  $"gene-harness/mode-pending/${session}")

(fn resolve_mode_receipt [client : Client, records : (List Any)] : Nil
  (if (== client/selected "") (return))
  (if ($absent? client/mode_pending)
    (var saved : Str (?? (storage_get (mode_pending_key client/selected)) ""))
    (if (!= saved "") (set client/mode_pending (try ($json/parse saved) catch Error nil))))
  (if ($absent? client/mode_pending) (return))
  (var pending : Any client/mode_pending)
  (for record in records
    (if (&& (== record/input_id pending/input_id) (== record/mode_instance pending/instance))
      (storage_remove (mode_pending_key client/selected))
      (if (== ($dom/input_value client/prompt) (string_or pending/text ""))
        ($dom/set_input_value client/prompt "")
        (remember_draft client))
      (set client/mode_pending nil)
      (notice ^key "mode-input" ^scope client/selected client "")
      (notice client "Input receipt recovered.")
      (return)))
  (notice ^key "mode-input" ^scope client/selected ^^sticky
    client
    "Input outcome is unknown. Check the transcript; submit again to resolve the same input id."))

(fn send_mode_input [client : Client] : Nil
  (if (|| (! client/ready) (! client/connected) client/sending ($present? client/mode/running))
    (return))
  (var text ($dom/input_value client/prompt))
  (if (== (str/trim text) "") (return))
  (var pending : Any client/mode_pending)
  (if ($absent? pending)
    (set pending
        {
          ^session client/selected
          ^instance client/mode/instance
          ^input_id ($browser/request_id)
          ^text text})
    else
      (var previous_text : Str pending/text)
      (if (!= previous_text text)
        (notice client "Resolve the pending input before submitting another one.")
        (return)))
  (if_not (storage_set (mode_pending_key client/selected) ($json/stringify pending))
    (notice client "Browser storage is required to recover an input receipt.")
    (return))
  (set client/mode_pending pending)
  (set client/sending true)
  (remember_draft client)
  (update_controls client)
  (var session : Str pending/session)
  (api
    client
    "POST"
    $"${(api_root)}/sessions/${session}/mode/input"
    pending
    (fn [code : Int, data : Any] : Nil
      (set client/sending false)
      (var incomplete : Bool false)
      (var closed : Bool false)
      (if ($present? data/incomplete) (set incomplete data/incomplete))
      (if ($present? data/closed) (set closed data/closed))
      (if (|| (== code 202) (== code 200))
        (storage_remove (mode_pending_key session))
          (set client/mode_pending nil)
          (if incomplete
            (notice client "Incomplete form. Add the remaining code.")
          else
            (if (== ($dom/input_value client/prompt) (string_or pending/text ""))
              ($dom/set_input_value client/prompt "")
              (remember_draft client))
            (if closed (set client/mode nil))
            (notice client ""))
        else
          (if (&& (>= code 400) (< code 500))
            (storage_remove (mode_pending_key session))
            (set client/mode_pending nil)
            (if (== (string_or data/code "") "mode_closed") (set client/mode (?? data/mode nil))))
          (show_error client data))
      (update_controls client))))

(fn leave_mode [client : Client] : Nil
  (if (|| ($absent? client/mode) client/sending) (return))
  (var session client/selected)
  (var instance : Str client/mode/instance)
  (set client/sending true)
  (update_controls client)
  (api
    client
    "POST"
    $"${(api_root)}/sessions/${session}/mode/leave"
    {^instance instance}
    (fn [code : Int, data : Any] : Nil
      (set client/sending false)
      (if (== code 200)
        (set client/mode nil)
        (notice client "")
      else
        (show_error client data))
      (update_controls client))))

(fn action [client : Client] : Nil
  (if (|| client/sending client/action_cooldown) (return))
  (var executing (if ($absent? client/mode) client/server_busy else ($present? client/mode/running)))
  (if executing
    (stop client)
    else (send client)))

(fn send [client : Client] : Nil
  (if (|| (! client/ready) (! client/connected) client/sending) (return))
  (if (voice_pending? client)
    (notice client "Resolve the pending voice submission before sending another prompt.")
    (return))
  (if ($present? client/mode)
    (send_mode_input client)
    (return))
  (var raw ($dom/input_value client/prompt))
  (var input : Any (reviewed_voice_input client client/selected raw))
  (if (&& ($present? input) (!= (str/trim raw) ""))
    (var session client/selected)
    (voice_submit
      client
      session
      raw
      input
      (fn [code : Int, data : Any] : Nil
        (if (== code 202)
          (storage_remove (voice_review_key client session))
          (if (&& (== session client/selected) (== raw ($dom/input_value client/prompt)))
            ($dom/set_input_value client/prompt "")
            (remember_draft client))
        else
          (show_error client data))))
    (return))
  (var attachments : MediaComposer client/media)
  (if (&& (!= client/selected "") (str/starts_with? raw "/") (! (str/starts_with? raw "//")))
    (if (media_has attachments)
      (notice client "Remove attachments before running a slash command.")
      (return))
    (send_command client raw)
    (return))
  (if (!= client/input_id "")
    (notice client "Answer or cancel the pending question first.")
    (return))
  (if (|| (! client/ready) (! client/connected) client/sending client/busy) (return))
  (if ($present? client/pending)
    (send_pending client)
    (return))
  (var text ($dom/input_value client/prompt))
  (if (media_blocked attachments)
    (notice client "Wait for uploads to finish, or remove any failed attachment.")
    (return))
  (if (&& (== (str/trim text) "") (! (media_has attachments))) (return))
  (if (! (model_allows_submit client)) (return))
  (remember_draft client)
  (if (== client/selected "")
    (request_session
      client
      "New conversation"
      (fn [code : Int, data : Any] : Nil
        (if (== code 201)
          (var id : Str data/id)
          (media_move attachments "" id)
          (select_session client id)
          ($dom/set_input_value client/prompt text)
          (remember_draft client)
          (storage_remove (draft_key "new"))
          (if (&& (str/starts_with? text "/") (! (str/starts_with? text "//")))
            (set client/queued_prompt text)
            (set client/queued_submit true)
          else
            (stage_submission client text))
        else
          (show_error client data))
        (update_controls client)))
    (return))
  (stage_submission client text))

(fn stop [client : Client] : Nil
  (if ($present? client/mode)
    (if ($absent? client/mode/running) (return))
    (var command_id : Str client/mode/running)
    (api
      client
      "POST"
      $"${(api_root)}/sessions/${client/selected}/commands/${command_id}/cancel"
      {}
      (fn [code : Int, data : Any] : Nil
        (if (== code 200) (notice client "Stop requested.") else (show_error client data))))
    (return))
  (if ($absent? client/round) (return))
  (var id : Str client/round/id)
  (api
    client
    "POST"
    $"${(api_root)}/sessions/${client/selected}/rounds/${id}/cancel"
    {}
    (fn [code : Int, data : Any] : Nil
      (if (== code 200)
        (notice client "Stop requested.")
        else
          (show_error client data)))))

# The host asks one tab to act; every tab sees the frame and only the named one answers.
(fn client_operation [client : Client, operation : Str, args : Any] : Any
  (var ui : UiClient client/ui)
  (if (== operation "view/state")
    (return {^active ui/navigation/active ^presentation ui/navigation/presentation
             ^last_view ui/navigation/last_view ^session client/selected}))
  (if (== operation "view/navigate")
    (return {^ok (navigate ui (string_or args/view "") (string_or args/presentation ""))}))
  (if (== operation "action/invoke")
    (var id (string_or args/id ""))
    (if (== id "composer/send")
      (send client)
      (return {^^ok}))
    (if (== id "composer/close_commands")
      (set_hidden "commands" true)
      (return {^^ok}))
    (return {^ok (run_action ui id)}))
  nil)

(fn answer_client_request [client : Client, data : Any] : Nil
  (if (!= (string_or data/client "") (client_page_id client)) (return))
  (var operation (string_or data/operation ""))
  (var known (|| (== operation "view/state") (== operation "view/navigate") (== operation "action/invoke")))
  (var reply (if known
    (try
        {^id data/id ^^ok ^result (client_operation client operation data/args)}
        catch Error
          {^id data/id ^!ok ^error "The browser could not run this operation."})
    else {^id data/id ^!ok ^error $"Unknown client operation ${operation}."}))
  ($http/request "POST" $"${(api_root)}/clients/reply" ($json/stringify reply)
    {^content-type "application/json" ^x-csrf-token client/csrf}
    (fn [status : Int, body : Str] : Nil nil)))

(fn socket_message [client : Client, text : Str] : Nil
  (try
    (var message : Any ($json/parse text))
    (var version : Int message/protocol)
    (if (!= version protocol_version)
      (set client/ready false)
      (set client/connected false)
      (update_controls client)
      (notice ^key "connection" ^^sticky
        client
        "Reload the page to use the current server version.")
      (return))
    (var sequence_text : Str message/sequence)
    (var sequence : Int ($json/parse sequence_text))
    (if (!= sequence (+ client/message_sequence 1))
      (connect_socket client)
      (return))
    (set client/message_sequence sequence)
    (set client/epoch message/epoch)
    (var kind : Str message/type)
    (var session : Str message/session)
    (var data : Any message/data)
    (if (== kind "models/catalog")
      (invalidate_status client client/epoch ""))
    (if (== kind "keyboard/changed")
      (var keyboard_ui : UiClient client/ui)
      (set keyboard_ui/keyboard (copy_map data/bindings)))
    (if (== kind "client/request")
      (answer_client_request client data))
    (if (== kind "status")
      (apply_status client data)
      elif (== kind "session/list")
        (var center : NotificationCenter client/center)
        (invalidate_questions center)
        (refresh_sessions client)
      elif (== kind "attention")
        (set client/needs_attention data/sessions)
        (render_sessions client)
      elif (== kind "session")
        (upsert_session client data)
        (if (== session client/selected)
          (set client/session_revision data/revision)
          (var title : Str data/title)
          (render_session_title client title data/channel)
          (var selected_tab (session_tab client session))
          (set selected_tab/cache/session data)
          (update_controls client))
      elif (== kind "snapshot")
        (if (== session client/selected) (apply_snapshot client data))
      elif (== kind "mode/state")
        (if (== session client/selected)
          (set client/mode data)
          (render_tabs client)
          (update_controls client))
      elif (|| (== kind "turn") (== kind "reply"))
        (if (== session client/selected) (apply_record client data))
      elif (== kind "records")
        (if (== session client/selected)
          (var records : (List Any) data/records)
          (var cursor : Str data/cursor)
          (apply_records client records cursor))
      elif (== kind "round/state")
        (apply_run client session data)
      elif (== kind "card")
        (apply_card_message client session data)
      elif (== kind "command")
        (apply_command client session data)
      elif (== kind "stopped")
        (var restarting : Bool data/restart)
        (set client/ready restarting)
        (set client/connected false)
        (var stopped_message : Str data/message)
        (notice ^key "connection" ^^sticky client stopped_message)
        (controls client)
      elif (== kind "restarted")
        (notice client "Harness restarted.")
      elif (== kind "error")
        (show_error client data)
      elif (== kind "resync")
        (var socket : EventTarget client/socket)
        ($ws/close socket)
      elif (== kind "ready")
        (set client/connected true)
        (notice ^key "connection" client "")
        (update_controls client)
        (var questions : QuestionEditors client/questions)
        (resume_replies questions)
        (if ($present? client/pending) (send_pending client))
        (if (|| client/queued_submit (!= client/queued_prompt ""))
          (var queued client/queued_prompt)
          (set client/queued_prompt "")
          (set client/queued_submit false)
          (if (&& (str/starts_with? queued "/") (! (str/starts_with? queued "//")))
            (send_command client queued)
          else
            (stage_submission client queued))))
  catch Error
    (notice ^key "connection" ^^sticky client "Refreshing the live connection…")
    (connect_socket client)))

(fn reconnect_socket [client : Client, epoch : Int] : Nil
  ($time/after 2500.0 (fn [] : Nil
    (if (|| (! client/ready) (!= epoch client/socket_epoch)) (return))
    # Reconnection checks cookie expiry. Connected streams refresh status only
    # on workspace invalidation or tab selection, without timer polling.
    (api client "GET" $"${(api_root)}/status" nil
      (fn [code : Int, data : Any] : Nil
        (if (!= epoch client/socket_epoch) (return))
        (match code
          when 200 (set client/csrf data/csrf) (connect_socket client)
          when 401
            (set client/ready false)
            (set_hidden "auth_notice" false)
            (show_error client data)
            (update_controls client)
          else (reconnect_socket client epoch)))))))

(fn connect_socket [client : Client] : Nil
  (connect_stream client (session_tab client client/selected)))

(fn connect_stream [client : Client, tab : SessionTab] : Nil
  (if (|| (! client/ready) tab/closed) (return))
  (set tab/socket_epoch (+ tab/socket_epoch 1))
  (var epoch tab/socket_epoch)
  (set tab/connected false)
  (set tab/sequence 0)
  (if ($present? tab/socket)
    (var old : EventTarget tab/socket)
    ($ws/close old))
  (if (== tab/id client/selected)
    (set client/connected false)
    (update_controls client))
  (var origin ($browser/origin))
  (var parts : (List Str) (str/split origin "://"))
  (var scheme (if (== parts/0 "https") "wss" else "ws"))
  (var socket
    ($ws/connect
      ($to_str
        $"${scheme}://${parts/1}${(api_root)}/events?session=${($url/encode_component tab/id)}&client_id=${(client_page_id client)}"
        (if client/safe_ui
          "&ui=default"
          else ""))))
  (set tab/socket socket)
  (if (== tab/id client/selected)
    (set client/socket socket)
    (set client/socket_epoch epoch))
  ($time/after
    10000.0
    (fn [] : Nil
      (if (&& client/ready (== epoch tab/socket_epoch) (! tab/connected)) ($ws/close socket))))
  ($ws/on_text
    socket
    (fn [text : Str] : Nil
      (if (== epoch tab/socket_epoch) (stream_message client tab text))))
  ($ws/on_close
    socket
    (fn [] : Nil
      (if (|| (!= epoch tab/socket_epoch) tab/closed) (return))
      (interrupt_output (live_store client) tab/id) (schedule_live_output client)
      (set tab/connected false)
      (if (== tab/id client/selected)
        (set client/connected false)
        (update_controls client)
        (if client/ready
          (notice ^key "connection" ^^sticky client "Reconnecting… Your draft is saved.")))
      (if client/ready (reconnect_stream client tab epoch)))))

(fn reconnect_stream [client : Client, tab : SessionTab, epoch : Int] : Nil
  ($time/after
    1500.0
    (fn [] : Nil
      (if (|| (! client/ready) tab/closed (!= epoch tab/socket_epoch)) (return))
      (api
        client
        "GET"
        $"${(api_root)}/status"
        nil
        (fn [code : Int, data : Any] : Nil
          (if (|| tab/closed (!= epoch tab/socket_epoch)) (return))
          (match code
            when 200
              (set client/csrf data/csrf)
              (connect_stream client tab)
            when 401
              (set client/ready false)
              (set_hidden "auth_notice" false)
              (show_error client data)
            else
              (reconnect_stream client tab epoch)))))))

(fn handle_log_frame [client : Client, message : Any] : Nil
  # Diagnostics use their own sequence and must never disturb state sequencing.
  (let version : Int message/protocol)
  (let epoch : Str message/epoch)
  (if (|| (!= version protocol_version) (!= epoch client/epoch))
    (return))
  (try (client/log_sink message) catch Throwable nil)
  nil)

(fn stream_message [client : Client, tab : SessionTab, text : Str] : Nil
  (try
    (var message : Any ($json/parse text))
    (let frame_kind : Str message/type)
    (if (|| (== frame_kind "log") (== frame_kind "log/gap"))
      (handle_log_frame client message)
      (return))
    (var version : Int message/protocol)
    (var sequence_text : Str message/sequence)
    (var sequence : Int ($json/parse sequence_text))
    (if (|| (!= version protocol_version) (!= sequence (+ tab/sequence 1)))
      (interrupt_output (live_store client) tab/id)
      (schedule_live_output client)
      (connect_stream client tab)
      (return))
    (ensure_feature_host client)
    (set tab/sequence sequence)
    (var server_epoch : Str message/epoch)
    (var output_store (live_store client))
    (var previous_output_epoch output_store/epoch)
    (if (! (output_epoch output_store server_epoch)) (return))
    (if (!= previous_output_epoch server_epoch) (schedule_live_output client))
    (if (&& (!= tab/server_epoch "") (!= tab/server_epoch server_epoch) (== tab/id client/selected))
      (notice client "Harness restarted."))
    (set tab/server_epoch server_epoch)
    (var kind : Str message/type)
    (var session : Str message/session)
    (var data : Any message/data)
    (if (== kind "console")
      (if (== session tab/id) (live_console client session data))
      (if (== tab/id client/selected) (set client/message_sequence sequence))
      (if (== session tab/id) (browser_event client kind session data))
      (return))
    (if (== kind "session/deleted")
      (var observed_here (|| (== session tab/id) (== tab/id client/selected)))
      (forget_session client (string_or data/id ""))
      (if observed_here (browser_event client kind session data))
      (return))
    (if (== session tab/id) (observe_output output_store session kind data))
    (var ui : UiClient client/ui)
    (if (|| (== session tab/id) (&& (== session "") (== tab/id client/selected)))
      (browser_event client kind session data))
    (var center : NotificationCenter client/center)
    (if (!= center/epoch server_epoch)
      (set center/epoch server_epoch)
      (invalidate_questions center))
    (var inbox : ProducerInbox client/inbox)
    (producer_event inbox kind server_epoch data)
    (if (== kind "snapshot") (center_snapshot center session data))
    (if (== kind "round/state") (invalidate_questions center session))
    (if (== kind "command")
      (var confirmations : Confirmations client/confirmations)
      (command_confirmation confirmations session data))
    (ui_event ui kind data)
    (if (== kind "ui/state") (sync_plugin_styles client))
    (if ($present? client/browser_appearance)
      (var appearance : BrowserAppearance client/browser_appearance)
      (appearance_event appearance kind data (== tab/id client/selected)))
    (if (&& (== tab/id client/selected) (== kind "ui/state"))
      (invalidate_status client server_epoch (string_or data/data_revision "")))
    (if (== kind "ready") (set tab/connected true))
    (if (&& (== kind "card") (!= tab/id client/selected))
      (var other_host : CardHost client/cards)
      (card_observed other_host session data/card)
      (if (== (string_or data/event "") "defined") (card_defined other_host session data/card)))
    (if (== tab/id client/selected)
      (set client/message_sequence (- sequence 1))
        (socket_message client text)
        (save_tab client)
      else
        (var cache : Any tab/cache)
        (if (&& (== kind "snapshot") (== session tab/id))
          (var incoming : (List Any) data/records)
          (var previous : (List Any) cache/records)
          (set data/records (historical_records (delegation_snapshot incoming previous)))
          (set data/preview (historical_records data/preview))
          (set tab/cache data)
          (set tab/title data/session/title))
        (if (&& (== session tab/id) (|| (== kind "turn") (== kind "reply")))
          (var preview : (List Any) cache/preview)
          (set cache/preview (bounded_blocks (merge_blocks preview [data]) true)))
        (if (&& (== session tab/id) (== kind "round/state"))
          (set cache/round data)
          (var rounds : (List Any) cache/rounds)
          (set cache/rounds (merge_blocks rounds [data]))
          (acknowledge_run client data session))
        (if (&& (== session tab/id) (== kind "mode/state")) (set cache/mode data))
        (if (&& (== session tab/id) (== kind "command"))
          (var id : Str data/id)
          (var output (string_or data/display (string_or data/text "")))
          (var command_preview : (List Any) cache/preview)
          (set cache/preview
            (bounded_blocks
              (merge_blocks
                command_preview
                [
                  {
                    ^id $"${session}/${id}"
                    ^round_id ""
                    ^turn 0
                    ^role "assistant"
                    ^phase "command"
                    ^name data/name
                    ^raw data/raw
                    ^command_id id
                    ^mode_instance data/mode_instance
                    ^input_id data/input_id
                    ^exit data/exit
                    ^seq ($to_str (dint data/start_seq))
                    ^text output
                    ^status data/status
                    ^view data/view
                    ^!durable}])
              true))))
    (render_tabs client)
  catch Error
    (connect_stream client tab)))

(fn authenticated [client : Client, data : Any] : Nil
  (set client/csrf data/csrf)
  (set client/ready true)
  (set_hidden "auth_notice" true)
  (var saved : Str (?? (storage_get "gene-harness/pending") ""))
  (if (!= saved "")
    (set client/pending (try ($json/parse saved) catch Error nil)))
  (if ($present? client/pending)
    (var id : Str client/pending/session)
    (set client/selected id))
  (var attachments : MediaComposer client/media)
  (media_select attachments client/selected)
  # A direct conversation URL needs the same draft initialization as navigation.
  (if (== client/generation 0)
    (set client/generation 1)
    (var key (draft_key (if (== client/selected "") "new" else client/selected)))
    ($dom/set_input_value client/prompt (?? (storage_get key) "")))
  (connect_socket client))

(fn authenticate [client : Client] : Nil
  (var token (query_value ($browser/hash) "token"))
  # Remove the owner token fragment without losing a view/presentation deep link.
  ($browser/replace_url ($to_str "/" ($browser/search)))
  (if (!= token "")
    (api
      client
      "POST"
      $"${(api_root)}/auth/exchange"
      {^token token}
      (fn [code : Int, data : Any] : Nil
        (if (== code 200)
          (authenticated client data)
          else
            (show_error client data)
            (set_hidden "auth_notice" false))))
    else (api
      client
      "GET"
      $"${(api_root)}/status"
      nil
      (fn [code : Int, data : Any] : Nil
        (if (== code 200)
          (authenticated client data)
          else
            (show_error client data)
            (set_hidden "auth_notice" false))))))

(fn main [root : EventTarget] : Nil
  # The server renders the page in the workspace's current theme.
  (var document ($dom/element "harness_document"))
  (var initial_mode : Str "light")
  (if ($present? document/dataset/mode) (set initial_mode document/dataset/mode))
  (var client
    (Client ^browser_appearance nil ^browser_clients nil ^command_client nil ^log_sink (fn [message : Any] : Nil nil) ^selected (query_value ($browser/search) "session") ^csrf "" ^cursor "" ^next_seq "1" ^epoch "" ^!ready ^!sending ^!connected ^!server_busy ^awaiting "" ^awaiting_session "" ^queued_prompt "" ^!queued_submit ^message_sequence 0 ^!busy ^^autoscroll ^generation 0 ^!has_older ^!loading_older ^socket_epoch 0 ^!viewing_history ^records [] ^preview [] ^sessions [] ^needs_attention [] ^filter_epoch 0 ^tabs [] ^expanded [] ^rounds [] ^input_id "" ^!answering ^round nil ^mode nil ^mode_pending nil ^!action_cooldown ^!was_executing ^pending nil ^status nil ^status_epoch "" ^status_revision "" ^status_generation 0 ^components [] ^component_buttons {} ^socket nil ^session_revision "1" ^ui nil ^media nil ^notices (create_notices) ^confirmations nil ^questions nil ^center nil ^inbox nil ^safe_ui (== (query_value ($browser/search) "ui") "default") ^root root ^list ($dom/element "sessions") ^transcript ($dom/element "transcript") ^prompt ($dom/element "prompt") ^notice ($dom/element "notice") ^title ($dom/element "conversation_title") ^appearance initial_mode ^style_signature "" ^cards nil))
  (set client/command_client
    (create_commands
      ^settled (fn [envelope : Any, receipt : Any] : Nil (command_settled client envelope receipt))
      (fn [method : Str, path : Str, payload : Any, done : (Fn [Int Any] Nil)] : Nil
        (api client method path payload done))
      (fn [message : Str] : Nil
        (var commands : CommandClient client/command_client)
        (set_hidden "command_receipt_recover" ($absent? commands/pending))
        (set_hidden "command_receipt_discard" ($absent? commands/pending))
        (if ($absent? commands/pending)
          (var discard ($dom/element "command_receipt_discard"))
          (set discard/open false))
        (var forget ($dom/element "command_receipt_forget"))
        (set forget/disabled commands/resolving)
        (notice ^key "command-recovery" ^sticky ($present? commands/pending) client message)
        (if (&& ($present? client/browser_clients) ($present? client/status))
          (var browsers : BrowserClients client/browser_clients)
          (update_clients browsers (launcher_items client/status/browser_clients) client/status)))))
  (ensure_feature_host client)
  (initialize_voice_feature client)
  (set client/browser_clients (create_clients root client/safe_ui (browser_bridge client)))
  ($dom/add_event_listener ($dom/element "command_receipt_recover") "click"
    (fn [event : Any] : Nil
      (var commands : CommandClient client/command_client)
      (recover_command commands)))
  ($dom/add_event_listener ($dom/element "command_receipt_forget") "click"
    (fn [event : Any] : Nil
      (var commands : CommandClient client/command_client)
      (forget_command commands)))
  ($dom/add_event_listener ($dom/element "session_creation_acknowledge") "click"
    (fn [event : Any] : Nil (acknowledge_creation client)))
  (set client/media
    (create_media client/selected
      (fn [name : Str, data : Str, done : (Fn [Int Any] Nil)] : Nil
        (api client "POST" $"${(api_root)}/media" {^name name ^data data} done))
      (fn [] : Nil (update_controls client))))
  (set client/questions
    (create_question_editors
      client/notices
      (fn [method : Str, path : Str, payload : Any, done : (Fn [Int Any] Nil)] : Nil
        (api client method path payload done))
      (fn [session : Str] : Nil
        (var center : NotificationCenter client/center)
        (invalidate_questions center session))
      ^stage (fn [text : Str] : Nil (stage_prompt client text))))
  (var questions : QuestionEditors client/questions)
  (set client/cards
    (create_card_host
      (fn [method : Str, path : Str, payload : Any, done : (Fn [Int Any] Nil)] : Nil
        (api client method path payload done))
      (fn [session : Str, text : Str, card : Any] : Nil
        (if (== session client/selected) (send_command ^!clear ^card card client text)))
      (fn [session : Str, text : Str, card : Any] : Nil
        (if (== session client/selected) (stage_card_send client text card)))
      (fn [text : Str] : Nil (stage_prompt client text))
      (fn [session : Str, card : Any] : Nil (apply_card client session card))))
  (set client/center
    (create_center
      client/notices
      questions
      (fn [method : Str, path : Str, payload : Any, done : (Fn [Int Any] Nil)] : Nil
        (api client method path payload done))
      (fn [session : Str] : Nil
        (select_session client session)
        (var ui : UiClient client/ui)
        (navigate ui "harness"))))
  (var center : NotificationCenter client/center)
  (set client/inbox
    (create_producer_inbox
      client/notices
      client/safe_ui
      (fn [method : Str, path : Str, payload : Any, done : (Fn [Int Any] Nil)] : Nil
        (api client method path payload done))
      (fn [count : Int] : Nil
        (set center/new_messages count)
        (update_center_count center))
      (fn [reference : Any] : Nil
        (var session (string_or reference/session ""))
        (if (!= session "") (select_session client session))
        (var ui : UiClient client/ui)
        (if ($absent? reference/component)
          (navigate ui "harness")
          else (open_reference ui reference))
        (if ($present? reference/round)
          (var round : Str reference/round)
          (client/expanded .push round)
          (render_transcript client))
        nil)
      (fn [session : Str, text : Str] : Nil
        (if (&& (!= session "") (!= session client/selected)) (select_session client session))
        (stage_prompt client text))))
  (var inbox : ProducerInbox client/inbox)
  (set center/on_open (fn [] : Nil (opened_inbox inbox)))
  (set client/confirmations
    (create_confirmations
      ($dom/element "confirmations")
      client/notices
      (fn [method : Str, path : Str, payload : Any, done : (Fn [Int Any] Nil)] : Nil
        (var parts ($str/split path "/"))
        (if (&& (== method "POST") (== parts/.size 6) (== parts/5 "commands"))
          (var commands : CommandClient client/command_client)
          (dispatch_command
            commands
            parts/4
            (string_or payload/text "")
            payload/expected_command
            done)
          (return))
        (api client method path payload done))))
  (set client/ui
    (create_ui
      root
      client/safe_ui
      client/notices
      (fn [method : Str, path : Str, payload : Any, done : (Fn [Int Any] Nil)] : Nil
        (api client method path payload done))
      (fn [id : Str] : Nil
        (select_session client id))
      (fn [command : Str] : Nil
        (component_command client command))
      (fn [text : Str] : Nil
        (stage_prompt client text))
      client/appearance))
  (if ($present? client/browser_clients)
    (var outlet_browsers : BrowserClients client/browser_clients)
    (var outlet_ui : UiClient client/ui)
    (set outlet_ui/outlet_sync
      (fn [outlets : (List Any)] : Nil
        (update_outlets outlet_browsers outlets (outlet_context client)))))
  (set client/editor
    (create_editor_panel
      root
      (fn [method : Str, path : Str, payload : Any, done : (Fn [Int Any] Nil)] : Nil
        (api client method path payload done))
      (fn [text : Str] : Nil (stage_prompt client text))))
  # api already carries safe-UI admission for this document.
  (var appearance (start_appearance
    (fn [method : Str, path : Str, payload : Any, done : (Fn [Int Any] Nil)] : Nil
      (api client method path payload done))
    (fn [answer : Any] : Nil
      (apply_appearance client answer/rendered/mode))
    ^on_error (fn [error : Any] : Nil (show_error client error))
    ^report (fn [answer : Any] : Nil
      (if ($present? client/socket)
        (var socket : EventTarget client/socket)
        (if ($ws/open? socket)
          ($ws/send socket ($json/stringify {^type "appearance_report" ^saved answer/saved ^rendered answer/rendered}))))
      )
    ^theme_toggle false))
  (set client/browser_appearance appearance)
  (var appearance_ui : UiClient client/ui)
  (set appearance_ui/browser_appearance appearance)
  ($dom/add_event_listener ($dom/element "ui_default_link") "click"
    (fn [event : Any] : Nil
      (go $"/ui/default?session=${($url/encode_component client/selected)}")))
  ($dom/add_event_listener ($dom/window) "popstate"
    (fn [event : Any] : Nil
      (var search ($browser/search))
      (var session (query_value search "session"))
      (var view (query_value search "view"))
      (var presentation (query_value search "presentation"))
      (if (== view "") (set view "harness"))
      (if (!= session client/selected) (select_session client session))
      (var ui : UiClient client/ui)
      (if_not (navigate ui view presentation false)
        (navigate ui "harness" "" false))))
  ($dom/add_event_listener
    ($dom/element "composer")
    "submit"
    (fn [event : Any] : Nil
      ($dom/prevent_default event)
      (action client)))
  ($dom/add_event_listener
    client/prompt
    "keydown"
    (fn [event : Any] : Nil
      (var composer_ui : UiClient client/ui)
      (var chord (event_chord event))
      (if (== chord (action_chord composer_ui "composer/close_commands" "Escape"))
        (set_hidden "commands" true))
      (if (&& (== chord (action_chord composer_ui "composer/send" "Enter")) (! ($event/is_composing event)))
        ($dom/prevent_default event)
        (send client))))
  ($dom/add_event_listener
    client/prompt
    "input"
    (fn [event : Any] : Nil
      (remember_draft client)
      (render_commands client)))
  ($dom/add_event_listener
    ($dom/element "create_session")
    "click"
    (fn [event : Any] : Nil
      (create client)))
  ($dom/add_event_listener
    ($dom/element "session_filter")
    "input"
    (fn [event : Any] : Nil
      ($time/after 300.0 (fn [] : Nil (refresh_sessions client)))))
  (for id in ["kind_filter" "status_filter" "trigger_filter" "since_filter" "until_filter"]
    ($dom/add_event_listener
      ($dom/element id)
      "change"
      (fn [event : Any] : Nil
        (refresh_sessions client))))
  ($dom/add_event_listener
    ($dom/element "leave_mode")
    "click"
    (fn [event : Any] : Nil
      (leave_mode client)))
  ($dom/add_event_listener
    ($dom/element "resolve_submission")
    "click"
    (fn [event : Any] : Nil
      (send_pending client)))
  ($dom/add_event_listener
    ($dom/element "new_output")
    "click"
    (fn [event : Any] : Nil
      (if client/viewing_history
        (select_session client client/selected)
      else
        ($dom/scroll_end client/transcript)
        (set_hidden "new_output" true))))
  ($dom/add_event_listener
    client/transcript
    "scroll"
    (fn [event : Any] : Nil
      (set client/autoscroll ($dom/near_end client/transcript 80.0))))
  ($dom/add_event_listener
    ($dom/element "status_button")
    "click"
    (fn [event : Any] : Nil
      (var drawer ($dom/element "status_drawer"))
      (var hidden : Bool drawer/hidden)
      (set drawer/hidden (! hidden))))
  ($dom/add_event_listener
    ($dom/element "close_status")
    "click"
    (fn [event : Any] : Nil
      (set_hidden "status_drawer" true)
      ($dom/focus ($dom/element "status_button"))))
  ($dom/add_event_listener
    ($dom/element "add_to_slack")
    "click"
    (fn [event : Any] : Nil (add_session_to_slack client)))
  ($dom/add_event_listener
    ($dom/element "rename_session")
    "click"
    (fn [event : Any] : Nil
      (set_hidden "rename_form" false)
      ($dom/set_input_value ($dom/element "rename_title") ($dom/text client/title))
      ($dom/focus ($dom/element "rename_title"))))
  ($dom/add_event_listener
    ($dom/element "pin_session")
    "click"
    (fn [event : Any] : Nil
      (pin_session client)))
  ($dom/add_event_listener
    ($dom/element "rename_form")
    "submit"
    (fn [event : Any] : Nil
      ($dom/prevent_default event)
      (api
        client
        "PATCH"
        $"${(api_root)}/sessions/${client/selected}"
        {^title ($dom/input_value ($dom/element "rename_title")) ^revision client/session_revision}
        (fn [code : Int, data : Any] : Nil
          (if (== code 200)
            (set_hidden "rename_form" true)
              (set client/session_revision data/revision)
              (var title : Str data/title)
              (render_session_title client title data/channel)
              (var tab (session_tab client client/selected))
              (set tab/title title)
              (var cache : Any tab/cache)
              (set cache/session data)
              (render_tabs client)
            else
              (show_error client data))))))
  ($dom/add_event_listener
    ($dom/window)
    "focus"
    (fn [event : Any] : Nil
      (if (&& client/ready (! client/sending)) (connect_socket client))))
  ($dom/add_event_listener
    ($dom/window)
    "hashchange"
    (fn [event : Any] : Nil
      (if (!= (query_value ($browser/hash) "token") "") (authenticate client))))
  (render_transcript client)
  (if (== client/selected "")
    ($dom/set_input_value client/prompt (?? (storage_get (draft_key "new")) "")))
  (controls client)
  (authenticate client))
