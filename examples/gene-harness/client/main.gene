(mod harness_client ^profile web)

(import ^from "./state.gene"
  [
    terminal
    merge_blocks
    query_value
    draft_key
    bounded_blocks
    step_key
    step_block
    marker_block
    run_label
    revision_before
    status_is_current])
(import ^from "../src/web/contract.gene" [protocol_version])
(import ^from "./view.gene" [block_view step_view run_status_view not_durable])
(import ^from "./components.gene" [render_slot])
(import ^from "./ui/model.gene" [UiClient UiNavigation])
(import ^from "./ui/router.gene" [navigate update_url])
(import ^from "./ui/navigation.gene" [view_url])
(import ^from "./notices.gene" [Notices create_notices put_notice remove_notice])
(import ^from "./confirmations.gene" [Confirmations create_confirmations command_confirmation])
(import ^from "./question_state.gene" [waiting_batch])
(import ^from "./question_editors.gene"
  [QuestionEditors create_question_editors mount_question question_ready resume_replies])
(import ^from "./notification_center.gene"
  [
    NotificationCenter
    create_center
    center_ready
    center_sessions
    center_snapshot
    invalidate_questions
    update_center_count])
(import ^from "./producer_inbox.gene"
  [ProducerInbox create_producer_inbox producer_ready producer_event opened_inbox])
(import ^from "./ui/controller.gene"
  [create : create_ui update : update_ui controls : ui_controls event : ui_event open_reference])

(type SessionTab ^props {^id Str ^title Str ^cache Any ^socket Any ^socket_epoch Int ^sequence Int ^connected Bool ^closed Bool ^expanded (List Str) ^server_epoch Str})

(type Client ^props {^selected Str ^csrf Str ^cursor Str ^next_seq Str ^epoch Str ^ready Bool ^connected Bool ^server_busy Bool ^awaiting Str ^awaiting_session Str ^queued_prompt Str ^message_sequence Int ^sending Bool ^busy Bool ^autoscroll Bool ^has_older Bool ^loading_older Bool ^socket_epoch Int ^viewing_history Bool ^generation Int ^records (List Any) ^preview (List Any) ^sessions (List Any) ^needs_attention (List Any) ^filter_epoch Int ^trigger_selected Str ^tabs (List SessionTab) ^expanded (List Str) ^rounds (List Any) ^input_id Str ^answering Bool ^round Any ^mode Any ^mode_pending Any ^action_cooldown Bool ^was_executing Bool ^pending Any ^status Any ^status_epoch Str ^status_revision Str ^status_generation Int ^components (List Any) ^component_buttons PropMap ^socket Any ^session_revision Str ^ui Any ^notices Notices ^confirmations Any ^questions Any ^center Any ^inbox Any ^safe_ui Bool ^root EventTarget ^list EventTarget ^transcript EventTarget ^prompt EventTarget ^notice EventTarget ^title EventTarget})

(fn render_plugin_slot [client : Client, target : EventTarget, slot : Str] : Bool
  (var components client/components)
  (var buttons : (List Any) [])
  (if_yes ($absent? client/component_buttons) (set client/component_buttons {}))
  (set client/component_buttons/%slot buttons)
  (render_slot
    target
    components
    slot
    (fn [text : Str] : Void
      (component_command client text))
    (fn [text : Str] : Void
      (if_yes (&& client/ready client/connected (! client/sending)) (stage_prompt client text)))
    (fn [target : Str, presentation : Str] : Void
      (var ui : UiClient client/ui)
      (navigate ui target presentation))
    (&& client/ready client/connected (! client/sending))
    buttons))

(fn render_extensions [client : Client] : Void
  (for slot in ["sidebar" "toolbar" "composer" "status"]
    (var target ($dom/element $"web_${slot}"))
    ($dom/clear target)
    (render_plugin_slot client target slot))
  (if_not ($absent? client/component_buttons)
    (var slots : PropMap client/component_buttons)
    (for [slot entries] in slots
      (var buttons : (List Any) entries)
      (for item in buttons
        (var button : EventTarget item/element)
        (var disabled : Bool item/disabled)
        (set button/disabled (|| disabled (! client/ready) (! client/connected) client/sending))))))

(fn component_command [client : Client, text : Str] : Void
  (if_yes (|| (! client/ready) (! client/connected) client/sending) (return))
  (if_yes (!= client/selected "")
    (send_command ^!clear client text)
    (return))
  (var draft ($dom/input_value client/prompt))
  (set client/sending true)
  (update_controls client)
  (api
    client
    "POST"
    "/api/v8/sessions"
    {^title "Plugin tools"}
    (fn [code : Int, data : Any] : Void
      (set client/sending false)
      (if (== code 201)
        (then
          (var id : Str data/id)
          (select_session client id)
          ($dom/set_input_value client/prompt draft)
          (remember_draft client)
          (send_command ^!clear client text))
        (else
          (show_error client data)))
      (update_controls client))))

(fn notice [client : Client, text : Str, ^key key : Str = "feedback", ^scope scope : Str = "", ^sticky sticky : Bool = false, ^severity severity : Str = "info"] : Void
  (put_notice client/notices client/notice "host" scope key text severity sticky {^session scope}))

(fn set_hidden [id : Str, hidden : Bool] : Void
  (var element ($dom/element id))
  (set element/hidden hidden))

(fn string_or [value : Any, fallback : Str] : Str
  (if_yes ($absent? value) (return fallback))
  (var text : Str value)
  text)

(fn api [client : Client, method : Str, path : Str, payload : Any, done : (Fn [Int Any] Void)] : Void
  (var address
    (if client/safe_ui
      ($to_str path (if (str/contains? path "?") "&ui=default" "?ui=default"))
      path))
  ($http/request
    method
    address
    ($json/stringify payload)
    {^content-type "application/json" ^x-csrf-token client/csrf}
    (fn [status : Int, body : Str] : Void
      (var result
        :
        Any
        (if (== body "")
          {^code "disconnected" ^message "Connection lost. Your draft is saved."}
          (try
            ($json/parse body)
          catch Any
            {^code "invalid_response" ^message "The Harness returned an unreadable response."})))
      (done status result))))

(fn show_error [client : Client, result : Any, ^session session : Str = ""] : Void
  (var message (string_or result/message "The request could not be completed."))
  (notice ^key "request-error" ^scope session ^^sticky ^severity "error" client message))

(fn session_tab [client : Client, id : Str] : SessionTab
  (for tab in client/tabs
    (if_yes (== tab/id id) (return tab)))
  (var empty : (List Any) [])
  (var tab
    (SessionTab ^id id ^title "Loading…" ^socket nil ^socket_epoch 0 ^sequence 0 ^!connected ^!closed ^expanded [] ^server_epoch "" ^cache {^session {^id id ^title "Loading…" ^revision "0"} ^records empty ^preview empty ^rounds empty ^cursor "" ^next_submission_seq "1" ^round nil ^questions nil ^!has_older}))
  (client/tabs .push tab)
  tab)

(fn save_tab [client : Client] : Void
  (var tab (session_tab client client/selected))
  (var cache : Any tab/cache)
  (set cache/records client/records)
  (set cache/preview client/preview)
  (set cache/rounds client/rounds)
  (set cache/round client/round)
  (set cache/mode client/mode)
  (set cache/cursor client/cursor)
  (set cache/next_submission_seq client/next_seq)
  (set cache/has_older client/has_older)
  (if_yes (== (string_or client/status/status_session "") client/selected)
    (set cache/status client/status))
  (set tab/expanded client/expanded))

(fn render_tabs [client : Client] : Void
  (var target ($dom/element "session_tabs"))
  ($dom/clear target)
  (for tab in client/tabs
    (if_yes (&& (! tab/closed) (!= tab/id ""))
      (var id tab/id)
      (var title tab/title)
      (var state : Str "")
      (var cache : Any tab/cache)
      (if_not ($absent? cache/round) (set state cache/round/state))
      (if_not ($absent? cache/mode) (set state cache/mode/label))
      ($dom/append
        target
        ($dom/render
          `(div ^class_name %(if (== id client/selected) "session_tab selected" "session_tab")
             (button ^type "button" ^on_click %(fn [event : Any] : Void (select_session client id))
               %title
               (small %state))
             (button ^type "button" ^aria-label %$"Close ${title}" ^on_click %(fn [event : Any] : Void (close_tab client id)) "×")))))))

(fn close_tab [client : Client, id : Str] : Void
  (var tab (session_tab client id))
  (set tab/closed true)
  (set tab/socket_epoch (+ tab/socket_epoch 1))
  (if_not ($absent? tab/socket)
    (var socket : EventTarget tab/socket)
    ($ws/close socket))
  (if_yes (== id client/selected)
    (var next "")
    (for candidate in client/tabs
      (if_yes (&& (! candidate/closed) (!= candidate/id ""))
        (set next candidate/id)
        (break)))
    (select_session client next))
  (render_tabs client))

(fn remember_draft [client : Client] : Void
  (if_yes (! client/ready) (return))
  (if_yes (&& (!= client/selected "") (== client/generation 0)) (return))
  (var key (draft_key (if (== client/selected "") "new" client/selected)))
  (if ($session_storage/set key ($dom/input_value client/prompt))
    (notice ^key "draft-storage" ^scope client/selected client "")
    (notice ^key "draft-storage" ^scope client/selected ^^sticky ^severity "error"
      client
      "Browser storage is unavailable. Keep this tab open to preserve your draft.")))

(fn controls [client : Client] : Void
  (if_not ($absent? client/inbox)
    (var inbox : ProducerInbox client/inbox)
    (producer_ready inbox (&& client/ready client/connected) client/selected))
  (if_not ($absent? client/questions)
    (var questions : QuestionEditors client/questions)
    (question_ready questions (&& client/ready client/connected)))
  (if_not ($absent? client/center)
    (var center : NotificationCenter client/center)
    (center_ready center (&& client/ready client/connected)))
  (var send ($dom/element "send"))
  (var in_mode (! ($absent? client/mode)))
  (var executing (if in_mode (! ($absent? client/mode/running)) client/server_busy))
  (if_yes (&& client/was_executing (! executing))
    (set client/action_cooldown true)
    ($time/after 250.0 (fn [] : Void (set client/action_cooldown false) (update_controls client))))
  (set client/was_executing executing)
  ($dom/set_class client/root "working" client/busy)
  ($dom/set_class client/root "sending" client/sending)
  ($dom/set_class client/root "input_mode" in_mode)
  (var command
    (&&
      (str/starts_with? ($dom/input_value client/prompt) "/")
      (! (str/starts_with? ($dom/input_value client/prompt) "//"))))
  (set send/disabled
    (||
      (! client/ready)
      (! client/connected)
      client/sending
      client/action_cooldown
      (&& (! executing) (! in_mode) (! command) (|| client/busy (!= client/input_id "")))))
  (var rename ($dom/element "rename_session"))
  (set rename/disabled
    (|| (! client/ready) (! client/connected) (== client/selected "") client/busy))
  (var pin ($dom/element "pin_session"))
  (set pin/disabled (|| (! client/ready) (! client/connected) (== client/selected "")))
  (var create_button ($dom/element "create_session"))
  (set create_button/disabled (|| (! client/ready) (! client/connected) client/sending))
  (set client/prompt/disabled (! client/ready))
  (set_hidden "leave_mode" (! in_mode))
  ($dom/set_text ($dom/element "input_mode_label") (if in_mode client/mode/label ""))
  ($dom/set_text
    ($dom/element "composer_hint")
    (if in_mode
      client/mode/hint
      "Shift+Enter for a new line · / for commands"))
  (set send/text_content
    (if client/sending
      "Sending…"
      (if executing
        "Stop"
        (if in_mode
          client/mode/submit_label
          (if ($absent? client/pending)
            "Send"
            "Resolve")))))
  ($dom/set_class send "stop" executing)
  (var mode "Local workspace")
  (if_not ($absent? client/status)
    (var model : Str client/status/model/model)
    (var provider : Str client/status/model/provider)
    (set mode (if client/status/offline "Command demo · no model" $"${model} · ${provider}"))
    (if_yes (&& (! client/status/offline) (! ($absent? client/status/model/effort)))
      (var effort : Str client/status/model/effort)
      (set mode $"${mode} · ${effort}")))
  (set_hidden "offline_notice" (|| ($absent? client/status) (! client/status/offline)))
  ($dom/set_text ($dom/element "mode") mode)
  (render_extensions client)
  (if_not ($absent? client/ui)
    (var ui : UiClient client/ui)
    (ui_controls ui (&& client/ready client/connected) client/selected)))

(fn render_input [client : Client] : Void
  (var batch (waiting_batch {^round client/round}))
  (set client/input_id (if ($absent? batch) "" (string_or batch/id "")))
  (set_hidden "input_panel" (== client/input_id ""))
  (if_not ($absent? client/questions)
    (var questions : QuestionEditors client/questions)
    (mount_question questions client/selected batch ($dom/element "input_fields") "conversation")))

(fn render_sessions [client : Client] : Void
  ($dom/clear client/list)
  (var attention ($dom/element "attention_sessions"))
  ($dom/clear attention)
  (if_not ($absent? client/center)
    (var center : NotificationCenter client/center)
    (center_sessions center client/sessions client/needs_attention))
  (for session in client/sessions
    (render_session_button client client/list session))
  (if_yes (== ($size client/sessions) 0)
    ($dom/append
      client/list
      ($dom/render `(p ^class_name "sidebar_empty" "Your conversations will appear here.")))))

(fn render_session_button [client : Client, target : EventTarget, session : Any] : Void
  (var title : Str session/title)
  (var id : Str session/id)
  (var kind : Str session/kind)
  (var status : Str session/status)
  (var cls (if (== id client/selected) "session selected" "session"))
  ($dom/append
    target
    ($dom/render
      `(button ^type "button" ^class_name %cls ^on_click %(fn [event : Any] : Void (select_session client id))
         (span ^class_name "session_name" %title)
         (span ^class_name "session_meta" %$"${kind} · ${status}")))))

(fn refresh_sessions [client : Client] : Void
  (if_not client/ready (return))
  (set client/filter_epoch (+ client/filter_epoch 1))
  (var epoch client/filter_epoch)
  (var query "?")
  (for row in [["q" "session_filter"] ["kind" "kind_filter"] ["status" "status_filter"] ["trigger" "trigger_filter"] ["since" "since_filter"] ["until" "until_filter"]]
    (var name : Str row/0)
    (var id : Str row/1)
    (var value ($dom/input_value ($dom/element id)))
    (if_yes (!= value "") (set query $"${query}${name}=${($url/encode_component value)}&")))
  (api
    client
    "GET"
    $"/api/v8/sessions${query}"
    nil
    (fn [code : Int, data : Any] : Void
      (if_yes (!= epoch client/filter_epoch) (return))
      (if (== code 200)
        (then
          (set client/sessions data/sessions)
          (set client/needs_attention data/needs_attention)
          (render_sessions client))
        (else
          (show_error client data))))))

(fn trigger_fields [] : Void
  (var kind ($dom/input_value ($dom/element "trigger_kind")))
  (set_hidden "trigger_every_field" (!= kind "heartbeat"))
  (set_hidden "trigger_at_field" (!= kind "scheduled"))
  (set_hidden "trigger_cron_field" (!= kind "cron"))
  (set_hidden "trigger_timezone_field" (!= kind "cron")))

(fn trigger_occurrences [client : Client, id : Str] : Void
  (set client/trigger_selected id)
  (var target ($dom/element "trigger_occurrences"))
  ($dom/clear target)
  ($dom/append target ($dom/render `(h3 %id)))
  ($dom/set_input_value ($dom/element "trigger_filter") id)
  (refresh_sessions client)
  (api
    client
    "GET"
    $"/api/v8/triggers/${($url/encode_component id)}/occurrences"
    nil
    (fn [code : Int, data : Any] : Void
      (if_yes (!= client/trigger_selected id) (return))
      (if (!= code 200)
        (then
          (show_error client data))
        (else
          (var occurrences : (List Any) data/occurrences)
          (for occurrence in occurrences
            (var state : Str occurrence/state)
            (var name : Str occurrence/id)
            (var session : Str occurrence/session)
            (var reason : Str (string_or occurrence/outcome (string_or occurrence/reason "")))
            ($dom/append
              target
              ($dom/render
                `(button ^type "button" ^class_name "occurrence" ^disabled %(|| (== state "due") (== state "skipped")) ^on_click %(fn [event : Any] : Void (set_hidden "trigger_drawer" true) (select_session client session))
                   (span %name)
                   (span %$"${state} ${reason}"))))))))))

(fn load_triggers [client : Client] : Void
  (api
    client
    "GET"
    "/api/v8/triggers"
    nil
    (fn [code : Int, data : Any] : Void
      (if (!= code 200)
        (then
          (show_error client data))
        (else
          (var target ($dom/element "trigger_list"))
          ($dom/clear target)
          (var definitions : (List Any) data/triggers)
          (if_yes (== ($size definitions) 0)
            ($dom/append target ($dom/render `(p "No triggers yet."))))
          (for definition in definitions
            (var id : Str definition/id)
            (var kind : Str definition/kind)
            ($dom/append
              target
              ($dom/render
                `(div ^class_name "trigger_row"
                   (button ^type "button" ^on_click %(fn [event : Any] : Void (trigger_occurrences client id))
                     %id
                     (small %kind))
                   (button ^type "button" ^on_click %(fn [event : Any] : Void (api client "DELETE" $"/api/v8/triggers/${($url/encode_component id)}" nil (fn [status : Int, result : Any] : Void (if (== status 200) (load_triggers client) (show_error client result))))) "Delete"))))))))))

(fn create_trigger [client : Client] : Void
  (try
    (var kind ($dom/input_value ($dom/element "trigger_kind")))
    (var keep : Int ($json/parse ($dom/input_value ($dom/element "trigger_keep"))))
    (var checkbox ($dom/element "trigger_continue"))
    (var continued : Bool checkbox/checked)
    (var data
      :
      Any
      {
        ^id ($dom/input_value ($dom/element "trigger_id"))
        ^kind kind
        ^request ($dom/input_value ($dom/element "trigger_request"))
        ^missed ($dom/input_value ($dom/element "trigger_missed"))
        ^overlap ($dom/input_value ($dom/element "trigger_overlap"))
        ^continue_session continued
        ^retention {^keep keep}})
    (if (== kind "heartbeat")
      (then
        (var every : Int ($json/parse ($dom/input_value ($dom/element "trigger_every"))))
        (set data/every_ms every)))
    (if (== kind "scheduled") (set data/at ($dom/input_value ($dom/element "trigger_at"))))
    (if_yes (== kind "cron")
      (set data/cron ($dom/input_value ($dom/element "trigger_cron")))
      (set data/timezone ($dom/input_value ($dom/element "trigger_timezone"))))
    (api
      client
      "POST"
      "/api/v8/triggers"
      data
      (fn [code : Int, result : Any] : Void
        (if (== code 201)
          (then
            (load_triggers client)
            (notice client "Trigger created."))
          (else
            (show_error client result)))))
  catch Any
    (notice client "Check the trigger's interval and retention values.")))

(fn expanded_block [client : Client, id : Str] : Bool
  (for previous in client/expanded
    (if_yes (== previous id) (return true)))
  false)

(fn toggle_block [client : Client, id : Str, opened : Bool] : Void
  (var kept : (List Str) [])
  (for previous in client/expanded
    (if_yes (!= previous id) (kept .push previous)))
  (if_yes opened (kept .push id))
  (set client/expanded kept))

(fn copy_text [client : Client, text : Str] : Void
  ($browser/copy
    text
    (fn [copied : Bool] : Void
      (notice client (if copied "Copied." "Select the text to copy it.")))))

(fn edit_prompt [client : Client, text : Str] : Void
  (if_yes (! ($absent? client/pending))
    (notice client "Resolve the pending submission before editing another prompt.")
    (return))
  ($dom/set_input_value client/prompt text)
  (remember_draft client)
  (render_commands client)
  ($dom/focus client/prompt))

(fn stage_prompt [client : Client, text : Str] : Void
  (var ui : UiClient client/ui)
  (navigate ui "harness")
  (var draft ($dom/input_value client/prompt))
  (if_yes (|| (== draft "") (== draft text)) (edit_prompt client text) (return))
  (var offer ($dom/element "prompt_offer"))
  ($dom/clear offer)
  (set offer/hidden false)
  ($dom/append offer ($dom/render
    `(div
      (p "A view offered a prompt. Keep your current draft, replace it, or append the offered text.")
      (pre %text)
      (button ^type "button" ^on_click %(fn [event : Any] : Void
        (edit_prompt client text) (set offer/hidden true)) "Replace draft")
      (button ^type "button" ^on_click %(fn [event : Any] : Void
        (edit_prompt client ($to_str ($dom/input_value client/prompt) "\n\n" text))
        (set offer/hidden true)) "Append to draft")
      (button ^type "button" ^on_click %(fn [event : Any] : Void
        (set offer/hidden true) ($dom/focus client/prompt)) "Keep draft")))))

(fn render_block [client : Client, target : EventTarget, block : Any] : Void
  (var id : Str block/id)
  (var generation client/generation)
  ($dom/append
    target
    (block_view
      block
      (not_durable block)
      (fn [text : Str] : Void
        (copy_text client text))
      (expanded_block client id)
      (fn [opened : Bool] : Void
        (if_yes (== generation client/generation) (toggle_block client id opened)))))
  (var phase : Str block/phase)
  (var status (string_or block/status ""))
  (if_yes (&& (== phase "command") (== status "running") ($absent? block/mode_instance))
    (var parts : (List Str) (str/split id "/"))
    (var command_id : Str parts/1)
    ($dom/append
      target
      ($dom/render
        `(button ^type "button" ^on_click %(fn [event : Any] : Void (api client "POST" $"/api/v8/sessions/${client/selected}/commands/${command_id}/cancel" {} (fn [code : Int, data : Any] : Void (if_yes (!= code 200) (show_error client data))))) "Cancel command"))))
  (var view : Any block/view)
  (if_yes (! ($absent? view))
    (var next : Any view/next)
    (if_yes (! ($absent? next))
      (var path : Str view/path)
      (var first : Int next)
      ($dom/append
        target
        ($dom/render
          `(button ^type "button" ^on_click %(fn [event : Any] : Void (send_command client $"/view ${path}:${first}")) "Next page"))))))

(fn render_run [client : Client, blocks : (List Any), run : Any] : Void
  (var target ($dom/render `(section ^class_name "run")))
  (var prompt "")
  (var i 0)
  (var generation client/generation)
  (while (< i ($size blocks))
    (var block : Any blocks/%i)
    (var role : Str block/role)
    (if_yes (== role "user") (set prompt block/text))
    (if (marker_block block)
      (then
        (set i (+ i 1)))
      (elif (step_block block)
        (var key (step_key block))
        (var step : (List Any) [])
        (while (< i ($size blocks))
          (var next : Any blocks/%i)
          (if (marker_block next)
            (then
              (set i (+ i 1)))
            (elif (&& (step_block next) (== (step_key next) key))
              (step .push next)
              (set i (+ i 1)))
            (else
              (break))))
        (var active false)
        (if_not ($absent? run)
          (var status : Str run/state)
          (set active (&& (! (terminal status)) (== i ($size blocks)))))
        ($dom/append
          target
          (step_view
            step
            (expanded_block client key)
            active
            (fn [text : Str] : Void
              (copy_text client text))
            (fn [id : Str] : Bool
              (expanded_block client id))
            (fn [id : Str, opened : Bool] : Void
              (if_yes (== generation client/generation) (toggle_block client id opened))))))
      (else
        (render_block client target block)
        (set i (+ i 1)))))
  (if_not ($absent? run)
    ($dom/append
      target
      (run_status_view run prompt (fn [text : Str] : Void (edit_prompt client text)))))
  ($dom/append client/transcript target))

(fn render_transcript [client : Client, ^prepend prepend : Bool = false] : Void
  (var old_top ($dom/scroll_top client/transcript))
  (var old_height ($dom/scroll_height client/transcript))
  (var follow (&& (! client/viewing_history)
    (|| client/autoscroll ($dom/near_end client/transcript 80.0))))
  # Keep expansion state only for retained blocks, across preview-to-durable
  # replacement and transcript refreshes. New model steps start collapsed.
  (var expanded : (List Str) [])
  (for id in client/expanded
    (var retained false)
    (for block in client/records
      (var block_id : Str block/id)
      (if_yes (|| (== block_id id) (== (step_key block) id)) (set retained true)))
    (for block in client/preview
      (var block_id : Str block/id)
      (if_yes (|| (== block_id id) (== (step_key block) id)) (set retained true)))
    (if_yes retained (expanded .push id)))
  (set client/expanded expanded)
  ($dom/clear client/transcript)
  (if_yes client/has_older
    ($dom/append client/transcript
      ($dom/render
        `(button ^type "button" ^class_name "older_messages" ^disabled %client/loading_older
           ^on_click %(fn [event : Any] : Void (load_older client))
           %(if client/loading_older "Loading…" "Load earlier messages")))))
  (if (&& (== ($size client/records) 0) (== ($size client/preview) 0))
    (if_not (render_plugin_slot client client/transcript "welcome")
      ($dom/append client/transcript
      ($dom/render
        `(div ^class_name "empty_state"
           (h2 "What would you like to work on?")
           (p "Start with an idea, a question, or a task.")
           (div ^class_name "suggestions"
             (button ^type "button"
               ^on_click %(fn [event : Any] : Void
                 ($dom/set_input_value client/prompt "What can you help me with?")
                 ($dom/focus client/prompt)) "Explore ideas"
               (span ^class_name "suggestion_symbol" ^aria-hidden "true" "→"))
             (button ^type "button"
               ^on_click %(fn [event : Any] : Void
                 ($dom/set_input_value client/prompt "/help")
                 ($dom/focus client/prompt)) "Browse commands"
               (span ^class_name "suggestion_symbol" ^aria-hidden "true" "/"))))))))
  (var all_visible : (List Any) client/records)
  # Durable records lead; append previews only when no durable version exists.
  (for block in client/preview
    (var found false)
    (for record in client/records (if_yes (== record/id block/id) (set found true)))
    (if_not found (set all_visible (merge_blocks all_visible [block]))))
  (var visible : (List Any) [])
  (var console "")
  (var count 0)
  (for block in all_visible
    (var phase : Str block/phase)
    (if (== phase "console")
      (then
        (var text : Str block/text)
        (var late : Bool false)
        (if_not ($absent? block/late) (set late block/late))
        (set console ($to_str console (if late "[late] " "") text))
        (set count (+ count 1)))
      (else (visible .push block))))
  ($dom/set_text ($dom/element "console_output") console)
  ($dom/set_text ($dom/element "console_summary") $"Console · ${count} entries")
  (var i 0)
  (var current_shown false)
  (while (< i ($size visible))
    (var first : Any visible/%i)
    (var id : Str first/round_id)
    (var blocks : (List Any) [])
    (while (< i ($size visible))
      (var block : Any visible/%i)
      (var block_run : Str block/round_id)
      (if_yes (!= block_run id) (break))
      (blocks .push block) (set i (+ i 1)))
    (var run : Any nil)
    (for receipt in client/rounds
      (var receipt_id : Str receipt/id)
      (if_yes (== receipt_id id) (set run receipt)))
    (if_not ($absent? client/round)
      (var current_id : Str client/round/id)
      (if_yes (== current_id id) (set run client/round) (set current_shown true)))
    (render_run client blocks run))
  (if_yes (&& (! ($absent? client/round)) (! current_shown))
    (var status : Str client/round/state)
    (if_not (terminal status) (render_run client [] client/round)))
  (if follow
    (then
      (if (&& (== client/records/.size 0) (== client/preview/.size 0))
        ($dom/set_scroll_top client/transcript 0.0)
        ($dom/scroll_end client/transcript))
      (set_hidden "new_output" true))
    (else
      ($dom/set_scroll_top client/transcript
        (if prepend (+ old_top (- ($dom/scroll_height client/transcript) old_height)) old_top))
      ($dom/set_text ($dom/element "new_output")
        (if client/viewing_history "Return to latest ↓" "New output ↓"))
      (set_hidden "new_output" false))))

(fn update_controls [client : Client] : Void
  (var state : Str (if ($absent? client/round) "" client/round/state))
  (set client/server_busy (== state "running"))
  (if ($absent? client/mode)
    (render_input client)
    (set_hidden "input_panel" true))
  (set client/busy
    (if ($absent? client/mode)
      (|| client/server_busy (!= client/awaiting ""))
      (! ($absent? client/mode/running))))
  (controls client))

(fn acknowledge_run [client : Client, run : Any, session : Str] : Void
  (if_yes ($absent? run) (return))
  (var request_id (string_or run/request_id ""))
  (if_yes (&& (== session client/awaiting_session) (== request_id client/awaiting))
    (set client/awaiting "")
    (set client/awaiting_session "")))

(fn refresh_status [client : Client] : Void
  (if_not client/ready (return))
  (set client/status_generation (+ client/status_generation 1))
  (var generation client/status_generation)
  (var session client/selected)
  # Coalesce a publication's invalidations and drop late requests after a tab
  # switch or another workspace update. This is event-driven, not polling.
  ($time/after 25.0 (fn [] : Void
    (if_yes (!= generation client/status_generation) (return))
    (api client "GET" $"/api/v8/status?session=${($url/encode_component session)}" nil
      (fn [code : Int, data : Any] : Void
        (if_yes (|| (!= generation client/status_generation) (!= session client/selected)) (return))
        (if (== code 200) (apply_status client data) (show_error client data)))))))

(fn invalidate_status [client : Client, epoch : Str, revision : Str] : Void
  (if_yes (&& (== epoch client/status_epoch) (! (revision_before client/status_revision revision)))
    (return))
  (set client/status_epoch epoch)
  (set client/status_revision revision)
  (refresh_status client))

(fn apply_status [client : Client, data : Any] : Void
  (if_not (status_is_current data client/status client/selected client/epoch client/status_epoch client/status_revision)
    (return))
  (var epoch (string_or data/epoch ""))
  (var revision (string_or data/status_revision ""))
  (set client/status_epoch epoch)
  (set client/status_revision revision)
  (var unchanged (== ($json/stringify client/status) ($json/stringify data)))
  (set client/status data)
  (if_not ($absent? client/ui)
    (var ui : UiClient client/ui)
    (update_ui ui data/ui))
  (var components : (List Any) [])
  (if_not ($absent? data/web_components) (set components data/web_components))
  (var components_changed (!= ($json/stringify client/components) ($json/stringify components)))
  (set client/components components)
  (update_controls client)
  (if_yes unchanged (return))
  (var drawer ($dom/element "status_content"))
  ($dom/clear drawer)
  (var summary ($dom/create_element "div"))
  ($dom/append drawer summary)
  (if_not (render_plugin_slot client summary "status_summary")
    (var profile : Str data/profile)
    ($dom/append drawer ($dom/render `(p "Profile: " %profile)))
    (var model : Str data/model/model)
    (var provider : Str data/model/provider)
    ($dom/append drawer ($dom/render `(p "Model: " %model)))
    ($dom/append drawer ($dom/render `(p "Provider: " %provider)))
    (if_not ($absent? data/model/effort)
      (var effort : Str data/model/effort)
      ($dom/append drawer ($dom/render `(p "Reasoning effort: " %effort)))))
  (var plugins : (List Any) data/plugins)
  (for plugin in plugins
    (var id : Str plugin/id)
    (var state : Str plugin/state)
    ($dom/append drawer ($dom/render `(div ^class_name "plugin_status" (span %id) (span %state)))))
  (for component in components
    (if_not ($absent? component/error)
      (var name : Str component/name)
      (var error : Str component/error)
      ($dom/append drawer ($dom/render `(p ^class_name "web_muted" %$"${name}: ${error}")))))
  (render_commands client)
  (if_yes (&& components_changed (== client/records/.size 0) (== client/preview/.size 0))
    (render_transcript client)))

(fn render_commands [client : Client] : Void
  (var picker ($dom/element "commands"))
  (if_yes (! ($absent? client/mode))
    (set picker/hidden true)
    (return))
  ($dom/clear picker)
  (var text ($dom/input_value client/prompt))
  (var parts : (List Str) (str/split text " "))
  (var show
    (&&
      (str/starts_with? text "/")
      (== ($size parts) 1)
      (!
        (str/contains?
          text
          """
"""))
      (! (str/contains? text "\t"))))
  (set picker/hidden (! show))
  (if_yes (|| (! show) ($absent? client/status)) (return))
  (var commands : (List Any) client/status/commands)
  (var matched false)
  (for command in commands
    (var name : Str command/name)
    (var doc : Str command/doc)
    (if_yes (str/starts_with? $"/${name}" (str/lower text))
      (set matched true)
      ($dom/append
        picker
        ($dom/render
          `(button ^type "button" ^class_name "command" ^on_click %(fn [event : Any] : Void ($dom/set_input_value client/prompt $"/${name} ") (remember_draft client) ($dom/focus client/prompt) (set picker/hidden true))
             (strong %$"/${name}")
             (span %doc))))))
  (if_not matched
    ($dom/append
      picker
      ($dom/render
        `(p ^class_name "muted"
           %(if (== ($size commands) 0)
              "Use /help to load available commands."
              "No matching commands. Use /help for the full list."))))))

(fn upsert_session [client : Client, session : Any] : Void
  (set client/sessions (merge_blocks client/sessions [session]))
  (render_sessions client))

(fn sessions_page [client : Client, after : Str] : Void
  (var epoch client/socket_epoch)
  (api client "GET" $"/api/v8/sessions?after=${after}" nil
    (fn [code : Int, data : Any] : Void
      (if_yes (!= epoch client/socket_epoch) (return))
      (if (== code 200)
        (then
          (var page : (List Any) data/sessions)
          # Live pushes may already hold a newer version of an existing row.
          (var additions : (List Any) [])
          (for entry in page
            (var found false)
            (for existing in client/sessions
              (if_yes (== entry/id existing/id) (set found true)))
            (if_not found (additions .push entry)))
          (set client/sessions (merge_blocks client/sessions additions))
          (render_sessions client)
          (var next (string_or data/next ""))
          (if_yes (!= next "") (sessions_page client next)))
        (else (show_error client data))))))

(fn load_older [client : Client] : Void
  (if_yes (|| client/loading_older (== ($size client/records) 0)) (return))
  (set client/loading_older true)
  (var generation client/generation)
  (var first : Any client/records/0)
  (var before : Str first/seq)
  (api
    client
    "GET"
    $"/api/v8/sessions/${client/selected}/snapshot?before=${before}"
    nil
    (fn [code : Int, data : Any] : Void
      (if_yes (!= generation client/generation) (return))
      (set client/loading_older false)
      (if (== code 200)
        (then
          (var older : (List Any) data/records)
          (var empty_runs : (List Any) [])
          (var raw_runs : Any (?? data/rounds empty_runs))
          (var runs : (List Any) raw_runs)
          (set client/rounds (merge_blocks client/rounds runs))
          (set client/records (bounded_blocks (merge_blocks older client/records) false))
          (set client/has_older data/has_older)
          (set client/autoscroll false)
          (set client/viewing_history true)
          (set client/preview [])
          (render_transcript ^^prepend client))
        (else
          (show_error client data))))))

(fn apply_snapshot [client : Client, data : Any] : Void
  (if_not ($absent? data/status) (apply_status client data/status))
  (if_not client/viewing_history
    (var records : (List Any) data/records)
    (set client/records (bounded_blocks records true))
    (set client/preview data/preview)
    (set client/has_older data/has_older))
  (set client/round data/round)
  (set client/mode (?? data/mode nil))
  (resolve_mode_receipt client data/records)
  (var empty_runs : (List Any) [])
  (var raw_runs : Any (?? data/rounds empty_runs))
  (var runs : (List Any) raw_runs)
  (set client/rounds (merge_blocks client/rounds runs))
  (acknowledge_run client data/round client/selected)
  (set client/cursor data/cursor)
  (set client/next_seq data/next_submission_seq)
  (set client/session_revision data/session/revision)
  (var title : Str data/session/title)
  ($dom/set_text client/title title)
  (var tab (session_tab client client/selected))
  (set tab/title title)
  (set tab/cache data)
  (var pinned : Bool false)
  (if_not ($absent? data/session/pinned) (set pinned data/session/pinned))
  ($dom/set_text ($dom/element "pin_session") (if pinned "Unpin" "Pin"))
  (render_transcript client)
  (render_tabs client)
  (update_controls client))

(fn apply_records [client : Client, incoming : (List Any), cursor : Str] : Void
  (if_not client/viewing_history
    (var merged (merge_blocks client/records incoming))
    (if_yes (> ($size merged) 600) (set client/has_older true))
    (set client/records (bounded_blocks merged true))
    (var preview : (List Any) [])
    (for block in client/preview
      (var found false)
      (for record in incoming
        (if_yes (== block/id record/id) (set found true)))
      (if_not found (preview .push block)))
    (set client/preview preview))
  (if_yes (!= cursor "") (set client/cursor cursor))
  (render_transcript client))

(fn apply_record [client : Client, record : Any] : Void
  (if_not client/viewing_history
    (var found false)
    (for saved in client/records
      (if_yes (== saved/id record/id) (set found true)))
    (if_not found (set client/preview (bounded_blocks (merge_blocks client/preview [record]) true))))
  (render_transcript client))

(fn apply_run [client : Client, session : Str, data : Any] : Void
  (acknowledge_run client data session)
  (if_yes (== session client/selected)
    (set client/round data)
    (set client/rounds (bounded_blocks (merge_blocks client/rounds [data]) true))
    (render_transcript client))
  (update_controls client))

(fn select_session [client : Client, id : Str] : Void
  (if_yes client/sending
    (notice client "Resolving your submission…")
    (return))
  (remember_draft client)
  (var refresh (&& (== id client/selected) client/viewing_history))
  (save_tab client)
  (set client/selected id)
  (set client/queued_prompt "")
  (set client/cursor "")
  (set client/next_seq "1")
  (set client/records [])
  (set client/preview [])
  (set client/expanded [])
  (set client/components [])
  (set client/round nil)
  (set client/mode nil)
  (set client/mode_pending nil)
  (set client/rounds [])
  (set client/has_older false)
  (set client/loading_older false)
  (set client/viewing_history false)
  (set client/autoscroll true)
  (set client/generation (+ client/generation 1))
  ($dom/set_input_value client/prompt (?? ($session_storage/get (draft_key id)) ""))
  ($browser/replace_url
    (view_url id ((Path "navigation" "active") client/ui)
      ((Path "navigation" "presentation") client/ui) client/safe_ui))
  ($dom/set_class client/root "menu_open" false)
  (notice client "")
  (render_sessions client)
  (var tab (session_tab client id))
  (set tab/closed false)
  (set client/connected tab/connected)
  (set client/socket tab/socket)
  (set client/socket_epoch tab/socket_epoch)
  (set client/message_sequence tab/sequence)
  (apply_snapshot client tab/cache)
  (refresh_status client)
  (set client/expanded tab/expanded)
  (render_transcript client)
  (render_tabs client)
  (if_not tab/connected (connect_stream client tab))
  (if_yes (&& refresh tab/connected (!= id ""))
    (api
      client
      "GET"
      $"/api/v8/sessions/${id}/snapshot"
      nil
      (fn [code : Int, data : Any] : Void
        (if_yes (== id client/selected)
          (if (== code 200)
            (apply_snapshot client data)
            (show_error client data))))))
  (if_yes (!= id "")
    (api
      client
      "POST"
      $"/api/v8/sessions/${id}/open"
      {}
      (fn [code : Int, data : Any] : Void
        (if_yes (!= code 200) (show_error client data))))))

(fn pin_session [client : Client] : Void
  (var id client/selected)
  (if_yes (== id "") (return))
  (var tab (session_tab client id))
  (var cache : Any tab/cache)
  (var pinned : Bool false)
  (if_not ($absent? cache/session/pinned) (set pinned cache/session/pinned))
  (api
    client
    "PATCH"
    $"/api/v8/sessions/${id}"
    {^pinned (! pinned) ^revision client/session_revision}
    (fn [code : Int, data : Any] : Void
      (if (== code 200)
        (then
          (set cache/session data)
          (if_yes (== id client/selected)
            (set client/session_revision data/revision)
            ($dom/set_text ($dom/element "pin_session") (if pinned "Pin" "Unpin"))))
        (else
          (show_error client data))))))

(fn create [client : Client] : Void
  (var draft
    (if (== client/selected "")
      ($dom/input_value client/prompt)
      (?? ($session_storage/get (draft_key "new")) "")))
  (api
    client
    "POST"
    "/api/v8/sessions"
    {^title "New conversation"}
    (fn [code : Int, data : Any] : Void
      (if (== code 201)
        (then
          (var id : Str data/id)
          (select_session client id)
          (if_yes (!= draft "")
            ($dom/set_input_value client/prompt draft)
            (remember_draft client))
          ($session_storage/remove (draft_key "new")))
        (else
          (show_error client data))))))

(fn send_pending [client : Client] : Void
  (if_yes (|| ($absent? client/pending) client/sending (! client/connected)) (return))
  (var pending : Any client/pending)
  (var session : Str pending/session)
  (var request_id : Str pending/request_id)
  (var already_seen false)
  (if_not ($absent? client/round)
    (set already_seen (&& (== session client/selected)
      (== (string_or client/round/request_id "") request_id))))
  (if_not already_seen
    (set client/awaiting request_id) (set client/awaiting_session session))
  (set client/sending true)
  (update_controls client)
  (api client "POST" $"/api/v8/sessions/${session}/rounds" pending
    (fn [code : Int, data : Any] : Void
      (set client/sending false)
      (if (== code 202)
        (then
          # POST acknowledges admission. A newer WebSocket completion must
          # never be overwritten by this potentially late accepted response.
          (var status : Str data/state)
          (if_yes (terminal status) (acknowledge_run client data session))
          ($session_storage/remove "gene-harness/pending")
          (var submitted : Str pending/text)
          (if (== session client/selected)
            (then
              (if (== ($dom/input_value client/prompt) submitted)
                (then ($dom/set_input_value client/prompt "")
                  ($session_storage/remove (draft_key session)))
                (else (remember_draft client))))
            (else
              (if_yes (== (?? ($session_storage/get (draft_key session)) "") submitted)
                ($session_storage/remove (draft_key session)))))
          (set client/pending nil)
          (set_hidden "commands" true)
          (notice client ""))
        (else
          (if_yes (&& (== client/awaiting_session session) (== client/awaiting request_id))
            (set client/awaiting "") (set client/awaiting_session ""))
          (var error_code (string_or data/code ""))
          (if_yes (|| (== code 400) (== code 404) (== code 409) (== code 410) (== code 413)
                      (&& (== code 503)
                        (|| (== error_code "recovery_required") (== error_code "unavailable"))))
            ($session_storage/remove "gene-harness/pending")
            (set client/pending nil))
          (show_error client data)
          (if (== code 401)
            (then
              (set client/ready false)
              (set client/connected false)
              (set_hidden "auth_notice" false))
            (elif ($absent? client/pending) (connect_socket client))
            (else
              # Unknown outcomes keep their idempotency key. Reconnect checks
              # authentication and backs off before resolving the submission.
              (set client/connected false)
              (if_not ($absent? client/socket)
                (var socket : EventTarget client/socket)
                ($ws/close socket))))))
      (set_hidden "resolve_submission" ($absent? client/pending))
      (update_controls client))))

(fn stage_submission [client : Client, text : Str] : Void
  (set client/pending
    {
      ^session client/selected
      ^request_id ($browser/request_id)
      ^submission_seq client/next_seq
      ^text text})
  (if_not ($session_storage/set "gene-harness/pending" ($json/stringify client/pending))
    (set client/pending nil)
    (notice
      client
      "Browser storage is required to safely recover a submission. Enable it and try again.")
    (return))
  (send_pending client))

(fn send_command [client : Client, text : Str, ^clear clear : Bool = true] : Void
  (set client/sending true)
  (update_controls client)
  (api
    client
    "POST"
    $"/api/v8/sessions/${client/selected}/commands"
    {^text text}
    (fn [code : Int, data : Any] : Void
      (set client/sending false)
      (if (== code 202)
        (then
          (if_yes clear
            ($dom/set_input_value client/prompt "")
            (render_commands client))
          (remember_draft client))
        (else
          (show_error client data)))
      (update_controls client))))

(fn apply_command [client : Client, session : Str, data : Any] : Void
  (if_yes (!= session client/selected) (return))
  (var id : Str data/id)
  (var status : Str data/status)
  (var block_id $"${session}/${id}")
  (var text : Str (string_or data/display (string_or data/text "")))
  (if_yes (&& (== text "") (! ($absent? data/raw)))
    (var command_name : Str (string_or data/name "command"))
    (var command_raw : Str (string_or data/raw ""))
    (set text $"/${command_name} ${command_raw}"))
  (if_yes (== status "running")
    (for previous in client/preview
      (var previous_id : Str previous/id)
      (if_yes (== previous_id block_id)
        (var prior : Str previous/text)
        (set text ($to_str prior text)))))
  (apply_record
    client
    {
      ^id block_id
      ^round_id ""
      ^turn 0
      ^role "assistant"
      ^phase "command"
      ^input_id data/input_id
      ^mode_instance data/mode_instance
      ^text text
      ^status status
      ^view data/view
      ^!durable})
  (if_yes (!= status "running") (resolve_mode_receipt client [data]))
  (render_transcript client))

(fn mode_pending_key [session : Str] : Str
  $"gene-harness/mode-pending/${session}")

(fn resolve_mode_receipt [client : Client, records : (List Any)] : Void
  (if_yes (== client/selected "") (return))
  (if_yes ($absent? client/mode_pending)
    (var saved : Str (?? ($session_storage/get (mode_pending_key client/selected)) ""))
    (if_yes (!= saved "") (set client/mode_pending (try ($json/parse saved) catch Any nil))))
  (if_yes ($absent? client/mode_pending) (return))
  (var pending : Any client/mode_pending)
  (for record in records
    (if_yes (&& (== record/input_id pending/input_id) (== record/mode_instance pending/instance))
      ($session_storage/remove (mode_pending_key client/selected))
      (if_yes (== ($dom/input_value client/prompt) (string_or pending/text ""))
        ($dom/set_input_value client/prompt "")
        (remember_draft client))
      (set client/mode_pending nil)
      (notice ^key "mode-input" ^scope client/selected client "")
      (notice client "Input receipt recovered.")
      (return)))
  (notice ^key "mode-input" ^scope client/selected ^^sticky
    client
    "Input outcome is unknown. Check the transcript; Eval resolves the same input id."))

(fn send_mode_input [client : Client] : Void
  (if_yes (|| (! client/ready) (! client/connected) client/sending (! ($absent? client/mode/running)))
    (return))
  (var text ($dom/input_value client/prompt))
  (if_yes (== (str/trim text) "") (return))
  (var pending : Any client/mode_pending)
  (if ($absent? pending)
    (then
      (set pending
        {
          ^session client/selected
          ^instance client/mode/instance
          ^input_id ($browser/request_id)
          ^text text}))
    (else
      (var previous_text : Str pending/text)
      (if_yes (!= previous_text text)
        (notice client "Resolve the previous REPL input before submitting different code.")
        (return))))
  (if_not ($session_storage/set (mode_pending_key client/selected) ($json/stringify pending))
    (notice client "Browser storage is required to recover an input receipt.")
    (return))
  (set client/mode_pending pending)
  (set client/sending true)
  (remember_draft client)
  (update_controls client)
  (var session : Str pending/session)
  (api
    client
    "POST"
    $"/api/v8/sessions/${session}/mode/input"
    pending
    (fn [code : Int, data : Any] : Void
      (set client/sending false)
      (var incomplete : Bool false)
      (var closed : Bool false)
      (if_not ($absent? data/incomplete) (set incomplete data/incomplete))
      (if_not ($absent? data/closed) (set closed data/closed))
      (if (|| (== code 202) (== code 200))
        (then
          ($session_storage/remove (mode_pending_key session))
          (set client/mode_pending nil)
          (if incomplete
            (notice client "Incomplete form. Add the remaining code.")
            (do
              (if_yes (== ($dom/input_value client/prompt) (string_or pending/text ""))
                ($dom/set_input_value client/prompt "")
                (remember_draft client))
              (if_yes closed (set client/mode nil))
              (notice client ""))))
        (else
          (if_yes (&& (>= code 400) (< code 500))
            ($session_storage/remove (mode_pending_key session))
            (set client/mode_pending nil)
            (if_yes (== (string_or data/code "") "mode_closed")
              (set client/mode (?? data/mode nil))))
          (show_error client data)))
      (update_controls client))))

(fn leave_mode [client : Client] : Void
  (if_yes (|| ($absent? client/mode) client/sending) (return))
  (var session client/selected)
  (var instance : Str client/mode/instance)
  (set client/sending true)
  (update_controls client)
  (api
    client
    "POST"
    $"/api/v8/sessions/${session}/mode/leave"
    {^instance instance}
    (fn [code : Int, data : Any] : Void
      (set client/sending false)
      (if (== code 200)
        (do
          (set client/mode nil)
          (notice client ""))
        (show_error client data))
      (update_controls client))))

(fn action [client : Client] : Void
  (if_yes (|| client/sending client/action_cooldown) (return))
  (var executing (if ($absent? client/mode) client/server_busy (! ($absent? client/mode/running))))
  (if executing
    (stop client)
    (send client)))

(fn send [client : Client] : Void
  (if_yes (|| (! client/ready) (! client/connected) client/sending) (return))
  (if_yes (! ($absent? client/mode))
    (send_mode_input client)
    (return))
  (var raw ($dom/input_value client/prompt))
  (if_yes (&& (!= client/selected "") (str/starts_with? raw "/") (! (str/starts_with? raw "//")))
    (send_command client raw)
    (return))
  (if_yes (!= client/input_id "")
    (notice client "Answer or cancel the pending question first.")
    (return))
  (if_yes (|| (! client/ready) (! client/connected) client/sending client/busy) (return))
  (if_yes (! ($absent? client/pending))
    (send_pending client)
    (return))
  (var text ($dom/input_value client/prompt))
  (if_yes (== (str/trim text) "") (return))
  (remember_draft client)
  (if_yes (== client/selected "")
    (set client/sending true)
    (update_controls client)
    (api
      client
      "POST"
      "/api/v8/sessions"
      {^title "New conversation"}
      (fn [code : Int, data : Any] : Void
        (set client/sending false)
        (if (== code 201)
          (then
            (var id : Str data/id)
            (select_session client id)
            (set client/queued_prompt text)
            ($dom/set_input_value client/prompt text)
            (remember_draft client)
            ($session_storage/remove (draft_key "new")))
          (else
            (show_error client data)))
        (update_controls client)))
    (return))
  (stage_submission client text))

(fn stop [client : Client] : Void
  (if_yes (! ($absent? client/mode))
    (if_yes ($absent? client/mode/running) (return))
    (var command_id : Str client/mode/running)
    (api
      client
      "POST"
      $"/api/v8/sessions/${client/selected}/commands/${command_id}/cancel"
      {}
      (fn [code : Int, data : Any] : Void
        (if (== code 200)
          (notice client "Stop requested.")
          (show_error client data))))
    (return))
  (if_yes ($absent? client/round) (return))
  (var id : Str client/round/id)
  (api
    client
    "POST"
    $"/api/v8/sessions/${client/selected}/rounds/${id}/cancel"
    {}
    (fn [code : Int, data : Any] : Void
      (if (== code 200)
        (then
          (notice client "Stop requested."))
        (else
          (show_error client data))))))

(fn socket_message [client : Client, text : Str] : Void
  (try
    (var message : Any ($json/parse text))
    (var version : Int message/protocol)
    (if_yes (!= version protocol_version)
      (set client/ready false)
      (set client/connected false)
      (update_controls client)
      (notice ^key "connection" ^^sticky
        client
        "Reload the page to use the current server version.")
      (return))
    (var sequence_text : Str message/sequence)
    (var sequence : Int ($json/parse sequence_text))
    (if_yes (!= sequence (+ client/message_sequence 1))
      (connect_socket client)
      (return))
    (set client/message_sequence sequence)
    (set client/epoch message/epoch)
    (var kind : Str message/type)
    (var session : Str message/session)
    (var data : Any message/data)
    (if (== kind "status")
      (then
        (apply_status client data))
      (elif (== kind "session/list")
        (var center : NotificationCenter client/center)
        (invalidate_questions center)
        (refresh_sessions client))
      (elif (== kind "attention")
        (set client/needs_attention data/sessions)
        (render_sessions client))
      (elif (== kind "session")
        (upsert_session client data)
        (if_yes (== session client/selected)
          (set client/session_revision data/revision)
          (var title : Str data/title)
          ($dom/set_text client/title title)))
      (elif (== kind "snapshot")
        (if_yes (== session client/selected) (apply_snapshot client data)))
      (elif (== kind "mode/state")
        (if_yes (== session client/selected)
          (set client/mode data)
          (render_tabs client)
          (update_controls client)))
      (elif (|| (== kind "turn") (== kind "reply") (== kind "console"))
        (if_yes (== session client/selected) (apply_record client data)))
      (elif (== kind "records")
        (if_yes (== session client/selected)
          (var records : (List Any) data/records)
          (var cursor : Str data/cursor)
          (apply_records client records cursor)))
      (elif (== kind "round/state")
        (apply_run client session data))
      (elif (== kind "command")
        (apply_command client session data))
      (elif (== kind "stopped")
        (var restarting : Bool data/restart)
        (set client/ready restarting)
        (set client/connected false)
        (var stopped_message : Str data/message)
        (notice ^key "connection" ^^sticky client stopped_message)
        (controls client))
      (elif (== kind "restarted")
        (notice client "Harness restarted."))
      (elif (== kind "error")
        (show_error client data))
      (elif (== kind "resync")
        (var socket : EventTarget client/socket)
        ($ws/close socket))
      (elif (== kind "ready")
        (set client/connected true)
        (notice ^key "connection" client "")
        (update_controls client)
        (var questions : QuestionEditors client/questions)
        (resume_replies questions)
        (if_not ($absent? client/pending) (send_pending client))
        (if_yes (!= client/queued_prompt "")
          (var queued client/queued_prompt)
          (set client/queued_prompt "")
          (if (&& (str/starts_with? queued "/") (! (str/starts_with? queued "//")))
            (send_command client queued)
            (stage_submission client queued)))))
  catch Any
    (notice ^key "connection" ^^sticky client "Refreshing the live connection…")
    (connect_socket client)))

(fn reconnect_socket [client : Client, epoch : Int] : Void
  ($time/after 2500.0 (fn [] : Void
    (if_yes (|| (! client/ready) (!= epoch client/socket_epoch)) (return))
    # Reconnection checks cookie expiry. Connected streams refresh status only
    # on workspace invalidation or tab selection, without timer polling.
    (api client "GET" "/api/v8/status" nil
      (fn [code : Int, data : Any] : Void
        (if_yes (!= epoch client/socket_epoch) (return))
        (if (== code 200)
          (then (set client/csrf data/csrf) (connect_socket client))
          (elif (== code 401)
            (set client/ready false)
            (set_hidden "auth_notice" false)
            (show_error client data)
            (update_controls client))
          (else (reconnect_socket client epoch))))))))

(fn connect_socket [client : Client] : Void
  (connect_stream client (session_tab client client/selected)))

(fn connect_stream [client : Client, tab : SessionTab] : Void
  (if_yes (|| (! client/ready) tab/closed) (return))
  (set tab/socket_epoch (+ tab/socket_epoch 1))
  (var epoch tab/socket_epoch)
  (set tab/connected false)
  (set tab/sequence 0)
  (if_not ($absent? tab/socket)
    (var old : EventTarget tab/socket)
    ($ws/close old))
  (if_yes (== tab/id client/selected)
    (set client/connected false)
    (update_controls client))
  (var origin ($browser/origin))
  (var parts : (List Str) (str/split origin "://"))
  (var scheme (if (== parts/0 "https") "wss" "ws"))
  (var socket
    ($ws/connect
      ($to_str
        $"${scheme}://${parts/1}/api/v8/events?session=${($url/encode_component tab/id)}"
        (if client/safe_ui
          "&ui=default"
          ""))))
  (set tab/socket socket)
  (if_yes (== tab/id client/selected)
    (set client/socket socket)
    (set client/socket_epoch epoch))
  ($time/after
    10000.0
    (fn [] : Void
      (if_yes (&& client/ready (== epoch tab/socket_epoch) (! tab/connected)) ($ws/close socket))))
  ($ws/on_text
    socket
    (fn [text : Str] : Void
      (if_yes (== epoch tab/socket_epoch) (stream_message client tab text))))
  ($ws/on_close
    socket
    (fn [] : Void
      (if_yes (|| (!= epoch tab/socket_epoch) tab/closed) (return))
      (set tab/connected false)
      (if_yes (== tab/id client/selected)
        (set client/connected false)
        (update_controls client)
        (if_yes client/ready
          (notice ^key "connection" ^^sticky client "Reconnecting… Your draft is saved.")))
      (if_yes client/ready (reconnect_stream client tab epoch)))))

(fn reconnect_stream [client : Client, tab : SessionTab, epoch : Int] : Void
  ($time/after
    1500.0
    (fn [] : Void
      (if_yes (|| (! client/ready) tab/closed (!= epoch tab/socket_epoch)) (return))
      (api
        client
        "GET"
        "/api/v8/status"
        nil
        (fn [code : Int, data : Any] : Void
          (if_yes (|| tab/closed (!= epoch tab/socket_epoch)) (return))
          (if (== code 200)
            (then
              (set client/csrf data/csrf)
              (connect_stream client tab))
            (elif (== code 401)
              (set client/ready false)
              (set_hidden "auth_notice" false)
              (show_error client data))
            (else
              (reconnect_stream client tab epoch))))))))

(fn stream_message [client : Client, tab : SessionTab, text : Str] : Void
  (try
    (var message : Any ($json/parse text))
    (var version : Int message/protocol)
    (var sequence_text : Str message/sequence)
    (var sequence : Int ($json/parse sequence_text))
    (if_yes (|| (!= version protocol_version) (!= sequence (+ tab/sequence 1)))
      (connect_stream client tab)
      (return))
    (set tab/sequence sequence)
    (var server_epoch : Str message/epoch)
    (if_yes (&& (!= tab/server_epoch "") (!= tab/server_epoch server_epoch) (== tab/id client/selected))
      (notice client "Harness restarted."))
    (set tab/server_epoch server_epoch)
    (var kind : Str message/type)
    (var session : Str message/session)
    (var data : Any message/data)
    (var ui : UiClient client/ui)
    (var center : NotificationCenter client/center)
    (if_yes (!= center/epoch server_epoch)
      (set center/epoch server_epoch)
      (invalidate_questions center))
    (var inbox : ProducerInbox client/inbox)
    (producer_event inbox kind server_epoch data)
    (if_yes (== kind "snapshot") (center_snapshot center session data))
    (if_yes (== kind "round/state") (invalidate_questions center session))
    (if_yes (== kind "command")
      (var confirmations : Confirmations client/confirmations)
      (command_confirmation confirmations session data))
    (ui_event ui kind data)
    (if_yes (&& (== tab/id client/selected) (== kind "ui/state"))
      (invalidate_status client server_epoch (string_or data/data_revision "")))
    (if_yes (== kind "ready") (set tab/connected true))
    (if (== tab/id client/selected)
      (then
        (set client/message_sequence (- sequence 1))
        (socket_message client text)
        (save_tab client))
      (else
        (var cache : Any tab/cache)
        (if (&& (== kind "snapshot") (== session tab/id))
          (then
            (set tab/cache data)
            (set tab/title data/session/title)))
        (if_yes (&& (== session tab/id) (|| (== kind "turn") (== kind "reply") (== kind "console")))
          (var preview : (List Any) cache/preview)
          (set cache/preview (bounded_blocks (merge_blocks preview [data]) true)))
        (if_yes (&& (== session tab/id) (== kind "round/state"))
          (set cache/round data)
          (var rounds : (List Any) cache/rounds)
          (set cache/rounds (merge_blocks rounds [data]))
          (acknowledge_run client data session))
        (if_yes (&& (== session tab/id) (== kind "mode/state")) (set cache/mode data))
        (if_yes (&& (== session tab/id) (== kind "command"))
          (var id : Str data/id)
          (var output (string_or data/display (string_or data/text "")))
          (var command_preview : (List Any) cache/preview)
          (set cache/preview
            (bounded_blocks
              (merge_blocks
                command_preview
                [
                  {
                    ^id $"${session}/${id}"
                    ^round_id ""
                    ^turn 0
                    ^role "assistant"
                    ^phase "command"
                    ^text output
                    ^status data/status
                    ^view data/view
                    ^!durable}])
              true)))))
    (render_tabs client)
  catch Any
    (connect_stream client tab)))

(fn authenticated [client : Client, data : Any] : Void
  (set client/csrf data/csrf)
  (set client/ready true)
  (set_hidden "auth_notice" true)
  (var saved : Str (?? ($session_storage/get "gene-harness/pending") ""))
  (if_yes (!= saved "")
    (set client/pending (try ($json/parse saved) catch Any nil)))
  (if_not ($absent? client/pending)
    (var id : Str client/pending/session)
    (set client/selected id))
  # A direct conversation URL needs the same draft initialization as navigation.
  (if_yes (== client/generation 0)
    (set client/generation 1)
    (var key (draft_key (if (== client/selected "") "new" client/selected)))
    ($dom/set_input_value client/prompt (?? ($session_storage/get key) "")))
  (connect_socket client))

(fn authenticate [client : Client] : Void
  (var token (query_value ($browser/hash) "token"))
  # Remove the owner token fragment without losing a view/presentation deep link.
  ($browser/replace_url ($to_str "/" ($browser/search)))
  (if (!= token "")
    (api
      client
      "POST"
      "/api/v8/auth/exchange"
      {^token token}
      (fn [code : Int, data : Any] : Void
        (if (== code 200)
          (then
            (authenticated client data))
          (else
            (show_error client data)
            (set_hidden "auth_notice" false)))))
    (api
      client
      "GET"
      "/api/v8/status"
      nil
      (fn [code : Int, data : Any] : Void
        (if (== code 200)
          (then
            (authenticated client data))
          (else
            (show_error client data)
            (set_hidden "auth_notice" false)))))))

(fn main [root : EventTarget] : Void
  (var client
    (Client ^selected (query_value ($browser/search) "session") ^csrf "" ^cursor "" ^next_seq "1" ^epoch "" ^!ready ^!sending ^!connected ^!server_busy ^awaiting "" ^awaiting_session "" ^queued_prompt "" ^message_sequence 0 ^!busy ^^autoscroll ^generation 0 ^!has_older ^!loading_older ^socket_epoch 0 ^!viewing_history ^records [] ^preview [] ^sessions [] ^needs_attention [] ^filter_epoch 0 ^trigger_selected "" ^tabs [] ^expanded [] ^rounds [] ^input_id "" ^!answering ^round nil ^mode nil ^mode_pending nil ^!action_cooldown ^!was_executing ^pending nil ^status nil ^status_epoch "" ^status_revision "" ^status_generation 0 ^components [] ^component_buttons {} ^socket nil ^session_revision "1" ^ui nil ^notices (create_notices) ^confirmations nil ^questions nil ^center nil ^inbox nil ^safe_ui (== (query_value ($browser/search) "ui") "default") ^root root ^list ($dom/element "sessions") ^transcript ($dom/element "transcript") ^prompt ($dom/element "prompt") ^notice ($dom/element "notice") ^title ($dom/element "conversation_title")))
  (set client/questions
    (create_question_editors
      client/notices
      (fn [method : Str, path : Str, payload : Any, done : (Fn [Int Any] Void)] : Void
        (api client method path payload done))
      (fn [session : Str] : Void
        (var center : NotificationCenter client/center)
        (invalidate_questions center session))))
  (var questions : QuestionEditors client/questions)
  (set client/center
    (create_center
      client/notices
      questions
      (fn [method : Str, path : Str, payload : Any, done : (Fn [Int Any] Void)] : Void
        (api client method path payload done))
      (fn [session : Str] : Void
        (select_session client session)
        (var ui : UiClient client/ui)
        (navigate ui "harness"))))
  (var center : NotificationCenter client/center)
  (set client/inbox
    (create_producer_inbox
      client/notices
      client/safe_ui
      (fn [method : Str, path : Str, payload : Any, done : (Fn [Int Any] Void)] : Void
        (api client method path payload done))
      (fn [count : Int] : Void
        (set center/new_messages count)
        (update_center_count center))
      (fn [reference : Any] : Void
        (var session (string_or reference/session ""))
        (if_yes (!= session "") (select_session client session))
        (var ui : UiClient client/ui)
        (if ($absent? reference/component)
          (navigate ui "harness")
          (open_reference ui reference))
        (if_not ($absent? reference/round)
          (var round : Str reference/round)
          (client/expanded .push round)
          (render_transcript client))
        nil)
      (fn [session : Str, text : Str] : Void
        (if_yes (&& (!= session "") (!= session client/selected)) (select_session client session))
        (stage_prompt client text))))
  (var inbox : ProducerInbox client/inbox)
  (set center/on_open (fn [] : Void (opened_inbox inbox)))
  (set client/confirmations
    (create_confirmations
      ($dom/element "confirmations")
      client/notices
      (fn [method : Str, path : Str, payload : Any, done : (Fn [Int Any] Void)] : Void
        (api client method path payload done))))
  (set client/ui
    (create_ui
      root
      client/safe_ui
      client/notices
      (fn [method : Str, path : Str, payload : Any, done : (Fn [Int Any] Void)] : Void
        (api client method path payload done))
      (fn [id : Str] : Void
        (select_session client id))
      (fn [command : Str] : Void
        (component_command client command))
      (fn [text : Str] : Void
        (stage_prompt client text))))
  ($dom/add_event_listener ($dom/window) "popstate"
    (fn [event : Any] : Void
      (var search ($browser/search))
      (var session (query_value search "session"))
      (var view (query_value search "view"))
      (var presentation (query_value search "presentation"))
      (if_yes (== view "") (set view "harness"))
      (if_yes (!= session client/selected) (select_session client session))
      (var ui : UiClient client/ui)
      (if_not (navigate ui view presentation false)
        (navigate ui "harness" "" false))))
  ($dom/add_event_listener
    ($dom/element "composer")
    "submit"
    (fn [event : Any] : Void
      ($dom/prevent_default event)
      (action client)))
  ($dom/add_event_listener
    client/prompt
    "keydown"
    (fn [event : Any] : Void
      (if_yes (== ($event/key event) "Escape") (set_hidden "commands" true))
      (if_yes (&& (== ($event/key event) "Enter") (! ($event/shift_key event)) (! ($event/is_composing event)))
        ($dom/prevent_default event)
        (send client))))
  ($dom/add_event_listener
    client/prompt
    "input"
    (fn [event : Any] : Void
      (remember_draft client)
      (render_commands client)))
  ($dom/add_event_listener
    ($dom/element "create_session")
    "click"
    (fn [event : Any] : Void
      (create client)))
  ($dom/add_event_listener
    ($dom/element "session_filter")
    "input"
    (fn [event : Any] : Void
      ($time/after 300.0 (fn [] : Void (refresh_sessions client)))))
  (for id in ["kind_filter" "status_filter" "trigger_filter" "since_filter" "until_filter"]
    ($dom/add_event_listener
      ($dom/element id)
      "change"
      (fn [event : Any] : Void
        (refresh_sessions client))))
  ($dom/add_event_listener
    ($dom/element "triggers_button")
    "click"
    (fn [event : Any] : Void
      (set_hidden "trigger_drawer" false)
      (load_triggers client)))
  ($dom/add_event_listener
    ($dom/element "close_triggers")
    "click"
    (fn [event : Any] : Void
      (set_hidden "trigger_drawer" true)))
  ($dom/add_event_listener
    ($dom/element "trigger_kind")
    "change"
    (fn [event : Any] : Void
      (trigger_fields)))
  ($dom/add_event_listener
    ($dom/element "trigger_form")
    "submit"
    (fn [event : Any] : Void
      ($dom/prevent_default event)
      (create_trigger client)))
  ($dom/add_event_listener
    ($dom/element "leave_mode")
    "click"
    (fn [event : Any] : Void
      (leave_mode client)))
  ($dom/add_event_listener
    ($dom/element "resolve_submission")
    "click"
    (fn [event : Any] : Void
      (send_pending client)))
  ($dom/add_event_listener
    ($dom/element "new_output")
    "click"
    (fn [event : Any] : Void
      (if client/viewing_history
        (select_session client client/selected)
        (do
          ($dom/scroll_end client/transcript)
          (set_hidden "new_output" true)))))
  ($dom/add_event_listener
    client/transcript
    "scroll"
    (fn [event : Any] : Void
      (set client/autoscroll ($dom/near_end client/transcript 80.0))))
  ($dom/add_event_listener
    ($dom/element "menu")
    "click"
    (fn [event : Any] : Void
      ($dom/set_class root "menu_open" true)))
  ($dom/add_event_listener
    ($dom/element "close_menu")
    "click"
    (fn [event : Any] : Void
      ($dom/set_class root "menu_open" false)))
  ($dom/add_event_listener
    ($dom/element "status_button")
    "click"
    (fn [event : Any] : Void
      (var drawer ($dom/element "status_drawer"))
      (var hidden : Bool drawer/hidden)
      (set drawer/hidden (! hidden))))
  ($dom/add_event_listener
    ($dom/element "close_status")
    "click"
    (fn [event : Any] : Void
      (set_hidden "status_drawer" true)
      ($dom/focus ($dom/element "status_button"))))
  ($dom/add_event_listener
    ($dom/element "rename_session")
    "click"
    (fn [event : Any] : Void
      (set_hidden "rename_form" false)
      ($dom/set_input_value ($dom/element "rename_title") ($dom/text client/title))
      ($dom/focus ($dom/element "rename_title"))))
  ($dom/add_event_listener
    ($dom/element "pin_session")
    "click"
    (fn [event : Any] : Void
      (pin_session client)))
  ($dom/add_event_listener
    ($dom/element "rename_form")
    "submit"
    (fn [event : Any] : Void
      ($dom/prevent_default event)
      (api
        client
        "PATCH"
        $"/api/v8/sessions/${client/selected}"
        {^title ($dom/input_value ($dom/element "rename_title")) ^revision client/session_revision}
        (fn [code : Int, data : Any] : Void
          (if (== code 200)
            (then
              (set_hidden "rename_form" true)
              (set client/session_revision data/revision)
              (var title : Str data/title)
              ($dom/set_text client/title title)
              (var tab (session_tab client client/selected))
              (set tab/title title)
              (var cache : Any tab/cache)
              (set cache/session data)
              (render_tabs client))
            (else
              (show_error client data)))))))
  ($dom/add_event_listener
    ($dom/window)
    "focus"
    (fn [event : Any] : Void
      (if_yes (&& client/ready (! client/sending)) (connect_socket client))))
  ($dom/add_event_listener
    ($dom/window)
    "hashchange"
    (fn [event : Any] : Void
      (if_yes (!= (query_value ($browser/hash) "token") "") (authenticate client))))
  (render_transcript client)
  (if_yes (== client/selected "")
    ($dom/set_input_value client/prompt (?? ($session_storage/get (draft_key "new")) "")))
  (controls client)
  (authenticate client))
