# Local feedback and owner-derived conditions. No durable notification copies.
(mod harness_notices ^profile web)

(type Notices ^props {^items PropMap ^changed (Fn [] Nil)})
(type Notice ^props {^identity Str ^source Str ^scope Str ^key Str ^text Str ^severity Str ^origin Any ^element EventTarget ^label EventTarget ^version Int ^hovered Bool ^focused Bool ^center_hovered Bool ^center_focused Bool ^sticky Bool ^action Any})

(fn notice_identity [source : Str, scope : Str, key : Str] : Str
  ($json/stringify [source scope key]))

(fn create_notices [] : Notices
  (Notices ^items {} ^changed (fn [] : Nil nil)))

(fn remove_notice [notices : Notices, source : Str, scope : Str, key : Str] : Nil
  (var identity (notice_identity source scope key))
  (var raw : Any notices/items/%identity)
  (if_yes ($absent? raw) (return))
  (var item : Notice raw)
  (set item/version (+ item/version 1))
  ($dom/remove item/element)
  (notices/items .delete identity)
  (notices/changed))

(fn clear_notices [notices : Notices] : Nil
  (for [key raw] in notices/items
    (var item : Notice raw)
    (set item/version (+ item/version 1))
    ($dom/remove item/element)
    (notices/items .delete key))
  (notices/changed))

(fn expire_notice [notices : Notices, item : Notice, version : Int] : Nil
  ($time/after
    6000.0
    (fn [] : Nil
      (if_yes (|| (!= item/version version) item/sticky) (return))
      (if (|| item/hovered item/focused item/center_hovered item/center_focused)
        (expire_notice notices item version)
        (remove_notice notices item/source item/scope item/key)))))

(fn put_notice [notices : Notices, target : EventTarget, source : Str, scope : Str, key : Str, text : Str, severity : Str, sticky : Bool, origin : Any, ^action action : Any = nil] : Nil
  (if_yes (== text "")
    (remove_notice notices source scope key)
    (return))
  (var identity (notice_identity source scope key))
  (var raw : Any notices/items/%identity)
  (var item
    :
    Notice
    (if ($absent? raw)
      (Notice ^identity identity ^source source ^scope scope ^key key ^text "" ^severity severity ^origin origin ^element ($dom/render `(div ^class_name "notice_item" ^tabindex "0")) ^label ($dom/render `(span)) ^version 0 ^!hovered ^!focused ^!center_hovered ^!center_focused ^sticky sticky ^action action)
      raw))
  (if_yes ($absent? raw)
    (set notices/items/%identity item)
    ($dom/append item/element item/label)
    ($dom/append item/element ($dom/render `(button ^type "button" ^class_name "notice_dismiss"
      ^aria-label "Dismiss message" ^title "Dismiss message"
      ^on_click %(fn [event : Any] : Nil (remove_notice notices item/source item/scope item/key)) (span ^class "icon" ^data-icon "close" ^aria-hidden "true"))))
    ($dom/append target item/element)
    ($dom/add_event_listener
      item/element
      "mouseenter"
      (fn [event : Any] : Nil
        (set item/hovered true)))
    ($dom/add_event_listener
      item/element
      "mouseleave"
      (fn [event : Any] : Nil
        (set item/hovered false)))
    ($dom/add_event_listener
      item/element
      "focusin"
      (fn [event : Any] : Nil
        (set item/focused true)))
    ($dom/add_event_listener
      item/element
      "focusout"
      (fn [event : Any] : Nil
        (set item/focused false))))
  (set item/sticky sticky)
  (set item/action action)
  (set item/origin origin)
  (set item/severity severity)
  ($dom/set_attribute item/element "data-notice-key" identity)
  ($dom/set_attribute item/element "data-severity" severity)
  (if_yes (!= item/text text)
    (set item/text text)
    ($dom/set_text item/label text))
  (set item/version (+ item/version 1))
  (if_not sticky (expire_notice notices item item/version))
  (notices/changed))
