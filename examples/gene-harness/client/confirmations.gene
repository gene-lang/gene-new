# Decisions are independent of feedback, captured under their original command.
(mod harness_confirmations ^profile web)
(import storage_get storage_set ^from "./workspace_storage.gene")
(import api_root ^from "../src/web/contract.gene")
(import handoff_modal ^from "./overlays.gene")
(import flag ^from "../src/common/launcher.gene")
(import ^from "./notices.gene" Notices put_notice remove_notice)
(type Confirmations ^props {^target EventTarget ^items PropMap ^saved PropMap ^notices Notices ^api (Fn [Str Str Any (Fn [Int Any] Nil)] Nil)})

(fn create_confirmations [target : EventTarget, notices : Notices, api : (Fn [Str Str Any (Fn [Int Any] Nil)] Nil)] : Confirmations
  (var controller (Confirmations ^target target ^items {} ^saved {} ^notices notices ^api api))
  (var saved (?? (storage_get "gene-harness/confirmations") ""))
  (if (!= saved "")
    (try
      (set controller/saved ($json/parse saved))
      (map_for [key record] in controller/saved
        (var session : Str record/session)
        (if (== ($json/stringify record/handled) "true")
          (set controller/items/%key true)
          else (command_confirmation controller session record/command)))
    catch Error
      nil))
  controller)

(fn finish_confirmation [controller : Confirmations, key : Str, target : EventTarget] : Nil
  (var record : Any controller/saved/%key)
  (set record/handled true)
  (var session : Str record/session)
  (remove_notice controller/notices "confirmation" session key)
  (storage_set "gene-harness/confirmations" ($json/stringify controller/saved))
  ($dom/remove target))

(fn command_confirmation [controller : Confirmations, session : Str, command : Any] : Nil
  (var code "")
  (if ($present? command/error_code) (set code command/error_code))
  (if (!= code "confirmation_required") (return))
  (var id : Str command/id)
  (var key ($json/stringify [session id]))
  (if ($present? controller/items/%key) (return))
  (var handoff (handoff_modal))
  (var text : Str command/display)
  (var name : Str command/name)
  (var target
    ($dom/render `(section ^class_name "confirmation" ^aria-label "Confirm stopping sessions")))
  (var status ($dom/render `(p ^role "status")))
  (var confirm ($dom/render `(button ^type "button" "Confirm")))
  (var keep ($dom/render `(button ^type "button" "Keep running")))
  (set controller/items/%key target)
  (set controller/saved/%key {^session session ^command command ^!handled})
  (storage_set "gene-harness/confirmations" ($json/stringify controller/saved))
  ($dom/append target ($dom/render `(p %text)))
  ($dom/append target ($dom/render `(small %$"Conversation ${session}")))
  ($dom/append target confirm)
  ($dom/append target keep)
  ($dom/append target status)
  ($dom/append controller/target target)
  (if handoff ($dom/focus confirm))
  (put_notice ^action (fn [] : Nil ($dom/focus confirm))
    controller/notices
    ($dom/element "notice")
    "confirmation"
    session
    key
    "A command needs your confirmation."
    "warning"
    true
    {^session session ^command id})
  ($dom/add_event_listener
    keep
    "click"
    (fn [event : Any] : Nil
      (finish_confirmation controller key target)))
  ($dom/add_event_listener
    confirm
    "click"
    (fn [event : Any] : Nil
      (set confirm/disabled true)
      (set keep/disabled true)
      (controller/api
        "POST"
        $"${(api_root)}/sessions/${session}/commands"
        {^text $"/${name} --confirm" ^expected_command command/expected_command}
        (fn [code : Int, data : Any] : Nil
          (if (== code 202)
            (finish_confirmation controller key target)
          else
            (if (flag data/not_sent)
              ($dom/set_text
                status
                "Confirmation was not sent. Resolve the current request, then try again.")
              (set confirm/disabled false)
            else
              ($dom/set_text
                status
                "Confirmation could not be verified. Check the host before trying again."))
            (set keep/disabled false)))))))
