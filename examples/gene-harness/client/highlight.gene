(mod harness_highlight ^profile web)

# Display-only lexical coloring. Never read or evaluate the supplied source.
# Keep offsets in the browser's UTF-16 units so even malformed/partial text
# round-trips exactly. Each scan advances; string/comment scans are iterative.
(fn char_at [chars : (List Str), index : Int] : Str
  (if (< index ($size chars)) chars/%index ""))

(fn source_slice [chars : (List Str), start : Int, end : Int] : Str
  (var out : (List Str) [])
  (var i start)
  (while (< i end) (out .push chars/%i) (set i (+ i 1)))
  (str/join out ""))

(fn space [char : Str] : Bool
  (&& (!= char "") (str/contains? " \t\r\n" char)))

(fn digit [char : Str] : Bool
  (&& (!= char "") (str/contains? "0123456789" char)))

(fn atom_end [char : Str] : Bool
  (|| (== char "") (space char) (str/contains? "()[]{}\"'`,;#" char)))

(fn member [words : Str, word : Str] : Bool
  (str/contains? words ($ " " word " ")))

(fn number_atom [word : Str] : Bool
  (var chars : (List Str) (str/split word ""))
  (var n ($size chars))
  (var i (if (== (char_at chars 0) "-") 1 0))
  (if_yes (&& (== (char_at chars i) "0") (== (char_at chars (+ i 1)) "x"))
    (set i (+ i 2))
    (if_yes (== i n) (return false))
    (while (< i n)
      (if_not (str/contains? "0123456789abcdefABCDEF" chars/%i) (return false))
      (set i (+ i 1)))
    (return true))
  (var digits 0)
  (while (digit (char_at chars i)) (set digits (+ digits 1)) (set i (+ i 1)))
  (if_yes (== (char_at chars i) ".")
    (set i (+ i 1))
    (while (digit (char_at chars i)) (set digits (+ digits 1)) (set i (+ i 1))))
  (if_yes (== digits 0) (return false))
  (if_yes (|| (== (char_at chars i) "e") (== (char_at chars i) "E"))
    (set i (+ i 1))
    (if_yes (|| (== (char_at chars i) "+") (== (char_at chars i) "-"))
      (set i (+ i 1)))
    (var start i)
    (while (digit (char_at chars i)) (set i (+ i 1)))
    (if_yes (== i start) (return false)))
  (== i n))

(fn atom_kind [word : Str, head : Bool] : Str
  (if_yes (|| (str/starts_with? word "^") (str/starts_with? word "@"))
    (return "property"))
  (if_yes (member " true false nil void self _ " word) (return "literal"))
  (if_yes (member " + - * / % = == != < <= > >= && || ! ?? -> => ~ ... : " word)
    (return "keyword"))
  (if_yes (number_atom word) (return "number"))
  (if_yes (&& head (member
    " fn var set do if_yes if_not if then elif else match when while loop repeat for in break continue macro type enum ctor protocol impl derive message try catch ensure fail panic quote quasiquote select env eval mod ns import import_impl yield scope supervisor spawn await return " word))
    (return "keyword"))
  (var first (char_at (str/split word "") 0))
  (if_yes (&& (!= first "") (str/contains? "ABCDEFGHIJKLMNOPQRSTUVWXYZ" first))
    (return "type"))
  (if_yes (|| head (str/starts_with? word "$") (str/starts_with? word "."))
    (return "callable"))
  "")

(fn gene_tokens [text : Str] : (List Any)
  (var out : (List Any) [])
  # A large block keeps all its text but avoids token/DOM amplification.
  (if_yes (> ($size text) 65536) (return [{^kind "" ^text text}]))
  (var chars : (List Str) (str/split text ""))
  (var n ($size chars))
  (var i 0)
  (var head false)
  (while (< i n)
    (if_yes (>= ($size out) 4096)
      (out .push {^kind "" ^text (source_slice chars i n)}) (break))
    (var start i)
    (var char : Str chars/%i)
    (var next (char_at chars (+ i 1)))
    (var kind "")
    (if (space char)
      (then
        (set i (+ i 1))
        (while (space (char_at chars i)) (set i (+ i 1))))
      (elif (&& (== char "#") (|| (space next) (== next "") (== next "!")))
        (set kind "comment")
        (while (&& (< i n) (!= chars/%i "\n")) (set i (+ i 1))))
      (elif (&& (== char "#") (== next "<"))
        (set kind "comment")
        (var depth 1)
        (set i (+ i 2))
        (while (&& (< i n) (> depth 0))
          (var pair ($ (char_at chars i) (char_at chars (+ i 1))))
          (if (== pair "#<") (then (set depth (+ depth 1)) (set i (+ i 2)))
            (elif (== pair ">#") (set depth (- depth 1)) (set i (+ i 2)))
            (else (set i (+ i 1))))))
      (elif (&& (== char "#") (== next "_"))
        (set kind "comment") (set i (+ i 2)))
      (elif (|| (== char "\"") (== char "'")
                (&& (|| (== char "$") (== char "#")) (== next "\"")))
        (set kind "string")
        (var regex (== char "#"))
        (if_yes (|| (== char "$") regex) (set i (+ i 1)))
        (var quote (char_at chars i))
        (var width (if (&& (== quote "\"") (== (char_at chars (+ i 1)) quote)
                          (== (char_at chars (+ i 2)) quote)) 3 1))
        (set i (+ i width))
        (while (< i n)
          (if (== chars/%i "\\")
            (then (set i (+ i 1)) (if_yes (< i n) (set i (+ i 1))))
            (elif (&& (== chars/%i quote)
                      (|| (== width 1) (&& (== (char_at chars (+ i 1)) quote)
                                         (== (char_at chars (+ i 2)) quote))))
              (set i (+ i width)) (break))
            (else (set i (+ i 1)))))
        (if_yes regex
          (while (&& (< i n) (str/contains? "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ" chars/%i))
            (set i (+ i 1))))
        (set head false))
      (elif (&& (== char "#") (!= next "") (str/contains? "([{@" next))
        (set kind "punctuation") (set i (+ i 2))
        (set head (|| (== next "(") (== next "@"))))
      (elif (str/contains? "()[]{}:,;`%" char)
        (set kind "punctuation") (set i (+ i 1))
        (set head (== char "(")))
      (else
        (set i (+ i 1))
        # Current reader byte literals: #B#, #B16#, #B64#.
        (var bytes false)
        (if_yes (&& (== char "#") (== next "B"))
          (while (&& (< i n) (! (atom_end chars/%i))) (set i (+ i 1)))
          (var prefix (source_slice chars start i))
          (if_yes (&& (== (char_at chars i) "#") (member " #B #B16 #B64 " prefix))
            (set bytes true) (set i (+ i 1))))
        (while (&& (< i n) (! (atom_end chars/%i))) (set i (+ i 1)))
        (var word (source_slice chars start i))
        (set kind (if bytes "number" (atom_kind word head)))
        (set head false)))
    (out .push {^kind kind ^text (source_slice chars start i)}))
  out)

(fn code_view [text : Str, gene : Bool] : EventTarget
  (if_not gene (return ($dom/render `(code %text))))
  (var code ($dom/render `(code ^class_name "gene_code")))
  (for token in (gene_tokens text)
    (var kind : Str token/kind)
    (var part : Str token/text)
    ($dom/append code ($dom/render
      `(span ^class_name %(if (== kind "") "" ($ "gene_" kind)) %part))))
  code)
