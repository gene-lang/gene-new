# Host-owned voice admissions. Optional plugins never own pending HTTP receipts.
(mod harness_round_client ^profile web)
(import [text flag integer] ^from "../src/common/launcher.gene")
(import [voice_draft_key] ^from "../src/common/voice_transitions.gene")

(type RoundClient ^props {^workspace Str ^pending Any ^resolving Bool
  ^api (Fn [Str Str Any (Fn [Int Any] Void)] Void) ^changed (Fn [Str] Void)
  ^settled (Fn [Any Any] Void)})

(fn storage_key [client : RoundClient] : Str
  $"gene-harness/voice-pending/${client/workspace}")

(fn clear_pending [client : RoundClient] : Void
  ($session_storage/remove (storage_key client))
  (set client/pending nil))

(fn hold_draft [client : RoundClient, session : Str] : Void
  (var key (voice_draft_key client/workspace session))
  (var saved (?? ($session_storage/get key) ""))
  (if_yes (== saved "") (return))
  (try
    (var draft : PropMap ($json/parse saved))
    (set draft/held true)
    (if_yes (! ($session_storage/set key ($json/stringify draft)))
      (client/changed "The refused voice draft could not be marked for review. Inspect it before sending more."))
  catch Any (client/changed "The saved voice draft needs inspection before another submission.")))

(fn admitted [client : RoundClient, receipt : Any] : Void
  (var envelope : Any client/pending)
  # Clearing an admitted prefix belongs to the host too: disabling the plugin
  # while POST is in flight must not leave accepted speech queued for resending.
  (var key (voice_draft_key client/workspace (text envelope/session)))
  (var saved (?? ($session_storage/get key) ""))
  (if_yes (!= saved "")
    (try
      (var draft : PropMap ($json/parse saved))
      (var current (text draft/text))
      (var submitted (text envelope/text))
      (if (== current submitted)
        ($session_storage/remove key)
        (if_yes (str/starts_with? current ($to_str submitted " "))
          (var pieces (str/split current submitted))
          (var rest : (List Str) [])
          (var index 0)
          (for piece in pieces (if_yes (> index 0) (rest .push piece)) (set index (+ index 1)))
          (set draft/text (str/trim (str/join rest submitted)))
          (var remaining_ms (- (integer draft/audio_ms) (integer envelope/input/audio_ms)))
          (set draft/audio_ms (if (< remaining_ms 0) 0 remaining_ms))
          (set draft/held false)
          ($session_storage/set key ($json/stringify draft))))
    catch Any (client/changed "The admitted voice draft could not be updated; inspect it before sending more.")))
  (clear_pending client)
  (client/settled envelope receipt))

(fn recover_round [client : RoundClient] : Void
  (if_yes (|| client/resolving ($absent? client/pending)) (return))
  (if_yes (flag client/pending/invalid)
    (client/changed "Saved voice submission is unreadable. Inspect its conversation before forgetting the request.")
    (return))
  (var envelope : Any client/pending)
  (var workspace client/workspace)
  (set client/resolving true)
  (client/changed "Looking up the voice submission…")
  (client/api "GET"
    $"/api/v8/sessions/${(text envelope/session)}/requests/${(text envelope/request_id)}?kind=round"
    nil
    (fn [code : Int, data : Any] : Void
      (if_yes (!= workspace client/workspace) (return))
      (set client/resolving false)
      (if (== code 200)
        (do (admitted client data) (client/changed "Voice submission recovered."))
        (client/changed "Voice submission outcome is unknown. Inspect the conversation, then resolve or explicitly forget it. It has not been resubmitted.")))))

(fn forget_round [client : RoundClient] : Bool
  (if_yes (|| client/resolving ($absent? client/pending)) (return false))
  (if_yes (! ($session_storage/set (storage_key client) "")) (return false))
  (clear_pending client)
  (client/changed "Voice request forgotten after inspection. This does not cancel or repeat earlier work.")
  true)

(fn configure_rounds [client : RoundClient, workspace : Str] : Void
  (if_yes (== client/workspace workspace) (return))
  (set client/workspace workspace) (set client/pending nil) (set client/resolving false)
  (var saved (?? ($session_storage/get (storage_key client)) ""))
  (if_yes (!= saved "")
    (try
      (var envelope : Any ($json/parse saved))
      (var valid true)
      (for field in ["session" "request_id" "text" "submission_seq"]
        (if_yes (== (text envelope/%field) "") (set valid false)))
      (if valid (set client/pending envelope) (set client/pending {^^invalid}))
    catch Any (set client/pending {^^invalid}))
    (recover_round client)))

(fn dispatch_round [client : RoundClient, session : Str, value : Str, input : Any,
                    done : (Fn [Int Any] Void)] : Void
  (if_yes (|| client/resolving (! ($absent? client/pending)))
    (done 409 {^code "pending_voice" ^^not_sent ^message "Resolve the earlier voice submission first."})
    (return))
  (if_yes (|| (== session "") (== (str/trim value) ""))
    (done 400 {^^not_sent ^message "Choose a conversation and record a nonempty prompt."})
    (return))
  (var input_copy : Any nil)
  (try (set input_copy ($json/parse ($json/stringify input)))
    catch Any
      (hold_draft client session)
      (done 400 {^^not_sent ^message "Voice input metadata could not be encoded."}) (return))
  (set client/resolving true)
  (client/api "GET" $"/api/v8/sessions/${session}/voice" nil
    (fn [code : Int, state : Any] : Void
      (if_yes (!= code 200)
        (set client/resolving false) (hold_draft client session)
        (client/changed "Voice was not submitted. Inspect the draft before trying again.")
        (done code {^^not_sent ^message (text state/message "The conversation is unavailable.")}) (return))
      (if_yes (|| (== (text state/state) "running") (== (text state/state) "waiting"))
        (set client/resolving false)
        (hold_draft client session) (client/changed "The conversation was busy. Review the unsent voice draft before retrying.")
        (done 409 {^code "busy" ^^not_sent ^message "The conversation is still working or waiting for answers."})
        (return))
      (var envelope : Any {^session session ^text value ^input input_copy ^^literal
        ^request_id ($browser/request_id) ^submission_seq (text state/next_submission_seq)})
      (if_yes (! ($session_storage/set (storage_key client) ($json/stringify envelope)))
        (set client/resolving false)
        (done 409 {^^not_sent ^message "Browser storage is required to recover a voice submission."}) (return))
      (set client/pending envelope)
      (client/api "POST" $"/api/v8/sessions/${session}/rounds" envelope
        (fn [accepted : Int, receipt : Any] : Void
          (set client/resolving false)
          (if (== accepted 202)
            (admitted client receipt)
            (do
              (hold_draft client session)
              (if (&& (>= accepted 400) (< accepted 500))
                (do (clear_pending client) (client/changed "Voice was refused. Review the unsent draft before retrying."))
                (client/changed "Voice submission outcome is unknown. The original request is saved."))))
          (done accepted receipt)
          (if_yes (|| (== accepted 0) (>= accepted 500)) (recover_round client)))))))

(fn create_rounds [api : (Fn [Str Str Any (Fn [Int Any] Void)] Void),
                   changed : (Fn [Str] Void), settled : (Fn [Any Any] Void)] : RoundClient
  (RoundClient ^workspace "" ^pending nil ^!resolving ^api api ^changed changed ^settled settled))
