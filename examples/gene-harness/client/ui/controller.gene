# Workspace panel requests, actions and layout; independent of chat drafts.
(mod harness_ui_controller ^profile web)
(import ^from "../notices.gene" [Notices])
(import ^from "./model.gene"
  [
    UiNode
    UiClient
    UiNavigation
    text
    flag
    copy_map
    body_args
    notice
    state_key
    saved_view
    pending_key
    persist_view
    persist_pending
    field_value
    sync_controls
    clear_saved_drafts])
(import ^from "./tree.gene" [apply_tree])
(import ^from "../state.gene" [revision_before])
(import ^from "./router.gene" [navigate update_views install_router capture_view restore_focus update_url layout])

(fn action_notice [ui : UiClient, pending : Any, message : Str, severity : Str = "info", sticky : Bool = true] : Void
  (notice ^key (text pending/request/input_id "legacy-action") ^severity severity ^sticky sticky ^action (if (&& sticky (! (flag pending/settled)) (! ($absent? ui/pending)) (== (text pending/format) "2")) (fn [] : Void (if_yes (== (text ui/pending/request/input_id) (text pending/request/input_id)) (resolve_action ui true))) nil) ^origin {^workspace ui/workspace ^component pending/request/component ^instance pending/request/instance ^arguments pending/request/named ^view_state pending/view_state ^action_id pending/request/input_id}
    ui
    message))

(fn accept_receipt [ui : UiClient, record : Any] : Void
  (if_yes ($absent? ui/pending) (return))
  (var pending : Any ui/pending)
  (if_yes (!= (text pending/format) "2") (return))
  (if_yes (!= (text record/input_id) (text pending/request/input_id)) (return))
  (set pending/command_id (text record/id))
  (persist_pending ui)
  (var status (text record/status))
  (if (|| (== status "accepted") (== status "running"))
    (action_notice ui pending "Saving…")
    (do
      (set pending/settled true)
      (if (== status "done")
        (do
          (clear_saved_drafts ui pending)
          (action_notice ui pending "Saved." "info" false))
        (action_notice ui pending (text record/display status) "error"))
      ($session_storage/remove (pending_key ui))
      (set ui/pending nil)
      (set ui/last_data "")
      (refresh ui)))
  (sync_controls ui))

(fn post_action [ui : UiClient] : Void
  (if_yes (|| ($absent? ui/pending) (! ui/ready)) (return))
  (var pending : Any ui/pending)
  (if_yes (!= (text pending/format) "2") (return))
  (var uncertain (flag pending/uncertain))
  (var attempted (flag pending/attempted))
  (set pending/attempted true)
  (if_not (persist_pending ui)
    (if_not attempted (set ui/pending nil))
    (notice ^key "action-storage" ^origin {^workspace ui/workspace ^component pending/request/component}
      ^^sticky ^severity "error" ui "Browser storage is required before saving an action. Nothing new was submitted.")
    (sync_controls ui)
    (return))
  (notice ^key "action-storage" ^origin {^workspace ui/workspace ^component pending/request/component} ui "")
  (action_notice ui pending "Saving…")
  (sync_controls ui)
  (ui/api
    "POST"
    "/api/v8/ui/actions"
    pending/request
    (fn [code : Int, data : Any] : Void
      (if_yes (|| ($absent? ui/pending) (!= (text ui/pending/request/input_id) (text pending/request/input_id)))
        (return))
      (if (== code 202)
        (accept_receipt ui data)
        (if (&& (>= code 400) (< code 500) (! uncertain) (== (text pending/command_id) ""))
          (do
            ($session_storage/remove (pending_key ui))
            (set ui/pending nil)
            (action_notice
              ui
              pending
              (text data/message "Action refused. Refresh the view.")
              "error")
            (set ui/last_data "")
            (refresh ui))
          (do
            (set pending/uncertain true)
            (set pending/unknown (&& (>= code 400) (< code 500)))
            (persist_pending ui)
            (action_notice ui pending
              (if (== code 410) "Outcome unknown / receipt expired. Inspect the saved data before starting a new action."
                "Save outcome is unknown. Resolve the action before trying again.") "error"))))
      (sync_controls ui))))

(fn resolve_action [ui : UiClient, retry : Bool] : Void
  (if_yes (|| ($absent? ui/pending) ui/resolving (! ui/ready)) (return))
  (var pending : Any ui/pending)
  (if_yes (!= (text pending/format) "2") (return))
  (var id : Str pending/request/input_id)
  (set ui/resolving true)
  (ui/api
    "GET"
    $"/api/v8/ui/actions/${($url/encode_component id)}"
    nil
    (fn [code : Int, data : Any] : Void
      (set ui/resolving false)
      (if_yes (|| ($absent? ui/pending) (!= id (text ui/pending/request/input_id))) (return))
      (if (== code 200)
        (accept_receipt ui data)
        (if (&& (|| (== code 404) (== code 410)) retry)
          (post_action ui)
          (do
            (if_yes (|| (== code 404) (== code 410)) (set pending/unknown true))
            (persist_pending ui)
            (action_notice ui pending
              "No receipt was recovered. Resolve checks the original identity; Dismiss only acknowledges the unknown outcome." "error"))))
      (sync_controls ui))))

(fn submit_action [ui : UiClient, node : UiNode] : Void
  (if_yes (|| ui/safe (! ui/ready) ui/loading ui/render_error (<= ui/navigation/action_generation 0) (!= ui/rendered_revision (text ui/descriptor/revision)) (! ($absent? ui/pending)))
    (return))
  (var name (text node/props/action))
  (var form (if (== node/tag "form") node/key node/form))
  (var named (copy_map node/props/args))
  (var args (body_args node/props/positional))
  (if_not ($absent? ui/forms/%form)
    (var saved : Any ui/forms/%form)
    (if ($absent? saved/named)
      (set named (copy_map saved))
      (do
        (set named (copy_map saved/named))
        (set args (body_args saved/positional)))))
  (for [key raw] in ui/nodes
    (var input : UiNode raw)
    (if_yes (&& (== input/form form) (! ($absent? input/props/field)))
      (var field : Str input/props/field)
      (set named/%field (field_value input))))
  (var request
    {
      ^component ui/descriptor/name
      ^revision ui/descriptor/revision
      ^function name
      ^function_revision ui/descriptor/functions/%name
      ^instance ui/instance
      ^generation ui/navigation/action_generation
      ^input_id $"${ui/navigation/action_generation}:${($browser/request_id)}"
      ^args args
      ^named named})
  (set ui/pending
    {^format "2" ^request request ^form form ^version ui/version ^form_context ui/forms/%form
     ^command_id "" ^view_state (copy_map ui/state) ^!uncertain ^!attempted})
  (persist_view ui)
  (post_action ui))

(fn changed_control [ui : UiClient, node : UiNode] : Void
  (set ui/navigation/focus node/key)
  (if_not ($absent? node/props/field)
    (var form node/form)
    (if_yes ($absent? ui/forms/%form)
      (var owner : UiNode ui/nodes/%form)
      (set ui/forms/%form
        {^named (copy_map owner/props/args) ^positional (body_args owner/props/positional)}))
    (var key node/key)
    (set ui/drafts/%key {^name node/props/field ^form form ^value (field_value node)})
    (persist_view ui))
  (if_not ($absent? node/props/state)
    (var name : Str node/props/state)
    (set ui/state/%name (if (== node/tag "button") node/props/value (field_value node)))
    (set ui/sequence (+ ui/sequence 1))
    (persist_view ui)
    (set ui/debounce (+ ui/debounce 1))
    (var wanted ui/debounce)
    ($time/after
      (if (== node/tag "button")
        0.0
        150.0)
      (fn [] : Void
        (if_yes (== wanted ui/debounce)
          (set ui/last_data "")
          (refresh ui))))))

(fn refresh [ui : UiClient] : Void
  (if_yes (|| ui/safe (! ui/ready) ($absent? ui/descriptor)) (return))
  (var revision : Str ui/descriptor/revision)
  (var data_revision : Str ui/descriptor/data_revision)
  (if_yes (== ui/last_data data_revision) (return))
  (set ui/sequence (+ ui/sequence 1))
  (var sequence ($to_str ui/sequence))
  (var instance ui/instance)
  (set ui/loading true)
  (set ui/last_data data_revision)
  (sync_controls ui)
  (ui/api
    "POST"
    "/api/v8/ui/render"
    {
      ^session ui/session
      ^component ui/descriptor/name
      ^revision revision
      ^instance instance
      ^sequence sequence
      ^state ui/state}
    (fn [code : Int, data : Any] : Void
      (if_yes (|| (!= instance ui/instance) (!= sequence ($to_str ui/sequence)) (!= revision (text ui/descriptor/revision)) (!= data_revision (text ui/descriptor/data_revision)))
        (return))
      (set ui/loading false)
      (if (&& (== code 200) ($absent? data/error))
        (try
          (apply_tree
            ui
            data/view
            (fn [node : UiNode] : Void
              (changed_control ui node))
            (fn [node : UiNode] : Void
              (submit_action ui node)))
          (set ui/rendered_revision revision)
          (notice ^key "render" ui "")
          (set ui/render_error false)
          (restore_focus ui)
        catch Any
          (set ui/render_error true)
          (notice ^key "render" ^^sticky ^severity "error"
            ui
            "The view could not be displayed. Restore the default UI to recover."))
        (do
          (set ui/render_error true)
          (notice ^key "render" ^^sticky ^severity "error"
            ui
            (text data/error (text data/message "View rendering failed.")))))
      (sync_controls ui))))

(fn restore_view [ui : UiClient, descriptor : Any] : Void
  (var name (text descriptor/name))
  (var version (text descriptor/state_version "1"))
  (var previous (text ui/navigation/versions/%name))
  (set ui/descriptor descriptor)
  (if_yes (&& (!= previous "") (!= previous version))
    (notice ^key "state-version" ui "This view changed its state format. Earlier drafts are kept separately."))
  (set ui/navigation/versions/%name version)
  (set ui/rendered_revision "")
  (set ui/instance ($browser/request_id))
  (set ui/sequence (+ ui/sequence 1))
  (set ui/debounce (+ ui/debounce 1))
  (set ui/loading false)
  (set ui/render_error false)
  (set ui/version (text descriptor/state_version "1"))
  (set ui/state (copy_map descriptor/view_state))
  (set ui/nodes {})
  (set ui/drafts {})
  (set ui/forms {})
  (set ui/last_data "")
  ($dom/clear ui/target)
  (var value (saved_view ui (state_key ui)))
  (var restored (copy_map value/state))
  (for [key initial] in ui/state
    (if_not ($absent? restored/%key) (set ui/state/%key restored/%key)))
  (set ui/drafts (copy_map value/drafts))
  (set ui/forms (copy_map value/forms))
  (set ui/navigation/focus (text value/focus))
  (var raw_scroll : Any (?? value/scroll 0))
  (var scroll : Int raw_scroll)
  (set ui/navigation/scroll ($to_float scroll))
  (set ui/navigation/focus_pending true))

(fn restore_pending [ui : UiClient, workspace : Str] : Void
  (if_yes (|| (== workspace "") (== workspace ui/workspace)) (return))
  (set ui/workspace workspace)
  (var saved (?? ($session_storage/get (pending_key ui)) ""))
  (if_yes (!= saved "")
    (set ui/pending (try ($json/parse saved) catch Any nil))
    (if_not ($absent? ui/pending)
      (if (== (text ui/pending/format) "2")
        (do
          (set ui/pending/uncertain true)
          (action_notice ui ui/pending "A saved action needs receipt recovery." "error"))
        (action_notice ui ui/pending "Outcome unknown — recorded before an upgrade. Dismiss acknowledges this notice without repeating the Save." "error"))))
  (sync_controls ui))

(fn action_metadata [ui : UiClient, data : Any] : Void
  (if_yes ($absent? data) (return))
  (var generation : Int data/generation)
  (if_yes (>= generation ui/navigation/action_generation)
    (set ui/navigation/action_generation generation)))

(fn update [ui : UiClient, data : Any] : Void
  (if_yes ui/safe (return))
  (if_yes ($absent? data) (return))
  (var epoch (text data/epoch))
  (var incoming (text data/data_revision))
  (if_yes (&& (== epoch ui/epoch) (!= ui/metadata_revision "") (!= incoming ""))
    (if_yes (revision_before incoming ui/metadata_revision) (return)))
  (if_yes (!= epoch ui/epoch) (set ui/last_data ""))
  (set ui/epoch epoch)
  (set ui/metadata_revision incoming)
  (var workspace (text data/workspace ui/workspace))
  (restore_pending ui workspace)
  (action_metadata ui data/actions)
  (set ui/settings data/settings)
  (var empty : (List Any) [])
  (var raw_components : Any (?? data/components empty))
  (var components : (List Any) raw_components)
  (update_views ui components)
  (sync_controls ui))

(fn controls [ui : UiClient, ready : Bool, session : Str] : Void
  (var reconnect (&& ready (! ui/ready)))
  (var changed_session (!= ui/session session))
  (set ui/ready ready)
  (set ui/session session)
  ($dom/set_attribute
    ($dom/element "ui_default_link")
    "href"
    $"/ui/default?session=${($url/encode_component session)}")
  ($dom/set_attribute
    ($dom/element "ui_workspace_link")
    "href"
    $"/?session=${($url/encode_component session)}")
  (if_yes reconnect (resolve_action ui false))
  (if_yes (|| reconnect changed_session)
    (set ui/sequence (+ ui/sequence 1))
    (set ui/last_data ""))
  ($dom/set_text ($dom/element "ui_connection") (if ready "Connected" "Disconnected · reconnecting…"))
  (refresh ui)
  (sync_controls ui))

(fn event [ui : UiClient, kind : Str, data : Any] : Void
  (if_yes (== kind "status") (restore_pending ui (text data/workspace)))
  (if_yes (&& ui/safe (!= kind "ui/action")) (return))
  (if_yes (== kind "ui/state") (update ui data))
  (if_yes (== kind "ui/action")
    (action_metadata ui data/actions)
    (accept_receipt ui data/record)))

(fn open_reference [ui : UiClient, reference : Any] : Void
  (if_yes (|| ui/safe ($absent? reference/component)) (return))
  (if_not (navigate ui (text reference/component) (text reference/presentation)) (return))
  (for [key value] in (copy_map reference/view_state)
    (if_not ($absent? ui/descriptor/view_state/%key) (set ui/state/%key value)))
  (persist_view ui)
  (set ui/last_data "")
  (refresh ui))

(fn create [root : EventTarget, safe : Bool, notices : Notices, api : (Fn [Str Str Any (Fn [Int Any] Void)] Void), select : (Fn [Str] Void), command : (Fn [Str] Void), prompt : (Fn [Str] Void)] : UiClient
  (var navigation (UiNavigation ^workspace "" ^active "harness" ^last_view "" ^presentation "classic"
    ^remembered {} ^versions {} ^snapshots {} ^views [] ^side "left" ^width 50 ^focus "" ^scroll 0.0
    ^!bar_hidden ^!focus_pending ^action_generation 0 ^action_revision ""
    ^restore (fn [view : Any] : Void (return)) ^refresh (fn [] : Void (return))))
  (var ui
    (UiClient ^root root ^target ($dom/element "ui_view") ^safe safe ^!ready ^session "" ^workspace "" ^epoch "" ^metadata_revision "" ^rendered_revision "" ^descriptor nil ^settings nil ^instance "" ^version "" ^notices notices ^state {} ^drafts {} ^forms {} ^nodes {} ^generation 0 ^sequence 0 ^debounce 0 ^last_data "" ^!loading ^!render_error ^pending nil ^!resolving ^navigation navigation ^navigate (fn [target : Str, presentation : Str] : Void (return)) ^api api ^select select ^command command ^prompt prompt))
  (set navigation/restore (fn [view : Any] : Void (restore_view ui view)))
  (set navigation/refresh (fn [] : Void (refresh ui)))
  (set ui/navigate (fn [target : Str, presentation : Str] : Void (navigate ui target presentation) (return)))
  (install_router ui)
  (layout ui)
  (var workspace_link ($dom/element "ui_workspace_link"))
  (set workspace_link/hidden (! safe))
  ($dom/add_event_listener
    ($dom/element "ui_retry")
    "click"
    (fn [event : Any] : Void
      (set ui/last_data "")
      (refresh ui)))
  ($dom/add_event_listener
    ($dom/element "ui_resolve")
    "click"
    (fn [event : Any] : Void
      (resolve_action ui true)))
  ($dom/add_event_listener
    ($dom/element "ui_discard")
    "click"
    (fn [event : Any] : Void
      (set ui/drafts {})
      (set ui/forms {})
      (persist_view ui)
      (set ui/last_data "")
      (refresh ui)
      (notice ui "Draft edits discarded.")))
  ($dom/add_event_listener
    ($dom/element "ui_cancel")
    "click"
    (fn [event : Any] : Void
      (if_yes ($absent? ui/pending) (return))
      (if_yes (!= (text ui/pending/format) "2") (return))
      (var id (text ui/pending/command_id))
      (if_yes (!= id "")
        (ui/api
          "POST"
          $"/api/v8/ui/actions/${($url/encode_component id)}/cancel"
          {}
          (fn [code : Int, data : Any] : Void
            (notice ui (if (== code 200) "Cancellation requested; effects may already have occurred."
              (text data/message "Cancellation could not be confirmed."))))))))
  ($dom/add_event_listener ($dom/element "ui_dismiss_pending") "click"
    (fn [event : Any] : Void
      (if_yes ($absent? ui/pending) (return))
      (notice ^key (text ui/pending/request/input_id "legacy-action")
        ^origin {^workspace ui/workspace ^component ui/pending/request/component} ui "")
      ($session_storage/remove (pending_key ui))
      (set ui/pending nil)
      (sync_controls ui)))
  ui)
