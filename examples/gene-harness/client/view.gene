(mod harness_client_view ^profile web)

(import [markdown_view] ^from "./markdown.gene")
(import [code_view] ^from "./highlight.gene")
(import [run_label terminal] ^from "./state.gene")

(fn execution_view [text : Str, summary : Str, is_gene : Bool,
                    expanded : Bool, on_copy : (Fn [Str] Void),
                    on_toggle : (Fn [Bool] Void)] : EventTarget
  (var pre ($dom/render `(pre)))
  (var colored (&& is_gene expanded))
  ($dom/append pre (code_view text colored))
  (var details ($dom/render
    `(details ^class_name "execution"
       ^open %expanded
       ^on_toggle %(fn [event : Any] : Void
         (var opened : Bool event/current_target/open)
         (if_yes (&& opened is_gene (! colored))
           ($dom/clear pre)
           ($dom/append pre (code_view text true))
           (set colored true))
         (on_toggle opened))
       (summary %summary)
       (button ^type "button" ^class_name "copy"
         ^on_click %(fn [event : Any] : Void (on_copy text)) "Copy"))))
  ($dom/append details pre)
  details)

(fn block_view [block : Any, provisional : Bool, on_copy : (Fn [Str] Void),
                expanded : Bool, on_toggle : (Fn [Bool] Void),
                ^source_text source_text : Any = nil] : EventTarget
  (var role : Str block/role)
  (var phase : Str block/phase)
  (var text : Str (if ($absent? source_text) block/text source_text))
  (var label (if (== role "user") "You" (if (== role "log") "History" "Gene")))
  (var cls (if (== role "user") "message user" "message agent"))
  (if_yes provisional (set cls $"${cls} provisional"))
  (var view_kind : Str "")
  (if_not ($absent? block/view) (set view_kind block/view/kind))
  (var content : EventTarget
    (if (== role "user")
      ($dom/render `(div ^class_name "message_text" %text))
      (if (== view_kind "gene")
      (execution_view text "Gene file" true true on_copy on_toggle)
      (if (== view_kind "markdown")
        (markdown_view text)
        (if (== phase "command")
          (execution_view text "Command output" false true on_copy on_toggle)
          (if (== phase "code")
            (execution_view text "Response code" true expanded on_copy on_toggle)
            (if (== phase "turn/request")
              (execution_view text "Next request" false true on_copy on_toggle)
              (if (== phase "reply")
              (markdown_view text)
              ($dom/render `(div ^class_name "message_text" %text))))))))))
  (var article : EventTarget
    ($dom/render
      `(article ^class_name %cls
         (div ^class_name "speaker" %label
           %(if (&& provisional (!= role "user")) " · in progress" "")))))
  ($dom/append article content)
  (if_yes block/truncated
    ($dom/append article ($dom/render `(p ^class_name "muted" "Output shortened for display."))))
  article)

(fn not_durable [block : Any] : Bool
  (var durable : Bool block/durable) (! durable))

(fn step_view [blocks : (List Any), opened : Bool, active : Bool,
               on_copy : (Fn [Str] Void), is_open : (Fn [Str] Bool),
               on_toggle : (Fn [Str Bool] Void)] : EventTarget
  (var first : Any blocks/0)
  (var round_id : Str first/round_id)
  (var round : Int first/turn)
  (var key : Str $"${round_id}/turn-${round}")
  (var progress "")
  (var has_code false)
  (var has_result false)
  (for block in blocks
    (var phase : Str block/phase)
    (if_yes (== phase "code") (set has_code true))
    (if_yes (== phase "turn/request") (set has_result true)))
  (if_yes active
    (set progress (if has_result " · Continuing…"
      (if has_code " · Evaluating code…" " · Generating response…"))))
  (var title $"Turn ${round}${progress}")
  (var details ($dom/render
    `(details ^class_name "step" ^open %opened
       ^on_toggle %(fn [event : Any] : Void
         (var open : Bool event/current_target/open) (on_toggle key open))
       (summary %title))))
  (var content ($dom/render `(div ^class_name "step_content")))
  (for block in blocks
    (var id : Str block/id)
    (var phase : Str block/phase)
    ($dom/append content
      (block_view block (not_durable block) on_copy (is_open id)
        (fn [open : Bool] : Void (on_toggle id open))
        ^source_text nil)))
  ($dom/append details content)
  details)

(fn run_status_view [run : Any, prompt : Str, on_retry : (Fn [Str] Void)] : EventTarget
  (var label (run_label run))
  (var status : Str run/state)
  (var failed (|| (== status "failed") (== status "recovery_required")))
  (var detail "")
  (if_not (|| (== status "done") ($absent? run/message))
    (var message : Str run/message)
    (if (str/starts_with? message $"${label}.")
      (set label message) (set detail message)))
  (var root ($dom/render `(div ^class_name %(if failed "run_status run_error" "run_status")
    (span %label))))
  (if_yes (!= detail "")
    ($dom/append root ($dom/render `(span ^class_name "outcome_message" %detail))))
  (if_yes (&& (!= prompt "") (terminal status) (!= status "done"))
    ($dom/append root ($dom/render
      `(button ^type "button" ^class_name "edit_retry"
         ^on_click %(fn [event : Any] : Void (on_retry prompt)) "Edit and retry"))))
  root)
