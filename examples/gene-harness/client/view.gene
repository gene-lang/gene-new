(mod harness_client_view ^profile web)

(import [markdown_view reply_summary] ^from "./markdown.gene")
(import [code_view] ^from "./highlight.gene")
(import [run_label terminal first_prompt_block status_text status_flag] ^from "./state.gene")
(import [attachment_view] ^from "./media.gene")
(import [author_line] ^from "./slack_users.gene")

(fn execution_view [text : Str, summary : Str, is_gene : Bool,
                    expanded : Bool, on_copy : (Fn [Str] Void),
                    on_toggle : (Fn [Bool] Void), ^on_mount on_mount : Any = nil] : EventTarget
  (var pre ($dom/render `(pre)))
  (var colored (&& is_gene expanded))
  ($dom/append pre (code_view text colored))
  (var details ($dom/render
    `(details ^class_name "execution"
       ^open %expanded
       ^on_toggle %(fn [event : Any] : Void
         (var opened : Bool event/current_target/open)
         (if_yes (&& opened is_gene (! colored))
           ($dom/clear pre)
           ($dom/append pre (code_view text true))
           (set colored true))
         (on_toggle opened))
       (summary %summary)
       (button ^type "button" ^class_name "copy"
         ^on_click %(fn [event : Any] : Void (on_copy text)) "Copy"))))
  ($dom/append details pre)
  (if_not ($absent? on_mount)
    (var mounted : (Fn [EventTarget] Void) on_mount) (mounted details))
  details)

(fn block_view [block : Any, provisional : Bool, on_copy : (Fn [Str] Void),
                expanded : Bool, on_toggle : (Fn [Bool] Void),
                ^source_text source_text : Any = nil, ^on_speak on_speak : Any = nil,
                ^resolve_author resolve_author : Any = nil, ^on_execution on_execution : Any = nil] : EventTarget
  (var role : Str block/role)
  (var phase : Str block/phase)
  (var text : Str (if ($absent? source_text) block/text source_text))
  (var label (if (== role "user") "User" "Agent"))
  (var cls (if (== role "user") "message user" "message agent"))
  (if_yes provisional (set cls $"${cls} provisional"))
  (var view_kind : Str "")
  (if_not ($absent? block/view) (set view_kind block/view/kind))
  (var content : EventTarget
    (if (== role "user")
      (then ($dom/render `(div ^class_name "message_text" %text)))
      (elif (== view_kind "gene") (execution_view text "Gene file" true true on_copy on_toggle))
      (elif (== view_kind "markdown") (markdown_view text))
      (elif (== phase "command") (execution_view text (if (&& (== (status_text block/name) "repl")
          ($present? block/mode_instance)) "Result" "Command output") false true on_copy on_toggle))
      (elif (== phase "code") (execution_view ^on_mount on_execution text "Response" true expanded on_copy on_toggle))
      (elif (== phase "turn/request") (execution_view text "Request" false expanded on_copy on_toggle))
      (elif (== phase "reply") (markdown_view text))
      (else ($dom/render `(div ^class_name "message_text" %text)))))
  (var article : EventTarget
    ($dom/render
      `(article ^class_name %cls
         (div ^class_name "speaker" %label
           %(if (&& provisional (!= role "user")) " · in progress" "")))))
  (if_yes (&& (== role "user") ($present? block/input) (== (status_text block/input/kind) "channel"))
    (set content ($dom/render `(div ^class_name "channel_inputs")))
    (var messages : (List Any) block/input/messages)
    (for part in messages
      (var message : Str part/message)
      (var body : Str part/text)
      (var incoming ($dom/render `(div)))
      ($dom/append incoming (author_line "Slack · " part $" · ${message}" resolve_author))
      ($dom/append incoming ($dom/render `(div ^class_name "message_text" %body)))
      ($dom/append content incoming)))
  ($dom/append article content)
  (if_yes (== (status_text block/answer_source/transport) "slack")
    ($dom/append article (author_line "User · Slack " block/answer_source
      " answered the questions." resolve_author)))
  (if_yes (== (status_text block/answer_source/kind) "harness")
    ($dom/append article ($dom/render `(p ^class_name "muted" "User · Harness answered the questions."))))
  (if_not ($absent? block/media)
    (var attachments : (List Any) block/media)
    (var gallery ($dom/render `(div ^class_name "message_attachments")))
    (for asset in attachments ($dom/append gallery (attachment_view asset)))
    ($dom/append article gallery))
  (if_yes block/truncated
    ($dom/append article ($dom/render `(p ^class_name "muted" "Output shortened for display."))))
  article)

# Render the conversation start without inserting synthetic records into paging.
(fn append_history_start [target : EventTarget, session : Any,
  records : (List Any), preview : (List Any), has_older : Bool, loading : Bool,
  on_copy : (Fn [Str] Void), on_load : (Fn [] Void)] : Void
  (var first : Any (first_prompt_block session records preview))
  (if_not ($absent? first)
    ($dom/append target (block_view first false on_copy false (fn [open : Bool] : Void nil))))
  (if_yes has_older
    ($dom/append target
      ($dom/render
        `(button ^type "button" ^class_name "older_messages" ^disabled %loading
           ^on_click %(fn [event : Any] : Void (on_load))
           %(if loading "Loading…" "Load earlier messages"))))))

(fn not_durable [block : Any] : Bool
  (var durable : Bool block/durable) (! durable))

(fn step_view [blocks : (List Any), opened : Bool, active : Bool,
               on_copy : (Fn [Str] Void), is_open : (Fn [Str] Bool),
               on_toggle : (Fn [Str Bool] Void), ^on_speak on_speak : Any = nil,
               ^output_view output_view : Any = nil, ^render_extra render_extra : Any = nil] : EventTarget
  (var first : Any blocks/0)
  (var round_id : Str first/round_id)
  (var round : Int first/turn)
  (var key : Str $"${round_id}/turn-${round}")
  (var progress "")
  (var reply "")
  (var has_code false)
  (var ended false) (var failed false) (var answered false) (var hint "")
  (var final_reply false)
  (for block in blocks
    (var phase : Str block/phase)
    (if_yes (== phase "code")
      (set has_code true) (set hint (status_text block/reply_hint)))
    (if_yes (|| (== phase "turn/end") (== phase "turn/error"))
      (set ended true)
      (if_yes (|| (== (status_text block/reason) "error") (== (status_text block/reason) "cancelled"))
        (set failed true)))
    (if_yes (== phase "questions") (set answered true))
    (if_yes (&& (== phase "turn/patch") (== (status_text block/patch_result/status) "failed")) (set failed true))
    (if_yes (== phase "reply")
      (if_yes (status_flag block/final) (set final_reply true))
      (var text : Str (str/trim block/text))
      (if_yes (!= text "") (set reply text))))
  (if final_reply (set reply "")
    (if_yes (&& (== reply "") (! failed)) (set reply hint)))
  (set reply (reply_summary reply))
  (if_yes (&& active (! ended) (! final_reply))
    (set progress (if has_code " · Evaluating code…" " · Generating response…")))
  (if_yes failed (set progress " · Code error"))
  (if_yes answered (set progress " · Questions"))
  (var title ($to_str $"Turn ${round}" (if (== reply "") "" $": ${reply}") progress))
  (var responses : (List Any) [])
  (var was_open opened)
  (var details ($dom/render
    `(details ^class_name "step" ^open %opened
       ^on_toggle %(fn [event : Any] : Void
         (var open : Bool event/current_target/open)
         # An initially open details element also emits toggle after rendering.
         # Only a real parent transition resets the Response disclosure.
         (if_yes (== open was_open) (return))
         (set was_open open)
         (if_yes open
           (for response in responses
             (var panel : EventTarget response/panel)
             (var id : Str response/id)
             (set panel/open true)
             (on_toggle $"collapsed/${id}" false)))
         (on_toggle key open))
       (summary %title))))
  (var content ($dom/render `(div ^class_name "step_content")))
  (for wanted in ["turn/request" "code"]
    (for block in blocks
      (var phase : Str block/phase)
      (if_yes (!= phase wanted) (continue))
      (var id : Str block/id)
      (var response (== phase "code"))
      (var expanded (if response (&& opened (! (is_open $"collapsed/${id}"))) (is_open id)))
      ($dom/append content (block_view block (not_durable block) on_copy expanded
        (fn [open : Bool] : Void
          (if response (on_toggle $"collapsed/${id}" (! open)) (on_toggle id open)))
        ^on_execution (fn [panel : EventTarget] : Void
          (responses .push {^id id ^panel panel}))))))
  (if_not ($absent? output_view)
    (var output : EventTarget output_view) ($dom/append content output))
  (for block in blocks
    (var id : Str block/id)
    (var phase : Str block/phase)
    (if_yes (|| (== phase "turn/request") (== phase "code") (== phase "turn/start") (== phase "turn/end")) (continue))
    (if_yes (== phase "reply")
      (if_yes (status_flag block/final) (continue))
      (var media : (List Any) [])
      (if_not ($absent? block/media) (set media block/media))
      (if_yes (&& (> media/.size 0) ($present? render_extra))
        (var media_render : (Fn [EventTarget Any] Void) render_extra) (media_render content block))
      (continue))
    (if ($absent? render_extra)
      ($dom/append content (block_view block (not_durable block) on_copy (is_open id)
        (fn [open : Bool] : Void (on_toggle id open))))
      (do (var render : (Fn [EventTarget Any] Void) render_extra) (render content block))))
  ($dom/append details content)
  details)

(fn run_status_view [run : Any, prompt : Str, on_retry : (Fn [Str] Void), ^on_continue on_continue : Any = nil] : EventTarget
  (var label (run_label run))
  (var status : Str run/state)
  (var limited (|| (== label "Turn limit reached") (== status "paused")))
  (var resumable (if ($absent? run/resumable) (== status "paused") (status_flag run/resumable)))
  (var failed (|| (== status "failed") (== status "recovery_required")))
  (var detail "")
  (if_not (|| limited (== status "done") ($absent? run/message))
    (var message : Str run/message)
    (if (str/starts_with? message $"${label}.")
      (set label message) (set detail message)))
  (var root ($dom/render `(div ^class_name %(if failed "run_status run_error" "run_status")
    (span %label))))
  (if_yes (!= detail "")
    ($dom/append root ($dom/render `(span ^class_name "outcome_message" %detail))))
  (if_not ($absent? run/continuation_error)
    ($dom/append root ($dom/render `(span ^class_name "outcome_message" %(status_text run/continuation_error)))))
  (if_yes (&& limited resumable ($present? on_continue)
              ($absent? run/continued_by) ($absent? run/continuation_stop))
    (var resume : (Fn [Str] Void) on_continue)
    (for mode in ["manual" "automatic"]
      ($dom/append root ($dom/render `(button ^type "button"
        ^on_click %(fn [event : Any] : Void (set event/current_target/disabled true) (resume mode))
        %(if (== mode "manual") "Continue" "Continue until finished"))))))
  (if_yes (&& limited (|| (!= status "paused")
    (== (status_text run/continuation_stop) "failed")
    (&& (! resumable) ($absent? run/continued_by) ($absent? run/continuation_stop))))
    ($dom/append root ($dom/render `(span ^class_name "outcome_message"
      "Send a new message in this conversation to resume the remaining work."))))
  (if_yes (&& (! limited) (!= prompt "") (terminal status) (!= status "done"))
    ($dom/append root ($dom/render
      `(button ^type "button" ^class_name "edit_retry"
         ^on_click %(fn [event : Any] : Void (on_retry prompt)) "Edit and retry"))))
  root)
