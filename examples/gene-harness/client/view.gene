(mod harness_client_view ^profile web)

(import [markdown_view] ^from "./markdown.gene")
(import [code_view] ^from "./highlight.gene")
(import [file_source model_code_source] ^from "./source.gene")
(import [run_label terminal] ^from "./state.gene")

(fn execution_view [text : Str, summary : Str, raw : Bool, gene : Bool,
                    expanded : Bool, on_copy : (Fn [Str] Void),
                    on_toggle : (Fn [Bool] Void)] : EventTarget
  (var pre ($dom/render `(pre)))
  (var colored (&& gene expanded))
  ($dom/append pre (code_view text colored))
  (var details ($dom/render
    `(details ^class_name %(if raw "execution raw_response" "execution")
       ^open %expanded
       ^on_toggle %(fn [event : Any] : Void
         (var opened : Bool event/current_target/open)
         (if_yes (&& opened gene (! colored))
           ($dom/clear pre)
           ($dom/append pre (code_view text true))
           (set colored true))
         (on_toggle opened))
       (summary %summary)
       (button ^type "button" ^class_name "copy"
         ^on_click %(fn [event : Any] : Void (on_copy text)) "Copy"))))
  ($dom/append details pre)
  details)

(fn source_view [source : Any, on_copy : (Fn [Str] Void)] : EventTarget
  (var text : Str source/text)
  (var path : Str source/path)
  (var gene : Bool source/gene)
  (var root ($dom/render
    `(div ^class_name "source_preview"
       (div ^class_name "source_header"
         (span ^class_name "source_path" %path)
         (button ^type "button" ^class_name "copy"
           ^on_click %(fn [event : Any] : Void (on_copy text))
           %(if gene "Copy code" "Copy text"))))))
  (var pre ($dom/render `(pre ^class_name "source_pre")))
  ($dom/append pre (code_view text gene))
  ($dom/append root pre)
  (if_yes source/truncated
    ($dom/append root ($dom/render `(p ^class_name "muted source_notice" "File content was shortened by the tool."))))
  root)

(fn block_view [block : Any, provisional : Bool, on_copy : (Fn [Str] Void),
                expanded : Bool, on_toggle : (Fn [Bool] Void),
                ^source_text source_text : Any = nil] : EventTarget
  (var role : Str block/role)
  (var phase : Str block/phase)
  (var text : Str (if ($absent? source_text) block/text source_text))
  (var label (if (== role "user") "You" (if (== role "log") "History" "Gene")))
  (var cls (if (== role "user") "message user" "message agent"))
  (if_yes provisional (set cls $"${cls} provisional"))
  (var raw (== phase "raw_response"))
  (var source : Any nil)
  (if_yes (|| (== phase "tool_result") (== phase "tool_call") (== phase "command_result"))
    (set source (file_source text)))
  (var command_code (&& (== role "user")
    (|| (str/starts_with? (str/trim text) "/code ")
        (str/starts_with? (str/trim text) "/code\n")
        (str/starts_with? (str/trim text) "/code\r")
        (str/starts_with? (str/trim text) "/code\t"))))
  (var step : Int block/round)
  (var summary (if raw $"Raw LLM response · Step ${step}"
    (if (== phase "code") "Gene code"
      (if (== phase "tool_call") "Tool request"
        (if (== phase "tool_result") "Tool result" "Execution result")))))
  (var content : EventTarget
    (if (! ($absent? source))
      (source_view source on_copy)
      (if (|| raw (== phase "code") (== phase "result")
            (== phase "tool_call") (== phase "tool_result"))
        (execution_view text summary raw true expanded on_copy on_toggle)
        (if command_code
          (do
            (var pre ($dom/render `(pre ^class_name "user_code")))
            ($dom/append pre (code_view text true))
            pre)
          (if (&& (== role "assistant") (|| (== phase "final") (== phase "narration")))
            (markdown_view text)
            ($dom/render `(div ^class_name "message_text" %text)))))))
  (var article : EventTarget
    ($dom/render
      `(article ^class_name %cls
         (div ^class_name "speaker" %label
           %(if provisional " · in progress" "")))))
  ($dom/append article content)
  (if_yes (&& (! ($absent? source)) (!= phase "command_result"))
    ($dom/append article (execution_view text "Raw tool data" false true expanded on_copy on_toggle)))
  (if_yes block/truncated
    ($dom/append article ($dom/render `(p ^class_name "muted" "Output shortened for display."))))
  article)

(fn not_durable [block : Any] : Bool
  (var durable : Bool block/durable) (! durable))

(fn step_view [blocks : (List Any), opened : Bool, active : Bool,
               on_copy : (Fn [Str] Void), is_open : (Fn [Str] Bool),
               on_toggle : (Fn [Str Bool] Void)] : EventTarget
  (var first : Any blocks/0)
  (var run_id : Str first/run_id)
  (var round : Int first/round)
  (var key : Str $"${run_id}/step-${round}")
  (var progress "")
  (var has_code false)
  (var has_tool false)
  (var has_result false)
  (var authored_code : Any nil)
  (for block in blocks
    (var phase : Str block/phase)
    (if_yes (== phase "raw_response")
      (var reply : Str block/text)
      (set authored_code (model_code_source reply)))
    (if_yes (|| (== phase "code") (== phase "tool_call")) (set has_code true))
    (if_yes (== phase "tool_call") (set has_tool true))
    (if_yes (|| (== phase "result") (== phase "tool_result")) (set has_result true)))
  (if_yes active
    (set progress (if has_result " · Result received"
      (if has_tool " · Running tool…"
        (if has_code " · Running code…" " · Generating response…")))))
  (var title $"Step ${round}${progress}")
  (var details ($dom/render
    `(details ^class_name "step" ^open %opened
       ^on_toggle %(fn [event : Any] : Void
         (var open : Bool event/current_target/open) (on_toggle key open))
       (summary %title))))
  (var content ($dom/render `(div ^class_name "step_content")))
  (for block in blocks
    (var id : Str block/id)
    (var phase : Str block/phase)
    ($dom/append content
      (block_view block (not_durable block) on_copy (is_open id)
        (fn [open : Bool] : Void (on_toggle id open))
        ^source_text (if (== phase "code") authored_code nil))))
  ($dom/append details content)
  details)

(fn run_status_view [run : Any, prompt : Str, on_retry : (Fn [Str] Void)] : EventTarget
  (var label (run_label run))
  (var status : Str run/status)
  (var failed (|| (== status "failed") (== status "recovery_required")))
  (var detail "")
  (if_not ($absent? run/message)
    (var message : Str run/message)
    (if (str/starts_with? message ($ label "."))
      (set label message) (set detail message)))
  (var root ($dom/render `(div ^class_name %(if failed "run_status run_error" "run_status")
    (span %label))))
  (if_yes (!= detail "")
    ($dom/append root ($dom/render `(span ^class_name "outcome_message" %detail))))
  (if_yes (&& (!= prompt "") (terminal status) (!= status "completed"))
    ($dom/append root ($dom/render
      `(button ^type "button" ^class_name "edit_retry"
         ^on_click %(fn [event : Any] : Void (on_retry prompt)) "Edit and retry"))))
  root)
