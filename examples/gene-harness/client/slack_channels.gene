(mod slack_channels ^profile web)
(import [text flag] ^from "../src/common/launcher.gene")

(fn can_share_session? [session : Any] : Bool
  (&& (flag session/slack_available) (== (text session/kind) "interactive")
    ($absent? session/channel) ($absent? session/parent)))

(fn session_share_pending? [session : Any] : Bool
  (var status (text session/slack_share/status))
  (|| (== status "pending") (== status "accepted")))

(fn session_share_label [session : Any] : Str
  (var status (text session/slack_share/status))
  (if_yes (== status "failed") (return "Slack share failed"))
  (if_yes (== status "uncertain") (return "Slack share needs attention"))
  (if_yes (session_share_pending? session) (return "Adding to Slack…"))
  "Add to Slack")

(fn session_share_busy? [session : Any] : Bool
  (var status (text session/status))
  # A failed or uncertain delivery still needs owner reconciliation. A second
  # share request cannot retry the durable intent or safely create a new one.
  (|| ($present? session/slack_share) (== status "running") (== status "waiting")))
