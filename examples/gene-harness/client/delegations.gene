(mod delegation_views ^profile web)

(fn dtext [value : Any, fallback : Str = ""] : Str
  (if_yes ($absent? value) (return fallback))
  (var text : Str value)
  text)

(fn dint [value : Any, fallback : Int = 0] : Int
  (if_yes ($absent? value) (return fallback))
  (var number : Int value)
  number)

(fn dflag [value : Any] : Bool
  (if_yes ($absent? value) (return false))
  (var flag : Bool value)
  flag)

(fn dlist [value : Any] : (List Any)
  (if_yes ($absent? value) (return []))
  (var items : (List Any) value)
  items)

(fn dstrings [value : Any] : (List Str)
  (if_yes ($absent? value) (return []))
  (var items : (List Str) value)
  items)

(fn elapsed_text [elapsed : Int] : Str
  (var seconds (/ elapsed 1000))
  $"${seconds} s elapsed")

(fn tick_elapsed [target : EventTarget, elapsed : Int, alive : (Fn [] Bool)] : Void
  ($time/after 1000.0 (fn [] : Void
    (if_not (alive) (return))
    (var next (+ elapsed 1000))
    ($dom/set_text target (elapsed_text next))
    (tick_elapsed target next alive))))

(fn session_link [session : Str, title : Str, open : (Fn [Str] Void)] : EventTarget
  ($dom/render `(a ^href %$"/?session=${($url/encode_component session)}&view=harness"
    ^on_click %(fn [event : Any] : Void
      ($dom/prevent_default event)
      (open session)) %title)))

(fn delegation_view [data : Any, open : (Fn [Str] Void), cancel : (Fn [] Void), alive : (Fn [] Bool)] : EventTarget
  (var state (dtext data/state))
  (var title (dtext data/title))
  (var section ($dom/render `(section ^class_name "card_block" ^aria-label %$"Delegation: ${title}")))
  ($dom/append section ($dom/render `(div ^class_name "card_header"
    (strong ^class_name "card_title" %title)
    (span ^class_name "card_status" ^role "status" %state))))
  (var used (dint data/turns_used))
  (var limit : Int data/turn_limit)
  (var elapsed (dint data/elapsed_ms))
  (var body ($dom/render `(div ^class_name "card_body"
    (p %$"${used} / ${limit} turns"))))
  (var clock ($dom/render `(p %(elapsed_text elapsed))))
  ($dom/append body clock)
  (if_yes (&& (! ($absent? data/started_at_ms))
             (|| (== state "running") (== state "waiting") (== state "queued")))
    (tick_elapsed clock elapsed alive))
  (if_not ($absent? data/usage/total_tokens)
    (var known : Bool data/usage/tokens_known)
    (var tokens (dint data/usage/total_tokens))
    ($dom/append body ($dom/render `(p %(if known $"${tokens} tokens" "Token usage unavailable")))))
  (if_yes (== state "waiting")
    ($dom/append body ($dom/render `(p "Waiting for an answer in the child session."))))
  (var reply (dtext data/reply (dtext data/message)))
  (if_yes (!= reply "") ($dom/append body ($dom/render `(pre %reply))))
  ($dom/append section body)
  (var controls ($dom/render `(div ^class_name "card_controls")))
  (if_yes (dflag data/session_exists)
    ($dom/append controls (session_link (dtext data/session) "Open child session" open)))
  (if_yes (dflag data/can_cancel)
    ($dom/append controls ($dom/render `(button ^type "button"
      ^on_click %(fn [event : Any] : Void (cancel)) "Cancel"))))
  ($dom/append section controls)
  section)

(fn recovery_view [data : Any, action : (Fn [Str] Void)] : EventTarget
  (var children : (List Str) data/children)
  ($dom/render `(section ^class_name "card_block" ^aria-label "Delegation recovery"
    (div ^class_name "card_header" (strong "Child work was interrupted"))
    (div ^class_name "card_body"
      (p "Continue with the interrupted results, or cancel this round.")
      (p %($str/join children ", ")))
    (div ^class_name "card_controls"
      (button ^type "button" ^on_click %(fn [event : Any] : Void (action "continue")) "Continue")
      (button ^type "button" ^on_click %(fn [event : Any] : Void (action "cancel")) "Cancel round")))))
