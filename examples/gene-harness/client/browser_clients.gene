# Host-owned executable-contribution lifecycle. Feature state stays in plugins.
(mod harness_browser_clients ^profile web)
(import [trap_modal_tab release_modal chord_recording?] ^from "./overlays.gene")
(import [text flag integer] ^from "../src/common/launcher.gene")

(type BrowserClients ^props {^root EventTarget ^safe Bool ^bridge Any
  ^mounts PropMap ^outlets PropMap ^descriptors PropMap ^generation Int})

(fn dispose [host : BrowserClients, name : Str] : Nil
  (var record : Any host/mounts/%name)
  (if ($absent? record) (return))
  (set host/mounts/%name nil)
  (if (flag record/failed) (return))
  (var mount : EventTarget record/root)
  # Revoke the external outlet first, so focus restoration cannot choose a
  # toolbar button that is about to disappear, even if cleanup throws.
  (if ($present? record/toolbar)
    (do (var toolbar : EventTarget record/toolbar)
    ($dom/remove toolbar)))
  (if ($present? record/composer)
    (do (var composer : EventTarget record/composer)
    ($dom/remove composer)))
  (var subscriptions : (List Any) (if ($absent? record/subscriptions) [] else record/subscriptions))
  (for subscription in subscriptions
    (try
      (var revoke : (Fn [] Nil) subscription)
      (revoke)
    catch Throwable ($console/error "Browser contribution subscription cleanup failed.")))
  (try
    (if ($present? mount/harness_controller/dispose)
      (do (var cleanup : (Fn [] Nil) mount/harness_controller/dispose)
      (cleanup)))
  catch Throwable ($console/error "Browser contribution cleanup failed."))
  (release_modal (text record/owner) true)
  ($dom/remove mount))

(fn fail_client [host : BrowserClients, name : Str, message : Str] : Nil
  (var record : Any host/mounts/%name)
  (if ($absent? record) (return))
  (dispose host name)
  # Retain a failed revision marker; only replacement/re-enable may retry it.
  (set host/mounts/%name {^^failed ^revision record/revision ^generation record/generation})
  ($console/error message))

(fn update_clients [host : BrowserClients, descriptors : (List Any), status : Any] : Nil
  (set host/descriptors {})
  (for descriptor in descriptors
    (var key (text descriptor/name))
    (set host/descriptors/%key descriptor))
  (var wanted : PropMap {})
  (if (! host/safe)
    (for descriptor in descriptors
      # View-scoped clients are mounted by their view outlet, not into the
      # page's toolbar and composer outlets.
      (if (== (text descriptor/scope "page") "view") (continue))
      (var name (text descriptor/name))
      (set wanted/%name descriptor)))
  (map_for [name record] in host/mounts
    (var next : Any wanted/%name)
    (if (&& ($present? record)
      (|| ($absent? next) (!= next/revision record/revision))) (dispose host ($to_str name))))
  (map_for [name descriptor] in wanted
    (var record : Any host/mounts/%name)
    (if ($absent? record)
      (do
        (set host/generation (+ host/generation 1))
        (var generation host/generation)
        (var mount ($dom/create_element "div"))
        (var toolbar ($dom/create_element "span"))
        (var composer ($dom/create_element "span"))
        (var source_bridge : PropMap host/bridge)
        (var bridge : PropMap {})
        (map_for [key value] in source_bridge (set bridge/%key value))
        (var capabilities : Any {})
        (if ($present? source_bridge/capabilities_for)
          (do (var provide_capabilities : (Fn [Str] Any) source_bridge/capabilities_for)
          (set capabilities (provide_capabilities ($to_str name)))))
        (set bridge/capabilities capabilities)
        (set bridge/capabilities_for nil)
        (var host_toolbar : EventTarget host/bridge/toolbar)
        ($dom/append host_toolbar toolbar)
        (set bridge/toolbar toolbar)
        (if ($present? host/bridge/composer_actions)
          (do (var host_composer : EventTarget host/bridge/composer_actions)
          ($dom/append host_composer composer)
          (set bridge/composer_actions composer)))
        (var owner $"${name}:${generation}")
        (var subscriptions : (List Any) [])
        (set bridge/subscribe (fn [callback : (Fn [Str Str Any] Nil)] : (Fn [] Nil)
          (var current : Any host/mounts/%name)
          (if (|| ($absent? current) (flag current/failed) (!= (integer current/generation) generation))
            (return (fn [] : Nil (return))))
          (var unsubscribe : (Fn [] Nil)
            (if ($absent? source_bridge/subscribe_owned)
              (do
                (var subscribe : (Fn [(Fn [Str Str Any] Nil)] (Fn [] Nil)) source_bridge/subscribe)
                (subscribe callback))
              else (do
                (var subscribe_owned : (Fn [Str (Fn [Str Str Any] Nil)] (Fn [] Nil)) source_bridge/subscribe_owned)
                (subscribe_owned ($to_str name) callback))))
          (var active true)
          (var revoke (fn [] : Nil
            (if (! active) (return))
            (set active false)
            (unsubscribe)))
          (subscriptions .push revoke)
          revoke))
        (set bridge/subscribe_owned nil)
        (set mount/harness_bridge bridge)
        (set mount/harness_owner owner)
        (set record {^root mount ^toolbar toolbar ^composer composer ^revision descriptor/revision ^owner owner
          ^generation generation ^status status ^subscriptions subscriptions})
        (set host/mounts/%name record)
        ($dom/append ($dom/body) mount)
        (if (!= (text descriptor/stylesheet) "")
          ($dom/append mount ($dom/render
            `(link ^rel "stylesheet" ^href %(text descriptor/stylesheet)))))
        ($browser/load_module (text descriptor/url)
          (fn [module : Any] : Nil
            (var current : Any host/mounts/%name)
            (if (|| ($absent? current) (!= (integer current/generation) generation)) (return))
            (try
              (var start : (Fn [EventTarget] Nil) module/main)
              (start mount)
              (var update : (Fn [Any] Nil) mount/harness_controller/update)
              (update current/status)
            catch Throwable
              (fail_client host ($to_str name) "Browser contribution failed to mount.")))
          (fn [message : Str] : Nil
            (var current : Any host/mounts/%name)
            (if (|| ($absent? current) (!= (integer current/generation) generation)) (return))
            (fail_client host ($to_str name) message))))
      else (do
        (set record/status status)
        (if (&& ($present? record/root/harness_controller/update) (! (flag record/failed)))
          (try
            (var update : (Fn [Any] Nil) record/root/harness_controller/update)
            (update status)
          catch Throwable
            (fail_client host ($to_str name) "Browser contribution failed to update.")))))))

# ---------------------------------------------------------------------------
# View-owned outlets
# ---------------------------------------------------------------------------

(fn outlet_descriptor [host : BrowserClients, name : Str] : Any
  (var descriptor : Any host/descriptors/%name)
  descriptor)

(fn dispose_outlet [host : BrowserClients, name : Str] : Nil
  (var record : Any host/outlets/%name)
  (if ($absent? record) (return))
  (set host/outlets/%name nil)
  (if (flag record/failed) (return))
  (var root : EventTarget record/element)
  (var subscriptions : (List Any) (if ($absent? record/subscriptions) [] else record/subscriptions))
  (for subscription in subscriptions
    (try
      (var revoke : (Fn [] Nil) subscription)
      (revoke)
    catch Throwable ($console/error "View outlet subscription cleanup failed.")))
  (try
    (if ($present? root/harness_controller/dispose)
      (do (var cleanup : (Fn [] Nil) root/harness_controller/dispose)
      (cleanup)))
  catch Throwable ($console/error "View outlet cleanup failed."))
  (release_modal (text record/owner) true)
  (if ($present? root) ($dom/clear root)))

(fn fail_outlet [host : BrowserClients, name : Str, element : EventTarget, message : Str] : Nil
  (var record : Any host/outlets/%name)
  (dispose_outlet host name)
  (set host/outlets/%name {^^failed ^revision (if ($present? record) (text record/revision) else "")
                           ^element element ^generation (if ($present? record) (integer record/generation) else 0)})
  ($dom/set_text element "The editor view could not be loaded.")
  ($console/error message))

(fn mount_outlet [host : BrowserClients, name : Str, outlet : Any,
                  context : Any, descriptor : Any] : Nil
  (var element : EventTarget outlet/element)
  ($dom/clear element)
  (set host/generation (+ host/generation 1))
  (var generation host/generation)
  (var source_bridge : PropMap host/bridge)
  (var bridge : PropMap {})
  (map_for [key value] in source_bridge (set bridge/%key value))
  (var capabilities : Any {})
  (if ($present? source_bridge/capabilities_for)
    (do (var provide_capabilities : (Fn [Str] Any) source_bridge/capabilities_for)
    (set capabilities (provide_capabilities name))))
  (set bridge/capabilities capabilities)
  (set bridge/capabilities_for nil)
  (set bridge/toolbar ($dom/create_element "span"))
  (set bridge/composer_actions nil)
  (set bridge/view
    {^name (text context/view_name) ^title (text context/view/title)
     ^presentation (text context/view/presentation)
     ^state_version (text context/view/state_version "1")
     ^view_state context/view_state})
  (set bridge/save_view_state context/save)
  (var owner $"${name}:view:${generation}")
  (var subscriptions : (List Any) [])
  (set bridge/subscribe (fn [callback : (Fn [Str Str Any] Nil)] : (Fn [] Nil)
    (var current : Any host/outlets/%name)
    (if (|| ($absent? current) (flag current/failed) (!= (integer current/generation) generation))
      (return (fn [] : Nil (return))))
    (var unsubscribe : (Fn [] Nil)
      (if ($absent? source_bridge/subscribe_owned)
        (do
          (var subscribe : (Fn [(Fn [Str Str Any] Nil)] (Fn [] Nil)) source_bridge/subscribe)
          (subscribe callback))
        else (do
          (var subscribe_owned : (Fn [Str (Fn [Str Str Any] Nil)] (Fn [] Nil)) source_bridge/subscribe_owned)
          (subscribe_owned ($to_str name) callback))))
    (var active true)
    (var revoke (fn [] : Nil
      (if (! active) (return))
      (set active false)
      (unsubscribe)))
    (subscriptions .push revoke)
    revoke))
  (set bridge/subscribe_owned nil)
  (set element/harness_bridge bridge)
  (set element/harness_owner owner)
  (var record
    # The view tree iterates a PropMap, so `outlet/key` is a Sym; the shared
    # text helper accepts the Str/Sym union and renders a Sym by name.
    {^element element ^key (text outlet/key) ^view (text context/view_name)
     ^workspace (text context/workspace) ^revision (text descriptor/revision)
     ^owner owner ^generation generation
     ^subscriptions subscriptions ^status context/status ^!failed})
  (set host/outlets/%name record)
  (if (!= (text descriptor/stylesheet) "")
    ($dom/append element ($dom/render
      `(link ^rel "stylesheet" ^href %(text descriptor/stylesheet)))))
  ($browser/load_module (text descriptor/url)
    (fn [module : Any] : Nil
      (var current : Any host/outlets/%name)
      (var current_element : EventTarget current/element)
      (if (|| ($absent? current) (!= (integer current/generation) generation)
                  (! (same? current_element element)))
        (return))
      (try
        (var start : (Fn [EventTarget] Nil) module/main)
        (start element)
        (var update : (Fn [Any] Nil) element/harness_controller/update)
        (update context/status)
      catch Throwable
        (do
          ($console/error $err/.message)
          (fail_outlet host name element "The editor view failed to mount."))))
    (fn [message : Str] : Nil
      (var current : Any host/outlets/%name)
      (var current_element : EventTarget current/element)
      (if (|| ($absent? current) (!= (integer current/generation) generation)
                  (! (same? current_element element)))
        (return))
      (fail_outlet host name element message))))

(fn update_outlets [host : BrowserClients, outlets : (List Any), context : Any] : Nil
  # The view tree supplies the outlet element and identity; this manager keeps
  # exactly one contribution mount per outlet name and disposes it when the
  # view, element, workspace, or contribution revision changes.
  (var wanted : PropMap {})
  (for outlet in outlets
    (var name (text outlet/name))
    (if (!= name "") (set wanted/%name outlet)))
  (if (== (text context/view_name) "")
    (do
      (map_for [name record] in host/outlets (dispose_outlet host ($to_str name)))
      (return)))
  (map_for [raw_name record] in host/outlets
    (var name ($to_str raw_name))
    (var next : Any wanted/%name)
    (var replaced false)
    (if ($present? next)
      (do
        (var next_element : EventTarget next/element)
        (var record_element : EventTarget record/element)
        (set replaced (! (same? next_element record_element)))))
    (if (|| ($absent? next)
            (== (text context/view_name) "")
            (!= (text context/workspace) (text record/workspace))
            (!= (text context/view_name) (text record/view))
            replaced)
      (dispose_outlet host name)))
  (map_for [raw_name outlet] in wanted
    (var name ($to_str raw_name))
    (var descriptor (outlet_descriptor host name))
    (var record : Any host/outlets/%name)
    (if ($present? record)
      (if (flag record/failed)
        (if (&& ($present? descriptor)
                (!= (text descriptor/revision) (text record/revision)))
          (do
            (set host/outlets/%name nil)
            (mount_outlet host name outlet context descriptor)))
        else (if ($absent? descriptor)
          (do
            (dispose_outlet host name)
            (set host/outlets/%name {^^failed ^revision "" ^element outlet/element ^generation 0})
            ($dom/set_text outlet/element "The editor view is unavailable."))
          else (if (!= (text descriptor/revision) (text record/revision))
            (do
              (dispose_outlet host name)
              (mount_outlet host name outlet context descriptor))
            else (do
              (set record/status context/status)
              (var bridge : PropMap record/element/harness_bridge)
              (set bridge/view
                {^name (text context/view_name) ^title (text context/view/title)
                 ^presentation (text context/view/presentation)
                 ^state_version (text context/view/state_version "1")
                 ^view_state context/view_state})
              (set bridge/save_view_state context/save)
              (if ($present? record/element/harness_controller/update)
                (try
                  (var update : (Fn [Any] Nil) record/element/harness_controller/update)
                  (update context/status)
                catch Throwable
                  (fail_outlet host name outlet/element "The editor view failed to update.")))))))
      else (if ($present? descriptor)
        (mount_outlet host name outlet context descriptor)
        else (do
          ($dom/set_text outlet/element "The editor view is unavailable.")
          (set host/outlets/%name {^^failed ^revision "" ^element outlet/element ^generation 0}))))))

(fn create_clients [root : EventTarget, safe : Bool, bridge : Any] : BrowserClients
  (var host (BrowserClients ^root root ^safe safe ^bridge bridge ^mounts {}
    ^outlets {} ^descriptors {} ^generation 0))
  ($dom/add_event_listener ^^capture ($dom/window) "keydown"
    (fn [event : Any] : Nil
      (if (|| ($event/is_composing event) (chord_recording?)) (return))
      (var handled (trap_modal_tab event))
      (map_for [name record] in host/mounts
        (if (&& (! handled) ($present? record) (! (flag record/failed))
                    ($present? record/root/harness_controller/key))
          (try
            (var key : (Fn [Any] Bool) record/root/harness_controller/key)
            (set handled (key event))
          catch Throwable
            (fail_client host ($to_str name) "Browser contribution keyboard handler failed.")
            (set handled true))))
      (map_for [name record] in host/outlets
        (if (&& (! handled) ($present? record) (! (flag record/failed))
                    ($present? record/element/harness_controller/key))
          (try
            (var key : (Fn [Any] Bool) record/element/harness_controller/key)
            (set handled (key event))
          catch Throwable
            (fail_outlet host ($to_str name) record/element "View outlet keyboard handler failed.")
            (set handled true))))
      (if handled (do ($dom/prevent_default event) ($dom/stop_propagation event)))))
  host)
