(mod pcm_frames ^profile web)

(fn write_u32 [bytes : (Buffer U8), offset : Int, value : Int] : Void
  (var number value) (var i 0)
  (while (< i 4)
    (bytes .set (+ offset i) (// number 256))
    (set number (/ number 256)) (set i (+ i 1))))

(fn read_u32 [bytes : (Buffer U8), offset : Int] : Int
  (var result 0) (var scale 1) (var i 0)
  (while (< i 4)
    (set result (+ result (* (bytes .get (+ offset i)) scale)))
    (set scale (* scale 256)) (set i (+ i 1)))
  result)

(fn pack_pcm [kind : Int, stream : Int, sequence : Int, pcm : (Buffer U8)] : (Buffer U8)
  (var frame ($buffer U8 (+ 9 pcm/.len)))
  (frame .set 0 kind) (write_u32 frame 1 stream) (write_u32 frame 5 sequence)
  (frame .copy_from pcm 0 pcm/.len 9)
  frame)

(fn frame_pcm [frame : (Buffer U8)] : (Buffer U8)
  (var pcm ($buffer U8 (- frame/.len 9)))
  (pcm .copy_from frame 9 frame/.len 0)
  pcm)
