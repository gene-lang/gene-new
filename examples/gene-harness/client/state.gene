(mod harness_client_state ^profile web)

(import ^from "../src/web/contract.gene" ^^export [terminal_round : terminal])

(fn merge_blocks [previous : (List Any), incoming : (List Any)] : (List Any)
  (var out : (List Any) [])
  (for old in previous
    (var replacement : Any old)
    (for item in incoming
      (if_yes (== old/id item/id) (set replacement item)))
    (out .push replacement))
  (for item in incoming
    (var found false)
    (for old in previous
      (if_yes (== old/id item/id) (set found true)))
    (if_not found (out .push item)))
  out)

# A saved first prompt leads paged history until its real request is visible.
# Do not infer it from a renameable title or suppress an identical later prompt.
(fn first_prompt_block [session : Any, records : (List Any), preview : (List Any)] : Any
  (var text : Str (status_text session/first_request))
  (var round_id : Str (status_text session/first_request_round))
  (if_yes (== text "") (return nil))
  (for blocks in [records preview]
    (for block in blocks
      (var role : Str (status_text block/role))
      (var phase : Str (status_text block/phase))
      (var run : Str (status_text block/round_id))
      (if_yes (&& (== role "user") (== phase "turn/request")
        (!= round_id "") (== run round_id))
        (return nil))))
  (var media : (List Any) [])
  (if_not ($absent? session/first_request_media) (set media session/first_request_media))
  {^id "first-request" ^round_id round_id ^turn 0 ^role "user"
   ^phase "turn/request" ^text text ^media media
   ^^durable})

# Display a submitted prompt before request preparation or a snapshot finishes.
# These display-only blocks never become records or paging cursors. A receipt
# binds the pending request to its round; the real user record then replaces it.
(fn submission_blocks [session : Str, pending : Any, rounds : (List Any), blocks : (List Any),
  ^shown_round shown_round : Str = ""] : (List Any)
  (var submitting (&& (! ($absent? pending)) (== (status_text pending/session) session)))
  (var receipt : Any nil)
  (var sequence : Int 0)
  (for run in rounds
    (var request_id : Str (status_text run/request_id))
    (var next : Int run/submission_seq)
    (if (if submitting (== request_id (status_text pending/request_id)) (> next sequence))
      (set receipt run)
      (set sequence next)))
  (if_yes (&& (! submitting) ($absent? receipt)) (return blocks))
  (var round_id : Str (status_text receipt/id))
  (if_yes (&& (!= round_id "") (== round_id shown_round)) (return blocks))
  (if_yes (!= round_id "")
    (for block in blocks
      (if_yes (&& (== (status_text block/role) "user")
        (== (status_text block/phase) "turn/request")
        (== (status_text block/round_id) round_id))
        (return blocks))))
  (var text : Str (if ($absent? receipt) (status_text pending/text) (status_text receipt/prompt)))
  (var media : (List Any) [])
  (if_not ($absent? receipt/media) (set media receipt/media))
  (if_yes (&& (== (str/trim text) "") (> media/.size 0))
    (var first : Any media/0)
    (set text $"Attachment: ${(status_text first/name)}"))
  (if_yes (&& (== (str/trim text) "") submitting)
    (var ids : (List Any) [])
    (if_not ($absent? pending/media) (set ids pending/media))
    (if_yes (> ids/.size 0) (set text "Attachments")))
  (if_yes (== (str/trim text) "") (return blocks))
  (var request_id : Str (if submitting (status_text pending/request_id) (status_text receipt/request_id)))
  (var prompt : Any {^id $"submission/${request_id}"
    ^round_id (if (== round_id "") $"submission/${request_id}" round_id)
    ^turn 0 ^role "user" ^phase "turn/request" ^text text ^media media
    ^durable (! ($absent? receipt))})
  (var out : (List Any) [])
  (var inserted false)
  (for block in blocks
    (if_yes (&& (! inserted) (!= round_id "") (== (status_text block/round_id) round_id))
      (out .push prompt)
      (set inserted true))
    (out .push block))
  (if_not inserted (out .push prompt))
  out)

(fn query_value [source : Str, name : Str] : Str
  (var normalized : Str (str/join (str/split source "?") ""))
  (set normalized (str/join (str/split normalized "#") ""))
  (for part in (str/split normalized "&")
    (var pair : (List Str) (str/split part "="))
    (if_yes (&& (== ($size pair) 2) (== pair/0 name)) (return ($url/decode_component pair/1))))
  "")

(fn draft_key [session : Str] : Str
  $"gene-harness/draft/${session}")

(fn bounded_blocks [blocks : (List Any), latest : Bool] : (List Any)
  (var out : (List Any) [])
  (var count ($size blocks))
  (var start (if (&& latest (> count 600)) (- count 600) 0))
  (var i 0)
  (for block in blocks
    (if_yes (&& (>= i start) (< ($size out) 600)) (out .push block))
    (set i (+ i 1)))
  out)

(fn step_key [block : Any] : Str
  (var run : Str block/round_id)
  (var round : Int block/turn)
  $"${run}/turn-${round}")

(fn step_block [block : Any] : Bool
  (var media : (List Any) [])
  (if_not ($absent? block/media) (set media block/media))
  (if_yes (> ($size media) 0) (return false))
  (var round : Int block/turn)
  (var phase : Str block/phase)
  (var final : Bool false)
  (if_not ($absent? block/final) (set final block/final))
  (if_yes (&& (== phase "reply") final) (return false))
  (&&
    (> round 0)
    (||
      (== phase "code")
      (== phase "turn/request")
      (== phase "turn/patch")
      (== phase "turn/error")
      (== phase "reply"))))

(fn revision_before [left : Str, right : Str] : Bool
  (if_yes (== left "") (return (!= right "")))
  (if_yes (== right "") (return false))
  (var a : (List Str) ($str/split left ":"))
  (var b : (List Str) ($str/split right ":"))
  (var ac : Int ($json/parse a/0))
  (var bc : Int ($json/parse b/0))
  (var ad : Int ($json/parse a/1))
  (var bd : Int ($json/parse b/1))
  (|| (< ac bc) (&& (== ac bc) (< ad bd))))

(fn marker_block [block : Any] : Bool
  false)

# Status embeds session-dependent ordinary components. Workspace revisions
# reject stale caches; render-start sequences reject late reads of one session.
(fn status_text [value : Any, fallback : Str = ""] : Str
  (if_yes ($absent? value) (return fallback))
  (var text : Str value)
  text)

(fn status_is_current [data : Any, previous : Any, session : Str, epoch : Str,
  wanted_epoch : Str, wanted_revision : Str] : Bool
  (var incoming_session (status_text data/status_session))
  (var incoming_epoch (status_text data/epoch))
  (var incoming_revision (status_text data/status_revision))
  (if_yes (!= incoming_session session) (return false))
  (if_yes (&& (!= epoch "") (!= incoming_epoch epoch)) (return false))
  (if_yes (&& (== incoming_epoch wanted_epoch)
    (revision_before incoming_revision wanted_revision)) (return false))
  (var previous_epoch (status_text previous/epoch))
  (var previous_session (status_text previous/status_session))
  (if_yes (&& (== incoming_epoch previous_epoch) (== session previous_session))
    (var incoming_text (status_text data/status_sequence "0"))
    (var previous_text (status_text previous/status_sequence "0"))
    (var incoming : Int ($json/parse incoming_text))
    (var before : Int ($json/parse previous_text))
    (if_yes (< incoming before) (return false)))
  true)

(fn run_label [run : Any] : Str
  (var status : Str run/state)
  (var value : Any (?? run/outcome ""))
  (var outcome : Str value)
  (if (== status "waiting") (return "Waiting for your answer"))
  (if (== outcome "code_error")
    "Code error"
    (if (== status "done")
      "Completed"
      (if (== status "cancelled")
        "Stopped"
        (if (== status "failed")
          "Failed"
          (if (== status "interrupted")
            "Interrupted"
            (if (== status "running")
              "Generating response…"
              (if (== status "accepted")
                "Starting…"
                (if (== status "stopping")
                  "Stopping…"
                  "Recovery required")))))))))
