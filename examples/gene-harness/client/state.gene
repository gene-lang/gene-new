(mod harness_client_state ^profile web)

(import [terminal_run : terminal] ^from "../src/web/contract.gene" ^export true)

(fn merge_blocks [previous : (List Any), incoming : (List Any)] : (List Any)
  (var out : (List Any) [])
  (for old in previous
    (var replacement : Any old)
    (for item in incoming
      (if_yes (== old/id item/id) (set replacement item)))
    (out .push replacement))
  (for item in incoming
    (var found false)
    (for old in previous
      (if_yes (== old/id item/id) (set found true)))
    (if_not found (out .push item)))
  out)

(fn query_value [source : Str, name : Str] : Str
  (var normalized : Str (str/join (str/split source "?") ""))
  (set normalized (str/join (str/split normalized "#") ""))
  (for part in (str/split normalized "&")
    (var pair : (List Str) (str/split part "="))
    (if_yes (&& (== ($size pair) 2) (== pair/0 name))
      (return ($url/decode_component pair/1))))
  "")

(fn draft_key [session : Str] : Str
  $"gene-harness/draft/${session}")

(fn bounded_blocks [blocks : (List Any), latest : Bool] : (List Any)
  (var out : (List Any) [])
  (var count ($size blocks))
  (var start (if (&& latest (> count 600)) (- count 600) 0))
  (var i 0)
  (for block in blocks
    (if_yes (&& (>= i start) (< ($size out) 600)) (out .push block))
    (set i (+ i 1)))
  out)

(fn step_key [block : Any] : Str
  (var run : Str block/run_id)
  (var round : Int block/round)
  $"${run}/step-${round}")

(fn step_block [block : Any] : Bool
  (var round : Int block/round)
  (var phase : Str block/phase)
  (&& (> round 0)
      (|| (== phase "raw_response") (== phase "code")
          (== phase "result") (== phase "narration"))))

(fn marker_block [block : Any] : Bool
  (var phase : Str block/phase)
  (var text : Str block/text)
  (|| (== phase "round_marker") (== phase "result_marker")
      # Recognize old display markers without hiding user text or final answers.
      (&& (== phase "narration")
          (|| (== text "-- Result  --")
              (&& (str/starts_with? text "== Round ") (str/ends_with? text " =="))))))

(fn run_label [run : Any] : Str
  (var status : Str run/status)
  (var value : Any (?? run/outcome ""))
  (var outcome : Str value)
  (if (== outcome "code_error") "Code error"
    (if (== status "completed") "Completed"
      (if (== status "cancelled") "Stopped"
        (if (== status "failed") "Failed"
          (if (== status "interrupted") "Interrupted"
            (if (== status "running") "Generating response…"
              (if (== status "accepted") "Starting…"
                (if (== status "stopping") "Stopping…" "Recovery required")))))))))
