# The optional board panel owns its view state and drafts independently of chat.
(mod harness_experimental_ui ^profile web)

(type UiNode ^props {^key Str ^tag Str ^element EventTarget ^props PropMap ^form Str ^seen Int})
(type UiClient ^props {^root EventTarget ^target EventTarget ^safe Bool ^ready Bool
  ^session Str ^workspace Str ^epoch Str ^metadata_revision Str ^rendered_revision Str ^descriptor Any ^settings Any ^instance Str ^version Str
  ^state PropMap ^drafts PropMap ^forms PropMap ^nodes PropMap ^generation Int
  ^sequence Int ^debounce Int ^last_data Str ^loading Bool ^render_error Bool ^pending Any ^resolving Bool
  ^api (Fn [Str Str Any (Fn [Int Any] Void)] Void) ^select (Fn [Str] Void)
  ^command (Fn [Str] Void) ^prompt (Fn [Str] Void)})

(fn text [value : Any, fallback : Str = ""] : Str
  (if_yes ($absent? value) (return fallback))
  (var result : Str value) result)

(fn flag [value : Any] : Bool
  (if_yes ($absent? value) (return false))
  (var result : Bool value) result)

(fn copy_map [value : Any] : PropMap
  (if_yes ($absent? value) (return {}))
  (var result : PropMap ($json/parse ($json/stringify value))) result)

(fn body_args [value : Any] : (List Any)
  (var empty : (List Any) [])
  (var raw : Any (?? value empty))
  (var result : (List Any) raw) result)

(fn notice [ui : UiClient, value : Str] : Void
  ($dom/set_text ($dom/element "ui_action_status") value))

(fn state_key [ui : UiClient] : Str
  $"gene-harness/ui-state/${ui/workspace}/${(text ui/descriptor/name)}/${ui/version}")
(fn pending_key [ui : UiClient] : Str $"gene-harness/ui-pending/${ui/workspace}")

(fn persist_view [ui : UiClient] : Void
  (if_yes (!= ui/workspace "")
    (if_not ($session_storage/set (state_key ui)
      ($json/stringify {^state ui/state ^drafts ui/drafts ^forms ui/forms}))
      (notice ui "Panel drafts could not be saved in browser storage. Keep this page open."))))

(fn persist_pending [ui : UiClient] : Bool
  ($session_storage/set (pending_key ui) ($json/stringify ui/pending)))

(fn field_value [node : UiNode] : Any
  (if_yes (== (text node/props/type) "checkbox")
    (var checked : Bool node/element/checked)
    (return checked))
  ($dom/input_value node/element))

(fn sync_controls [ui : UiClient] : Void
  (var current (!= (text ui/descriptor/revision) ""))
  (var enabled (&& ui/ready current (! ui/loading) (! ui/render_error)
    (== ui/rendered_revision (text ui/descriptor/revision)) ($absent? ui/pending)))
  (for [key raw] in ui/nodes
    (var node : UiNode raw)
    (if_yes (== node/tag "button")
      (set node/element/disabled (|| (! enabled) (! ($absent? node/props/disabled))))))
  (var resolve_button ($dom/element "ui_resolve"))
  (var cancel_button ($dom/element "ui_cancel"))
  (set resolve_button/hidden ($absent? ui/pending))
  (set cancel_button/hidden
    (|| ($absent? ui/pending) (== (text ui/pending/command_id) ""))))

(fn clear_saved_drafts [ui : UiClient, pending : Any] : Void
  (var form (text pending/form))
  (var still_dirty false)
  (for [key raw] in ui/drafts
    (var item : Any raw)
    (if_yes (== (text item/form) form)
      (var name : Str item/name)
      (if (== ($json/stringify item/value) ($json/stringify pending/request/named/%name))
        (set ui/drafts/%key void)
        (set still_dirty true))))
  (if_not still_dirty (set ui/forms/%form void))
  (persist_view ui))

(fn accept_receipt [ui : UiClient, session : Str, record : Any] : Void
  (if_yes ($absent? ui/pending) (return))
  (var pending : Any ui/pending)
  (if_yes (!= session (text pending/session)) (return))
  (if_yes (!= (text record/ui_action_id) (text pending/request/input_id)) (return))
  (set pending/command_id (text record/id))
  (persist_pending ui)
  (var status (text record/status))
  (if (== status "running")
    (notice ui "Saving…")
    (do
      (if (== status "done")
        (do (clear_saved_drafts ui pending) (notice ui "Saved."))
        (notice ui (text record/display status)))
      ($session_storage/remove (pending_key ui))
      (set ui/pending nil)
      (set ui/last_data "")
      (refresh ui)))
  (sync_controls ui))

(fn post_action [ui : UiClient] : Void
  (if_yes (|| ($absent? ui/pending) (! ui/ready)) (return))
  (var pending : Any ui/pending)
  (var session : Str pending/session)
  (if_not (persist_pending ui)
    (notice ui "Browser storage is required before saving an action.")
    (return))
  (notice ui "Saving…")
  (sync_controls ui)
  (ui/api "POST" $"/api/v6/sessions/${session}/ui/actions" pending/request
    (fn [code : Int, data : Any] : Void
      (if_yes (|| ($absent? ui/pending)
        (!= (text ui/pending/request/input_id) (text pending/request/input_id))) (return))
      (if (== code 202)
        (accept_receipt ui session data)
        (if (&& (>= code 400) (< code 500))
          (do
            ($session_storage/remove (pending_key ui))
            (set ui/pending nil)
            (notice ui (text data/message "Action refused. Refresh the view."))
            (set ui/last_data "")
            (refresh ui))
          (notice ui "Save outcome is unknown. Resolve the action before trying again.")))
      (sync_controls ui))))

(fn resolve_action [ui : UiClient, retry : Bool] : Void
  (if_yes (|| ($absent? ui/pending) ui/resolving (! ui/ready)) (return))
  (var pending : Any ui/pending)
  (var session : Str pending/session)
  (var id : Str pending/request/input_id)
  (set ui/resolving true)
  (ui/api "GET" $"/api/v6/sessions/${session}/ui/actions/${id}" nil
    (fn [code : Int, data : Any] : Void
      (set ui/resolving false)
      (if_yes (|| ($absent? ui/pending) (!= id (text ui/pending/request/input_id))) (return))
      (if (== code 200)
        (accept_receipt ui session data)
        (if (&& (== code 404) retry)
          (post_action ui)
          (notice ui "No receipt was recovered. Resolve action retries the original identity."))))))

(fn submit_action [ui : UiClient, node : UiNode] : Void
  (if_yes (|| (! ui/ready) ui/loading ui/render_error
    (!= ui/rendered_revision (text ui/descriptor/revision)) (! ($absent? ui/pending))) (return))
  (var name (text node/props/action))
  (var form (if (== node/tag "form") node/key node/form))
  (var named (copy_map node/props/args))
  (var args (body_args node/props/positional))
  (if_not ($absent? ui/forms/%form)
    (var saved : Any ui/forms/%form)
    (if ($absent? saved/named)
      (set named (copy_map saved))
      (do (set named (copy_map saved/named)) (set args (body_args saved/positional)))))
  (for [key raw] in ui/nodes
    (var input : UiNode raw)
    (if_yes (&& (== input/form form) (! ($absent? input/props/field)))
      (var field : Str input/props/field)
      (set named/%field (field_value input))))
  (var request {^component ui/descriptor/name ^revision ui/descriptor/revision
    ^function name ^function_revision ui/descriptor/functions/%name ^instance ui/instance
    ^input_id ($browser/request_id) ^args args ^named named})
  (set ui/pending {^session ui/session ^request request ^form form ^command_id ""})
  (if (== ui/session "")
    (ui/api "POST" "/api/v6/sessions" {^title "Project board"}
      (fn [code : Int, data : Any] : Void
        (if (== code 201)
          (do
            (var id : Str data/id)
            (set ui/pending/session id)
            (if_yes (== ui/session "") (ui/select id))
            (post_action ui))
          (do (set ui/pending nil) (notice ui (text data/message "Could not create a session."))))))
    (post_action ui)))

(fn changed_control [ui : UiClient, node : UiNode] : Void
  (if_not ($absent? node/props/field)
    (var form node/form)
    (if_yes ($absent? ui/forms/%form)
      (var owner : UiNode ui/nodes/%form)
      (set ui/forms/%form {^named (copy_map owner/props/args) ^positional (body_args owner/props/positional)}))
    (var key node/key)
    (set ui/drafts/%key {^name node/props/field ^form form ^value (field_value node)})
    (persist_view ui))
  (if_not ($absent? node/props/state)
    (var name : Str node/props/state)
    (set ui/state/%name (if (== node/tag "button") node/props/value (field_value node)))
    (set ui/sequence (+ ui/sequence 1))
    (persist_view ui)
    (set ui/debounce (+ ui/debounce 1))
    (var wanted ui/debounce)
    ($time/after (if (== node/tag "button") 0.0 150.0)
      (fn [] : Void
        (if_yes (== wanted ui/debounce)
          (set ui/last_data "")
          (refresh ui))))))

(fn metadata [name : Str] : Bool
  (for key in ["key" "field" "state" "action" "args" "positional" "command" "prompt"]
    (if_yes (== key name) (return true)))
  false)

(fn input_tag [tag : Str] : Bool
  (|| (== tag "input") (== tag "textarea") (== tag "select")))

(fn patch_node [ui : UiClient, tree : Any, parent : EventTarget, at : Int, path : Str, form : Str] : Void
  (var tag (text tree/tag "#text"))
  (var props (if (== tag "#text") {} (copy_map tree/props)))
  (var key (text props/key path))
  (var found : Any ui/nodes/%key)
  (if_yes (! ($absent? found))
    (var previous : UiNode found)
    (if_yes (!= previous/tag tag)
      ($dom/remove previous/element)
      (set found nil)))
  (var node : UiNode
    (if ($absent? found)
      (UiNode ^key key ^tag tag ^element (if (== tag "#text") ($dom/create_text "") ($dom/create_element tag))
        ^props {} ^form form ^seen ui/generation)
      found))
  (var created ($absent? found))
  (set ui/nodes/%key node)
  (set node/seen ui/generation)
  (set node/form form)
  (if (== tag "#text")
    ($dom/set_text node/element (text tree))
    (do
      (for [old_name value] in node/props
        (var name ($to_str old_name))
        (if_yes (&& (! (metadata name)) ($absent? props/%name))
          ($dom/remove_attribute node/element name)))
      (set node/props props)
      ($dom/set_attribute node/element "data-ui-key" key)
      (for [raw_name value] in props
        (var name ($to_str raw_name))
        (if_not (metadata name)
          (var attribute : Str value)
          ($dom/set_attribute node/element name attribute)))
      (if_yes created
        (if_yes (input_tag tag)
          ($dom/add_event_listener node/element "input" (fn [event : Any] : Void (changed_control ui node))))
        (if_yes (== tag "button")
          ($dom/add_event_listener node/element "click" (fn [event : Any] : Void
            (if_yes (|| (! ui/ready) ui/loading) (return))
            (if_not ($absent? node/props/state)
              ($dom/prevent_default event)
              (changed_control ui node))
            (if_not ($absent? node/props/action)
              ($dom/prevent_default event)
              (submit_action ui node))
            (if_not ($absent? node/props/command) (ui/command (text node/props/command)))
            (if_not ($absent? node/props/prompt) (ui/prompt (text node/props/prompt))))))
        (if_yes (== tag "form")
          ($dom/add_event_listener node/element "submit" (fn [event : Any] : Void
            ($dom/prevent_default event) (submit_action ui node)))))
      (var children : (List Any) tree/children)
      (var index 0)
      (for child in children
        (patch_node ui child node/element index $"${path}/${index}" (if (== tag "form") key form))
        (set index (+ index 1)))
      (if_yes (input_tag tag)
        (var draft : Any ui/drafts/%key)
        (if (== (text props/type) "checkbox")
          (set node/element/checked (if ($absent? draft) (! ($absent? props/checked)) (flag draft/value)))
          (do
            (var value (if ($absent? draft) (text props/value) (text draft/value)))
            (if_yes (!= value ($dom/input_value node/element)) ($dom/set_input_value node/element value)))))))
  ($dom/insert_at parent node/element at))

(fn apply_tree [ui : UiClient, tree : Any] : Void
  (set ui/generation (+ ui/generation 1))
  (patch_node ui tree ui/target 0 "@root" "")
  (for [key raw] in ui/nodes
    (var node : UiNode raw)
    (if_yes (!= node/seen ui/generation)
      ($dom/remove node/element)
      (set ui/nodes/%key void)))
  (sync_controls ui))

(fn refresh [ui : UiClient] : Void
  (if_yes (|| ui/safe (! ui/ready) ($absent? ui/descriptor)) (return))
  (var revision : Str ui/descriptor/revision)
  (var data_revision : Str ui/descriptor/data_revision)
  (if_yes (== ui/last_data data_revision) (return))
  (set ui/sequence (+ ui/sequence 1))
  (var sequence ($to_str ui/sequence))
  (var instance ui/instance)
  (set ui/loading true)
  (set ui/last_data data_revision)
  (sync_controls ui)
  (ui/api "POST" "/api/v6/ui/render"
    {^session ui/session ^component ui/descriptor/name ^revision revision ^instance instance
     ^sequence sequence ^state ui/state}
    (fn [code : Int, data : Any] : Void
      (if_yes (|| (!= instance ui/instance) (!= sequence ($to_str ui/sequence))
        (!= revision (text ui/descriptor/revision))
        (!= data_revision (text ui/descriptor/data_revision))) (return))
      (set ui/loading false)
      (if (&& (== code 200) ($absent? data/error))
        (try
          (apply_tree ui data/view)
          (set ui/rendered_revision revision)
          (if_yes ui/render_error (notice ui ""))
          (set ui/render_error false)
          catch Any
            (set ui/render_error true)
            (notice ui "The view could not be displayed. Restore the default UI to recover."))
        (do (set ui/render_error true)
          (notice ui (text data/error (text data/message "View rendering failed.")))))
      (sync_controls ui))))

(fn restore_view [ui : UiClient, descriptor : Any] : Void
  (if_yes (&& (!= ui/version "") (!= ui/version (text descriptor/state_version "1")))
    (notice ui "Panel state reset for the new view version."))
  (set ui/descriptor descriptor)
  (set ui/rendered_revision "")
  (set ui/instance ($browser/request_id))
  (set ui/version (text descriptor/state_version "1"))
  (set ui/state (copy_map descriptor/view_state))
  (set ui/nodes {}) (set ui/drafts {}) (set ui/forms {})
  (set ui/last_data "")
  ($dom/clear ui/target)
  (var saved (?? ($session_storage/get (state_key ui)) ""))
  (if_yes (!= saved "")
    (try
      (var value : Any ($json/parse saved))
      (set ui/state (copy_map value/state))
      (set ui/drafts (copy_map value/drafts))
      (set ui/forms (copy_map value/forms))
    catch Any (notice ui "The saved panel state could not be restored."))))

(fn update [ui : UiClient, data : Any] : Void
  (if_yes ui/safe (return))
  (if_yes ($absent? data) (return))
  (var epoch (text data/epoch))
  (var incoming (text data/data_revision))
  (if_yes (&& (== epoch ui/epoch) (!= ui/metadata_revision "") (!= incoming ""))
    (var before : (List Str) ($str/split ui/metadata_revision ":"))
    (var after : (List Str) ($str/split incoming ":"))
    (var old_composition : Int ($json/parse before/0))
    (var new_composition : Int ($json/parse after/0))
    (var old_data : Int ($json/parse before/1))
    (var new_data : Int ($json/parse after/1))
    (if_yes (|| (< new_composition old_composition)
                (&& (== new_composition old_composition) (< new_data old_data))) (return)))
  (if_yes (!= epoch ui/epoch) (set ui/last_data ""))
  (set ui/epoch epoch)
  (set ui/metadata_revision incoming)
  (var workspace (text data/workspace ui/workspace))
  (if_yes (!= workspace ui/workspace)
    (set ui/workspace workspace)
    (var saved (?? ($session_storage/get (pending_key ui)) ""))
    (if_yes (!= saved "") (set ui/pending (try ($json/parse saved) catch Any nil))))
  (set ui/settings data/settings)
  (var selected : Any nil)
  (var empty : (List Any) [])
  (var raw_components : Any (?? data/components empty))
  (var components : (List Any) raw_components)
  (for component in components
    (if_yes (|| (== (text component/name) (text data/settings/panel))
                (&& ($absent? selected) (== (text data/settings/panel) "")))
      (set selected component)))
  (var active (&& (flag data/settings/enabled) (! ($absent? selected))))
  (var layout_controls ($dom/element "ui_layout_controls"))
  (set layout_controls/hidden (! active))
  (var visible (&& active (== (text data/settings/layout) "panel")))
  (var panel ($dom/element "ui_panel"))
  (set panel/hidden (! visible))
  ($dom/set_class ui/root "has_ui_panel" visible)
  ($dom/set_class ui/root "ui_right" (== (text data/settings/side) "right"))
  ($dom/set_text ($dom/element "ui_toggle") (if visible "Hide board" "Show board"))
  (for key in ["ink" "muted" "line" "surface" "sidebar" "soft" "accent"]
    ($dom/set_style ui/root $"--${key}" (if active (text data/settings/theme/%key) "")))
  (var raw_width : Any (?? data/settings/width 50))
  (var width : Int raw_width)
  (var first (if (== (text data/settings/side) "right") (- 100 width) width))
  ($dom/set_style ui/root "--ui-first" $"${first}fr")
  ($dom/set_style ui/root "--ui-second" $"${(- 100 first)}fr")
  (if ($absent? selected)
    (do (set ui/descriptor nil) (set ui/loading false) (set ui/nodes {}) ($dom/clear ui/target))
    (do
      (if (|| (!= (text ui/descriptor/name) (text selected/name))
              (!= ui/version (text selected/state_version "1")))
        (restore_view ui selected)
        (set ui/descriptor selected))
      (refresh ui)))
  (sync_controls ui))

(fn controls [ui : UiClient, ready : Bool, session : Str] : Void
  (var reconnect (&& ready (! ui/ready)))
  (set ui/ready ready) (set ui/session session)
  ($dom/set_attribute ($dom/element "ui_default_link") "href"
    $"/ui/default?session=${($url/encode_component session)}")
  (if_yes reconnect
    (set ui/last_data "")
    (resolve_action ui false))
  (refresh ui)
  (sync_controls ui))

(fn event [ui : UiClient, kind : Str, data : Any] : Void
  (if_yes ui/safe (return))
  (if_yes (== kind "ui/state") (update ui data))
  (if_yes (== kind "ui/action") (accept_receipt ui (text data/session) data/record)))

(fn create [root : EventTarget, safe : Bool,
  api : (Fn [Str Str Any (Fn [Int Any] Void)] Void), select : (Fn [Str] Void),
  command : (Fn [Str] Void), prompt : (Fn [Str] Void)] : UiClient
  (var ui (UiClient ^root root ^target ($dom/element "ui_view") ^safe safe ^!ready
    ^session "" ^workspace "" ^epoch "" ^metadata_revision "" ^rendered_revision "" ^descriptor nil ^settings nil ^instance "" ^version ""
    ^state {} ^drafts {} ^forms {} ^nodes {} ^generation 0 ^sequence 0 ^debounce 0
    ^last_data "" ^!loading ^!render_error ^pending nil ^!resolving ^api api ^select select ^command command ^prompt prompt))
  ($dom/add_event_listener ($dom/element "ui_toggle") "click" (fn [event : Any] : Void
    (if_yes (|| ui/safe ($absent? ui/descriptor)) (return))
    (var settings (copy_map ui/settings))
    (set settings/layout (if (== (text settings/layout) "panel") "chat" "panel"))
    (set settings/panel ui/descriptor/name)
    (ui/api "POST" "/api/v6/ui/settings" settings
      (fn [code : Int, data : Any] : Void
        (if (== code 200) (update ui data) (notice ui (text data/message "Layout change failed.")))))))
  ($dom/add_event_listener ($dom/element "ui_resolve") "click" (fn [event : Any] : Void (resolve_action ui true)))
  ($dom/add_event_listener ($dom/element "ui_discard") "click" (fn [event : Any] : Void
    (set ui/drafts {}) (set ui/forms {})
    (persist_view ui)
    (set ui/last_data "")
    (refresh ui)
    (notice ui "Draft edits discarded.")))
  ($dom/add_event_listener ($dom/element "ui_cancel") "click" (fn [event : Any] : Void
    (if_yes ($absent? ui/pending) (return))
    (var session : Str ui/pending/session)
    (var id (text ui/pending/command_id))
    (if_yes (!= id "")
      (ui/api "POST" $"/api/v6/sessions/${session}/commands/${id}/cancel" {}
        (fn [code : Int, data : Any] : Void (notice ui "Cancellation requested."))))))
  ui)
