# Typed callbacks from page coordination into first-party feature modules.
# Features own no socket, sequence counter, authentication epoch or retry loop.
(mod feature_host ^profile web)
(type FeatureHost ^props {
  ^api (Fn [Str Str Any (Fn [Int Any] Nil)] Nil)
  ^error (Fn [Any Str] Nil) ^feedback (Fn [Str Str Bool] Nil) ^controls (Fn [] Nil)
  ^select (Fn [Str] Nil) ^refresh (Fn [] Nil) ^tab (Fn [Str] Any)
  ^upsert (Fn [Any] Nil) ^remember (Fn [] Nil) ^apply_run (Fn [Str Any] Nil)
  ^emit (Fn [Str Str Any] Nil) ^render (Fn [] Nil)})
