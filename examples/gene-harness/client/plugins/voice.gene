(mod harness_voice ^profile web)
(import [text flag integer items] ^from "../../src/common/launcher.gene")
(import [VoiceDrafts new_voice_drafts start_utterance release_utterance finish_utterance
  dispose_drafts voice_draft_key find_utterance partial_utterance recognition_timeout_ms] ^from "../../src/common/voice_transitions.gene")
(import [HostAudio open_host_audio close_host_audio start_host_capture finish_host_capture
  cancel_input cancel_output cancel_host_utterance speak_host_reply speak_host_announcement prefetch_host_reply start_handsfree stop_handsfree] ^from "./host_audio.gene")

(type Voice ^props {^root EventTarget ^bridge Any ^button EventTarget ^panel EventTarget
  ^mic EventTarget ^message EventTarget ^transcript EventTarget ^send_button EventTarget ^discard_button EventTarget
  ^drafts VoiceDrafts ^context Any ^capture Any ^unsubscribe Any ^host Any ^pending PropMap ^meter EventTarget
  ^pointer_up Any ^key_down Any ^key_up Any ^page_hide Any
  ^enabled Bool ^disposed Bool ^claiming Bool ^recording Bool ^finalizing Bool ^submitting Bool ^held Bool
  ^output Bool ^autosend Bool ^progress Bool ^mode Str ^voice Str ^language Str ^recognizer Str ^synthesizer Str
  ^release_at F64 ^speech_began F64 ^speaking_record Str
  ^duplex Str ^manual_capture Bool ^mode_select EventTarget ^voice_select EventTarget
  ^session Str ^title Str ^workspace Str ^client_id Str ^token Str ^claim_revision Str ^capture_id Str ^capture_started F64
  ^generation Int ^speech_generation Int ^speaking Bool ^queue (List Any) ^seen PropMap ^final_rounds PropMap
  ^round_state Str ^partial Str ^feedback Str})

(fn state [voice : Voice] : Any
  (var read : (Fn [] Any) voice/bridge/state)
  (read))

(fn host_audio [voice : Voice] : HostAudio
  (var host : HostAudio voice/host)
  host)

(fn host_ready? [voice : Voice] : Bool
  (if_yes ($absent? voice/host) (return false))
  (var host (host_audio voice))
  (&& host/ready (! host/closed)))

(fn save_settings [voice : Voice] : Void
  ($session_storage/set ($to_str "gene-harness/voice-settings/" voice/workspace)
    ($json/stringify {^output voice/output ^autosend voice/autosend ^progress voice/progress
      ^mode voice/mode ^voice voice/voice ^language voice/language
      ^recognizer voice/recognizer ^synthesizer voice/synthesizer ^duplex voice/duplex})))

(fn load_settings [voice : Voice] : Void
  (var saved (?? ($session_storage/get ($to_str "gene-harness/voice-settings/" voice/workspace)) ""))
  (if_yes (== saved "") (return))
  (try
    (var value : Any ($json/parse saved))
    (set voice/output (flag (?? value/output true))) (set voice/autosend (flag (?? value/autosend true)))
    (set voice/progress (flag (?? value/progress true)))
    (set voice/mode (if (== (text value/mode) "toggle") "toggle"
      (if (== (text value/mode) "handsfree") "handsfree" "hold")))
    (set voice/recognizer (if (== (text value/recognizer) "host") "host" "browser"))
    (set voice/synthesizer (if (== (text value/synthesizer) "host") "host" "browser"))
    (if_yes (&& (== voice/mode "handsfree") (!= voice/recognizer "host")) (set voice/mode "hold"))
    (set voice/duplex (if (== (text value/duplex) "headphones") "headphones" "half"))
    (set voice/voice (text value/voice)) (set voice/language (text value/language "en-US"))
  catch Any (set voice/feedback "Saved voice settings could not be read. Browser defaults are available.")))

(fn populate_voices [voice : Voice] : Void
  (if_yes voice/disposed (return))
  ($dom/clear voice/voice_select)
  ($dom/append voice/voice_select ($dom/render `(option ^value "" "System default")))
  (var found (== voice/voice ""))
  (for item in ($speech/voices)
    (var uri (text item/uri))
    (if_yes (== uri voice/voice) (set found true))
    ($dom/append voice/voice_select ($dom/render `(option ^value %uri
      %($to_str (text item/name) " · " (text item/language))))))
  (if_yes (! found)
    ($dom/append voice/voice_select ($dom/render `(option ^value %voice/voice "Saved voice · not currently available"))))
  ($dom/set_input_value voice/voice_select voice/voice))

(fn api [voice : Voice, method : Str, path : Str, value : Any, done : (Fn [Int Any] Void)] : Void
  (var request : (Fn [Str Str Any (Fn [Int Any] Void)] Void) voice/bridge/api)
  (request method path value done))

(fn draft [voice : Voice] : Any
  (var session voice/session)
  voice/drafts/drafts/%session)

(fn store_draft [voice : Voice] : Bool
  (if_yes (== voice/session "") (return false))
  (var key (voice_draft_key voice/workspace voice/session))
  (var value : Any (draft voice))
  (if_yes (== (text value/text) "") ($session_storage/remove key) (return true))
  (if_yes (flag value/held) (set voice/held true))
  (if_yes (== (text value/recognizer) "") (set value/recognizer voice/recognizer))
  (set value/held voice/held)
  ($session_storage/set key ($json/stringify value)))

(fn load_draft [voice : Voice] : Void
  (var session voice/session)
  (var saved (?? ($session_storage/get (voice_draft_key voice/workspace session)) ""))
  (if (== saved "")
    (do (set voice/drafts/drafts/%session nil) (set voice/held false))
    (try
      (var value : Any ($json/parse saved))
      (var content (text value/text))
      (set voice/held (flag value/held))
      (if_yes voice/held
        (set voice/feedback "The saved voice draft needs review. Use Send queued voice when ready."))
      (set voice/drafts/drafts/%session {^text content ^audio_ms (integer value/audio_ms)
        ^recognizer (text value/recognizer voice/recognizer) ^held voice/held ^review_required (flag value/review_required)})
    catch Any
      (set voice/held true)
      (set voice/feedback "Saved voice draft is unreadable. Inspect it before discarding it."))))

(fn earcon [voice : Voice, frequency : F64] : Void
  (if_yes ($absent? voice/context) (return))
  (var context : EventTarget voice/context)
  (if_not ($absent? voice/host)
    (var host (host_audio voice))
    (if_yes (< host/suppress_until (+ ($time/now) 200.0)) (set host/suppress_until (+ ($time/now) 200.0))))
  (try ($audio/tone context frequency 0.07 0.04) catch Any nil))

(fn paint [voice : Voice] : Void
  (if_yes voice/disposed (return))
  ($dom/set_input_value voice/mode_select voice/mode)
  ($dom/set_text voice/button (if voice/enabled "Voice on" "Voice"))
  ($dom/set_attribute voice/button "aria-pressed" (if voice/enabled "true" "false"))
  (set voice/panel/hidden (&& (! voice/enabled) (! voice/claiming)))
  (set voice/mic/disabled (|| (! voice/enabled) voice/claiming
    (if (== voice/recognizer "host") (! (host_ready? voice)) (! ($speech/recognizer_available?)))))
  ($dom/set_text voice/mic
    (if voice/finalizing "Finishing…"
      (if voice/recording
        (if (== voice/mode "toggle") "Recording… click to finish"
          (if (&& (== voice/mode "handsfree") (! voice/manual_capture)) "Recording… silence sends" "Recording… release to finish"))
        (if (== voice/mode "hold") "Hold to talk · Space"
          (if (== voice/mode "handsfree") "Hands-free · hold or Space to interrupt" "Start / stop recording")))))
  (var value : Any (draft voice))
  (if (|| voice/recording voice/finalizing)
    ($dom/set_attribute voice/transcript "readonly" "")
    ($dom/remove_attribute voice/transcript "readonly"))
  ($dom/set_input_value voice/transcript
    (if (|| voice/recording voice/finalizing) voice/partial (text value/text)))
  (var pending_state : (Fn [] Bool) voice/bridge/capabilities/voice/pending)
  (var pending (pending_state))
  (set voice/send_button/disabled (|| voice/submitting pending (== (text value/text) "")))
  (set voice/discard_button/disabled (|| voice/submitting pending (== (text value/text) "")))
  (var feedback
    (if voice/claiming "Enabling voice…"
      (if pending "Voice submission outcome is unknown. Use Resolve voice submission in the host controls."
        (if voice/held voice/feedback
          (if (&& (!= (text value/text) "") (|| (== voice/round_state "running") (== voice/round_state "waiting")))
            "Voice draft queued for this conversation. You can edit or cancel it."
            voice/feedback)))))
  ($dom/set_text voice/message ($to_str (if (== voice/title "") "" ($to_str "Voicing " voice/title " · "))
    feedback (if voice/speaking " · Speaking replies." ""))))

(fn cancel_speech [voice : Voice] : Void
  (set voice/speech_generation (+ voice/speech_generation 1))
  (set voice/queue [])
  (set voice/speaking false)
  (if_not ($absent? voice/host)
    (var host (host_audio voice)) (cancel_output host) (set host/external_playback false))
  ($speech/cancel))

(fn prefetch_next [voice : Voice] : Void
  (if_yes (|| (! voice/speaking) (!= voice/synthesizer "host") (! (host_ready? voice))
              (== voice/queue/.size 0)) (return))
  (var next : Any voice/queue/0)
  (if_yes (&& (! voice/output) (! (flag next/replay))) (return))
  (if_yes (str/starts_with? (text next/id) ($to_str voice/session "/"))
    (prefetch_host_reply (host_audio voice) (text next/id))))

(fn pump [voice : Voice] : Void
  (if_yes (|| voice/disposed (! voice/enabled) voice/speaking voice/recording voice/finalizing
              (== voice/queue/.size 0)) (return))
  (if_yes (&& (== voice/synthesizer "host") (! (host_ready? voice))) (return))
  (var next : Any voice/queue/0)
  (var remaining : (List Any) [])
  (var index 0)
  (for item in voice/queue (if_yes (> index 0) (remaining .push item)) (set index (+ index 1)))
  (set voice/queue remaining)
  (if_yes (&& (! voice/output) (! (flag next/replay))) (pump voice) (return))
  (set voice/speaking true)
  (paint voice)
  (set voice/speech_began (if ($absent? next/received) ($time/now) next/received))
  (set voice/speaking_record (text next/id))
  (if_yes (== voice/synthesizer "host")
    (var accepted (if (== (text next/announcement) "")
      (speak_host_reply (host_audio voice) (text next/id))
      (speak_host_announcement (host_audio voice) (text next/announcement) (integer next/count))))
    (if_yes (! accepted)
      (set voice/speaking false) (set voice/feedback "The host speaker is still preparing. Replay the reply after it is ready.") (paint voice))
    (prefetch_next voice)
    (return))
  (var generation voice/speech_generation)
  (var began voice/speech_began)
  (if_not ($absent? voice/host)
    (var host (host_audio voice)) (set host/external_playback true))
  ($speech/speak (text next/speech) voice/voice (if (> voice/queue/.size 1) 1.15 1.0)
    (fn [] : Void
      (if_yes (|| voice/disposed (!= generation voice/speech_generation)) (return))
      (api voice "POST" $"/api/v8/sessions/${voice/session}/voice/latency"
        {^kind "output" ^identity (text next/id) ^elapsed_ms ($to_int (- ($time/now) began))} (fn [code : Int, data : Any] : Void nil)))
    (fn [error : Str] : Void
      (if_yes (|| voice/disposed (!= generation voice/speech_generation)) (return))
      (set voice/speaking false)
      (if_not ($absent? voice/host)
        (var host (host_audio voice)) (set host/external_playback false)
        (set host/suppress_until (+ ($time/now) 300.0)))
      (if_yes (!= error "") (set voice/feedback ($to_str "Speech unavailable: " error ". You can read the reply on screen.")))
      (paint voice) (pump voice))))

(fn enqueue [voice : Voice, id : Str, spoken : Str, replay : Bool = false,
             announcement : Str = "", count : Int = 0] : Void
  (if_yes (|| (== (str/trim spoken) "") voice/disposed (! voice/enabled)) (return))
  (if_yes (&& (! replay) (! ($absent? voice/seen/%id))) (return))
  (set voice/seen/%id true)
  (voice/queue .push {^id id ^speech spoken ^replay replay ^received ($time/now) ^announcement announcement ^count count})
  (prefetch_next voice)
  (pump voice))

(fn try_send [voice : Voice, explicit : Bool = false] : Void
  (if_yes (flag (/held (draft voice))) (set voice/held true))
  (if_yes (|| voice/disposed (! voice/enabled) voice/submitting voice/recording voice/finalizing
              (&& voice/held (! explicit))) (return))
  (var value : Any (draft voice))
  (var content (text value/text))
  (if_yes (== (str/trim content) "") (return))
  (if_yes (|| (== voice/round_state "running") (== voice/round_state "waiting"))
    (paint voice) (return))
  (if_yes (! (store_draft voice))
    (set voice/feedback "The voice draft could not be saved. Restore browser storage before sending.")
    (set voice/held true) (paint voice) (return))
  (var duration (integer value/audio_ms))
  (var input : Any {^kind "voice" ^recognizer (text value/recognizer voice/recognizer) ^audio_ms duration})
  (if_yes (&& (! voice/autosend) (! explicit))
    (var review : (Fn [Str Str Any] Bool) voice/bridge/capabilities/voice/review)
    (if (review voice/session content input)
      (do
        (var session voice/session)
        (set voice/drafts/drafts/%session nil) (store_draft voice)
        (set voice/feedback "Voice text is in the composer for review."))
      (set voice/feedback "The voice draft could not be offered. It remains queued."))
    (paint voice) (return))
  (set voice/submitting true)
  (set voice/held false)
  (var generation voice/generation)
  (var released voice/release_at)
  (var submit : (Fn [Str Str Any (Fn [Int Any] Void)] Void) voice/bridge/capabilities/voice/submit)
  (submit voice/session content input
    (fn [code : Int, data : Any] : Void
      (if_yes (|| voice/disposed (!= generation voice/generation)) (return))
      (set voice/submitting false)
      (if (== code 202)
        (do
          (if_yes (> released 0.0)
            (api voice "POST" $"/api/v8/sessions/${voice/session}/voice/latency"
              {^kind "input" ^identity (text data/id) ^input_kind "voice" ^elapsed_ms ($to_int (- ($time/now) released))}
              (fn [status : Int, value : Any] : Void nil)))
          (load_draft voice) (set voice/feedback "Voice prompt sent.") (earcon voice 880.0))
        (do
          (set voice/held true)
          (store_draft voice)
          (set voice/feedback (text data/message "Voice submission is unresolved. Your text is retained."))))
      (paint voice))))

(fn pending_count [voice : Voice] : Int
  (var count 0)
  (for [id value] in voice/pending (if_yes (! ($absent? value)) (set count (+ count 1))))
  count)

(fn drop_pending [voice : Voice, id : Str] : Void
  (var keep : PropMap {})
  (for [key value] in voice/pending
    (if_yes (&& (!= ($to_str key) id) (! ($absent? value)))
      (var name ($to_str key)) (set keep/%name value)))
  (set voice/pending keep)
  (if_not ($absent? voice/host)
    (var host (host_audio voice)) (set host/input_paused (>= (pending_count voice) 4))))

(fn await_host_final [voice : Voice, id : Str, duration : Int] : Void
  (release_utterance voice/drafts id duration)
  (set voice/pending/%id {^released ($time/now)})
  (var host (host_audio voice)) (set host/input_paused (>= (pending_count voice) 4))
  ($time/after ($to_float (recognition_timeout_ms duration)) (fn [] : Void
    (if_yes (|| voice/disposed ($absent? voice/pending/%id)) (return))
    (cancel_host_utterance (host_audio voice) id) (drop_pending voice id)
    (finish_utterance voice/drafts id "" "failed")
    (store_draft voice)
    (set voice/feedback "Recognition timed out. Any recognized text is kept for review.")
    (earcon voice 220.0) (paint voice) (try_send voice))))

(fn finish_capture [voice : Voice, cancel : Bool = false] : Void
  (if_yes (&& (! voice/recording) (! voice/finalizing)) (return))
  (var id voice/capture_id)
  (set voice/manual_capture false)
  (if_yes (== voice/recognizer "host")
    (set voice/recording false)
    (var host (host_audio voice))
    (if cancel
      (do (cancel_host_utterance host id) (finish_utterance voice/drafts id "" "cancelled"))
      (do
        (await_host_final voice id ($to_int (- ($time/now) voice/capture_started)))
        (finish_host_capture host)))
    (set voice/capture_id "") (paint voice) (pump voice) (return))
  (var handle : EventTarget voice/capture)
  (set voice/recording false)
  (if cancel
    (do
      (set voice/finalizing false) (set voice/capture_id "")
      (finish_utterance voice/drafts id "" "cancelled")
      ($speech/recognize_abort handle)
      (set voice/feedback "Capture cancelled.") (earcon voice 330.0)
      (paint voice) (pump voice))
    (do
      (set voice/finalizing true)
      (set voice/release_at ($time/now))
      (release_utterance voice/drafts id ($to_int (- ($time/now) voice/capture_started)))
      ($speech/recognize_stop handle)
      (paint voice)
      ($time/after 5000.0 (fn [] : Void
        (if_yes (|| voice/disposed (!= id voice/capture_id) (! voice/finalizing)) (return))
        ($speech/recognize_abort handle)
        (finish_utterance voice/drafts id "" "failed")
        (store_draft voice)
        (set voice/finalizing false) (set voice/capture_id "")
        (set voice/feedback "Recognition did not finish. Any recognized text is kept for review.")
        (earcon voice 220.0) (paint voice) (try_send voice) (pump voice))))))

(fn start_capture [voice : Voice] : Void
  (if_yes (|| voice/disposed (! voice/enabled) voice/recording voice/claiming) (return))
  (if_yes voice/finalizing
    (set voice/feedback "The previous recording is finishing. Wait for it before recording again.")
    (earcon voice 220.0) (paint voice) (return))
  (if_yes (&& (== voice/recognizer "host") (! (host_ready? voice)))
    (set voice/feedback "The host recognizer is still connecting.") (paint voice) (return))
  (if_yes (>= (pending_count voice) 4)
    (set voice/feedback "Four recordings are still finishing. Wait for one before starting another.")
    (earcon voice 220.0) (paint voice) (return))
  (if_yes (&& (== voice/recognizer "browser") (! ($speech/recognizer_available?)))
    (set voice/feedback "Speech recognition is unavailable. Typed input remains available.")
    (paint voice) (return))
  (cancel_speech voice)
  (var id ($browser/request_id))
  (set voice/capture_id id) (set voice/partial "") (set voice/recording true)
  (set voice/capture_started ($time/now))
  (set voice/manual_capture true)
  (start_utterance voice/drafts id voice/session)
  (if_yes (== voice/recognizer "host")
    (if (! (start_host_capture (host_audio voice) id (fn [level : F64] : Void
      ($dom/set_attribute voice/meter "value" ($to_str level)))))
      (do (set voice/recording false) (set voice/capture_id "")
        (finish_utterance voice/drafts id "" "failed") (earcon voice 220.0)
        (set voice/feedback "Finishing the previous audio frame. Try recording again.")))
    ($time/after 120000.0 (fn [] : Void
      (if_yes (&& (! voice/disposed) (== id voice/capture_id) voice/recording) (finish_capture voice))))
    (paint voice) (return))
  (try
    (set voice/capture
      ($speech/recognize_start voice/language
        (fn [value : Str] : Void
          (if_yes (|| voice/disposed (!= id voice/capture_id)) (return))
          (partial_utterance voice/drafts id value)
          (set voice/partial value) (paint voice))
        (fn [value : Str] : Void
          (if_yes voice/disposed (return))
          (if_yes voice/recording
            (release_utterance voice/drafts id ($to_int (- ($time/now) voice/capture_started))))
          (finish_utterance voice/drafts id value "done")
          (if_yes (! ($absent? (draft voice)))
            (var session voice/session)
            (set voice/drafts/drafts/%session/recognizer "browser"))
          (if_yes (! (store_draft voice))
            (set voice/held true) (set voice/feedback "The recognized draft could not be saved."))
          (if_yes (== value "") (earcon voice 330.0)))
        (fn [error : Str] : Void
          (if_yes (|| voice/disposed (!= id voice/capture_id)) (return))
          (var ended_early (&& voice/recording (== error "")))
          (set voice/recording false) (set voice/finalizing false) (set voice/capture_id "")
          (if_yes ended_early
            (set voice/held true)
            (set voice/feedback "Recognition stopped before release. Review or send the saved voice draft.")
            (store_draft voice) (earcon voice 330.0))
          (if_yes (!= error "")
            (finish_utterance voice/drafts id "" "failed")
            (set voice/held true)
            (store_draft voice)
            (set voice/feedback ($to_str "Recognition unavailable: " error ". You can type instead."))
            (earcon voice 220.0))
          (paint voice) (try_send voice) (pump voice))))
    ($dom/focus voice/mic) (earcon voice 660.0)
    (paint voice)
    ($time/after 120000.0 (fn [] : Void
      (if_yes (&& (! voice/disposed) (== id voice/capture_id) voice/recording) (finish_capture voice))))
  catch Any
    (finish_utterance voice/drafts id "" "failed")
    (set voice/recording false) (set voice/capture_id "")
    (set voice/feedback "The microphone could not start. Check browser permission or type instead.")
    (paint voice)))

(fn disable_voice [voice : Voice, release : Bool = true] : Void
  (if_yes (|| voice/recording voice/finalizing) (finish_capture voice true))
  (set voice/enabled false) (set voice/claiming false)
  (set voice/generation (+ voice/generation 1)) (set voice/submitting false)
  (cancel_speech voice)
  (if_not ($absent? voice/host)
    (close_host_audio (host_audio voice)) (set voice/host nil))
  (for [id pending] in voice/pending
    (finish_utterance voice/drafts ($to_str id) "" "cancelled"))
  (set voice/pending {})
  (if_yes (!= voice/session "") (store_draft voice))
  (if_yes (&& release (!= voice/token ""))
    (api voice "POST" $"/api/v8/sessions/${voice/session}/voice"
      {^client_id voice/client_id ^token voice/token ^enabled false} (fn [code : Int, data : Any] : Void nil)))
  (set voice/token "")
  (if_not ($absent? voice/context)
    (var context : EventTarget voice/context)
    ($audio/close context) (set voice/context nil))
  (paint voice))

(fn host_event [voice : Voice, kind : Str, data : Any] : Void
  (if_yes (|| voice/disposed (! voice/enabled)) (return))
  (if_yes (== kind "error")
    (set voice/feedback (text data/message "Host audio is unavailable. You can type instead."))
    (disable_voice voice) (return))
  (if_yes (== kind "host/reconnecting")
    (if_yes (!= voice/capture_id "") (finish_utterance voice/drafts voice/capture_id "" "cancelled"))
    (for [id pending] in voice/pending (finish_utterance voice/drafts ($to_str id) "" "failed"))
    (store_draft voice)
    (set voice/pending {}) (set voice/capture_id "") (set voice/recording false)
    (set voice/finalizing false) (set voice/speaking false) (set voice/queue [])
    (set voice/feedback "Reconnecting voice. Interrupted recordings and speech are not resumed.") (paint voice) (return))
  (if_yes (== kind "engines/changed")
    (if_yes (!= voice/capture_id "") (finish_utterance voice/drafts voice/capture_id "" "cancelled"))
    (for [id pending] in voice/pending (finish_utterance voice/drafts ($to_str id) "" "failed"))
    (store_draft voice)
    (set voice/pending {}) (set voice/capture_id "") (set voice/recording false)
    (set voice/finalizing false) (set voice/speaking false) (set voice/queue [])
    (set voice/feedback "Speech engines changed. Reconnecting voice.")
    (connect_host voice) (paint voice) (return))
  (if_yes (== kind "host/ready")
    (set voice/feedback "Voice connected. Hold the microphone button, or focus it and hold Space.")
    (if_yes (== voice/mode "handsfree") (enable_handsfree voice))
    (paint voice) (pump voice) (return))
  (if_yes (== kind "microphone/error")
    (var failed_id (text data/id))
    (if_yes (!= failed_id "") (finish_utterance voice/drafts failed_id "" "failed") (drop_pending voice failed_id))
    (store_draft voice)
    (set voice/recording false) (set voice/capture_id "")
    (set voice/feedback (text data/message "The hands-free microphone is unavailable. You can type instead."))
    (paint voice) (try_send voice) (pump voice) (return))
  (if_yes (== kind "vad/start")
    (var started_id (text data/id))
    (if_yes (>= (pending_count voice) 4)
      (cancel_host_utterance (host_audio voice) started_id)
      (var paused_host (host_audio voice)) (set paused_host/input_paused true)
      (set voice/feedback "Waiting for earlier recordings to finish.") (paint voice) (return))
    (cancel_speech voice)
    (set voice/manual_capture false) (set voice/capture_id started_id) (set voice/recording true)
    (set voice/capture_started ($time/now)) (set voice/partial "")
    (start_utterance voice/drafts started_id voice/session)
    (paint voice) (return))
  (if_yes (== kind "vad/end")
    (var ended_id (text data/id))
    (await_host_final voice ended_id (integer data/audio_ms))
    (if_yes (== voice/capture_id ended_id) (set voice/capture_id "") (set voice/recording false))
    (paint voice) (pump voice) (return))
  (if_yes (== kind "capture/released") (paint voice) (pump voice) (return))
  (if_yes (== kind "engine/error")
    (set voice/feedback (text data/message "The configured speech engine is unavailable. Check host configuration or select browser speech."))
    (paint voice) (return))
  (if_yes (== kind "speak/started")
    (api voice "POST" $"/api/v8/sessions/${voice/session}/voice/latency"
      {^kind "output" ^identity voice/speaking_record ^elapsed_ms ($to_int (- ($time/now) voice/speech_began))}
      (fn [code : Int, value : Any] : Void nil)) (return))
  (if_yes (|| (== kind "speak/end") (== kind "speak/error"))
    (set voice/speaking false)
    (if_yes (== kind "speak/error") (set voice/feedback (text data/message "Host speech failed.")))
    (paint voice) (pump voice) (return))
  (var id (text data/id))
  (if_yes (== kind "transcript/partial")
    (partial_utterance voice/drafts id (text data/text))
    (if_yes (|| (== id voice/capture_id) (! voice/recording)) (set voice/partial (text data/text)) (paint voice))
    (return))
  (if_yes (|| (== kind "transcript/final") (== kind "capture/error"))
    (if_yes (&& (== kind "capture/error") (!= (text data/text) ""))
      (partial_utterance voice/drafts id (text data/text)))
    (if_yes (&& (== kind "capture/error") (== id voice/capture_id))
      (set voice/recording false) (set voice/capture_id "")
      (finish_utterance voice/drafts id "" "failed")
      (store_draft voice)
      (set voice/feedback (text data/message "Recognition failed. You can type instead."))
      (paint voice) (try_send voice) (pump voice) (return))
    (if_yes ($absent? voice/pending/%id) (return))
    (set voice/release_at voice/pending/%id/released)
    (drop_pending voice id)
    (if_yes (&& (== kind "transcript/final") (! ($absent? data/audio_ms)))
      (var utterance : Any (find_utterance voice/drafts id))
      (if_not ($absent? utterance) (set utterance/audio_ms (integer data/audio_ms))))
    (finish_utterance voice/drafts id (text data/text) (if (== kind "transcript/final") "done" "failed"))
    (if_yes (== kind "capture/error")
      (set voice/feedback (text data/message "Recognition failed. You can type instead.")) (earcon voice 220.0))
    (if_not ($absent? (draft voice))
      (var session voice/session)
      (set voice/drafts/drafts/%session/recognizer (text data/recognizer "host")))
    (store_draft voice) (paint voice) (try_send voice) (pump voice)))

(fn connect_host [voice : Voice] : Void
  (if_yes (|| (! voice/enabled) (&& (!= voice/recognizer "host") (!= voice/synthesizer "host"))) (return))
  (if_not ($absent? voice/host) (close_host_audio (host_audio voice)))
  (var current (state voice))
  (var context : EventTarget voice/context)
  (set voice/host (open_host_audio context voice/session voice/client_id (text current/csrf) voice/token voice/output
    (== voice/recognizer "host") (== voice/synthesizer "host")
    (fn [kind : Str, data : Any] : Void (host_event voice kind data)))))

(fn change_engine [voice : Voice, kind : Str, value : Str] : Void
  (var active voice/enabled)
  (var session voice/session)
  (if_yes active (disable_voice voice))
  (if (== kind "recognizer") (set voice/recognizer value) (set voice/synthesizer value))
  (if_yes (&& (== voice/mode "handsfree") (!= voice/recognizer "host")) (set voice/mode "hold"))
  (save_settings voice)
  (if_yes active (enable_voice ^session session voice (fn [] : Void nil)))
  (paint voice))

(fn enable_handsfree [voice : Voice] : Void
  (if_yes (|| (! voice/enabled) (! (host_ready? voice)) (!= voice/recognizer "host")) (return))
  (if_yes (start_handsfree (host_audio voice) voice/duplex (fn [level : F64] : Void
    ($dom/set_attribute voice/meter "value" ($to_str level))))
    (set voice/feedback (if (== voice/duplex "half")
      "Hands-free microphone is on. Hold or press Space to interrupt playback."
      "Hands-free microphone is on. Wear headphones; speaking interrupts playback.")))
  (paint voice))

(fn change_mode [voice : Voice, mode : Str] : Void
  (if_yes (&& (== mode "handsfree") (!= voice/recognizer "host"))
    (set voice/feedback "Choose a configured host recognizer before enabling hands-free capture.")
    (paint voice) (return))
  (if_yes voice/recording (finish_capture voice true))
  (if_not ($absent? voice/host) (stop_handsfree (host_audio voice)))
  (set voice/mode mode) (save_settings voice)
  (if_yes (== mode "handsfree") (enable_handsfree voice))
  (paint voice))

(fn enable_voice [voice : Voice, done : (Fn [] Void), ^session session : Str = ""] : Void
  (if_yes (|| voice/disposed voice/claiming) (return))
  (if_yes voice/enabled (done) (return))
  (if_yes ($absent? voice/context) (set voice/context ($audio/context)))
  (var context : EventTarget voice/context)
  ($audio/resume context)
  (populate_voices voice)
  ($time/after 250.0 (fn [] : Void (if_yes (! voice/disposed) (populate_voices voice))))
  (set voice/claiming true)
  (var generation voice/generation)
  (var claim (fn [id : Str] : Void
    (set voice/session id)
    (api voice "POST" $"/api/v8/sessions/${id}/voice"
      {^client_id voice/client_id ^output voice/output}
      (fn [code : Int, data : Any] : Void
        (if_yes (|| voice/disposed (!= generation voice/generation))
          (if_yes (== code 200)
            (api voice "POST" $"/api/v8/sessions/${id}/voice"
              {^client_id voice/client_id ^token (text data/token) ^enabled false}
              (fn [released : Int, result : Any] : Void nil)))
          (return))
        (if (== code 200)
          (do
            (set voice/token (text data/token))
            (set voice/claim_revision (text data/revision))
            (load_draft voice)
            (api voice "GET" $"/api/v8/sessions/${id}/voice" nil
              (fn [status : Int, current : Any] : Void
                (if_yes (|| voice/disposed (!= generation voice/generation)) (return))
                (set voice/claiming false)
                (if_yes (|| (!= status 200) (!= (text current/voice/revision) voice/claim_revision)
                            (!= (text current/voice/owner) voice/client_id))
                  (set voice/feedback "Another page owns voice. Enable it again to take it back.")
                  (disable_voice voice false) (return))
                (set voice/enabled true)
                (set voice/title (text current/title "this conversation"))
                (set voice/round_state (text current/state "done"))
                (connect_host voice)
                (if_yes (&& (== voice/recognizer "browser") (! ($speech/recognizer_available?)))
                  (set voice/feedback "Recognition is unavailable in this browser. You can type or replay replies."))
                (paint voice) (done))))
          (do (set voice/claiming false) (set voice/feedback (text data/message "Voice could not be enabled."))))
        (paint voice)))))
  (if (!= session "") (claim session)
    (do
      (var ensure : (Fn [(Fn [Int Any] Void)] Void) voice/bridge/ensure_session)
      (ensure (fn [code : Int, data : Any] : Void
        (if_yes (|| voice/disposed (!= generation voice/generation)) (return))
        (if (|| (== code 200) (== code 201)) (claim (text data/id))
          (do (set voice/claiming false) (set voice/feedback (text data/message "Choose a conversation first.")) (paint voice)))))))
  (paint voice))

(fn event [voice : Voice, kind : Str, session : Str, data : Any] : Void
  (if_yes voice/disposed (return))
  (if_yes (== kind "voice/state")
    (if_yes (&& voice/enabled
      (|| (! (flag data/enabled)) (!= (text data/owner) voice/client_id) (!= (text data/revision) voice/claim_revision)))
      (disable_voice voice false))
    (return))
  (if_yes (== kind "voice/replay")
    (if_yes (|| voice/recording voice/finalizing) (set voice/feedback "Finish the recording before replaying a reply.") (paint voice) (return))
    (if_yes (&& voice/enabled (!= session voice/session)) (disable_voice voice))
    (enable_voice ^session session voice
      (fn [] : Void (enqueue voice (text data/id) (text data/speech (text data/text)) true)))
    (return))
  (if_yes (== kind "submission/state") (load_draft voice) (paint voice) (return))
  (if_yes (!= session voice/session) (return))
  (if_yes (== kind "session/close") (disable_voice voice) (return))
  (if_yes (== kind "voice/admitted")
    (load_draft voice) (set voice/round_state (text data/state "running")) (paint voice) (return))
  (if_yes (! voice/enabled) (return))
  (if_yes (== kind "reply")
    (var round (text data/round_id))
    (if_yes (flag data/final) (set voice/final_rounds/%round true))
    (if_yes (|| voice/progress (flag data/final))
      (enqueue voice (text data/id) (text data/speech (text data/text))))
    (return))
  (if_yes (== kind "round/state")
    (set voice/round_state (text data/state "done"))
    (if_yes (&& (== voice/round_state "paused") (!= (text data/continuation_mode) "automatic"))
      (enqueue voice ($to_str (text data/id) "/paused") "Paused at the turn limit. Continue controls are on screen." false "paused"))
    (if_yes (== voice/round_state "waiting")
      (var count ($size (items data/questions/questions)))
      (enqueue voice ($to_str (text data/id) "/questions") ($to_str count " questions are on screen.") false "questions" count))
    (if_yes (|| (== voice/round_state "failed") (== voice/round_state "cancelled") (== voice/round_state "interrupted"))
      (if_yes (== voice/round_state "cancelled") (cancel_speech voice))
      (var round_id (text data/id))
      (if_yes ($absent? voice/final_rounds/%round_id)
        (earcon voice 220.0)
        (enqueue voice ($to_str round_id "/state") ($to_str "The request " voice/round_state ". Details are on screen.") false voice/round_state)))
    (paint voice) (try_send voice)))

(fn dispose [voice : Voice] : Void
  (if_yes voice/disposed (return))
  (disable_voice voice)
  (set voice/disposed true)
  (set voice/generation (+ voice/generation 1))
  (dispose_drafts voice/drafts)
  (var unsubscribe : (Fn [] Void) voice/unsubscribe)
  (unsubscribe)
  (var pointer_up : (Fn [Any] Void) voice/pointer_up)
  (var key_down : (Fn [Any] Void) voice/key_down)
  (var key_up : (Fn [Any] Void) voice/key_up)
  (var page_hide : (Fn [Any] Void) voice/page_hide)
  ($dom/remove_event_listener ($dom/window) "pointerup" pointer_up)
  ($dom/remove_event_listener ($dom/window) "keydown" key_down)
  ($dom/remove_event_listener ($dom/window) "keyup" key_up)
  ($dom/remove_event_listener ($dom/window) "pagehide" page_hide))

(fn labeled_control [label : Str, control : EventTarget] : EventTarget
  (var node ($dom/render `(label %label)))
  ($dom/append node control)
  node)

(fn main [root : EventTarget] : Void
  (var bridge : Any root/harness_bridge)
  (var button ($dom/render `(button ^type "button" ^aria-pressed "false" "Voice")))
  (var toolbar : EventTarget bridge/toolbar)
  ($dom/append toolbar button)
  (var mic ($dom/render `(button ^type "button" "Hold to talk · Space")))
  (var message ($dom/render `(p ^role "status" ^aria-live "polite")))
  (var transcript ($dom/render `(textarea ^rows "3" ^aria-label "Voice draft" ^placeholder "Your recognized speech appears here.")))
  (var send_button ($dom/render `(button ^type "button" "Send queued voice")))
  (var discard_button ($dom/render `(button ^type "button" "Cancel queued voice")))
  (var panel ($dom/render `(section ^class_name "voice-panel" ^aria-label "Voice controls" ^^hidden
    (strong "Voice")
    (p ^class_name "muted" "Browser recognition may send audio to your browser vendor. It may need a network connection. Typed input stays available."))))
  (var voice (Voice ^root root ^bridge bridge ^button button ^panel panel ^mic mic ^message message
    ^transcript transcript ^send_button send_button ^discard_button discard_button ^drafts (new_voice_drafts)
    ^context nil ^capture nil ^unsubscribe nil ^host nil ^pending {} ^meter ($dom/render `(meter ^min "0" ^max "1" ^value "0" ^aria-label "Microphone level"))
    ^release_at 0.0 ^speech_began 0.0 ^speaking_record "" ^recognizer "browser" ^synthesizer "browser"
    ^duplex "half" ^!manual_capture ^mode_select root ^voice_select root
    ^pointer_up nil ^key_down nil ^key_up nil ^page_hide nil
    ^!enabled ^!disposed ^!claiming ^!recording ^!finalizing ^!submitting ^!held
    ^^output ^^autosend ^^progress ^mode "hold" ^voice "" ^language "en-US"
    ^session "" ^title "" ^workspace "" ^client_id "" ^token "" ^claim_revision "" ^capture_id "" ^capture_started 0.0
    ^generation 0 ^speech_generation 0 ^!speaking ^queue [] ^seen {} ^final_rounds {}
    ^round_state "done" ^partial "" ^feedback "Hold the microphone button, or focus it and hold Space."))
  (var current (state voice))
  (set voice/workspace (text current/workspace))
  (set voice/client_id (text current/client_id))
  (load_settings voice)
  (var mode_select ($dom/render `(select ^aria-label "Capture mode" ^on_change %(fn [e : Any] : Void
    (change_mode voice (text e/current_target/value)))
    (option ^value "hold" ^selected %(== voice/mode "hold") "Hold to talk")
    (option ^value "toggle" ^selected %(== voice/mode "toggle") "Click to start / stop")
    (option ^value "handsfree" ^selected %(== voice/mode "handsfree") "Hands-free (host recognizer)"))))
  (set voice/mode_select mode_select)
  (var voice_select ($dom/render `(select ^aria-label "Browser voice" ^on_change %(fn [e : Any] : Void
    (set voice/voice (text e/current_target/value)) (save_settings voice)))))
  (set voice/voice_select voice_select)
  (populate_voices voice)
  ($dom/append panel mic) ($dom/append panel transcript)
  ($dom/append panel voice/meter)
  ($dom/append panel send_button) ($dom/append panel discard_button)
  (var settings ($dom/render `(details
    (summary "Voice settings")
    (label (input ^type "checkbox" ^checked %voice/output ^on_change %(fn [e : Any] : Void
      (set voice/output (flag e/current_target/checked))
      (if_not ($absent? voice/host)
        (var host (host_audio voice)) (set host/output voice/output))
      (save_settings voice)
      (if_yes (! voice/output) (cancel_speech voice))
      (if_yes voice/enabled
        (api voice "POST" $"/api/v8/sessions/${voice/session}/voice"
          {^client_id voice/client_id ^token voice/token ^output voice/output}
          (fn [code : Int, data : Any] : Void (if_yes (!= code 200) (disable_voice voice false))))))) " Speak replies")
    (label (input ^type "checkbox" ^checked %voice/autosend ^on_change %(fn [e : Any] : Void (set voice/autosend (flag e/current_target/checked)) (save_settings voice))) " Send on release; turn off to review")
    (label (input ^type "checkbox" ^checked %voice/progress ^on_change %(fn [e : Any] : Void (set voice/progress (flag e/current_target/checked)) (save_settings voice))) " Speak progress replies"))))
  ($dom/append settings (labeled_control "Capture mode " mode_select))
  ($dom/append settings ($dom/render `(div
    (label "Hands-free playback "
      (select ^aria-label "Hands-free playback" ^on_change %(fn [e : Any] : Void
        (set voice/duplex (text e/current_target/value)) (save_settings voice)
        (if_yes (&& voice/enabled (== voice/mode "handsfree")) (enable_handsfree voice)))
        (option ^value "half" ^selected %(== voice/duplex "half") "Half duplex · hold to interrupt")
        (option ^value "headphones" ^selected %(== voice/duplex "headphones") "Headphones · speak to interrupt")))
    (label "Recognition "
      (select ^aria-label "Recognition engine" ^on_change %(fn [e : Any] : Void (change_engine voice "recognizer" (text e/current_target/value)))
        (option ^value "browser" ^selected %(== voice/recognizer "browser") "Browser speech service")
        (option ^value "host" ^selected %(== voice/recognizer "host") "Configured host engine")))
    (label "Speech output "
      (select ^aria-label "Speech output engine" ^on_change %(fn [e : Any] : Void (change_engine voice "synthesizer" (text e/current_target/value)))
        (option ^value "browser" ^selected %(== voice/synthesizer "browser") "Browser voice")
        (option ^value "host" ^selected %(== voice/synthesizer "host") "Configured host engine")))
    (label "Browser recognition language "
      (input ^type "text" ^value %voice/language ^aria-label "Browser recognition language" ^on_change %(fn [e : Any] : Void
        (set voice/language (text e/current_target/value "en-US")) (save_settings voice)))))))
  ($dom/append settings (labeled_control "Browser voice " voice_select))
  ($dom/append settings ($dom/render `(div
    (button ^type "button" ^on_click %(fn [e : Any] : Void (populate_voices voice)) "Refresh browser voices")
    (button ^type "button" ^on_click %(fn [e : Any] : Void (cancel_speech voice)) "Stop speaking"))))
  ($dom/append panel settings)
  ($dom/append panel message) ($dom/append root panel)
  ($dom/add_event_listener button "click" (fn [e : Any] : Void
    (if voice/enabled (disable_voice voice) (enable_voice voice (fn [] : Void nil)))))
  ($dom/add_event_listener mic "pointerdown" (fn [e : Any] : Void
    (if_yes (|| (== voice/mode "hold") (== voice/mode "handsfree")) ($dom/prevent_default e) (start_capture voice))))
  ($dom/add_event_listener mic "click" (fn [e : Any] : Void
    (if_yes (== voice/mode "toggle")
      (if voice/recording (finish_capture voice) (start_capture voice)))))
  ($dom/add_event_listener send_button "click" (fn [e : Any] : Void (try_send voice true)))
  ($dom/add_event_listener discard_button "click" (fn [e : Any] : Void
    (var session voice/session)
    (set voice/drafts/drafts/%session nil) (store_draft voice) (set voice/held false) (paint voice)))
  ($dom/add_event_listener transcript "input" (fn [e : Any] : Void
    (if_yes (|| voice/recording voice/finalizing) (return))
    (var session voice/session)
    (var previous : Any (draft voice))
    (set voice/drafts/drafts/%session {^text ($dom/input_value transcript) ^audio_ms (if ($absent? previous/audio_ms) 0 previous/audio_ms)})
    (store_draft voice)))
  (var pointer_up (fn [e : Any] : Void
    (if_yes (&& voice/recording (|| (== voice/mode "hold") (&& (== voice/mode "handsfree") voice/manual_capture))) (finish_capture voice))))
  (var key_down (fn [e : Any] : Void
    (if_yes (|| voice/disposed ($event/is_composing e) ($event/repeat e)) (return))
    (var owned : (Fn [] Bool) bridge/keyboard_owned)
    (if_yes (owned) (return))
    (if_yes (&& (== ($event/code e) "Escape") (|| voice/recording voice/finalizing))
      ($dom/prevent_default e) (finish_capture voice true))
    (if_yes (&& (== ($event/code e) "Space") ($dom/focused? mic) (|| (== voice/mode "hold") (== voice/mode "handsfree")))
      ($dom/prevent_default e) (start_capture voice))))
  (var key_up (fn [e : Any] : Void
    (if_yes (&& (== ($event/code e) "Space") voice/recording
      (|| (== voice/mode "hold") (&& (== voice/mode "handsfree") voice/manual_capture)))
      ($dom/prevent_default e) (finish_capture voice))))
  (var page_hide (fn [e : Any] : Void (dispose voice)))
  (set voice/pointer_up pointer_up) (set voice/key_down key_down) (set voice/key_up key_up) (set voice/page_hide page_hide)
  ($dom/add_event_listener ($dom/window) "pointerup" pointer_up)
  ($dom/add_event_listener ($dom/window) "keydown" key_down)
  ($dom/add_event_listener ($dom/window) "keyup" key_up)
  ($dom/add_event_listener ($dom/window) "pagehide" page_hide)
  (var subscribe : (Fn [(Fn [Str Str Any] Void)] (Fn [] Void)) bridge/subscribe)
  (set voice/unsubscribe (subscribe (fn [kind : Str, session : Str, data : Any] : Void (event voice kind session data))))
  (set root/harness_controller
    {^dispose (fn [] : Void (dispose voice))
     ^update (fn [status : Any] : Void
       (set voice/workspace (text status/workspace voice/workspace)) (paint voice))})
  (paint voice))
