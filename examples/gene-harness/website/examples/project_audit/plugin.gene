# Adapted from the recorded project_audit example to the current function API.
# request.txt preserves the original request; check.gene verifies this version.
(mod plugin
  (import [Plugin PluginHost] ^from "src/plugin_api.gene")
  (type AuditError ^props {^code Str ^message Str ^data Any?} ^impl [Error])
  (impl Error for AuditError)

  (fn audit_error [code : Str, message : Str, stage : Str, path : Str]
    (fail (AuditError ^code code ^message message ^data {^stage stage ^path path})))

  (fn check_path [path : Str, stage : Str]
    (if (|| (== path "") ($str/starts_with? path "/")
            ($str/contains? path "\\") ($str/contains? path ":"))
      (audit_error "invalid_path" "Use a relative filename with forward slashes." stage path))
    (for part in ($str/split path "/")
      (if (|| (== part "..") (== part ""))
        (audit_error "invalid_path" "Parent traversal and empty path components are not allowed." stage path))))

  (fn table_row [label, counts]
    ($str/join ["| " label " | " ($to_str counts/non_empty)
      " | " ($to_str counts/todo) " | " ($to_str counts/fixme) " |"] ""))

  (fn write_report [host, summary]
    (let rows ["| File | Non-empty | TODO | FIXME |" "| --- | ---: | ---: | ---: |"])
    (for file in summary/files
      (var label ($str/join ($str/split file/path "|") "&#124;"))
      (set label ($str/join ($str/split label "\n") " "))
      (set label ($str/join ($str/split label "\r") " "))
      (rows .push (table_row label file)))
    (rows .push (table_row "**Total**" summary/totals))
    (rows .push "")
    (try ($fs/write_text summary/report_path ($str/join rows "\n"))
      catch Any (audit_error "write_failed" $"Could not write ${summary/report_path}." "write" summary/report_path))
    (host .PluginHost:update_state summary)
    summary)

  (fn scan [host, paths : List, report_path : Str]
    (if (|| (< paths/.size 1) (> paths/.size 8))
      (audit_error "invalid_input" "Provide 1 to 8 paths." "read" ""))
    (for path in paths (check_path path "read"))
    (check_path report_path "write")
    (if_not ($str/ends_with? ($str/lower report_path) ".md")
      (audit_error "invalid_path" "The report filename must end in .md." "write" report_path))
    (let files [])
    (let totals {^non_empty 0 ^todo 0 ^fixme 0})
    (for path in paths
      (let text (try ($fs/read_text path)
        catch Any (audit_error "read_failed" $"Could not read ${path}." "read" path)))
      (let counts {^path path ^non_empty 0 ^todo 0 ^fixme 0})
      (for line in ($str/split text "\n")
        (if (!= ($str/trim line) "") (counts .put "non_empty" (+ counts/non_empty 1)))
        (let normalized ($str/lower line))
        (if ($str/contains? normalized "todo") (counts .put "todo" (+ counts/todo 1)))
        (if ($str/contains? normalized "fixme") (counts .put "fixme" (+ counts/fixme 1))))
      (files .push counts)
      (for key in ["non_empty" "todo" "fixme"]
        (totals .put key (+ (totals .get key) (counts .get key)))))
    (write_report host {^report_path report_path ^files files ^totals totals}))

  (fn init [descriptor]
    (Plugin ^id "project_audit"
      ^provides [["functions" "project_audit_scan"] ["functions" "project_audit_last"]]
      ^activate (fn [host]
        (host .PluginHost:contribute "functions"
          {^name "project_audit_scan"
           ^doc "Audit 1–8 relative files, write a Markdown report and persist the successful summary."
           ^fn (fn [^paths paths : List, ^report_path report_path : Str]
             (scan host paths report_path))})
        (host .PluginHost:contribute "functions"
          {^name "project_audit_last" ^doc "Read the last successful audit without reading files."
           ^fn (fn [] host/.PluginHost:state)})))))
