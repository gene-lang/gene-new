# Verify the current website example without a model, including restart recovery.
# Run from any directory; the fixture project and Harness state use a scratch workspace.
(mod project_audit_check)
(import [module_dir row] ^from "../../../src/kernel")
(import [register_plugin] ^from "../../../src/storage/workspace")
(import [open_runtime close_runtime] ^from "../../../src/runtime/bootstrap")
(import [offline_profile] ^from "../../../src/profiles/offline")
(import [submit_command command_receipt] ^from "../../../src/runtime/commands")

(let example_dir (module_dir this_mod/.path))
(let package_root ($path/parent ($path/parent ($path/parent example_dir))))

(fn fixture [path : Str] ($fs/read_text $"${example_dir}/${path}"))
(fn fixture_data [path : Str] (($parse/read_all (fixture path)) .next))

(fn run_command [runtime, text : Str]
  (let record (submit_command runtime/commands "website_check" text))
  (runtime/commands/watchers/.get .get $"website_check:${record/id}"; .join)
  (command_receipt runtime/commands "website_check" record/id))

(fn last_summary [runtime]
  ((/fn (row runtime/h "functions" "project_audit_last"))))

(fn main [args]
  (let scratch $"${package_root}/tmp/website-check-${($crypto/random_hex 8)}")
  ($fs/make_dir scratch)
  ($fs/make_dir $"${scratch}/src")
  (for name in ["orders.gene" "report.gene"]
    ($fs/write_text $"${scratch}/src/${name}" (fixture $"project/src/${name}")))
  (let commands (fixture_data "commands.gene"))
  (let expected (fixture_data "expected/summary.gene"))
  (let runtime (open_runtime scratch "website_check" (offline_profile)))
  (try
    (let registered (register_plugin runtime/workspace runtime/h "project_audit"
      (fixture "plugin.gene") ^by "website/check"))
    ($assert (== registered/state "active") ($to_str registered))
    (let scanned (run_command runtime commands/scan))
    ($assert (== scanned/status "done") scanned/display)
    ($assert (== (last_summary runtime) expected) "Audit summary changed.")
    ($assert (== ($fs/read_text "audit-report.md") (fixture "expected/audit-report.md")) "Report changed.")
    (let missing (run_command runtime commands/missing))
    (let failure (fixture_data "expected/missing.gene"))
    ($assert (== missing/status "failed") missing/display)
    ($assert (== missing/error_code failure/code) missing/display)
    ($assert ($str/contains? missing/display failure/message) missing/display)
    ($assert (! ($fs/exists? "missing-report.md")) "A failed scan wrote a report.")
    ($assert (== (last_summary runtime) expected) "A failed scan replaced the saved summary.")
    (let inspect (/fn (row runtime/h "functions" "project_audit_scan")))
    (let diagnostic (try (inspect ^paths ["src/missing.gene"] ^report_path "missing-report.md") nil
      catch Any {^code $err/code ^message $err/message ^data $err/data}))
    ($assert (== diagnostic failure) ($to_str diagnostic))
  ensure (close_runtime runtime))
  (let restored (open_runtime scratch "website_check" (offline_profile)))
  (try
    ($assert (== (last_summary restored) expected) "Restart lost the plugin or its state.")
    ($assert (== (/status (run_command restored commands/last)) "done"))
  ensure (close_runtime restored))
  ($println $"project_audit example: ok (${scratch})")
  0)
