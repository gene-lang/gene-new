# Opt-in actual-engine smoke/latency probe. PCM stays in memory; only metrics
# are printed. Supply the engine's normal host environment before running.
(import [piper_row whisper_row mac_synthesizer_row mac_helper] ^from "../src/audio/engines")
(import [wav_decode wav_encode pcm_duration_ms audio_error] ^from "./audio" ^pkg "audio")
(import [bounded_audio_call] ^from "../src/audio/call")
(import [mac_recognizer_row] ^from "../src/audio/mac_recognition")
(import [open_worker close_worker read_json dispatch_json] ^from "./worker" ^pkg "audio")
(import [connect api] ^from "../src/cli/client")

(fn main [argv] : Int
  (let args [])
  (for arg in argv (args .push ($to_str arg)))
  (let kind (if (== args/.size 0) "piper" args/0))
  (if_yes (|| (== kind "fixture") (== kind "fixture_vad"))
    (if (< args/.size 3) (audio_error "Fixture trim needs SOURCE_WAV OUTPUT_WAV."))
    (let fixture (wav_decode ($fs/read_bytes args/1)))
    (let count ($math/min ($binary/size fixture/pcm) (* fixture/format/rate fixture/format/channels 6)))
    (var pcm ($binary/slice fixture/pcm 0 count))
    (if_yes (== kind "fixture_vad")
      (let zeros [])
      (repeat sample in (* fixture/format/rate fixture/format/channels 2) (zeros .push 0))
      (set pcm ($binary/concat [pcm ($binary/from_list zeros)])))
    ($fs/write_bytes args/2 (wav_encode pcm fixture/format/rate fixture/format/channels))
    ($println "Wrote a public-speech test fixture.") (return 0))
  (if_yes (== kind "latency")
    (if (< args/.size 3) (audio_error "Latency probe needs WORKSPACE SESSION."))
    ($println ($json/stringify (api (connect args/1) "GET" $"/sessions/${args/2}/voice/latency")))
    (return 0))
  (if_yes (== kind "macos_install")
    (let worker (open_worker (mac_helper) ["--install" (if (> args/.size 1) args/1 "en-US")]))
    (try
      (let result (bounded_audio_call (fn [] (read_json worker/reader)) [] 180000))
      (if (!= result/ok true) (audio_error (?? result/message "SpeechAnalyzer asset installation failed.")))
      ($println "SpeechAnalyzer assets installed.")
      (return 0)
    ensure (close_worker worker)))
  (let engine (if (== kind "piper") (piper_row)
    (if (== kind "macos") (mac_synthesizer_row)
      (if (== kind "macos_stt") (mac_recognizer_row) (whisper_row)))))
  (let settings {^language "en" ^rate 1.0})
  (let started ($os/monotonic_ms))
  (let resource (engine/open settings))
  (if_not ($absent? resource/dispatch_message)
    (dispatch_json resource resource/dispatch_message resource/dispatch_error))
  (let opened (- ($os/monotonic_ms) started))
  (try
    (if (|| (== kind "piper") (== kind "macos"))
      (then
        (for text in ["The voice check is ready." "The voice check is ready."]
          (let began ($os/monotonic_ms))
          (var first nil) (var count 0) (var chunks 0)
          (let emit (fn [bytes : Bytes]
            (if ($absent? first) (set first (- ($os/monotonic_ms) began)))
            (set count (+ count ($binary/size bytes))) (set chunks (+ chunks 1))))
          (bounded_audio_call engine/synthesize [resource text settings emit] 15000)
          ($println ($json/stringify {^engine kind ^open_ms opened ^first_chunk_ms first
            ^total_ms (- ($os/monotonic_ms) began) ^chunks chunks ^bytes count ^rate resource/format/rate}))))
      (else
        (if (< args/.size 2) (audio_error "Whisper probe needs a 16 kHz mono s16le fixture WAV path."))
        (let wav (wav_decode ($fs/read_bytes args/1)))
        (if (|| (!= wav/format/rate 16000) (!= wav/format/channels 1))
          (audio_error "Whisper probe expects a 16 kHz mono fixture WAV."))
        (let began ($os/monotonic_ms))
        (var transcript "")
        (if (== engine/mode "stream")
          (then
            (let done ($cell false)) (let error ($cell nil))
            (let sink (engine/stream resource settings (fn [text : Str] nil)
              (fn [text : Str] (set transcript text) (done .set true))
              (fn [message : Str] (error .set message) (done .set true))))
            (try
              (var offset 0)
              (while (< offset ($binary/size wav/pcm))
                (let count ($math/min 640 (- ($binary/size wav/pcm) offset)))
                (sink/push ($binary/slice wav/pcm offset count))
                (set offset (+ offset count)) ($sleep 20))
              (sink/finish)
              (let deadline (+ ($os/monotonic_ms) 5000))
              (while (! done/.get)
                (if (> ($os/monotonic_ms) deadline) (audio_error "SpeechAnalyzer did not finalize within five seconds."))
                ($sleep 5))
              (if_not ($absent? error/.get) (audio_error error/.get))
            ensure (sink/close)))
          (else (set transcript (engine/transcribe resource wav/pcm settings))))
        ($println ($json/stringify {^engine kind ^open_ms opened ^total_ms (- ($os/monotonic_ms) began)
          ^audio_ms (pcm_duration_ms wav/pcm 16000) ^transcript transcript}))))
    0
  ensure (engine/close resource)))
