(mod channel_authority)
(import [open_channel_store close_channel_store snapshot mutate read] ^from "./store" ^^export)
(import [channel_error copy key account_id identifier required_text transport_name] ^from "./model")

(fn open_authority [root : Str]
  (open_channel_store root "owner"
    {^id ($to_str "owner-" ($crypto/random_hex 16)) ^policy_revision 0
     ^accounts {} ^routes {} ^ingress {} ^deliveries {}}))

(fn route_key [transport : Str, account : Str, team : Str, channel : Str]
  (key [transport account team channel]))

(fn ^^private optional_identifier [value, label : Str]
  (if ($absent? value) nil (identifier value label)))

# The account stores the transport's verified public identity and its opaque
# `config` (host-owned references such as a credential file), never a copy of
# a secret. Only owner tooling calls this configuration API; only the account's
# transport plugin reads `config`.
(fn configure_account [owner, id : Str, identity, ^config config = {}]
  (account_id id)
  (if (!= ($head config) Map) (channel_error "invalid_request" "Channel account config must be a map."))
  (let transport (transport_name identity/transport))
  (let record {^id id ^transport transport ^config (copy config)
    ^team (identifier identity/team "team ID")
    ^app (optional_identifier identity/app "app ID")
    ^bot (optional_identifier identity/bot "bot ID")
    ^bot_user (identifier identity/bot_user "bot user ID")
    ^operator (identifier identity/operator "operator ID") ^^enabled})
  (mutate owner (fn [state]
    (map_for [name existing] in state/accounts
      (if (&& (!= ($to_str name) id) (== existing/transport transport) (== existing/team record/team)
              (== (?? existing/app existing/bot_user) (?? record/app record/bot_user)))
        (channel_error "conflict" "This transport app/team already has a configured account.")))
    (let previous (state/accounts .get id))
    (if (&& ($present? previous)
            (|| (!= previous/transport transport) (!= previous/app record/app)
                (!= previous/team record/team) (!= previous/bot_user record/bot_user)))
      (channel_error "conflict" "An account's channel identity cannot be replaced in place."))
    (if_yes (!= previous record)
      (state/accounts .put id record)
      (state .put "policy_revision" (+ state/policy_revision 1)))
    {^account id ^transport transport ^owner state/id ^policy_revision state/policy_revision})))

(fn configure_route [owner, account : Str, channel : Str, workspace : Str,
                     ^approved approved = nil, ^require_mention require_mention : Bool = true,
                     ^enabled enabled : Bool = true]
  (identifier channel "channel ID")
  (required_text workspace "workspace directory" ^max_bytes 4096)
  (if_not (workspace .starts_with? "/")
    (channel_error "invalid_request" "The routed workspace must be an absolute directory."))
  (let canonical ($path/normalize workspace))
  (mutate owner (fn [state]
    (let selected (state/accounts .get account))
    (if ($absent? selected) (channel_error "not_found" "Channel account not found."))
    (let users (if ($absent? approved) [selected/operator] approved))
    (if (!= ($head users) List) (channel_error "invalid_request" "Approved channel users must be a list."))
    (let normalized [])
    (for user in users
      (identifier user "approved user ID")
      (if_not (normalized .contains? user) (normalized .push user)))
    (let id (route_key selected/transport account selected/team channel))
    (let previous (state/routes .get id))
    (if (&& ($present? previous) (!= previous/workspace canonical))
      (channel_error "conflict" "Moving a channel to another workspace requires an explicit migration."))
    (map_for [other candidate] in state/routes
      (if (&& enabled candidate/enabled (!= ($to_str other) id) (== candidate/workspace canonical))
        (channel_error "conflict" "The workspace already has an enabled channel binding.")))
    (let record {^id id ^owner state/id ^transport selected/transport ^account account ^team selected/team ^channel channel
      ^workspace canonical ^approved normalized ^require_mention require_mention ^enabled enabled})
    (if_yes (!= previous record)
      (state/routes .put id record)
      (state .put "policy_revision" (+ state/policy_revision 1)))
    (copy record))))

# One snapshot is one authorization decision. A remote workspace must query
# this authority again before admitting a queued batch instead of using a cache.
(fn authorize_state [state, id : Str, user : Str, workspace]
  (let selected (state/routes .get id))
  (let account (if ($absent? selected) nil (state/accounts .get selected/account)))
  (let allowed (&& ($present? selected) selected/enabled ($present? account) account/enabled
    (|| ($absent? workspace) (== selected/workspace workspace))
    (selected/approved .contains? user)))
  {^allowed allowed ^owner state/id ^policy_revision state/policy_revision
   ^route (if ($absent? selected) nil (copy selected)) ^author user})

(fn authorize [owner, id : Str, user : Str, ^workspace workspace = nil]
  (read owner (fn [state] (authorize_state state id user workspace))))

(fn authorize_parts [owner, id : Str, parts, ^workspace workspace = nil]
  (let decisions {})
  (read owner (fn [state]
    (for part in parts
      (decisions .put part/id (authorize_state state id part/author workspace)))))
  decisions)

(fn public_authority [owner]
  (let state (snapshot owner))
  (let accounts [])
  (map_for [id account] in state/accounts
    (accounts .push {^id ($to_str id) ^transport account/transport ^team account/team ^app account/app
      ^bot_user account/bot_user ^operator account/operator ^enabled account/enabled}))
  {^owner state/id ^revision state/revision ^policy_revision state/policy_revision
   ^accounts accounts ^routes (copy state/routes)})

# The account records of one transport, including its `config`, for that
# transport's own plugin (connections and API clients).
(fn transport_accounts [owner, transport : Str]
  (read owner (fn [state]
    (let result [])
    (map_for [id account] in state/accounts
      (if (== account/transport transport) (result .push (copy account))))
    ($order/sort_by result /id))))
