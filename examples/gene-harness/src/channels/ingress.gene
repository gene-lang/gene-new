(mod channel_ingress)
(import [snapshot mutate read] ^from "./store")
(import [route_key authorize_state] ^from "./authority")
(import [channel_error copy key required_text normalize_message binding_key] ^from "./model")

# A transport plugin normalizes its own envelope and calls this on the
# connection owner before acknowledging it. Returning means the disposition is
# durable and the caller may acknowledge. Network delivery to the workspace
# happens later, outside the reader. The event is:
#   {^event_id ^content          dedup identity and conflict digest source
#    ^message {^channel ^thread ^message ^author ^text}   only when eligible
#    ^reason                      why an ineligible event is ignored
#    ^mentioned ^raw}             addressed to the bot; transport audit copy
(fn record_ingress [owner, account_id : Str, event]
  (if (!= ($head event) Map) (channel_error "invalid_request" "Channel ingress must be a map."))
  (let event_id (required_text event/event_id "event ID" ^max_bytes 256))
  # An account's team never changes in place, so the record ID is stable.
  (let team (read owner (fn [state] (/team (state/accounts .get account_id)))))
  (if ($absent? team) (channel_error "not_found" "Channel account not configured."))
  (let id (key [account_id team event_id]))
  (mutate owner (fn [state]
    (let account (state/accounts .get account_id))
    (if ($absent? account) (channel_error "not_found" "Channel account not configured."))
    (let digest (key event/content))
    (let previous (state/ingress .get id))
    (if_yes ($present? previous)
      (if (!= previous/digest digest)
        (channel_error "submission_conflict" "Channel event ID has different content."))
      (return previous))
    (state .put "ingress_sequence" (+ (?? state/ingress_sequence 0) 1))
    (let record {^id id ^event_id event_id ^account account_id ^digest digest
      ^sequence state/ingress_sequence ^status "ignored" ^reason (?? event/reason "unsupported_event")
      ^received_at ($os/wall_ms)})
    (let supplied event/message)
    (if_yes ($present? supplied)
      (let route_id (route_key account/transport account_id account/team (?? supplied/channel "")))
      (let decision (authorize_state state route_id (?? supplied/author "") nil))
      (record .put "decision" {^allowed decision/allowed ^owner decision/owner
        ^policy_revision decision/policy_revision ^author decision/author})
      (record .put "status" "denied")
      (record .put "reason" "sender_policy")
      (if_yes decision/allowed
        (let message (normalize_message {^transport account/transport ^account account_id ^team account/team
          ^channel supplied/channel ^thread supplied/thread ^message supplied/message
          ^author supplied/author ^text supplied/text ^received_at record/received_at}))
        (record .put "route" (copy decision/route))
        (record .put "workspace" decision/route/workspace)
        (record .put "payload" (copy (?? event/raw {})))
        (record .put "message" message)
        (record .put "start_allowed" (|| (! decision/route/require_mention) (== event/mentioned true)))
        (record .put "mentioned" (== event/mentioned true))
        (record .put "status" "pending")
        (record .delete "reason")))
    (state/ingress .put id record)
    record) ^changes {^ingress [id]}))

(fn pending_ingress [owner]
  (read owner (fn [state]
    (let pending [])
    (for [id record] in state/ingress
      (if (== record/status "pending") (pending .push record)))
    ($order/sort_by pending /sequence))))

(fn handoff_schedule [owner]
  (read owner (fn [state]
    (let pending [])
    (for [id record] in state/ingress
      (if (!= record/status "pending") (continue))
      (if (<= (?? record/next_handoff_at 0) ($os/wall_ms))
        (pending .push record)
        # A small ordering barrier keeps later replies behind a deferred
        # handoff without copying its payload on every transport tick.
        (pending .push {^sequence record/sequence ^^deferred
          ^message {^transport record/message/transport ^account record/message/account
            ^team record/message/team ^channel record/message/channel
            ^thread record/message/thread ^message record/message/message}})))
    ($order/sort_by pending /sequence))))

(fn defer_handoff [owner, id : Str, code : Str]
  (mutate owner (fn [state]
    (let record (state/ingress .get id))
    (if (!= record/status "pending") (return nil))
    (let delay ($math/min 30000 (* 2 (?? record/handoff_delay 500))))
    (let next (+ ($os/wall_ms) delay))
    (record .put "handoff_delay" delay)
    (record .put "handoff_attempts" (+ (?? record/handoff_attempts 0) 1))
    (record .put "handoff_error" code)
    (record .put "next_handoff_at" (if (== code "waiting_root")
      ($math/min next (+ record/message/received_at 300000)) next))
    nil) ^changes {^ingress [id]}))

(fn root_waiters [state, thread : Str]
  (let ids [])
  (for [id record] in state/ingress
    (if (&& (== record/status "pending") (== record/handoff_error "waiting_root")
            (== (binding_key record/message) thread))
      (ids .push ($to_str id))))
  ids)

# Wake only this thread's waiting replies. A deferred reply never delays a root,
# and observing even an ignored root lets the workspace dispose of it promptly.
(fn wake_root_waiters [owner, message]
  (let thread (binding_key message))
  (mutate owner (fn [state]
    (for id in (root_waiters state thread)
      (let record (state/ingress .get id))
      (record .put "next_handoff_at" 0)
      (record .put "handoff_delay" 500)
      (record .put "handoff_error" nil))
    nil) ^changes (fn [state] {^ingress (root_waiters state thread)})))

(fn finish_handoff [owner, id : Str, result]
  (mutate owner (fn [state]
    (let record (state/ingress .get id))
    (if ($absent? record) (channel_error "not_found" "Ingress delivery not found."))
    (if (== record/status "handed_off") (return record))
    (if (!= record/status "pending")
      (channel_error "conflict" "This ingress record is not awaiting handoff."))
    (if (|| (!= ($head result) Map) (! (["queued" "claimed" "consumed" "denied" "ignored" "deleted" "control"] .contains? result/status)))
      (channel_error "invalid_request" "Workspace did not return a durable channel disposition."))
    (record .put "status" "handed_off")
    (record .put "result" {^status result/status ^id (?? result/id nil)
      ^session (?? result/session nil) ^reason (?? result/reason nil)})
    # The logical message and routing decision have reached the workspace.
    # Keep dedup evidence, not a second permanent copy of its transcript.
    (record .delete "payload") (record .delete "message") (record .delete "decision")
    (record .delete "route")
    (record .delete "next_handoff_at") (record .delete "handoff_delay") (record .delete "handoff_error")
    (record .put "finished_at" ($os/wall_ms))
    record) ^changes {^ingress [id]}))
