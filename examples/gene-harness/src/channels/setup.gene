# Owner setup: the transport verifies credentials and destinations; the host
# records the resulting account and route. data/transport names the
# `channel_transports` row; it may be omitted while only one is installed.
(mod channel_setup)
(import [configure_account configure_route snapshot route_key] ^from "./authority")
(import [channel_error transport_name] ^from "./model")
(import [transport_row transport_call transport_rows] ^from "./transports")
(import [ensure_channel_initiator] ^from "./initiators")
(import [bind_workspace] ^from "./service")

(fn sole_transport [runtime]
  (let rows (transport_rows runtime))
  (if (!= rows/.size 1)
    (channel_error "invalid_request" "Name the channel transport for this account."))
  rows/0/name)

# ^row overrides the installed transport row (probes without a full host).
(fn setup_account [service, data, ^row supplied = nil]
  (let transport (transport_name (if ($present? data/transport) data/transport
    (if ($present? supplied) supplied/name (sole_transport service/runtime)))))
  (let row (if ($present? supplied) supplied (transport_row service/runtime transport)))
  (let verified (transport_call row "verify_account" {^data data}))
  (let identity (verified/identity .assoc "transport" transport))
  (let result (configure_account service/owner data/id identity ^config (?? verified/config {})))
  (if ($present? service/runtime/h) (ensure_channel_initiator service/runtime/h transport))
  (if_not ($absent? verified/channel) (result .put "channel" verified/channel))
  result)

(fn setup_route [service, data, ^row supplied = nil]
  (let owner (snapshot service/owner))
  (let account (owner/accounts .get data/account))
  (if ($absent? account) (channel_error "not_found" "Channel account not configured."))
  (let workspace (try ($fs/real_path data/workspace)
    catch Error (channel_error "not_found" "Create the routed workspace directory first.")))
  (let previous (owner/routes .get (route_key account/transport data/account account/team data/channel)))
  (if ($absent? previous)
    (transport_call (if ($present? supplied) supplied (transport_row service/runtime account/transport))
      "verify_route" {^account account ^channel data/channel}))
  (let route (configure_route service/owner data/account data/channel workspace
    ^approved (?? data/approved previous/approved) ^require_mention (?? data/require_mention (?? previous/require_mention true))
    ^enabled (?? data/enabled (?? previous/enabled true))))
  (if (== workspace service/runtime/root) (bind_workspace service workspace route/id))
  route)
