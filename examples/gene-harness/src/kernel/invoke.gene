# Bounded invocation, independent of registry and composition storage.
(mod kernel_invoke)
(import ExecutionLimits ^from "../plugin_api")
(import HarnessError ^from "../errors")
(import supervised_call ^from "../runtime/call_supervision")

(fn invoke_bounded [callable, argument, limits : ExecutionLimits]
  # A plugin's Fault, a Panic included, becomes a HarnessError that keeps it
  # as the cause.
  (try
    (eval ^in (env ^bindings {^callable callable ^argument argument} ^policy {^max_memory_mb limits/max_memory_mb ^timeout_ms limits/timeout_ms})
      (quote (callable argument)))
  catch Fault
    (let message $err/.message)
    (fail (HarnessError
      ^_msg (if (== ($head $err) Panic) $"plugin panic: ${message}" else message)
      ^_cause $err))))

(fn apply_argument_list [bundle]
  (bundle/callable bundle/args...))

(fn invoke_supervised [callable, args, limits : ExecutionLimits]
  (let outcome (supervised_call callable args limits))
  (match ^!exhaustive outcome
    when (TaskOutcome/ok value)
      value
    when (TaskOutcome/error error)
      (fail error)
    when (TaskOutcome/fault fault) (let message fault/.message)
      # The plugin boundary turns a plugin's defect into a HarnessError and keeps
      # the defect as the cause.
      (fail (HarnessError ^_cause fault
        ^_msg (if (== ($head fault) Panic) $"plugin panic: ${message}" else message)))
    when TaskOutcome/cancelled
      (fail (HarnessError ^_msg "plugin invocation was cancelled or exceeded its deadline"))))

(fn configure_plugin_module [module, limits : ExecutionLimits]
  (var policy
    {^max_memory_mb limits/max_memory_mb ^timeout_ms limits/timeout_ms})
  (var program (quote ($runtime/configure_module module policy)))
  (eval ^in (env ^bindings {^module module ^policy policy} ^imports [$runtime]) program))

(fn execution_limits_data [limits]
  (if ($absent? limits) (return nil))
  {^max_memory_mb limits/max_memory_mb
   ^timeout_ms limits/timeout_ms})
