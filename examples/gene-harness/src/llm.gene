# A model whose only way to act is to emit a Gene program that runs against the
# harness itself.
#
#   OPENROUTER_KEY=$(cat ~/.secrets/openrouter) \
#     gene run --allow_read_dir /tmp src/main.gene chat
#
# The shape is `examples/safe_ai_agent`'s, pointed at a different subject. There
# the evaluated program's world is a workspace directory; here it is the running
# harness — the model gets transaction-aware operations bound to the current
# Harness, never the mutable Harness record itself, so
# "install a plugin", "swap that provider", "subscribe to activations" are
# things it *writes*, not things it selects from a menu.
#
#   prompt -> LLM -> {^status ^response ^code (do ...)} -> eval -> result
#          -> repeat while ^status is "in-progress"
#
# There is no tool list. The previous version had one — the model replied
# `RUN: <command>` and the harness matched it against ten verbs — and the
# ceiling was obvious the moment the model wanted to do something the verbs did
# not name. A harness whose whole thesis is that it can be recomposed at runtime
# should not hand a model a fixed menu of ten recompositions.
#
# What bounds the model is not the menu, then, but the two boundaries that were
# already load-bearing: the Env's capability row for *host* authority, and the
# fact that everything it does to the harness goes through the effect ledger and
# is therefore reversible.

(mod llm)

(import $net/http_client [request])
(import $parse [read_all])
(import $fs [read_text])
(import [Plugin PluginContext PluginHost Harness HarnessError HarnessEvent ToolInvoked
         PluginActivated PluginDeactivated PluginFailed PluginInstalled
         PluginUninstalled
         new_harness install_with_policy uninstall retry resolve
         seam_bound bound_seams registry_row_keys invoke_registry_row
         plugin_states plugin_ids status_of installed
         lifecycle_log log_append log_events assemble_request
         publish render_prompt doc transaction_diff
         module_dir]
  from "./kernel")
(import [ExecutionLimits] from "./plugin_api")
(import_impl PluginHost for PluginContext from "./kernel")
(import [HarnessFs HarnessRender HarnessPrompt HarnessCodegen LocalFs MemFs
         TextRender HtmlRender fs_provider render_provider prompt_provider
         codegen_provider head_tool report_tool] from "./seams")
(import [dispatch bare_query? words words_from word plugin_source] from "./agent")
(import [register_module run_workspace_turn] from "./workspace")

(var endpoint "https://openrouter.ai/api/v1/chat/completions")
(var default_model "deepseek/deepseek-v4-flash-0731")
(var turn_limit 8)

(fn model_name [] : Str
  # `$os/get_env` *raises* when the variable is unset; `$os/env?` is the
  # optional read. Using the first here put the whole agent plugin into `error`
  # at boot, with the reason in the lifecycle log — §3.3.5 working on a real
  # mistake rather than a hypothetical one.
  (var configured ($os/env? "OPENROUTER_MODEL"))
  (if (== configured nil) default_model ($to_str configured)))

# ---------------------------------------------------------------------------
# What the generated program may reach
# ---------------------------------------------------------------------------

# --- the shapes Gene's path syntax cannot express ---------------------------
#
# `xs/~size` and `xs/%i` work only on a *named binding*, so there is no way to
# write the size of an expression: `((c ~ get) ~size)` is a syntax error and a
# model reaches for it constantly, because binding first is the one thing it
# forgets under pressure. These four are the shapes it kept needing, and they
# are ordinary functions rather than a tool layer — the model can still do
# anything, it just no longer has to route a list operation through a temporary.

(fn size [xs] : Int xs/~size)

(fn at [xs, i : Int] xs/%i)

(fn drop_first [xs, n : Int] : Any
  (var out [])
  (var i n)
  (while (< i xs/~size)
    (out ~ push xs/%i)
    (set i (+ i 1)))
  out)

(fn without [xs, v] : Any
  (var out [])
  (for x in xs (if_not (== x v) (out ~ push x)))
  out)

(fn harness_bindings [h : Harness, queued] : Any
  # The model gets the complete structural operation vocabulary, bound to this
  # Harness, but never the public Harness record itself. Every mutation must
  # therefore pass through the ledger/transaction-aware functions below.
  #
  # `queued` is the current turn's registration queue: `^register_module`
  # appends to it and `run_program` owns it, drains it at the turn boundary and
  # never reuses it. It is a parameter rather than a private cell because the
  # vocabulary outlives no turn — a caller that only wants to read the bindings
  # (a test asking what a program may reach) passes a list it then ignores.
  {
   # lifecycle
   ^install (fn [plugin] (install_with_policy h plugin []))
   ^uninstall (fn [id] (uninstall h id))
   ^retry (fn [id] (retry h id))
   ^register_module
     (fn [id, source,
          ^scope scope : Str = "session",
          ^selectors selectors = nil,
          ^limits limits = nil,
          ^dependencies dependencies = nil,
          ^by by : Str = "",
          ^model model : Str = "",
          ^at at_value : Str = "",
          ^replace replace_value : Bool = false]
       # Registration writes a blob, loads the module and runs its `init`, all
       # of which need host authority the program does not have — and grants
       # only attenuate, so calling through from in here could never do
       # anything but refuse. It did, four times in one recorded session, with
       # "fs/exists? needs fs/ReadDir" and a burnt turn each time. So this
       # validates what it can cheaply and queues the rest for `run_program`,
       # which is outside the sandbox and still inside the turn.
       (if_not (== ($head id) Str)
         (fail (HarnessError
           ^message "register_module id must be a string")))
       (if_yes (== ($to_str id) "")
         (fail (HarnessError ^message "register_module id is empty")))
       (if_not (== ($head source) (quote mod))
         (fail (HarnessError
           ^message $"register_module source for ${id} must be a quoted mod node")))
       (queued ~ push
         {^id ($to_str id) ^source source ^scope scope ^selectors selectors
          ^limits limits ^dependencies dependencies ^by by ^model model
          ^at at_value ^replace replace_value})
       $"queued ${id}; the harness registers it when this turn ends")
   # seams and registries. Mutations happen through a PluginContext acquired by
   # `install`; registry reads return keys, not mutable row payloads.
   ^resolve (fn [seam] (resolve h seam))
   ^seam_bound (fn [seam] (seam_bound h seam))
   ^row_keys (fn [registry_name] (registry_row_keys h registry_name))
   ^invoke_registry
     (fn [registry_name, key, args]
       (invoke_registry_row h registry_name key args))
   # inspection
   ^bound_seams (fn [] (bound_seams h))
   ^plugin_states (fn [] (plugin_states h))
   ^plugin_ids (fn [] (plugin_ids h))
   ^status_of (fn [id] (status_of h id))
   ^installed (fn [] (installed h))
   ^transaction_diff (fn [] (transaction_diff h))
   ^lifecycle_log (fn [] (lifecycle_log h))
   ^doc (fn [name] (doc h name))
   # the session log, and the §3.6 invariant
   ^record_message (fn [text] (log_append h "message" text))
   ^assemble_request assemble_request
   # observation
   ^publish (fn [event] (publish h event))
   # types a program needs to construct things
   ^Plugin Plugin ^HarnessError HarnessError
   ^HarnessEvent HarnessEvent ^ToolInvoked ToolInvoked
   ^PluginActivated PluginActivated ^PluginDeactivated PluginDeactivated
   ^PluginFailed PluginFailed ^PluginInstalled PluginInstalled
   ^PluginUninstalled PluginUninstalled
   # the seams, their providers, and their consumers
   ^HarnessFs HarnessFs ^HarnessRender HarnessRender ^HarnessPrompt HarnessPrompt
   ^LocalFs LocalFs ^MemFs MemFs ^TextRender TextRender ^HtmlRender HtmlRender
   ^fs_provider fs_provider ^render_provider render_provider
   ^prompt_provider prompt_provider
   ^head_tool head_tool ^report_tool report_tool
   # growing code that did not exist at boot. `plugin_source` returns an inert
   # quoted module node; `register_module` validates, content-addresses and
   # commits it before activation.
   ^plugin_source plugin_source
   # list shapes the path syntax cannot express on an expression
   ^size size ^at at ^drop_first drop_first ^without without
   # the offline interpreter, still available as one call
   ^dispatch (fn [prompt] (dispatch h prompt))})

(fn run_program [h : Harness, program] : Str
  # One `(do ...)` block, evaluated as written. The shape the model emits is the
  # shape that runs, so a program may define something and then use it.
  #
  # `^capabilities` is the *host* authority row and it is resolved against this
  # module's context when the Env is minted, so it can never name more than the
  # harness already holds. Here that row is empty, so the program has no host
  # authority whatsoever. Structural authority over the harness is total —
  # every binding above is an ordinary Gene call needing no grant — while host
  # authority stays with the harness. That split is the point: the model may
  # rebuild the harness and still not read your home directory. The one
  # operation that needs both is `register_module`, and the queue below is how
  # it gets them without the sandbox ever holding a grant.
  (var queued ($thaw #[]))
  (var sandbox
    (env ^bindings (harness_bindings h queued)
         ^capabilities []))
  (var existing_events (log_events h))
  (var turn_id $"model-${(+ existing_events/~size 1)}")
  (var outcome
    (run_workspace_turn h/workspace h turn_id
      (fn [ignored]
        (var rendered
          (try
            $"${(eval program ^in sandbox)}"
          catch MissingCapability
            # A denial is a value shown to the next model round.
            $"refused: ${$ex/operation} needs ${$ex/capability}"
          catch Any
            (if ($str/contains? $ex/message " requires ")
              $"refused: ${$ex/message}"
              (fail $ex))))
        # Drained here and not in the sandbox: this callback runs under the
        # caller's capability context (`invoke_bounded ^inherit true`), which
        # is the only point in the round that still holds the authority a
        # registration needs. A failure raises like any other error in the
        # body, so a module that will not load never becomes a revision.
        (for request in queued
          # A program that queued a module rarely names its own author, and the
          # harness knows what the caller does not have to say: this turn came
          # from a model reply. Stamping the blanks is the difference between a
          # durable entry that says who wrote it and one that says nothing —
          # the same gap `build` had before it started asking its provider.
          (var by (if (== request/by "") "program/model" request/by))
          (var model (if (== request/model "") (model_name) request/model))
          (var at (if (== request/at "") ($to_str (gene/now)) request/at))
          (var registered
            (register_module h/workspace h request/id request/source
              ^scope request/scope ^selectors request/selectors
              ^limits request/limits ^dependencies request/dependencies
              ^by by ^model model ^at at
              ^replace request/replace))
          # The program cannot observe its own registration — it committed
          # after the program returned — so the result has to say it happened.
          (set rendered
            $"${rendered}\nregistered ${request/id} at revision ${registered/revision}"))
        rendered)
      # `default_execution_limits` is 2 000 ms, which suits a local callback
      # and not a body that may hash a module, write a blob, load it and run
      # its `init`. Steps and memory stay where they are — those guard against
      # code that runs away, and neither is loosened by admitting that writing
      # to disk takes time. Same trade `profiles/chat.gene` makes for a
      # command that waits on a model.
      ^limits (ExecutionLimits ^max_steps 100000 ^max_memory_mb 64
                               ^timeout_ms 30000)))
  (if (== outcome/status "aborted")
    $"error: ${outcome/error/message}"
    ($to_str outcome/result)))

# ---------------------------------------------------------------------------
# Talking to the model
# ---------------------------------------------------------------------------

(fn harness_primer [h : Harness] : Str
  # Plugin-authored prompt sections and pull introspection share the same rows;
  # there is no second hand-maintained command/tool inventory here.
  (render_prompt h))

(fn repository_root [] : Str
  (module_dir (module_dir (module_dir (module_dir this_mod/~path)))))

(fn gene_skill_file [relative : Str] : Str
  (read_text $"${(repository_root)}/tools/gene-lang-skill/${relative}"))

(fn system_prompt [h : Harness] : Str
  # The format instruction leads *and* closes the prompt, with a filled-in
  # example between them. Stating it once in the middle was not enough: the
  # model replied with a sentence followed by a bare `(do ...)`, which is not
  # readable as an envelope, and the turn was lost. A worked example is what
  # moved it.
  $"""Your entire reply is ONE Gene map. No prose outside it, no markdown fence,
no explanation before or after. It looks exactly like this:

{^status "done"
 ^response "Nine plugins are installed."
 ^code (do (plugin_states))}

Three props, always all three:
  ^status    "done" if this reply finishes the task, "in-progress" if you need
             to see the result before deciding what to do next
  ^response  one short sentence: what you are doing, or your answer
  ^code      ONE (do ...) block — the program to run. Use (do nil) if the task
             needs no action.

**A reply that runs code is never the last one.** You write ^status before your
program has run, so you cannot know yet whether it worked — and the harness
ignores "done" on any reply whose ^code does something. You will be shown the
result and asked again. That next reply is where you finish: give your answer in
^response with ^code (do nil) and ^status "done", or run more code if the result
was not what you needed.

So a normal task is two replies. First: ^status "in-progress", ^code that does
the work. Then, having seen the output: ^status "done", ^code (do nil), and the
answer in ^response.

If a program fails, fix it — do not resend the same call and never report
success over an error. "undefined symbol: x" means x does not exist in Gene;
find the real name in the rules below instead of inventing another one.

You are the agent inside a Gene plugin harness, and ^code runs against it live.

${(harness_primer h)}

Your program has no host authority at all: reading a file or the environment is
refused, and you will see the refusal as a value. Changing the harness itself
needs no authority — that is what you are for. register_module is the one
operation the harness performs for you: it queues the module, and the harness
commits and activates it after your program returns. So a tool you register is
callable from your NEXT program, never the one that registered it, and the
result you are shown names the revision it landed at.

Remember: reply with the map and nothing else. Start your reply with {^status
and end it with }.""")

(fn api_key [] : Any
  # Both spellings, because both are in use: OPENROUTER_API_KEY is what the
  # service's own docs call it, OPENROUTER_KEY is what this example started
  # with. Reading one and failing on the other is a bad first five minutes.
  (var primary ($os/env? "OPENROUTER_API_KEY"))
  (if (== primary nil) ($os/env? "OPENROUTER_KEY") primary))

(fn chat_completion [system : Str, user : Str,
                     ^max_tokens max_tokens : Int = 3000] : Str
  # One HTTP path for every kind of request this harness makes of a model.
  # `call_model` answers a prompt; `model_plugin_source` writes a plugin. They
  # differ only in what they put in the two messages, which is the whole reason
  # a second use did not need a second client.
  (var key (api_key))
  (if_yes (== key nil)
    (fail (HarnessError
      ^message "no API key — set OPENROUTER_API_KEY (or OPENROUTER_KEY)")))
  (var body ($json/stringify
    {^model (model_name)
     ^messages [{^role "system" ^content system}
                {^role "user" ^content user}]
     ^max_tokens max_tokens
     # This model reasons by default and will spend the whole budget thinking
     # before emitting a token of content — measured: at max_tokens 60 it
     # returned the three characters "har".
     ^reasoning {^enabled false}}))
  (var resp
    (await (request ^method "POST" ^url endpoint
                    ^headers {^content-type "application/json"
                              ^authorization $"Bearer ${key}"}
                    ^body body ^timeout_ms 90000 ^max_bytes 2000000)))
  # A non-2xx status is ordinary response data for this client, not a failed
  # task, so it has to be checked rather than caught.
  (if_yes (!= resp/status 200)
    (fail (HarnessError ^message $"openrouter ${resp/status}: ${resp/body}")))
  (var parsed ($json/parse resp/body))
  (var text parsed/choices/0/message/content)
  (if (== text nil) "" ($str/trim ($to_str text))))

(fn call_model [h : Harness, prompt : Str, history : Str] : Str
  (chat_completion (system_prompt h)
    $"${prompt}\n\nPrior turns:\n${history}"))

(fn strip_fence [reply : Str] : Str
  # Models wrap code in ``` even when told not to. The envelope is Gene data, so
  # a fence makes the whole reply unreadable; dropping the fence lines is
  # cheaper than arguing with the prompt.
  (var out [])
  (for line in ($str/split reply "\n")
    (if_not ($str/starts_with? ($str/trim line) "```")
      (out ~ push line)))
  ($str/join out "\n"))

(fn from_first_brace [reply : Str] : Str
  # A model that prefixes a sentence still emitted a readable map after it.
  # Starting at the first `{` recovers the turn instead of losing it, and costs
  # nothing when the reply was already clean.
  (var parts ($str/split reply "{"))
  (if (< parts/~size 2)
    (then reply)
    (else
      (var tail [])
      (var i 1)
      (while (< i parts/~size)
        (tail ~ push parts/%i)
        (set i (+ i 1)))
      ($str/join ["{" ($str/join tail "{")] ""))))

(fn read_first_form [text : Str] : Any
  (try
    ((read_all text) ~ next)
    catch Any
    nil))

(fn parse_envelope [reply : Str] : Any
  # `read_all` yields a stream of the forms in the reply; the envelope is the
  # first. Try the reply as sent, then from its first brace; a model that
  # answers in prose alone yields nil either way.
  (var clean (strip_fence reply))
  (var direct (read_first_form clean))
  (if (!= direct nil) direct (read_first_form (from_first_brace clean))))

# ---------------------------------------------------------------------------
# One task, however many turns it takes
# ---------------------------------------------------------------------------

(fn tail_preview [text : Str] : Str
  # The *end* of the reply, because that is where a truncated or unbalanced
  # module goes wrong. The opening lines of a module are always the same two
  # imports and tell you nothing.
  (var size ($str/byte_size text))
  (if (> size 300)
    ($str/join ["... " ($str/slice_bytes text (- size 300) size)] "")
    text))

(fn preview [text : Str] : Str
  (if (> ($str/byte_size text) 400)
    ($str/join [($str/slice_bytes text 0 400) " ..."] "")
    text))

(fn failed? [result : Str] : Bool
  # `run_program` renders an ordinary mistake as "error: ..." and a capability
  # denial as "refused: ...". Only the first is the model's to fix: an error is
  # a bug in the code it just wrote, while a refusal is a fact about authority
  # that writing different code will not change. So errors force another turn
  # and refusals leave the decision to the model.
  ($str/starts_with? result "error:"))

(fn emit_output [h : Harness, text : Str]
  (log_append h "output" text))

(fn no_op? [code] : Bool
  # A program that does nothing has nothing worth showing. The model emits
  # `(do nil)` when a turn is pure answer — printing the code and a result of
  # `nil` under it is three lines saying "no".
  (var text ($str/trim ($to_str code)))
  (|| (== text "(do nil)") (== text "(do)")))

(fn run_task [h : Harness, prompt : Str, session, state_host] : Str
  # Prints each turn as it happens rather than returning one block at the end:
  # a task may take several model round trips, and a shell that goes silent for
  # thirty seconds looks hung. The value returned is the last thing said, which
  # is what the driver prints.
  # Earlier exchanges first, then this task's own turns accumulate after them.
  (var history ($cell (remembered session)))
  (var turn ($cell 0))
  (var running ($cell true))
  (var last ($cell ""))
  (while (running ~ get)
    (turn ~ set (+ (turn ~ get) 1))
    # Turn one needs no marker — the `Gene>` label above it is the marker. Every
    # turn after it is the agent going round again without being asked, which is
    # the thing a reader wants delimited.
    (if_yes (> (turn ~ get) 1)
      (emit_output h $"== Round $(turn ~ get) =="))
    (var raw (call_model h prompt (history ~ get)))
    (var envelope (parse_envelope raw))
    (if (== envelope nil)
      (then
        # An unreadable reply is a mistake the model can fix, and it is the one
        # mistake it cannot see: the harness is the only party that knows the
        # text did not read as Gene. Ending the task here wasted a turn that
        # the loop already exists to spend, so tell it what happened and let it
        # try again. Say what arrived, too — "the model did not return Gene
        # data" with nothing attached is the least useful thing this loop can
        # print, because the fix is always in the reply.
        (emit_output h "(reply was not readable Gene data; asking again)")
        (last ~ set $"the model did not return Gene data. It said:\n  $(preview raw)")
        (var prior (history ~ get))
        (history ~ set $"${prior}\nYOUR LAST REPLY WAS DISCARDED. It did not read as Gene data.\nIt began: $(preview raw)\nReply with ONLY the map: {^status ... ^response ... ^code (do ...)}. No prose, no fence.\nRemember: there is no def, defn, let, let*, and, or, str, int, first, rest, nth, count.\nOnly (var x v), (fn [a] ...), (&& a b), ($str/join xs s), xs/~size on a named binding.")
        (if_yes (>= (turn ~ get) turn_limit)
          (running ~ set false)))
      (else
        (var response envelope/response)
        (if_yes (!= response nil)
          (emit_output h ($to_str response)))
        # The program is shown before it runs. `^response` is a claim composed
        # before the model could know the outcome; printing the code next to it
        # lets a reader check the claim against what actually executes.
        (var ran_code (== (no_op? envelope/code) false))
        (var result
          (if ran_code
            (then
              (emit_output h ($to_str envelope/code))
              (var value (run_program h envelope/code))
              (emit_output h "-- Result  --")
              (emit_output h value)
              value)
            (else "(no action)")))
        (last ~ set result)
        # The whole reply goes back, not just the result: the model needs to see
        # the code it wrote next to what that code did, or it cannot tell which
        # form drew which complaint.
        (var prior (history ~ get))
        (history ~ set $"${prior}\nreply: ${envelope}\noutput: ${result}")
        # **A reply that ran code is never done.** `^status` and `^code` arrive
        # in the same message, so the model wrote "done" before its program had
        # produced anything — the claim is about intent, not outcome. Believing
        # it is how a task ends with a broken program and a confident sentence
        # above it, which is precisely what happened before this rule existed.
        #
        # So the harness decides, not the model: running code always earns
        # another round, and only a reply that *acted on* a result — one whose
        # own code is `(do nil)` — may finish. The cost is one extra round per
        # task; what it buys is that no answer is ever given by something that
        # has not seen what it did.
        (if_yes ran_code
          (history ~ set $"$(history ~ get)\nYou ran code, so the task is NOT finished and any \"done\" in that reply was ignored.\nThe output above is what your program actually returned - you are seeing it now for\nthe first time. Decide from it: if it answers the task, reply with ^status \"done\",\nyour answer in ^response, and ^code (do nil). If it does not, run more code."))
        (if_yes (failed? result)
          (history ~ set $"$(history ~ get)\nThat program FAILED. The mistake is in the code you just sent - find it and emit a\ncorrected program. Do not send the same call again, and do not report success.\n\"undefined symbol: x\" means x does not exist in Gene; use a real name from the\nrules rather than inventing another one."))
        (if_yes (&& (== ran_code false) (!= envelope/status "in-progress"))
          (running ~ set false))
        (if_yes (&& (running ~ get) (>= (turn ~ get) turn_limit))
          (emit_output h
            $"(gave up after ${turn_limit} rounds; the last program still fails)")
          (running ~ set false)))))
  # Everything has been printed as it happened, so there is nothing left for
  # the driver to echo. Remembering happens here rather than in `answer`
  # because this is where the real last result is known.
  (remember session state_host prompt (last ~ get))
  "")

(fn strip_slash [prompt : Str] : Str
  # Drop one leading `/` and keep every other one: `/read a/b` is `read a/b`,
  # because a path argument has slashes and they are not the prefix.
  (var parts ($str/split prompt "/"))
  (var out [])
  (var i 1)
  (while (< i parts/~size)
    (out ~ push parts/%i)
    (set i (+ i 1)))
  ($str/trim ($str/join out "/")))

(fn answer [h : Harness, prompt : Str, session, state_host] : Str
  # Two ways to reach the offline interpreter without a round trip, and both
  # have to be unambiguous — the shell should not get slower or need a network
  # for the things typed most, but it also must not mistake a sentence for a
  # command. `/` is explicit; a bare one-word query cannot be anything else.
  #
  # The rule this replaced was "if the first word names a command, run it", and
  # it read `build me a plugin called greeter` as a request for a tool named
  # `me`. A prefix of a sentence is not a command.
  (if ($str/starts_with? prompt "/")
    (then (dispatch h (strip_slash prompt)))
    (elif (bare_query? h prompt) (dispatch h prompt))
    (else (run_task h prompt session state_host))))

# ---------------------------------------------------------------------------
# Session memory
# ---------------------------------------------------------------------------
#
# `safe_ai_agent` discards history when a task finishes, which is right for a
# task runner and wrong for a shell: the second thing anyone types is "now
# remove it". Without a carry-over the model guessed a plugin name out of the
# system prompt's example and uninstalled something that was never there.
#
# So a bounded window of completed exchanges rides along, separate from the
# within-task history that already accumulates per turn. Bounded because a
# session is open-ended — this is the one place in the harness where unbounded
# growth would be invisible until a context limit turned into a 400.

(var session_window 4)

(fn remembered [session] : Str
  (var lines (session ~ get))
  ($str/join lines "\n"))

(fn remember [session, state_host, prompt : Str, result : Str]
  (var lines (session ~ get))
  (lines ~ push $"you: ${prompt}\nharness: $(preview result)")
  (var kept [])
  (var start (- lines/~size session_window))
  (var i (if (< start 0) 0 start))
  (while (< i lines/~size)
    (kept ~ push lines/%i)
    (set i (+ i 1)))
  (session ~ set kept)
  (state_host ~ PluginHost:update_state {^history kept}))

# ---------------------------------------------------------------------------
# The model as the author of a plugin
# ---------------------------------------------------------------------------
#
# `build <name> <what it should do>` used to fill a template, so the harness
# could install code at runtime but only ever *that* code — the dummy tool that
# echoes its own description back. Behind the `HarnessCodegen` seam the same
# command asks a model to write the module instead, and nothing else about
# `build` changes: `build_tool` still resolves a seam, still hands the result
# to `register_module`, and still cannot tell which provider answered.
#
# The safety argument is unchanged too, and it is the reason this is allowed to
# be a model at all. The reply is *text*, parsed into an inert quoted node and
# never evaluated as text. Everything that decides whether it is a legal module
# already existed for the template: `canonical_module_source` requires a
# `(mod plugin ...)` root, an inert top level, a defined `init`, and imports
# inside the declared closure; `describe_plugin_module` runs that `init` under
# `^capabilities []` and the step/time/memory ceiling; the loader pins an
# immutable policy to the sandbox module. A model that writes something hostile
# is refused by the same code that refuses a typo.

(fn from_first_mod [reply : Str] : Str
  # `from_first_brace`'s argument, for a module: a model that prefixes a
  # sentence still emitted a readable module after it, and starting at the
  # first `(mod ` recovers the build instead of losing it. Trailing prose costs
  # nothing — `read_all` yields the forms in order and only the first is taken.
  (var parts ($str/split reply "(mod "))
  (if (< parts/~size 2)
    (then reply)
    (else ($str/join ["(mod " ($str/join (drop_first parts 1) "(mod ")] ""))))

(fn codegen_skill_text [] : Str
  # The same checked-in skill the agent plugin pushes and pulls from, and an
  # author needs it more than a dispatcher does. The module contract in the
  # prompt is what the *loader* checks; this is what makes the body between the
  # parens actually run when someone invokes the tool.
  ($str/join [(gene_skill_file "SKILL.md")
              (gene_skill_file "reference/pitfalls.md")
              (gene_skill_file "reference/stdlib.md")]
    "\n\n"))

(fn plugin_module_contract [] : Str
  # The skeleton and the loader's rules, shared by the two paths that produce a
  # module: `build`'s codegen provider writes one from scratch, and a model
  # program queues one through `register_module`. Only the first had a copy, so
  # the program path produced modules with the imports missing and `init`
  # mis-typed — the harness advertised a durable path and withheld the one page
  # needed to use it. Held as data rather than duplicated prose so the two
  # cannot drift.
  #
  # A plain triple-quoted string, not a `$"""` one: it is full of `${...}`,
  # `$(...)` and `$str/...` sequences that an interpolated literal would try to
  # evaluate. Nothing here is computed, so nothing here should be.
  """It looks exactly like this. Copy the shape; change the name, the doc and
the body of `run`:

(mod plugin
  (import [Plugin DescriptorContext PluginContext PluginHost]
    from "../../../src/plugin_api")
  (import_impl PluginHost for PluginContext from "../../../src/kernel")

  (fn run [arg : Str] : Str
    ($str/join ["you said: " arg] ""))

  (fn init [ctx : DescriptorContext] : Plugin
    ^capabilities []
    (Plugin
      ^id "echo"
      ^provides [["tools" "echo"]]
      ^requires []
      ^contextual true
      ^activate
        (fn []
          (fn [host]
            (host ~ PluginHost:contribute "tools"
              {^name "echo" ^doc "repeat the argument" ^run run}))))))

The loader rejects a module that breaks any of these:
  - the root form is `(mod plugin ...)` — never another module name
  - the top level holds only `import`, `import_impl`, `fn`, `type`, `impl`,
    `protocol`, `alias`, `enum`; no top-level expressions of any kind
  - `init` is defined, takes one `DescriptorContext`, and carries
    `^capabilities []`
  - the two import lines are copied *exactly*, character for character:
        (import [Plugin DescriptorContext PluginContext PluginHost]
          from "../../../src/plugin_api")
        (import_impl PluginHost for PluginContext from "../../../src/kernel")
    "../../../plugin_api" without `src/` is the mistake to avoid, and no other
    import of any kind is permitted. Omitting them is what makes `Plugin` and
    `DescriptorContext` unknown type annotations.
  - `^contextual true`, and `^activate` is a thunk returning `(fn [host] ...)`

`run` takes one Str and returns a Str. It holds no capabilities at all — no
filesystem, no network, no clock, no environment, no randomness. Computation on
its argument and on literals is the whole of what it can do. If the request
cannot be met that way, write the closest pure-text version of it rather than
reaching for authority you do not have.
""")

(fn codegen_system_prompt [skill : Str] : Str
  ($str/join [
  """Your entire reply is ONE Gene module and nothing else: no prose, no
markdown fence, no explanation before or after it.

"""
  (plugin_module_contract)
  """
Gene is not the Lisp you are thinking of, and the reference below is
authoritative — read it before you write the body of `run`. The ones that have
actually cost a build here:
  - stdlib names carry a `$`: ($str/join [a b] ""), ($to_str n), ($println x).
    A bare `str`, `join`, `filter` or `println` is an undefined symbol.
  - `map` and `filter` are *stream* operations, not list ones. On a list, loop:
    (var out []) (for x in xs (if_yes (test x) (out ~ push x))) — or count with
    a (var n 0) and (set n (+ n 1)).
  - there is no `let`. (var x expr) declares, (set x expr) assigns, and both are
    statements in the enclosing body.
  - length is xs/~size on a *named binding*; ($str/byte_size s) for a string.
    You cannot write the size of an expression, so bind it first.
  - index with a *literal* as xs/0 and with a *variable* as xs/%i. Writing
    xs/i where i is a variable is a property lookup that quietly yields void,
    and you find out several lines later when something else rejects it.
  - ($str/split s sep) needs a non-empty sep; splitting on "" to reach the
    characters of a string is an error, not a trick.
  - ($str/join xs sep) requires every item of xs to already be a Str. Map
    ($to_str x) over anything else first.
  - $regex has replace, replace_all and split if you need them; $str does not.
  - (if cond a b) takes exactly ONE expression per arm. Two forms in a branch
    need (if cond (then x y) (else z)) — and a `var` declared inside an arm is
    gone after it, so bind above the `if` and (set ...) inside.
  - the $str namespace is exactly: byte_size contains? ends_with? from_utf8
    join lower slice_bytes split starts_with? to_utf8 trim. There is no
    `upper`, no `replace`, no `pad`, no `index_of`. Never call a function that
    is not there: nothing checks the body of `run` until someone invokes the
    tool, so a guessed name is a plugin that installs cleanly and then fails in
    the user's hands. Build what you need from the list, or make the tool do
    the part you can and say so in its output.

Reply with the module and nothing else, starting at `(mod plugin` and ending at
its closing paren. The two import paths are "../../../src/plugin_api" and
"../../../src/kernel".

# Gene reference

"""
  skill] ""))

(fn codegen_request [name : Str, request : Str] : Str
  $"""Tool name: ${name}
It should: ${request}

Reply with the module for that tool and nothing else.""")

(fn read_module_form [text : Str] : Any
  # `read_first_form` swallows the reader's complaint, which is right for an
  # envelope — a model answering in prose has nothing to report. A module is
  # different: "not readable Gene" on its own leaves you re-running a build to
  # find out whether the reply was truncated, unbalanced, or never code at all.
  (try
    {^form ((read_all text) ~ next) ^problem ""}
  catch Any
    {^form nil ^problem ($to_str $ex/message)}))

(fn model_plugin_source [name : Str, request : Str, skill : Str] : Any
  # Text in, inert node out. Two recoveries, both cheap: drop a markdown fence,
  # and start at the first `(mod ` if the model wrote a sentence first. What is
  # deliberately *not* here is a retry loop — `build` is one turn, and a model
  # that answered with prose should say so in the error rather than quietly
  # cost three more requests.
  (var reply
    (chat_completion (codegen_system_prompt skill) (codegen_request name request)))
  (if_yes (== ($str/trim reply) "")
    (fail (HarnessError ^message $"model returned nothing for ${name}")))
  (var clean (strip_fence reply))
  (var read (read_module_form clean))
  (if_yes (== read/form nil)
    (set read (read_module_form (from_first_mod clean))))
  (var form read/form)
  (if_yes (== form nil)
    (fail (HarnessError
      ^message $"model reply for ${name} is not readable Gene (${read/problem}); the reply ended: $(tail_preview reply)")))
  (if_not (== ($head form) (quote mod))
    (fail (HarnessError
      ^message $"model reply for ${name} is not a module: $(preview reply)")))
  form)

(type ModelCodegen ^props {^model Str ^skill Str})

(impl HarnessCodegen for ModelCodegen
  (message generate [name : Str, request : Str] : Any
    (model_plugin_source name request self/skill))
  (message author [] : Any
    # `self/model` is the model that was configured when this provider was
    # bound, which is the one that answered — not whatever the environment
    # says now.
    {^by "codegen/model" ^model self/model}))

(fn model_codegen_plugin [] : Plugin
  # Same id and same seam as the template provider in agent.gene. A deployment
  # binds one or the other, never both — which is the `fs` provider argument
  # (§3.8) applied to authorship: `chat` and `web` differ in what `build` can
  # write, and in nothing else.
  (Plugin ^id "codegen" ^provides ["HarnessCodegen"]
    ^contextual true
    ^activate (fn [] (fn [host]
      (host ~ PluginHost:provide "HarnessCodegen"
        (codegen_provider
          (ModelCodegen ^model (model_name) ^skill (codegen_skill_text))))))))

(type LlmAgent ^props {^model Str ^session Any ^state_host PluginContext})

(impl HarnessPrompt for LlmAgent
  (message handle [h, prompt : Str] : Str
    (answer h prompt self/session self/state_host)))

(fn llm_prompt_text [] : Str
  # Two call shapes are spelled out because guessing them is the failure that
  # keeps happening. For `register_module`: two recorded sessions passed
  # `^name`/`^source` named arguments and one passed the module as a *string*.
  # For reaching a tool: a session that had just registered one spent five
  # rounds on `(shout ...)`, `(tool ...)`, `(tools)` and `(active)` and never
  # found `invoke_registry`. A row is not a binding, and nothing in the primer
  # said so. The arity error a wrong shape produces names an anonymous
  # binding, so it does not point at the mistake either.
  "register_module takes two positional arguments and queues a durable authored plugin: (register_module \"<id>\" (quote (mod plugin ...)) ^replace true). The source is a quoted module node, never a string, and `id` is a plain word. Pull the module the loader will accept with (doc \"plugin/module\") and copy its shape — a queued module that omits the two imports fails on `Plugin` as an unknown type annotation. The harness commits and activates once your program returns, so the tool is callable from your next program and not the one that queued it. Registry rows are not bindings: list one with (row_keys \"tools\") and call a row with (invoke_registry \"tools\" \"<name>\" [argument]). A program holds no host authority at all. Harness operations are already bound and take no h argument. Entries are content-addressed, capability selectors only attenuate named roots, and code-running replies must observe their result before claiming completion. Pull detailed Gene references with (doc \"gene/pitfalls\"), gene/syntax, gene/declarations, gene/control_flow, or gene/stdlib.")

(fn llm_agent_plugin [] : Plugin
  (Plugin ^id "agent"
    ^provides [["seams" "HarnessPrompt"] ["prompt" "llm_agent"]
               ["prompt" "plugin/module"]
               ["prompt" "gene/language"] ["prompt" "gene/pitfalls"]
               ["prompt" "gene/syntax"] ["prompt" "gene/declarations"]
               ["prompt" "gene/control_flow"] ["prompt" "gene/stdlib"]]
    ^contextual true
    ^activate (fn [] (fn [host]
      (var restored (host ~ PluginHost:state))
      (var history ($thaw (if (== restored nil) #[] (?? restored/history #[]))))
      (host ~ PluginHost:provide "HarnessPrompt"
        (prompt_provider
          (LlmAgent ^model (model_name) ^session ($cell history)
                    ^state_host host)))
      (host ~ PluginHost:contribute "prompt"
        {^name "llm_agent" ^text (llm_prompt_text)})
      # Pull-only: the contract is a page, and only a turn that actually
      # queues a module needs it. `build`'s author gets the same text pushed,
      # because writing the module is the whole of its job.
      (host ~ PluginHost:contribute "prompt"
        {^name "plugin/module" ^text (plugin_module_contract)
         ^pull_only true})
      # The checked-in Gene language skill is the one source for both pushed
      # guidance and pull introspection. References stay out of every request
      # until the model asks for one through `doc`.
      (host ~ PluginHost:contribute "prompt"
        {^name "gene/language" ^text (gene_skill_file "SKILL.md")})
      (host ~ PluginHost:contribute "prompt"
        {^name "gene/pitfalls"
         ^text (gene_skill_file "reference/pitfalls.md") ^pull_only true})
      (host ~ PluginHost:contribute "prompt"
        {^name "gene/syntax"
         ^text (gene_skill_file "reference/syntax.md") ^pull_only true})
      (host ~ PluginHost:contribute "prompt"
        {^name "gene/declarations"
         ^text (gene_skill_file "reference/declarations.md") ^pull_only true})
      (host ~ PluginHost:contribute "prompt"
        {^name "gene/control_flow"
         ^text (gene_skill_file "reference/control-flow.md") ^pull_only true})
      (host ~ PluginHost:contribute "prompt"
        {^name "gene/stdlib"
         ^text (gene_skill_file "reference/stdlib.md") ^pull_only true})))))
