# The host's feature registry catalog. The kernel interprets these specs using
# the same machinery available to a plugin-defined extension point.
(mod builtin_registry_specs)
(import [HarnessError] ^from "../errors")
(import [validate_keyboard_action_row validate_setting_row validate_settings_group_row validate_setting_choices_row validate_seam_row validate_command_row validate_function_row validate_input_mode_row
  validate_provider_row validate_speech_row validate_decision_engine_row validate_image_generator_row validate_hook_row
  validate_hook_point_row validate_interaction_row
  validate_feature_slot_row validate_service_row validate_http_route_row validate_channel_transport_row
  validate_prompt_row validate_docs_row validate_event_type_row validate_event_type_owner
  cancel_subscription_row] ^from "./contracts")
(import [validate_theme validate_icon] ^from "../web/theme_registry")
(import [validate_web_component] ^from "../ui/components")
(import [validate_browser_client] ^from "../ui/browser_assets")
(import [own_engine_resources] ^from "./resources")
(import [prepare_command_callback prepare_prompt_callback] ^from "../runtime/callback_context")
(import [api_root] ^from "../web/contract")

(fn ^^private route_prefix [owner : Str, candidate]
  (if (== candidate/kind "owner")
    $"${(api_root)}/p/${owner}${candidate/path}"
    $"/callback/${owner}${candidate/path}"))

(fn builtin_registry_specs [h, lookup]
  (let discovery_reserved {^discover "" ^doc "" ^workspace "" ^manager "" ^session ""})
  (let host_functions_reserved (discovery_reserved .assoc "set_appearance" "core"))
  [
    {^name "seams" ^^unique ^schema validate_seam_row ^callbacks ["value"]}
    {^name "commands" ^^unique ^schema validate_command_row ^callbacks ["run"]
     ^prepare (fn [owner, candidate] (prepare_command_callback h owner candidate))
     ^reserved {^sh "shell" ^repl "repl" ^help "core_commands" ^run "core_commands"
                 ^view "core_commands" ^cancel "core" ^stop "core" ^restart "core" ^theme "core"}}
    {^name "input_modes" ^^unique ^schema validate_input_mode_row ^callbacks ["classify" "run" "close"]
     ^prepare (fn [owner, candidate] (prepare_command_callback h owner candidate))}
    {^name "functions" ^^unique ^schema validate_function_row ^callbacks ["fn"]
     ^signature "fn" ^reserved host_functions_reserved}
    {^name "ui_actions" ^^unique ^schema validate_function_row ^callbacks ["fn"]
     ^signature "fn" ^reserved discovery_reserved}
    {^name "ui_links" ^^unique ^schema validate_function_row ^callbacks ["fn"]
     ^signature "fn" ^reserved discovery_reserved}
    {^name "providers" ^^unique ^schema validate_provider_row
     ^callbacks ["connection" "models" "configure" "capabilities" "prepare" "send"]}
    {^name "image_generators" ^^unique ^schema validate_image_generator_row
     ^callbacks ["available" "configure" "capabilities" "prepare" "send"]}
    {^name "speech_recognizers" ^^unique
     ^schema (fn [candidate] (validate_speech_row candidate "recognizer"))
     ^prepare (fn [owner, candidate] (own_engine_resources h owner candidate))
     ^callbacks ["available" "open" "transcribe" "stream"]}
    {^name "speech_synthesizers" ^^unique
     ^schema (fn [candidate] (validate_speech_row candidate "synthesizer"))
     ^prepare (fn [owner, candidate] (own_engine_resources h owner candidate))
     ^callbacks ["available" "open" "synthesize"]}
    {^name "decision_engines" ^^unique ^schema validate_decision_engine_row
     ^prepare (fn [owner, candidate] (own_engine_resources h owner candidate))
     ^callbacks ["available" "open" "decide" "limits"]}
    {^name "hook_points" ^^unique ^schema validate_hook_point_row}
    {^name "hooks" ^^unique ^^ordered ^callbacks ["run"]
     ^key (fn [candidate] $"${candidate/point}/${candidate/name}")
     ^schema (fn [candidate]
       (validate_hook_row candidate)
       (if ($absent? (lookup "hook_points" candidate/point))
         (fail (HarnessError ^message $"hook point ${candidate/point} is not available")))
       candidate)}
    # Not unique: several plugins may claim a slot. The holder is resolved from
    # the published rows (runtime/activation_services.gene), never by order.
    {^name "feature_slots" ^!unique ^schema validate_feature_slot_row}
    {^name "services" ^^unique ^schema validate_service_row}
    # Default UI settings for a workspace with no saved UI state; a profile's
    # plugin (the workspace manager's) contributes the "default" row.
    {^name "ui_defaults" ^^unique}
    {^name "channel_transports" ^^unique ^schema validate_channel_transport_row
     ^callbacks ["state" "render" "send" "remove" "reconcile" "lookup" "verify_account" "verify_route" "settings"]}
    # Recall for model-context ids with a feature prefix (e.g. "image."); the
    # longest matching prefix's `recall [session id]` answers.
    {^name "recall_sources" ^^unique ^key "prefix" ^callbacks ["recall"]}
    {^name "http_routes" ^^unique ^schema validate_http_route_row ^callbacks ["handle"]
     ^key (fn [candidate] candidate/prefix)
     ^prepare (fn [owner, candidate] (candidate .assoc "prefix" (route_prefix owner candidate)))}
    {^name "interactions" ^^unique ^schema validate_interaction_row
     ^callbacks ["validate_request" "validate_reply" "render"]}
    {^name "prompt" ^!unique ^^ordered ^schema validate_prompt_row ^callbacks ["render"]
     ^prepare (fn [owner, candidate] (prepare_prompt_callback h owner candidate))}
    {^name "docs" ^^unique ^schema validate_docs_row}
    {^name "settings" ^^unique ^schema validate_setting_row ^key "key" ^callbacks ["validate"]}
    {^name "settings_groups" ^^unique ^schema validate_settings_group_row ^key "name"}
    {^name "setting_choices" ^^unique ^schema validate_setting_choices_row ^key "name" ^callbacks ["choices"]}
    {^name "keyboard_actions" ^^unique ^schema validate_keyboard_action_row ^key "id"}
    {^name "themes" ^^unique ^schema validate_theme}
    {^name "icons" ^^unique ^schema validate_icon}
    {^name "web_components" ^^unique ^^ordered ^schema validate_web_component ^callbacks ["render"] ^reserved {^theme "core"}}
    {^name "browser_clients" ^^unique ^^ordered ^schema validate_browser_client}
    {^name "event_types" ^^unique ^schema validate_event_type_row
     ^prepare validate_event_type_owner ^^same_owner ^callbacks ["schema"]}
    {^name "subscriptions" ^!unique ^on_remove cancel_subscription_row}])
