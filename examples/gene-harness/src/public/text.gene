# UTF-8-safe bounds and image stripping for plugin and host text.
(mod harness_text)

(fn without_markdown_images [text : Str] : Str
  ($regex/replace_all #"!\[[^]]*\]\([^)]+\)" text ""))

(fn byte_prefix [text : Str, maximum : Int] : Str
  (var count ($math/min maximum ($str/byte_size text)))
  (while (>= count 0)
    (let prefix (try ($str/slice_bytes text 0 count) catch Any nil))
    (if_not ($absent? prefix) (return prefix))
    (set count (- count 1)))
  "")

(fn byte_suffix [text : Str, maximum : Int] : Str
  (let size ($str/byte_size text))
  (var count ($math/min maximum size))
  (while (>= count 0)
    (let suffix (try ($str/slice_bytes text (- size count) count) catch Any nil))
    (if_not ($absent? suffix) (return suffix))
    (set count (- count 1)))
  "")
