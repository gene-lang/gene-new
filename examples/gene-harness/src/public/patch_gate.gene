# The workspace write gate and the path rules a patch and the editor share.
#
# A shared SDK module, so the host and every plugin that imports it hold the
# same gate for a workspace root: an editor save and a model patch never
# interleave.
(mod patch_gate)

(type PatchError : Error)

(var patch_gates ^^private ($cell {}))
(var patch_gate_index ^^private ($sync/gate))

# Hold this across preparation, the durable response record, and commit or
# rollback. Locking only rename would allow a prepared plan to overwrite a
# patch that committed after it read the original file.
(fn with_patch_gate [root : Str, body]
  (let canonical ($fs/real_path root))
  (let gate (patch_gate_index (fn []
    (let existing (patch_gates/.get .get canonical))
    (if ($present? existing) (return existing))
    (let created ($sync/gate))
    (patch_gates/.get .put canonical created)
    created)))
  (gate body))

(fn patch_error [message : Str] (fail (PatchError ^_msg message)))

# A workspace-relative path: not empty, not absolute, no NUL, and no `..`.
(fn checked_path [path : Str]
  (if (|| (== path "") ($str/starts_with? path "/") ($str/contains? path "\0")
          (($str/split path "/") .contains? ".."))
    (patch_error $"invalid relative patch path ${path}"))
  path)

# The sibling a write is staged in before its rename.
(fn temporary_path [target : Str]
  ($path/join ($path/parent target) $".${($path/name target)}.gene-harness-tmp"))
