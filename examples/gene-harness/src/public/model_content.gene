# Provider-independent image parts. Binary assets are expanded only at the
# model boundary; durable conversation history keeps media IDs instead.
(mod model_content)
(import [ProviderError] ^from "../plugin_api")

(fn message_images [message]
  (let images (?? message/images []))
  (if_not (== ($head images) List)
    (fail (ProviderError ^message "Model image input must be a list.")))
  (if (&& (! images/.empty?) (!= message/role "user"))
    (fail (ProviderError ^message "Image observations must be supplied in user messages.")))
  (for image in images
    (if_not (&& (== ($head image) Map)
                (["image/png" "image/jpeg" "image/webp"] .contains? image/mime)
                (== ($head image/data) Str) (!= image/data ""))
      (fail (ProviderError ^message "Invalid model image content.")))
    (if_not (["auto" "low" "high"] .contains? (?? image/detail "auto"))
      (fail (ProviderError ^message "Image detail must be auto, low or high."))))
  images)

(fn image_url [image] : Str
  $"data:${image/mime};base64,${image/data}")

(fn responses_content [message]
  (let images (message_images message))
  (let parts [])
  (if (|| (!= message/content "") images/.empty?)
    (parts .push {^type (if (== message/role "assistant") "output_text" "input_text")
                  ^text message/content}))
  (for image in images
    (parts .push {^type "input_image" ^image_url (image_url image)
                  ^detail (?? image/detail "auto")}))
  parts)

(fn anthropic_content [message]
  (let images (message_images message))
  (let parts [])
  (if (|| (!= message/content "") images/.empty?)
    (parts .push {^type "text" ^text message/content}))
  (for image in images
    (parts .push {^type "image"
      ^source {^type "base64" ^media_type image/mime ^data image/data}}))
  parts)

(fn chat_messages [messages]
  (let result [])
  (for message in messages
    (let images (message_images message))
    (var content message/content)
    (if_not images/.empty?
      (set content [])
      (if (!= message/content "") (content .push {^type "text" ^text message/content}))
      (for image in images
        (content .push {^type "image_url"
          ^image_url {^url (image_url image) ^detail (?? image/detail "auto")}})))
    (result .push {^role message/role ^content content}))
  result)

(fn require_text_messages [messages, provider : Str]
  (for message in messages
    (let images (message_images message))
    (if_not images/.empty?
      (fail (ProviderError ^message
        $"${provider} does not support image observations in this transport; choose codex, anthropic or an image-capable OpenRouter model."))))
  nil)
