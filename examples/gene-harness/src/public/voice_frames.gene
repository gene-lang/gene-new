# The audio socket is unsequenced and ephemeral; these sequence numbers belong
# only to one PCM stream. Integers are little endian, like the PCM payload.
(mod voice_protocol)
(import [AudioError] ^from "./audio" ^pkg "audio")

(fn protocol_error [message : Str] (fail (AudioError ^message message)))

(fn encode_audio_frame [kind : Int, stream : Int, sequence : Int, pcm : Bytes] : Bytes
  (if (|| (&& (!= kind 1) (!= kind 2)) (< stream 1) (> stream 4294967295)
          (< sequence 0) (> sequence 4294967295)
          (== ($binary/size pcm) 0) (> ($binary/size pcm) 65536)
          (!= (// ($binary/size pcm) 2) 0))
    (protocol_error "Invalid audio frame."))
  ($binary/concat [($binary/put_u8 kind) ($binary/put_u32 stream)
    ($binary/put_u32 sequence) pcm]))

(fn decode_audio_frame [bytes : Bytes]
  (let count ($binary/size bytes))
  (if (|| (< count 11) (> count 65545) (!= (// (- count 9) 2) 0))
    (protocol_error "Audio frames need a nine-byte header and complete s16le samples."))
  (let kind ($binary/get bytes 0))
  (let stream ($binary/get_u32 bytes 1))
  (if (|| (&& (!= kind 1) (!= kind 2)) (== stream 0)) (protocol_error "Invalid audio frame header."))
  {^kind kind ^stream stream ^sequence ($binary/get_u32 bytes 5)
   ^pcm ($binary/slice bytes 9 (- count 9))})

(fn new_capture [id : Str, stream : Int]
  {^id id ^stream stream ^next 0 ^chunks [] ^bytes 0 ^state "capturing"})

(fn capture_frame [capture, frame]
  (if (|| (!= capture/state "capturing") (!= frame/kind 1)
          (!= frame/stream capture/stream) (!= frame/sequence capture/next)
          (> ($binary/size frame/pcm) 640))
    (protocol_error "Microphone frame is stale, out of sequence, or longer than 20 ms."))
  (let count (+ capture/bytes ($binary/size frame/pcm)))
  (if (> count 3840000) (protocol_error "An utterance may contain at most 120 seconds of audio."))
  (set capture/bytes count)
  (set capture/next (+ capture/next 1))
  (capture/chunks .push frame/pcm)
  nil)

# Absolute consumed-byte acknowledgements fence stale player reports. Sent
# bytes remain charged until the browser confirms actual playback, rather than
# merely receiving the WebSocket frame. A paused player therefore stops credit.
(fn new_credit [rate : Int]
  {^rate rate ^sent 0 ^played 0 ^sequence 0})

(fn playback_ack [credit, played : Int]
  (if (|| (< played credit/played) (> played credit/sent) (!= (// played 2) 0))
    (protocol_error "Invalid player acknowledgement."))
  (set credit/played played)
  nil)

(fn playback_credit [credit] : Int
  ($math/max 0 (- (* credit/rate 4) (- credit/sent credit/played))))

(fn charge_playback [credit, count : Int]
  (if (|| (<= count 0) (!= (// count 2) 0) (> count (playback_credit credit)))
    (protocol_error "PCM exceeds the player's two-second credit."))
  (set credit/sent (+ credit/sent count))
  (set credit/sequence (+ credit/sequence 1))
  nil)
