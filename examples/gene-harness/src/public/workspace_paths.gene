(mod workspace_paths)
(import [ServiceError] ^from "../plugin_api")

(fn manager_root_path [^explicit explicit = nil, ^environment environment = nil] : Str
  (let configured (?? environment ($os/get_env "GENE_HARNESS_ROOT" "")))
  (var selected (if (&& ($present? explicit) (!= explicit ""))
    (then explicit) (else configured)))
  (if (== selected "")
    (then
      (let home ($os/get_env "HOME" ""))
      (if (== home "")
        (fail (ServiceError ^code "invalid_workspace_settings"
          ^message "HOME is required to locate the manager root; use --root DIR.")))
      (set selected ($path/join home ".gene-harness-root"))))
  (if ($str/starts_with? selected "/")
    (then selected) (else ($path/join ($os/launch_dir) selected))))
