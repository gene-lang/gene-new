# The Models contribution owns this standalone page and its executable asset.
# The host supplies its theme CSS as data; no private host module is imported.
(mod model_page)
(import ^from "./web_style" [shell_css])
(import $html [render])
(import $web [script stylesheet])

(let model_styles (shell_css """
body.models_standalone { overflow: auto; height: auto; min-height: 100vh; }
.models_page { max-width: var(--size-75); margin: auto; padding: var(--space-6); }
.models_page header, .models_page nav, .models_page .actions { display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap; }
.models_page header { justify-content: space-between; border-bottom: var(--border-width) solid var(--line); padding-bottom: var(--space-4); }
.models_page h1 { margin: 0; }
.models_page h2 { font-size: var(--text-lg); margin: 0 0 var(--space-2); }
.models_page p { margin: var(--space-2) 0; }
.models_page section, .models_page .connection { border: var(--border-width) solid var(--line); padding: var(--space-4); margin: var(--space-4) 0; }
.models_page .connection h3 { margin: 0; }
.models_page .muted, .models_page small { color: var(--muted); font-size: var(--text-sm); }
.models_page .error { color: var(--danger); }
.models_page .notice { min-height: var(--size-1-5); margin: var(--space-3) 0; }
.models_page code { overflow-wrap: anywhere; }
.models_page input:not([type=checkbox]), .models_page select { padding: var(--space-2); border: var(--border-width) solid var(--edge); background-color: var(--field-surface); }
.models_page select:not([multiple]) { padding-inline-end: var(--space-8); }
.models_page form { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%, var(--size-14)), 1fr)); gap: var(--space-3); align-items: end; }
.models_page label { display: flex; flex-direction: column; gap: var(--space-1); }
.models_page label.check { flex-direction: row; align-items: center; }
.models_page table { width: 100%; border-collapse: collapse; margin-top: var(--space-3); }
.models_page th, .models_page td { text-align: left; padding: var(--space-2); border-top: var(--border-width) solid var(--line); vertical-align: top; }
.models_page td small { display: block; }
.models_page .default_form { display: flex; gap: var(--space-2); flex-wrap: wrap; }
.models_page .model_id { overflow-wrap: anywhere; }
.models_welcome { position: fixed; inset: 0; z-index: var(--layer-dialog); background: var(--scrim); display: flex; align-items: center; justify-content: center; padding: var(--space-4); }
.models_welcome[hidden] { display: none; }
.models_welcome section { max-width: var(--size-30); border: var(--border-width) solid var(--line); background: var(--surface); padding: var(--space-6); }
@compact { .models_page { padding: var(--space-4); } .models_page table, .models_page tbody, .models_page tr, .models_page td { display: block; } .models_page thead { display: none; } .models_page td { border: 0; padding: var(--space-1) 0; } .models_page tr { border-top: var(--border-width) solid var(--line); padding: var(--space-2) 0; } }
"""))

(fn model_page [asset, appearance, workspace : Str, base_styles : Str] : Str
  (let rendered appearance/rendered)
  (let toggle_label (if (== rendered/mode "dark") "Light" "Dark"))
  (let identity ($crypto/sha256 workspace))
  (let preloads [])
  (for src in (?? rendered/preloads [])
    (preloads .push `(link ^rel "preload" ^as "font" ^crossorigin "anonymous" ^href %src)))
  ($to_str "<!doctype html>"
    (render `(html ^id "harness_document" ^lang "en" ^data-theme %rendered/theme ^data-mode %rendered/mode
      ^data-density %rendered/density ^data-text-size %rendered/text_size ^data-content-width %rendered/content_width ^data-workspace-id %identity
      (head (meta ^charset "utf-8") (meta ^name "viewport" ^content "width=device-width,initial-scale=1")
        (title "Models · Gene Harness")
        %(stylesheet "harness-models-page" ($to_str base_styles model_styles))
        (link ^id "harness_theme" ^rel "stylesheet" ^href %rendered/stylesheet)
        %preloads...)
      (body ^class "models_standalone"
        (main ^id "models_page" ^class "models_page"
          (header (h1 "Models")
            (nav ^aria-label "Workspace navigation" (a ^href "/" "Workspace") (a ^href "/plugins" "Plugins")
              (button ^id "theme_toggle" ^type "button" %toggle_label)
              (button ^id "models_refresh" ^type "button" "Refresh connections")))
          (p ^id "models_workspace" ^class "muted" "Connecting to this workspace…")
          (div ^id "models_notice" ^class "notice" ^role "status" ^aria-live "polite")
          (div ^id "models_errors" ^role "alert")
          (div ^id "models_login" ^aria-live "polite")
          (div ^id "chatgpt_accounts")
          (div ^id "models_welcome" ^class "models_welcome" ^^hidden)
          (section (h2 "Shared default") (p ^id "models_default")
            (p ^class "muted" "Sessions and workspaces can choose their own model. New selections use the current shared default.")
            (p ^class "muted" "Settings file: " (code ^id "models_path")))
          (label "Find a model" (input ^id "models_search" ^type "search" ^placeholder "Search by provider, name or model id"))
          (div ^id "models_connections")
          (section
            (h2 "Add endpoint")
            (form ^id "models_endpoint_form"
              (label "Name" (input ^id "endpoint_name" ^^required ^placeholder "work_proxy"))
              (label "Adapter" (select ^id "endpoint_adapter"
                (option ^value "openai_chat" "OpenAI Chat Completions")
                (option ^value "openai_responses" "OpenAI Responses")
                (option ^value "anthropic_messages" "Anthropic Messages")
                (option ^value "openrouter_chat" "OpenRouter Chat Completions")))
              (label "Base URL" (input ^id "endpoint_url" ^type "url" ^^required ^placeholder "http://127.0.0.1:11434/v1"))
              (label "Credential environment variable (optional)" (input ^id "endpoint_env" ^placeholder "WORK_LLM_KEY"))
              (label "Initial model id (optional)" (input ^id "endpoint_model" ^placeholder "model-id"))
              (label ^class "check" (input ^id "endpoint_discover" ^type "checkbox" ^^checked) "Discover models")
              (button ^id "endpoint_add" ^type "submit" "Add endpoint"))
            (p ^class "muted" "Enter the environment variable name, never its secret value. Credential commands can be configured in the data file."))
          (section
            (h2 "Add model")
            (form ^id "models_model_form"
              (label "Provider" (select ^id "model_provider"))
              (label "Model id" (input ^id "model_id" ^^required))
              (label "Display name (optional)" (input ^id "model_label"))
              (label "Context window (optional)" (input ^id "model_window" ^type "number" ^min "1"))
              (label "Supported efforts (optional)" (input ^id "model_efforts" ^placeholder "low medium high"))
              (label "Default effort (optional)" (input ^id "model_default_effort" ^placeholder "medium"))
              (button ^id "model_add" ^type "submit" "Add model"))
            (p ^class "muted" "A typed model id is unverified. Context and effort overrides describe what this endpoint supports.")))
        %(script ^mount "models_page" asset))))))
