(mod web_component_spec)
(import ^from "./images" [image_source])
(import $css [scoped class_name render : render_css])

(type WebComponentError ^props {^message Str} ^impl [Error])
(impl Error for WebComponentError)

(const component_slots ["sidebar" "conversation_sidebar" "toolbar" "composer" "status" "welcome" "status_summary" "panel" "view"])
(const sidebar_widgets ["brand" "new_conversation" "filters" "attention" "extensions" "conversations" "workspace_tools"])
(const interactive_tags ["form" "label" "input" "textarea" "select" "option" "table" "thead" "tbody" "tr" "th" "td"])
(const interactive_attributes ["key" "field" "state" "action" "args" "positional" "success_state" "name" "placeholder" "checked" "selected" "for" "rows" "required"])
# Conversation cards (docs/cards.md) use the keyed controls without view-state
# or function actions, plus their own card actions.
(const card_attributes ["key" "field" "args" "name" "placeholder" "checked" "selected" "for" "rows" "required" "update" "send" "answer"])
(const card_actions ["command" "prompt" "update" "send" "answer"])
(const component_tags
  [
    "div"
    "section"
    "p"
    "h2"
    "h3"
    "h4"
    "span"
    "strong"
    "small"
    "em"
    "ul"
    "ol"
    "li"
    "button"
    "a"
    "details"
    "summary"
    "pre"
    "code"
    "progress"
    "hr"
    "br"
    "img"])
(const component_attributes
  [
    "class"
    "class_name"
    "title"
    "role"
    "aria-label"
    "aria_label"
    "type"
    "href"
    "target"
    "value"
    "max"
    "open"
    "disabled"
    "command"
    "prompt"
    "switch_view"
    "presentation"
    "src"
    "alt"
    "width"
    "height"
    "columns"
    "inset"])

(fn component_error [message : Str]
  (fail (WebComponentError ^message ($to_str message
    "; read (doc \"harness/ui/forms\") for keyed controls or (doc \"harness/web_components\") for the full contract"))))

(fn card_error [message : Str]
  (fail (WebComponentError ^message ($to_str message "; read (doc \"harness/cards\") for the card contract"))))

# Card modes: "static" (prompt and command buttons), "live" (update forms and
# buttons, send, prompt, command) and "question" (answer and prompt buttons).
(fn card_attribute [mode : Str, tag : Str, name : Str, item, attributes] : Bool
  (if_not (["update" "send" "answer"] .contains? name) (return false))
  (if (&& (== name "answer") (!= mode "question"))
    (card_error "answer buttons belong to question views"))
  (if (&& (["update" "send"] .contains? name) (!= mode "live"))
    (card_error $"${name} requires a live card with view and update functions"))
  (if_yes (== name "answer")
    (if (!= tag "button") (card_error "answer requires a button"))
    (if_not ([Str Int Float Bool] .contains? ($head item))
      (card_error "an answer value must be text, a number or a boolean"))
    (attributes .put "answer" item)
    (return true))
  (if (|| (!= ($head item) Str) (== ($str/trim item) ""))
    (card_error $"${name} requires nonempty text"))
  (if (> ($str/byte_size item) 4096) (card_error $"${name} text exceeds 4 KiB"))
  (if (&& (== name "update") (! (["button" "form"] .contains? tag)))
    (card_error "update requires a button or form"))
  (if (&& (== name "send") (!= tag "button"))
    (card_error "send requires a button"))
  (attributes .put name item)
  true)

(fn component_view [value, ^depth depth : Int = 0, ^experimental experimental : Bool = false, ^keys keys = nil, ^form form = nil, ^widgets widgets = nil, ^card card = nil]
  (if (> depth 24) (component_error "web component view exceeds 24 levels"))
  (if ([Str Int Float Bool Nil] .contains? ($head value))
    (return (if ($absent? value) "" ($to_str value))))
  (var tag nil)
  (var props {})
  (var children [])
  (match value
    (when (node : Node)
      (set tag ($to_str ($head node)))
      (set props ($node/props node))
      (set children ($node/body node)))
    (when (data : Map)
      (set tag data/tag)
      (set props (?? data/props {}))
      (set children (?? data/children [])))
    (else
      (component_error "web component view must be a quoted element or data tree")))
  (if (|| (!= ($head props) Map) (!= ($head children) List))
    (component_error "web component props and children must be a map and list"))
  (if_yes (== tag "host_widget")
    (if ($absent? widgets)
      (component_error "host_widget is only available in conversation_sidebar"))
    (if (|| (!= ($size props) 1) (! (sidebar_widgets .contains? props/name)) (! children/.empty?))
      (component_error "host_widget requires one supported name and no children"))
    (if_not ($absent? (widgets .get props/name))
      (component_error $"duplicate sidebar widget ${props/name}"))
    (widgets .put props/name true)
    (return {^tag "host_widget" ^props {^name props/name} ^children []}))
  (if_not (|| (component_tags .contains? tag) (&& (|| experimental (! ($absent? card))) (interactive_tags .contains? tag)))
    (component_error $"unsupported web component element ${tag}"))
  (let attributes {})
  (for [key item] in props
    (let name ($to_str key))
    (if_yes ($absent? card)
      (if_not (|| (component_attributes .contains? name) (&& experimental (interactive_attributes .contains? name)))
        (component_error $"unsupported web component attribute ${name}")))
    (if_not ($absent? card)
      (if (|| (["switch_view" "presentation"] .contains? name)
              (! (|| (component_attributes .contains? name) (card_attributes .contains? name))))
        (card_error $"unsupported card attribute ${name}"))
      (if (card_attribute card tag name item attributes) (continue)))
    (if_yes (== name "args")
      (if (!= ($head item) Map) (component_error "action args must be a map"))
      ($serde/write_data item)
      (attributes .put name item)
      (continue))
    (if_yes (== name "positional")
      (if (!= ($head item) List) (component_error "positional action arguments must be a list"))
      ($serde/write_data item)
      (attributes .put name item)
      (continue))
    (if_yes (== name "success_state")
      (if (!= ($head item) Map) (component_error "success_state must be a map"))
      (for [field value] in item
        (if_not ([Str Int Float Bool Nil] .contains? ($head value))
          (component_error "success_state values must be scalar data")))
      (attributes .put "success-state" item)
      (continue))
    # Images and overlay geometry are scalar, bounded, and never CSS strings.
    (if_yes (== name "src")
      (if (!= tag "img") (component_error "src requires img"))
      (attributes .put "src" (image_source item))
      (continue))
    (if_yes (["alt" "width" "height"] .contains? name)
      (if (!= tag "img") (component_error "image attributes require img"))
      (if_yes (!= name "alt")
        (if (|| (!= ($head item) Int) (< item 1) (> item 2048))
          (component_error "image dimensions must be integers from 1 to 2048"))))
    (if_yes (["columns" "inset"] .contains? name)
      (if (|| (!= tag "div") (!= ($head item) Int)
              (< item (if (== name "columns") 1 0))
              (> item 25))
        (component_error "overlay columns must be 1–25; inset must be 0–25"))
      (attributes .put ($to_str "data-" name) ($to_str item))
      (continue))
    (if_not ([Str Int Float Bool Nil] .contains? ($head item))
      (component_error "web component attributes must be scalar data"))
    (if (|| ($absent? item) (== item false)) (continue))
    (if_yes (["command" "prompt" "switch_view"] .contains? name)
      (if (|| (!= tag "button") (!= ($head item) Str))
        (component_error "component actions require a button and text"))
      (if (&& (== name "command") (! ($str/starts_with? item "/")))
        (component_error "component command actions must start with /"))
      (if (&& (== name "switch_view") (== ($str/trim item) ""))
        (component_error "view navigation needs a nonempty target")))
    (if_yes (== name "href")
      (if (|| (!= ($head item) Str) (! (|| ($str/starts_with? item "#") (&& ($str/starts_with? item "/") (! ($str/starts_with? item "//"))) ($str/starts_with? item "https://"))))
        (component_error "component links require a local path, fragment or HTTPS URL")))
    (if_yes (== name "target")
      (if (|| (!= tag "a") (! (["_self" "_blank"] .contains? item)))
        (component_error "link targets require an anchor and must be _self or _blank")))
    (attributes .put ($regex/replace_all #"_" name "-") (if (== item true) "" ($to_str item))))
  (if (== attributes/target "_blank")
    (attributes .put "rel" "noopener"))
  (if_not ($absent? attributes/class-name)
    (attributes .put "class" attributes/class-name)
    (attributes .delete "class-name"))
  (if (&& (! ($absent? attributes/command)) (! ($absent? attributes/prompt)))
    (component_error "a component button needs one action"))
  (if_not ($absent? card)
    (var actions 0)
    (for name in card_actions
      (if_not ($absent? (attributes .get name)) (set actions (+ actions 1))))
    (if (> actions 1) (card_error "a card control needs exactly one action"))
    (if (&& (== card "question") (! ($absent? attributes/command)))
      (card_error "question views cannot run commands; use a prompt button"))
    (if (&& (! ($absent? attributes/field)) (!= card "live"))
      (card_error "form fields belong to live cards"))
    (if (&& (== tag "form") (!= card "live")) (card_error "forms belong to live cards"))
    (if (&& (== tag "form") ($absent? attributes/update))
      (card_error "a card form needs an update action"))
    (if (&& (== tag "form") (! ($absent? form))) (card_error "nested forms are unsupported"))
    (if_not ($absent? attributes/field)
      (if ($absent? form) (card_error "card fields must belong to a form"))
      (if_not ($absent? (form .get attributes/field)) (card_error "duplicate form field"))
      (form .put attributes/field true)
      (if_not (["input" "textarea" "select"] .contains? tag) (card_error "form fields require an input")))
    (if (&& (|| (== tag "form") (! ($absent? attributes/field)) (! ($absent? attributes/update))
                (! ($absent? attributes/send)) (! ($absent? (attributes .get "answer"))))
            ($absent? attributes/key))
      (card_error "card controls and forms require stable keys"))
    (if (&& (== tag "input") (! ($absent? attributes/type))
            (! (["text" "search" "checkbox" "number" "hidden"] .contains? attributes/type)))
      (card_error "unsupported card input type"))
    (if_not ($absent? attributes/key)
      (if (|| (== attributes/key "") (! ($absent? (keys .get attributes/key))))
        (card_error "card keys must be nonempty and unique"))
      (keys .put attributes/key true)))
  (if_not ($absent? attributes/switch-view)
    (for name in ["command" "prompt" "action" "state"]
      (if_not ($absent? (attributes .get name))
        (component_error "view navigation cannot be combined with another button action"))))
  (if_not ($absent? attributes/presentation)
    (if (|| ($absent? attributes/switch-view) (== attributes/switch-view "harness")
            (! (["docked" "full"] .contains? attributes/presentation)))
      (component_error "presentation requires a plugin view target and must be docked or full")))
  (if_yes experimental
    (if (&& (! ($absent? attributes/success-state))
            (|| (!= tag "form") ($absent? attributes/action)))
      (component_error "success_state requires a form action"))
    (if (&& (== tag "form") (! ($absent? form))) (component_error "nested forms are unsupported"))
    (if_not ($absent? attributes/field)
      (if ($absent? form) (component_error "draft fields must belong to a form"))
      (if_not ($absent? (form .get attributes/field)) (component_error "duplicate form field"))
      (form .put attributes/field true))
    (if (&& (|| (== tag "form") (! ($absent? attributes/field))
                 (! ($absent? attributes/state)) (! ($absent? attributes/action)))
            ($absent? attributes/key))
      (component_error "interactive controls and forms require stable keys"))
    (if (&& (== tag "input") (! ($absent? attributes/type))
            (! (["text" "search" "checkbox" "number" "hidden"] .contains? attributes/type)))
      (component_error "unsupported experimental input type"))
    (if (&& (! ($absent? attributes/action)) (! (["button" "form"] .contains? tag)))
      (component_error "function actions require a button or form"))
    (if (&& (! ($absent? attributes/state)) (! (["button" "input" "textarea" "select"] .contains? tag)))
      (component_error "view state requires a button or input"))
    (if (&& (! ($absent? attributes/field)) (! (["input" "textarea" "select"] .contains? tag)))
      (component_error "form fields require an input"))
    (if (&& (! ($absent? attributes/field)) (! ($absent? attributes/state)))
      (component_error "a control cannot be both a draft and view state"))
    (if_not ($absent? attributes/key)
      (if (|| (== attributes/key "") (! ($absent? (keys .get attributes/key))))
        (component_error "view keys must be nonempty and unique"))
      (keys .put attributes/key true)))
  (if_yes (== tag "img")
    (if (|| ($absent? attributes/src) ($absent? attributes/alt) (! children/.empty?))
      (component_error "img requires workspace src, alt text (empty allowed), and no children")))
  (if_yes (|| (! ($absent? attributes/data-columns)) (! ($absent? attributes/data-inset)))
    (if (!= (?? attributes/class "") "web_image_grid")
      (component_error "columns and inset require web_image_grid")))
  (let field_names (if (== tag "form") {} form))
  (let body ($map children (fn [child] (component_view ^depth (+ depth 1) ^experimental experimental ^keys keys ^form field_names ^widgets widgets ^card card child))))
  # A textarea's ordinary text content is its initial value. The keyed browser
  # adapter needs that value in props; explicit value still takes precedence.
  (if_yes (&& (== tag "textarea") ($absent? attributes/value) (! body/.empty?))
    (for child in body
      (if (!= ($head child) Str) (component_error "textarea initial content must be text")))
    (attributes .put "value" ($str/join body "")))
  {^tag tag ^props attributes ^children body})

(fn bounded_card_view [value, mode : Str]
  (if_not (["static" "live" "question"] .contains? mode) (card_error "unknown card mode"))
  (let view (component_view ^card mode ^keys {} value))
  (if (> ($str/byte_size ($json/stringify view)) 65536)
    (card_error "card view exceeds 64 KiB"))
  view)

# Whether a validated wire tree carries slash-command buttons. Those make a
# static card follow the reload rule, like a live card.
(fn tree_has_commands? [tree] : Bool
  (if (!= ($head tree) Map) (return false))
  (if_not ($absent? tree/props/command) (return true))
  (for child in (?? tree/children [])
    (if (tree_has_commands? child) (return true)))
  false)

(fn bounded_component_view [value, ^experimental experimental : Bool = false, ^sidebar sidebar : Bool = false]
  (let view (component_view ^experimental experimental ^keys {} ^widgets (if sidebar {} nil) value))
  (if (> ($str/byte_size ($json/stringify view)) 65536)
    (component_error "web component view exceeds 64 KiB"))
  view)

# A style contribution is `$css` node data. It is scoped to the component with
# `$css/scoped` by default, which avoids accidental selector collisions; it is
# not isolation. `^!style_scoped` renders the rules page-wide. Plugins are
# trusted, so the rules themselves are not restricted (docs/theming.md).
(fn component_style [candidate, checked]
  (if ($absent? candidate/style) (return nil))
  (let scoped_style
    (if (== candidate/style_scoped false) nil (scoped $"plugin_${candidate/name}" candidate/style)))
  (let css
    (try
      (render_css (?? scoped_style candidate/style))
    catch Any
      (component_error $"web component style could not be rendered: ${$err/message}")))
  (if (> ($str/byte_size css) 65536) (component_error "web component style exceeds 64 KiB"))
  (checked .put "style_css" css)
  (checked .put "style_class" (if ($absent? scoped_style) "" (class_name scoped_style)))
  nil)

(fn validate_web_component [candidate]
  (if (|| (!= ($head candidate/name) Str) ($absent? (#"^[a-z][a-z0-9_]{0,79}$" .match candidate/name)))
    (component_error "web component requires a stable name"))
  (if (== candidate/name "harness") (component_error "harness is reserved for Classic Harness"))
  (if_not (component_slots .contains? candidate/slot)
    (component_error "unknown web component slot"))
  (if (&& (["welcome" "status_summary" "conversation_sidebar"] .contains? candidate/slot) (!= candidate/name candidate/slot))
    (component_error "replacement component name must equal its slot"))
  (if (== ($absent? candidate/view) ($absent? candidate/render))
    (component_error "web component requires exactly one of view or render"))
  (if (&& (! ($absent? candidate/render)) (! ($runtime/callable? candidate/render)))
    (component_error "web component render must be callable"))
  (let checked ($thaw ($freeze_shallow candidate)))
  (let stateful (! ($absent? candidate/view_state)))
  (if_yes stateful
    (if (!= ($head candidate/view_state) Map) (component_error "view_state must declare a map of defaults"))
    (if (|| ($absent? candidate/render) (! (["panel" "view"] .contains? candidate/slot)))
      (component_error "stateful views need a panel or view render callback"))
    (for [key value] in candidate/view_state
      (if_not ([Str Bool Int Float Nil] .contains? ($head value))
        (component_error "view state defaults must be scalar data")))
    (if_not ($absent? candidate/actions)
      (if (!= ($head candidate/actions) List) (component_error "actions must list function names"))
      (for name in candidate/actions
        (if (|| (!= ($head name) Str) (== name "")) (component_error "invalid action function name")))))
  (if (&& (["panel" "view"] .contains? candidate/slot) (! stateful))
    (component_error "views must declare view_state"))
  (if_yes stateful
    (let title (if (== candidate/slot "panel") (?? candidate/title candidate/name) candidate/title))
    (if (|| (!= ($head title) Str) (== ($str/trim title) "") (> ($str/byte_size title) 160))
      (component_error "view title must have 1–160 bytes"))
    (checked .put "title" title)
    (checked .put "default_presentation" (if (== candidate/slot "panel") "docked" "full"))
    (checked .put "slot" "view"))
  (if_not ($absent? candidate/view)
    (checked .put "view" (bounded_component_view ^sidebar (== candidate/slot "conversation_sidebar") candidate/view)))
  (component_style candidate checked)
  checked)
