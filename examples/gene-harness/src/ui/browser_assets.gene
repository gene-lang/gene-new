# Only assets admitted by web/load can become executable browser contributions.
(mod browser_assets)
(import [ui_revision] ^from "./state")

(fn stylesheet_url [value]
  (if ($absent? value) (return ""))
  (if (!= ($head value) (quote link))
    (fail (Error ^_msg "A browser stylesheet must be prepared with web/stylesheet before activation.")))
  (let props ($props value))
  (let base ($web/asset_base))
  (for route in ($web/published_routes)
    (let url (if (== base "/") $"/${route/file}" else $"${base}/${route/file}"))
    (if (&& (== props/rel "stylesheet") (== props/href url)
            ($str/starts_with? route/content_type "text/css")) (return url)))
  (fail (Error ^_msg "The browser stylesheet is not a published asset.")))

(fn validate_browser_client [payload]
  (if (|| (!= ($head payload) Map) (!= ($head payload/name) Str)
          ($absent? (#"^[a-z][a-z0-9_]{0,79}$" .match payload/name)))
    (fail (Error ^_msg "A browser client needs a stable contribution name.")))
  # A contribution is plugin data: a value that is not a compiled web module
  # is rejected as an Error, with the native's complaint kept as the cause.
  (let url (try ($web/module_url payload/asset)
    catch Fault
      (fail (Error ^_msg "A browser client needs a web_module or web/load asset." ^_cause $err))))
  (let style (stylesheet_url payload/style))
  (let scope (?? payload/scope "page"))
  (if (! (["page" "view"] .contains? scope))
    (fail (Error ^_msg "A browser client scope must be page or view.")))
  {^name payload/name ^title (?? payload/title payload/name) ^url url
   ^stylesheet style ^scope scope})

(fn browser_client_descriptors [h, snapshot]
  (let results [])
  (for record in (?? (snapshot/registries .get "browser_clients") [])
    (results .push {^name record/key ^owner record/owner
      ^revision (ui_revision h record) ^url record/payload/url
      ^title record/payload/title ^stylesheet record/payload/stylesheet
      ^scope record/payload/scope}))
  results)
