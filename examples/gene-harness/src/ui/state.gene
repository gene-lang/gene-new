# Workspace UI configuration and revision descriptors; no rendering or transport.
(mod ui_state)
(import [plugin_state next_sequence stream_key] ^from "../storage/state")
(import [current_snapshot] ^from "../runtime/composition")
(import [public_tokens theme_modes css_name] ^from "../web/theme")
(import [theme_revision] ^from "../web/theme_registry")

(type UiError ^props {^code Str ^message Str} ^impl [Error])
(impl Error for UiError)

(fn ui_error [code : Str, message : Str] (fail (UiError ^code code ^message message)))

(fn ui_settings [runtime]
  (let h runtime/h)
  # Match the Workspace UI plugin's persisted identity across source renames.
  (let saved (if ($absent? h/event_store) nil
    (plugin_state h/event_store "workspace" "workspace" "ui_experiment")))
  (var defaults nil)
  (if_yes ($present? h/snapshots)
    (let snapshot (current_snapshot h/snapshots))
    (for record in (?? (snapshot/registries .get "ui_defaults") [])
      (if_yes (== record/key "default")
        (set defaults {})
        (for [key value] in record/payload
          (if (!= ($to_str key) "name") (defaults .put ($to_str key) value))))))
  (?? saved defaults {^enabled false ^layout "chat" ^panel "" ^side "left" ^width 50 ^tokens {}}))

(fn validate_theme_colors [colors, declared = []]
  (if (!= ($head colors) Map) (ui_error "invalid_request" "Theme overrides must be a map of tokens."))
  (let normalized {})
  (for [raw_key color] in colors
    (let key (css_name raw_key))
    (if_not (|| (public_tokens .contains? ($to_str key)) (declared .contains? ($to_str key)))
      (ui_error "invalid_request" $"Unknown theme token ${key}."))
    (if (|| (!= ($head color) Str) (&& (public_tokens .contains? ($to_str key)) ($absent? (#"^#[0-9a-fA-F]{6}$" .match color))))
      (ui_error "invalid_request" "Theme colors must be six-digit hex colors."))
    (normalized .put key color))
  normalized)

# Theme overrides belong to an explicit mode: {^light {...} ^dark {...}}.
(fn validate_theme [theme, declared = []]
  (let normalized {})
  (for [key colors] in theme
    (if_not (theme_modes .contains? ($to_str key))
      (ui_error "invalid_request" "Theme overrides require light/dark mode maps."))
    (normalized .put key (validate_theme_colors colors declared)))
  normalized)

(fn validate_ui_settings [value, declared = []]
  (if (!= ($head value) Map) (ui_error "invalid_request" "UI settings must be a map."))
  (let result {^enabled (== value/enabled true) ^layout (?? value/layout "chat")
    ^default_view (?? value/default_view "")
    ^panel (?? value/panel "") ^side (?? value/side "left")
    ^width (?? value/width 50) ^tokens (?? value/tokens {})})
  (if_not (["chat" "panel"] .contains? result/layout) (ui_error "invalid_request" "Unknown UI layout."))
  (if_not (["left" "right"] .contains? result/side) (ui_error "invalid_request" "Panel side must be left or right."))
  (if (|| (!= ($head result/width) Int) (< result/width 25) (> result/width 70))
    (ui_error "invalid_request" "Panel width must be 25–70 percent."))
  (if (|| (!= ($head result/panel) Str) (!= ($head result/tokens) Map))
    (ui_error "invalid_request" "Invalid panel or theme."))
  (if (|| (!= ($head result/default_view) Str)
          (&& (!= result/default_view "") ($absent? (#"^[a-z][a-z0-9_]{0,79}$" .match result/default_view))))
    (ui_error "invalid_request" "Default view must be a registered view name or harness."))
  (result .put "tokens" (validate_theme result/tokens declared))
  result)

(fn ui_record [snapshot, registry : Str, name : Str]
  (for record in (?? (snapshot/registries .get registry) [])
    (if (== record/key name) (return record)))
  nil)

(fn ui_revision [h, record] ($to_str h/ui_epoch ":" record/row_id))

# A view's own actions plus those of the section rows it embeds, so a contributed
# section uses the ordinary action contract inside the embedding view.
(fn view_actions [snapshot, payload]
  (let names [])
  (for name in (?? payload/actions []) (names .push name))
  (if ($present? payload/embeds)
    (for record in (?? (snapshot/registries .get "web_components") [])
      (if (== record/payload/slot payload/embeds)
        (for name in (?? record/payload/actions [])
          (if_not (names .contains? name) (names .push name))))))
  names)

# Optional workspace views follow the enabled setting; an always_available view
# such as Settings is listed regardless.
(fn view_listed? [settings, record] : Bool
  (|| (== settings/enabled true) (== record/payload/always_available true)))

(fn ui_data_revision [runtime, snapshot]
  (let h runtime/h)
  (let manager runtime/services/values/manager)
  ($to_str snapshot/id ":" (if ($absent? h/event_store) 0
    (next_sequence h/event_store (stream_key "workspace" "workspace")))
    (if ($absent? manager) "" ($to_str ":manager:" manager/revision/.get))
    ":settings:" (settings_revision runtime)))

# Bumped by every committed settings write and observed shared change, so open
# Settings screens refresh. Read inline: ui state must not import the resolver.
(fn settings_revision [runtime] : Int
  (let state (if ($absent? runtime/services) nil runtime/services/values/settings))
  (if ($absent? state) 0 state/revision/.get))

(fn ui_descriptor [runtime, snapshot, record]
  (let h runtime/h)
  (let candidate record/payload)
  (let functions {})
  (for name in (view_actions snapshot candidate)
    (let action (?? (ui_record snapshot "ui_actions" name) (ui_record snapshot "functions" name)))
    (if_not ($absent? action) (functions .put name (ui_revision h action))))
  {^name candidate/name ^title (?? candidate/title candidate/name) ^owner record/owner
   ^default_presentation (?? candidate/default_presentation "docked")
   ^slot candidate/slot ^revision (ui_revision h record)
   ^data_revision (ui_data_revision runtime snapshot) ^view_state candidate/view_state
   ^state_version ($to_str (?? candidate/state_version "1")) ^functions functions
   ^style candidate/style_css ^style_class candidate/style_class ^tokens (?? candidate/tokens [])})

(fn ui_status [runtime]
  (let h runtime/h)
  (let settings (ui_settings runtime))
  (let components [])
  (let snapshot h/snapshots/current/.get)
  (for record in (?? (snapshot/registries .get "web_components") [])
    (if (&& ($present? record/payload/view_state) (view_listed? settings record))
      (components .push (ui_descriptor runtime snapshot record))))
  (let actions (if ($absent? runtime/services/values/actions) nil runtime/services/values/actions/log/state/.get))
  {^settings settings ^components ($order/sort_by components (fn [item] item/name))
   ^data_revision (ui_data_revision runtime snapshot) ^theme_revision (theme_revision runtime) ^epoch h/ui_epoch
   ^actions (if ($absent? actions) nil
     {^generation actions/generation ^floor actions/floor ^revision ($to_str actions/revision)})
   ^workspace (?? h/workspace/workspace_root "")})
