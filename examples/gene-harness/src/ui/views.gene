# Leased rendering and publication previews shared by CLI and browser hosts.
(mod ui_views)
(import [resolve] ^from "../kernel")
(import [acquire_snapshot release_snapshot] ^from "../runtime/composition")
(import [spawn_composition_call] ^from "../runtime/cordis_adapter")
(import [load_session list_sessions require_record] ^from "../runtime/sessions")
(import [bounded_component_view WebComponentError] ^from "./components")
(import [ui_settings ui_record ui_revision ui_data_revision ui_descriptor ui_error] ^from "./state")
(import [view_outline outline_text] ^from "./outline")

(fn render_component [h, callback, context, ^experimental experimental : Bool = false]
  (let outcome
    (scope
      (let task (spawn_composition_call h/composition callback [context]
        {^timeout_ms 1000 ^max_memory_mb 32} ($runtime/context)))
      (let deadline (spawn ^lane root (do ($sleep 1000) task/.cancel)))
      (try task/.join
        ensure
          (if_not task/.done? task/.cancel task/.join)
          deadline/.cancel
          deadline/.join)))
  (match outcome
    (when (TaskOutcome/ok value) (bounded_component_view ^experimental experimental value))
    (when (TaskOutcome/error error) (fail (WebComponentError ^message error/message)))
    (when (TaskOutcome/panic message) (fail (WebComponentError ^message $"component render panicked: ${message}")))
    (else (fail (WebComponentError ^message "component render exceeded its budget or was cancelled")))))

(fn ui_context [h, session : Str, state]
  (let loop_factory (resolve h "loop"))
  (let runtime (/runtime (loop_factory)))
  (let loaded (if (== session "") nil (load_session runtime/sessions session)))
  (let config ($serde/read_data ($fs/read_text $"${runtime/state_root}/config.gene")))
  ($freeze {^session_id session ^session (if ($absent? loaded) nil (require_record runtime/sessions session))
    ^round (if ($absent? loaded) nil loaded/round/.get) ^workspace runtime/root
    ^model {^provider config/provider ^model config/model} ^sessions (list_sessions runtime/sessions)
    ^view_state state}))

(fn ui_view_state [candidate, supplied]
  (if (!= ($head supplied) Map) (ui_error "invalid_request" "View state must be a map."))
  (if (> ($str/byte_size ($json/stringify supplied)) 16384) (ui_error "too_large" "View state is too large."))
  (let state ($thaw ($freeze candidate/view_state)))
  (for [key value] in supplied
    (if_not (candidate/view_state .has_key? key) (ui_error "invalid_request" $"Unknown view-state field ${key}."))
    (if_not ([Str Bool Int Float Nil] .contains? ($head value)) (ui_error "invalid_request" "View state must contain scalar values."))
    (let initial (candidate/view_state .get key))
    (if (&& (! ($absent? initial)) (!= ($head initial) ($head value))
            (! (&& ([Int Float] .contains? ($head initial)) ([Int Float] .contains? ($head value)))))
      (ui_error "invalid_request" $"Wrong type for view-state field ${key}."))
    (state .put key value))
  state)

(fn validate_view_actions [tree, candidate, snapshot]
  (if ($absent? tree/tag) (return nil))
  (if_not ($absent? tree/props/action)
    (let name tree/props/action)
    (if_not ((?? candidate/actions []) .contains? name)
      (ui_error "invalid_request" $"Undeclared view action ${name}."))
    (if ($absent? (ui_record snapshot "functions" name)) (ui_error "unavailable" $"Missing action function ${name}.")))
  (if_not ($absent? tree/props/state)
    (if_not (candidate/view_state .has_key? tree/props/state)
      (ui_error "invalid_request" $"Undeclared view-state field ${tree/props/state}.")))
  (for child in tree/children (validate_view_actions child candidate snapshot))
  nil)

(fn ui_render [h, session : Str, name : Str, revision : Str, state, ^instance instance : Str = "preview", ^sequence sequence : Str = "0"]
  (if_not (/enabled (ui_settings h)) (ui_error "unavailable" "The UI experiment is disabled."))
  (let lease (acquire_snapshot h/snapshots))
  (try
    (let record (ui_record lease/snapshot "web_components" name))
    (if (|| ($absent? record) ($absent? record/payload/view_state)) (ui_error "not_found" "View not found."))
    (if (&& (!= revision "") (!= revision (ui_revision h record))) (ui_error "revision_conflict" "This view was replaced. Refresh before trying again."))
    (let data_revision (ui_data_revision h lease/snapshot))
    (let result (ui_descriptor h lease/snapshot record))
    (result .put "instance" instance)
    (result .put "sequence" sequence)
    (result .put "data_revision" data_revision)
    (let view_state (ui_view_state record/payload state))
    # Request failures (including a missing session) belong to the HTTP caller.
    # Only callback/validation failures become a view's inline error.
    (let context (ui_context h session view_state))
    (try
      (let view ($runtime/with_context {^composition h/snapshots ^snapshot lease/snapshot ^session session ^^ui_render}
        (fn [] (render_component ^^experimental h record/payload/render context))))
      (validate_view_actions view record/payload lease/snapshot)
      (result .put "view" view)
    catch Any (result .put "error" $err/message))
    result
  ensure (release_snapshot h/snapshots lease)))

(fn ui_preview [h, name : Str, state = {}, ^session session : Str = ""]
  (let chosen (if (== session "") (?? (/session ($runtime/context)) "") session))
  (ui_render h chosen name "" state))

(fn ui_publication_preview [h, session : Str, changes]
  (if_not (/enabled (ui_settings h)) (return nil))
  (let owners [])
  (for change in changes
    (if (== change/state "active") (owners .push change/id)))
  (let results [])
  (let summary {^views results ^truncated false})
  (var bytes 64)
  (let snapshot h/snapshots/current/.get)
  (for record in (?? (snapshot/registries .get "web_components") [])
    (if (|| (! (owners .contains? record/owner)) ($absent? record/payload/view_state)) (continue))
    (if (>= results/.size 8) (do (summary .put "truncated" true) (break)))
    (let preview (ui_render h session record/key (ui_revision h record) {}))
    (let item {^name preview/name ^slot preview/slot ^revision preview/revision})
    (if ($absent? preview/error)
      (do
        (let outline (view_outline preview/view))
        (item .put "outline" outline/nodes)
        (item .put "truncated" outline/truncated))
      (item .put "error" (outline_text preview/error)))
    (let size (+ ($str/byte_size ($json/stringify item)) 1))
    (if (> (+ bytes size) 12288)
      (do (summary .put "truncated" true) (break)))
    (set bytes (+ bytes size))
    (results .push item))
  (if results/.empty? nil ($json/stringify summary)))
