# The terminal driver: read a prompt, hand it to the agent, print the answer.
#
# It knows nothing about what any prompt means. That is the `HarnessPrompt`
# seam's job, and the reason this file is short: swapping the agent for a
# model-backed one changes everything the harness can do and none of this.
#
# The driver is itself a plugin contributing a `views` row, so "is this
# deployment interactive?" is answered by profile composition rather than by a
# flag in main.gene.

(mod repl)

(import [Plugin PluginContext PluginHost Harness HarnessLog] ^from "../kernel")
(import_impl PluginHost for PluginContext ^from "../kernel")
(import [ask] ^from "../runtime/cli_driver")
(import [pending_input] ^from "../runtime/interactions")
(import [HarnessView view_provider] ^from "./view_api")

# A literal escape byte, because Gene has no string escape that produces one:
# `\e`, `\x1b` and `\u001b` are all read errors, `$str/from_utf8` wants a
# `(Buffer U8)`, and there is no `chr`. So the byte sits in the source between
# the quotes. It is invisible in most editors and `cat -v` shows it as `^[`.
(const ESC "")

(fn colored [text : Str] : Str
  ($str/join [ESC "[94m" text ESC "[0m"] ""))

(fn user_prompt [] : Str
  # Colour only when a terminal is on the other end. Piped input is how the
  # regression sweep drives this, and escape bytes in that output would be
  # noise in a transcript nobody is looking at in colour.
  (if ($os/stdin_tty?) (colored "User>") "User>"))

(fn quitting? [line : Str] : Bool
  (if (== line "quit") true (== line "exit")))

(type TerminalOutput ^props {^raw Bool ^last Any})

(impl Callable for TerminalOutput
  (message apply [self call]
    (var event (/0 call))
    (if_yes (&& (! self/raw) (! ($absent? event/record))
                (== event/record/phase "raw_response")) (return nil))
    (if_yes (== event/kind "output")
      (var previous (self/last .get))
      (var duplicate false)
      (if_yes (&& (! ($absent? previous)) (! ($absent? event/record)))
        (set duplicate (&& (== event/record/phase "command_result")
          (== previous/phase "tool_result") (== previous/run event/record/run_id)
          (== previous/text event/text))))
      (self/last .set {^phase event/record/phase ^run event/record/run_id ^text event/text})
      (if_not duplicate ($println event/text)))))

# The driver's half of a turn is two calls with main.gene's `$os/read_line`
# between them, and neither of them waits for a person. That is what makes a
# wall-clock budget applicable at all: this file used to own both the loop and
# the read, so the `chat` profile's 120 000 ms deadline covered the whole
# conversation *and* the pauses in it, and a shell that answered one prompt and
# then sat idle expired at the keyboard. Handing the read back to the host also
# retires the active-row handoff that lived here — main.gene re-reads the row
# each turn, so a committed replacement takes effect at the next prompt without
# a hand-rolled check or a tail call into the successor.

(fn repl_prompt [greeted h] : Any
  # The greeting is one-shot state on the view rather than something activation
  # prints, because activation runs in the middle of boot output and this line
  # has to be the last thing before the first prompt.
  (if_not (greeted .get)
    (greeted .set true)
    ($println "Gene Agent — `/help` for commands, `quit` / Ctrl-D to leave"))
  # The prompt goes out with a newline rather than as `User> `. stdout is
  # line-buffered on a terminal and Gene exposes no flush, so a prompt
  # without a newline would sit in the buffer until after the answer it was
  # asking for — invisible exactly when it matters.
  ($println "")
  (var pending (pending_input h))
  (if_not ($absent? pending)
    ($println pending/request/prompt)
    (if_yes (== pending/request/kind "select")
      (var i 1)
      (for option in pending/request/options
        ($println $"  ${i}. ${option}") (set i (+ i 1))))
    (if_yes (== pending/request/kind "confirm") ($println "Enter yes or no."))
    ($println "Enter your answer, or /cancel to cancel the question."))
  ($println (user_prompt))
  nil)

(fn repl_line [h : Harness, line] : Any
  (if_yes (== line nil)
    # Ctrl-D. The host reads the line and reports EOF as nil, but what EOF
    # *means* is the view's call, so the decision to leave stays here.
    ($println "bye")
    (return 0))
  (var text ($str/trim line))
  (if_yes (quitting? text)
    ($println "bye")
    (return 0))
  (if_not ($absent? (pending_input h))
    (try (ask h line) catch Any ($println $"error: ${$err/message}"))
    (return nil))
  (if_yes (!= text "")
    # One speaker label per exchange. The agent may take several turns
    # after this, and those are marked as rounds rather than repeating
    # the label — the harness is still the one talking.
    ($println "Gene>")
    (try (ask h text) catch Any ($println $"error: ${$err/message}")))
  nil)

(type TerminalView ^props {^greeted Any})
(impl HarnessView for TerminalView
  (message show_prompt [h] : Any (repl_prompt self/greeted h))
  (message handle_line [h, line] : Any (repl_line h line)))

(fn driver_plugin [] : Plugin
  (Plugin ^id "driver" ^provides [["views" "active"]]
    ^requires ["HarnessPrompt"] ^contextual true
    ^activate (fn [] (fn [host]
      (host .PluginHost:subscribe HarnessLog
        (TerminalOutput ^raw (== ($os/env? "GENE_HARNESS_RAW") "1") ^last ($cell nil)))
      (host .PluginHost:contribute "views"
        {^name "active" ^implementation "terminal"
         ^value (view_provider (TerminalView ^greeted ($cell false)))})))))
