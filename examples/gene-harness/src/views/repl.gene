(mod repl)
(import ^from "../runtime/commands" [parse_submission submit_command cancel_command])
(import [mode_state mode_record submit_mode_input close_mode] ^from "../runtime/input_modes")
(import ^from "../runtime/round_controller" [submit_round round_state answer_round])
(import ^from "../runtime/sessions" [load_session])
(import ^from "../kernel" [HarnessEvent RoundChanged CommandChanged ModeChanged])

(fn print_question [question]
  ($println question/prompt)
  (if_not ($absent? question/choices)
    (var choice_index 1)
    (for choice in question/choices
      ($println choice_index ". " choice)
      (set choice_index (+ choice_index 1))))
  (if_not ($absent? question/recommended) ($println "Recommended: " question/recommended))
  ($println "Enter accepts the recommendation; - skips; /dismiss skips the batch."))

(fn answer_value [question, text : Str]
  (if (== text "-") (return (quote unanswered)))
  (if (&& (== text "") (! ($absent? question/recommended))) (return question/recommended))
  (if ($absent? question/choices) (return text))
  (if (== question/multi true)
    (then
      (let values [])
      (for number in ($str/split text ",")
        (let picked_index (- ($parse/parse_int ($str/trim number)) 1))
        (if (|| (< picked_index 0) (>= picked_index question/choices/.size))
          (fail "invalid choice"))
        (values .push question/choices/%picked_index))
      (return values)))
  (let choice_index (- ($parse/parse_int text) 1))
  (if (|| (< choice_index 0) (>= choice_index question/choices/.size)) (fail "invalid choice"))
  question/choices/%choice_index)

(fn read_run_command [runtime, raw : Str]
  (var code raw)
  (while ($parse/incomplete? code)
    ($print "... ")
    (let input ($os/read_line_async))
    (runtime/stdin_task .set input)
    (let outcome input/.join)
    (runtime/stdin_task .set nil)
    (match outcome
      (when (TaskOutcome/ok line)
        (if ($absent? line) (return nil))
        (set code $"${code}\n${line}"))
      (else (return nil))))
  $"/run ${code}")

(fn handle_repl_event [runtime, selected, answers, shown, interrupts, event]
  (match event ^exhaustive false
    (when (changed : ModeChanged)
      (if_yes (== changed/session selected/.get)
        (if ($absent? changed/mode)
          (then
            (if_yes interrupts/.get
              ($os/end_interrupt)
              (interrupts .set false))
            # Removal publishes this event while its load gate may be held.
            (let loaded (runtime/sessions/loaded/.get .get selected/.get))
            (let round loaded/round/.get)
            (if_yes (== round/state "waiting")
              (let saved (answers/.get .get selected/.get))
              (let index (?? saved/index 0))
              (print_question round/questions/questions/%index)))
          (else
            (if_not interrupts/.get
              (interrupts .set ($os/begin_interrupt))))))
      nil)
    (when (changed : RoundChanged)
      (let id changed/session)
      (let receipt changed/receipt)
      (let key $"${receipt/id}:${receipt/state}")
      (if (== (shown .get; .get key) true) (return nil))
      (shown
        .get
        ; .put key true)
      (if (== receipt/state "done") ($println $"[${id}] ${receipt/reply}"))
      (if (== receipt/state "failed") ($println $"[${id}] ${(?? receipt/request receipt/message)}"))
      (if (== receipt/state "waiting")
        (then
          (answers
            .get
            ; .put id {^batch receipt/questions/id ^index 0 ^values {}})
          (if ($absent? (mode_state runtime/modes id))
            (do ($println $"[${id}] Questions:")
                (print_question receipt/questions/questions/0)))))
      ($io/flush_stdout)
      nil)
    (when (changed : CommandChanged)
      (let id changed/session)
      (let record changed/record)
      (if_not ($absent? record/text) ($print $"[${id}] ${record/text}"))
      (if_not ($absent? record/display)
        ($println $"[${id}] ${record/display}")
        (if (== record/error_code "confirmation_required")
          ($println "Repeat /stop --confirm or /restart --confirm to stop those sessions.")))
      (if_not ($absent? record/selected) (selected .set record/selected))
      ($io/flush_stdout)
      nil))
  nil)

(fn chat [controller, selected : Str]
  (let runtime controller/runtime)
  (let session ($cell selected))
  (let answers ($cell {}))
  (let shown ($cell {}))
  (let interrupts ($cell false))
  (let interrupted ($cell false))
  (let polling ($cell true))
  (let poller (spawn ^lane root
    (while polling/.get
      ($sleep 5)
      (if_yes (&& interrupts/.get ($os/take_interrupt))
        (interrupted .set true)
        (let mode (mode_state runtime/modes session/.get))
        (if ($absent? mode/running)
          (then
            (let reader runtime/stdin_task/.get)
            (if_not ($absent? reader) reader/.cancel))
          (else (cancel_command runtime/commands session/.get mode/running)))))))
  (let subscription
    (runtime/h/bus .subscribe HarnessEvent
      (fn [event] (handle_repl_event runtime session answers shown interrupts event))))
  (try
   (while (! runtime/stopping/.get)
    (let selected_id session/.get)
    (let current_mode (mode_state runtime/modes selected_id))
    ($print (if ($absent? current_mode) $"${selected_id}> "
      $"${selected_id} ${current_mode/prompt}> "))
    ($io/flush_stdout)
    (interrupted .set false)
    (let input ($os/read_line_async))
    (runtime/stdin_task .set input)
    (let outcome input/.join)
    (runtime/stdin_task .set nil)
    (var text nil)
    (var halt false)
    (match outcome
      (when (TaskOutcome/ok value)
        (set text value))
      (when TaskOutcome/cancelled
        (set halt (! (&& interrupts/.get interrupted/.get))))
      (else
        ($println outcome)
        (set halt true)))
    (if halt (break))
    (if (&& interrupts/.get interrupted/.get) (continue))
    (if ($absent? text)
      (then
        (close_mode runtime/modes selected_id "eof")
        (for [id watcher] in controller/watchers/.get
          watcher/.join)
        (break)))
    (try
      (let mode (mode_state runtime/modes selected_id))
      (if_yes (! ($absent? mode))
        (var code text)
        (var eof false)
        (while ($parse/incomplete? code)
          ($print "... ")
          ($io/flush_stdout)
          (let reader ($os/read_line_async))
          (runtime/stdin_task .set reader)
          (let next reader/.join)
          (runtime/stdin_task .set nil)
          (match next
            (when (TaskOutcome/ok line)
              (if ($absent? line) (set eof true) (set code $"${code}\n${line}")))
            (else (set eof (! interrupted/.get))))
          (if (|| eof interrupted/.get) (break)))
        (if_yes eof (close_mode runtime/modes selected_id "eof") (break))
        (if interrupted/.get (continue))
        (let record (submit_mode_input runtime/modes selected_id mode/instance
          ($crypto/random_hex 16) code))
        (if_not ($absent? record/id)
          (runtime/commands/watchers/.get .get $"${selected_id}:${record/id}"; .join))
        (continue))
      (let state (load_session runtime/sessions selected_id))
      (let round state/round/.get)
      (if_yes (&& (! ($absent? round)) (== round/state "waiting") (== text "/dismiss"))
        (answer_round ^^dismiss controller selected_id round/questions/id {})
        (continue))
      (let parsed (parse_submission runtime/h text))
      (if (== parsed/kind "command")
        (then
          (let command (if (== parsed/name "run") (read_run_command runtime parsed/raw) text))
          (if ($absent? command) (break))
          (let record (submit_command runtime/commands selected_id command))
          (if_not ($absent? (mode_record runtime/h/snapshots/current/.get parsed/name))
            (runtime/commands/watchers/.get .get $"${selected_id}:${record/id}"; .join)))
        (else (if (&& (! ($absent? round)) (== round/state "waiting"))
          (then
            (var current (answers .get; .get selected_id))
            (if ($absent? current)
              (then
                (set current {^batch round/questions/id ^index 0 ^values {}})
                (answers
                  .get
                  ; .put selected_id current)))
            (let question_index current/index)
            (let question round/questions/questions/%question_index)
            (let value (answer_value question text))
            (if (!= value (quote unanswered)) (current/values .put question/id value))
            (current .put "index" (+ current/index 1))
            (if (== current/index round/questions/questions/.size)
              (answer_round controller selected_id round/questions/id current/values)
              (do
                (let next_index current/index)
                (print_question round/questions/questions/%next_index))))
          (else
            (let sequence (round_state controller selected_id))
            (submit_round
              controller
              selected_id
              $"cli-${sequence/next_seq}"
              sequence/next_seq
              parsed/text)))))
    catch Any
      ($println $err/message)))
  ensure
    (polling .set false)
    poller/.cancel
    poller/.join
    subscription/.cancel
    (if interrupts/.get ($os/end_interrupt))
    (close_mode runtime/modes session/.get "cli_closed"))
  runtime/exit_code/.get)
