# Model-backed agent and plugin author. Replies are validated Gene data:
# pure programs, host-owned tool requests, durable questions, or final text.
# The model receives read-only inspection data and explicit operations.
# Operational functionality comes from plugin-owned tool rows.

(mod llm)

(import $fs [read_text])
(import [model_name chat_completion] ^from "./model_client")
(import [parse_envelope reply_format_prompt] ^from "./model_reply")
(import [execute_tool resume_tool] ^from "../runtime/tools")
(import [request_input pending_input] ^from "../runtime/interactions")
(import [HarnessResume] ^from "../seams")
(import [Plugin PluginContext PluginHost Harness HarnessError CommandError HarnessPreview
         uninstall retry resolve bound_seams registry_row_keys
         plugin_states plugin_ids status_of installed lifecycle_log log_append
         log_events current_run_id publish render_prompt doc transaction_diff
         describe_tools describe_tool module_dir]
  ^from "../kernel")
(import [ExecutionLimits] ^from "../plugin_api")
(import_impl PluginHost for PluginContext ^from "../kernel")
(import [HarnessPrompt HarnessCodegen prompt_provider codegen_provider] ^from "../seams")
(import [dispatch] ^from "./agent")
(import [register_module run_workspace_turn] ^from "../storage/workspace")

(var turn_limit 16)

# ---------------------------------------------------------------------------
# What the generated program may reach
# ---------------------------------------------------------------------------

# --- the shapes Gene's path syntax cannot express ---------------------------
#
# `xs/.size` and `xs/%i` work only on a *named binding*, so an expression needs
# the long form `((c .get) .size)`. A model reaches for path syntax there
# constantly because the extra grouping is easy to forget under pressure.
# These four are the shapes it kept needing, and they
# are ordinary functions rather than a tool layer — the model can still do
# anything, it just no longer has to route a list operation through a temporary.

(fn size [xs] : Int xs/.size)

(fn at [xs, i : Int] xs/%i)

(fn drop_first [xs, n : Int] : Any
  (var out [])
  (var i n)
  (while (< i xs/.size)
    (out .push xs/%i)
    (set i (+ i 1)))
  out)

(fn without [xs, v] : Any
  (var out [])
  (for x in xs (if_not (== x v) (out .push x)))
  out)

(fn harness_bindings [h : Harness, queued,
                      ^session session = nil, ^state_host state_host = nil,
                      ^payload payload = nil, ^prompt prompt : Str = "",
                      ^round round : Int = 1] : Any
  # Only inert snapshots and named operations cross into model code. Runtime
  # cells, provider values, plugin contexts and concrete tools remain private.
  (var data ($freeze (if ($absent? payload) {} payload)))
  (var current_session ($freeze
    {^id h/event_stream ^scope h/event_scope
     ^history (if ($absent? session) [] (session .get))}))
  (var inspection ($freeze {^session current_session ^plugins (plugin_states h)
    ^tools (describe_tools h) ^seams (bound_seams h)}))
  (var context ($freeze {^session current_session ^payload data ^prompt prompt ^round round}))
  {^h inspection ^harness inspection ^session current_session ^context context
   ^payload data ^get_payload (fn [] data)
   ^uninstall (fn [id] (uninstall h id))
   ^retry (fn [id] (retry h id))
   ^register_module
     (fn [id, source,
          ^scope scope : Str = "session",
          ^selectors selectors = nil,
          ^limits limits = nil,
          ^dependencies dependencies = nil,
          ^by by : Str = "",
          ^model model : Str = "",
          ^at at_value : Str = "",
          ^replace replace_value : Bool = false]
       # Registration writes a blob, loads the module and runs its `init`, all
       # of which need host authority the program does not have — and grants
       # only attenuate, so calling through from in here could never do
       # anything but refuse. It did, four times in one recorded session, with
       # "fs/exists? needs fs/ReadDir" and a burnt turn each time. So this
       # validates what it can cheaply and queues the rest for `run_program`,
       # which is outside the sandbox and still inside the turn.
       (if_not (== ($head id) Str)
         (fail (HarnessError
           ^message "register_module id must be a string")))
       (if_yes (== ($to_str id) "")
         (fail (HarnessError ^message "register_module id is empty")))
       (if_not (== ($head source) (quote mod))
         (fail (HarnessError
           ^message $"register_module source for ${id} must be a quoted mod node")))
       (queued .push
         {^id ($to_str id) ^source source ^scope scope ^selectors selectors
          ^limits limits ^dependencies dependencies ^by by ^model model
          ^at at_value ^replace replace_value})
       $"queued ${id}; the harness registers it when this turn ends")
   ^row_keys (fn [registry_name] ($freeze (registry_row_keys h registry_name)))
   ^tools (fn [] (describe_tools h))
   ^describe_tool (fn [name] (describe_tool h name))
   ^bound_seams (fn [] ($freeze (bound_seams h)))
   ^plugin_states (fn [] ($freeze (plugin_states h)))
   ^plugin_ids (fn [] ($freeze (plugin_ids h)))
   ^status_of (fn [id] (status_of h id))
   ^installed (fn [] ($freeze (installed h)))
   ^transaction_diff (fn [] ($freeze (transaction_diff h)))
   ^lifecycle_log (fn [] ($freeze (lifecycle_log h)))
   ^doc (fn [name] (doc h name))
   ^HarnessError HarnessError
   ^size size ^at at ^drop_first drop_first ^without without})

(fn run_program [h : Harness, program,
                 ^session session = nil, ^state_host state_host = nil,
                 ^payload payload = nil, ^prompt prompt : Str = "",
                 ^round round : Int = 1, ^author author = nil,
                 ^evaluation_limits evaluation_limits = nil,
                 ^raise_errors raise_errors : Bool = false] : Str
  # One `(do ...)` block, evaluated as written. The shape the model emits is the
  # shape that runs, so a program may define something and then use it.
  #
  # Model code has no host authority. It sees immutable inspection data and
  # explicit transaction-aware operations; operational work uses tool requests.
  # Registration is queued until the restricted evaluator has returned.
  (var queued ($thaw #[]))
  (var bindings (harness_bindings h queued ^session session ^state_host state_host
                  ^payload payload ^prompt prompt ^round round))
  (var limits (if ($absent? evaluation_limits)
    (ExecutionLimits ^max_steps 100000 ^max_memory_mb 64 ^timeout_ms 2000)
    evaluation_limits))
  (var sandbox
    (env ^bindings bindings ^capabilities []
      ^policy {^max_steps limits/max_steps ^max_memory_mb limits/max_memory_mb
               ^timeout_ms limits/timeout_ms}))
  (var existing_events (log_events h))
  (var turn_id $"model-${(+ existing_events/.size 1)}")
  (var run_id (current_run_id h))
  (if_not (== run_id "") (set turn_id $"${run_id}/round-${round}"))
  (var outcome
    (run_workspace_turn h/workspace h turn_id
      (fn [ignored]
        (var rendered
          (try
            $"${(eval program ^in sandbox)}"
          catch MissingCapability
            # A denial is a value shown to the next model round.
            (if_yes raise_errors
              (fail (CommandError ^code "code_error"
                ^message $"refused: ${$err/operation} needs ${$err/capability}")))
            $"refused: ${$err/operation} needs ${$err/capability}"
          catch Any
            (if ($str/contains? $err/message " requires ")
              (do
                (var message $"refused: ${$err/message}")
                (if_yes raise_errors (fail (CommandError ^code "code_error" ^message message)))
                message)
              (fail $err))))
        # Drained here and not in the sandbox: this callback runs under the
        # caller's capability context (`invoke_bounded ^inherit true`), which
        # is the only point in the round that still holds the authority a
        # registration needs. A failure raises like any other error in the
        # body, so a module that will not load never becomes a revision.
        (for request in queued
          # A direct user command supplies its own provenance; model callers
          # retain the existing default. Explicit registration authors win.
          (var by (if (== request/by "")
            (if ($absent? author) "program/model" author/by) request/by))
          (var model (if (== request/model "")
            (if ($absent? author) (model_name) author/model) request/model))
          (var at (if (== request/at "") ($to_str (gene/now)) request/at))
          (var registered
            (register_module h/workspace h request/id request/source
              ^scope request/scope ^selectors request/selectors
              ^limits request/limits ^dependencies request/dependencies
              ^by by ^model model ^at at
              ^replace request/replace))
          # The program cannot observe its own registration — it committed
          # after the program returned — so the result has to say it happened.
          (set rendered
            $"${rendered}\nregistered ${request/id} at revision ${registered/revision}"))
        rendered)
      # `default_execution_limits` is 2 000 ms, which suits a local callback
      # and not a body that may hash a module, write a blob, load it and run
      # its `init`. Steps and memory stay where they are — those guard against
      # code that runs away, and neither is loosened by admitting that writing
      # to disk takes time. Same trade `profiles/chat.gene` makes for a
      # command that waits on a model.
      ^limits (ExecutionLimits ^max_steps 1000000 ^max_memory_mb 64
                               ^timeout_ms 30000)))
  (if (== outcome/status "aborted")
    (do
      (if_yes (&& raise_errors (== ($head outcome/error) CommandError))
        (fail outcome/error))
      (var message $"error: ${outcome/error/message}")
      (if_yes raise_errors (fail (CommandError ^code "code_error" ^message message)))
      message)
    ($to_str outcome/result)))

# ---------------------------------------------------------------------------
# Talking to the model
# ---------------------------------------------------------------------------

(fn harness_primer [h : Harness] : Str
  # Plugin-authored prompt sections and pull introspection share the same rows;
  # there is no second hand-maintained command/tool inventory here.
  (render_prompt h))

(fn repository_root [] : Str
  (module_dir (module_dir (module_dir (module_dir (module_dir this_mod/.path))))))

(fn gene_skill_file [relative : Str] : Str
  (read_text $"${(repository_root)}/tools/gene-lang-skill/${relative}"))

(fn system_prompt [h : Harness] : Str
  $"""${(reply_format_prompt)}

You are the agent inside a durable Gene plugin harness. Help the user complete
real work, and build missing capabilities as plugins when needed.

Use type "tool" to call a registered tool. The host runs it under its plugin's
policy. Tool inputs follow the schema below. Tool requests execute after your
restricted model context ends, so they can perform permitted real I/O.

Registered tools (the live registry is authoritative):
${(describe_tools h)}

Pure Gene code can calculate and inspect data. Its session, harness/h, context
and payload bindings are read-only snapshots. session contains id, scope and a
history list. harness contains session, plugins, tools and seams; it has no live
runtime cells. context contains session, payload, prompt and round.
(tools), (describe_tool name), (row_keys registry), (plugin_states), (doc name),
(status_of id), and (bound_seams) inspect the current system.

${(harness_primer h)}

Code holds no host authority. Do not call fs, network, process operations,
concrete provider constructors, or invoke_registry from it. Request a tool
instead. register_module is a transaction-aware core operation: it queues an
inert quoted plugin module for validation and durable registration when the
program ends. The installed tools become callable in the next step.

If a capability is missing, say what is missing and build the real capability
or ask for the required configuration. Do not substitute a simulated answer
for an operation the user requested. Tool errors are observations to resolve,
not successful results. Never claim a file changed unless the tool result
confirms it. Return exactly one map with ^type and no surrounding prose.""")

(fn call_model [h : Harness, prompt : Str, history : Str, ^on_delta on_delta = nil] : Str
  (chat_completion (system_prompt h)
    $"${prompt}\n\nPrior turns:\n${history}" ^on_delta on_delta))

# ---------------------------------------------------------------------------
# One task, however many turns it takes
# ---------------------------------------------------------------------------

(fn tail_preview [text : Str] : Str
  # The *end* of the reply, because that is where a truncated or unbalanced
  # module goes wrong. The opening lines of a module are always the same two
  # imports and tell you nothing.
  (var size ($str/byte_size text))
  (if (> size 300)
    ($str/join ["... " ($str/slice_bytes text (- size 300) size)] "")
    text))

(fn preview [text : Str] : Str
  (if (> ($str/byte_size text) 400)
    ($str/join [($str/slice_bytes text 0 400) " ..."] "")
    text))

(fn failed? [result : Str] : Bool
  # `run_program` renders an ordinary mistake as "error: ..." and a capability
  # denial as "refused: ...". Only the first is the model's to fix: an error is
  # a bug in the code it just wrote, while a refusal is a fact about authority
  # that writing different code will not change. A continuing code reply gets
  # correction guidance for errors; code-with-response returns either directly.
  ($str/starts_with? result "error:"))

(fn emit_output [h : Harness, text : Str,
                 ^phase phase : Str = "narration", ^round round : Int = 0,
                 ^block_id block_id : Str = ""]
  (log_append h "output" text ^phase phase ^round round ^block_id block_id))

(fn run_task [h : Harness, prompt : Str, session, state_host,
              ^complete complete = nil, ^history history_override = nil,
              ^start_round start_round : Int = 0] : Str
  # Intermediate narration/results are emitted as they happen. The final
  # response is returned to ask, which emits it once and flushes the session.
  (var history (?? history_override (remembered session)))
  (var turn start_round)
  (var running true)
  (var last "")
  (while running
    (set turn (+ turn 1))
    (if_yes (> turn 1) (emit_output h $"== Round ${turn} ==" ^phase "round_marker" ^round turn))
    (var run_id (current_run_id h))
    (var raw_id $"${run_id}/raw-${turn}")
    (var raw
      (if ($absent? complete)
        (call_model h prompt history
          ^on_delta (fn [text]
            (if_yes (!= run_id "")
              (publish h (HarnessPreview ^run_id run_id ^block_id raw_id
                ^text text ^phase "raw_response" ^round turn)))))
        (complete h prompt history)))
    # Browser runs retain the original reply, including malformed replies and
    # final text envelopes. Capture before parsing; never evaluate this copy.
    (if_yes (!= (current_run_id h) "")
      (emit_output h raw ^phase "raw_response" ^round turn ^block_id raw_id))
    (var problem "")
    (var envelope
      (try (parse_envelope raw)
        catch HarnessError
        (set problem $err/message)
        nil))
    (if ($absent? envelope)
      (then
        (set last $"invalid model reply: ${problem}")
        (emit_output h $"(${last}; asking again)")
        (set history $"${history}\nYOUR LAST REPLY WAS DISCARDED: ${problem}.\nIt began: $(preview raw)\n${(reply_format_prompt)}"))
      (elif (== envelope/type "response")
        (set last envelope/response)
        (set running false))
      (elif (== envelope/type "tool")
        (if_not ($absent? envelope/response)
          (emit_output h envelope/response ^round turn))
        (var result (execute_tool h envelope/tool envelope/input ^round turn
          ^continuation {^kind "tool" ^prompt prompt ^history history ^round turn}))
        (if (== result/waiting true)
          (then (set last "") (set running false))
          (else
            (set last ($to_str result))
            (set history $"${history}\nTool ${envelope/tool} input: ${envelope/input}\nResult: ${result}\nContinue from this observed result. Do not claim success when ok is false."))))
      (elif (== envelope/type "input")
        (request_input h envelope/request
          {^kind "agent" ^prompt prompt ^history history ^round turn})
        (set last "")
        (set running false))
      (else
        # Both code types may narrate intent before execution. That text is
        # optional, and for code-with-response the result is the final answer.
        (var narration (?? envelope/response ""))
        (if_yes (!= narration "") (emit_output h narration ^round turn))
        (emit_output h ($to_str envelope/code) ^phase "code" ^round turn)
        (var result
          (run_program h envelope/code ^session session ^state_host state_host
            ^payload (?? envelope/payload {}) ^prompt prompt ^round turn))
        (set last result)
        (if (== envelope/type "code-with-response")
          (then (set running false))
          (else
            (emit_output h "-- Result  --" ^phase "result_marker" ^round turn)
            (emit_output h result ^phase "result" ^round turn)
            (set history $"${history}\nreply: ${envelope}\noutput: ${result}\nThe code has executed. Decide from the result: finish with type response, or send more code.")
            (if_yes (failed? result)
              (set history $"${history}\nThat program failed. Correct the reported error; do not repeat the failed call or report success."))))))
    (if_yes (&& running (>= turn turn_limit))
      (fail (CommandError ^code "step_limit"
        ^message $"The agent reached its ${turn_limit}-step limit. Last result: ${(preview last)}"))))
  # Retain the actual answer, not a progress sentence or a '(no action)' marker.
  (if ($absent? (pending_input h)) (remember session state_host prompt last))
  last)

(fn strip_slash [prompt : Str] : Str
  # Drop one leading `/` and keep every other one: `/read a/b` is `read a/b`,
  # because a path argument has slashes and they are not the prefix.
  (var parts ($str/split prompt "/"))
  (var out [])
  (var i 1)
  (while (< i parts/.size)
    (out .push parts/%i)
    (set i (+ i 1)))
  ($str/trim ($str/join out "/")))

(fn answer [h : Harness, prompt : Str, session, state_host,
            ^complete complete = nil] : Str
  # Only an explicit slash selects a command. Every other prompt, including
  # one word such as "help" or a sentence starting with "build", reaches the
  # same model loop. Trim for routing while preserving the model's input.
  (var command ($str/trim prompt))
  (if ($str/starts_with? command "/")
    (then (dispatch h (strip_slash command)))
    (else (run_task h prompt session state_host ^complete complete))))

# ---------------------------------------------------------------------------
# Session memory
# ---------------------------------------------------------------------------
#
# The archived `safe_ai_agent` example discarded history when a task finished,
# which is right for a task runner and wrong for a shell: the second thing
# anyone types is "now remove it". Without a carry-over the model guessed a
# plugin name out of the system prompt's example and uninstalled something that
# was never there.
#
# So a bounded window of completed exchanges rides along, separate from the
# within-task history that already accumulates per turn. Bounded because a
# session is open-ended — this is the one place in the harness where unbounded
# growth would be invisible until a context limit turned into a 400.

(var session_window 4)

(fn remembered [session] : Str
  (var lines (session .get))
  ($str/join lines "\n"))

(fn remember [session, state_host, prompt : Str, result : Str]
  (var lines (session .get))
  (lines .push $"you: ${prompt}\nharness: $(preview result)")
  (var kept [])
  (var start (- lines/.size session_window))
  (var i (if (< start 0) 0 start))
  (while (< i lines/.size)
    (kept .push lines/%i)
    (set i (+ i 1)))
  (session .set kept)
  (state_host .PluginHost:update_state {^history kept}))

# ---------------------------------------------------------------------------
# The model as the author of a plugin
# ---------------------------------------------------------------------------
#
# `build <name> <what it should do>` used to fill a template, so the harness
# could install code at runtime but only ever *that* code — the dummy tool that
# echoes its own description back. Behind the `HarnessCodegen` seam the same
# command asks a model to write the module instead, and nothing else about
# `build` changes: `build_tool` still resolves a seam, still hands the result
# to `register_module`, and still cannot tell which provider answered.
#
# The safety argument is unchanged too, and it is the reason this is allowed to
# be a model at all. The reply is *text*, parsed into an inert quoted node and
# never evaluated as text. Everything that decides whether it is a legal module
# already existed for the template: `canonical_module_source` requires a
# `(mod plugin ...)` root, an inert top level, a defined `init`, and imports
# inside the declared closure; `describe_plugin_module` runs that `init` under
# `^capabilities []` and the step/time/memory ceiling; the loader pins an
# immutable policy to the sandbox module. A model that writes something hostile
# is refused by the same code that refuses a typo.

(fn codegen_skill_text [] : Str
  # The same checked-in skill the agent plugin pushes and pulls from, and an
  # author needs it more than a dispatcher does. The module contract in the
  # prompt is what the *loader* checks; this is what makes the body between the
  # parens actually run when someone invokes the tool.
  ($str/join [(gene_skill_file "SKILL.md")
              (gene_skill_file "reference/pitfalls.md")
              (gene_skill_file "reference/stdlib.md")]
    "\n\n"))

(fn plugin_module_contract [] : Str
  """A plugin is an inert module node with a descriptor and plugin-owned tools:

(mod plugin
  (import [Plugin DescriptorContext PluginContext PluginHost ToolError]
    ^from "../../../src/plugin_api")
  (import_impl PluginHost for PluginContext ^from "../../../src/kernel")
  (fn measured [result]
    (if_not result/ok
      (fail (ToolError ^code result/error/code ^message result/error/message
        ^data (?? result/error/details nil))))
    ($str/byte_size result/value/text))
  (fn run [host input]
    (host .PluginHost:request_tool "fs.read" input ^continuation measured))
  (fn init [ctx : DescriptorContext] : Plugin
    ^capabilities []
    (Plugin ^id "file_length" ^contextual true
      ^provides [["tools" "file_length"]] ^requires [["tools" "fs.read"]]
      ^activate (fn [] (fn [host]
        (host .PluginHost:contribute "tools"
          {^name "file_length" ^doc "Count UTF-8 bytes in a file"
           ^contextual true ^run run
           ^input_schema {^type "object" ^required ["path"]
             ^properties {^path {^type "string"}
               ^root {^type "string" ^enum ["workspace" "state"]}}
             ^additionalProperties false}}))))))

The root must be (mod plugin ...). Its top level contains only declarations
(import/import_impl/fn/type/impl/protocol/alias/enum). init takes one
DescriptorContext, declares ^capabilities [], and only constructs a descriptor.
activate is a thunk returning a host callback. The descriptor id must equal
the requested plugin name. Tools may have different names; advertise them all.

A tool accepts a structured data value and returns data. Set ^contextual true
on a tool row to receive (host input); otherwise its run receives only input.
Supply an input_schema with type, properties, required and additionalProperties
for object inputs. Primitive inputs and reflected positional/named envelopes
are supported too. Tool results delivered by the host are {^ok true ^value ...}
or {^ok false ^error {^code ... ^message ...}}.

For composition, declare ^requires [["tools" "callee"]]. Return
(host .PluginHost:request_tool "callee" input ^continuation (fn [result] ...)).
The host performs the callee after your callback returns and then invokes your
continuation under your plugin policy. Without a continuation the callee's
result is forwarded. Do not expect request_tool to return the callee's value
inside your callback. A continuation can return another request; chains are
bounded. Tool removal makes dependent plugins pending automatically. Throw
ToolError with code, message and optional data for a failed operation; returning
an ordinary map containing ok:false is just a successful data value.

For durable configuration, return
(host .PluginHost:request_input {^kind "text" ^prompt "Your name?"}
  "my_plugin.finish" {^saved "data"}). The resume tool must belong to your own
plugin. It receives {^input <saved data> ^reply {^id ... ^value ... ^cancelled false}}.
Persist configuration with PluginHost:update_state there. For asynchronous computation, a tool may return ToolTask with a task and
optional result continuation; import ToolTask from plugin_api. Return the wrapper
instead of waiting inside a bounded callback. Its task retains its execution
budget and is cancelled with the run.

The host saves only
inert data, never a function continuation or live resources, and rejects a
changed plugin version on resume. An input request cannot cross a pending
function continuation: use a named resume tool as the step boundary instead.

Use (host .PluginHost:state) and (host .PluginHost:update_state data) for durable
plugin state. There are no private snapshot files. State scope follows the
plugin's session/workspace scope. Never retain live resources in persisted data.

Normally delegate I/O to installed tools and keep selectors empty. A plugin
that performs file I/O itself can import $fs and request an attenuated selector:
{^type "fs/ReadDir" ^root "workspace" ^path "."}. Supported selector types are
fs/ReadDir, fs/WriteDir and fs/ReadWriteDir; roots are workspace and state.
Selectors cannot grant authority absent from the launcher. Do not imitate an
unavailable operation. Explain the missing requirement instead.

Additional imports must be capability-enabled namespaces, versioned shared
contracts, or declared content-addressed dependencies. The kernel import above
is allowed only for import_impl PluginHost for PluginContext, never utilities.
Shared seam protocols may be imported from ../../../src/seams.
""")

(fn codegen_system_prompt [skill : Str] : Str
  ($str/join [
  (reply_format_prompt)
  """

For this plugin-authoring request, use type "response", a short ^response
string, and ^payload {^module (mod plugin ...) ^scope "session" ^selectors [] ^dependencies []}. The module is an inert Gene
node in payload, not a string and not a quoted expression. Do not return ^code.
The consumer validates and registers payload/module with the declared scope, selectors and dependency modules; it never evaluates source text. Prefer delegating to existing tools over adding I/O authority.
Example envelope (replace the module with the complete implementation):
{^type "response" ^response "Here is the plugin."
 ^payload {^module (mod plugin ...)}}

The module in payload/module must follow this contract:

"""
  (plugin_module_contract)
  """
Gene is not the Lisp you are thinking of, and the reference below is
authoritative — read it before you write the body of `run`. The ones that have
actually cost a build here:
  - stdlib names carry a `$`: ($str/join [a b] ""), ($to_str n), ($println x).
    A bare `str`, `join`, `filter` or `println` is an undefined symbol.
  - `map` and `filter` are *stream* operations, not list ones. On a list, loop:
    (var out []) (for x in xs (if_yes (test x) (out .push x))) — or count with
    a (var n 0) and (set n (+ n 1)).
  - there is no `let`. (var x expr) declares, (set x expr) assigns, and both are
    statements in the enclosing body.
  - length is xs/.size on a *named binding*; ($str/byte_size s) for a string.
    You cannot write the size of an expression, so bind it first.
  - index with a *literal* as xs/0 and with a *variable* as xs/%i. Writing
    xs/i where i is a variable is a property lookup that quietly yields void,
    and you find out several lines later when something else rejects it.
  - ($str/split s sep) needs a non-empty sep; splitting on "" to reach the
    characters of a string is an error, not a trick.
  - ($str/join xs sep) requires every item of xs to already be a Str. Map
    ($to_str x) over anything else first.
  - $regex has replace, replace_all and split if you need them; $str does not.
  - (if cond a b) takes exactly ONE expression per arm. Two forms in a branch
    need (if cond (then x y) (else z)) — and a `var` declared inside an arm is
    gone after it, so bind above the `if` and (set ...) inside.
  - the $str namespace is exactly: byte_size contains? ends_with? from_utf8
    join lower slice_bytes split starts_with? to_utf8 trim. There is no
    `upper`, no `replace`, no `pad`, no `index_of`. Never call a function that
    is not there: nothing checks the body of `run` until someone invokes the
    tool, so a guessed name is a plugin that installs cleanly and then fails in
    the user's hands. Build what you need from the list, delegate to an installed tool, or report
    the missing capability explicitly. Do not return a simulated operation.

Return exactly one response envelope with the complete module in ^payload
under ^module. The two import paths in that module are
"../../../src/plugin_api" and "../../../src/kernel".

# Gene reference

"""
  skill] ""))

(fn codegen_request [name : Str, request : Str] : Str
  $"""Tool name: ${name}
It should: ${request}

Reply with one Gene map: ^type "response", a short ^response, and
^payload {^module (mod plugin ...)} containing the complete module.""")

(fn module_from_reply [reply : Str] : Any
  (var envelope (parse_envelope reply))
  (if_not (== envelope/type "response")
    (fail (HarnessError ^message "plugin author must return a response envelope")))
  (var payload (?? envelope/payload {}))
  (var form payload/module)
  (if_not (== ($head form) (quote mod))
    (fail (HarnessError ^message "plugin author must return a module node in ^payload/^module")))
  {^module form ^scope (?? payload/scope "session")
   ^selectors (?? payload/selectors []) ^dependencies (?? payload/dependencies [])})

(fn validate_author_code [value, ^depth depth : Int = 0]
  (if ($leaf? value) (return nil))
  (if (> depth 128) (fail (HarnessError ^message "Generated code is nested too deeply.")))
  (var head ($head value))
  (if (== head List)
    (then (for child in value (validate_author_code child ^depth (+ depth 1))))
    (elif (== head Map)
      (for [key child] in value (validate_author_code child ^depth (+ depth 1))))
    (elif (== ($head head) Sym)
      (var body ($node/body value))
      (if_yes (&& (== head (quote if)) (> body/.size 2))
        (var tagged false)
        (var i 1)
        (while (< i body/.size)
          (if_yes (["then" "else" "elif"] .contains? ($to_str ($head body/%i)))
            (set tagged true))
          (set i (+ i 1)))
        (if_yes tagged
          (if_not (== ($head body/1) (quote then))
            (fail (HarnessError ^message "Do not mix if branch styles. Use (if condition (then ...) (else ...)).")))
          (set i 2)
          (while (< i body/.size)
            (if_not (["else" "elif"] .contains? ($to_str ($head body/%i)))
              (fail (HarnessError ^message "A tagged if needs an explicit else/elif for every following branch.")))
            (set i (+ i 1)))))
      (for child in body (validate_author_code child ^depth (+ depth 1)))
      (for [key child] in ($node/props value) (validate_author_code child ^depth (+ depth 1)))))
  nil)

(fn model_plugin_source [name : Str, request : Str, skill : Str, ^on_reply on_reply = nil] : Any
  # The envelope and module are read as inert data. The author never runs code;
  # the existing registration path still validates and canonicalizes the module.
  (var prompt (codegen_request name request))
  (var attempt 0)
  (var problem "")
  (while (< attempt 3)
    (set attempt (+ attempt 1))
    (var reply (chat_completion (codegen_system_prompt skill) prompt))
    (if_not ($absent? on_reply) (on_reply reply))
    (var plan
      (try
        (var candidate (module_from_reply reply))
        (validate_author_code candidate/module)
        candidate
      catch HarnessError (set problem $err/message) nil))
    (if_not ($absent? plan) (return plan))
    (set prompt $"${(codegen_request name request)}\nYour previous reply failed validation: ${problem}\nReturn a corrected complete envelope. Use explicit (then ...) and (else ...) branches consistently.\nPrevious reply:\n${reply}"))
  (fail (HarnessError ^message $"Plugin author could not produce a valid module for ${name}: ${problem}")))

(type ModelCodegen ^props {^model Str ^skill Str})

(impl HarnessCodegen for ModelCodegen
  (message generate [name : Str, request : Str, ^on_reply on_reply = nil] : Any
    (model_plugin_source name request self/skill ^on_reply on_reply))
  (message author [] : Any
    # `self/model` is the model that was configured when this provider was
    # bound, which is the one that answered — not whatever the environment
    # says now.
    {^by "codegen/model" ^model self/model}))

(fn model_codegen_plugin [] : Plugin
  # Same id and same seam as the template provider in agent.gene. A deployment
  # binds one or the other, never both — which is the `fs` provider argument
  # (§3.8) applied to authorship: `chat` and `web` differ in what `build` can
  # write, and in nothing else.
  (Plugin ^id "codegen" ^provides ["HarnessCodegen"]
    ^contextual true
    ^activate (fn [] (fn [host]
      (host .PluginHost:contribute "seams"
        {^name "HarnessCodegen" ^private true ^value (codegen_provider
          (ModelCodegen ^model (model_name) ^skill (codegen_skill_text)))})))))

(type LlmAgent ^private true ^props {^model Str ^session Any ^state_host PluginContext})

(impl HarnessPrompt for LlmAgent
  (message handle [h, prompt : Str] : Str
    (answer h prompt self/session self/state_host)))

(impl HarnessResume for LlmAgent
  (message resume [h, continuation, reply] : Str
    (if_yes (== continuation/kind "tool")
      (var result (resume_tool h continuation reply))
      (if (== result/waiting true) (return ""))
      (return (run_task h continuation/prompt self/session self/state_host
        ^history $"${continuation/history}\nTool ${continuation/tool} resumed after input. Result: ${result}"
        ^start_round (+ continuation/round 1))))
    (run_task h continuation/prompt self/session self/state_host
      ^history $"${continuation/history}\nThe user answered question ${reply/id}: ${reply/value}"
      ^start_round continuation/round)))

(fn llm_prompt_text [] : Str
  "Tools are plugin-owned registry entries. Use type tool with a tool name and structured input; the host executes it and returns a result for your next step. Use (tools) and (describe_tool name) for current contracts. For creating a durable plugin, read (doc \"plugin/module\") and use register_module with a quoted module. Model code sees read-only snapshots and transaction-aware operations, never live Harness cells. Gene language references are available through doc: gene/pitfalls, gene/syntax, gene/declarations, gene/control_flow and gene/stdlib.")

(fn llm_agent_plugin [] : Plugin
  (Plugin ^id "agent"
    ^provides [["seams" "HarnessPrompt"] ["prompt" "llm_agent"]
               ["prompt" "plugin/module"]
               ["prompt" "gene/language"] ["prompt" "gene/pitfalls"]
               ["prompt" "gene/syntax"] ["prompt" "gene/declarations"]
               ["prompt" "gene/control_flow"] ["prompt" "gene/stdlib"]]
    ^contextual true
    ^activate (fn [] (fn [host]
      (var restored (host .PluginHost:state))
      (var history ($thaw (if (== restored nil) #[] (?? restored/history #[]))))
      (host .PluginHost:contribute "seams"
        {^name "HarnessPrompt" ^private true ^value (prompt_provider
          (LlmAgent ^model (model_name) ^session ($cell history)
                    ^state_host host))})
      (host .PluginHost:contribute "prompt"
        {^name "llm_agent" ^text (llm_prompt_text)})
      # Pull-only: the contract is a page, and only a turn that actually
      # queues a module needs it. `build`'s author gets the same text pushed,
      # because writing the module is the whole of its job.
      (host .PluginHost:contribute "prompt"
        {^name "plugin/module" ^text (plugin_module_contract)
         ^pull_only true})
      # The checked-in Gene language skill is the one source for both pushed
      # guidance and pull introspection. References stay out of every request
      # until the model asks for one through `doc`.
      (host .PluginHost:contribute "prompt"
        {^name "gene/language" ^text (gene_skill_file "SKILL.md")})
      (host .PluginHost:contribute "prompt"
        {^name "gene/pitfalls"
         ^text (gene_skill_file "reference/pitfalls.md") ^pull_only true})
      (host .PluginHost:contribute "prompt"
        {^name "gene/syntax"
         ^text (gene_skill_file "reference/syntax.md") ^pull_only true})
      (host .PluginHost:contribute "prompt"
        {^name "gene/declarations"
         ^text (gene_skill_file "reference/declarations.md") ^pull_only true})
      (host .PluginHost:contribute "prompt"
        {^name "gene/control_flow"
         ^text (gene_skill_file "reference/control-flow.md") ^pull_only true})
      (host .PluginHost:contribute "prompt"
        {^name "gene/stdlib"
         ^text (gene_skill_file "reference/stdlib.md") ^pull_only true})))))
