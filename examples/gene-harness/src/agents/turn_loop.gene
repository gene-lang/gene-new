(mod turn_loop)
(import [effective_config] ^from "../runtime/settings_resolver")
(import ^from "../runtime/composition" [acquire_snapshot release_snapshot current_snapshot])
(import ^from "./harness_turn" [evaluate_harness_turn])
(import [ui_publication_preview] ^from "../ui/views")
(import ^from "./instructions" [assemble_instructions])
(import ^from "./history"
  [
    append_message
    provider_context
    elide_response
    recall_body
    bounded_request
    compact_history
    history_state
    read_body])
(import [pending_request replace_pending_request] ^from "./history")
(import [next_request admit_next_request] ^from "./next_request")
(import [operator_round? collection_turns] ^from "../runtime/round_policy")
(import ^from "../public/text" [byte_prefix])
(import ^from "./provider_selection" [readiness_info select_provider session_settings resolve_selection])
(import ^from "./model_call" [call_model])
(import ^from "./hooks" [history_policy request_prepare])
(import ^from "../storage/state"
  [append_core_event append_turn_end_once core_state record_core_state flush_event_store copy_data])
(import ^from "../runtime/questions" [ask_questions])
(import ^from "../runtime/sessions" [require_record update_session])
(import [new_runtime_turn_transaction] ^from "../runtime/turn_participant_registry")
(import [begin_turn_transaction run_turn_phase finish_turn_transaction ParticipantFailure]
  ^from "../runtime/turn_participants")
(import [participant_inputs participant_bindings validate_participants commit_participants round_limit_participants
  request_source request_sources finish_participant_outcome] ^from "./turn_participation")
(import [turn_evidence run_check_in check_in_summary check_in_notice] ^from "../runtime/check_ins")
(import [decision_available?] ^from "../runtime/decision_service")
(import [dispatch_round_event claimed?] ^from "../runtime/round_lifecycle")

(type TurnReadinessFailure ^props {^message Str ^code Str?} ^impl [Error])
(impl Error for TurnReadinessFailure)

(fn recall_model_context [runtime, session : Str, id : Str]
  (var source nil)
  (let snapshot (current_snapshot runtime/h/snapshots))
  (for record in (?? (snapshot/registries .get "recall_sources") [])
    (let row record/payload)
    (if (&& ($str/starts_with? id row/prefix)
            (|| ($absent? source) (> ($str/byte_size row/prefix) ($str/byte_size source/prefix))))
      (set source row)))
  (if ($absent? source)
    (recall_body runtime session id)
    (source/recall session ($str/slice_bytes id ($str/byte_size source/prefix)
      (- ($str/byte_size id) ($str/byte_size source/prefix))))))

(fn transcript [runtime, session : Str, payload]
  (let timed (copy_data payload))
  (timed .put "at_ms" ($os/wall_ms))
  (append_core_event runtime/events "session" session timed))

(fn finish_turn [runtime, session : Str, payload]
  (let timed (copy_data payload))
  (timed .put "at_ms" ($os/wall_ms))
  (let outcome (append_turn_end_once runtime/events session timed))
  outcome/event)

(fn console_output [runtime, session : Str, round : Str, turn : Int, item]
  (let loaded (runtime/sessions/loaded/.get .get session))
  (var offset 0)
  (let total ($str/byte_size item/text))
  (while (< offset total)
    (let remaining ($str/slice_bytes item/text offset (- total offset)))
    (let chunk (byte_prefix remaining 16384))
    (set offset (+ offset ($str/byte_size chunk)))
    (let payload
      {
        ^type "console"
        ^session session
        ^round round
        ^turn turn
        ^text chunk
        ^late item/late
        ^^ignorable})
    (if (&& item/late ($absent? loaded))
      (then
        (append_core_event runtime/events "workspace" "workspace" payload))
      (else
        (if_not ($absent? loaded) (loaded/console/.get .push payload))
        (transcript runtime session payload))))
  (if item/late (flush_event_store runtime/events))
  nil)

(fn attach_participant_inputs [runtime, session : Str, round, turn : Int, request : Str, initial : Bool, incoming]
  (let known (?? round/request_sources []))
  (let added ($filter incoming/items (fn [item] (! (known .contains? (request_source item))))))
  (if added/.empty? (return {^request request ^sources known}))
  (let rendered (bounded_request runtime session added))
  (let combined (if (== request "") rendered/full $"${request}\n${rendered/full}"))
  (for source in (request_sources rendered/items) (known .push source))
  (round .put "request_sources" known)
  (round .put "request" combined)
  (if_not initial
    (append_message ^settled rendered/settled ^round round/id ^turn turn runtime session "user" rendered/full)
    (let record ($thaw ($freeze_shallow incoming/annotations)))
    (for [key value] in {^type "turn/request" ^turn turn ^round round/id
      ^for_turn turn ^combine "append" ^full rendered/full ^settled rendered/settled}
      (record .put key value))
    (transcript runtime session record))
  {^request combined ^sources known})

(fn prepare_continuation [runtime, session : Str, round, number : Int, limit : Int, lease, incoming]
  (let key $"continuation/prepared/${round/id}")
  (var rendered (core_state runtime/events "session" session key))
  (if ($absent? rendered)
    (then
      (let saved ($serde/read_data (read_body runtime round/continuation/items_ref)))
      (let items ($filter saved (fn [item] (!= item/settled false))))
      (let sources (?? round/continuation/request_sources []))
      (for item in incoming/items
        (let source (request_source item))
        (if_not (sources .contains? source)
          (items .push item)
          (if_not ($absent? source) (sources .push source))))
      (let prepared ($runtime/with_context
        {^composition runtime/h/snapshots ^snapshot lease/snapshot}
        (fn [] (request_prepare runtime lease/snapshot
          {^session session ^round round/id ^turn number ^round_turn 1 ^limit limit
           ^continuation_mode round/continuation_mode ^task_root round/task_root ^items items}))))
      (set rendered (bounded_request runtime session prepared/items))
      (rendered .put "media" (?? round/continuation/media []))
      (rendered .put "sources" (request_sources rendered/items))
      (record_core_state runtime/events "session" session "session/state" key rendered)
      (flush_event_store runtime/events)))
  (replace_pending_request runtime session round/continuation/history rendered)
  (round .put "request" rendered/full)
  (round .put "request_settled" rendered/settled)
  (round .put "request_sources" rendered/sources)
  (round .put "request_media" rendered/media)
  (transcript runtime session {^type "turn/request" ^round round/id ^turn 0
    ^for_turn number ^combine "replace" ^continued_from round/continuation/source_round
    ^source_turn round/continuation/source_turn
    ^full rendered/full ^settled rendered/settled ^media rendered/media})
  rendered/full)

(fn record_turn_result [runtime, session : Str, round, number : Int, result, ^reply reply : Bool = true]
  (let outcome (?? result/validated/outcome nil))
  (if_not ($absent? result/patch)
    (update_session runtime/sessions session {^^has_patch})
    (if (== result/patch/attention true) (update_session runtime/sessions session {^^attention})))
  (if_not ($absent? result/composition_changes)
    (if_not result/composition_changes/.empty?
      (update_session runtime/sessions session {^^has_registration})))
  (if (== outcome/attention true) (update_session runtime/sessions session {^^attention}))
  (if (&& reply ($present? outcome/reply) (!= outcome/reply ""))
    (transcript runtime session ((?? result/reply_fields {}) .assoc "type" "reply"
      ; .assoc "turn" number ; .assoc "round" round/id ; .assoc "text" outcome/reply
      ; .assoc "final" (== result/kind "done"))))
  nil)

(fn suspension_result [suspension, round, request : Str, count : Int, number : Int]
  (let record (copy_data suspension))
  (for [key value] in {^request request ^request_sources (?? round/request_sources [])
    ^request_items_ref (?? round/request_items_ref nil) ^turn_count count ^last_turn number}
    (record .put key value))
  record)

# Checked rounds have no fixed ceiling while check-ins answer. Their counters
# are in task turns; the effective ceiling is allowance_base + turn_limit,
# converted here to this round's turns (docs/decisions.md).
(fn init_check_in_counters [round, interval : Int]
  (let base (?? round/task_turns_base 0))
  (if ($absent? round/allowance_base) (round .put "allowance_base" base))
  (if ($absent? round/allowance_source)
    (round .put "allowance_source" (if ($present? round/continuation) "operator" "start")))
  (if ($absent? round/next_check_turn) (round .put "next_check_turn" (+ base interval)))
  nil)

(fn checked_limit [round, configured : Int] : Int
  (- (+ round/allowance_base configured) (?? round/task_turns_base 0)))

# Whether a feature still runs work this round owns (delegated children, for
# example). Answered by round_lifecycle handlers, not a feature import.
(fn owned_children? [runtime, session : Str, round] : Bool
  (try (claimed? (dispatch_round_event runtime "round/outstanding" {^session session ^round round/id}))
    catch Any false))

(fn run_round [runtime, session : Str, round, ^resume resume : Bool = false]
  (let metadata (require_record runtime/sessions session))
  (let config (session_settings metadata (effective_config runtime)))
  (let selection (?? round/selection (resolve_selection runtime config)))
  (let configured_limit
    (?? round/effective_limits/turn_limit
      (if (operator_round? round) config/turn_limit config/trigger_turn_limit)))
  (let checked (&& (operator_round? round) (== round/continuation_mode "checked")))
  (let interval (?? config/check_in_turns 10))
  (if checked (init_check_in_counters round interval))
  (var limit (if checked (checked_limit round configured_limit) configured_limit))
  (let extra_turns (collection_turns round))
  (let collection (> extra_turns 0))
  (var ceiling (+ limit extra_turns))
  (var pause nil)
  # Rounds whose initiator declares a check-in use (trigger rounds, delegated
  # children, plugin automation) end early, rather than pause, when a progress
  # check-in finds them blocked, repeating or drifting. A child's failed
  # result, with the evidence, is its report to the parent.
  (let early_use (?? round/check_in_use nil))
  (let early (&& ($present? early_use) (!= config/check_ins false)
    (decision_available? runtime/services/values/decisions early_use)))
  (var next_early interval)
  (var count (?? round/turn_count 0))
  (var last_request (?? round/request round/prompt))
  (if_not resume
    (let recovery (core_state runtime/events "session" session "recovery"))
    (if_yes (&& ($present? recovery) (!= recovery/delivered true))
      (let warning_text
        ($str/join
          recovery/warnings
          """
"""))
      (set last_request
        ($to_str
          """[recovery]
"""
          warning_text
          """
"""
          last_request))
      (recovery .put "delivered" true)
      (record_core_state runtime/events "session" session "session/state" "recovery" recovery)))
  (while (< count ceiling)
    (let current (require_record runtime/sessions session))
    (let number (+ current/turns 1))
    (set count (+ count 1))
    (round .put "turn_count" count)
    (round .put "last_turn" number)
    (if ($absent? round/first_turn) (round .put "first_turn" number))
    (update_session runtime/sessions session {^turns number})
    (let lease (acquire_snapshot ^label "model/turn" runtime/h/snapshots))
    (var result nil)
    (var stage "request/prepare")
    (var transaction nil)
    (var failure nil)
    (var body_completed false)
    (let started ($cell false))
    (fn start_record []
      (if (started .swap true) (return nil))
      (transcript runtime session
        {^type "turn/start" ^turn number ^round round/id ^initiator round/initiator ^card (?? round/card nil)
         ^task_turns (+ (?? round/task_turns_base 0) count) ^task_root (?? round/task_root round/id)
         ^continuation_mode (?? round/continuation_mode "manual")})
      (round .put "task_turns" (+ (?? round/task_turns_base 0) count))
      nil)
    (fn seal_turn [terminal, errors]
      (start_record)
      (let failed (! errors/.empty?))
      (if_not ($absent? result)
        (record_turn_result runtime session round number result
          ^reply (&& (! failed) ($absent? failure) body_completed)))
      (let reason (if failed "error" terminal/kind))
      (let ended {^type "turn/end" ^turn number ^round round/id ^reason reason
        ^text (if failed ($str/join ($map errors /message) "; ") (?? terminal/error nil)) ^!synthetic})
      # A short result line per turn, for check-ins and their repetition rule.
      (let evidence (try (turn_evidence (if failed (terminal .assoc "error" ended/text) terminal)) catch Any nil))
      (if_yes ($present? evidence)
        (ended .put "result_line" evidence/line)
        (ended .put "evidence" (evidence .assoc "line" nil)))
      (if (== reason "error") (ended .put "stage" stage))
      (let record (finish_turn runtime session ended))
      (flush_event_store runtime/events)
      record)
    (try
      (let continuing (&& (! resume) (== count 1) ($present? round/continuation)))
      (set transaction (new_runtime_turn_transaction runtime lease
        {^session session ^round round ^turn number ^count count ^limit limit ^collection collection
         ^carry (|| continuing (&& (! resume) (== count 1) (operator_round? round)))}))
      (set stage "participants/begin")
      (begin_turn_transaction transaction)
      (set stage "participants/request_items")
      (let incoming (participant_inputs transaction))
      (set stage "request/prepare")
      (if_yes continuing (set last_request (prepare_continuation runtime session round number limit lease incoming)))
      (if_yes (! continuing)
        (let packet (attach_participant_inputs runtime session round number last_request
          (&& (! resume) (== count 1)) incoming))
        (set last_request packet/request))
      (if (&& (! resume) (== count 1) (! continuing))
        (then
          (let source_request last_request)
          (let prepared
            ($runtime/with_context
              {^composition runtime/h/snapshots ^snapshot lease/snapshot}
              (fn []
                (request_prepare runtime lease/snapshot
                  {^session session ^round round/id ^turn number
                   ^round_turn count ^limit limit ^continuation_mode (?? round/continuation_mode "manual")
                   ^task_root (?? round/task_root round/id) ^items []}))))
          (let rendered (bounded_request runtime session prepared/items))
          (let settled
            (if (== rendered/settled "") source_request
              $"${source_request}\n${rendered/settled}"))
          (if_not (== rendered/full "")
            (set last_request $"${source_request}\n${rendered/full}"))
          (round .put "request" last_request)
          (round .put "request_settled" settled)
          (append_message ^settled settled ^round round/id ^media (?? round/media []) runtime session
            "user" last_request)
          (transcript runtime session
            {^type "turn/request" ^round round/id ^turn 0
             ^for_turn number ^combine "replace" ^initiator round/initiator ^card (?? round/card nil)
             ^input (?? round/input nil)
             ^full last_request ^settled settled ^media (?? round/media []) ^^initial})))
      (start_record)
      (flush_event_store runtime/events)
      (set stage "readiness")
      (let ready
        ($runtime/with_context
          {^composition runtime/h/snapshots ^snapshot lease/snapshot}
          (fn []
            (readiness_info ^selection selection runtime config))))
      (if ($present? ready/reason)
        (fail (TurnReadinessFailure ^code ready/code ^message ready/reason)))
      (set stage "provider/select")
      (let selected
        ($runtime/with_context
          {^composition runtime/h/snapshots ^snapshot lease/snapshot}
          (fn [] (select_provider ^selection selection runtime config))))
      (set stage "instructions")
      (let instructions
        ($runtime/with_context
          {^composition runtime/h/snapshots ^snapshot lease/snapshot}
          (fn []
            (assemble_instructions runtime (require_record runtime/sessions session)))))
      (set stage "history/compact")
      (let window_tokens selection/context_window)
      (let policy
        ($runtime/with_context
          {^composition runtime/h/snapshots ^snapshot lease/snapshot}
          (fn []
            (history_policy runtime lease/snapshot
              {^session session ^round round/id ^turn number
               ^window_tokens window_tokens ^instructions instructions
               ^messages ((history_state runtime session) .get "messages")}))))
      (if_not ($absent? policy)
        (compact_history ^policy policy
          runtime
          session
          instructions
          window_tokens
          (fn [request]
            (request .put "config" config)
            (request .put "round" round/id)
            (request .put "turn" number)
            (set stage "history/summary")
            (let summary_call (call_model ^selected selected runtime request))
            (set stage "history/compact")
            summary_call/text)))
      (set stage "context")
      (let messages (provider_context runtime session instructions))
      (let budget {^limit limit ^used count ^remaining (- limit count)})
      (set stage "participants/request_admitted")
      (run_turn_phase transaction "request_admitted")
      (set stage "model/call")
      (let completion
        (call_model ^selected selected runtime
          {
            ^session session
            ^round round/id
            ^turn number
            ^budget budget
            ^config config
            ^messages messages}))
      (let text completion/text)
      (set stage "response/evaluate")
      (let elided
        (try
          (elide_response runtime session number text)
        catch Any
          {^text text ^blobs {}}))
      (let response_recorded ($cell false))
      (fn record_response [files, ^hint hint = nil]
        (if response_recorded/.get (return nil))
        (transcript
          runtime
          session
          {
            ^type "turn/response"
            ^turn number
            ^round round/id
            ^model_call completion/call_id
            ^text elided/text
            ^blobs elided/blobs
            ^reply_hint hint
            ^patch_files files})
        (append_message ^settled elided/text ^round round/id ^turn number
          runtime
          session
          "assistant"
          text)
        (if_not files/.empty?
          (record_core_state
            runtime/events
            "session"
            session
            "session/state"
            $"patch/${number}"
            {^files files ^state "started" ^round round/id ^turn number}))
        (flush_event_store runtime/events)
        # The core write is already durable. A failed mandatory acknowledgment
        # must not record it again or re-run the response through a repair turn.
        (response_recorded .set true)
        (run_turn_phase transaction "response_recorded" {^patch_files files ^reply_hint hint})
        nil)
      (set stage "participants/bindings")
      (let bindings (participant_bindings transaction))
      (set stage "response/evaluate")
      (set result
        (evaluate_harness_turn ^session session ^round round/id ^reviewer selected ^lease lease ^^coordinated
          ^publication_preview (fn [session changes] (ui_publication_preview runtime session changes))
          ^turn_context {^count count ^limit limit ^collection collection}
          ^bindings bindings ^timeout_ms (?? config/response_budget/timeout_ms 600000) ^max_memory_mb (?? config/response_budget/max_memory_mb 1024) ^recall (fn [id] (recall_model_context runtime session id)) ^console_sink (fn [item] (console_output runtime session round/id number item)) ^record (fn [kind data] (if (== kind "turn/response") (record_response ^hint data/reply_hint data/patch_files) (do (record_core_state runtime/events "session" session "session/state" $"patch/${number}" {^state "completed" ^result data/result ^round round/id ^turn number}) (transcript runtime session {^type "turn/patch" ^round round/id ^turn number ^result data/result ^text data/result/text}))))
          runtime/h
          number
          runtime/root
          text))
      (record_response [])
      (set stage "participants/validate_outcome")
      (set result (validate_participants transaction result))
      (set stage "participants/commit")
      (set result (commit_participants transaction result))
      (set result (finish_participant_outcome result))
      (let produced_media (?? result/media []))
      (if_not produced_media/.empty?
        (transcript runtime session {^type "reply" ^round round/id ^turn number
          ^text "" ^media result/media ^!final}))
      (if_not (["done" "cancelled"] .contains? result/kind)
        (set stage "request/prepare")
        (let prepared
          ($runtime/with_context
            {^composition runtime/h/snapshots ^snapshot lease/snapshot}
            (fn []
              (request_prepare runtime lease/snapshot
                {^session session ^round round/id ^turn (+ number 1)
                 ^round_turn (+ count 1) ^limit limit
                 ^continuation_mode (?? round/continuation_mode "manual") ^task_root (?? round/task_root round/id)
                 ^items result/request_items}))))
        (result .put "prepared_request_items" prepared/items))
      (set body_completed true)
    catch Any
      (set failure $err)
      (if (== ($head $err) ParticipantFailure) (set stage $"participants/${$err/phase}"))
      (let kind (if (|| (== ($head $err) TurnReadinessFailure) (== $err/code "connection_changed"))
        (then "not_ready") (else "error")))
      (set result ((?? result {}) .assoc "kind" kind ; .assoc "error" $err/message))
    ensure
      (let terminal
        (if (&& ($absent? failure) (! body_completed))
          ((?? result {}) .assoc "kind" "cancelled" ; .assoc "error" "Response cancelled.")
          (?? result {^kind "error" ^error "Turn did not produce a result."})))
      (if (&& ($absent? failure) body_completed) (set stage "participants/finalize"))
      (try
        (if ($absent? transaction)
          (seal_turn terminal [])
          (finish_turn_transaction transaction terminal seal_turn))
      catch Any
        (if_yes ($absent? failure)
          (set failure $err)
          (let failed_phase (?? $err/errors/0/phase (?? $err/phase "finish")))
          (set stage $"participants/${failed_phase}"))
        # A core record may have committed before its caller lost the result.
        # End-once is idempotent; no participant or seal callback is replayed.
        (start_record)
        (finish_turn runtime session {^type "turn/end" ^turn number ^round round/id
          ^reason "error" ^stage "participants/finish" ^text $err/message ^!synthetic})
        (transcript runtime session {^type "trace" ^^ignorable
          ^text $"Turn finalization failed: ${$err/message}"})
        (flush_event_store runtime/events)
      ensure (release_snapshot runtime/h/snapshots lease)))
    (if ($present? failure)
      (then
        (let failed {^state "failed" ^message failure/message ^stage stage
          ^turn_count count ^last_turn number})
        # A transport refusal happened before a model call. Preserve its
        # pending input for deliberate resumption; never replay uncertain work.
        (if (&& (operator_round? round) (== failure/code "connection_changed")
                (["readiness" "provider/select"] .contains? stage)
                ($present? round/request_items_ref))
          (then
            (failed .put "reason" "connection_changed")
            (failed .put "continuation_mode" "manual")
            (failed .put "continuation" {^items_ref (?? round/logical_items_ref round/request_items_ref)
              ^history (pending_request runtime session) ^media (?? round/request_media [])
              ^request_sources (?? round/request_sources []) ^task_root (?? round/task_root round/id)
              ^task_turns (+ (?? round/task_turns_base 0) count) ^source_round round/id ^source_turn number})))
        (return failed)))
    (let outcome (?? result/validated/outcome nil))
    (if (== result/kind "done")
      (then
        (flush_event_store runtime/events)
        (return {^state "done" ^reply outcome/reply ^result (?? result/result nil) ^turn_count count ^last_turn number})))
    (if (== result/kind "cancelled")
      (then
        (flush_event_store runtime/events)
        (return {^state "cancelled" ^turn_count count ^last_turn number})))
    # The check runs once this turn's result is final and before the next
    # request is recorded, so the unsent marker reflects its verdict.
    (if_yes (&& checked (! collection) ($absent? result/suspension) (!= result/kind "questions")
                (>= (+ (?? round/task_turns_base 0) count) round/next_check_turn))
      (let record (run_check_in runtime session round (+ (?? round/task_turns_base 0) count) ^interval interval))
      (if_yes ($present? record)
        (for [key value] in record/counters (round .put ($to_str key) value))
        (round .put "last_check_in" (check_in_summary record))
        (if (== record/action "pause") (set pause record))
        (set limit (checked_limit round configured_limit))
        (set ceiling (+ limit extra_turns))))
    (if_yes (&& early (>= count next_early) (!= result/kind "questions") ($absent? result/suspension))
      (let early_record (run_check_in ^use early_use runtime session round count ^interval interval))
      (if_yes ($present? early_record)
        (set next_early (+ count (if (== early_record/verdict "uncertain") ($math/max 1 (/ interval 2)) interval)))
        (round .put "last_check_in" (check_in_summary early_record))
        (if_yes (== early_record/action "pause")
          (flush_event_store runtime/events)
          (return {^state "failed" ^reason "check_in" ^check_in (check_in_summary early_record)
            ^message $"ended at a progress check-in (${early_record/verdict}): ${early_record/evidence}"
            ^request last_request ^turn_count count ^last_turn number}))))
    (let requests (next_request runtime session round result/prepared_request_items
      ^logical result/request_items ^media (?? result/media [])
      ^record_fields {^at_limit (|| ($present? pause) (>= count ceiling))} ^!admit))
    (set last_request requests/full)
    (if_yes ($present? result/suspension)
      (flush_event_store runtime/events)
      (return (suspension_result result/suspension round last_request count number)))
    (if (== result/kind "questions")
      (then
        (let id $"${round/id}-q-${number}")
        (let deadline
          (if (== metadata/kind "interactive")
            nil
            (+ ($os/wall_ms) config/question_timeout_ms)))
        (let batch
          (ask_questions ^deadline deadline ^^normalized ^round round/id
            runtime/events
            session
            id
            number
            result/validated/questions))
        (return
          {
            ^state "waiting"
            ^questions batch ^delegation_wait nil
            ^request last_request
            ^turn_count count
            ^last_turn number})))
    (admit_next_request runtime session round)
    (flush_event_store runtime/events)
    (if ($present? pause) (break)))
  (if_yes ($present? pause)
    # pause_requested: no further parent model call and no collection turn.
    # Running children keep going and belong to the continuation round.
    (let turns (+ (?? round/task_turns_base 0) count))
    (let children (owned_children? runtime session round))
    (return {^state "paused" ^reason "check_in" ^message "paused at a progress check-in"
      ^notice (check_in_notice pause (?? round/last_turn 0) ^children children)
      ^check_in (check_in_summary pause) ^children_running children
      ^request last_request ^turn_count count ^last_turn (?? round/last_turn 0)
      ^task_turns turns ^continuation_mode "checked"
      ^continuation {^items_ref (?? round/logical_items_ref round/request_items_ref)
        ^history (pending_request runtime session) ^media (?? round/request_media [])
        ^request_sources (?? round/request_sources []) ^task_root (?? round/task_root round/id)
        ^task_turns turns ^source_round round/id ^source_turn (?? round/last_turn 0)}}))
  (let boundary_turn (?? round/last_turn metadata/turns))
  (let parked (round_limit_participants runtime session round boundary_turn count limit collection))
  (if_not ($absent? parked)
    (return (suspension_result parked round (?? round/request last_request) count boundary_turn)))
  (if_yes (operator_round? round)
    (let turns (+ (?? round/task_turns_base 0) count))
    # In checked mode this is the fallback: no check-in answered within
    # turn_limit turns. The last check-in's status is the evidence.
    (if_yes (&& checked ($present? round/last_check_in))
      (round .put "check_in" round/last_check_in)
      (round .put "notice" ($to_str "Paused after turn " (?? round/last_turn 0)
        ": no progress check-in answered within the turn limit (last status: "
        round/last_check_in/status "). Continue, or tell it what to change.")))
    (return {^state "paused" ^reason "turn_limit" ^message "turn limit reached"
      ^request last_request ^turn_count count ^last_turn (?? round/last_turn 0)
      ^task_turns turns ^continuation_mode (?? round/continuation_mode "manual")
      ^continuation {^items_ref (?? round/logical_items_ref round/request_items_ref)
        ^history (pending_request runtime session) ^media (?? round/request_media [])
        ^request_sources (?? round/request_sources []) ^task_root (?? round/task_root round/id)
        ^task_turns turns ^source_round round/id ^source_turn (?? round/last_turn 0)}}))
  (transcript
    runtime
    session
    {
      ^type "reply"
      ^turn (?? round/last_turn 0)
      ^^synthetic ^reason "turn_limit"
      ^round round/id
      ^text ($to_str
              "The round reached its "
              limit
              "-turn limit. Your files and conversation are saved. Send a continuation message in this conversation to finish the remaining work.")
      ^^final})
  (flush_event_store runtime/events)
  {^state "failed" ^message "turn limit reached" ^request last_request ^turn_count count})
