(mod turn_loop)
(import ^from "../runtime/composition" [acquire_snapshot release_snapshot])
(import ^from "./harness_turn" [evaluate_harness_turn])
(import ^from "./instructions" [assemble_instructions])
(import ^from "./history"
  [
    append_message
    provider_context
    elide_response
    recall_body
    bounded_request
    compact_history
    history_state
    write_body
    read_body])
(import [pending_request replace_pending_request] ^from "./history")
(import [operator_round?] ^from "../runtime/round_policy")
(import ^from "../text" [byte_prefix])
(import ^from "./provider_selection" [readiness_report select_provider session_settings])
(import ^from "./model_call" [call_model])
(import ^from "./hooks" [history_policy request_prepare])
(import ^from "../storage/state"
  [append_core_event append_turn_end_once core_state record_core_state flush_event_store copy_data])
(import ^from "../runtime/questions" [ask_questions])
(import ^from "../runtime/sessions" [require_record update_session])
(import [recall_image_run] ^from "../storage/image_runs")
(import [card_bindings flush_card_progress] ^from "../runtime/cards")
(import [new_turn_items] ^from "./outcome")
(import [delegation_context commit_delegation_turn delegation_request_items
  begin_delegation_request mark_delegation_results_seen release_delegation_turn
  has_owned_work?] ^from "../runtime/delegations")

(fn recall_model_context [runtime, session : Str, id : Str]
  (if ($str/starts_with? id "image.")
    (recall_image_run runtime session ($str/slice_bytes id 6 (- ($str/byte_size id) 6)))
    (recall_body runtime session id)))

(fn transcript [runtime, session : Str, payload]
  (let timed (copy_data payload))
  (timed .put "at_ms" ($os/wall_ms))
  (append_core_event runtime/events "session" session timed))

(fn finish_turn [runtime, session : Str, payload]
  (let timed (copy_data payload))
  (timed .put "at_ms" ($os/wall_ms))
  (let outcome (append_turn_end_once runtime/events session timed))
  outcome/event)

(fn console_output [runtime, session : Str, round : Str, turn : Int, item]
  (let loaded (runtime/sessions/loaded/.get .get session))
  (var offset 0)
  (let total ($str/byte_size item/text))
  (while (< offset total)
    (let remaining ($str/slice_bytes item/text offset (- total offset)))
    (let chunk (byte_prefix remaining 16384))
    (set offset (+ offset ($str/byte_size chunk)))
    (let payload
      {
        ^type "console"
        ^session session
        ^round round
        ^turn turn
        ^text chunk
        ^late item/late
        ^^ignorable})
    (if (&& item/late ($absent? loaded))
      (then
        (append_core_event runtime/events "workspace" "workspace" payload))
      (else
        (if_not ($absent? loaded) (loaded/console/.get .push payload))
        (transcript runtime session payload))))
  (if item/late (flush_event_store runtime/events))
  nil)

(fn request_delegation_sources [items]
  (let sources [])
  (for item in items
    (if (&& (! ($absent? item/delegation_source)) (! (sources .contains? item/delegation_source)))
      (sources .push item/delegation_source)))
  sources)

(fn attach_delegation_inputs [runtime, session : Str, round, turn : Int, request : Str, initial : Bool]
  (let known (?? round/request_sources []))
  (let incoming (delegation_request_items runtime/delegations session round/id turn
    ^carry (&& initial (operator_round? round))))
  (let added ($filter incoming (fn [item] (! (known .contains? item/delegation_source)))))
  (if added/.empty? (return {^request request ^sources known}))
  (let rendered (bounded_request runtime session added))
  (let combined (if (== request "") rendered/full $"${request}\n${rendered/full}"))
  (for source in (request_delegation_sources rendered/items) (known .push source))
  (round .put "request_sources" known)
  (round .put "request" combined)
  (if_not initial
    (append_message ^settled rendered/settled ^round round/id ^turn turn runtime session "user" rendered/full)
    (transcript runtime session {^type "turn/request" ^turn turn ^round round/id
      ^for_turn turn ^combine "append" ^full rendered/full ^settled rendered/settled ^delegation true}))
  {^request combined ^sources known})

(fn prepare_continuation [runtime, session : Str, round, number : Int, limit : Int, lease]
  (let key $"continuation/prepared/${round/id}")
  (var rendered (core_state runtime/events "session" session key))
  (if ($absent? rendered)
    (then
      (let saved ($serde/read_data (read_body runtime round/continuation/items_ref)))
      (let items ($filter saved (fn [item] (!= item/settled false))))
      (let sources (?? round/continuation/request_sources []))
      (if_not ($absent? runtime/delegations)
        (for item in (delegation_request_items runtime/delegations session round/id number ^carry true)
          (if_not (sources .contains? item/delegation_source)
            (items .push item) (sources .push item/delegation_source))))
      (let prepared ($runtime/with_context
        {^composition runtime/h/snapshots ^snapshot lease/snapshot}
        (fn [] (request_prepare runtime lease/snapshot
          {^session session ^round round/id ^turn number ^round_turn 1 ^limit limit
           ^continuation_mode round/continuation_mode ^task_root round/task_root ^items items}))))
      (set rendered (bounded_request runtime session prepared/items))
      (rendered .put "media" (?? round/continuation/media []))
      (rendered .put "sources" sources)
      (record_core_state runtime/events "session" session "session/state" key rendered)
      (flush_event_store runtime/events)))
  (replace_pending_request runtime session round/continuation/history rendered)
  (round .put "request" rendered/full)
  (round .put "request_settled" rendered/settled)
  (round .put "request_sources" rendered/sources)
  (round .put "request_media" rendered/media)
  (transcript runtime session {^type "turn/request" ^round round/id ^turn 0
    ^for_turn number ^combine "replace" ^continued_from round/continuation/source_round
    ^source_turn round/continuation/source_turn
    ^full rendered/full ^settled rendered/settled ^media rendered/media})
  rendered/full)

(fn run_round [runtime, session : Str, round, ^resume resume : Bool = false]
  (let metadata (require_record runtime/sessions session))
  (let config (session_settings metadata
    ($serde/read_data ($fs/read_text $"${runtime/state_root}/config.gene"))))
  (let limit
    (?? round/effective_limits/turn_limit
      (if (operator_round? round) (?? config/turn_limit 24) (?? config/trigger_turn_limit 12))))
  (let collection (== round/delegation_collection true))
  (let ceiling (+ limit (if collection 1 0)))
  (var count (?? round/turn_count 0))
  (var last_request (?? round/request round/prompt))
  (if_not resume
    (let recovery (core_state runtime/events "session" session "recovery"))
    (if_yes (&& (! ($absent? recovery)) (!= recovery/delivered true))
      (let warning_text
        ($str/join
          recovery/warnings
          """
"""))
      (set last_request
        ($to_str
          """[recovery]
"""
          warning_text
          """
"""
          last_request))
      (recovery .put "delivered" true)
      (record_core_state runtime/events "session" session "session/state" "recovery" recovery)))
  (while (< count ceiling)
    (let current (require_record runtime/sessions session))
    (let number (+ current/turns 1))
    (set count (+ count 1))
    (round .put "turn_count" count)
    (round .put "last_turn" number)
    (if ($absent? round/first_turn) (round .put "first_turn" number))
    (update_session runtime/sessions session {^turns number})
    (let lease (acquire_snapshot runtime/h/snapshots))
    (var result nil)
    (var stage "request/prepare")
    (var started false)
    (try
      (let continuing (&& (! resume) (== count 1) (! ($absent? round/continuation))))
      (if_yes continuing (set last_request (prepare_continuation runtime session round number limit lease)))
      (if_yes (&& (! continuing) (! ($absent? runtime/delegations)))
        (let packet (attach_delegation_inputs runtime session round number last_request
          (&& (! resume) (== count 1))))
        (set last_request packet/request))
      (if (&& (! resume) (== count 1) (! continuing))
        (then
          (let source_request last_request)
          (let prepared
            ($runtime/with_context
              {^composition runtime/h/snapshots ^snapshot lease/snapshot}
              (fn []
                (request_prepare runtime lease/snapshot
                  {^session session ^round round/id ^turn number
                   ^round_turn count ^limit limit ^continuation_mode (?? round/continuation_mode "manual")
                   ^task_root (?? round/task_root round/id) ^items []}))))
          (let rendered (bounded_request runtime session prepared/items))
          (let settled
            (if (== rendered/settled "") source_request
              $"${source_request}\n${rendered/settled}"))
          (if_not (== rendered/full "")
            (set last_request $"${source_request}\n${rendered/full}"))
          (round .put "request" last_request)
          (round .put "request_settled" settled)
          (append_message ^settled settled ^round round/id ^media (?? round/media []) runtime session
            "user" last_request)
          (transcript runtime session
            {^type "turn/request" ^round round/id ^turn 0
             ^for_turn number ^combine "replace" ^initiator round/initiator ^card (?? round/card nil)
             ^full last_request ^settled settled ^media (?? round/media []) ^^initial})))
      (transcript runtime session
        {^type "turn/start" ^turn number ^round round/id ^initiator round/initiator ^card (?? round/card nil)
         ^task_turns (+ (?? round/task_turns_base 0) count) ^task_root (?? round/task_root round/id)
         ^continuation_mode (?? round/continuation_mode "manual")})
      (set started true)
      (round .put "task_turns" (+ (?? round/task_turns_base 0) count))
      (flush_event_store runtime/events)
      (set stage "readiness")
      (let ready_message
        ($runtime/with_context
          {^composition runtime/h/snapshots ^snapshot lease/snapshot}
          (fn []
            (readiness_report runtime config))))
      (if_not ($absent? ready_message)
        (finish_turn runtime session
          {^type "turn/end" ^turn number ^round round/id
           ^reason "not_ready" ^text ready_message ^!synthetic})
        (flush_event_store runtime/events)
        (return {^state "failed" ^message ready_message
          ^turn_count count ^last_turn number}))
      (set stage "provider/select")
      (let selected
        ($runtime/with_context
          {^composition runtime/h/snapshots ^snapshot lease/snapshot}
          (fn [] (select_provider runtime config))))
      (set stage "instructions")
      (let instructions
        ($runtime/with_context
          {^composition runtime/h/snapshots ^snapshot lease/snapshot}
          (fn []
            (assemble_instructions runtime (require_record runtime/sessions session)))))
      (set stage "history/compact")
      (let window_tokens (?? config/context_window 128000))
      (let policy
        ($runtime/with_context
          {^composition runtime/h/snapshots ^snapshot lease/snapshot}
          (fn []
            (history_policy runtime lease/snapshot
              {^session session ^round round/id ^turn number
               ^window_tokens window_tokens ^instructions instructions
               ^messages ((history_state runtime session) .get "messages")}))))
      (if_not ($absent? policy)
        (compact_history ^policy policy
          runtime
          session
          instructions
          window_tokens
          (fn [request]
            (request .put "config" config)
            (request .put "round" round/id)
            (request .put "turn" number)
            (set stage "history/summary")
            (let summary_call (call_model ^selected selected runtime request))
            (set stage "history/compact")
            summary_call/text)))
      (set stage "context")
      (let messages (provider_context runtime session instructions))
      (let budget {^limit limit ^used count ^remaining (- limit count)})
      (if_not ($absent? runtime/delegations)
        (begin_delegation_request runtime/delegations session round/id number (?? round/request_sources [])))
      (set stage "model/call")
      (let completion
        (call_model ^selected selected runtime
          {
            ^session session
            ^round round/id
            ^turn number
            ^budget budget
            ^config config
            ^messages messages}))
      (let text completion/text)
      (set stage "response/evaluate")
      (let elided
        (try
          (elide_response runtime session number text)
        catch Any
          {^text text ^blobs {}}))
      (let response_recorded ($cell false))
      (fn record_response [files, ^hint hint = nil]
        (if response_recorded/.get (return nil))
        (transcript
          runtime
          session
          {
            ^type "turn/response"
            ^turn number
            ^round round/id
            ^model_call completion/call_id
            ^text elided/text
            ^blobs elided/blobs
            ^reply_hint hint
            ^patch_files files})
        (append_message ^settled elided/text ^round round/id ^turn number
          runtime
          session
          "assistant"
          text)
        (if_not files/.empty?
          (record_core_state
            runtime/events
            "session"
            session
            "session/state"
            $"patch/${number}"
            {^files files ^state "started" ^round round/id ^turn number}))
        (flush_event_store runtime/events)
        (if_not ($absent? runtime/delegations)
          (let sources (?? round/request_sources []))
          (if (&& (! ($absent? runtime/delegations/checkpoint))
                  (! sources/.empty?))
            (runtime/delegations/checkpoint "parent_response_recorded" session))
          (mark_delegation_results_seen runtime/delegations session round/id number sources)
          (if (&& (! ($absent? runtime/delegations/checkpoint))
                  (! sources/.empty?))
            (runtime/delegations/checkpoint "parent_response" session)))
        (response_recorded .set true)
        nil)
      (set result
        (evaluate_harness_turn ^session session ^round round/id ^reviewer selected ^lease lease
          ^bindings (do (let api (card_bindings runtime session round/id number))
                      (let bound ($thaw ($freeze_shallow api)))
                      (bound .put "card_api" api)
                      (if_not ($absent? runtime/delegations)
                        (bound .put "delegation_context" (delegation_context runtime/delegations session round/id count limit collection)))
                      bound) ^timeout_ms (?? config/response_budget/timeout_ms 600000) ^max_memory_mb (?? config/response_budget/max_memory_mb 1024) ^recall (fn [id] (recall_model_context runtime session id)) ^console_sink (fn [item] (console_output runtime session round/id number item)) ^record (fn [kind data] (if (== kind "turn/response") (record_response ^hint data/reply_hint data/patch_files) (do (record_core_state runtime/events "session" session "session/state" $"patch/${number}" {^state "completed" ^result data/result ^round round/id ^turn number}) (transcript runtime session {^type "turn/patch" ^round round/id ^turn number ^result data/result ^text data/result/text}))))
          runtime/h
          number
          runtime/root
          text))
      (record_response [])
      (if_not ($absent? runtime/delegations)
        (set result (commit_delegation_turn runtime/delegations session round/id number result
          ^limit limit ^count count ^collection collection)))
      (let produced_media (?? result/media []))
      (if_not produced_media/.empty?
        (transcript runtime session {^type "reply" ^round round/id ^turn number
          ^text "" ^media result/media ^!final}))
      (if_not (["done" "cancelled"] .contains? result/kind)
        (let prepared
          ($runtime/with_context
            {^composition runtime/h/snapshots ^snapshot lease/snapshot}
            (fn []
              (request_prepare runtime lease/snapshot
                {^session session ^round round/id ^turn (+ number 1)
                 ^round_turn (+ count 1) ^limit limit
                 ^continuation_mode (?? round/continuation_mode "manual") ^task_root (?? round/task_root round/id)
                 ^items result/request_items}))))
        (result .put "prepared_request_items" prepared/items))
    catch Any
      (let message ($to_str $err/message))
      (if started
        (finish_turn runtime session
          {^type "turn/end" ^turn number ^round round/id
           ^reason "error" ^stage stage ^text message ^!synthetic}))
      (flush_event_store runtime/events)
      (return {^state "failed" ^message message ^stage stage
        ^turn_count count ^last_turn number})
    ensure
      # Live card progress becomes durable when the turn ends, however it ends.
      (try (flush_card_progress runtime session) catch Any nil)
      (release_snapshot runtime/h/snapshots lease))
    (let outcome (if ($absent? result/validated) nil result/validated/outcome))
    (if_not ($absent? result/patch)
      (update_session runtime/sessions session {^^has_patch})
      (if (== result/patch/attention true) (update_session runtime/sessions session {^^attention})))
    (if_not ($absent? result/composition_changes)
      (if_not result/composition_changes/.empty?
        (update_session runtime/sessions session {^^has_registration})))
    (if (&& (! ($absent? outcome)) (== outcome/attention true))
      (update_session runtime/sessions session {^^attention}))
    (if (&& (! ($absent? outcome/reply)) (!= outcome/reply ""))
      (transcript
        runtime
        session
        {
          ^type "reply"
          ^turn number
          ^round round/id
          ^text outcome/reply
          ^audio_reply outcome/audio_reply
          ^final (== result/kind "done")}))
    (finish_turn
      runtime
      session
      {^type "turn/end" ^turn number ^round round/id ^reason result/kind
       ^text (?? result/error nil) ^!synthetic})
    (if_not ($absent? runtime/delegations)
      (flush_event_store runtime/events)
      (release_delegation_turn runtime/delegations session round/id number))
    (if (== result/kind "done")
      (then
        (flush_event_store runtime/events)
        (return {^state "done" ^reply outcome/reply ^result (?? outcome/result nil) ^turn_count count ^last_turn number})))
    (if (== result/kind "cancelled")
      (then
        (flush_event_store runtime/events)
        (return {^state "cancelled" ^turn_count count ^last_turn number})))
    (let requests (bounded_request runtime session result/prepared_request_items))
    (set last_request requests/full)
    (round .put "request" last_request)
    (round .put "request_settled" requests/settled)
    (round .put "request_media" (?? result/media []))
    (round .put "request_items_ref" (write_body runtime ($serde/write_data requests/items)))
    (round .put "logical_items_ref" (write_body runtime ($serde/write_data result/request_items)))
    (round .put "request_sources" (request_delegation_sources requests/items))
    (transcript
      runtime
      session
      {
        ^type "turn/request"
        ^turn number
        ^for_turn (+ number 1) ^combine "replace"
        ^at_limit (>= count ceiling)
        ^round round/id
        ^full last_request
        ^settled requests/settled})
    (if_yes (== result/kind "delegation_wait")
      (flush_event_store runtime/events)
      (return {^state "waiting" ^questions nil ^delegation_wait result/delegation_wait
        ^delegation_collection (== result/delegation_collection true)
        ^request last_request ^request_sources (?? round/request_sources [])
        ^request_items_ref round/request_items_ref ^turn_count count ^last_turn number}))
    (if (== result/kind "questions")
      (then
        (let id $"${round/id}-q-${number}")
        (let deadline
          (if (== metadata/kind "interactive")
            nil
            (+ ($os/wall_ms) (?? config/question_timeout_ms 86400000))))
        (let batch
          (ask_questions ^deadline deadline ^^normalized ^round round/id
            runtime/events
            session
            id
            number
            result/validated/questions))
        (return
          {
            ^state "waiting"
            ^questions batch ^delegation_wait nil
            ^request last_request
            ^turn_count count
            ^last_turn number})))
    (append_message ^media (?? result/media []) ^settled requests/settled ^round round/id ^turn number
      runtime
      session
      "user"
      last_request)
    (flush_event_store runtime/events))
  (if_yes (&& (! collection) (! ($absent? runtime/delegations))
          (has_owned_work? runtime/delegations session round/id))
    (let number (?? round/last_turn metadata/turns))
    (let drained (commit_delegation_turn runtime/delegations session round/id number
      {^kind "continue" ^turn (new_turn_items number) ^request_items [] ^validated nil}
      ^limit limit ^count count))
    (return {^state "waiting" ^questions nil ^delegation_wait drained/delegation_wait
      ^delegation_collection true ^request (?? round/request last_request)
      ^request_sources (?? round/request_sources []) ^request_items_ref (?? round/request_items_ref nil)
      ^turn_count count ^last_turn number}))
  (if_yes (operator_round? round)
    (let turns (+ (?? round/task_turns_base 0) count))
    (return {^state "paused" ^reason "turn_limit" ^message "turn limit reached"
      ^request last_request ^turn_count count ^last_turn (?? round/last_turn 0)
      ^task_turns turns ^continuation_mode (?? round/continuation_mode "manual")
      ^continuation {^items_ref (?? round/logical_items_ref round/request_items_ref)
        ^history (pending_request runtime session) ^media (?? round/request_media [])
        ^request_sources (?? round/request_sources []) ^task_root (?? round/task_root round/id)
        ^task_turns turns ^source_round round/id ^source_turn (?? round/last_turn 0)}}))
  (transcript
    runtime
    session
    {
      ^type "reply"
      ^turn (?? round/last_turn 0)
      ^^synthetic ^reason "turn_limit"
      ^round round/id
      ^text ($to_str
              "The round reached its "
              limit
              "-turn limit. Your files and conversation are saved. Send a continuation message in this conversation to finish the remaining work.")
      ^^final})
  (flush_event_store runtime/events)
  {^state "failed" ^message "turn limit reached" ^request last_request ^turn_count count})
