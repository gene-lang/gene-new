(mod response)

(type ResponseReadError : Error ^props {^line Int ^response_line Int})

(fn read_response_code [code : Str, ^source source : Str = "response"]
  ($into ($parse/read_all ^source source ^^locs code) []))

(fn complete_code? [code : Str]
  (try
    ($into ($parse/read_all code) [])
    true
  catch Error
    false))

(fn block_start? [line : Str]
  (|| ($str/starts_with? line "<<<") ($str/starts_with? line "*** Begin Patch")))

(fn read_error [line : Int, message : Str]
  (fail (ResponseReadError ^line line ^response_line line ^_msg $"response:${line}: ${message}")))

(fn line_text [lines, index : Int] : Str
  (if (< index (- lines/.size 1))
    ($to_str
      lines/%index
      """
""")
    else lines/%index))

(fn structural_line [line : Str] : Str
  (if ($str/ends_with? line "\r")
    ($str/slice_bytes line 0 (- ($str/byte_size line) 1))
    else line))

(fn nonempty_bounds [lines]
  (var first -1)
  (var last -1)
  (var index 0)
  (while (< index lines/.size)
    (if (!= ($str/trim (structural_line lines/%index)) "")
      (if (< first 0) (set first index))
      (set last index))
    (set index (+ index 1)))
  {^first first ^last last})

(fn unwrap_code_fence [text : Str] : Str
  (let lines ($str/split text "\n"))
  (let bounds (nonempty_bounds lines))
  (if (|| (< bounds/first 0) (== bounds/first bounds/last)) (return text))
  (let first ($str/trim (structural_line (lines .get bounds/first))))
  (let last ($str/trim (structural_line (lines .get bounds/last))))
  (if_not (&& ($str/starts_with? first "```") (== last "```")) (return text))
  (let body [])
  (var index (+ bounds/first 1))
  (while (< index bounds/last)
    (body .push (line_text lines index))
    (set index (+ index 1)))
  ($str/join body ""))

(fn gene_code_line? [line : Str] : Bool
  (let trimmed ($str/trim (structural_line line)))
  (|| ($str/starts_with? trimmed "(")
      ($str/starts_with? trimmed "`(")
      ($str/starts_with? trimmed "[")
      ($str/starts_with? trimmed "{")
      ($str/starts_with? trimmed "*** Begin Patch")
      ($str/starts_with? trimmed "<<")))

(fn plain_text_response? [text : Str] : Bool
  (if (|| ($str/contains? text "(Outcome")
          ($str/contains? text "(append_prompt")
          ($str/contains? text "*** Begin Patch")
          ($str/contains? text "<<"))
    (return false))
  (for line in ($str/split text "\n")
    (if (gene_code_line? line) (return false)))
  true)

(fn plain_text_forms [text : Str] : Any
  # A conversational answer is a safe final reply. Without this fallback a
  # model that drops the code wrapper can burn the whole turn budget retrying
  # against a reader error that gives it no useful recovery path.
  (let literal ($json/stringify ($str/trim text)))
  ($into ($parse/read_all ($to_str "(Outcome ^^done ^reply " literal ")")) []))

(fn plain_shape? [forms] : Bool
  # Gene accepts bare words as symbols, so much prose parses without error.
  # Keep a single non-symbol value (for example 42 or a string) as ordinary
  # response code, but treat multiple bare symbols as conversational text.
  (|| (== forms/.size 0) (!= forms/.size 1) (== ($head forms/0) Sym)))


(fn validate_execution_attachments [response]
  (for block in response/blocks
    (if (!= block/kind "attachment") (continue))
    (let body ($str/trim block/body))
    (if (&& (== block/terminator "ELIDED") ($str/starts_with? body "[elided ") ($str/contains? body "; (recall \"") ($str/ends_with? body "\")]"))
      (read_error
        block/line
        ($to_str
          "attachment "
          block/name
          " is a history placeholder; use recall to recover its original body or provide the full attachment"))))
  response)

(fn split_response [text : Str]
  (let source (unwrap_code_fence text))
  (let lines ($str/split source "\n"))
  (let code_parts [])
  (var start lines/.size)
  (var index 0)
  (while (< index lines/.size)
    (let line (structural_line lines/%index))
    (if (&& (block_start? line) (complete_code? ($str/join code_parts "")))
      (set start index)
      (break))
    (code_parts .push (line_text lines index))
    (set index (+ index 1)))
  (let code ($str/join code_parts ""))
  (let attachments {})
  (let blocks [])
  (var patch nil)
  (set index start)
  (while (< index lines/.size)
    (let line (structural_line lines/%index))
    (if (== ($str/trim line) "")
      (set index (+ index 1))
      (continue))
    (if ($str/starts_with? line "<<<")
      (let header ($str/split line " "))
        (if (!= header/.size 2) (read_error (+ index 1) "attachment header must be <<<name terminator"))
        (let name ($str/slice_bytes header/0 3 (- ($str/byte_size header/0) 3)))
        (let terminator header/1)
        (if (|| ($absent? (#"^[A-Za-z0-9_.-]+$" .match name))
                (== terminator "") ($present? (#"\s" .match terminator)))
          (read_error (+ index 1) "invalid attachment name or terminator"))
        (if ($present? (attachments .get name))
          (read_error (+ index 1) $"duplicate attachment ${name}"))
        (let opening (+ index 1))
        (set index (+ index 1))
        (let body_parts [])
        (while (&& (< index lines/.size) (!= (structural_line lines/%index) terminator))
          (body_parts .push (line_text lines index))
          (set index (+ index 1)))
        (if (>= index lines/.size) (read_error opening $"unterminated attachment ${name}"))
        (let body ($str/join body_parts ""))
        (attachments .put name body)
        (blocks .push {^kind "attachment" ^name name ^line opening ^body body ^terminator terminator})
        (set index (+ index 1))
      elif (== line "*** Begin Patch")
        (if ($present? patch) (read_error (+ index 1) "a response may contain at most one patch"))
        (let opening (+ index 1))
        (let body_parts [(line_text lines index)])
        (set index (+ index 1))
        (while (&& (< index lines/.size) (!= (structural_line lines/%index) "*** End Patch"))
          (body_parts .push (line_text lines index))
          (set index (+ index 1)))
        (if (>= index lines/.size) (read_error opening "unterminated patch"))
        (body_parts .push (line_text lines index))
        (set patch ($str/join body_parts ""))
        (blocks .push {^kind "patch" ^line opening ^body patch})
        (set index (+ index 1))
      else (read_error (+ index 1) "expected an attachment or patch after response code")))
  # Read the code even when there were no blocks. Reading remains inert. If
  # the reader rejects a response that contains no code-like lines, treat the
  # text as a plain final answer instead of entering a repair loop.
  (var plain false)
  (var forms nil)
  (try
    (set forms (read_response_code code))
  catch ParseError
    (if (plain_text_response? code)
      (do (set plain true) (set forms (plain_text_forms code)))
      else (fail $err)))
  (if (&& (! plain) (!= ($str/trim code) "")
          (plain_text_response? code) (plain_shape? forms))
    (do
      (set plain true)
      (set forms (plain_text_forms code))))
  {^text text ^code code ^forms forms ^attachments attachments ^patch patch ^blocks blocks ^plain plain})
