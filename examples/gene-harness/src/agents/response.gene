(mod response)

(type ResponseReadError ^props {^message Str ^line Int ^response_line Int} ^impl [Error])
(impl Error for ResponseReadError)

(fn read_response_code [code : Str, ^source source : Str = "response"]
  ($into ($parse/read_all ^source source ^^locs code) []))

(fn complete_code? [code : Str]
  (try
    ($into ($parse/read_all code) [])
    true
  catch Any
    false))

(fn block_start? [line : Str]
  (|| ($str/starts_with? line "<<<") ($str/starts_with? line "*** Begin Patch")))

(fn read_error [line : Int, message : Str]
  (fail (ResponseReadError ^line line ^response_line line ^message $"response:${line}: ${message}")))

(fn line_text [lines, index : Int] : Str
  (if (< index (- lines/.size 1))
    ($to_str
      lines/%index
      """
""")
    lines/%index))

(fn structural_line [line : Str] : Str
  (if ($str/ends_with? line "\r")
    ($str/slice_bytes line 0 (- ($str/byte_size line) 1))
    line))

(fn validate_execution_attachments [response]
  (for block in response/blocks
    (if (!= block/kind "attachment") (continue))
    (let body ($str/trim block/body))
    (if (&& (== block/terminator "ELIDED") ($str/starts_with? body "[elided ") ($str/contains? body "; (recall \"") ($str/ends_with? body "\")]"))
      (read_error
        block/line
        ($to_str
          "attachment "
          block/name
          " is a history placeholder; use recall to recover its original body or provide the full attachment"))))
  response)

(fn split_response [text : Str]
  (let lines ($str/split text "\n"))
  (let code_parts [])
  (var start lines/.size)
  (var index 0)
  (while (< index lines/.size)
    (let line (structural_line lines/%index))
    (if (&& (block_start? line) (complete_code? ($str/join code_parts "")))
      (then (set start index) (break)))
    (code_parts .push (line_text lines index))
    (set index (+ index 1)))
  (let code ($str/join code_parts ""))
  (let attachments {})
  (let blocks [])
  (var patch nil)
  (set index start)
  (while (< index lines/.size)
    (let line (structural_line lines/%index))
    (if (== ($str/trim line) "")
      (then (set index (+ index 1)) (continue)))
    (if ($str/starts_with? line "<<<")
      (then
        (let header ($str/split line " "))
        (if (!= header/.size 2) (read_error (+ index 1) "attachment header must be <<<name terminator"))
        (let name ($str/slice_bytes header/0 3 (- ($str/byte_size header/0) 3)))
        (let terminator header/1)
        (if (|| ($absent? (#"^[A-Za-z0-9_.-]+$" .match name))
                (== terminator "") (! ($absent? (#"\s" .match terminator))))
          (read_error (+ index 1) "invalid attachment name or terminator"))
        (if_not (== (attachments .get name) void)
          (read_error (+ index 1) $"duplicate attachment ${name}"))
        (let opening (+ index 1))
        (set index (+ index 1))
        (let body_parts [])
        (while (&& (< index lines/.size) (!= (structural_line lines/%index) terminator))
          (body_parts .push (line_text lines index))
          (set index (+ index 1)))
        (if (>= index lines/.size) (read_error opening $"unterminated attachment ${name}"))
        (let body ($str/join body_parts ""))
        (attachments .put name body)
        (blocks .push {^kind "attachment" ^name name ^line opening ^body body ^terminator terminator})
        (set index (+ index 1)))
      (elif (== line "*** Begin Patch")
        (if_not ($absent? patch) (read_error (+ index 1) "a response may contain at most one patch"))
        (let opening (+ index 1))
        (let body_parts [(line_text lines index)])
        (set index (+ index 1))
        (while (&& (< index lines/.size) (!= (structural_line lines/%index) "*** End Patch"))
          (body_parts .push (line_text lines index))
          (set index (+ index 1)))
        (if (>= index lines/.size) (read_error opening "unterminated patch"))
        (body_parts .push (line_text lines index))
        (set patch ($str/join body_parts ""))
        (blocks .push {^kind "patch" ^line opening ^body patch})
        (set index (+ index 1)))
      (else (read_error (+ index 1) "expected an attachment or patch after response code"))))
  # Read the code even when there were no blocks. Reading remains inert.
  (let forms (read_response_code code))
  {^text text ^code code ^forms forms ^attachments attachments ^patch patch ^blocks blocks})
