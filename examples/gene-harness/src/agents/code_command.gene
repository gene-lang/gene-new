# Direct user code reuses the model evaluator and workspace transactions.
(mod code_command)

(import $parse [read_all])
(import [Plugin PluginContext PluginHost Harness ExecutionLimits log_append CommandError assemble_request log_events]
  ^from "../kernel")
(import_impl PluginHost for PluginContext ^from "../kernel")
(import [run_program] ^from "./llm")

(fn command_code [h : Harness, source : Str] : Str
  (var text ($str/trim source))
  (if (== text "") (return "usage: /code <Gene code>, for example /code (+ 1 2)"))
  (var forms [])
  (try
    (for form in (read_all text) (forms .push form))
  catch Any
    (fail (CommandError ^code "code_error" ^message $"code parse error: ${$err/message}")))
  (if (== forms/.size 0) (return "usage: /code <Gene code>, for example /code (+ 1 2)"))
  (if ($absent? h/workspace) (return "code execution requires a harness workspace"))
  (var history ($cell (assemble_request (log_events h))))
  (log_append h "output" text ^phase "code" ^round 1)
  # The command callback has an outer budget. Bound evaluation separately so
  # exhausting user code still leaves time and steps to abort the transaction.
  (run_program h `(do %forms...) ^session history
    ^raise_errors true
    ^prompt $"/code ${text}" ^author {^by "program/user" ^model ""}
    ^evaluation_limits (ExecutionLimits ^max_steps 25000 ^max_memory_mb 32 ^timeout_ms 1000)))

(fn code_command_plugin [] : Plugin
  (Plugin ^id "code_command" ^provides [["commands" "code"]]
    ^contextual true
    ^activate (fn [] (fn [host]
      (host .PluginHost:contribute "commands"
        {^name "code" ^doc "run Gene code directly: /code (+ 1 2)"
         ^raw_input true ^run command_code})))))
