# The agent: what turns a prompt into a response.
#
# This is the `HarnessPrompt` provider, and it is deliberately deployment-
# agnostic — the terminal loop in repl.gene, a future HTTP handler, and a test
# all send it the same way. A real harness binds a model here; this one
# interprets commands, which is enough to show that the seam is the boundary.
#
# The commands are the harness talking about itself: what is installed, what is
# bound, what happened, and — the interesting one — `build`, which writes a new
# plugin and loads it into the running system.

(mod agent)

(import [Plugin PluginContext PluginHost Harness provide resolve seam_bound
         row row_record rows invoke_registry_row plugin_states bound_seams ToolTask
         lifecycle_log log_append uninstall retry status_of
         installed transaction_diff flush_harness HarnessError current_run_id
         run_needs_recovery? CommandError describe_tools describe_tool current_run_round] ^from "../kernel")
(import_impl PluginHost for PluginContext ^from "../kernel")
(import [HarnessPrompt HarnessFs HarnessRender HarnessCodegen head_tool
         prompt_provider codegen_provider]
  ^from "../seams")
(import [register_module composition_entries ensure_module_blob disable_entry enable_entry]
  ^from "../storage/workspace")
(import [execute_tool await_owned_tasks] ^from "../runtime/tools")

(import [ask_result] ^from "../runtime/prompt" ^export true)
(import [ask] ^from "../runtime/cli_driver" ^export true)

# --- word handling ---------------------------------------------------------

(fn words [text : Str] : Any
  # `$str/split` yields empty strings for repeated separators, so drop them.
  (var out ($thaw #[]))
  (for w in ($str/split ($str/trim text) " ")
    (if_yes (!= w "") (out .push w)))
  out)

(fn word [parts, i : Int] : Str
  (var v parts/%i)
  (if (== v void) "" ($to_str v)))

(fn words_from [parts, i : Int] : Str
  (var out ($thaw #[]))
  (var j i)
  (while (< j parts/.size)
    (out .push ($to_str parts/%j))
    (set j (+ j 1)))
  ($str/join out " "))

# --- generated plugins -----------------------------------------------------

(fn safe_name? [name : Str] : Bool
  (var bad false)
  (if_yes (== name "") (set bad true))
  (for c in ["/" "\\" ".." "\"" "'" "$" "~" ":" ";" "*" "?" "<" ">" "|"]
    (if_yes ($str/contains? name c) (set bad true)))
  (if_yes (> ($str/byte_size name) 40) (set bad true))
  (== bad false))

(fn plugin_source [name : Str, text : Str]
  # Source is data, not a string template. Quasiquote inserts the untrusted
  # strings as Str values, so quotes, interpolation markers, and newlines can
  # never close a literal and become code.
  `(mod plugin
     (import [Plugin DescriptorContext PluginContext PluginHost]
       ^from "../../../src/plugin_api")
     (import_impl PluginHost for PluginContext ^from "../../../src/kernel")
     (fn run [arg] : Str
       ($str/join [(unquote name) "(" arg ") -> " (unquote text)] ""))
     (fn init [ctx : DescriptorContext] : Plugin
       ^capabilities []
       (Plugin ^id %name
         ^provides [["tools" (unquote name)]] ^requires []
         ^contextual true
         ^activate (fn [] (fn [host]
           (host .PluginHost:contribute "tools"
             {^name %name ^doc %text ^run run})))))))

# --- the default author ----------------------------------------------------
#
# One provider of `HarnessCodegen`, and the only one that needs no authority:
# it fills the template above. `web` and `cli` bind it, which is why `build`
# works offline, in a test, and with no key — and why the tour is reproducible.
# `chat` binds a model instead and `build` means something else entirely,
# without this file or `build_tool` knowing that happened.

(type TemplateCodegen)

(impl HarnessCodegen for TemplateCodegen
  (message generate [name : Str, request : Str, ^on_reply on_reply = nil] : Any
    (plugin_source name request))
  (message author [] : Any
    # No model wrote this one, and the durable entry should say so rather than
    # carry the name of whichever model happened to be configured.
    {^by "template" ^model ""}))

(fn template_codegen_plugin [] : Plugin
  (Plugin ^id "codegen" ^provides ["HarnessCodegen"]
    ^contextual true
    ^activate (fn [] (fn [host]
      (host .PluginHost:provide "HarnessCodegen"
        (codegen_provider (TemplateCodegen)))))))

(fn build_plugin [h : Harness, name : Str, text : Str,
                  ^scope scope = nil, ^selectors selectors = nil]
  (if_yes (== name "")
    (fail (HarnessError ^message "usage: build <name> <text...>")))
  (if_not (safe_name? name)
    (fail (HarnessError
      ^message $"unsafe tool name ${name}: one plain word, no path characters")))
  (if (== h/workspace nil)
    (fail (HarnessError
      ^message "durable build requires a harness workspace")))
  # The author is a seam, so `build` cannot tell a template from a model — and
  # neither can what it registers. Whatever comes back is an inert quoted node;
  # `register_module` is what decides whether it is a legal module at all
  # (`canonical_module_source`: a `(mod plugin ...)` root, an inert top level,
  # a defined `init`, imports inside the declared closure). A provider is
  # therefore untrusted by construction, which is the only way an authored-by-
  # model plugin can be safe to accept.
  (var codegen (resolve h "HarnessCodegen"))
  (var authored (codegen .HarnessCodegen:generate name
    $"${text}\n\nInstalled tool contracts: ${(describe_tools h)}\nRequested scope: ${scope}; selectors: ${selectors}.\nFor real I/O prefer delegating to installed tools through PluginHost:request_tool. Declare those tool dependencies."
    ^on_reply (fn [raw]
      (log_append h "output" raw ^phase "raw_response" ^round ($math/max 1 (current_run_round h)))
      (flush_harness h))))
  (var plan (if (== ($head authored) Map) authored {^module authored}))
  (var source plan/module)
  # Provenance is provider knowledge, so `build` asks for it rather than
  # guessing. Until it did, every entry this command committed carried
  # ^by "" ^model "" ^at "" — a durable record that could not say who wrote a
  # module, while the thing that wrote it stood right there.
  (var author (codegen .HarnessCodegen:author))
  (var registered
    (register_module h/workspace h name source
      ^scope (?? scope (?? plan/scope "session"))
      ^selectors (?? selectors (?? plan/selectors []))
      ^dependencies (?? plan/dependencies [])
      ^by author/by ^model author/model ^at ($to_str (gene/now))
      # `build` is the only verb that claims a durable name and there is no
      # verb that releases one — `disable` takes an entry out of desired state
      # but the name stays taken. Create-only therefore made iterating on a
      # generated tool mean inventing a new name per attempt (slugify, slug,
      # slug2). Replacement is already a first-class recorded outcome:
      # `record_composition_change` writes "replaced", the previous blob stays
      # in the store, and each one is a new revision you can read back.
      ^replace true))
  (var tools [])
  (for tool in (describe_tools h)
    (if_yes (== tool/owner name) (tools .push tool)))
  {^id name ^revision registered/revision ^status registered/status ^tools tools
   ^message "Registered. Invoke the advertised tools with real inputs to verify their behavior."})

(fn build_tool [h : Harness, name : Str, text : Str] : Str
  ($to_str (build_plugin h name text)))

(fn build_plugin_tool [h input]
  (ToolTask ^task (spawn ^lane root
    (build_plugin h input/name input/request ^scope input/scope ^selectors input/selectors))))

(fn inspect_plugin_tool [h input]
  (for entry in (composition_entries h/workspace)
    (if_yes (== entry/id input/name)
      (var path (ensure_module_blob h/workspace entry/module_digest))
      (return {^entry entry ^source ($fs/read_text path)})))
  (fail (HarnessError ^message $"No durable plugin ${input/name}")))

(fn disable_plugin_tool [h input]
  {^id input/name ^revision (disable_entry h/workspace input/name ^h h)})

(fn enable_plugin_tool [h input]
  {^id input/name ^revision (enable_entry h/workspace input/name ^h h)})

(fn tool_names [h : Harness] : Any
  (var out ($thaw #[]))
  (for tool in (rows h "tools") (out .push tool/name))
  out)

# --- the command surface ---------------------------------------------------

(fn help_text [h : Harness] : Str
  (var lines ($thaw #["commands:"]))
  (for command in (rows h "commands")
    (lines .push $"  ${command/name}  ${command/doc}"))
  (if_yes (== (current_run_id h) "")
    (lines .push "  quit | exit | Ctrl-D  leave"))
  ($str/join lines "\n"))

(fn command_help [h, parts] (help_text h))
(fn command_status [h, parts] ($to_str (plugin_states h)))
(fn command_seams [h, parts] ($to_str (bound_seams h)))
(fn command_log [h, parts] ($str/join (lifecycle_log h) "\n"))
(fn command_tools [h, parts] ($to_str (tool_names h)))
(fn read_command_result [h, parts]
  (var result (execute_tool h "fs.read" {^path (word parts 1)} ^round 1))
  (if_not result/ok (fail (CommandError ^code "tool_failed" ^message result/error/message)))
  (if (== result/waiting true) "" ($to_str result)))
(fn command_read [h, parts]
  (ToolTask ^task (spawn ^lane root (read_command_result h parts))))
(fn tool_command_result [h, source]
  (var input (command_input source))
  (var text ($str/trim input/source))
  (var value text)
  (if_yes (|| ($str/starts_with? text "{") ($str/starts_with? text "["))
    (set value
      (try ($json/parse text)
        catch Any
          (var forms ($parse/read_all text))
          (var first (forms .next))
          (if (forms .has_next) (fail (HarnessError ^message "tool input must be one data value")))
          first)))
  (var result (execute_tool h input/name value ^round 1))
  (if_not result/ok (fail (CommandError ^code "tool_failed" ^message result/error/message)))
  (if (== result/waiting true) "" ($to_str result)))
(fn command_tool [h, source]
  (ToolTask ^task (spawn ^lane root (tool_command_result h source))))
(fn command_build [h, parts]
  (ToolTask ^task (spawn ^lane root (build_tool h (word parts 1) (words_from parts 2)))))
(fn command_unload [h, parts] (uninstall h (word parts 1)))
(fn command_retry [h, parts] (retry h (word parts 1)))
(fn command_diff [h, parts] ($to_str (transaction_diff h)))

(fn command_input [prompt : Str]
  # Find the command's first whitespace separator without rewriting its tail.
  # Source commands need original newlines, comments and spaces in strings.
  (var text ($str/trim prompt))
  (var bytes ($str/to_utf8 text))
  (var length ($str/byte_size text))
  (var end 0)
  (while (< end length)
    (if ([9 10 13 32] .contains? (bytes .get end)) (break))
    (set end (+ end 1)))
  {^name ($str/slice_bytes text 0 end)
   ^source ($str/slice_bytes text end (- length end))})

(fn dispatch [h : Harness, prompt : Str] : Str
  (var input (command_input prompt))
  (var cmd input/name)
  (var record (row_record h "commands" cmd))
  (if ($absent? record) (return $"I don't know \"${cmd}\". Try `/help`."))
  (var command record/payload)
  (var value
    (if (== command/raw_input true)
      (then (invoke_registry_row h "commands" cmd [h input/source]))
      (else
        (var parts [cmd])
        (for part in (words input/source) (parts .push part))
        (invoke_registry_row h "commands" cmd [h parts]))))
  ($to_str (await_owned_tasks h record/owner value)))

# --- the provider, and the plugin that binds it ----------------------------

(type CommandAgent)

(impl HarnessPrompt for CommandAgent
  (message handle [h, prompt : Str] : Str
    (var command ($str/trim prompt))
    (if_yes ($str/starts_with? command "/")
      (set command ($str/slice_bytes command 1 (- ($str/byte_size command) 1))))
    (dispatch h command)))

(fn agent_prompt_text [] : Str
  "Commands and tools are registry rows. Query `commands` and `tools` through introspection; use `build <name> <text>` to register a durable generated tool.")

(fn command_plugin [] : Plugin
  (Plugin ^id "commands"
    ^provides [["commands" "help"] ["commands" "status"]
               ["commands" "seams"] ["commands" "log"]
               ["commands" "read"] ["commands" "tools"]
               ["commands" "tool"] ["commands" "build"]
               ["commands" "unload"] ["commands" "retry"]
               ["commands" "diff"]
               ["tools" "plugins.build"] ["tools" "plugins.inspect"]
               ["tools" "plugins.disable"] ["tools" "plugins.enable"]
               ["prompt" "agent_commands"]]
    ^contextual true
    ^activate (fn [] (fn [host]
      (host .PluginHost:contribute "tools"
        {^name "plugins.build" ^doc "Build or revise a durable plugin from a description. Read its contracts and test it afterward; this does not execute guessed test inputs."
         ^run build_plugin_tool ^contextual true
         ^input_schema {^type "object" ^required ["name" "request"] ^additionalProperties false
           ^properties {^name {^type "string"} ^request {^type "string"}
             ^scope {^type "string" ^enum ["session" "workspace"]}
             ^selectors {^type "array" ^items {^type "object"}}}}})
      (for item in [["plugins.inspect" "Read a durable plugin's source and metadata." inspect_plugin_tool]
                   ["plugins.disable" "Persistently disable a custom plugin." disable_plugin_tool]
                   ["plugins.enable" "Re-enable a durable custom plugin." enable_plugin_tool]]
        (host .PluginHost:contribute "tools"
          {^name item/0 ^doc item/1 ^run item/2 ^contextual true
           ^input_schema {^type "object" ^required ["name"] ^additionalProperties false
             ^properties {^name {^type "string"}}}}))
      (host .PluginHost:contribute "commands"
        {^name "help" ^doc "show registry-derived help" ^run command_help})
      (host .PluginHost:contribute "commands"
        {^name "status" ^doc "show plugin lifecycle states" ^run command_status})
      (host .PluginHost:contribute "commands"
        {^name "seams" ^doc "show bound seams" ^run command_seams})
      (host .PluginHost:contribute "commands"
        {^name "log" ^doc "show lifecycle history" ^run command_log})
      (host .PluginHost:contribute "commands"
        {^name "read" ^doc "read through HarnessFs" ^run command_read})
      (host .PluginHost:contribute "commands"
        {^name "tools" ^doc "list registered tools" ^run command_tools})
      (host .PluginHost:contribute "commands"
        {^name "tool" ^doc "invoke a registered tool: /tool fs.read {\"path\":\"README.md\"}"
         ^raw_input true ^run command_tool})
      (host .PluginHost:contribute "commands"
        {^name "build" ^doc "register a durable generated plugin" ^run command_build})
      (host .PluginHost:contribute "commands"
        {^name "unload" ^doc "uninstall a plugin for this run" ^run command_unload})
      (host .PluginHost:contribute "commands"
        {^name "retry" ^doc "retry a failed plugin" ^run command_retry})
      (host .PluginHost:contribute "commands"
        {^name "diff" ^doc "show the active turn's staged changes"
         ^run command_diff})
      (host .PluginHost:contribute "prompt"
        {^name "agent_commands" ^text (agent_prompt_text)})))))

(fn agent_plugin [] : Plugin
  (Plugin ^id "agent" ^provides ["HarnessPrompt"]
    ^contextual true
    ^activate (fn [] (fn [host]
      (host .PluginHost:provide "HarnessPrompt"
        (prompt_provider (CommandAgent)))))))
