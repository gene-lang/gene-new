(mod provider_selection)
(import ^from "../kernel" [row rows HarnessError])

(fn nonempty [value]
  (if ($absent? value) (return nil))
  (let text ($str/trim ($to_str value)))
  (if (== text "") nil text))

(fn provider_reason [candidate]
  (if ($absent? candidate/available) (return nil))
  (try
    (candidate/available)
  catch Any
    ($to_str $err/message)))

(fn choose_auto [h]
  (var selected nil)
  (for candidate in (rows h "providers")
    (if ($absent? candidate/auto) (continue))
    (if_not ($absent? (provider_reason candidate)) (continue))
    (if (|| ($absent? selected)
            (< candidate/auto selected/auto)
            (&& (== candidate/auto selected/auto)
                (< ($order/compare candidate/name selected/name) 0)))
      (set selected candidate)))
  selected)

(fn provider_choice [runtime, settings, ^environment supplied = nil]
  (let pinned (nonempty runtime/profile/provider))
  (let environment
    (nonempty (if ($absent? supplied)
      ($os/env? "GENE_HARNESS_PROVIDER")
      supplied/GENE_HARNESS_PROVIDER)))
  (let configured (nonempty settings/provider))
  (let name (if (|| (== runtime/managed true) (== settings/session_override true))
    (?? pinned configured environment) (?? pinned environment configured)))
  (let candidate
    (if ($absent? name)
      (choose_auto runtime/h)
      (row runtime/h "providers" name)))
  (if ($absent? candidate)
    (return {^name (?? name "")
      ^reason (if ($absent? name)
        "no provider is available"
        $"providers/${name} is missing")}))
  (let reason (provider_reason candidate))
  (if_not ($absent? reason)
    (return {^name candidate/name ^reason reason ^row candidate}))
  {^name candidate/name ^reason nil ^row candidate})

(fn readiness_report [runtime, settings]
  (for requirement in (?? runtime/profile/requires [])
    (let registry ($to_str requirement/0))
    (let key ($to_str requirement/1))
    (if ($absent? (row runtime/h registry key))
      (return $"${runtime/profile/name} cannot run: ${registry}/${key} is missing")))
  (let choice (provider_choice runtime settings))
  (if_not ($absent? choice/reason)
    (return $"${runtime/profile/name} cannot run: ${choice/reason}"))
  nil)

(fn select_provider [runtime, settings, ^environment supplied = nil]
  (let choice (provider_choice ^environment supplied runtime settings))
  (if_not ($absent? choice/reason)
    (fail (HarnessError ^message choice/reason)))
  (let inherited_provider (nonempty (if ($absent? supplied)
    ($os/env? "GENE_HARNESS_PROVIDER") supplied/GENE_HARNESS_PROVIDER)))
  (let applicable (|| (!= runtime/managed true) ($absent? inherited_provider)
    (== inherited_provider choice/name)))
  (let inherited_model (if applicable (nonempty (if ($absent? supplied)
    ($os/env? "GENE_HARNESS_MODEL") supplied/GENE_HARNESS_MODEL)) nil))
  (let inherited_effort (if applicable (nonempty (if ($absent? supplied)
    ($os/env? "GENE_HARNESS_THINKING_EFFORT") supplied/GENE_HARNESS_THINKING_EFFORT)) nil))
  (let model (if (|| (== runtime/managed true) (== settings/session_override true)) (?? (nonempty settings/model) inherited_model)
    (?? inherited_model (nonempty settings/model))))
  (let effort (if (|| (== runtime/managed true) (== settings/session_override true)) (?? (nonempty settings/effort) inherited_effort)
    (?? inherited_effort (nonempty settings/effort))))
  (let timeout (?? settings/provider_timeout_ms 600000))
  (let effective (choice/row/configure model effort timeout))
  {^name choice/name ^row choice/row ^settings effective})

(fn session_settings [metadata, settings]
  (if ($absent? metadata/model_settings) (return settings))
  (let effective ($thaw ($freeze settings)))
  (for key in ["provider" "model" "effort"]
    (let value (metadata/model_settings .get key))
    (if_not ($absent? value) (effective .put key value)))
  (effective .put "session_override" true)
  effective)
