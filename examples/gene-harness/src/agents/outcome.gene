(mod outcome)
(import ^from "../runtime/questions" [validate_questions])
(import [normalize_delegation_wait delegation_result_data] ^from "../runtime/delegation_contract")

(type Outcome ^props {^done Bool? ^prompt Any? ^reply Str? ^audio_reply Any? ^questions Any? ^attention Bool?
  ^wait Any? ^result Any? ^wake_on_questions Bool? ^extensions Any?})
(type CheckedOutcome ^^private ^props {^value Outcome})
(type OutcomeError ^props {^message Str ^response_line Int?} ^impl [Error])
(impl Error for OutcomeError)
(type TurnClosed ^props {^message Str ^turn Int?} ^impl [Error])
(impl Error for TurnClosed)

# Only the harness's leased schema admission creates this private envelope.
# A plain Outcome carrying unverified extension data is rejected below.
(fn checked_outcome_extensions [value : Outcome] (CheckedOutcome ^value value))

(fn new_turn_items [turn : Int, ^attachments attachments = {}, ^recall recall = nil, ^console console = nil]
  {
    ^turn turn
    ^queue_token ($crypto/random_hex 16)
    ^composition_queued ($cell false)
    ^delegation_staged ($cell [])
    ^delegation_guard nil
    ^delegation_collection false
    ^state ($cell "open")
    ^items ($cell [])
    ^media ($cell [])
    ^labels ($cell {})
    ^attachments attachments
    ^recall recall
    ^console console})

(fn require_turn [turn]
  (if (|| ($absent? turn) (!= turn/state/.get "open"))
    (fail
      (TurnClosed ^turn (if ($absent? turn) nil turn/turn) ^message (if ($absent? turn) "operation requires an open turn" $"turn ${turn/turn} is closed"))))
  turn)

(fn next_label [turn, label : Str]
  (let labels turn/labels/.get)
  (let count (+ (?? (labels .get label) 0) 1))
  (labels .put label count)
  (if (== count 1)
    label
    $"${label}#${count}"))

(fn add_item [turn, label : Str, value, ^line line = nil, ^form form = nil, ^function function = nil]
  (require_turn turn)
  (let item
    {
      ^id $"${turn/turn}.${(next_label turn label)}"
      ^value value
      ^line line
      ^form form
      ^function function})
  (turn/items
    .get
    ; .push item)
  value)

(fn append_prompt_at [turn, label : Str, line : Int, form, value]
  (if ($absent? (#"^[a-z0-9_]+$" .match label))
    (fail (OutcomeError ^message "append_prompt label must match [a-z0-9_]+")))
  (let call `(append_prompt %label %form))
  (add_item ^line line ^form call turn label value))

(fn append_plugin_prompt [label : Str, value]
  (let context ($runtime/context))
  (let turn (if ($absent? context) nil (?? context/turn nil)))
  (require_turn turn)
  (if ($absent? (#"^[a-z0-9_]+$" .match label))
    (fail (OutcomeError ^message "append_prompt label must match [a-z0-9_]+")))
  (add_item ^function (?? context/function "plugin") turn label value))

(fn attachment [turn, name : Str] : Str
  (let text (turn/attachments .get name))
  (if (== text void) (fail (OutcomeError ^message $"unknown attachment ${name}")))
  text)

(fn recall [turn, id : Str]
  (if ($absent? turn/recall) (fail (OutcomeError ^message $"unknown or expired recall id ${id}")))
  (turn/recall id))

(fn value_text [value] : Str
  (if (== ($head value) Str)
    value
    ($to_str value)))

(fn nonempty_prompt? [value] : Bool
  (if (== value void) (return false))
  (if (== ($head value) Str)
    (!= value "")
    true))

(fn normalize_audio_reply [turn, value]
  (let raw value/audio_reply)
  (if ($absent? raw) (return value))
  (var audio nil)
  (if (&& (== ($head raw) Str) (<= ($str/byte_size raw) 2048)
          (try ($binary/decode_utf8 ($binary/from_str raw)) true catch Any false)
          (! ($absent? value/reply)) (!= ($str/trim value/reply) "") (!= ($str/trim raw) ""))
    (set audio ($str/trim raw))
    (if_not ($absent? turn/console)
      (turn/console "Ignored audio_reply: use at most 2 KiB of nonempty text alongside reply.\n")))
  # Copy rather than mutate: a model may return a frozen Outcome.
  (Outcome ^done value/done ^prompt value/prompt ^reply value/reply ^audio_reply audio
    ^questions value/questions ^attention value/attention ^wait value/wait
    ^result value/result ^wake_on_questions value/wake_on_questions ^extensions value/extensions))

(fn validate_outcome [turn, value, ^validators validators = {}, ^renderers renderers = {}]
  (let checked (== ($head value) CheckedOutcome))
  (let raw (if checked value/value value))
  (let candidate (if (== ($head raw) Outcome) raw (Outcome ^prompt raw)))
  (if_not ($absent? candidate/extensions)
    (if (!= ($head candidate/extensions) Map)
      (fail (OutcomeError ^message "Outcome extensions must be a map of registered keys.")))
    (if (&& (! checked) (> ($size candidate/extensions) 0))
      (fail (OutcomeError ^message "Outcome extension data requires leased schema validation."))))
  (let outcome (normalize_audio_reply turn candidate))
  (if_not ($absent? outcome/result)
    (if (!= outcome/done true) (fail (OutcomeError ^message "result requires a done Outcome.")))
    (delegation_result_data outcome/result))
  (if_not ($absent? outcome/wait)
    (if (|| outcome/done (! ($absent? outcome/questions)))
      (fail (OutcomeError ^message "wait cannot be combined with done or questions.")))
    (if turn/delegation_collection
      (fail (OutcomeError ^message "The collection turn cannot wait or start more work; finish with done.")))
    (normalize_delegation_wait outcome/wait ^wake_on_questions (== outcome/wake_on_questions true))
    (return {^kind "wait" ^outcome outcome ^questions nil}))
  (if (== outcome/done true)
    (then
      (if (|| ($absent? outcome/reply) (== ($str/trim outcome/reply) ""))
        (fail (OutcomeError ^message "done Outcome requires a non-empty reply")))
      (if (|| (!= outcome/prompt void) (!= outcome/questions void))
        (fail (OutcomeError ^message "done Outcome rejects prompt and questions")))
      (if turn/composition_queued/.get
        (return {^kind "continue" ^outcome (Outcome ^reply outcome/reply ^audio_reply outcome/audio_reply ^extensions outcome/extensions)
          ^questions nil ^^rejected_done}))
      (if (|| (! turn/delegation_staged/.get/.empty?)
              (&& (! ($absent? turn/delegation_guard)) (turn/delegation_guard)))
        (return {^kind "continue" ^outcome (Outcome ^reply outcome/reply ^audio_reply outcome/audio_reply ^extensions outcome/extensions)
          ^questions nil ^^rejected_delegation_done}))
      (if_not turn/media/.get/.empty?
        (return {^kind "continue" ^outcome (Outcome ^reply outcome/reply ^audio_reply outcome/audio_reply ^extensions outcome/extensions)
          ^questions nil ^^rejected_done}))
      (if (> ($size turn/items/.get) 0)
        (then
          (if_not ($absent? turn/console)
            (turn/console """done Outcome dropped appended prompt items
"""))
          (turn/items .set [])))
      (return {^kind "done" ^outcome outcome ^questions nil})))
  (if_not ($absent? outcome/questions)
    (return
      {
        ^kind "questions"
        ^outcome outcome
        ^questions (validate_questions ^validators validators ^renderers renderers outcome/questions)}))
  (if (&& (! (nonempty_prompt? outcome/prompt)) (== ($size turn/items/.get) 0)
          turn/delegation_staged/.get/.empty?)
    (fail (OutcomeError ^message "continuing Outcome requires a prompt or append_prompt items")))
  {^kind "continue" ^outcome outcome ^questions nil})

(fn plain_form [form]
  (if (== ($head form) List) (return ($map form plain_form)))
  (if (== ($head form) Map) (return ($map form plain_form)))
  (match form
    (when (node : Node)
      (let body ($map ($node/body form) plain_form))
      (let props ($map ($node/props form) plain_form))
      # These symbols are only printed as headers, never evaluated. Restore
      # static reader paths so the next request uses the model's source style.
      (if_yes (&& (== ($head form) (quote path)) (> body/.size 0) (== ($size props) 0))
        (var static true)
        (let parts [])
        (for segment in body
          (if_not ([Sym Int] .contains? ($head segment)) (set static false))
          (parts .push ($to_str segment)))
        (if_yes static
          (if (&& (== parts/0 "gene") (> parts/.size 1))
            (return ($to_sym ($to_str "$" ($str/join ($drop parts 1) "/")))))
          (return ($to_sym ($str/join parts "/")))))
      ($node/rebuild ^head (plain_form ($head form)) ^body body ^props props ^meta {} form))
    (else
      form)))

(fn rewrite_prompt_calls [forms]
  ($map forms rewrite_prompt_form))

(fn rewrite_prompt_form [form]
  (if (== ($head form) List) (return ($map form rewrite_prompt_form)))
  (if (== ($head form) Map) (return ($map form rewrite_prompt_form)))
  (match form
    (when (node : Node)
      (let head ($head form))
      (if ([`quote `quasiquote] .contains? head) (return form))
      (let body ($node/body form))
      (if (== head (quote card)) (return (rewrite_card_form form)))
      (if (== head (quote append_prompt))
        (then
          (let meta ($node/meta form))
          (let line (?? meta/line 1))
          (if (|| (!= body/.size 2) (!= ($head body/0) Str))
            (fail
              (OutcomeError ^response_line line ^message "append_prompt requires a literal label and a value")))
          (if ($absent? (#"^[a-z0-9_]+$" .match body/0))
            (fail
              (OutcomeError ^response_line line ^message "append_prompt label must match [a-z0-9_]+")))
          (let value_form body/1)
          (let value (rewrite_prompt_form value_form))
          (let quoted `(quote %value_form))
          (return
            ($node/rebuild ^head (quote append_prompt_at) ^body [body/0 line quoted value] form))))
      ($node/rebuild ^body ($map body rewrite_prompt_form) ^props ($map ($node/props form) rewrite_prompt_form)
        form))
    (else
      form)))

(fn fn_form? [form] : Bool
  (match form
    (when (node : Node) (== ($head node) (quote fn)))
    (else false)))

# A card keeps its ^view and ^update functions as source (docs/cards.md), so
# they are quoted here and never evaluated in the turn that made the card.
(fn rewrite_card_form [form]
  (let meta ($node/meta form))
  (let line (?? meta/line 1))
  (let props {})
  (for [key value] in ($node/props form)
    (let name ($to_str key))
    (if (["view" "update"] .contains? name)
      (then
        (if_not (fn_form? value)
          (fail
            (OutcomeError ^response_line line ^message $"card ^${name} must be a literal (fn ...) form")))
        (props .put key `(quote %value)))
      (else
        (props .put key (rewrite_prompt_form value)))))
  (let body [line])
  (for item in ($node/body form) (body .push (rewrite_prompt_form item)))
  ($node/rebuild ^head (quote card_at) ^body body ^props props form))

(fn abbreviated_form [form] : Str
  (let printed ($to_str (plain_form form)))
  (let characters ($graphemes printed))
  (if (<= characters/.size 100) (return printed))
  (let prefix ($take characters 100))
  ($str/join [($str/join prefix "") "…"] ""))

(fn item_header [item] : Str
  (var header $"[${item/id}]")
  (if_not ($absent? item/function) (return $"${header} fn ${item/function}"))
  (if_not ($absent? item/line) (set header $"${header} line ${item/line}:"))
  (if_not ($absent? item/form) (set header $"${header} ${(abbreviated_form item/form)}"))
  header)

(fn request_items [turn, validated, ^patch patch = nil, ^error error = nil, ^error_line error_line = nil, ^answers answers = nil, ^result_line result_line = nil]
  (let rendered [])
  (if_not ($absent? patch)
    (let patch_id (implicit_id turn "patch"))
    (rendered .push {^id patch_id ^header $"[${patch_id}]" ^value patch ^^inline}))
  (for item in turn/items/.get
    (rendered .push {^id item/id ^header (item_header item) ^value (value_text item/value)}))
  (if_not ($absent? validated)
    (let outcome validated/outcome)
    (if_not (== outcome/prompt void)
      (let result_id (implicit_id turn "result"))
      (let line (if ($absent? result_line) "" $" line ${result_line}: Outcome ^prompt"))
      (rendered .push
        {^id result_id ^header $"[${result_id}]${line}" ^value (value_text outcome/prompt)})))
  (if_not ($absent? error)
    (let error_id (implicit_id turn "error"))
    (let line (if ($absent? error_line) "" $" line ${error_line}:"))
    (rendered .push {^id error_id ^header $"[${error_id}]${line}" ^value error}))
  (if_not ($absent? answers)
    (let answers_id (implicit_id turn "answers"))
    (rendered .push {^id answers_id ^header $"[${answers_id}]" ^value (value_text answers)}))
  rendered)

(fn implicit_id [turn, label : Str] : Str
  (let count (?? (turn/labels .get; .get label) 0))
  (let suffix (if (== count 0) label $"${label}#${(+ count 1)}"))
  $"${turn/turn}.${suffix}")

(fn render_request [turn, validated, ^patch patch = nil, ^error error = nil, ^error_line error_line = nil, ^answers answers = nil, ^result_line result_line = nil]
  (let rendered [])
  (for item in (request_items ^patch patch ^error error ^error_line error_line ^answers answers ^result_line result_line turn validated)
    (rendered .push
      (if (== item/inline true)
        $"${item/header} ${item/value}"
        ($to_str
          item/header
          """
"""
          item/value))))
  ($str/join
    rendered
    """
"""))
