# Provider transport shared by workspace sessions. Credentials stay in
# the host client; they never enter model prompts or durable harness state.
(mod model_client)

(import $net/http_client [request stream : http_stream])
(import $fs [read_text])
(import ^from "../kernel" [HarnessError])
(import ^from "./claude" [anthropic_request anthropic_text claude_completion])

(fn nonempty [value] : Any
  (if ($absent? value)
    nil
    (if (== ($str/trim ($to_str value)) "")
      nil
      ($str/trim ($to_str value)))))

(fn resolve_config [environment] : Any
  (var key (?? (nonempty environment/OPENROUTER_API_KEY) (nonempty environment/OPENROUTER_KEY)))
  (var anthropic_key (nonempty environment/ANTHROPIC_API_KEY))
  (var provider
    (??
      (nonempty environment/GENE_HARNESS_PROVIDER)
      (if (! ($absent? key))
        "openrouter"
        (if (! ($absent? anthropic_key))
          "anthropic"
          "codex"))))
  (if_not (["codex" "openrouter" "claude" "anthropic"] .contains? provider)
    (fail
      (HarnessError ^message "GENE_HARNESS_PROVIDER must be codex, openrouter, claude, or anthropic")))
  (var model (nonempty environment/GENE_HARNESS_MODEL))
  (if_yes (== provider "openrouter") (set model (?? model (nonempty environment/OPENROUTER_MODEL))))
  (set model
    (??
      model
      (if (== provider "codex")
        "gpt-6-astra"
        (if (== provider "claude")
          "sonnet"
          (if (== provider "anthropic")
            "claude-sonnet-5"
            "openai/gpt-6-astra")))))
  (var effort (?? (nonempty environment/GENE_HARNESS_THINKING_EFFORT) "medium"))
  (var valid_effort false)
  (for supported in ["none" "minimal" "low" "medium" "high" "xhigh" "max"]
    (if_yes (== effort supported) (set valid_effort true)))
  (if_not valid_effort
    (fail
      (HarnessError ^message "GENE_HARNESS_THINKING_EFFORT must be none, minimal, low, medium, high, xhigh, or max")))
  (if_yes (&& (["claude" "anthropic"] .contains? provider) (== effort "minimal"))
    (set effort "low"))
  (var auth_file (nonempty environment/CODEX_AUTH_FILE))
  (if_yes ($absent? auth_file)
    (var home (nonempty environment/CODEX_HOME))
    (if_yes ($absent? home)
      (var user_home (nonempty environment/HOME))
      (if_not ($absent? user_home) (set home $"${user_home}/.codex")))
    (if_not ($absent? home) (set auth_file $"${home}/auth.json")))
  {
    ^provider provider
    ^model model
    ^effort effort
    ^api_key key
    ^auth_file auth_file
    ^anthropic_key anthropic_key
    ^claude_command (?? (nonempty environment/GENE_HARNESS_CLAUDE_COMMAND) "claude")})

(fn model_config [^settings settings = {}] : Any
  (var environment {})
  (for name in ["GENE_HARNESS_PROVIDER" "GENE_HARNESS_MODEL" "GENE_HARNESS_THINKING_EFFORT" "GENE_HARNESS_CLAUDE_COMMAND" "ANTHROPIC_API_KEY" "OPENROUTER_API_KEY" "OPENROUTER_KEY" "OPENROUTER_MODEL" "CODEX_AUTH_FILE" "CODEX_HOME" "HOME"]
    (environment .put name ($os/env? name)))
  (for [key name] in {^provider "GENE_HARNESS_PROVIDER" ^model "GENE_HARNESS_MODEL" ^effort "GENE_HARNESS_THINKING_EFFORT"}
    (if ($absent? (nonempty (environment .get name))) (environment .put name (settings .get key))))
  (let config (resolve_config environment))
  (let timeout (?? settings/provider_timeout_ms 600000))
  (if (|| (!= ($head timeout) Int) (<= timeout 0) (> timeout 86400000))
    (fail (HarnessError ^message "provider_timeout_ms must be an integer between 1 and 86400000")))
  (config .put "provider_timeout_ms" timeout)
  config)

(fn model_name [] : Str
  (var config (model_config))
  config/model)

(fn public_model_config [^settings settings = {}]
  (var config (model_config ^settings settings))
  {^provider config/provider ^model config/model ^effort config/effort})

(fn codex_credentials [path] : Any
  (if_yes ($absent? path)
    (fail (HarnessError
      ^message "cannot locate Codex auth.json; set CODEX_AUTH_FILE, CODEX_HOME, or HOME")))
  # Never include parser diagnostics: malformed JSON may contain a token in
  # the offending source excerpt. The file remains owned and refreshed by Codex.
  (var auth
    (try ($json/parse (read_text path))
      catch Any
      (fail (HarnessError
        ^message $"cannot read Codex auth.json at ${path}; run codex login with file credential storage"))))
  (if_not (== ($head auth) Map)
    (fail (HarnessError ^message "Codex auth.json must contain an object")))
  (var tokens auth/tokens)
  (if_not (== ($head tokens) Map)
    (fail (HarnessError
      ^message "Codex auth.json has no OAuth tokens; sign in with ChatGPT using codex login")))
  (var access tokens/access_token)
  (var account tokens/account_id)
  (if_not (&& (== ($head access) Str) (== ($head account) Str))
    (fail (HarnessError
      ^message "Codex auth.json requires tokens.access_token and tokens.account_id; run codex login")))
  (if_yes (|| ($absent? (nonempty access)) ($absent? (nonempty account)))
    (fail (HarnessError
      ^message "Codex OAuth credentials are empty; run codex login")))
  {^access_token access ^account_id account})

(fn completion_request [config, system : Str, user : Str, max_tokens : Int, ^messages messages = nil] : Any
  (if_yes (== config/provider "anthropic")
    (return (anthropic_request config system user max_tokens ^messages messages)))
  (if_yes (== config/provider "claude")
    (fail (HarnessError ^message "Claude Code uses the local CLI, not an HTTP completion request")))
  (let conversation (if ($absent? messages) [{^role "user" ^content user}]
    (messages .filter (fn [message] (!= message/role "system")))))
  (if (== config/provider "codex")
    (then
      (var credentials (codex_credentials config/auth_file))
      {^url "https://chatgpt.com/backend-api/codex/responses"
       ^headers {^content-type "application/json" ^accept "text/event-stream"
                 ^authorization $"Bearer ${credentials/access_token}"
                 ^chatgpt-account-id credentials/account_id
                 ^OpenAI-Beta "responses=experimental"
                 ^originator "gene-harness"}
       # The Codex endpoint requires streaming and store=false, and does not
       # accept max_output_tokens. The buffered HTTP client still bounds bytes
       # and wall time; only completed responses are allowed to become code.
       ^body {^model config/model ^instructions system
              ^input (conversation .map (fn [message]
                {^role message/role ^content [{^type (if (== message/role "assistant") "output_text" "input_text")
                                             ^text message/content}]}))
              ^reasoning {^effort config/effort}
              ^store false ^stream true}})
    (else
      (if_yes ($absent? config/api_key)
        (fail (HarnessError
          ^message "no OpenRouter API key; set OPENROUTER_API_KEY (or OPENROUTER_KEY)")))
      {^url "https://openrouter.ai/api/v1/chat/completions"
       ^headers {^content-type "application/json"
                 ^authorization $"Bearer ${config/api_key}"}
       ^body {^model config/model
              ^messages (if ($absent? messages) [{^role "system" ^content system} {^role "user" ^content user}] messages)
              ^max_tokens max_tokens ^reasoning {^effort config/effort}}})))

(fn response_text [response] : Str
  (if_not (== response/status "completed")
    (fail (HarnessError ^message "codex response did not complete")))
  (var texts [])
  (var phased false)
  (for item in (?? response/output [])
    (if (&& (== item/type "message") (! ($absent? item/phase))) (set phased true)))
  (for item in (?? response/output [])
    (if_yes (&& (== item/type "message") (== item/role "assistant"))
      (if (&& phased (!= item/phase "final_answer")) (continue))
      (for part in (?? item/content [])
        (if_yes (== part/type "refusal") (fail (HarnessError ^message "codex refused the request")))
        (if_yes (== part/type "output_text") (texts .push part/text)))))
  (var text ($str/join texts ""))
  (if_yes (== ($str/trim text) "") (fail (HarnessError ^message "codex returned no output text")))
  text)

(fn codex_event [data : Str, items] : Any
  (if_yes (|| (== data "") (== data "[DONE]")) (return nil))
  (var event
    (try ($json/parse data)
      catch Any
      (fail (HarnessError ^message "codex returned an invalid stream event"))))
  (if_yes (|| (== event/type "error") (== event/type "response.failed")
               (== event/type "response.incomplete"))
    (fail (HarnessError ^message $"codex stream failed (${event/type})")))
  (if_yes (== event/type "response.output_item.done")
    (items .push event/item))
  (if (|| (== event/type "response.completed") (== event/type "response.done"))
    (then
      (var response event/response)
      (var output (?? response/output []))
      # Codex may send completed items separately and leave the terminal
      # response's output empty. Keep those items, but release text only once
      # the whole response has completed successfully.
      (response_text {^status response/status
                      ^output (if (== output/.size 0) items output)}))
    (else nil)))

(fn codex_stream_text [body : Str] : Str
  # SSE data may span several lines; CRLF, comments, event names and other
  # fields are legal too. Deltas are deliberately ignored: a severed stream
  # must never send a partial Gene program to the evaluator.
  (var data [])
  (var items [])
  (var completed nil)
  (for raw_line in ($str/split body "\n")
    (var line ($str/trim raw_line))
    (if (== line "")
      (then
        (var text (codex_event ($str/join data "\n") items))
        (if_not ($absent? text) (set completed text))
        (set data []))
      (elif ($str/starts_with? line "data:")
        (data .push ($str/trim ($str/slice_bytes line 5 ($str/byte_size line)))))))
  (var last_text (codex_event ($str/join data "\n") items))
  (if_not ($absent? last_text) (set completed last_text))
  (if_yes ($absent? completed)
    (fail (HarnessError ^message "codex stream ended before response.completed")))
  completed)

(fn completion_text [provider : Str, response] : Str
  (if_yes (== provider "anthropic") (return (anthropic_text response)))
  (if_yes (!= response/status 200)
    (if_yes (&& (== provider "codex") (== response/status 401))
      (fail
        (HarnessError ^message "codex 401: OAuth credentials expired or were rejected; run codex login to refresh auth.json")))
    (fail (HarnessError ^message $"${provider} ${response/status}: ${response/body}")))
  (if (== provider "codex")
    (then
      (codex_stream_text response/body))
    (else
      (var parsed ($json/parse response/body))
      (var text parsed/choices/0/message/content)
      (if ($absent? text)
        ""
        (if (== ($head text) Str)
          text
          (fail (HarnessError ^message "provider returned invalid text content")))))))

(fn feed_codex_preview [state, chunk : Str]
  (state .put "pending" $"${state/pending}${chunk}")
  (var lines ($str/split state/pending "\n"))
  (var last (- lines/.size 1))
  (state .put "pending" lines/%last)
  (var i 0)
  (while (< i last)
    (var line ($str/trim lines/%i))
    (if (== line "")
      (then
        (var data ($str/join state/data "\n"))
        (state .put "data" [])
        (if_yes (&& (!= data "") (!= data "[DONE]"))
          # Preview parsing never authorizes execution. The complete response
          # still passes completion_text and the Gene envelope validator.
          (var event (try ($json/parse data) catch Any nil))
          (if_yes (&& (! ($absent? event)) (== event/type "response.output_text.delta")
                      (== ($head event/delta) Str))
            (state .put "text" $"${state/text}${event/delta}"))))
      (elif ($str/starts_with? line "data:")
        (state/data .push ($str/trim ($str/slice_bytes line 5 ($str/byte_size line))))))
    (set i (+ i 1)))
  state/text)

(fn stream_codex_completion [spec, on_delta, ^timeout_ms timeout_ms : Int = 600000] : Str
  (var transfer
    (http_stream ^method "POST" ^url spec/url ^headers spec/headers ^body ($json/stringify spec/body) ^timeout_ms timeout_ms ^max_bytes 2000000 ^max_pending_bytes 2000000 ^channel_capacity 256))
  (var state {^pending "" ^data [] ^text ""})
  (var emitted "")
  (try
    (try
      (loop
        (var chunk transfer/channel/.recv)
        (var text (feed_codex_preview state chunk))
        (if_yes (!= text emitted)
          (set emitted text)
          (on_delta text)))
    catch ChannelClosed
      nil)
    (var response (await transfer/task))
    (completion_text "codex" response)
  ensure
    transfer/task/.cancel))

(fn with_provider_timeout [config, operation] : Str
  (let timeout (?? config/provider_timeout_ms 600000))
  (repeat attempt in 2
    (try
      (return (operation))
    catch HttpClientError
      (if_not ($str/contains? ($str/lower $err/message) "timeout") (fail $err))
      (if (== attempt 1)
        (fail
          (HarnessError ^message $"${config/provider} model provider request exceeded ${(/ timeout 1000.0)} s (2 attempts). Send a continuation message or increase provider_timeout_ms.")))))
  "")

(fn chat_completion [system : Str, user : Str, ^max_tokens max_tokens = nil, ^on_delta on_delta = nil, ^messages messages = nil, ^config configured = nil] : Str
  (var config (?? configured (model_config)))
  (if_yes (== config/provider "claude")
    (return
      (claude_completion config system (if ($absent? messages) user ($serde/write_data messages)))))
  (var budget (?? max_tokens (if (== config/provider "anthropic") 8192 3000)))
  (var spec (completion_request ^messages messages config system user budget))
  (if_yes (&& (== config/provider "codex") (! ($absent? on_delta)))
    (return
      (with_provider_timeout
        config
        (fn []
          (stream_codex_completion ^timeout_ms (?? config/provider_timeout_ms 600000) spec on_delta)))))
  (with_provider_timeout
    config
    (fn []
      (let pending
        (request ^method "POST" ^url spec/url ^headers spec/headers ^body ($json/stringify spec/body) ^timeout_ms (?? config/provider_timeout_ms 600000) ^max_bytes 2000000))
      (var response (try (await pending) ensure pending/.cancel))
      (completion_text config/provider response))))

(fn complete_messages [request] : Str
  (let messages request/messages)
  (let last (- messages/.size 1))
  (chat_completion ^messages messages ^max_tokens (?? request/max_tokens nil) ^config (model_config ^settings (?? request/config {}))
    messages/0/content
    messages/%last/content))
