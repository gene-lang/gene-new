(mod turn_eval)
(import ^from "./response" [split_response])
(import ^from "./outcome"
  [
    Outcome
    new_turn_items
    append_prompt_at
    validate_outcome
    render_request
    request_items
    rewrite_prompt_calls
    attachment
    recall])
(import ^from "./eval_site" [evaluate_response])
(import ^from "../runtime/patch" [prepare_patch commit_patch])
(import ^from "./history" [byte_prefix])

(fn evaluate_turn [number : Int, workspace_root : Str, text : Str,
                   ^bindings bindings = {}, ^timeout_ms timeout_ms : Int = 600000,
                   ^max_memory_mb max_memory_mb : Int = 1024,
                   ^console_sink console_sink = nil, ^recall recall_function = nil,
                   ^record record = nil, ^context inherited = nil,
                   ^validators validators = {},
                   ^fail_after_renames fail_after_renames : Int = -1,
                   ^after_patch_rename after_patch_rename = nil]
  (let console ($cell []))
  (let bytes ($cell 0))
  (let truncated ($cell false))
  (let turn (new_turn_items number ^recall recall_function))
  (let context (if ($absent? inherited) {} ($thaw ($freeze_shallow inherited))))
  (context .put "turn" turn)
  (context .put "output" (fn [text]
    (let late (!= (turn/state .get) "open"))
    (if (truncated .get) (return nil))
    (let marker "[console truncated]\n")
    (let remaining (- 262144 (bytes .get)))
    (let length ($str/byte_size text))
    (let cutoff (> length (- remaining ($str/byte_size marker))))
    (let kept (if cutoff ($to_str (byte_prefix text ($math/max 0 (- remaining ($str/byte_size marker)))) marker) text))
    (if cutoff (truncated .set true))
    (bytes .set (+ (bytes .get) ($str/byte_size kept)))
    (let item {^text kept ^late late})
    (if_not late ((console .get) .push item))
    (if_not ($absent? console_sink) (console_sink item))))
  (turn .put "console" (fn [text] (context/output text)))
  (var patch_result nil)
  (var validated nil)
  (var error nil)
  (var error_line nil)
  (var last_line nil)
  (var cancelled false)
  (try
    (let response (split_response text))
    (turn .put "attachments" response/attachments)
    (var plan nil)
    (if_not ($absent? response/patch)
      (try
        (set plan (prepare_patch workspace_root response/patch))
        catch Any
          (set patch_result {^status "failed" ^text $"failed: ${$err/message}" ^files [] ^attention false})))
    # Durability precedes staging. The caller records body stubs/blob refs.
    (if_not ($absent? record)
      (record "turn/response" {^turn number ^response response
        ^patch_files (if ($absent? plan) [] plan/files)}))
    (if_not ($absent? plan)
      (set patch_result (commit_patch plan ^fail_after_renames fail_after_renames ^after_rename after_patch_rename)))
    (if (&& (! ($absent? patch_result)) (! ($absent? record)))
      (record "turn/patch" {^turn number ^result patch_result}))
    (if (|| ($absent? patch_result) (== patch_result/status "applied"))
      (then
        (let values ($thaw ($freeze_shallow bindings)))
        (values .put "Outcome" Outcome)
        (values .put "workspace_root" workspace_root)
        (values .put "append_prompt_at" (fn [label line form value]
          (append_prompt_at turn label line form value)))
        (values .put "attachment" (fn [name] (attachment turn name)))
        (values .put "recall" (fn [id] (recall turn id)))
        (let environment (env ^bindings values
          ^policy {^timeout_ms timeout_ms ^max_memory_mb max_memory_mb}))
        (let forms (rewrite_prompt_calls response/forms))
        (if (> forms/.size 0)
          (then
            (let last_index (- forms/.size 1))
            (let meta ($node/meta forms/%last_index))
            (set last_line (?? meta/line nil))
            (let expired ($cell false))
            (let outcome (scope
              # The evaluation task itself is a child of the turn, as well as
              # owning the ordinary children created by response code.
              (let task (spawn ^lane root
                ($runtime/with_context context (fn []
                  (evaluate_response `(scope %forms...) environment)))))
              (let deadline (spawn ^lane root
                (do ($sleep timeout_ms) (expired .set true) (task .cancel))))
              (try (task .join)
                ensure (deadline .cancel) (deadline .join))))
            (match outcome
              (when (TaskOutcome/ok value) (set validated (validate_outcome turn value ^validators validators)))
              (when (TaskOutcome/error failure)
                (set error ($to_str failure/message))
                (set error_line (?? failure/line nil)))
              (when (TaskOutcome/panic message) (set error $"panic: ${message}"))
              (when TaskOutcome/cancelled
                (if (expired .get) (set error "response budget timed out") (set cancelled true)))))
          (else
            (set validated (validate_outcome turn (if ($absent? patch_result) nil patch_result/text) ^validators validators))))))
    catch Any
      (set error ($to_str $err/message))
      (set error_line (?? $err/line nil))
    ensure (turn/state .set "closed"))
  (let patch_text (if ($absent? patch_result) nil patch_result/text))
  (let request (if (|| cancelled (&& (! ($absent? validated)) (== validated/kind "done"))) ""
    (render_request turn validated ^patch patch_text ^error error ^error_line error_line ^result_line last_line)))
  (let kind (if cancelled "cancelled" (if ($absent? error)
    (if ($absent? validated) "error" validated/kind) "error")))
  {^kind kind ^validated validated ^request request ^patch patch_result ^error error
   ^console (console .get) ^turn turn
   ^request_items (if (== request "") [] (request_items turn validated ^patch patch_text
     ^error error ^error_line error_line ^result_line last_line))})
