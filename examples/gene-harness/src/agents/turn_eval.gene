(mod turn_eval)
(import ^from "./response" split_response validate_execution_attachments)
(import ^from "./outcome"
    Outcome
    new_turn_items
    append_plugin_prompt
    append_prompt_at
    validate_outcome
    render_request
    request_items
    rewrite_prompt_calls
    attachment
    recall)
(import ^from "./eval_site" evaluate_response)
(import ^from "../runtime/patch" prepare_patch commit_patch with_patch_gate)
(import ^from "../public/text" byte_prefix without_markdown_images)
(import open_execution_scope close_execution_scope ^from "../runtime/execution_budget")
(import ParticipantFailure ^from "../runtime/turn_participants")

(fn response_error_line [failure]
  (?? failure/response_line (if (== failure/file "response") (?? failure/line nil) else nil)))

(fn contains_any? [text : Str, needles] : Bool
  (for needle in needles
    (if ($str/contains? text needle) (return true)))
  false)

(fn response_repair_hint [message : Str] : Str
  (if (contains_any? message ["attachment header" "unterminated attachment" "expected an attachment or patch"])
    (return
      "Put every executable Gene form above the first <<< or *** Begin Patch block. An attachment header is exactly <<<name END, followed by raw body lines, then END on its own line. Never put code after a block."))
  (if (contains_any? message ["character literal" "read_all:" "ParseError" "unexpected token" "expected a"])
    (return
      "The previous response was not readable Gene. Return only Gene forms and # comments. Do not use Markdown or uncommented prose; apostrophes in uncommented prose start character literals."))
  (if ($str/contains? message "undefined symbol: println")
    (return "Console output is ($println value). Do not call bare println."))
  (if ($str/contains? message "undefined symbol: str")
    (return "Use ($to_str value) for string conversion, not (str value)."))
  (if ($str/contains? message "undefined symbol:")
    (return "The previous response was not executable Gene. Keep prose in # comments and finish direct answers with (Outcome ^^done ^reply \"...\")."))
  (if (&& ($str/contains? message "not callable") ($str/contains? message "session/"))
    (return "Property paths are values, not calls: write session/id, not (session/id)."))
  (if (&& ($str/contains? message "not callable") ($str/contains? message "workspace/"))
    (return "Property paths are values, not calls: write workspace/root, not (workspace/root)."))
  (if (&& ($str/contains? message "expected Str") ($str/contains? message "got Nil"))
    (return "A required value was nil. Use (?? map/key default) or check ($present? value) before passing it to a Str parameter."))
  "")

(fn literal_reply_hint [response]
  (if response/forms/.empty? (return nil))
  (match ($last response/forms)
    when (form : Node)
      (if (!= ($head form) (quote Outcome)) (return nil))
      (let value (($node/props form) .get "reply"))
      (if (== ($head value) Str) (byte_prefix (without_markdown_images value) 1024) else nil)
    else nil))

(fn evaluate_turn [number : Int, workspace_root : Str, text : Str,
                   ^bindings bindings = {}, ^timeout_ms timeout_ms : Int = 600000,
                   ^max_memory_mb max_memory_mb : Int = 1024,
                   ^console_sink console_sink = nil, ^recall recall_function = nil,
                   ^record record = nil, ^context inherited = nil,
                   ^normalize_outcome normalize_outcome = nil,
                   ^outcome_binding outcome_binding = nil,
                   ^coordinated coordinated : Bool = false,
                   ^turn_sink turn_sink = nil,
                   ^validators validators = {},
                   ^renderers renderers = {},
                   ^fail_after_renames fail_after_renames : Int = -1,
                   ^after_patch_rename after_patch_rename = nil]
  (let console ($cell []))
  (let bytes ($cell 0))
  (let truncated ($cell false))
  (let turn (new_turn_items number ^recall recall_function))
  (fn validate_value [value]
    (let prepared (if ($absent? normalize_outcome) value else (normalize_outcome turn value)))
    (validate_outcome turn prepared ^validators validators ^renderers renderers ^coordinated coordinated))
  (if_not ($absent? turn_sink) (turn_sink .set turn))
  (var context ((?? inherited {}) .assoc "turn" turn))
  (set context (context .assoc "append_prompt" append_plugin_prompt))
  (set context (context .assoc "output" (fn [text]
    (let late (!= turn/state/.get "open"))
    (if truncated/.get (return nil))
    (let marker "[console truncated]\n")
    (let remaining (- 262144 bytes/.get))
    (let length ($str/byte_size text))
    (let cutoff (> length (- remaining ($str/byte_size marker))))
    (let kept (if cutoff ($to_str (byte_prefix text ($math/max 0 (- remaining ($str/byte_size marker)))) marker) else text))
    (if cutoff (truncated .set true))
    (bytes .set (+ bytes/.get ($str/byte_size kept)))
    (let item {^text kept ^late late})
    (if_not late (console/.get .push item))
    (if_not ($absent? console_sink) (console_sink item)))))
  (turn .put "console" (fn [text] (context/output text)))
  (var patch_result nil)
  (var validated nil)
  (var error nil)
  (var error_line nil)
  (var last_line nil)
  (var cancelled false)
  (var response nil)
  (try
    (set response (split_response text))
    (validate_execution_attachments response)
    (turn .put "attachments" response/attachments)
    (let prepare_and_commit (fn []
      (var plan nil)
      (if_not ($absent? response/patch)
        (try
          (set plan (prepare_patch workspace_root response/patch))
          catch Error
            (set patch_result {^status "failed" ^text $"failed: ${$err/.message}" ^files [] ^!attention})))
      # Durability precedes staging, while the workspace patch gate prevents
      # another response from preparing against this plan's original files.
      (if_not ($absent? record)
        (record "turn/response" {^turn number ^response response ^reply_hint (literal_reply_hint response)
          ^patch_files (if ($absent? plan) [] else plan/files)}))
      (if_not ($absent? plan)
        (set patch_result (commit_patch plan ^fail_after_renames fail_after_renames ^after_rename after_patch_rename)))
      (if (&& ($present? patch_result) ($present? record))
        (record "turn/patch" {^turn number ^result patch_result}))))
    (if ($absent? response/patch)
      (prepare_and_commit)
      else (with_patch_gate workspace_root prepare_and_commit))
    (if (|| ($absent? patch_result) (== patch_result/status "applied"))
      # Bindings hold live objects, so copy the map without copying its values.
      (let values {})
      (map_for [name value] in bindings
        (values .put name value))
      (values .put "Outcome" (?? outcome_binding Outcome))
      (if ($absent? (values .get "workspace")) (values .put "workspace" {^root workspace_root}))
      (values .put
        "append_prompt_at"
        (fn [label line form value]
          (append_prompt_at turn label line form value)))
      (values .put "attachment" (fn [name] (attachment turn name)))
      (values .put "recall" (fn [id] (recall turn id)))
      (let environment
        (env ^bindings values ^policy {^timeout_ms timeout_ms ^max_memory_mb max_memory_mb}))
      (let forms (rewrite_prompt_calls response/forms))
      (if (> forms/.size 0)
        (let last_index (- forms/.size 1))
        (let meta ($node/meta forms/%last_index))
        (set last_line (?? meta/line nil))
        (let expired ($cell false))
        (let execution
          (open_execution_scope
            "response"
            {^timeout_ms timeout_ms ^max_memory_mb max_memory_mb}
            context))
        (let outcome
          (try
            (scope
              # The evaluation task itself is a child of the turn, as well as
              # owning the ordinary children created by response code.
              (let task
                (spawn ^lane root ($runtime/with_context execution/context (fn [] (evaluate_response `(scope %forms...) environment)))))
              (let deadline
                (spawn ^lane root (do ($sleep ($math/max 0 (- execution/deadline_ms ($os/monotonic_ms)))) (expired .set true) task/.cancel)))
              (try
                task/.join
              ensure
                deadline/.cancel
                deadline/.join))
          ensure
            (close_execution_scope execution)))
        (match ^!exhaustive outcome
          when (TaskOutcome/ok value)
            (set validated (validate_value value))
          when (TaskOutcome/error failure)
            (set error ($to_str failure/.message))
            (set error_line (response_error_line failure))
          when (TaskOutcome/fault fault)
            (let message fault/.message)
            (if (== ($head fault) Panic)
              (set error $"panic: ${message}")
            else
              (set error ($to_str message))
              (set error_line (response_error_line fault)))
          when TaskOutcome/cancelled
            (if expired/.get (set error "response budget timed out") else (set cancelled true)))
      else
        (set validated (validate_value (if ($absent? patch_result) nil else patch_result/text)))))
    catch ParticipantFailure (fail $err)
    catch Throwable
      (set error ($to_str $err/.message))
      (set error_line (response_error_line $err))
    ensure (turn/state .set (if cancelled "cancelled" else "closed")))
  (if (&& ($present? response) (> response/forms/.size 0) (== ($head response/forms/0) Sym) (== error $"undefined symbol: ${response/forms/0}"))
    (var line 0)
    (for source_line in ($str/split response/code "\n")
      (set line (+ line 1))
      (let stripped ($str/trim source_line))
      (if (|| (== stripped "") ($str/starts_with? stripped "#")) (continue))
      (set error_line line)
      (break))
    (set error
      ($to_str
        error
        """
Return executable Gene code only. Put any prose preamble in # comments; evaluation stopped at this symbol.""")))
  (if ($present? error)
    (do
      (let hint (response_repair_hint error))
      (if (!= hint "")
        (set error ($to_str error "\n\n[repair]\n" hint)))))
  (let patch_text (if ($absent? patch_result) nil else patch_result/text))
  (let request (if (|| cancelled (&& ($present? validated) (== validated/kind "done"))) ""
    else (render_request turn validated ^patch patch_text ^error error ^error_line error_line ^result_line last_line)))
  (let kind (if cancelled
    "cancelled"
    elif ($absent? error) (if ($absent? validated) "error" else validated/kind)
    else "error"))
  {^kind kind ^validated validated ^request request ^patch patch_result ^error error
   ^media turn/media/.get
   ^console console/.get ^turn turn
   ^request_items (if (&& (== request "") (! coordinated)) [] else (request_items turn validated ^patch patch_text
     ^error error ^error_line error_line ^result_line last_line))})
