(mod models_plugin)
(import [Plugin PluginHost ModelsHost] ^from "../plugin_api")
(import [list_catalog_models] ^from "../public/model_catalog")
(import [contribute_text_doc] ^from "../public/documentation")
(import [model_page] ^from "../public/model_page")
(import [resolve_effort] ^from "../public/models")

(const effort_levels ["auto" "none" "minimal" "low" "medium" "high" "xhigh" "max"])

# Settings choices read the cached catalog; Refresh stays an explicit operation.
(fn model_choice_options [snapshot]
  (let options [])
  (var complete true)
  (for [key entry] in (?? snapshot/providers {})
    (let provider ($to_str key))
    (let ready (== entry/connection/state "ready"))
    (if (|| (! ready) (== entry/stale true)) (set complete false))
    (for model in (?? entry/models [])
      (if (!= model/hidden true)
        (options .push {^value model/id ^label (?? model/label model/id) ^provider provider ^model model/id
          ^available ready ^reason (if ready nil (?? entry/connection/reason "Not connected."))}))))
  {^options options ^complete complete
   ^reason (if complete nil "Some connections are still being checked or are not ready. A model id that is not listed can still be typed; it is saved unverified.")})

(fn catalog_model [snapshot, provider : Str, id : Str]
  (let entry (?? snapshot/providers/%provider {}))
  (for model in (?? entry/models [])
    (if (== model/id id) (return model)))
  nil)

# Requested efforts are the portable levels plus native levels the model advertises;
# each shows what it becomes for the model. Without catalog metadata for the model
# the list is incomplete, so a native level is left to the round's own check.
(fn effort_choice_options [snapshot, values]
  (let provider ($to_str (?? values/provider "")))
  (let id ($to_str (?? values/model "")))
  (let listed (catalog_model snapshot provider id))
  (let model (?? listed {^id id}))
  (let levels ($thaw ($freeze effort_levels)))
  (for level in (?? model/efforts [])
    (if_not (levels .contains? level) (levels .push level)))
  (let options [])
  (for level in levels
    (let resolved (try {^effort (resolve_effort level model)} catch Any {^error ($to_str (?? $err/message $err))}))
    (let effective (?? resolved/effort "provider default"))
    (options .push
      {^value level ^available ($absent? resolved/error) ^reason (?? resolved/error nil)
       ^label (if ($present? resolved/error) $"${level} (not available for this model)"
         (if (== level effective) level $"${level} → ${effective}"))}))
  {^options options ^complete ($present? listed)
   ^reason (if ($present? listed) nil "This model has no catalog metadata, so only the portable levels are listed.")})

# Workspace effort is judged against the model the candidate values select, which
# the host resolves with resets, drafts and provider defaults applied. A shared
# default names its provider and model directly.
(fn effort_values [context]
  (if (== context/scope "workspace") (return (?? context/selection {})))
  (?? context/values {}))

(fn providers_section [snapshot]
  (let rows [])
  (for [key entry] in (?? snapshot/providers {})
    (let name ($to_str key))
    (let connection (?? entry/connection {}))
    (let count ($size (?? entry/models [])))
    (rows .push
      `(tr ^key %$"provider/${name}"
         (td (strong %(?? connection/label name)) (br) (small ^class_name "web_muted" %name))
         (td %(?? connection/state "unknown"))
         (td %(?? connection/reason ""))
         (td %$"${count} models"))))
  `(section ^key "providers-section" ^class_name "web_stack"
     (table ^key "providers-table" ^class_name "web_table_compact"
       (thead (tr (th "Provider") (th "State") (th "Detail") (th "Models")))
       (tbody %rows...))
     (div ^class_name "web_actions"
       (button ^key "providers-refresh" ^action "models_refresh" ^class_name "web_secondary" "Refresh connections")
       (a ^href "/models" ^target "_blank" "Open Providers"))
     (p ^class_name "web_muted"
       "Sign-in, accounts and endpoint configuration are on the Providers page. Refresh checks connections and model lists; it does not send an inference request.")))

(var asset ($cell nil))
(var stylesheet ($cell nil))
(var page_asset ($cell nil))

(fn models [^root root = nil] : Plugin
  (let error (try
    (if ($absent? asset/.get)
      (asset .set ($web/load ($path/join this_pkg/root "client" "plugins" "models_picker.gene"))))
    (if ($absent? page_asset/.get)
      (page_asset .set ($web/load ($path/join this_pkg/root "client" "plugins" "models_page.gene"))))
    (if ($absent? stylesheet/.get)
      (stylesheet .set ($web/stylesheet "models" """
.models-controls { display: inline-flex; align-items: center; flex-wrap: wrap; gap: var(--space-2); max-width: 100%; }
.models-plan { font-size: var(--text-sm); color: var(--muted); }
.models-controls button { max-width: min(var(--model-picker-max-width), var(--model-picker-max-inline)); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.models-controls .models-default { color: var(--muted); }
.models-menu { position: fixed; z-index: var(--layer-menu); inset: var(--model-menu-inset-block) auto auto 50%; transform: translateX(-50%); width: min(var(--model-menu-width), calc(100vw - var(--model-menu-viewport-inset-inline))); max-height: var(--model-menu-max-height); overflow: auto; padding: var(--space-5); border: var(--border-width) solid var(--line); background: var(--surface-raised); color: var(--ink); box-shadow: var(--shadow-raised); }
.models-menu[hidden] { display: none; }
.models-menu input[type=search] { width: 100%; margin-bottom: var(--space-2); }
.models-menu button, .models-menu a { margin: var(--space-1) var(--space-2) var(--space-1) 0; }
.models-menu h4 { margin: var(--space-4) 0 var(--space-2); font-size: var(--text-sm); color: var(--muted); }
.models-menu p { font-size: var(--text-sm); line-height: var(--line-body); }
.models-option { display: block; width: 100%; text-align: left; }
.models-option small { display: block; color: var(--muted); }
.models-custom { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: var(--space-3) 0; }
.models-custom input { flex: 1; min-width: var(--model-custom-input-min-width); }
.models-trigger-controls { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); align-items: center; }
.models-trigger-controls label { display: inline-flex; align-items: center; gap: var(--space-2); }
.models-trigger-controls p { width: 100%; margin: 0 0 var(--space-2); font-size: var(--text-sm); color: var(--muted); }

.models-menu, .voice-panel { border-radius: var(--radius-surface); border-color: var(--edge); }
""")))
    nil catch Any $err/.Error:message))
  (Plugin ^id "models" ^requires ["models/host"]
    ^provides [["seams" "models/catalog"] ["seams" "models/page"] ["functions" "list_models"] ["docs" "harness/models"]
      ["commands" "model"] ["commands" "effort"] ["browser_clients" "models"]
      ["setting_choices" "models"] ["setting_choices" "efforts"] ["settings_groups" "Providers"]
      ["web_components" "model_providers"] ["ui_actions" "models_refresh"]]
    ^activate (fn [host]
      (if ($present? error) (fail error))
      (let catalog (host .PluginHost:resolve "models/host"))
      (catalog .ModelsHost:start root)
      (host .PluginHost:contribute "browser_clients"
        {^name "models" ^title "Models" ^asset asset/.get ^style stylesheet/.get})
      (host .PluginHost:provide "models/page"
        (fn [appearance, workspace : Str, styles : Str] (model_page page_asset/.get appearance workspace styles)))
      (host .PluginHost:provide "models/catalog"
        {^snapshot (fn [] catalog/.ModelsHost:snapshot)
         ^configuration (fn [] catalog/.ModelsHost:configuration)
         ^refresh (fn [] catalog/.ModelsHost:refresh)
         ^connect (fn [provider, account = nil] (catalog .ModelsHost:connect provider account))
         ^accounts (fn [] catalog/.ModelsHost:accounts)
         ^account_action (fn [id action] (catalog .ModelsHost:account_action id action))
         ^login_status (fn [id] (catalog .ModelsHost:login_status id))
         ^cancel_login (fn [id] (catalog .ModelsHost:cancel_login id))
         ^login_callback (fn [params] (catalog .ModelsHost:login_callback params))
         ^save (fn [value expected] (catalog .ModelsHost:save value expected))
         ^set_default (fn [selection expected] (catalog .ModelsHost:set_default selection expected))
         ^preview (fn [session selection] (catalog .ModelsHost:preview session selection))
         ^select (fn [session selection] (catalog .ModelsHost:select session selection))
         ^failed (fn [provider status transport = nil] (catalog .ModelsHost:failed provider status transport))})
      (for definition in
        [{^name "model" ^usage "/model [provider/model | preset | default]" ^doc "Show or set this conversation's model. Default removes its pin."}
         {^name "effort" ^usage "/effort [auto | level]" ^doc "Show or set requested effort; effective effort follows model capabilities."}]
        (let name definition/name)
        (definition .put "raw_input" true)
        (definition .put "tags" ["models" "provider" "effort"])
        (definition .put "docs" ["harness/models"])
        (definition .put "run" (fn [context] (catalog .ModelsHost:command name context)))
        (host .PluginHost:contribute "commands" definition))
      (host .PluginHost:contribute "setting_choices"
        {^name "models" ^!closed ^choices (fn [context] (model_choice_options catalog/.ModelsHost:snapshot))})
      (host .PluginHost:contribute "setting_choices"
        {^name "efforts" ^^closed
         ^choices (fn [context] (effort_choice_options catalog/.ModelsHost:snapshot (effort_values context)))})
      (host .PluginHost:contribute "settings_groups"
        {^name "Providers" ^order 30 ^section "model_providers"
         ^doc "Model connections. Contributing a provider adds choices; it never changes the saved model."})
      (host .PluginHost:contribute "ui_actions"
        {^name "models_refresh" ^doc "Request bounded model discovery for every connection."
         ^fn (fn [] catalog/.ModelsHost:refresh "Refreshing connections.")})
      (host .PluginHost:contribute "web_components"
        {^name "model_providers" ^slot "settings_section" ^actions ["models_refresh"]
         ^render (fn [context] (providers_section catalog/.ModelsHost:snapshot))})
      (host .PluginHost:contribute "functions"
        {^name "list_models" ^doc "List ready models with efforts, context limits and billing. Search with q/provider; use next_offset for another page."
         ^tags ["models" "provider" "effort"] ^docs ["harness/models"]
         ^fn (fn [^provider provider = nil, ^q query : Str = "", ^offset offset : Int = 0, ^limit limit : Int = 50]
           (list_catalog_models ^provider provider ^q query ^offset offset ^limit limit catalog/.ModelsHost:snapshot))})
      (contribute_text_doc host "harness/models" "Model catalog, effort and connection discovery."
        "list_models returns ready, visible provider/model pairs, supported efforts, model defaults, context/output limits and billing metadata. It reads the cached catalog and never calls inference or login tools. Use q for a multiword search, provider to narrow a connection, and next_offset to page. A catalog is not proof of model access. Effort auto uses the model default when known; other portable levels resolve down or to its lowest supported level. Native extras require explicit model support. Shared models.gene supplies defaults and metadata overrides. Credentials are read only by transport operations and never belong in prompts or prepared requests."
        ^tags ["models" "provider" "effort"]))))
