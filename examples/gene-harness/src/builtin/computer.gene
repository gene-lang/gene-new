(mod computer)
(import [Plugin PluginHost ComputerHost] ^from "../plugin_api")
(import [contribute_doc] ^from "../public/documentation")

(fn computer [] : Plugin
  (Plugin ^id "computer" ^requires ["computer/host"]
    ^provides [["commands" "computer"] ["functions" "computer_targets"]
      ["functions" "computer_observe"] ["functions" "computer_act"] ["functions" "computer_receipt"]]
    ^activate (fn [host]
      (let computer (host .PluginHost:resolve "computer/host"))
      computer/.ComputerHost:start
      (host .PluginHost:contribute "commands"
        {^name "computer" ^usage "/computer windows | allow PID WINDOW | browser PID WINDOW | close"
         ^doc "Select computer-use targets for this conversation or release them."
         ^tags ["computer" "browser" "screenshot"] ^docs ["harness/computer"]
         ^run (fn [ctx] (computer .ComputerHost:command ctx))})
      (for definition in
        [{^name "computer_targets" ^doc "List computer windows granted by the operator to this conversation."
          ^fn (fn [] computer/.ComputerHost:targets)}
         {^name "computer_observe" ^doc "Observe one granted target; append its UI state and screenshot for the next model turn."
          ^fn (fn [target : Str, ^query query : Str = ""] (computer .ComputerHost:observe target ^query query))}
         {^name "computer_receipt" ^doc "Read a durable action outcome by request ID without dispatch, including after restart."
          ^fn (fn [request : Str] (computer .ComputerHost:receipt request))}
         {^name "computer_act" ^doc "Dispatch a scoped action once, using a fresh observation and stable request ID. Observe again to verify."
          ^fn (fn [target : Str, observation : Str, name : Str, params, request : Str]
            (computer .ComputerHost:act target observation name params request))}]
        (definition .put "tags" ["computer" "browser" "screenshot"])
        (definition .put "docs" ["harness/computer"])
        (host .PluginHost:contribute "functions" definition))
      (contribute_doc host "harness/computer" "Computer-use workflow, target grants, screenshots and action recovery."
        "examples/gene-harness/docs/computer.md" ^tags ["computer" "browser" "screenshot" "skill"]))))
