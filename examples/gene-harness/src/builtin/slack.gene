(mod slack_plugin)
(import [Plugin PluginHost ChannelHost] ^from "../plugin_api")
(import [contribute_doc] ^from "../public/documentation")

(fn slack [] : Plugin
  (Plugin ^id "slack" ^requires ["channels/host"]
    ^activate (fn [host]
      (let channels (host .PluginHost:resolve "channels/host"))
      channels/.ChannelHost:start
      (contribute_doc host "harness/channels"
        "Slack accounts, thread sessions, operator trust and queue controls."
        "examples/gene-harness/docs/channels.md" ^tags ["slack" "channels" "sessions"]))))
