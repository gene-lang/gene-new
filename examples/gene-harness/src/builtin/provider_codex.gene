(mod provider_codex)
(import ^from "../plugin_api" [Plugin PluginHost])
(import ^from "./documentation" [contribute_text_doc])
(import ^from "../kernel" [HarnessError])
(import ^from "./provider_common" [nonempty configure_model http_json_attempt])

(fn auth_file []
  (let explicit (nonempty ($os/env? "CODEX_AUTH_FILE")))
  (if_not ($absent? explicit) (return explicit))
  (let user_home (nonempty ($os/env? "HOME")))
  (let home (?? (nonempty ($os/env? "CODEX_HOME"))
                  (if_not ($absent? user_home) $"${user_home}/.codex")))
  (if ($absent? home) nil $"${home}/auth.json"))

(fn codex_credentials [path]
  (if ($absent? path)
    (fail (HarnessError ^message
      "cannot locate Codex auth.json; set CODEX_AUTH_FILE, CODEX_HOME, or HOME")))
  # Parser excerpts may contain tokens, so credential errors stay generic.
  (let auth
    (try ($json/parse ($fs/read_text path))
      catch Any
        (fail (HarnessError ^message
          $"cannot read Codex auth.json at ${path}; run codex login with file credential storage"))))
  (if_not (== ($head auth) Map)
    (fail (HarnessError ^message "Codex auth.json must contain an object")))
  (let tokens auth/tokens)
  (if_not (== ($head tokens) Map)
    (fail (HarnessError ^message
      "Codex auth.json has no OAuth tokens; sign in with ChatGPT using codex login")))
  (let access tokens/access_token)
  (let account tokens/account_id)
  (if_not (&& (== ($head access) Str) (== ($head account) Str)
              (! ($absent? (nonempty access)))
              (! ($absent? (nonempty account))))
    (fail (HarnessError ^message
      "Codex auth.json requires tokens.access_token and tokens.account_id; run codex login")))
  {^access_token access ^account_id account})

(fn response_text [response] : Str
  (if_not (== response/status "completed")
    (fail (HarnessError ^message "codex response did not complete")))
  (let texts [])
  (var phased false)
  (for item in (?? response/output [])
    (if (&& (== item/type "message") (! ($absent? item/phase)))
      (set phased true)))
  (for item in (?? response/output [])
    (if_yes (&& (== item/type "message") (== item/role "assistant"))
      (if (&& phased (!= item/phase "final_answer")) (continue))
      (for part in (?? item/content [])
        (if (== part/type "refusal")
          (fail (HarnessError ^message "codex refused the request")))
        (if (== part/type "output_text") (texts .push part/text)))))
  (let text ($str/join texts ""))
  (if (== ($str/trim text) "")
    (fail (HarnessError ^message "codex returned no output text")))
  text)

(fn codex_event [data : Str, items]
  (if (|| (== data "") (== data "[DONE]")) (return nil))
  (let event
    (try ($json/parse data)
      catch Any
        (fail (HarnessError ^message "codex returned an invalid stream event"))))
  (if (|| (== event/type "error") (== event/type "response.failed")
          (== event/type "response.incomplete"))
    (fail (HarnessError ^message $"codex stream failed (${event/type})")))
  (if (== event/type "response.output_item.done") (items .push event/item))
  (if (|| (== event/type "response.completed") (== event/type "response.done"))
    (then
      (let response event/response)
      (let output (?? response/output []))
      {^text (response_text {^status response/status
        ^output (if (== output/.size 0) items output)})
       ^usage response/usage})
    (else nil)))

(fn codex_stream_result [body : Str]
  (var data [])
  (let items [])
  (var completed nil)
  (for raw_line in ($str/split body "\n")
    (let line ($str/trim raw_line))
    (if (== line "")
      (then
        (let text (codex_event ($str/join data "\n") items))
        (if_not ($absent? text) (set completed text))
        (set data []))
      (elif ($str/starts_with? line "data:")
        (data .push ($str/trim
          ($str/slice_bytes line 5 ($str/byte_size line)))))))
  (let last_text (codex_event ($str/join data "\n") items))
  (if_not ($absent? last_text) (set completed last_text))
  (if ($absent? completed)
    (fail (HarnessError ^message
      "codex stream ended before response.completed")))
  completed)

(fn codex_stream_text [body : Str] : Str
  (let result (codex_stream_result body))
  result/text)

(fn provider_codex [] : Plugin
  (Plugin ^id "provider_codex" ^provides [["providers" "codex"]]
    ^activate (fn [host]
      (host .PluginHost:contribute "providers"
        {^name "codex" ^tags ["provider" "model" "codex"] ^docs ["harness/providers/codex"] ^doc "Use the Codex Responses endpoint." ^auto 2
         ^available (fn []
           (let path (auth_file))
           (if (&& (! ($absent? path)) ($fs/exists? path))
             nil
             "Codex auth.json is unavailable; run codex login"))
         ^configure (fn [model, effort, timeout]
           (configure_model model effort timeout "gpt-6-sol"))
         ^prepare (fn [call]
           (let messages call/messages)
           (let settings call/settings)
           (let conversation
             (messages .filter (fn [message] (!= message/role "system"))))
           {^body
             {^model settings/model ^instructions messages/0/content
              ^input (conversation .map (fn [message]
                {^role message/role
                 ^content [{^type (if (== message/role "assistant")
                                     "output_text" "input_text")
                            ^text message/content}]}))
              ^reasoning {^effort settings/effort}
              ^!store ^^stream}
            ^timeout_ms settings/timeout_ms})
         ^send (fn [prepared]
           (let credentials (codex_credentials (auth_file)))
           (let headers
             {^content-type "application/json" ^accept "text/event-stream"
              ^authorization $"Bearer ${credentials/access_token}"
              ^chatgpt-account-id credentials/account_id
              ^OpenAI-Beta "responses=experimental"
              ^originator "gene-harness"})
           (http_json_attempt
             "https://chatgpt.com/backend-api/codex/responses"
             headers prepared/body prepared/timeout_ms
             (fn [response]
               (if_not (== response/status 200)
                 (if (== response/status 401)
                   (fail (HarnessError ^message
                     "codex 401: OAuth credentials expired or were rejected; run codex login to refresh auth.json"))
                   (fail (HarnessError ^message
                     $"codex ${response/status}: provider request failed"))))
               (codex_stream_result response/body))))})
      (contribute_text_doc host "harness/providers/codex"
        "Codex Responses transport, preparation and credential boundary."
        "The codex provider prepares system instructions plus role-preserving conversation input, then sends one Responses streaming attempt. Provider preparation contains no authentication; send reads the existing Codex login file. Model, reasoning effort and timeout come from Harness settings. Refresh a rejected login through codex login as an operator; never copy credentials into prompts or documentation."
        ^tags ["provider" "model" "codex"]))))
