(mod notifications)
(import [Plugin PluginHost NotificationHost] ^from "../plugin_api")

(fn notifications [] : Plugin
  (Plugin ^id "notifications" ^requires ["notifications/host"]
    ^provides [["functions" "notification_post"] ["functions" "notification_update"]
               ["functions" "notification_list"] ["functions" "notification_detail"]
               ["functions" "notification_clear"]]
    ^activate (fn [host]
      (let inbox (host .PluginHost:resolve "notifications/host"))
      (for definition in
        [{^name "notification_post"
          ^doc "Publish a stored operator message; inspect ok before reporting success."
          ^fn (fn [message] (inbox .NotificationHost:post message))}
         {^name "notification_update" ^doc "Update an operator-owned keyed message."
          ^fn (fn [id : Str, changes] (inbox .NotificationHost:update id changes))}
         {^name "notification_list" ^doc "List recent messages and the opened watermark."
          ^fn (fn [] inbox/.NotificationHost:list)}
         {^name "notification_detail" ^doc "Read a retained notification and its original evidence references."
          ^fn (fn [id : Str] (inbox .NotificationHost:detail id))}
         {^name "notification_clear" ^doc "Clear only the observed message revision; never answers a question."
          ^fn (fn [id : Str, revision : Int] (inbox .NotificationHost:clear id revision))}]
        (definition .put "tags" ["notifications" "messages" "attention"])
        (definition .put "docs" ["harness/notifications" "harness/notifications/publishing"])
        (host .PluginHost:contribute "functions" definition))
      (for chapter in
        [["harness/notifications" "Notices, pending workflows and the producer inbox."
          "notifications.md" ["notifications" "messages" "questions"]]
         ["harness/notifications/publishing" "Source-scoped plugin publishing, receipts and declared actions."
          "notification-publishing.md" ["notifications" "plugins" "actions"]]]
        (host .PluginHost:contribute "docs"
          {^name chapter/0 ^summary chapter/1 ^tags chapter/3
           ^path ($path/join this_pkg/root "docs" "recipes" chapter/2)})))))
