# Slack's side of channel delivery: one part's external effect and the
# read-only recovery scan. The host owns receipts, part claims, ordering and
# pacing; these functions only call Slack and classify the result.
(mod slack_delivery)
(import [api_call SlackError] ^from "./api")

(fn digest [value] ($crypto/sha256 ($serde/write_data value)))

(const uncertain_codes ["transport_unknown" "server_unknown" "invalid_response" "internal_error"
  "fatal_error" "request_timeout" "service_unavailable"])

# {^account ^intent ^delivery ^revision ^index ^part ^ts ^thread}: ts updates
# an earlier post; thread replies in a thread (nil starts a new root).
(fn send_part [api, request]
  (let intent request/intent)
  (let rendered request/part)
  (let data {^channel intent/channel ^text rendered/text ^parse "none"
    ^metadata {^event_type "gene_harness_delivery"
      ^event_payload {^delivery request/delivery ^part request/index ^revision request/revision
        ^body_digest (digest rendered)}}})
  (if_not ($absent? rendered/blocks) (data .put "blocks" rendered/blocks))
  (let update ($present? request/ts))
  (if update (then (data .put "ts" request/ts))
    (else
      (data .put "unfurl_links" false) (data .put "unfurl_media" false)
      (if_not ($absent? request/thread) (data .put "thread_ts" request/thread))))
  (try
    (let response (api_call api (if update "chat.update" "chat.postMessage") data))
    # An unrecognizable timestamp cannot be linked or updated later.
    (if (|| (!= ($head response/ts) Str) ($absent? (#"^[0-9]{1,20}\.[0-9]{1,9}$" .match response/ts)))
      (return {^status "uncertain" ^error "invalid_response"}))
    {^status "sent" ^ts response/ts}
  catch SlackError
    (if (== $err/code "rate_limited")
      (then {^status "pending" ^error "rate_limited" ^retry_at (+ ($os/wall_ms) (?? $err/retry_after_ms 1000))})
      (elif (uncertain_codes .contains? $err/code) {^status "uncertain" ^error $err/code})
      (else {^status "failed" ^error $err/code}))
  catch Error {^status "uncertain" ^error "unconfirmed_response"}))

# Removing a known status message is idempotent, unlike posting one.
(fn remove_part [api, request]
  (let part request/part)
  (try
    (api_call api "chat.delete" {^channel request/intent/channel ^ts part/ts})
    {^status "sent" ^ts part/ts}
  catch SlackError
    (if (== $err/code "message_not_found")
      (then {^status "sent" ^ts part/ts})
      (elif (|| (== $err/code "rate_limited") (uncertain_codes .contains? $err/code))
        {^status "pending" ^error $err/code ^retry_at (+ ($os/wall_ms) (?? $err/retry_after_ms 1000))})
      (else {^status "failed" ^error $err/code}))
  catch Error {^status "pending" ^error "unconfirmed_removal" ^retry_at (+ ($os/wall_ms) 1000)}))

# One bounded history page. A part counts as delivered only when exactly one
# bot message carries its delivery, part, revision and body digest. Rate
# limits propagate (code rate_limited, retry_after_ms) for the host's backoff.
(fn reconcile_parts [api, request]
  (let original request/delivery)
  (let account request/account)
  (let new_root request/new_root)
  (let thread (if (== original/intent/mode "thread") original/parts/0/ts original/intent/thread))
  (let query {^channel original/intent/channel ^include_all_metadata true ^limit 100})
  (if_not new_root (query .put "ts" thread))
  (if_not ($absent? original/reconcile_cursor) (query .put "cursor" original/reconcile_cursor))
  (let response (api_call api (if new_root "conversations.history" "conversations.replies") query ^http_method "GET"))
  (let found [])
  (for part in original/parts
    (if (!= part/status "uncertain") (continue))
    (let index part/index)
    (let matches [])
    (for message in (?? response/messages [])
      (let metadata message/metadata)
      (let external metadata/event_payload)
      (if (&& (== message/user account/bot_user) (== metadata/event_type "gene_harness_delivery")
               (== external/delivery original/intent/id) (== external/part index)
               (== external/revision original/intent/revision)
               (if new_root (== (?? message/thread_ts message/ts) message/ts)
                 (== (?? message/thread_ts message/ts) thread))
               (== external/body_digest (digest original/intent/parts/%index)))
        (matches .push message)))
    (if (== matches/.size 1) (found .push {^index index ^ts matches/0/ts})))
  {^matches found ^cursor response/response_metadata/next_cursor})
