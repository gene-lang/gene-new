(mod slack_users)
(import [read_slack_credentials open_api close_api api_call slack_error] ^from "./api")

(fn ^^private key [parts] ($crypto/sha256 ($serde/write_data parts)))

(type SlackUsers ^props {^cache Cell ^blocked Cell ^gate Any ^requester Any?})

(fn open_users [^requester requester = nil]
  (SlackUsers ^cache ($cell {}) ^blocked ($cell {}) ^gate ($sync/gate) ^requester requester))

(fn profile_name [user] : Str
  (for value in [user/profile/real_name user/real_name user/profile/display_name user/name]
    (if (&& (== ($head value) Str) (!= value/.trim "") (<= value/.byte_size 512))
      (return ($str/join (value/.trim .split "\n") " "))))
  "")

(fn channel_name [channel] : Str
  (let value channel/name)
  (if (&& (== ($head value) Str) (<= value/.byte_size 512)) value/.trim ""))

(fn thread_url [url, channel : Str, thread : Str, ^message message : Str = ""] : Str
  (if (!= ($head url) Str) (return ""))
  (let base (/0 (url .split "?")))
  (let matched (#"^https://[a-z0-9-]+\.slack\.com/archives/([CG][A-Z0-9]+)/p([0-9]+)$" .match base))
  (if (|| ($absent? matched) (!= matched/groups/0 channel)
          (!= matched/groups/1 ($str/join ((if (== message "") thread message) .split ".") ""))) (return ""))
  ($to_str base "?thread_ts=" ($url/encode_component thread) "&cid=" channel))

# Display metadata only. Lookups run separately from transcript snapshots and
# socket intake, and never change the IDs used by authorization or admission.
# The host has validated the account and identifiers and chosen the thread's
# target message; data is {^team ^channel ^author ^thread ^message}.
(fn lookup_name [users, account, kind : Str, data]
  (let subject (if (!= kind "user") data/channel data/author))
  (let thread (if (== kind "thread") data/thread ""))
  (let target (if (== kind "thread") data/message ""))
  (let empty (if (== kind "thread") {^url ""} {^name ""}))
  (users/gate (fn []
    (let id (key [kind account/id account/team subject thread target]))
    (let now ($os/monotonic_ms))
    (let cached (users/cache/.get .get id))
    (if (> (?? cached/until 0) now) (return cached/value))
    (let group (key [kind account/app account/team]))
    (if (> (?? (users/blocked/.get .get group) 0) now)
      (return empty))
    (var value empty)
    (var ttl 3600000)
    (try
      (let credentials (read_slack_credentials account/config/secret_file))
      (let api (open_api credentials/bot ^requester users/requester))
      (try
        (if (== kind "thread")
          (then
            (let response (api_call api "chat.getPermalink" {^channel subject ^message_ts target} ^http_method "GET"))
            (set value {^url (thread_url response/permalink subject thread ^message target)}))
          (else
            (let response (api_call api (if (== kind "channel") "conversations.info" "users.info")
              (if (== kind "channel") {^channel subject} {^user subject}) ^http_method "GET"))
            (let info (if (== kind "channel") response/channel response/user))
            (if (!= info/id subject) (slack_error "invalid_response" "Slack returned a different identity."))
            (set value {^name (if (== kind "channel") (channel_name info) (profile_name info))})))
      ensure (close_api api))
    catch Error
      (set ttl 60000)
      (if (["missing_scope" "invalid_auth" "not_authed" "credentials_unavailable"] .contains? $err/code)
        (set ttl 300000))
      (if (== $err/code "rate_limited") (set ttl ($math/max 1000 (?? $err/retry_after_ms 60000))))
      (if (["rate_limited" "missing_scope" "invalid_auth" "not_authed" "credentials_unavailable"] .contains? $err/code)
        (users/blocked/.get .put group (+ ($os/monotonic_ms) ttl))))
    (if (>= ($map_size users/cache/.get) 1024) (users/cache .set {}))
    (if (>= ($map_size users/blocked/.get) 1024) (users/blocked .set {}))
    (users/cache/.get .put id {^until (+ ($os/monotonic_ms) ttl) ^value value})
    value)))
