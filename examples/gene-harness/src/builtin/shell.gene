(mod shell)
(import [Plugin PluginHost OperatorHost] ^from "../plugin_api")
(import [contribute_doc] ^from "../public/documentation")

(fn shell [] : Plugin
  (Plugin ^id "shell" ^requires ["operator/host"] ^provides [["commands" "sh"] ["input_modes" "sh"]]
    ^activate (fn [host]
      (let operator (host .PluginHost:resolve "operator/host"))
      (operator .OperatorHost:retain_mode "sh")
      (host .PluginHost:contribute "commands"
        {^name "sh" ^usage "/sh [shell command]"
         ^doc "Run a shell command, or open shell mode until exit or quit."
         ^tags ["commands" "shell" "processes"] ^docs ["harness/shell"]
         ^^raw_input ^run (fn [ctx] (operator .OperatorHost:command "sh" ctx))})
      (host .PluginHost:contribute "input_modes"
        {^name "sh" ^label "Shell" ^hint "Shell · exit or quit to leave"
         ^submit_label "Run" ^prompt "shell command" ^^reset_on_interrupt
         ^tags ["commands" "shell" "processes"] ^docs ["harness/shell"]
         ^classify (fn [text : Str] (operator .OperatorHost:classify "sh" text))
         ^run (fn [ctx] (operator .OperatorHost:input "sh" ctx))
         ^close (fn [session reason] (operator .OperatorHost:close "sh" session))})
      (contribute_doc host "harness/shell"
        "One-shot shell commands, persistent shell mode and process cleanup."
        "examples/gene-harness/docs/shell.md" ^tags ["commands" "shell" "processes"]))))
