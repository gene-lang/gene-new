(mod ui_experiment)
(import [Plugin PluginHost] ^from "../plugin_api")
(import [validate_ui_settings] ^from "../ui/state")
(import [ui_preview] ^from "../ui/views")
(import [contribute_doc] ^from "./documentation")

(fn ui_experiment [] : Plugin
  (Plugin ^id "ui_experiment" ^requires ["loop"]
    ^provides [["functions" "ui_configure"] ["functions" "ui_preview"]]
    ^activate (fn [host]
      (let loop_factory (host .PluginHost:resolve "loop"))
      (let runtime (/runtime (loop_factory)))
      (host .PluginHost:contribute "functions"
        {^name "ui_configure" ^doc "Enable, select or theme the experimental workspace panel."
         ^tags ["ui" "layout" "theme" "panel"] ^docs ["harness/ui/configuration"]
         ^fn (fn [settings]
           (let checked (validate_ui_settings settings))
           (host .PluginHost:update_state checked)
           checked)})
      (host .PluginHost:contribute "functions"
        {^name "ui_preview" ^doc "Validate a panel tree using supplied browser view state."
         ^tags ["ui" "preview" "verify"] ^docs ["harness/ui/publication"]
         ^fn (fn [name : Str, state = {}] (ui_preview runtime/h name state))})
      (contribute_doc host "harness/ui/configuration"
        "Enable a panel; layout, width, theme tokens and default-UI recovery."
        "examples/gene-harness/docs/recipes/ui-configuration.md"
        ^tags ["ui" "layout" "theme" "panel" "recovery"] ^docs ["harness/ui"]))))
