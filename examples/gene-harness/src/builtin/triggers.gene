(mod triggers)
(import ^from "../plugin_api" [Plugin PluginHost])
(import ^from "../runtime/triggers"
  [open_trigger_manager close_trigger_manager create_trigger list_triggers delete_trigger])

(const trigger_paragraph "Use (create_trigger {^id \"audit\" ^kind \"heartbeat\" ^every_ms 60000 ^request \"Audit.\"}) to schedule workspace work. Kinds: heartbeat (every_ms), scheduled (at, UTC timestamp), cron (cron, timezone). Policies: missed skip/once, overlap skip/queue_one, continue_session boolean, retention keep/days. (list_triggers) lists definitions; (delete_trigger \"audit\") disables future starts.")

(fn triggers [] : Plugin
  (let activations [])
  (Plugin ^id "triggers" ^requires ["loop"]
    ^provides [["functions" "create_trigger"] ["functions" "list_triggers"]
               ["functions" "delete_trigger"]]
    ^activate (fn [host]
      (let loop_factory (host .PluginHost:resolve "loop"))
      (let loop (loop_factory))
      (let manager
        (open_trigger_manager ^start (?? loop/start true) ^boot (?? loop/boot true)
          loop/runtime loop/controller))
      (activations .push {^host host ^manager manager ^runtime loop/runtime})
      (host .PluginHost:contribute "functions"
        {^name "create_trigger" ^doc "Schedule workspace work."
         ^fn (fn [definition] (create_trigger manager definition))})
      (host .PluginHost:contribute "functions"
        {^name "list_triggers" ^doc "List trigger definitions."
         ^fn (fn [] (list_triggers manager))})
      (host .PluginHost:contribute "functions"
        {^name "delete_trigger" ^doc "Disable a trigger by id."
         ^fn (fn [id : Str] (delete_trigger manager id))})
      (host .PluginHost:contribute "prompt"
        {^name "triggers" ^text trigger_paragraph}))
    ^deactivate (fn [host]
      (for active in activations
        (if (same? active/host host)
          (then
            (close_trigger_manager active/manager)
            (if (same? active/runtime/triggers active/manager)
              (set active/runtime/triggers nil))))))))
