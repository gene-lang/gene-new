(mod repl)
(import [Plugin PluginHost OperatorHost] ^from "../plugin_api")
(import [contribute_doc] ^from "../public/documentation")

(fn repl [] : Plugin
  (Plugin ^id "repl" ^requires ["operator/host"] ^provides [["commands" "repl"] ["input_modes" "repl"]]
    ^activate (fn [host]
      (let operator (host .PluginHost:resolve "operator/host"))
      (operator .OperatorHost:retain_mode "repl")
      (host .PluginHost:contribute "commands"
        {^name "repl" ^usage "/repl" ^doc "Open a persistent Gene REPL for this session."
         ^tags ["repl" "Gene" "evaluate"] ^docs ["harness/repl"]
         ^^raw_input ^run (fn [ctx] (operator .OperatorHost:command "repl" ctx))})
      (host .PluginHost:contribute "input_modes"
        {^name "repl" ^label "REPL" ^hint "REPL · exit or quit to leave"
         ^tags ["repl" "Gene" "evaluate"] ^docs ["harness/repl"]
         ^submit_label "Eval" ^prompt "gene"
         ^classify (fn [text : Str] (operator .OperatorHost:classify "repl" text))
         ^run (fn [ctx] (operator .OperatorHost:input "repl" ctx))
         ^close (fn [session reason] (operator .OperatorHost:close "repl" session))})
      (contribute_doc host "harness/repl"
        "Persistent Gene evaluation, imports, cwd and live plugin functions."
        "examples/gene-harness/docs/repl.md" ^tags ["repl" "Gene" "evaluate" "imports"]))))
