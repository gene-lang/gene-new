(mod provider_anthropic)
(import ^from "../plugin_api" [Plugin PluginHost])
(import ^from "../public/documentation" [contribute_text_doc])
(import ^from "../plugin_api" [ProviderError])
(import ^from "../public/provider" [nonempty configure_model http_json_attempt])
(import [anthropic_models] ^from "../public/model_defaults")
(import [model_capabilities] ^from "../public/models")
(import [anthropic_model_list] ^from "../public/provider_discovery")
(import [prepare_messages messages_stream_result] ^from "../public/provider_payloads")
(import [anthropic_auth_source anthropic_headers anthropic_connection] ^from "../public/anthropic_auth")

(fn anthropic_text [response] : Str
  (if_not (== response/status 200)
    (let help (match response/status
      (when 401 "check ANTHROPIC_API_KEY")
      (when 429 "rate or usage limit reached; try again later")
      (else "check model access, thinking support, and request limits")))
    (fail (ProviderError ^status response/status ^message $"anthropic ${response/status}: ${help}")))
  (let parsed (try ($json/parse response/body)
    catch Any (fail (ProviderError ^message "anthropic returned invalid JSON"))))
  (if_not (== ($head parsed) Map)
    (fail (ProviderError ^message "anthropic returned an invalid message")))
  (if (|| (!= parsed/type "message") (!= parsed/role "assistant"))
    (fail (ProviderError ^message "anthropic returned an invalid assistant message")))
  (if (== parsed/stop_reason "max_tokens")
    (fail (ProviderError ^message
      "anthropic reached the output token limit; incomplete output was not executed")))
  (if (|| (== parsed/stop_reason "refusal")
          (== parsed/stop_details/type "refusal"))
    (fail (ProviderError ^message "anthropic refused the request")))
  (if_not (== parsed/stop_reason "end_turn")
    (fail (ProviderError ^message
      "anthropic response did not finish its turn; incomplete output was not executed")))
  (if_not (== ($head parsed/content) List)
    (fail (ProviderError ^message "anthropic returned invalid content")))
  (let parts [])
  (for block in parsed/content
    (if_yes (== block/type "text")
      (if_not (== ($head block/text) Str)
        (fail (ProviderError ^message "anthropic returned invalid text content")))
      (parts .push block/text)))
  (let text ($str/join parts ""))
  (if (== ($str/trim text) "")
    (fail (ProviderError ^message "anthropic returned no output text")))
  text)

(fn prepare_anthropic [call]
  (prepare_messages call))

(fn provider_anthropic [] : Plugin
  (Plugin ^id "provider_anthropic" ^provides [["providers" "anthropic"]]
    ^activate (fn [host]
      (host .PluginHost:contribute "providers"
        {^name "anthropic" ^tags ["provider" "model" "anthropic"] ^docs ["harness/providers/anthropic"] ^doc "Use the Anthropic Messages API." ^auto 3
         ^media_recording "inventory"
         ^builtin_models (anthropic_models)
         ^models (fn []
           (let deadline (+ ($os/monotonic_ms) 5000))
           (let headers (anthropic_headers (anthropic_auth_source)))
           (let remaining (- deadline ($os/monotonic_ms)))
           (if (<= remaining 0) (fail (ProviderError ^message "Anthropic discovery timed out")))
           (anthropic_model_list ^headers headers ^timeout_ms remaining nil))
         ^connection anthropic_connection
         ^transport {^adapter "anthropic_messages" ^base_url "https://api.anthropic.com/v1"
           ^credential (/credential (anthropic_auth_source)) ^billing "metered"}
         ^capabilities model_capabilities
         ^configure (fn [model, effort, timeout]
           (configure_model ^catalog (anthropic_models) model effort timeout
             "claude-sonnet-5-5"))
         ^prepare prepare_anthropic
         ^send (fn [prepared]
           (let deadline (+ ($os/monotonic_ms) prepared/timeout_ms))
           (let headers (anthropic_headers ^timeout_ms ($math/min 5000 prepared/timeout_ms) (anthropic_auth_source)))
           (headers .put "content-type" "application/json") (headers .put "accept" "text/event-stream")
           (let remaining (- deadline ($os/monotonic_ms)))
           (if (<= remaining 0) (return {^^timeout}))
           (http_json_attempt ^max_bytes 8388608 "https://api.anthropic.com/v1/messages"
             headers prepared/body remaining
             (fn [response] (messages_stream_result response "anthropic"))))})
      (contribute_text_doc host "harness/providers/anthropic"
        "Anthropic Messages preparation, effort and credential boundary."
        "The anthropic provider separates system instructions from role-preserving conversation messages, prepares an effort-dependent output budget and buffers streamed Messages through completion. ANTHROPIC_API_KEY wins over ant's Console OAuth profile. Otherwise transport operations call ant auth print-credentials --access-token, which refreshes its own login. Console requests are metered. Claude Code's subscription credentials are never read or accepted as API keys. Preparation and discovery never expose credentials."
        ^tags ["provider" "model" "anthropic"]))))
