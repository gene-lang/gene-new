(mod gene_reference)
(import Plugin PluginHost ^from "../plugin_api")
(import contribute_doc ^from "../public/documentation")

(fn gene_reference [] : Plugin
  (Plugin ^id "gene_reference"
    ^provides [["prompt" "gene_reference"] ["docs" "harness/ui/quickstart"]]
    ^activate (fn [host]
      (host .PluginHost:contribute "prompt"
        {^name "gene_reference"
         ^text "Write Gene using documented patterns and verify the working implementation with focused tests. Probe specific blocking uncertainties. The language overview is gene/overview; load book chapters with $docs and the index with $docs/index. A complete tested UI starter is harness/ui/quickstart. Focused chapters are discoverable by topic."})
      (contribute_doc host "gene/overview"
        "The language overview: how the book is organized and how to load it."
        "tools/gene-lang-skill/SKILL.md" ^tags ["language" "Gene" "syntax" "tooling"]
        ^docs ["harness/ui/quickstart"])
      (contribute_doc host "harness/web_components"
        "Complete contract for UI slots, keyed forms, browser state, actions and safe workspace images."
        "examples/gene-harness/docs/web-components.md"
        ^tags ["ui" "web" "components" "reference"]
        ^docs ["harness/ui/quickstart" "harness/ui" "harness/ui/forms" "harness/ui/drafts" "harness/ui/revisions"])
      (contribute_doc host "harness/ui/quickstart"
        "Complete tested persistent counter plugin: actions, keyed form, view, publication and smoke checks. Start UI implementation here."
        "examples/gene-harness/docs/recipes/ui-quickstart.md"
        ^tags ["ui" "web" "quickstart" "starter" "plugin" "forms" "state"]
        ^docs ["harness/ui" "harness/ui/forms" "harness/ui/publication"])
      (contribute_doc host "harness/cards"
        "Inline conversation cards: static cards, question views and live cards with state."
        "examples/gene-harness/docs/cards.md"
        ^tags ["cards" "card" "ui" "questions" "interactive" "conversation"]
        ^docs ["harness/web_components"])
      (contribute_doc host "harness/ui"
        "Start a customized workflow UI: layout, routes and relevant recipes."
        "examples/gene-harness/docs/recipes/ui.md" ^tags ["ui" "web" "workflow" "layout"]
        ^docs ["harness/ui/quickstart" "harness/ui/forms" "harness/ui/drafts" "harness/ui/revisions" "harness/ui/publication"])
      (for entry in
          [["forms" "Build keyed forms, named action arguments and friendly labels."]
           ["drafts" "Retain browser drafts and selection; use true host discard."]
           ["revisions" "Protect durable edits with expected revisions and a shared state lock."]
           ["publication" "Publish and verify UI plugins; distinguish previews from browser acceptance."]]
        (contribute_doc host $"harness/ui/${entry/0}" entry/1
          $"examples/gene-harness/docs/recipes/ui-${entry/0}.md"
          ^tags ["ui" "web" "recipe"] ^docs ["harness/web_components"])))))
