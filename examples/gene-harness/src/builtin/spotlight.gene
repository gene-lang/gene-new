(mod spotlight)
(import [Plugin PluginHost] ^from "../plugin_api")
(import [module_dir] ^from "../kernel")

(var asset ($cell nil))
(var asset_path ($cell ""))
(var stylesheet ($cell nil))
(let style """
.spotlight-launcher { white-space: nowrap; }
.spotlight-backdrop { position: fixed; inset: 0; z-index: 1000; background: #0005; padding: min(14vh, 110px) 16px 24px; overflow: auto; }
.spotlight-backdrop[hidden] { display: none; }
.spotlight-dialog { width: min(640px, 100%); margin: 0 auto; background: var(--surface, #fff); color: var(--ink, #18202b); border: 1px solid var(--line, #ccd2db); border-radius: 14px; box-shadow: 0 16px 60px #0005; overflow: hidden; }
.spotlight-heading { display: flex; align-items: center; padding: 12px 14px; gap: 10px; border-bottom: 1px solid var(--line, #ccd2db); }
.spotlight-heading input { flex: 1; min-width: 0; border: 0; background: transparent; color: inherit; font: inherit; font-size: 21px; padding: 7px 2px; outline-offset: 4px; }
.spotlight-crumb:empty { display: none; }
.spotlight-crumb { font-size: 12px; padding: 12px 16px 0; color: var(--muted, #667085); }
.spotlight-results { max-height: min(516px, calc(100dvh - 280px)); overflow-y: auto; padding: 6px; }
.spotlight-option { display: flex; gap: 16px; align-items: center; padding: 9px 12px; border-radius: 7px; cursor: pointer; min-height: 56px; }
.spotlight-option.active { background: var(--accent, #2463eb); color: var(--surface, #fff); }
.spotlight-option[aria-disabled=true] { opacity: .6; }
.spotlight-copy { flex: 1; min-width: 0; }
.spotlight-copy strong, .spotlight-copy small { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.spotlight-copy strong { font-size: 14px; line-height: 18px; font-weight: 600; }
.spotlight-copy small { font-size: 12px; line-height: 16px; opacity: .72; margin-top: 3px; }
.spotlight-option kbd { font: 12px ui-monospace, monospace; opacity: .8; }
.spotlight-message { padding: 5px 18px 9px; font-size: 12px; color: var(--muted, #667085); }
.spotlight-footer { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 10px 16px; border-top: 1px solid var(--line, #ccd2db); font-size: 11px; color: var(--muted, #667085); }
[data-theme=dark] .spotlight-dialog { background: var(--surface, #20242c); color: var(--ink, #eee); border-color: var(--line, #454b57); }
@media (max-width: 480px) { .spotlight-backdrop { padding: 24px 8px; } .spotlight-footer span { max-width: 220px; } .spotlight-heading input { font-size: 17px; } }
""")

(fn spotlight_from [path : Str] : Plugin
  # Prepare assets before composition staging captures its Application state.
  # Defer a preparation error to activation so this optional plugin can be
  # quarantined without preventing the profile or host from starting.
  (let preparation_error (try
    (if_yes (|| ($absent? asset/.get) (!= asset_path/.get path))
      (asset .set ($web/load path))
      (asset_path .set path))
    (if ($absent? stylesheet/.get)
      (stylesheet .set ($web/stylesheet "spotlight" style)))
    nil
    catch Any $err/.Error:message))
  (let prepared_asset asset/.get)
  (let prepared_style stylesheet/.get)
  (Plugin ^id "spotlight" ^provides [["browser_clients" "spotlight"]]
    ^activate (fn [host]
      (if_not ($absent? preparation_error) (fail preparation_error))
      (host .PluginHost:contribute "browser_clients"
        {^name "spotlight" ^title "Search Harness" ^asset prepared_asset ^style prepared_style}))))

(fn spotlight [] : Plugin
  (spotlight_from $"${(module_dir this_mod/.path)}/../../client/plugins/spotlight.gene"))
