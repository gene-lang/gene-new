(mod spotlight)
(import ^from "../public/web_style" [shell_css])
(import [Plugin PluginHost] ^from "../plugin_api")

(var asset ($cell nil))
(var asset_path ($cell ""))
(var stylesheet ($cell nil))
(let style (shell_css """
.spotlight-launcher { white-space: nowrap; }
.spotlight-backdrop { position: fixed; inset: 0; z-index: var(--layer-dialog); background: var(--scrim); padding: var(--spotlight-inset-block) var(--space-4) var(--space-6); overflow: auto; }
.spotlight-backdrop[hidden] { display: none; }
.spotlight-dialog { width: min(var(--spotlight-width), 100%); margin: 0 auto; background: var(--surface-raised); color: var(--ink); border: var(--border-width) solid var(--edge); box-shadow: var(--shadow-overlay); overflow: hidden; }
.spotlight-heading { display: flex; align-items: center; padding: var(--space-3) var(--space-3); gap: var(--space-2); border-bottom: var(--border-width) solid var(--edge); }
.spotlight-heading input { flex: 1; min-width: 0; border: 0; background: transparent; color: inherit; font: inherit; font-size: var(--text-2xl); padding: var(--space-2) var(--space-1); outline-offset: var(--focus-offset); }
.spotlight-crumb:empty { display: none; }
.spotlight-crumb { font-size: var(--text-xs); padding: var(--space-3) var(--space-4) 0; color: var(--muted); }
.spotlight-results { max-height: min(var(--spotlight-results-max-height), calc(100dvh - var(--spotlight-viewport-inset-block))); overflow-y: auto; padding: var(--space-1); }
.spotlight-option { display: flex; gap: var(--space-4); align-items: center; padding: var(--space-2) var(--space-3); border-radius: var(--radius-row); cursor: pointer; min-height: var(--spotlight-option-min-height); }
.spotlight-option.active .spotlight-copy small, .spotlight-option.active kbd { color: var(--action-ink); }
.spotlight-option.active { background: var(--action); color: var(--action-ink); }
.spotlight-option[aria-disabled=true] { opacity: var(--opacity-disabled); }
.spotlight-copy { flex: 1; min-width: 0; }
.spotlight-copy strong, .spotlight-copy small { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.spotlight-copy strong { font-size: var(--text-md); line-height: var(--line-heading); font-weight: var(--weight-bold); }
.spotlight-copy small { font-size: var(--text-xs); line-height: var(--line-heading); color: var(--muted); margin-top: var(--space-1); }
.spotlight-option kbd { font: var(--type-code); color: var(--muted); }
.spotlight-message { padding: var(--space-1) var(--space-4) var(--space-2); font-size: var(--text-xs); color: var(--muted); }
.spotlight-footer { display: flex; justify-content: space-between; align-items: center; gap: var(--space-2); padding: var(--space-2) var(--space-4); border-top: var(--border-width) solid var(--edge); font-size: var(--text-2xs); color: var(--muted); }

@compact { .spotlight-backdrop { padding: var(--space-6) var(--space-2); } .spotlight-footer span { max-width: var(--spotlight-hint-max-width); } .spotlight-heading input { font-size: var(--text-lg); } }

.spotlight-dialog { border-radius: var(--radius-surface); }
"""))

(fn spotlight_from [path : Str] : Plugin
  # Prepare assets before composition staging captures its Application state.
  # Defer a preparation error to activation so this optional plugin can be
  # quarantined without preventing the profile or host from starting.
  (let preparation_error (try
    (if_yes (|| ($absent? asset/.get) (!= asset_path/.get path))
      (asset .set ($web/load path))
      (asset_path .set path))
    (if ($absent? stylesheet/.get)
      (stylesheet .set ($web/stylesheet "spotlight" style)))
    nil
    catch Any $err/.Error:message))
  (let prepared_asset asset/.get)
  (let prepared_style stylesheet/.get)
  (Plugin ^id "spotlight" ^provides [["browser_clients" "spotlight"]]
    ^activate (fn [host]
      (if_not ($absent? preparation_error) (fail preparation_error))
      (host .PluginHost:contribute "browser_clients"
        {^name "spotlight" ^title "Search Harness" ^asset prepared_asset ^style prepared_style}))))

(fn spotlight [] : Plugin
  (spotlight_from ($path/join this_pkg/root "client" "plugins" "spotlight.gene")))
