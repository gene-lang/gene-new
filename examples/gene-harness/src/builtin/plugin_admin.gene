(mod plugin_admin)
(import ^from "../plugin_api" [Plugin PluginHost])
(import ^from "../runtime/composition" [current_snapshot])
(import ^from "../storage/workspace"
  [register_plugin set_plugin_enabled restore_plugin])
(import ^from "./documentation" [contribute_doc])

(fn plugin_admin [] : Plugin
  (Plugin ^id "plugin_admin"
    ^provides [["functions" "register_plugin"] ["docs" "harness/plugins"]]
    ^activate (fn [host]
      (let h host/h)
      (host .PluginHost:contribute "functions"
        {^name "register_plugin" ^doc "Queue a workspace plugin for publication."
         ^tags ["plugins" "publish" "register" "replace"] ^docs ["harness/plugins"]
         ^fn (fn [id : Str source, ^dependencies dependencies = [],
                  ^replace replace : Bool = false]
           (register_plugin ^dependencies dependencies ^replace replace
             h/workspace h id source))})
      (host .PluginHost:contribute "functions"
        {^name "plugin_states" ^doc "List plugins from the leased composition."
         ^tags ["plugins" "inspect"] ^docs ["harness/plugins"]
         ^fn (fn []
           (let snapshot (current_snapshot h/snapshots))
           {^plugins (?? snapshot/plugins [])
            ^readiness (if ($absent? h/readiness) nil (h/readiness))})})
      (host .PluginHost:contribute "functions"
        {^name "inspect_plugin" ^doc "Inspect one plugin in the leased composition."
         ^tags ["plugins" "inspect"] ^docs ["harness/plugins"]
         ^fn (fn [id : Str]
           (let snapshot (current_snapshot h/snapshots))
           (for plugin in (?? snapshot/plugins [])
             (if (== plugin/id id) (return plugin)))
           nil)})
      (host .PluginHost:contribute "functions"
        {^name "enable_plugin" ^doc "Enable a stored or built-in plugin."
         ^tags ["plugins" "enable"] ^docs ["harness/plugins"]
         ^fn (fn [id : Str] (set_plugin_enabled h/workspace h id true))})
      (host .PluginHost:contribute "functions"
        {^name "disable_plugin" ^doc "Disable a stored or built-in plugin."
         ^tags ["plugins" "disable"] ^docs ["harness/plugins"]
         ^fn (fn [id : Str] (set_plugin_enabled h/workspace h id false))})
      (host .PluginHost:contribute "functions"
        {^name "restore_plugin" ^doc "Restore a built-in plugin to its profile default."
         ^tags ["plugins" "restore"] ^docs ["harness/plugins"]
         ^fn (fn [id : Str] (restore_plugin h/workspace h id))})
      (contribute_doc host "harness/plugins"
        "Author self-describing plugins; publication, restricted imports, inert declarations and lifecycle."
        "examples/gene-harness/docs/plugins.md" ^tags ["plugins" "register" "publish" "discovery"]))))
