# Optional voice policy and browser contribution. Host admission owns durable work.
(mod voice_plugin)
(import [Plugin PluginHost VoiceHost SessionHost] ^from "../plugin_api")
(import [contribute_text_doc] ^from "../public/documentation")
(import [whisper_row piper_row elevenlabs_row mac_synthesizer_row] ^from "../public/speech_engines")
(import [mac_recognizer_row] ^from "../public/mac_recognition")

(var asset ($cell nil))
(var stylesheet ($cell nil))

(fn voice_advisory [voice, sessions, context]
  (let round (sessions .SessionHost:round context/session))
  (let spoken (&& (== round/id context/round) (== round/input/kind "voice")))
  (let output (voice .VoiceHost:output context/session))
  (if (! (|| spoken output)) (return context))
  (let items [])
  (for item in context/items (items .push item))
  (let guidance ($to_str
    (if spoken "The prompt came from speech recognition and may contain recognition errors; read it charitably. " "")
    (if output "Replies are read aloud. If the final reply contains code, tables, lists, links, paths or other formatting, add ^audio_reply: one to three plain spoken sentences. " "")
    "Detailed guidance is in harness/voice."))
  (items .push {^id $"${context/turn}.voice" ^header "[harness_voice]" ^value guidance ^!settled})
  (context .assoc "items" items))

# No current engine can enumerate its voices, so the source reports that and the
# voice id stays a typed value in the voice map.
(fn voice_choices [synthesizers, values]
  (let configured (?? values/voice {}))
  (let selected (if (== ($head configured) Map) (?? configured/synthesizer "") ""))
  (let named (if (== selected "") "The configured synthesizer" $"The ${selected} synthesizer"))
  {^options [] ^complete false
   ^reason $"${named} does not list its voices. Type a voice id in the voice map, such as ^voice for an ElevenLabs voice ID."})

(fn engine_rows [host, rows, kind : Str, label : Str]
  (for engine in (host .PluginHost:rows kind)
    (let reason (try (engine/available) catch Any "The availability check failed."))
    (rows .push
      `(tr ^key %$"${kind}/${engine/name}"
         (td (strong %engine/name) (br) (small ^class_name "web_muted" %(?? engine/summary "")))
         (td %label)
         (td %(if ($absent? reason) "Available" reason)))))
  rows)

(fn voice_section [host]
  (let rows [])
  (engine_rows host rows "speech_recognizers" "Recognizer")
  (engine_rows host rows "speech_synthesizers" "Synthesizer")
  `(section ^key "voice-section" ^class_name "web_stack"
     (table ^key "voice-engines" ^class_name "web_table_compact"
       (thead (tr (th "Engine") (th "Kind") (th "Availability")))
       (tbody %rows...))
     (p ^class_name "web_muted"
       "Choose engines with the voice map above: ^recognizer, ^synthesizer, ^voice, ^language and ^rate. Engines read credentials from the host environment.")))

(fn voice [] : Plugin
  (let error (try
    (if ($absent? asset/.get)
      (asset .set ($web/load ($path/join this_pkg/root "client" "plugins" "voice.gene"))))
    (if ($absent? stylesheet/.get)
      (stylesheet .set ($web/stylesheet "voice" """
.voice-panel { position: fixed; right: var(--size-1); top: var(--size-4); max-height: max(var(--size-12), calc(100dvh - var(--size-16))); overflow: auto; z-index: var(--layer-menu); width: min(var(--size-26), calc(100vw - var(--size-2))); padding: var(--space-4); border: var(--border-width) solid var(--line); background: var(--surface-raised); color: var(--ink); box-shadow: var(--shadow-overlay); }
.voice-panel[hidden] { display: none; }
.voice-panel textarea { display: block; width: 100%; min-height: var(--size-5); margin: var(--space-2) 0; }
.voice-panel button { margin: var(--space-1) var(--space-1) var(--space-1) 0; }
.voice-panel label { display: block; margin: var(--space-2) 0; }
.voice-panel p { margin: var(--space-2) 0; font-size: var(--text-sm); line-height: var(--line-body); }

.models-menu, .voice-panel { border-radius: var(--radius-surface); border-color: var(--edge); }
""")))
    nil
    catch Any $err/.Error:message))
  (Plugin ^id "voice" ^requires ["voice/host" "sessions/host"]
    ^provides [["browser_clients" "voice"] ["hooks" "request/prepare/voice"]
      ["speech_recognizers" "whisper_local"] ["speech_recognizers" "macos"] ["speech_synthesizers" "piper"]
      ["speech_synthesizers" "elevenlabs"] ["speech_synthesizers" "macos"]
      ["setting_choices" "voices"] ["settings_groups" "Voice"] ["web_components" "voice_engines"]]
    ^activate (fn [host]
      (if_not ($absent? error) (fail error))
      (let service (host .PluginHost:resolve "voice/host"))
      (let sessions (host .PluginHost:resolve "sessions/host"))
      (host .PluginHost:defer (fn [] service/.VoiceHost:reset_if_unused))
      (host .PluginHost:contribute "speech_recognizers" (whisper_row))
      (host .PluginHost:contribute "speech_recognizers" (mac_recognizer_row))
      (host .PluginHost:contribute "speech_synthesizers" (piper_row))
      (host .PluginHost:contribute "speech_synthesizers" (elevenlabs_row))
      (host .PluginHost:contribute "speech_synthesizers" (mac_synthesizer_row))
      (host .PluginHost:contribute "browser_clients"
        {^name "voice" ^title "Voice" ^asset asset/.get ^style stylesheet/.get})
      (host .PluginHost:contribute "setting_choices"
        {^name "voices" ^!closed
         ^choices (fn [context] (voice_choices (host .PluginHost:rows "speech_synthesizers") (?? context/values {})))})
      (host .PluginHost:contribute "settings_groups"
        {^name "Voice" ^order 60 ^section "voice_engines" ^doc "Speech engines for spoken prompts and replies."})
      (host .PluginHost:contribute "web_components"
        {^name "voice_engines" ^slot "settings_section" ^render (fn [context] (voice_section host))})
      (host .PluginHost:contribute "hooks"
        {^point "request/prepare" ^name "voice" ^summary "Temporary spoken-input and spoken-reply guidance."
         ^run (fn [context, next] (next (voice_advisory service sessions context)))})
      (contribute_text_doc ^tags ["voice" "speech" "audio"] host "harness/voice"
        "Spoken prompts, reply playback, privacy and recovery."
        "Voice prompts are literal user requests, not slash commands. Speech recognition can mishear names: interpret it charitably. When replies are being spoken, keep progress replies short and add optional ^audio_reply to a final Outcome if code, tables, lists, URLs or paths do not read well aloud. Use one to three plain sentences, refer to details on screen, and omit symbols and long identifiers. Without audio_reply, the host normalizes reply text. Invalid optional audio data is discarded without rejecting a valid text reply. Voice does not answer waiting question batches. Browser recognition may use the browser vendor's remote service. Raw audio is not retained. Voice drafts are separate from typed and attachment drafts; uncertain submissions stay with host receipt recovery after this plugin is disabled."))))
