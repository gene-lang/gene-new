# The triggers plugin's owner HTTP route: /api/vN/p/triggers[...]
#   GET    ""                 list definitions      POST "" create
#   GET    "/occurrences"     all occurrences
#   PATCH  "/<id>"            change model_settings DELETE "/<id>" disable
#   GET    "/<id>/occurrences" one trigger's occurrences
(mod trigger_routes)
(import [TriggerError create_trigger update_trigger delete_trigger list_triggers list_occurrences]
  ^from "./scheduler")

(fn ^^private status_for [code : Str] : Int
  (match code ^!exhaustive
    (when "invalid_request" 400)
    (when "not_found" 404)
    (when "conflict" 409)
    (else 503)))

(fn ^^private body_data [request]
  (try ($json/parse request/body)
    catch Any (fail (TriggerError ^code "invalid_request" ^message "The request must contain JSON."))))

(fn ^^private handle [scheduler, request]
  (let parts ($filter ($str/split request/subpath "/") (fn [part] (!= part ""))))
  (let id (if (> parts/.size 0) ($url/decode_component parts/0) ""))
  (if (== parts/.size 0)
    (then
      (if (== request/method "GET") (return {^status 200 ^body {^triggers (list_triggers scheduler)}}))
      (if (== request/method "POST")
        (return {^status 201 ^body (create_trigger scheduler (body_data request))}))))
  (if (&& (== parts/.size 1) (== id "occurrences") (== request/method "GET"))
    (return {^status 200 ^body {^occurrences (list_occurrences scheduler)}}))
  (if_yes (== parts/.size 1)
    (if (== request/method "PATCH")
      (return {^status 200 ^body (update_trigger scheduler id (body_data request))}))
    (if (== request/method "DELETE")
      (return {^status 200 ^body (delete_trigger scheduler id)})))
  (if (&& (== parts/.size 2) (== parts/1 "occurrences") (== request/method "GET"))
    (return {^status 200 ^body {^occurrences (list_occurrences scheduler ^trigger id)}}))
  {^status 404 ^body {^code "not_found" ^message "Unknown trigger route."}})

(fn trigger_route [scheduler]
  {^name "triggers" ^kind "owner" ^methods ["GET" "POST" "PATCH" "DELETE"] ^path ""
   ^summary "Trigger definitions and occurrences."
   ^handle (fn [request]
     (try (handle scheduler request)
       catch TriggerError {^status (status_for $err/code) ^body {^code $err/code ^message $err/message}}
       catch Any {^status 400 ^body {^code "invalid_request" ^message $err/message}}))})
