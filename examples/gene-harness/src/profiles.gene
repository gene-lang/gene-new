# The registry: which profiles this application offers.
#
# One file to change when a deployment is added, and the only file that has to
# know the whole list. `src/profile.gene` is what a profile *is*; `src/profiles/`
# holds them; this is the lookup.
#
# Note there is no precedence between the entries. Two profiles are
# *alternatives*, not a stack — `cli` and `web` even reuse the plugin ids `fs`
# and `render` precisely so they cannot be layered (design §3.8).

(mod profiles)

(import [Profile] from "./profile")
(import [HarnessError] from "./kernel")
(import [cli_profile] from "./profiles/cli")
(import [web_profile] from "./profiles/web")
(import [chat_profile] from "./profiles/chat")

(fn profile_names [] : Any
  ["cli" "web" "chat"])

(fn profile_named [name : Str] : Profile
  (if (== name "cli")
    (cli_profile)
    (if (== name "web")
      (web_profile)
      (if (== name "chat")
        (chat_profile)
        (fail (HarnessError
          ^message $"unknown profile ${name}; expected one of $(profile_names)"))))))
