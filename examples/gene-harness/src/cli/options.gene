(mod cli_options)
(type CliError : Error ^props {^code Str ^request_id Str? ^submission_seq Str? ^execution_id Str? ^kind Str? ^session Str?})

(fn problem [message : Str, ^code code : Str = "invalid_request"]
  (fail (CliError ^code code ^_msg message)))

# The hosted entry receives its argv as a Node; direct callers pass a List.
(fn argument_values [args]
  (try
    (if (== ($head args/.body) List) args/.body else args)
    catch Error args))

(fn parse_options [args]
  (let values (argument_values args))
  (let argv [])
  (for arg in values
    (argv .push ($to_str arg)))
  (let options {})
  (let workspace ($os/get_env "GENE_HARNESS_WORKSPACE" ""))
  (if (!= workspace "") (options .put "workspace" workspace))
  (let words [])
  (var i 0)
  (var literal false)
  (var explicit_workspace false)
  (let valued
    [
      "workspace"
      "root"
      "provider"
      "model"
      "effort"
      "session"
      "port"
      "restart-port"
      "startup-id"
      "script"
      "title"
      "request-id"
      "sequence"
      "revision"
      "expected-revision"
      "limit"
      "round"
      "command"
      "batch"
      "answers"
      "file"
      "after"
      "before"
      "kind"
      "status"
      "trigger"
      "q"
      "since"
      "until"
      "type"
      "level"
      "lines"
      "cursor"
      "timeout-ms"])
  (let flags ["json" "wait" "no-wait" "confirm" "offline" "help" "attention" "supervised" "all" "recovery" "managed" "follow"])
  (while (< i argv/.size)
    (let arg ($to_str argv/%i))
    (if (&& (! literal) (== arg "--"))
      (set literal true)
      elif (&& (! literal) ($str/starts_with? arg "--"))
        (let key ($str/slice_bytes arg 2 (- ($str/byte_size arg) 2)))
        (if (valued .contains? key)
          (set i (+ i 1))
            (if (>= i argv/.size) (problem $"${arg} needs a value"))
            (if (== key "workspace") (set explicit_workspace true))
            (options .put key ($to_str argv/%i))
          elif (flags .contains? key)
            (options .put key true)
          else
            (problem $"Unknown option ${arg}. Use --help for usage."))
      else
        (words .push arg))
    (set i (+ i 1)))
  (let command (if words/.empty? "web" else words/0))
  (if (== command "manager")
    (if explicit_workspace
      (problem "manager hosts its root directory; use --root DIR instead of --workspace."))
    (options .delete "workspace"))
  (if (&& (! (["manager" "web"] .contains? command)) ($present? options/root))
    (problem "--root applies only to web and manager hosts."))
  {^options options ^words words ^command command})

(fn joined_words [words, start : Int] : Str
  (let rest [])
  (var i start)
  (while (< i words/.size)
    (rest .push words/%i)
    (set i (+ i 1)))
  ($str/join rest " "))

(fn read_data_file [path : Str]
  (let text ($fs/read_text path))
  (try
    ($serde/read_data text)
  catch Error
    (let forms ($into ($parse/read_all text) []))
    (if (|| (!= forms/.size 1) (!= ($head forms/0) Map))
      (problem "Definition must be an inert Gene map or serde data."))
    forms/0))
