(mod cli_channels)
(import [api] ^from "./client")
(import [problem read_data_file] ^from "./options")

(fn channel_command [client, words, options]
  (let action (?? words/1 "status"))
  (if (== action "status") (return (api client "GET" "/channels")))
  (if (== action "delivery")
    (return (api client "POST" "/channels/owner/result" {^id words/2})))
  (if (== action "queue")
    (return (api client "POST" "/channels/queue/status" {^session options/session})))
  (if (== action "resume")
    (return (api client "POST" "/channels/queue/resume"
      {^session options/session ^revision ($parse/parse_int (?? options/revision "-1"))})))
  (if ($absent? options/file)
    (problem "Use channels account NAME, route ACCOUNT or bind ROUTE --file FILE."))
  (let definition (read_data_file options/file))
  (if (== action "discard")
    (return (api client "POST" "/channels/queue/discard"
      {^session options/session ^revision ($parse/parse_int (?? options/revision "-1"))
       ^ids definition/ids ^reason definition/reason})))
  (if (== action "settings") (return (api client "POST" "/channels/settings" definition)))
  (if (== action "account")
    (return (api client "POST" "/channels/owner/accounts" (definition .assoc "id" words/2))))
  (if (== action "route")
    (return (api client "POST" "/channels/owner/routes" (definition .assoc "account" words/2))))
  (if (== action "bind")
    (return (api client "POST" "/channels/bind" (definition .assoc "route" words/2))))
  (problem "Unknown channels command."))
