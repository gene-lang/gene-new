# Deterministic no-terminal view used by tests and embeddings.

(mod recording_view)

(import [Plugin PluginContext PluginHost HarnessLog] from "./kernel")
(import_impl PluginHost for PluginContext from "./kernel")
(import [HarnessView view_provider] from "./view_api")

(type RecordingView ^props {^lines Any})

(type RecordingSink ^props {^lines Any})

(impl Callable for RecordingSink
  (message apply [self call]
    ((self/lines .get) .push (/0 call))))

(impl HarnessView for RecordingView
  # Stops from the prompt, which is what makes this view usable with no
  # terminal: the caller never reaches its read, so nothing ever waits on
  # stdin. `handle_line` exists to satisfy the protocol and is unreachable.
  (message show_prompt [h] : Any
    0)
  (message handle_line [h, line] : Any
    0))

(fn recording_view_plugin [lines] : Plugin
  (Plugin ^id "recording_view" ^provides [["views" "active"]]
    ^contextual true
    ^activate (fn [] (fn [host]
      (host .PluginHost:subscribe HarnessLog (RecordingSink ^lines lines))
      (host .PluginHost:contribute "views"
        {^name "active" ^implementation "recording" ^value
          (view_provider (RecordingView ^lines lines))})))))
