(import ^from "./cli/options" [parse_options problem])
(import ^from "./cli/main" [run_client usage])
(import ^from "./web/server" [main : serve_web])
(import ^from "./web/recovery" [main : serve_recovery])
(import ^from "./runtime/workspace_settings" [initialize_manager_workspace])

(fn mark_startup_entry [input]
  (let marker ($os/env? "GENE_HARNESS_ENTRY_MARKER"))
  (if ($absent? marker) (return nil))
  (let args [])
  (for arg in input (args .push ($to_str arg)))
  # Ignore the inherited marker in ordinary CLI subprocesses. The supervisor
  # supplies both the marker and a startup id for its direct hosting child.
  (var supervised false) (var id "") (var index 0)
  (while (< index args/.size)
    (let arg ($to_str args/%index))
    (if (== arg "--") (break))
    (if (== arg "--supervised") (set supervised true))
    (if (&& (== arg "--startup-id") (< (+ index 1) args/.size))
      (then (set index (+ index 1)) (set id ($to_str args/%index))))
    (set index (+ index 1)))
  (if (&& supervised (!= id "") ($str/ends_with? marker $"/${id}.entered"))
    (then
      ($fs/make_dir ($path/parent marker))
      ($fs/write_text_atomic ^^owner_only marker "entered")))
  nil)

(fn main [args] : Int
  (mark_startup_entry args)
  (let application ($pkg/application))
  (if_yes ($absent? application/provenance)
    (let delegated ["run" "--snapshot"
      ($path/join application/source_root "src/main.gene")])
    (for arg in args (delegated .push ($to_str arg)))
    (return (await ($os/exec_stdio_async ($os/executable_path) delegated...))))
  (var parsed nil)
  (try
    (set parsed (parse_options args))
    (if_yes (|| (== parsed/options/help true) (== parsed/command "help"))
      ($println (usage))
      (return 0))
    (if (== parsed/command "manager")
      (parsed/options .put "workspace" (initialize_manager_workspace ^root parsed/options/root)))
    (if_yes (["web" "manager"] .contains? parsed/command)
      (if (> parsed/words/.size 1) (problem "web accepts host options, not additional commands."))
      (map_for [key value] in parsed/options
        (if_not (["workspace" "root" "port" "restart-port" "startup-id" "script" "offline" "supervised" "recovery" "managed" "provider" "model" "effort"] .contains? ($to_str key))
          (problem $"--${key} requires a client command.")))
      (if (== parsed/options/recovery true) (return (serve_recovery parsed/options)))
      (let arguments [])
      (for key in ["workspace" "root" "port" "restart-port" "startup-id" "script" "provider" "model" "effort"]
        (let value (parsed/options .get key))
        (if_not ($absent? value)
          (arguments .push $"--${key}")
          (arguments .push value)))
      (if (== parsed/options/offline true) (arguments .push "--offline"))
      (if (== parsed/options/supervised true) (arguments .push "--supervised"))
      (if (== parsed/options/managed true) (arguments .push "--managed"))
      (return (serve_web arguments)))
    (run_client parsed)
  catch Any
    (let error {^code (?? $err/code "error") ^message $err/message})
    (let properties ($props $err))
    (for key in ["request_id" "submission_seq" "execution_id" "kind" "session"]
      (let value (properties .get key))
      (if_not ($absent? value) (error .put key value)))
    ($println
      (if (== parsed/options/json true)
        ($json/stringify error)
        $"${error/code}: ${error/message}"))
    1))
