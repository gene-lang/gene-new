# The harness entry point: boot a deployment from a named profile.
#
#   gene run examples/gene-harness/src/main.gene web
#   gene run examples/gene-harness/src/main.gene cli          # interactive
#   gene run examples/gene-harness/src/main.gene web status   # one-shot prompt
#
# For the interactive shell and for `build`, run it from the package directory
# so that a capability row naming `plugins/generated` means this one:
#
#   cd examples/gene-harness && gene run --allow_read_dir /tmp src/main.gene cli
#
# This is what `package.gene` names as the application entry, and it is the
# whole of what an entry point has to do here: pick a profile, hand it to
# `boot`, and run whatever driver the profile bound. There is no merge step and
# no overlay resolution — the profile *is* the configuration, and the kernel
# settles the rest (design §3.8).
#
# demo.gene is the tour — it walks the kernel's properties one at a time.

(import [profile_named] ^from "./profiles/registry")
(import [plugin_names] ^from "./profiles/profile")
(import [report_of] ^from "./profiles/common")
(import [ask] ^from "./agents/agent")
(import [plugin_states bound_seams lifecycle_log status_of row]
  ^from "./kernel")
(import [prepare_workspace doctor disable_entry enable_entry]
  ^from "./storage/workspace")
(import [HarnessView] ^from "./views/view_api")
(import [prepare_home open_runtime close_runtime] ^from "./runtime/bootstrap")
(import $os [get_env])

(fn arg_list [args] : Any
  (var out [])
  (for c in args (out .push ($to_str c)))
  out)

(fn joined_from [parts, i : Int] : Str
  (var out [])
  (var j i)
  (while (< j parts/.size)
    (out .push ($to_str parts/%j))
    (set j (+ j 1)))
  ($str/join out " "))

(fn print_output_since [h, start : Int]
  (var events (h/log .get))
  (var i start)
  (while (< i events/.size)
    (var event events/%i)
    (if_yes (== event/kind "output") ($println event/text))
    (set i (+ i 1))))

# The loop over a view's turns lives out here, and so does the read. A view
# that owned its loop drew one supervision budget for the whole conversation; a
# view that owned the read drew one for the human's thinking time and expired at
# the keyboard. Splitting the turn puts `$os/read_line` between two bounded
# calls and under neither of them — reading the process's own stdin is host
# authority, not something a plugin should be doing on a deadline. Re-reading
# the active row between turns is also the whole of view replacement: a row
# committed during a turn takes effect at the next prompt, and an absent row
# ends the session.
(fn run_view_turns [h, view] : Any
  (var current view)
  (while (!= current void)
    (var stopped (current/value .HarnessView:show_prompt h))
    (if_not (== stopped nil) (return stopped))
    # Unbounded on purpose. A view that never reaches a prompt — the recording
    # view, for one — stops above and this never runs, so a headless deployment
    # still never touches stdin.
    (var line ($os/read_line))
    (var result (current/value .HarnessView:handle_line h line))
    (if_not (== result nil) (return result))
    (set current (row h "views" "active")))
  0)

(fn print_summary [h, p]
  ($println "plugins:   " (plugin_names p))
  ($println "states:    " (plugin_states h))
  ($println "seams:     " (bound_seams h))
  ($println "report:    " (report_of h))
  ($println "")
  ($println "lifecycle:")
  (for l in (lifecycle_log h) ($println "  " l))
  (if_yes (!= (status_of h "reporter") "ready")
    ($println "")
    ($println "No report: a plugin did not reach `ready`, and the lifecycle")
    ($println "above says which and why. For the `cli` profile that is usually")
    ($println "the missing --allow_read_dir /tmp grant — the provider it binds")
    ($println "declares `(fs/ReadDir \"/tmp\")`, so the consumer that calls")
    ($println "through it cannot run without one. Nothing else was affected.")))

(fn main [args]
  (var names (arg_list args))
  (var name (if (> names/.size 0) names/0 "cli"))
  (var p (profile_named name))
  (var home (prepare_home))
  (var session (get_env "GENE_HARNESS_SESSION" "default"))
  (var prompt (joined_from names 1))
  (var recovery_command (if (> names/.size 1) names/1 ""))
  (var recovery_target (if (> names/.size 2) names/2 ""))
  (var recovering (["disable" "enable" "doctor"] .contains? recovery_command))
  (var runtime (open_runtime home session p ^activate (! recovering)))
  (var h runtime/h)
  (var workspace runtime/workspace)

  (try
    # Irreducible recovery commands run before descriptor or profile
    # activation. In particular, `disable` never gives the entry one more
    # effectful activation before taking it out of desired state.
    (if (== recovery_command "disable")
      (then
        ($println $"composition revision ${(disable_entry workspace recovery_target ^h h)}"))
      (elif (== recovery_command "enable")
        ($println $"composition revision ${(enable_entry workspace recovery_target ^h h)}"))
      (elif (== recovery_command "doctor")
        (prepare_workspace workspace h ^session session)
        (for finding in (doctor workspace) ($println finding)))
      (else
        (for finding in (doctor workspace)
          ($println $"quarantined: ${finding}"))
        # Three ways in, one system underneath. A one-shot prompt reaches the
        # same seam as the interactive view.
        (if (!= prompt "")
          (then
            (var current_log (h/log .get))
            (var output_start current_log/.size)
            (ask h prompt)
            (print_output_since h output_start))
          (else
            (var view (row h "views" "active"))
            (if (!= view void)
              (run_view_turns h view)
              (print_summary h p))))))
  ensure (close_runtime runtime)))
