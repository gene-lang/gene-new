(import ^from "./runtime/bootstrap" [open_runtime close_runtime prepare_workspace_root])
(import ^from "./profiles/baseline" [baseline_profile])
(import ^from "./runtime/round_controller" [new_round_controller close_round_controller])
(import ^from "./runtime/triggers" [open_trigger_manager close_trigger_manager list_triggers create_trigger delete_trigger list_occurrences])
(import ^from "./runtime/cli_driver" [ask])
(import ^from "./agents/model_client" [complete_messages])
(import ^from "./agents/scripted" [scripted_provider])
(import ^from "./storage/workspace" [doctor prepare_workspace disable_entry enable_entry])
(import ^from "./views/repl" [chat])
(import ^from "./kernel" [HarnessError])

(fn read_trigger_definition [path : Str]
  (let text ($fs/read_text path))
  (try ($serde/read_data text)
    catch Any
      (let forms ($into ($parse/read_all text) []))
      (if (|| (!= forms/.size 1) (!= ($head forms/0) Map))
        (fail (HarnessError ^message "trigger definition must be an inert Gene map or serde data")))
      forms/0))

(fn main [args]
  (let names [])
  (for arg in args
    (names .push ($to_str arg)))
  (var root "")
  (var session "default")
  (var script nil)
  (let positional [])
  (var index 0)
  (while (< index names/.size)
    (let name names/%index)
    (if (["--workspace" "--session" "--script"] .contains? name)
      (then
        (set index (+ index 1))
        (if (>= index names/.size) (fail (HarnessError ^message $"${name} needs a value")))
        (if (== name "--workspace")
          (set root names/%index)
          (if (== name "--session")
            (set session names/%index)
            (set script names/%index))))
      (else
        (positional .push name)))
    (set index (+ index 1)))
  (let command (if positional/.empty? "chat" positional/0))
  (let recovery (["doctor" "disable" "enable"] .contains? command))
  (let provider
    (if ($absent? script)
      complete_messages
      (scripted_provider (($parse/read_all ($fs/read_text script)) .next))))
  (let runtime
    (open_runtime ^entry this_mod/.path ^activate (! recovery)
      (prepare_workspace_root ^root root)
      session
      (baseline_profile)))
  (var controller nil)
  (try
    (if recovery
      (then
        (if (== command "doctor")
          (then
            (prepare_workspace runtime/workspace runtime/h)
            (for finding in (doctor runtime/workspace)
              ($println finding)))
          (else
            (if (< positional/.size 2) (fail (HarnessError ^message $"${command} needs a plugin id")))
            ($println
              (if (== command "disable")
                (disable_entry ^h runtime/h runtime/workspace positional/1)
                (enable_entry ^h runtime/h runtime/workspace positional/1)))))
        (return 0)))
    (if_not (["chat" "scripted" "triggers"] .contains? command) (fail (HarnessError ^message $"unknown command ${command}")))
    (set controller (new_round_controller runtime provider))
    (let serving (!= command "triggers"))
    (let triggers (open_trigger_manager runtime controller ^start serving ^boot serving))
    (if (== command "triggers")
      (then
        (let action (if (> positional/.size 1) positional/1 "list"))
        (match action
          (when "list" (for definition in (list_triggers triggers) ($println definition)))
          (when "create"
            (if (< positional/.size 3) (fail (HarnessError ^message "triggers create needs a definition file")))
            ($println (create_trigger triggers (read_trigger_definition positional/2))))
          (when "delete"
            (if (< positional/.size 3) (fail (HarnessError ^message "triggers delete needs an id")))
            ($println (delete_trigger triggers positional/2)))
          (when "occurrences"
            (for occurrence in (list_occurrences triggers ^trigger (if (> positional/.size 2) positional/2 nil))
              ($println occurrence)))
          (else (fail (HarnessError ^message $"unknown triggers action ${action}"))))
        (return 0)))
    (if (> positional/.size 1)
      (then
        (let prompt [])
        (var i 1)
        (while (< i positional/.size)
          (prompt .push positional/%i)
          (set i (+ i 1)))
        (ask controller session ($str/join prompt " ")))
      (else
        (chat controller session)))
    (runtime/exit_code .get)
  ensure
    (if_not ($absent? runtime/triggers) (close_trigger_manager runtime/triggers))
    (if_not ($absent? controller) (close_round_controller controller))
    (close_runtime runtime)))
