# A runnable tour of the harness kernel.
#
#   gene run examples/gene-harness/src/main.gene
#
# Every line it prints is a property docs/design.md claims: atomic activation,
# no partial registration, one provider per seam, and an uninstall that removes
# exactly one plugin's contributions.

(import [new_harness install uninstall resolve provide replace installed
         bound_seams install_sandboxed module_dir log_append log_events
         assemble_request subscribe publish HarnessEvent ToolInvoked
         Plugin HarnessError]
  from "./kernel")
(import [HarnessFs LocalFs MemFs head_tool fs_provider] from "./seams")

(fn fs_plugin [] : Plugin
  (Plugin ^id "fs_local" ^provides ["Fs"]
    ^activate (fn [] (fn [h, id] (provide h id "Fs" "LOCAL-FS")))))

(fn combo_plugin [] : Plugin
  # Two seams from one plugin, so uninstall has more than one effect to reverse.
  (Plugin ^id "combo" ^provides ["Llm" "Tools"]
    ^activate (fn [] (fn [h, id]
      (provide h id "Llm" "LLM-A")
      (provide h id "Tools" "TOOLS-A")))))

(fn broken_plugin [] : Plugin
  # Registers one seam, then fails. The seam must not survive.
  (Plugin ^id "broken" ^provides ["Log"]
    ^activate (fn [] (fn [h, id]
      (provide h id "Log" "LOG-X")
      (fail (HarnessError ^message "boom during activate"))))))

# Two providers of one seam. Each is a plugin; neither is the consumer's
# business.
(fn mem_fs_plugin [] : Plugin
  (Plugin ^id "fs_mem" ^provides ["HarnessFs"]
    ^activate (fn [] (fn [h, id]
      (provide h id "HarnessFs"
        (fs_provider (MemFs ^files {^notes "mem:hello"})))))))

(fn local_fs_plugin [] : Plugin
  (Plugin ^id "fs_local_real" ^provides ["HarnessFs"]
    ^activate (fn [] (fn [h, id]
      (replace h id "HarnessFs" (fs_provider (LocalFs ^root "/tmp")))))))

# An observer plugin. It contributes no seam at all — it subscribes, which is
# an effect the ledger reverses like any other.
(var audit_seen ($cell []))

(fn note_tool [e : ToolInvoked]
  ((audit_seen ~ get) ~ push $"${e/tool}(${e/arg})"))

(fn audit_plugin [] : Plugin
  (Plugin ^id "audit" ^provides []
    ^activate (fn [] (fn [h, id] (subscribe h id ToolInvoked note_tool)))))

(fn show [label, thunk]
  ($println "  " label ($to_str (thunk))))

(fn main [args]
  (var h (new_harness))

  ($println "-- install --")
  ($println "  " (install h (fs_plugin)))
  ($println "  " (install h (combo_plugin)))
  ($println "  seams:     " (bound_seams h))
  ($println "  installed: " (installed h))

  ($println "-- resolve --")
  ($println "  Fs -> " (resolve h "Fs"))

  ($println "-- activation is all-or-nothing --")
  ($println "  " (try (install h (broken_plugin)) catch e $"refused: ${e/message}"))
  ($println "  Log rolled back? "
    (try (resolve h "Log") catch e "yes — no provider left behind"))
  ($println "  installed: " (installed h))

  ($println "-- binding is explicit, not last-wins --")
  ($println "  " (try (install h (fs_plugin)) catch e $"refused: ${e/message}"))

  ($println "-- uninstall reverses exactly one plugin --")
  ($println "  " (uninstall h "combo"))
  ($println "  Llm gone?  " (try (resolve h "Llm") catch e "yes"))
  ($println "  Fs intact: " (resolve h "Fs"))
  ($println "  seams:     " (bound_seams h))
  ($println "  installed: " (installed h))

  # --- the seam payoff ------------------------------------------------------
  #
  # One consumer, two providers, and a swap that the consumer never sees. The
  # authority contract rides along: the in-memory provider declared
  # `^capabilities []` and runs anywhere, while the local one declared
  # `(fs/ReadDir "/tmp")` and is refused without that grant. Swapping the
  # provider therefore changes what the *product* is allowed to do, which is
  # the property a plugin system built on good manners cannot offer.
  ($println "-- a seam is a protocol carrying an authority contract --")
  (install h (mem_fs_plugin))
  ($println "  provider:  in-memory")
  ($println "  head_tool: "
    (try (head_tool (resolve h "HarnessFs") "notes")
      catch e $"refused: ${e/message}"))

  (install h (local_fs_plugin))
  ($println "  provider:  local (replaced, live)")
  ($println "  head_tool: "
    (try (head_tool (resolve h "HarnessFs") "notes")
      catch e $"refused: ${e/message}"))
  ($println "  ^ same consumer, untouched. The provider changed, and with it")
  ($println "    the authority the product needs: the local provider is")
  ($println "    refused without --allow_read_dir /tmp and")
  ($println "    serves the file with it. Run it both ways.")

  # Replacement moved the ledger entry too. Uninstalling the plugin that
  # *used* to own the seam must not unbind a seam it no longer provides —
  # otherwise the live provider would vanish for a reason nothing explains.
  ($println "  " (uninstall h "fs_mem"))
  ($println "  seam survives its former owner: "
    (try (head_tool (resolve h "HarnessFs") "notes")
      catch e $"refused: ${e/message}"))
  ($println "  installed: " (installed h))

  # --- a plugin that was never compiled in ----------------------------------
  #
  # Loaded from outside src/ at runtime, granted nothing, and still able to
  # implement the seam — because the harness shares the one file holding the
  # protocol. Grants are the operator-readable statement of reach: `[]` here
  # means this code cannot name $fs, $net, or $os at all.
  # A value that does not implement the seam is refused where it is bound,
  # not where it is first used.
  ($println "  non-conforming provider: "
    (try (fs_provider "just-a-string") catch e "refused at bind"))

  ($println "-- a plugin loaded at runtime, granted nothing --")
  (var here (module_dir this_mod/~path))
  (fn load_stub []
    (install_sandboxed h $"${here}/../plugins/fs_stub" "plugin.gene"
      []                              # grants: nothing that reaches the world
      [$"${here}/seams.gene"]))       # shared: the seam definition, so the
                                      # plugin implements *this* HarnessFs
  # The rules do not soften for code that arrived late: a bound seam is still
  # refused rather than shadowed.
  ($println "  " (try (load_stub) catch e $"refused: ${e/message}"))
  ($println "  " (uninstall h "fs_local_real"))
  # With the seam free, the outcome below can only come from the sandbox — and
  # it is not what the design doc assumed. The rogue plugin reaches for $fs,
  # and it *loads*: a denied namespace is absent, so the name fails where it is
  # resolved, which for a name used only inside a message body is the first
  # call. The boundary holds — the read never happens — but it arrives late and
  # the diagnostic does not mention the sandbox.
  ($println "  rogue load: "
    (try (install_sandboxed h $"${here}/../plugins/fs_rogue" "plugin.gene"
           [] [$"${here}/seams.gene"])
      catch e $"refused: ${e/message}"))
  ($println "  rogue call: "
    (try (head_tool (resolve h "HarnessFs") "notes")
      catch e $"refused: ${e/message}"))
  ($println "  ^ the boundary holds and the file is never read, but the")
  ($println "    refusal is at first call, not at load, and the message")
  ($println "    does not say \"sandbox\". See docs/design.md §5.")
  ($println "  " (uninstall h "fs_rogue"))
  ($println "  " (load_stub))
  ($println "  head_tool: "
    (try (head_tool (resolve h "HarnessFs") "notes")
      catch e $"refused: ${e/message}"))
  ($println "  ^ never compiled in, cannot name $fs at all, and still")
  ($println "    satisfies the seam the consumer sends to.")
  ($println "  installed: " (installed h))

  # --- model-visible <=> logged ---------------------------------------------
  #
  # The invariant worth stealing verbatim from dsh. A plugin that wants
  # something in front of the model appends a log event; the assembler reads
  # the log and nothing else, so the request is reconstructible by
  # construction rather than by discipline.
  ($println "-- model-visible <=> logged --")
  (log_append h "message" "user: read notes")
  (log_append h "trace" "tool selected: head_tool")
  (log_append h "message" (head_tool (resolve h "HarnessFs") "notes"))
  (var events (log_events h))
  ($println "  log events:  " events/~size)
  ($println "  request:     " (assemble_request (log_events h)))
  ($println "  ^ the trace line is in the log and not in the request; the")
  ($println "    request contains only what the log says is model-visible.")

  # Replay is a fold over the log, so it does not depend on the live system.
  # Tear the provider out and the same request still assembles.
  (uninstall h "fs_stub")
  ($println "  after uninstalling the provider:")
  ($println "  request:     " (assemble_request (log_events h)))
  ($println "  seams:       " (bound_seams h))

  # --- an effect the ledger reverses that is not a seam ---------------------
  #
  # §3.7 said the ledger closed the mechanism and what remained was breadth.
  # `subscription` is the second kind. An observer plugin contributes no seam;
  # it subscribes, and uninstalling it cancels the subscription without the
  # plugin's cooperation. A listener outliving its plugin is the classic
  # plugin-system leak, and the ledger is what makes it impossible here.
  ($println "-- the ledger reverses subscriptions too --")
  ($println "  " (install h (audit_plugin)))
  (publish h (ToolInvoked ^tool "head_tool" ^arg "notes"))
  ($println "  audit saw:   " (audit_seen ~ get))
  ($println "  " (uninstall h "audit"))
  (publish h (ToolInvoked ^tool "head_tool" ^arg "after-uninstall"))
  ($println "  audit saw:   " (audit_seen ~ get))
  ($println "  ^ unchanged: the subscription went with the plugin.")
  nil)
