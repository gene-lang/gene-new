# Stable, shared contract between the harness kernel and generated plugins.
# Contributions may add summary (Str), tags ([Str]) and docs ([chapter name]).
# discover indexes active metadata automatically; doc loads one owned chapter.
# Keep prompt rows to essential orientation and place manuals/examples in docs.

(mod plugin_api)

(type Plugin ^props {^id Str ^provides Any? ^requires Any? ^activate Any ^deactivate Any? ^events Any?})

# The bus publishes this after a workspace or session event is appended.
# Subscribe to DurableRecord, then select an event by `name`.
(type HarnessEvent : $event/Event)
(type DurableRecord : HarnessEvent ^props {^scope Str ^stream Str ^name Str ^envelope Any})

# Shared nominal identity for command callbacks. For non-host rows,
# manager/runtime are nil and snapshot is public revision data.
(type CommandContext ^props {^manager Any ^runtime Any ^session Str ^raw Str ^id Str ^output Any ^snapshot Any})
(type CommandResult ^props {^display Any? ^status Str? ^attached Bool? ^exit Int? ^view Any? ^selected Str? ^stop Int? ^mode Str?})

# Inert input to descriptor construction. It deliberately implements no host
# protocol: preflight and boot see only immutable identity, never live registry
# state or a contribution surface.
(type DescriptorContext ^props {^module_id Str ^core_interface Str})

(type ExecutionLimits ^props {^max_memory_mb Int ^timeout_ms Int})

(fn default_execution_limits [] : ExecutionLimits
  (ExecutionLimits ^max_memory_mb 64 ^timeout_ms 2000))

(fn response_execution_limits [] : ExecutionLimits
  (ExecutionLimits ^max_memory_mb 1024 ^timeout_ms 600000))

(type ImageError ^props {^code Str ^message Str ^status Int? ^usage Any? ^diagnostic Str?} ^impl [Error])
(impl Error for ImageError)

# Provider adapters share one failure contract without importing the kernel.
(type ProviderError ^props {^message Str} ^impl [Error])
(impl Error for ProviderError)

(type ServiceError ^props {^code Str ^message Str} ^impl [Error])
(impl Error for ServiceError)

(protocol MediaHost
  (message list [] : Any)
  (message show [id : Str] : Any)
  (message import_file [path : Str] : Any)
  (message page [id : Str, page : Int] : Any)
  (message store [name : Str, data, ^source source : Str = "upload"] : Any))

(protocol TriggerHost
  (message start [] : Any)
  (message list [] : Any)
  (message create [definition] : Any)
  (message delete [id : Str] : Any)
  (message occurrences [^trigger trigger : Str = ""] : Any))

(protocol ChannelHost
  (message start [] : Any)
  (message state [] : Any))

(protocol SessionHost
  (message record [session : Str] : Any)
  (message round [session : Str] : Any))

(protocol VoiceHost
  (message output [session : Str] : Bool)
  (message reset_if_unused [] : Any))

(protocol UiHost
  (message settings [] : Any)
  (message configure [settings] : Any)
  (message preview [name : Str, state = {}] : Any)
  (message receipts [^view view : Str = "", ^status status : Str = "", ^input_id input_id : Str = "",
                     ^before before : Int = 0, ^limit limit : Int = 25] : Any))

# A browser redirect reference carries no owner credential. Only the
# authenticated HTTP host resolves it to a navigation URL.
(type BrowserTarget ^props {^kind Str ^id Str})

(protocol WorkspaceHost
  (message list [] : Any)
  (message snapshot [] : Any)
  (message inspect [id : Str] : Any)
  (message operation [operation : Str, values = {}] : Any)
  (message action [operation : Str, values] : Any)
  (message open_link [id : Str] : BrowserTarget))

(protocol ComputerHost
  (message start [] : Any)
  (message command [context : CommandContext] : Any)
  (message targets [] : Any)
  (message observe [target : Str, ^query query : Str = ""] : Any)
  (message act [target : Str, observation : Str, name : Str, params, request : Str] : Any)
  (message receipt [request : Str] : Any))

(protocol OperatorHost
  (message command [name : Str, context : CommandContext] : Any)
  (message retain_mode [mode : Str] : Any)
  (message classify [mode : Str, text : Str] : Str)
  (message input [mode : Str, context : CommandContext] : Any)
  (message close [mode : Str, session : Str] : Any))

(protocol CompositionHost
  (message register [id : Str, source, ^dependencies dependencies = [], ^replace replace : Bool = false] : Any)
  (message states [] : Any)
  (message inspect [id : Str] : Any)
  (message enable [id : Str, enabled : Bool] : Any)
  (message restore [id : Str] : Any)
  (message history [id : Str = "", ^limit limit : Int = 50, ^before before = nil, ^page page : Bool = false] : Any)
  (message revert [id : Str, revision : Int, ^expected expected = nil] : Any))

(import [DelegationError] ^from "./runtime/delegation_contract" ^^export)

(protocol DelegationHost
  (message stage [request] : Any)
  (message inspect [id : Str] : Any)
  (message cancel [id : Str] : Any)
  (message continue [id : Str, text : Str] : Any)
  (message answer [id : Str, answers] : Any))

# The workflow owns prompts and loop policy; these host operations own durable
# admission, individual model calls and media. Image bytes are exposed only to
# a selected generator while its send callback is active.
(protocol ImageHost
  (message begin [request] : Any)
  (message generate [run : Str, instructions : Str] : Any)
  (message review [run : Str, instructions : Str, ^repair repair : Bool = false] : Any)
  (message finish [run : Str, reason : Str] : Any)
  (message image_input [run : Str, id : Str] : Any))

(protocol PluginHost
  (message execution_budget [] : Any)
  (message defer [cleanup] : Any)
  (message registry_names [] : Any)
  (message row_keys [registry : Str] : Any)
  (message rows [registry : Str] : Any)
  (message row [registry : Str, key : Str] : Any)
  (message run_hooks [point : Str, context] : Any)
  (message create_registry [spec] : Any)
  (message resolve [seam : Str] : Any)
  (message provide [seam : Str, value] : Str)
  (message replace [seam : Str, value] : Str)
  (message contribute [registry : Str, payload] : Str)
  (message replace_contribution [registry : Str, payload] : Str)
  (message subscribe [selector, handler] : Any)
  (message emit_event [name : Str, payload] : Any)
  (message state [^session session = nil] : Any)
  (message update_state [value, ^session session = nil] : Any)
  (message notify [message] : Any)
  (message notifications [] : Any)
  (message notification_update [id : Str, changes] : Any)
  (message notification_clear [id : Str, revision : Int] : Any))

# Operator-inbox access is distinct from PluginHost's source-owned publisher.
# Reads and revision-checked clears cover all sources; writes remain operator-owned.
(protocol NotificationHost
  (message post [message] : Any)
  (message update [id : Str, changes] : Any)
  (message list [] : Any)
  (message detail [id : Str] : Any)
  (message clear [id : Str, revision : Int] : Any))

(import ^from "./agents/outcome" [append_plugin_prompt TurnClosed])
(fn append_prompt [label : Str, value]
  (append_plugin_prompt label value))

# A plugin function called from response code can place a card in the calling
# conversation (docs/cards.md). It passes ^view and ^update as quoted fn forms.
(fn show_card [id, tree = nil, ^title title = nil, ^state state = nil, ^view view = nil, ^update update = nil]
  (let api (/cards ($runtime/context)))
  (if ($absent? api)
    (fail (TurnClosed ^message "show_card requires an open turn in a conversation")))
  (api/card_from_plugin id tree ^title title ^state state ^view view ^update update))
