# Stable, shared contract between the harness kernel and generated plugins.

(mod plugin_api)

(type Plugin ^props {^id Str ^provides Any? ^requires Any? ^activate Any ^deactivate Any? ^events Any?})

(type CommandContext ^props {^manager Any ^runtime Any ^session Str ^raw Str ^id Str ^output Any ^snapshot Any})
(type CommandResult ^props {^display Any? ^status Str? ^attached Bool? ^exit Int? ^view Any? ^selected Str? ^stop Int?})

# Inert input to descriptor construction. It deliberately implements no host
# protocol: preflight and boot see only immutable identity, never live registry
# state or a contribution surface.
(type DescriptorContext ^props {^module_id Str ^core_interface Str})









(type ExecutionLimits ^props {^max_steps Int ^max_memory_mb Int ^timeout_ms Int})

(fn default_execution_limits [] : ExecutionLimits
  (ExecutionLimits ^max_steps 100000 ^max_memory_mb 64 ^timeout_ms 2000))

(fn response_execution_limits [] : ExecutionLimits
  (ExecutionLimits ^max_steps 9223372036854775807 ^max_memory_mb 1024 ^timeout_ms 600000))

(protocol PluginHost
  (message registry_names [] : Any)
  (message row_keys [registry : Str] : Any)



  (message create_registry [spec] : Any)
  (message resolve [seam : Str] : Any)
  (message provide [seam : Str, value] : Str)
  (message replace [seam : Str, value] : Str)
  (message contribute [registry : Str, payload] : Str)
  (message replace_contribution [registry : Str, payload] : Str)
  (message subscribe [selector, handler] : Any)
  (message emit_event [name : Str, payload] : Any)
  (message state [^session session = nil] : Any)
  (message update_state [value, ^session session = nil] : Any))

(import ^from "./agents/outcome" [append_plugin_prompt])
(fn append_prompt [label : Str, value]
  (append_plugin_prompt label value))
