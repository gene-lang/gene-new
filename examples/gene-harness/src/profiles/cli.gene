# The `cli` deployment: a real filesystem and plain-text output.
#
#   gene run examples/gene-harness/src/main.gene cli
#
# What distinguishes this profile from `web` is not code shape — both are three
# plugins with the same ids — but what they reach. The filesystem provider here
# reads the real disk beneath /tmp where the web one serves an in-memory map;
# see design §3.8.

(mod cli)

(import [Plugin PluginContext PluginHost] ^from "../kernel")
(import_impl PluginHost for PluginContext ^from "../kernel")
(import [HarnessFs LocalFs TextRender fs_provider render_provider] ^from "../seams")
(import [Profile] ^from "./profile")
(import [reporter_plugin] ^from "./common")
(import [agent_plugin command_plugin template_codegen_plugin] ^from "../agents/agent")
(import [code_command_plugin] ^from "../agents/code_command")
(import [driver_plugin] ^from "../views/repl")

# Each factory is nullary and references only module-level names, so the stored
# activation captures nothing from the frame that built it — see the note on the
# thunk convention in kernel.gene.

(fn cli_fs_plugin [] : Plugin
  # Reads the real filesystem, beneath /tmp.
  (Plugin ^id "fs" ^provides ["HarnessFs" ["tools" "fs.read"]]
    ^contextual true
    ^activate (fn [] (fn [host]
      (var fs (fs_provider (LocalFs ^root "/tmp")))
      (host .PluginHost:provide "HarnessFs" fs)
      (host .PluginHost:contribute "tools"
        {^name "fs.read" ^doc "Read a file beneath /tmp in the explicit CLI demonstration."
         ^input_schema {^type "object" ^required ["path"] ^properties {^path {^type "string"}}}
         ^run (fn [input] {^path input/path ^text (fs .HarnessFs:read_text input/path) ^truncated false})})))))

(fn cli_render_plugin [] : Plugin
  (Plugin ^id "render" ^provides ["HarnessRender"]
    ^contextual true
    ^activate (fn [] (fn [host]
      (host .PluginHost:provide "HarnessRender"
        (render_provider (TextRender)))))))

(fn cli_profile [] : Profile
  # The driver is what makes this deployment interactive. It contributes a
  # view row; main runs the selected view and knows no profile-specific driver.
  (Profile ^name "cli"
           ^plugins [(cli_fs_plugin) (cli_render_plugin) (reporter_plugin)
                     (command_plugin) (code_command_plugin) (agent_plugin) (driver_plugin)
                     (template_codegen_plugin)]))
