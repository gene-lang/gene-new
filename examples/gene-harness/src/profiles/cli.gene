# The `cli` deployment: a real filesystem and plain-text output.
#
#   gene run --allow_read_dir /tmp examples/gene-harness/src/main.gene cli
#
# What distinguishes this profile from `web` is not code shape — both are three
# plugins with the same ids — but *authority*. The filesystem provider here
# declares `(fs/ReadDir "/tmp")`, so a deployment that boots this set needs a
# grant the web one does not. Run it without the grant and the reporter is the
# only casualty; see design §3.8.

(mod cli)

(import [Plugin provide] from "../kernel")
(import [LocalFs TextRender fs_provider render_provider] from "../seams")
(import [Profile] from "../profile")
(import [reporter_plugin] from "./common")

# Each factory is nullary and references only module-level names, so the stored
# activation captures nothing from the frame that built it — see the note on the
# thunk convention in kernel.gene.

(fn cli_fs_plugin [] : Plugin
  # Reads the real filesystem, and says so in the only place that counts: the
  # provider's `^capabilities` row.
  (Plugin ^id "fs" ^provides ["HarnessFs"]
    ^activate (fn [] (fn [h, id]
      (provide h id "HarnessFs" (fs_provider (LocalFs ^root "/tmp")))))))

(fn cli_render_plugin [] : Plugin
  (Plugin ^id "render" ^provides ["HarnessRender"]
    ^activate (fn [] (fn [h, id]
      (provide h id "HarnessRender" (render_provider (TextRender)))))))

(fn cli_profile [] : Profile
  (Profile ^name "cli"
           ^plugins [(cli_fs_plugin) (cli_render_plugin) (reporter_plugin)]))
