# What a profile *is*, and how to boot one.
#
# This file knows nothing about any particular deployment. `src/profiles/registry.gene`
# is the registry of the ones that exist, and `src/profiles/` holds them.
#
# **A profile is a set, not a stack.** It names the plugins a deployment starts
# with, and nothing about the order they appear in changes what you get.
#
# That is not a style preference. `dsh` assembles a running instance from
# ordered layers — bundle patches, then profile, then home, then CLI overlays,
# over a base config — and needs `--dump-config` to tell you what you actually
# got (design §1.5). Ordered layers exist because when activation is a
# *sequence*, order decides which provider wins and which dependency is visible;
# once order is load-bearing, composition has to be expressed as a stack and the
# stack has to be printable to be understood. Make unmet dependencies a *state*
# instead (§3.3.5) and the problem the layers were solving stops existing.
# `boot_reversed` is here to keep that claim honest.
#
# What a profile does *not* do is patch another profile. Modifying a running
# harness is `install`, `uninstall`, and `replace` — named operations an
# operator asked for, at runtime, on a live system (§4, "living application").
# A layer that wins by arriving later is the thing we are avoiding.

(mod profile)

(import [Harness new_harness put_cordis_plugins] ^from "../kernel")

(type Profile ^props {^name Str ^plugins Any ^limits Any?})

(fn boot [p : Profile, ^h supplied = nil] : Harness
  # The whole of it: stage every plugin, then reconcile once. There is no merge
  # step and no overlay resolution; the profile *is* the configuration.
  #
  # `^limits` is the one deployment-wide knob a profile carries. A callback
  # budget states what callbacks do in this deployment, and it is also the
  # ceiling every plugin's limits narrow from. `^inherit true` leaves the
  # launcher's capability context where the baseline puts it.
  (var h (if (== supplied nil) (new_harness ^limits p/limits) supplied))
  (var admissions [])
  (for plugin in p/plugins
    (admissions .push
      {^plugin plugin
       ^options (if ($absent? p/limits)
         {^inherit true}
         {^scope "session" ^selectors [] ^inherit true ^limits p/limits})}))
  (put_cordis_plugins h admissions)
  h)

(fn reversed [xs] : Any
  (var out [])
  (var i (- xs/.size 1))
  (while (>= i 0)
    (out .push xs/%i)
    (set i (- i 1)))
  out)

(fn boot_reversed [p : Profile] : Harness
  # Exists to keep the claim in this file's header honest. Booting a profile
  # backwards must reach the same state as booting it forwards; if it ever does
  # not, "a profile is a set" was wrong and the layers were right.
  (boot (Profile ^name p/name ^plugins (reversed p/plugins) ^limits p/limits)))

(fn plugin_names [p : Profile] : Any
  (var out [])
  (for plugin in p/plugins (out .push plugin/id))
  out)
