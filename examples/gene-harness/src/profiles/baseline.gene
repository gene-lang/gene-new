(mod baseline)
(import Profile ^from "./profile")
(import ExecutionLimits ^from "../plugin_api")
(import gene_reference ^from "../builtin/gene_reference")
(import plugin_admin ^from "../builtin/plugin_admin")
(import core_commands ^from "../builtin/core_commands")
(import shell ^from "../builtin/shell")
(import repl ^from "../builtin/repl")
(import workspace_ui ^from "../builtin/workspace_ui")
(import notifications ^from "../builtin/notifications")
(import triggers ^from "../builtin/triggers")
(import provider_chatgpt ^from "../builtin/provider_chatgpt")
(import provider_anthropic ^from "../builtin/provider_anthropic")
(import provider_claude ^from "../builtin/provider_claude")
(import provider_openrouter ^from "../builtin/provider_openrouter")
(import provider_deepseek ^from "../builtin/provider_deepseek")
(import budget_advisory ^from "../builtin/budget_advisory")
(import history_basic ^from "../builtin/history_basic")
(import working_instructions ^from "../builtin/working_instructions")
(import sidebar ^from "../builtin/sidebar")
(import spotlight ^from "../builtin/spotlight")
(import voice ^from "../builtin/voice")
(import media ^from "../builtin/media")
(import computer ^from "../builtin/computer")
(import image ^from "../builtin/image")
(import image_openrouter ^from "../builtin/image_openrouter")
(import delegation ^from "../builtin/delegation")
(import slack ^from "../builtin/slack")
(import models ^from "../builtin/models")
(import model_endpoints models_file_watch ^from "../builtin/model_endpoints")
(import settings ^from "../builtin/settings")
(import decisions ^from "../builtin/decisions")
(import editor ^from "../builtin/editor")
(fn baseline_profile [^models_root models_root = nil]
  (let launcher (spotlight))
  (Profile ^name "web" ^plugins [launcher (voice) (gene_reference) (plugin_admin) (core_commands) (shell) (repl) (triggers) (workspace_ui) (notifications) (provider_chatgpt) (provider_anthropic) (provider_claude) (provider_openrouter) (provider_deepseek) (budget_advisory) (decisions) (editor) (history_basic) (working_instructions) (sidebar) (media) (computer) (image) (image_openrouter) (delegation) (slack) (model_endpoints ^root models_root) (models_file_watch ^root models_root) (models ^root models_root) (settings)] ^requires [["prompt" "gene_reference"] ["hooks" "history/compact/history_basic"]] ^limits (ExecutionLimits ^max_memory_mb 1024 ^timeout_ms 600000)))
