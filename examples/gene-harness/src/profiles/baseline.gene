(mod baseline)
(import ^from "./profile" [Profile])
(import ^from "../plugin_api" [ExecutionLimits])
(import ^from "../builtin/gene_reference" [gene_reference])
(import ^from "../builtin/plugin_admin" [plugin_admin])
(import ^from "../builtin/core_commands" [core_commands])
(import ^from "../builtin/shell" [shell])
(import ^from "../builtin/repl" [repl])
(import ^from "../builtin/workspace_ui" [workspace_ui])
(import ^from "../builtin/notifications" [notifications])
(import ^from "../builtin/triggers" [triggers])
(import [provider_chatgpt] ^from "../builtin/provider_chatgpt")
(import ^from "../builtin/provider_anthropic" [provider_anthropic])
(import ^from "../builtin/provider_claude" [provider_claude])
(import ^from "../builtin/provider_openrouter" [provider_openrouter])
(import ^from "../builtin/budget_advisory" [budget_advisory])
(import ^from "../builtin/history_basic" [history_basic])
(import ^from "../builtin/working_instructions" [working_instructions])
(import ^from "../builtin/sidebar" [sidebar])
(import [spotlight] ^from "../builtin/spotlight")
(import [voice] ^from "../builtin/voice")
(import ^from "../builtin/media" [media])
(import ^from "../builtin/computer" [computer])
(import [image] ^from "../builtin/image")
(import [image_openrouter] ^from "../builtin/image_openrouter")
(import [delegation] ^from "../builtin/delegation")
(import [slack] ^from "../builtin/slack")
(import [models] ^from "../builtin/models")
(import [model_endpoints models_file_watch] ^from "../builtin/model_endpoints")
(import [settings] ^from "../builtin/settings")
(import [decisions] ^from "../builtin/decisions")
(fn baseline_profile [^models_root models_root = nil]
  (let launcher (spotlight))
  (Profile ^name "web" ^plugins [launcher (voice) (gene_reference) (plugin_admin) (core_commands) (shell) (repl) (triggers) (workspace_ui) (notifications) (provider_chatgpt) (provider_anthropic) (provider_claude) (provider_openrouter) (budget_advisory) (decisions) (history_basic) (working_instructions) (sidebar) (media) (computer) (image) (image_openrouter) (delegation) (slack) (model_endpoints ^root models_root) (models_file_watch ^root models_root) (models ^root models_root) (settings)] ^requires [["prompt" "gene_reference"] ["hooks" "history/compact/history_basic"]] ^limits (ExecutionLimits ^max_memory_mb 1024 ^timeout_ms 600000)))
