# The `web` deployment: no filesystem authority, escaped HTML output.
#
#   gene run examples/gene-harness/src/main.gene web
#
# The mirror of `cli`. Same provider/reporter/agent plugins, two
# different providers — and because the in-memory filesystem provider declares
# `^capabilities []`, this profile boots under no grants at all. A web
# deployment has no business reading the operator's disk, and here that is a
# fact about the binding rather than a rule someone has to remember.

(mod web)

(import [Plugin PluginContext PluginHost] from "../kernel")
(import_impl PluginHost for PluginContext from "../kernel")
(import [MemFs HtmlRender fs_provider render_provider] from "../seams")
(import [Profile] from "../profile")
(import [reporter_plugin] from "./common")
(import [agent_plugin command_plugin template_codegen_plugin] from "../agent")

(fn web_fs_plugin [] : Plugin
  (Plugin ^id "fs" ^provides ["HarnessFs"]
    ^contextual true
    ^activate (fn [] (fn [host]
      (host .PluginHost:provide "HarnessFs"
        (fs_provider (MemFs ^files {^notes "hello from memory"})))))))

(fn web_render_plugin [] : Plugin
  (Plugin ^id "render" ^provides ["HarnessRender"]
    ^contextual true
    ^activate (fn [] (fn [host]
      (host .PluginHost:provide "HarnessRender"
        (render_provider (HtmlRender)))))))

(fn web_profile [] : Profile
  # The same agent as `cli`, and no driver: this deployment is driven by
  # whatever calls it, not by a terminal. That the agent is the identical
  # plugin in both sets is the point — a prompt means the same thing here as it
  # does at the command line.
  (Profile ^name "web"
           ^plugins [(web_fs_plugin) (web_render_plugin) (reporter_plugin)
                     (command_plugin) (agent_plugin)
                     (template_codegen_plugin)]))
