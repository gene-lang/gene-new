# The `web` deployment: no filesystem, escaped HTML output.
#
#   gene run examples/gene-harness/src/main.gene web
#
# The mirror of `cli`. Same provider/reporter/agent plugins, two
# different providers — and because the filesystem provider is in-memory, this
# profile never touches the disk. A web deployment has no business reading the
# operator's disk, and here that is a fact about the binding rather than a rule
# someone has to remember.

(mod web)

(import [Plugin PluginContext PluginHost] ^from "../kernel")
(import_impl PluginHost for PluginContext ^from "../kernel")
(import [HarnessFs MemFs HtmlRender fs_provider render_provider] ^from "../seams")
(import [Profile] ^from "./profile")
(import [reporter_plugin] ^from "./common")
(import [agent_plugin command_plugin template_codegen_plugin] ^from "../agents/agent")
(import [code_command_plugin] ^from "../agents/code_command")

(fn web_fs_plugin [] : Plugin
  (Plugin ^id "fs" ^provides ["HarnessFs" ["tools" "fs.read"]]
    ^contextual true
    ^activate (fn [] (fn [host]
      (var fs (fs_provider (MemFs ^files {^notes "hello from memory"})))
      (host .PluginHost:provide "HarnessFs" fs)
      (host .PluginHost:contribute "tools"
        {^name "fs.read" ^doc "Read a file from the explicit memory demonstration."
         ^input_schema {^type "object" ^required ["path"] ^properties {^path {^type "string"}}}
         ^run (fn [input] {^path input/path ^text (fs .HarnessFs:read_text input/path) ^truncated false})})))))

(fn web_render_plugin [] : Plugin
  (Plugin ^id "render" ^provides ["HarnessRender"]
    ^contextual true
    ^activate (fn [] (fn [host]
      (host .PluginHost:provide "HarnessRender"
        (render_provider (HtmlRender)))))))

(fn web_profile [] : Profile
  # The same agent as `cli`, and no driver: this deployment is driven by
  # whatever calls it, not by a terminal. That the agent is the identical
  # plugin in both sets is the point — a prompt means the same thing here as it
  # does at the command line.
  (Profile ^name "web"
           ^plugins [(web_fs_plugin) (web_render_plugin) (reporter_plugin)
                     (command_plugin) (code_command_plugin) (agent_plugin)
                     (template_codegen_plugin)]))
