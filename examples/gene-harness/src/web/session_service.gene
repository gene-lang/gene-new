(import ^from "../profiles/registry" [workspace_profile])
(import ^from "../runtime/workspace_manager" [WorkspaceManagerChanged open_workspace_manager start_manager_polling])
(import ^from "../runtime/round_controller" ^^export
  [
    new_round_controller
    resume_answered_rounds
    submit_round
    round_receipt
    round_state
    answer_round
    cancel_round
    close_round_controller
    RoundError])
(import ^from "../runtime/sessions"
  [
    create_session
    :
    create_record
    list_sessions
    :
    session_records
    require_record
    update_session
    load_session])
(import ^from "../agents/provider_selection" [provider_choice select_provider])
(import ^from "../storage/state" [events_for])
(import ^from "./contract" [protocol_version history_page_limit])
(import ^from "../runtime/commands"
  [
    parse_submission
    submit_command
    command_receipt
    command_request_receipt
    command_state
    cancel_command])
(import ^from "../kernel"
  [
    rows
    contribute
    provide
    withdraw_seam
    HarnessEvent
    RoundChanged
    CommandChanged
    SessionChanged
    DurableRecord])
(import ^from "../runtime/composition" [acquire_snapshot release_snapshot current_snapshot])
(import ^from "../runtime/input_modes" [mode_state])
(import ^from "../kernel" [ModeChanged CompositionChanged CardChanged])
(import ^from "../runtime/cards" ^^export
  [card_records public_card card_action card_action_receipt check_card_command CardError])
(import ^from "../runtime/appearance" [AppearanceChanged appearance_mode])
(import ^from "../ui/state" [ui_status ui_data_revision])
(import ^from "../ui/views" [render_component])
(import ^from "../runtime/cordis_adapter" [spawn_composition_call])
(import ^from "../ui/components" [bounded_component_view WebComponentError])
(import ^from "../runtime/triggers" ^^export
  [
    open_trigger_manager
    close_trigger_manager
    list_triggers
    create_trigger
    delete_trigger
    list_occurrences])

(type WorkspaceService ^props {^runtime Any ^events Any ^sessions Any ^controller Any ^epoch Str ^publisher Any ^revision Any ^closed Any ^model_info Any ^offline Bool ^subscriptions Any ^snapshot_jobs Any ^snapshot_versions Any ^ui_audience Any? ^snapshot_audience Any?})

(fn public_session [service, record]
  (let copy ($thaw ($freeze record)))
  (copy .put "revision" ($to_str (?? record/revision 0)))
  # Match the sequence-1 round, not prompt text: later prompts may be identical.
  (copy .put "first_request_round"
    $"round-${($str/slice_bytes ($crypto/sha256 record/id) 0 16)}-1")
  (let loaded (load_session service/sessions record/id))
  # Older sessions have the prompt label but not its media in the index.
  (if_yes (&& (!= record/first_request "") ($absent? record/first_request_media))
    (for event in (events_for service/events "session" record/id)
      (if_yes (&& (== event/type "turn/request") (== event/payload/initial true)
        (== event/payload/round copy/first_request_round))
        (copy .put "first_request_media" (?? event/payload/media []))
        (break))))
  (copy .put "last_round" loaded/round/.get)
  copy)

(fn publish_message [service, kind : Str, session : Str, data, ^reason reason = nil]
  (let publisher service/publisher/.get)
  (if_not ($absent? publisher)
    (let message {^type kind ^session session ^data data})
    (if_not ($absent? reason) (message .put "reason" reason))
    (publisher message))
  nil)

(fn event_record [session : Str, event]
  (let payload event/payload)
  # Initial user bubbles exclude temporary request/prepare guidance. Keep the
  # full request for model input and subsequent diagnostic request records.
  (let text (?? payload/text (?? payload/full "")))
  {
    ^seq ($to_str event/seq)
    ^id $"${session}/${event/seq}"
    ^round_id (?? payload/round "")
    ^turn (?? payload/turn 0)
    ^role (if (== payload/initial true)
            "user"
            (if (== event/type "console")
              "log"
              "assistant"))
    ^kind event/type
    ^phase (if (== event/type "turn/response")
             "code"
             (if (== event/type "turn/end")
               "turn/error"
               event/type))
    ^order (?? payload/at_ms event/seq)
    ^text (if (== payload/initial true) (?? payload/settled text) text)
    ^media (?? payload/media [])
    ^late (== payload/late true)
    ^final (== payload/final true)
    ^patch_files (?? payload/patch_files [])
    ^blobs (?? payload/blobs {})
    ^^durable})

(fn publish_transcript [service, session : Str, event]
  (let kind event/type)
  (if (|| (["turn/response" "turn/request" "turn/patch"] .contains? kind) (&& (== kind "turn/end") (! ($absent? event/payload/text))))
    (publish_message service "turn" session (event_record session event)))
  (if (["reply" "console"] .contains? kind)
    (publish_message service kind session (event_record session event)))
  nil)

(fn command_input_record [session : Str, record]
  # Older receipts retain the parsed command, but not its original spelling.
  (let text (?? record/input_text
    ($to_str "/" record/name (if (== record/raw "") "" ($to_str " " record/raw)))))
  {^id $"${session}/${record/id}/input"
   ^seq ($to_str (?? record/start_seq 0)) ^round_id "" ^turn 0
   ^role "user" ^phase "prompt" ^kind "command/input"
   ^text text ^order (?? record/started_ms 0) ^^durable})

(fn queue_snapshot [service, session : Str]
  (if service/closed/.get (return nil))
  (if ($absent? service/publisher/.get) (return nil))
  (if (&& (! ($absent? service/snapshot_audience)) (! (service/snapshot_audience session)))
    (return nil))
  (let id ($crypto/random_hex 8))
  (let versions service/snapshot_versions/.get)
  (let version (+ (?? (versions .get session) 0) 1))
  (versions .put session version)
  (let slot ($cell nil))
  (service/snapshot_jobs/.get .put id slot)
  (let job
    (spawn ^lane root (try (if_not service/closed/.get ($runtime/with_context nil (fn [] (let safe (if ($absent? service/ui_audience) false (! (service/ui_audience)))) (let data (snapshot ^safe safe service session)) (if (&& (! service/closed/.get) (== (service/snapshot_versions/.get .get session) version)) (publish_message service "snapshot" session data))))) catch Any (if_not service/closed/.get (publish_message service "error" session {^message ($to_str $err/message)})) ensure (service/snapshot_jobs/.get .delete id))))
  (slot .set job)
  nil)

(fn handle_harness_event [service, event]
  (match ^!exhaustive event
    (when (changed : ModeChanged)
      (publish_message ^reason changed/reason service "mode/state" changed/session changed/mode))
    (when (changed : CompositionChanged)
      (publish_message service "ui/state" "" (ui_status service/runtime/h)))
    (when (changed : CardChanged)
      (publish_message service "card" changed/session {^card changed/card ^event changed/event}))
    (when (changed : WorkspaceManagerChanged)
      (publish_message service "ui/state" "" (ui_status service/runtime/h)))
    (when (changed : AppearanceChanged)
      (publish_message service "appearance" "" {^mode changed/mode}))
    (when (record : DurableRecord)
      (if (&& (== record/scope "workspace")
              (|| (== record/name "plugin/state") (== record/envelope/origin "plugin")))
        (publish_message service "ui/state" "" (ui_status service/runtime/h)))
      (if (== record/scope "session") (publish_transcript service record/stream record/envelope)))
    (when (changed : RoundChanged)
      (publish_message service "round/state" changed/session changed/receipt)
      (if (== changed/receipt/state "waiting")
        (publish_message service "questions" changed/session changed/receipt/questions))
      (queue_snapshot service changed/session))
    (when (changed : SessionChanged)
      (publish_message service "session/list" "" (list_sessions service))
      (publish_message
        service
        "attention"
        ""
        {^sessions (session_records ^^attention service/sessions)}))
    (when (changed : CommandChanged)
      (let record changed/record)
      (let session changed/session)
      (if_yes (== record/ui_action true)
        (publish_message service "ui/action" "" {^session session ^record record})
        (return nil))
      (if (&& (! ($absent? record/raw)) ($absent? record/mode_instance))
        (publish_message service "turn" session (command_input_record session record)))
      (if (&& (!= record/name "sh") (! ($absent? record/text)))
        (publish_message
          service
          "console"
          session
          {
            ^id $"${session}/${record/id}/console"
            ^seq "0"
            ^round_id ""
            ^turn 0
            ^role "log"
            ^phase "console"
            ^kind "console"
            ^text record/output
            ^!late
            ^!durable})
        (publish_message service "command" session record))
      (if ($absent? record/text) (queue_snapshot service session))))
  nil)

(fn open_session_service [^workspace workspace : Str = "", ^offline offline : Bool = false, ^profile supplied_profile = nil, ^ownership ownership = nil, ^managed managed : Bool = false]
  (let canonical (prepare_workspace_root ^root workspace))
  (let profile (workspace_profile ^base supplied_profile ^offline offline canonical))
  (let runtime
    (open_runtime ^ownership ownership ^managed managed ^event_scope "workspace" ^entry ($path/join ($path/parent this_mod/.path) "server.gene")
      canonical
      "default"
      profile))
  (contribute
    runtime/h
    "web"
    "prompt"
    {
      ^name "web_components"
      ^text "This session has a browser frontend. Discover UI capabilities and start with (doc \"harness/ui\") to customize its workspace. Verify the browser as well as server previews."})
  (let settings ($serde/read_data ($fs/read_text $"${runtime/state_root}/config.gene")))
  (let model_info
    (try
      (let selected (select_provider runtime settings))
      {^provider selected/name ^model selected/settings/model ^effort selected/settings/effort}
    catch Any
      (let choice (provider_choice runtime settings))
      {^provider choice/name ^model "Unavailable" ^effort ""}))
  (let service
    (WorkspaceService ^runtime runtime ^events runtime/events ^sessions runtime/sessions ^controller nil ^epoch ($crypto/random_hex 16) ^publisher ($cell nil) ^revision ($atomic_cell 0) ^closed ($cell false) ^model_info model_info ^offline offline ^subscriptions [] ^snapshot_jobs ($cell {}) ^snapshot_versions ($cell {})))
  (runtime/h/notifications/observer .set
    (fn [kind, data]
      (let copy ($thaw ($freeze data)))
      (copy .put "epoch" service/epoch)
      (publish_message service kind "" copy)))
  (runtime/actions/log/observer .set
    (fn [record, metadata]
      (publish_message service "ui/action" "" {^record record ^actions metadata})))
  (set service/controller (new_round_controller runtime))
  # Recovery recorded answered batches whose continuation never started.
  (resume_answered_rounds service/controller)
  (service/subscriptions .push
    (runtime/h/bus .subscribe HarnessEvent (fn [event] (handle_harness_event service event))))
  # Runtime-owned observation must not inherit a plugin activation's callback
  # budget or stop when the manager view is replaced.
  (if (== profile/name "manager")
    (start_manager_polling (open_workspace_manager runtime)))
  (provide
    runtime/h
    "core"
    "loop"
    (fn []
      {^runtime runtime ^controller service/controller ^^start ^^boot}))
  service)

(fn list_sessions [service, ^after after : Str = "", ^limit limit : Int = 100, ^kind kind = nil, ^status status = nil, ^attention attention = nil, ^trigger trigger = nil, ^q q : Str = "", ^since since : Str = "", ^until until : Str = ""]
  (let results [])
  (for record in (session_records ^kind kind ^status status ^attention attention ^trigger trigger ^q q ^since since ^until until service/sessions)
    (if (&& (!= after "") (<= ($order/compare record/id after) 0)) (continue))
    (if (>= results/.size limit) (break))
    (results .push record))
  {^sessions results ^needs_attention (session_records ^^attention service/sessions) ^next ""})

(fn create_session [service, ^title title : Str = "New conversation"]
  (let record (create_record ^title title service/sessions))
  (public_session service record))

(fn rename_session [service, id : Str, title : Str, revision : Int]
  (edit_session service id {^title title} revision))

(fn edit_session [service, id : Str, changes, revision : Int]
  (let record (require_record service/sessions id))
  (if (!= (?? record/revision 0) revision)
    (fail
      (RoundError ^code "revision_conflict" ^message "Session changed; refresh before editing it.")))
  (let update {^revision (+ revision 1)})
  (if_not ($absent? changes/title)
    (if (|| (!= ($head changes/title) Str) (== ($str/trim changes/title) "") (> ($str/byte_size changes/title) 256))
      (fail (RoundError ^code "invalid_request" ^message "Session title must have 1–256 bytes")))
    (update .put "title" ($str/trim changes/title)))
  (if_not ($absent? changes/pinned)
    (if (!= ($head changes/pinned) Bool)
      (fail (RoundError ^code "invalid_request" ^message "Pinned must be boolean")))
    (update .put "pinned" changes/pinned))
  (let next (update_session service/sessions id update))
  (public_session service next))

(fn acknowledge_attention [service, id : Str]
  (let record (require_record service/sessions id))
  (if record/attention (update_session service/sessions id {^!attention}))
  {^^ok})

(fn submit [service, session : Str, request_id : Str, sequence : Int, text : Str, ^media media = [], ^card card = nil]
  (if_not (== ($head media) List)
    (fail (RoundError ^code "invalid_request" ^message "Attachments must be a list of media IDs.")))
  # A card send is always a chat message, never a slash command.
  (if_not ($absent? card)
    (return (submit_round ^media media ^card card service/controller session request_id sequence text)))
  (let parsed (parse_submission service/runtime/h text))
  (if (&& (== parsed/kind "command") (! media/.empty?))
    (fail (RoundError ^code "invalid_request" ^message "Attachments accompany chat messages, not slash commands.")))
  (if (== parsed/kind "command")
    (submit_command service/runtime/commands session text)
    (submit_round ^media media service/controller session request_id sequence parsed/text)))
(fn command [service, session : Str, text : Str, ^request_id request_id : Str = "", ^sequence sequence = nil, ^card card = nil]
  # A card's command button names the card revisions behind the clicked tree.
  (if_not ($absent? card) (check_card_command service/runtime session card text))
  (submit_command ^request_id request_id ^sequence sequence service/runtime/commands session text))

(fn session_card_action [service, session : Str, card : Str, request]
  (require_record service/sessions session)
  (let copy ($thaw ($freeze request)))
  (copy .put "card" card)
  (card_action service/runtime session copy))

(fn session_card_receipt [service, session : Str, input_id : Str]
  (card_action_receipt service/runtime session input_id))

(fn card_block [session : Str, card]
  {^id $"${session}/card/${card/id}" ^seq ($to_str (?? card/created_seq 0))
   ^round_id (?? card/placement_round "") ^turn (?? card/turn 0)
   ^role "assistant" ^phase "card" ^kind "card" ^text ""
   ^card (public_card card) ^order (?? card/created_ms 0) ^^durable})

(fn question_view? [batch] : Bool
  (for question in (?? batch/questions [])
    (if_not ($absent? (?? question/view nil)) (return true)))
  false)

(fn operator_receipt [service, session : Str, id : Str]
  (require_record service/sessions session)
  (let result (command_receipt service/runtime/commands session id))
  (if ($absent? result)
    (fail (RoundError ^code "not_found" ^message "Command receipt is not retained.")))
  result)

(fn request_receipt [service, session : Str, request_id : Str, kind : Str]
  (require_record service/sessions session)
  (if_yes (== kind "command")
    (let result (command_request_receipt service/runtime/commands session request_id))
    (if_not ($absent? result) (return result)))
  (if (== kind "round")
    (for record in ((Path "receipts") (round_state service/controller session))
      (if (== record/request_id request_id) (return record))))
  (fail
    (RoundError ^code "not_found" ^message "Request receipt is not retained; do not replay an uncertain operation.")))
(fn cancel_operator_command [service, session : Str, id : Str]
  (cancel_command service/runtime/commands session id))
(fn receipt [service, session : Str, id : Str]
  (require_record service/sessions session)
  (let result (round_receipt service/controller session id))
  (if ($absent? result)
    (fail (RoundError ^code "not_found" ^message "Round receipt is not retained.")))
  result)
(fn answer [service, session : Str, batch_id : Str, values, ^dismiss dismiss : Bool = false]
  (answer_round ^dismiss dismiss service/controller session batch_id values))
(fn cancel [service, session : Str, id : Str]
  (cancel_round service/controller session id))

(fn snapshot [service, id : Str, ^after after : Int = -1, ^before before : Int = -1, ^safe safe : Bool = false]
  (let metadata (require_record service/sessions id))
  (let loaded (load_session service/sessions id))
  (let records [])
  (var cursor 0)
  (for event in (events_for service/events "session" id)
    (set cursor event/seq)
    (if (&& (>= after 0) (<= event/seq after)) (continue))
    (if (&& (>= before 0) (>= event/seq before)) (continue))
    (if (|| (["turn/response" "turn/request" "turn/patch" "reply" "console"] .contains? event/type) (&& (== event/type "turn/end") (! ($absent? event/payload/text))))
      (records .push (event_record id event)))
    # A later definition of a card shows a short line where it happened.
    (if_yes (== event/type "card/state")
      (let card event/payload/state)
      (if (&& (! ($absent? card)) (== card/origin "model") (!= card/updated_turn card/turn))
        (records .push
          {^id $"${id}/card-update/${card/id}/${card/definition_revision}" ^seq ($to_str event/seq)
           ^round_id (?? card/round "") ^turn card/updated_turn ^role "assistant"
           ^phase "card/update" ^kind "card/update" ^text card/title ^card_id card/id
           ^order (?? card/updated_ms event/seq) ^^durable})))
    # Answered questions with views stay in the transcript, read-only.
    (if_yes (== event/type "question/answered")
      (let batch event/payload/state)
      (if (&& (! ($absent? batch)) (question_view? batch))
        (records .push
          {^id $"${id}/questions/${batch/id}" ^seq ($to_str event/seq)
           ^round_id (?? batch/round "") ^turn (?? batch/turn 0) ^role "assistant"
           ^phase "questions" ^kind "questions" ^text ""
           ^batch {^id batch/id ^questions batch/questions ^answers batch/answers
                   ^intent (?? batch/intent "continue")}
           ^order (?? batch/answered_ms event/seq) ^^durable}))))
  (for card in (card_records service/runtime id)
    (let seq (?? card/created_seq 0))
    (if (&& (>= after 0) (<= seq after)) (continue))
    (if (&& (>= before 0) (>= seq before)) (continue))
    (records .push (card_block id card)))
  (let commands (command_state service/runtime id))
  (for record in commands/records
    (if (== record/ui_action true) (continue))
    (let seq (?? record/start_seq 0))
    (if (&& (>= after 0) (<= seq after)) (continue))
    (if (&& (>= before 0) (>= seq before)) (continue))
    (if ($absent? record/mode_instance)
      (records .push (command_input_record id record)))
    (if_yes (&& (!= record/name "sh") (!= (?? record/output "") ""))
      (records .push
        {
          ^id $"${id}/${record/id}/console"
          ^seq ($to_str seq)
          ^round_id ""
          ^turn 0
          ^role "log"
          ^phase "console"
          ^kind "console"
          ^text record/output
          ^!late
          ^order (?? record/started_ms 0)
          ^^durable}))
    (records .push
      {
        ^id $"${id}/${record/id}"
        ^seq ($to_str seq)
        ^round_id ""
        ^turn 0
        ^role "assistant"
        ^phase "command"
        ^kind "command"
        ^command_id record/id
        ^input_id (?? record/input_id nil)
        ^mode_instance (?? record/mode_instance nil)
        ^name record/name
        ^raw record/raw
        ^text (?? record/display record/output)
        ^status record/status
        ^view (?? record/view nil)
        ^order (?? record/started_ms 0)
        ^^durable}))
  (let rounds (round_state service/controller id))
  (let ordered ($order/sort_by records (fn [record] (?? record/order 0))))
  (let page [])
  (var start ($math/max 0 (- ordered/.size history_page_limit)))
  # A command's input and output share one cursor. Keep them on the same
  # page so the exclusive "before" cursor cannot skip its input.
  (while (> start 0)
    (let previous (- start 1))
    (if (!= ordered/%previous/seq ordered/%start/seq) (break))
    (set start previous))
  (var i 0)
  (for record in ordered
    (if (>= i start) (page .push record))
    (set i (+ i 1)))
  {
    ^protocol protocol_version
    ^session (public_session service metadata)
    ^records page
    ^cursor ($to_str cursor)
    ^preview []
    ^has_older (> start 0)
    ^rounds rounds/receipts
    ^next_command_seq ($to_str commands/next_id)
    ^next_submission_seq ($to_str rounds/next_seq)
    ^round loaded/round/.get
    ^mode (mode_state service/runtime/modes id)
    ^status (host_status ^session id ^safe safe service)
    ^questions (if (== metadata/status "waiting")
                 ((Path "questions") loaded/round/.get)
                 nil)})

(fn web_components [service, session : Str]
  (let metadata (if (== session "") nil (require_record service/sessions session)))
  (let loaded (if (== session "") nil (load_session service/sessions session)))
  (let context
    ($freeze
      {
        ^session_id session
        ^session metadata
        ^round (if ($absent? loaded)
                 nil
                 loaded/round/.get)
        ^workspace service/runtime/root
        ^model service/model_info
        ^sessions (session_records service/sessions)}))
  (let components [])
  (for candidate in (rows service/runtime/h "web_components")
    (if_not ($absent? candidate/view_state) (continue))
    (let item {^name candidate/name ^slot candidate/slot})
    (if_not ($absent? candidate/style_css)
      (item .put "style" candidate/style_css)
      (item .put "style_class" candidate/style_class))
    (try
      (let view
        (if ($absent? candidate/render)
          candidate/view
          (render_component ^sidebar (== candidate/slot "conversation_sidebar")
            service/runtime/h candidate/render context)))
      (item .put "view" view)
    catch Any
      (item .put "error" $err/message))
    (components .push item))
  components)

(fn host_status [service, ^session session : Str = "", ^safe safe : Bool = false]
  (let lease (acquire_snapshot service/runtime/h/snapshots))
  (try
    ($runtime/with_context
      {^composition service/runtime/h/snapshots ^snapshot lease/snapshot ^session session}
      (fn []
        (host_status_in_snapshot ^safe safe service session)))
  ensure
    (release_snapshot service/runtime/h/snapshots lease)))

(fn next_status_sequence [service]
  (loop
    (let current service/revision/.load)
    (if (service/revision .compare_exchange current (+ current 1)) (return current))))

(fn host_status_in_snapshot [service, session : Str, ^safe safe : Bool = false]
  # Capture freshness before callbacks can park. A render begun before a state
  # change must not be stamped with the revision current at its completion.
  (let composition (current_snapshot service/runtime/h/snapshots))
  (let status_revision (ui_data_revision service/runtime/h composition))
  (let status_sequence (next_status_sequence service))
  (let active service/controller/active/.get)
  (let commands [])
  (for row in (rows service/runtime/h "commands")
    (commands .push {^name row/name ^usage row/usage ^doc row/doc}))
  (let plugins [])
  (for plugin in composition/plugins
    (plugins .push {^id plugin/id ^state plugin/status}))
  {
    ^protocol protocol_version
    ^epoch service/epoch
    ^status_session session
    ^status_revision status_revision
    ^status_sequence ($to_str status_sequence)
    ^model service/model_info
    ^profile service/runtime/profile/name
    ^appearance (appearance_mode service/runtime/h)
    ^readiness (if ($absent? service/runtime/h/readiness)
      nil (service/runtime/h/readiness))
    ^plugins plugins
    ^web_components (if safe [] (web_components service session))
    ^ui (if safe nil (ui_status service/runtime/h))
    ^commands commands
    ^offline service/offline
    ^workspace service/runtime/root
    ^running ($size active)})

(fn close_session_service [service]
  (if (service/closed .swap true) (return nil))
  (service/runtime/h/notifications/observer .set nil)
  (service/runtime/actions/log/observer .set nil)
  (for subscription in service/subscriptions
    subscription/.cancel)
  (let jobs (service/snapshot_jobs .swap {}))
  (for [id slot] in jobs
    (while ($absent? slot/.get)
      ($sleep 1))
    (let job slot/.get)
    job/.cancel)
  (for [id slot] in jobs
    (let job slot/.get)
    job/.join)
  (withdraw_seam service/runtime/h "core" "loop")
  (if_not ($absent? service/runtime/triggers) (close_trigger_manager service/runtime/triggers))
  (close_round_controller service/controller)
  (close_runtime service/runtime))
