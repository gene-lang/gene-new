(type WorkspaceService ^props {^runtime Any ^epoch Str ^publisher Any ^revision Any ^closed Any ^offline Bool ^snapshot_jobs Any ^snapshot_versions Any ^browser_requests Any ^ui_audience Any? ^snapshot_audience Any? ^lifecycle Any? ^clients Any? ^client_requests Any?})

(fn current_model_info [service, session : Str = ""]
  (let metadata (if (== session "") (then nil) (else (require_record service/runtime/sessions session))))
  (let loaded (if (== session "") (then nil) (else (load_session service/runtime/sessions session))))
  (let round (if ($present? loaded) (then loaded/round/.get) (else nil)))
  (selection_view ^metadata metadata ^round round service/runtime (effective_config service/runtime)))

(fn model_catalog [service]
  (let contribution (row service/runtime/h "seams" "models/catalog"))
  (if ($absent? contribution)
    (fail (ServiceError ^code "unavailable" ^message "The Models contribution is disabled or unavailable.")))
  (contribution/value/snapshot))

(fn refresh_models [service]
  (let contribution (row service/runtime/h "seams" "models/catalog"))
  (if ($absent? contribution)
    (fail (ServiceError ^code "unavailable" ^message "The Models contribution is disabled or unavailable.")))
  (contribution/value/refresh))

(fn model_configuration [service]
  (let contribution (row service/runtime/h "seams" "models/catalog"))
  (if ($absent? contribution)
    (fail (ServiceError ^code "unavailable" ^message "The Models contribution is disabled or unavailable.")))
  (contribution/value/configuration))

(fn save_model_configuration [service, config, expected : Str]
  (let contribution (row service/runtime/h "seams" "models/catalog"))
  (if ($absent? contribution)
    (fail (ServiceError ^code "unavailable" ^message "The Models contribution is disabled or unavailable.")))
  (contribution/value/save config expected)
  (model_configuration service))

(fn model_login [service, action : Str, value : Str, ^account account = nil]
  (let contribution (row service/runtime/h "seams" "models/catalog"))
  (if ($absent? contribution)
    (fail (ServiceError ^code "unavailable" ^message "The Models contribution is disabled or unavailable.")))
  (match action
    (when "connect" (contribution/value/connect value account))
    (when "status" (contribution/value/login_status value))
    (when "cancel" (contribution/value/cancel_login value))
    (else (fail (ServiceError ^code "invalid_request" ^message "Unknown sign-in action.")))))

(fn model_accounts [service, ^action action = nil, ^id id = nil]
  (let contribution (row service/runtime/h "seams" "models/catalog"))
  (if ($absent? contribution)
    (fail (ServiceError ^code "unavailable" ^message "The Models contribution is disabled or unavailable.")))
  (if ($absent? action)
    (then (contribution/value/accounts))
    (else (contribution/value/account_action id action))))

(fn model_login_callback [service, params]
  (let contribution (row service/runtime/h "seams" "models/catalog"))
  (if ($absent? contribution)
    (return {^status 400 ^message "The Models contribution is unavailable. Return to Gene Harness."}))
  (contribution/value/login_callback params))

(fn model_page [service, appearance : Str, styles : Str]
  (let lease (acquire_snapshot ^label "web/models page" service/runtime/h/snapshots))
  (try
    ($runtime/with_context {^composition service/runtime/h/snapshots ^snapshot lease/snapshot}
      (fn []
        (let contribution (row service/runtime/h "seams" "models/page"))
        (if ($absent? contribution)
          (fail (ServiceError ^code "unavailable" ^message "The Models contribution is disabled or unavailable.")))
        (contribution/value appearance service/runtime/root styles)))
  ensure (release_snapshot service/runtime/h/snapshots lease)))

(fn preview_model_settings [service, session : Str, selection]
  (let contribution (row service/runtime/h "seams" "models/catalog"))
  (if ($absent? contribution)
    (fail (ServiceError ^code "unavailable" ^message "The Models contribution is disabled or unavailable.")))
  (contribution/value/preview session selection))

(fn set_model_default [service, selection, expected : Str]
  (let contribution (row service/runtime/h "seams" "models/catalog"))
  (if ($absent? contribution)
    (fail (ServiceError ^code "unavailable" ^message "The Models contribution is disabled or unavailable.")))
  (let state (contribution/value/set_default selection expected))
  {^^ok ^revision state/id ^digest state/digest ^default state/default})

(fn public_session [service, record]
  (let copy ($thaw ($freeze record)))
  (copy .put "slack_available" (&& ($present? service/runtime/services/values/channels) (sharing_available? service/runtime)))
  (copy .put "revision" ($to_str (?? record/revision 0)))
  # Match the sequence-1 round, not prompt text: later prompts may be identical.
  (copy .put "first_request_round"
    $"round-${($str/slice_bytes ($crypto/sha256 record/id) 0 16)}-1")
  (let loaded (load_session service/runtime/sessions record/id))
  (copy .put "first_request_speaker" "Request")
  (for round in (/receipts (round_state service/runtime/services/values/controller record/id))
    (if (== round/id copy/first_request_round)
      (copy .put "first_request_speaker" (initiating_label round {}))))
  (let shown (public_round service record/id loaded/round/.get))
  (copy .put "last_round" shown)
  (if (== shown/state "paused") (copy .put "status" "paused"))
  (if_not ($absent? record/parent)
    (let owner (service/runtime/sessions/index/.get .get record/parent/session))
    (copy .put "parent_title" (?? owner/title record/parent/session)))
  copy)

(fn session_slack_thread [service, id : Str] : Str
  (let record (require_record service/runtime/sessions id))
  (if ($absent? service/runtime/services/values/channels)
    (fail (RoundError ^code "unavailable" ^message "Slack is unavailable in recovery mode.")))
  (if (|| ($absent? record/channel) (!= record/channel/transport "slack"))
    (fail (RoundError ^code "not_found" ^message "This session is not linked to Slack.")))
  (let result (thread_link service/runtime/services/values/channels record/channel))
  (if (== result/url "")
    (fail (RoundError ^code "unavailable" ^message "The Slack thread link is temporarily unavailable.")))
  result/url)

(fn session_add_to_slack [service, id : Str, revision : Int]
  (if ($absent? service/runtime/services/values/channels)
    (fail (RoundError ^code "unavailable" ^message "Slack is unavailable in recovery mode.")))
  (public_session service (share_session service/runtime/services/values/channels id revision)))

(fn publish_message [service, kind : Str, session : Str, data, ^reason reason = nil]
  (let publisher service/publisher/.get)
  (if_not ($absent? publisher)
    (let message {^type kind ^session session ^data data})
    (if_not ($absent? reason) (message .put "reason" reason))
    (publisher message))
  nil)

(fn event_record [session : Str, event]
  (let payload event/payload)
  # Initial user bubbles exclude temporary request/prepare guidance. Keep the
  # full request for model input and subsequent diagnostic request records.
  (let text (?? payload/text (?? payload/full "")))
  {
    ^seq ($to_str event/seq)
    ^id $"${session}/${event/seq}"
    ^round_id (?? payload/round "")
    ^turn (?? payload/turn 0)
    ^role (if (== payload/initial true)
      (then "user")
      (elif (== event/type "console") "log")
      (else "assistant"))
    ^kind event/type
    ^phase (if (== event/type "turn/response")
      (then "code")
      (elif (&& (== event/type "turn/end") ($present? payload/text)) "turn/error")
      (else event/type))
    ^order (?? payload/at_ms event/seq)
    ^text (if (== payload/initial true) (?? payload/settled text) text)
    ^audio_reply (?? payload/audio_reply nil)
    ^speech (if (== event/type "reply") (?? payload/audio_reply (speech_text text)) "")
    ^media (?? payload/media [])
    ^late (== payload/late true)
    ^final (== payload/final true)
    ^patch_files (?? payload/patch_files [])
    ^blobs (?? payload/blobs {})
    ^for_turn (?? payload/for_turn nil) ^combine (?? payload/combine nil)
    ^continued_from (?? payload/continued_from nil) ^source_turn (?? payload/source_turn nil)
    ^delegation (== payload/delegation true) ^answers (== payload/answers true)
    ^initial (== payload/initial true) ^initiator (?? payload/initiator nil)
    ^input (?? payload/input nil)
    ^answer_source (?? payload/answer_source nil)
    ^card (?? payload/card nil) ^reply_hint (?? payload/reply_hint nil)
    ^reason (?? payload/reason nil) ^synthetic (== payload/synthetic true)
    ^at_limit (== payload/at_limit true)
    ^task_turns (?? payload/task_turns nil) ^task_root (?? payload/task_root nil)
    ^continuation_mode (?? payload/continuation_mode nil)
    ^patch_result (?? payload/result nil)
    ^^durable})

(fn browser_request [service, session : Str, event]
  (let record (event_record session event))
  (let cache service/browser_requests/.get)
  (let prior (cache .get session))
  (if_yes (&& (== record/role "user")
    (> (?? record/for_turn 0) 0) ($present? record/initiator)
    (! ($str/starts_with? (?? record/initiator "") "continue:")))
    (record .put "speaker" (initiating_label nil record))
    (cache .put session record)
    (return record))
  (let receiver (?? record/for_turn 0))
  (if_yes (> receiver 0)
    (if (== record/at_limit true) (return nil))
    (let same_owner (&& (== prior/round_id record/round_id) (== prior/turn receiver)
      (== prior/role "assistant")))
    # Current writers declare their receiving turn and combination. Keep only
    # the latest live request per active session; cold appends rebuild
    # provenance once from the durable stream.
    (if_yes (&& ($present? prior) (== prior/round_id record/round_id)
      (> event/seq ($parse/parse_int prior/seq))
      (|| (== record/combine "replace") (&& (== record/combine "append") same_owner)))
      (let projected (project_request record receiver (if same_owner prior nil)))
      (cache .put session projected)
      (return projected)))
  (let records [])
  (for source in (events_for service/runtime/events "session" session)
    (if (["turn/request" "turn/start" "turn/end"] .contains? source/type)
      (records .push (event_record session source))))
  (let rounds (round_state service/runtime/services/values/controller session))
  (let projected (project_conversation records rounds/receipts))
  (let id $"${session}/${event/seq}")
  (for record in projected
    (if_yes (|| (== record/id id)
      (&& ($present? record/source_ids) (record/source_ids .contains? id)))
      (cache .put session record) (return record)))
  nil)

(fn publish_transcript [service, session : Str, event]
  (let kind event/type)
  (if (&& (== kind "reply") (== event/payload/synthetic true))
    (do (queue_snapshot service session) (return nil)))
  (if_yes (== kind "delegation/state")
    (let data event/payload/state/record)
    (if_not ($absent? data)
      (if (== data/created_seq 0) (data .put "created_seq" event/seq))
      (publish_message service "delegation" session (delegation_block session data)))
    (queue_snapshot service session))
  (if (== kind "turn/request")
    (do (let request (browser_request service session event))
      (if_not ($absent? request) (publish_message service "turn" session request))))
  (if (["turn/response" "turn/start" "turn/end" "turn/patch"] .contains? kind)
    (publish_message service "turn" session (event_record session event)))
  (if (["reply" "console"] .contains? kind)
    (publish_message service kind session (event_record session event)))
  (if_yes (&& (== kind "reply") (== event/payload/final true)
              ($absent? event/payload/audio_reply)
              (voice_output? service/runtime/services/values/voice session)
              (speech_needs_audio_reply? (?? event/payload/text "")))
    (try
      (append_core_event service/runtime/events "session" session
        {^type "trace" ^kind "voice/audio_reply_missing"
         ^text "voice/audio_reply_missing" ^round event/payload/round ^^ignorable})
    catch Any nil))
  nil)

(fn command_input_record [session : Str, record]
  # Older receipts retain the parsed command, but not its original spelling.
  (let mode_input ($present? record/mode_instance))
  (let text (if mode_input record/raw (?? record/input_text
    ($to_str "/" record/name (if (== record/raw "") "" ($to_str " " record/raw))))))
  {^id $"${session}/${record/id}/input"
   ^seq ($to_str (?? record/start_seq 0)) ^round_id "" ^turn 0
   ^role "user" ^phase "prompt" ^kind "command/input"
   ^speaker "User"
   ^text text ^order (?? record/started_ms 0) ^^durable})

(fn command_display [record]
  (if_not (["sh" "run" "repl"] .contains? record/name)
    (return (?? record/display "")))
  (if (== record/status "running") (return ""))
  (if (== record/status "cancelled") (return "Stopped."))
  # The bounded item keeps only the value, including for older receipts whose
  # display field still includes a command echo and diagnostic id.
  (?? record/item/value (?? record/display "")))

(fn public_command [record]
  (let result ($thaw ($freeze_shallow record)))
  (result .put "display" (command_display record))
  result)

(fn snapshot_job_current? [service, session : Str, version : Int] : Bool
  (&& (! service/closed/.get)
      (== (service/snapshot_versions/.get .get session) version)
      ($present? (service/runtime/sessions/index/.get .get session))))

(fn queue_snapshot [service, session : Str]
  (if service/closed/.get (return nil))
  (if ($absent? service/publisher/.get) (return nil))
  (if (&& ($present? service/snapshot_audience) (! (service/snapshot_audience session)))
    (return nil))
  (let id ($crypto/random_hex 8))
  (let versions service/snapshot_versions/.get)
  (let version (+ (?? (versions .get session) 0) 1))
  (versions .put session version)
  (let slot ($cell nil))
  (service/snapshot_jobs/.get .put id slot)
  (let job
    (spawn ^lane root
      (try
        (if (snapshot_job_current? service session version)
          ($runtime/with_context nil (fn []
            (let safe (if ($absent? service/ui_audience) false (! (service/ui_audience))))
            (let data (snapshot ^!console ^safe safe service session))
            (if (snapshot_job_current? service session version)
              (publish_message service "snapshot" session data)))))
      catch Any
        (if (snapshot_job_current? service session version)
          (publish_message service "error" session {^message ($to_str $err/message)}))
      ensure (service/snapshot_jobs/.get .delete id))))
  (slot .set job)
  nil)

(fn handle_harness_event [service, event]
  (match ^!exhaustive event
    (when (changed : VoiceChanged)
      (publish_message service "voice/state" "" (public_voice_state changed/state)))
    (when (changed : ModelCatalogChanged)
      (try
        (let active (model_catalog service))
        (if (== active/id changed/revision)
          (publish_message service "models/catalog" "" {^revision changed/revision}))
      catch Any nil))
    (when (changed : ModeChanged)
      (publish_message ^reason changed/reason service "mode/state" changed/session changed/mode))
    (when (changed : CompositionChanged)
      (publish_message service "ui/state" "" (ui_status service/runtime)))
    (when (changed : CardChanged)
      (publish_message service "card" changed/session {^card changed/card ^event changed/event}))
    (when (changed : WorkspaceManagerChanged)
      (publish_message service "ui/state" "" (ui_status service/runtime)))
    (when (changed : AppearanceChanged)
      (publish_message service "appearance" "" {^mode changed/mode}))
    (when (changed : SettingsChanged)
      (publish_message service "settings/changed" ""
        {^scope changed/scope ^digest changed/digest ^keys changed/keys})
      (publish_message service "ui/state" "" (ui_status service/runtime)))
    (when (record : DurableRecord)
      (if (&& (== record/name "trace") (== record/envelope/payload/kind "channel/status"))
        (queue_snapshot service record/stream))
      (if (&& (== record/scope "workspace")
              (|| (== record/name "plugin/state") (== record/envelope/origin "plugin")))
        (publish_message service "ui/state" "" (ui_status service/runtime)))
      (if (== record/scope "session") (publish_transcript service record/stream record/envelope)))
    (when (changed : RoundChanged)
      (if (["done" "failed" "paused" "cancelled" "interrupted" "recovery_required"] .contains? changed/receipt/state)
        (service/browser_requests/.get .delete changed/session))
      (publish_message service "round/state" changed/session (public_round service changed/session changed/receipt))
      (if (== changed/receipt/state "waiting")
        (publish_message service "questions" changed/session changed/receipt/questions))
      (queue_snapshot service changed/session))
    (when (changed : SessionChanged)
      (if (== changed/record/deleted true)
        (then
          (let versions service/snapshot_versions/.get)
          (versions .put changed/record/id (+ (?? (versions .get changed/record/id) 0) 1))
          (publish_message service "session/deleted" "" {^id changed/record/id})))
      (publish_message service "session/list" "" (list_sessions service))
      (publish_message
        service
        "attention"
        ""
        {^sessions (session_records ^^attention service/runtime/sessions)}))
    (when (changed : CommandChanged)
      (let record changed/record)
      (let session changed/session)
      (if_yes (== record/ui_action true)
        (publish_message service "ui/action" "" {^session session ^record record})
        (return nil))
      (if ($present? record/raw)
        (publish_message service "turn" session (command_input_record session record)))
      (if ($present? record/text)
        (publish_message
          service
          "console"
          session
          {
            ^id $"${session}/${record/id}/console"
            ^command_id record/id ^^cumulative
            ^seq "0"
            ^round_id ""
            ^turn 0
            ^role "log"
            ^phase "console"
            ^kind "console"
            ^text record/output
            ^!late
            ^!durable})
        (publish_message service "command" session (public_command record)))
      (if ($absent? record/text) (queue_snapshot service session))))
  nil)

(fn open_session_service [^workspace workspace : Str = "", ^offline offline : Bool = false, ^profile supplied_profile = nil, ^ownership ownership = nil, ^managed managed : Bool = false, ^channel_options channel_options = nil, ^service_event service_event = nil, ^launch launch = nil]
  (let canonical (prepare_workspace_root ^root workspace))
  (let profile (workspace_profile ^base supplied_profile ^offline offline ^models_root launch/root canonical))
  (let runtime
    (open_runtime ^ownership ownership ^managed managed ^launch launch ^event_scope "workspace" ^entry ($path/join ($path/parent this_mod/.path) "server.gene")
      ^objects (fn [opened] (install_host_objects opened launch))
      canonical
      "default"
      profile))
  (var service nil)
  (try
  (contribute
    runtime/h
    "web"
    "prompt"
    {
      ^name "web_components"
      ^text "This session has a browser frontend. Discover UI capabilities and start with (doc \"harness/ui\") to customize its workspace. Verify the browser as well as server previews."})
  (set service
    (WorkspaceService ^runtime runtime ^epoch ($crypto/random_hex 16) ^publisher ($cell nil) ^revision ($atomic_cell 0) ^closed ($cell false) ^offline offline ^snapshot_jobs ($cell {}) ^snapshot_versions ($cell {}) ^browser_requests ($cell {}) ^client_requests ($cell {})))
  (runtime/h/objects/.get/workspace/service .set service)
  (set service/lifecycle (open_session_lifecycle service publish_message handle_harness_event
    ^channel_options channel_options ^observe service_event))
  service
  catch Any
    (let original $err)
    (if_not ($absent? service) (service/closed .set true))
    (if (|| ($absent? service) ($absent? service/lifecycle))
      (close_runtime runtime)
      (close_session_lifecycle service/lifecycle))
    (fail original)))

(fn row_voice [service]
  (let snapshot (current_snapshot service/runtime/h/snapshots))
  (for record in (?? (snapshot/registries .get "browser_clients") [])
    (if (== record/key "voice") (return record)))
  nil)

(fn session_voice_state [service, session : Str]
  (let metadata (require_record service/runtime/sessions session))
  (let rounds (round_state service/runtime/services/values/controller session))
  (let loaded (load_session service/runtime/sessions session))
  (let round loaded/round/.get)
  {^voice (public_voice_state (voice_snapshot service/runtime/services/values/voice)) ^title metadata/title
   ^next_submission_seq ($to_str rounds/next_seq)
   ^state (?? round/state "done") ^round_id (?? round/id "")})

(fn session_voice_claim [service, session : Str, request]
  (require_record service/runtime/sessions session)
  (if (!= ($head request/client_id) Str)
    (fail (RoundError ^code "invalid_request" ^message "Voice needs a browser client identity.")))
  (if (|| (&& ($present? request/token)
              (|| (!= ($head request/token) Str) (> ($str/byte_size request/token) 128)))
          (&& ($present? request/output) (!= ($head request/output) Bool))
          (&& ($present? request/enabled) (!= ($head request/enabled) Bool)))
    (fail (RoundError ^code "invalid_request" ^message "Voice expects a text token and boolean enabled/output values.")))
  (if (== request/enabled false)
    (return (public_voice_state (release_voice service/runtime/services/values/voice request/client_id (?? request/token "")))))
  (if ($absent? (row_voice service))
    (fail (RoundError ^code "unavailable" ^message "The voice plugin is disabled or unavailable.")))
  (let claim (claim_voice ^token (?? request/token "") service/runtime/services/values/voice session
    request/client_id (!= request/output false)))
  (if (&& (== claim/owner request/client_id) (== claim/session session))
    claim (public_voice_state claim)))

(fn public_session_index [record]
  (let result ($thaw ($freeze_shallow record)))
  (result .put "revision" ($to_str (?? record/revision 0)))
  result)

(fn list_sessions [service, ^after after : Str = "", ^limit limit : Int = 100, ^kind kind = nil, ^status status = nil, ^attention attention = nil, ^trigger trigger = nil, ^q q : Str = "", ^since since : Str = "", ^until until : Str = ""]
  (let results [])
  (let slack_available (&& ($present? service/runtime/services/values/channels) (sharing_available? service/runtime)))
  (for record in (session_records ^kind kind ^status status ^attention attention ^trigger trigger ^q q ^since since ^until until service/runtime/sessions)
    (if (&& (!= after "") (<= ($order/compare record/id after) 0)) (continue))
    (if (>= results/.size limit) (break))
    (let shown (public_session_index record))
    (shown .put "slack_available" slack_available)
    (if_yes (&& (== q "") ($absent? kind) ($absent? status) ($absent? attention)
                ($absent? trigger) (== since "") (== until ""))
      (let children [])
      (for child in (session_records ^kind "child" service/runtime/sessions)
        (if (== child/parent/session record/id) (children .push (public_session_index child))))
      (shown .put "children" children))
    (results .push shown))
  {^sessions results ^needs_attention ($map (session_records ^^attention service/runtime/sessions) public_session_index) ^next ""})

(fn create_session [service, ^title title : Str = "New conversation"]
  (let record (create_record ^title title service/runtime/sessions))
  (public_session service record))

(fn rename_session [service, id : Str, title : Str, revision : Int]
  (edit_session service id {^title title} revision))

(fn edit_session [service, id : Str, changes, revision : Int]
  (with_session_gate service/runtime/sessions $"round/${id}"
    (fn [] (edit_session_locked service id changes revision))))

(fn edit_session_locked [service, id : Str, changes, revision : Int]
  (let record (require_record service/runtime/sessions id))
  (if (!= (?? record/revision 0) revision)
    (fail
      (RoundError ^code "revision_conflict" ^message "Session changed; refresh before editing it.")))
  (let update {^revision (+ revision 1)})
  (if_not ($absent? changes/title)
    (if (|| (!= ($head changes/title) Str) (== ($str/trim changes/title) "") (> ($str/byte_size changes/title) 256))
      (fail (RoundError ^code "invalid_request" ^message "Session title must have 1–256 bytes")))
    (update .put "title" ($str/trim changes/title)))
  (if_not ($absent? changes/pinned)
    (if (!= ($head changes/pinned) Bool)
      (fail (RoundError ^code "invalid_request" ^message "Pinned must be boolean")))
    (update .put "pinned" changes/pinned))
  (let next (update_session service/runtime/sessions id update))
  (public_session service next))

(fn acknowledge_attention [service, id : Str]
  (let record (require_record service/runtime/sessions id))
  (if record/attention (update_session service/runtime/sessions id {^!attention}))
  {^^ok})

(fn remove_session [service, id : Str, revision : Int]
  (require_record service/runtime/sessions id)
  (let ids [id])
  (for [key record] in service/runtime/sessions/index/.get
    (if (== record/parent/session id) (ids .push ($to_str key))))
  (if_not (delete_session ^^explicit ^revision revision service/runtime/sessions id)
    (fail (RoundError ^code "busy" ^message "Stop running work and answer or dismiss pending questions before deleting this conversation.")))
  {^deleted ids})

(fn submit [service, session : Str, request_id : Str, sequence : Int, text : Str, ^media media = [], ^card card = nil, ^model_settings model_settings = nil]
  (if_not (== ($head media) List)
    (fail (RoundError ^code "invalid_request" ^message "Attachments must be a list of media IDs.")))
  # A card send is always a chat message, never a slash command.
  (if_not ($absent? card)
    (return (submit_round ^model_settings model_settings ^media media ^card card service/runtime/services/values/controller session request_id sequence text)))
  (let parsed (parse_submission service/runtime/h text))
  (if (&& (== parsed/kind "command") (! media/.empty?))
    (fail (RoundError ^code "invalid_request" ^message "Attachments accompany chat messages, not slash commands.")))
  (if (== parsed/kind "command")
    (submit_command service/runtime/services/values/commands session text)
    (submit_round ^model_settings model_settings ^media media service/runtime/services/values/controller session request_id sequence parsed/text)))
(fn command [service, session : Str, text : Str, ^request_id request_id : Str = "", ^sequence sequence = nil, ^expected expected = nil, ^card card = nil]
  (if ($absent? card)
    (return (submit_command ^request_id request_id ^sequence sequence ^expected expected service/runtime/services/values/commands session text)))
  # A card's command button names the card revisions behind the clicked tree.
  # It registers with the round-resume barrier until the command ends, so
  # answering the card's round never resumes the model while it runs.
  (admit_card_command service/runtime session card text)
  (let started ($cell false))
  (let released ($cell false))
  (let release (fn []
    (if_not (released .swap true) (release_card_command service/runtime session))))
  (try
    (let record (submit_command ^request_id request_id ^sequence sequence ^expected expected
      ^on_admit (fn [admitted] (started .set true)) ^on_finish release
      service/runtime/services/values/commands session text))
    # A retried request returns its earlier receipt and starts nothing.
    (if_not started/.get (release))
    record
  catch Any
    (if_not started/.get (release))
    (fail $err)))

(fn session_card_action [service, session : Str, card : Str, request]
  (require_record service/runtime/sessions session)
  (let copy ($thaw ($freeze request)))
  (copy .put "card" card)
  (card_action service/runtime session copy))

(fn session_card_receipt [service, session : Str, input_id : Str]
  (card_action_receipt service/runtime session input_id))

(fn card_block [runtime, session : Str, card]
  {^id $"${session}/card/${card/id}" ^seq ($to_str (?? card/created_seq 0))
   ^round_id (?? card/placement_round "") ^turn (?? card/turn 0)
   ^role "assistant" ^phase "card" ^kind "card" ^text ""
   ^card (shown_card runtime session card) ^order (?? card/created_ms 0) ^^durable})

(fn question_view? [batch] : Bool
  (for question in (?? batch/questions [])
    (if_not ($absent? (?? question/view nil)) (return true)))
  false)

(fn operator_receipt [service, session : Str, id : Str]
  (require_record service/runtime/sessions session)
  (let result (command_receipt service/runtime/services/values/commands session id))
  (if ($absent? result)
    (fail (RoundError ^code "not_found" ^message "Command receipt is not retained.")))
  result)

(fn command_sequence [service, session : Str]
  (require_record service/runtime/sessions session)
  {^next_command_seq ($to_str (/next_id (command_state service/runtime session)))})

(fn request_receipt [service, session : Str, request_id : Str, kind : Str]
  (require_record service/runtime/sessions session)
  (if_yes (== kind "command")
    (let result (command_request_receipt service/runtime/services/values/commands session request_id))
    (if_not ($absent? result) (return result)))
  (if (== kind "round")
    (for record in ((Path "receipts") (round_state service/runtime/services/values/controller session))
      (if (== record/request_id request_id) (return (public_round service session record)))))
  (fail
    (RoundError ^code "not_found" ^message "Request receipt is not retained; do not replay an uncertain operation.")))
(fn cancel_operator_command [service, session : Str, id : Str]
  (cancel_command service/runtime/services/values/commands session id))
(fn public_round [service, session : Str, source]
  (if ($absent? source) (return nil))
  (let result ($thaw ($freeze source)))
  (if_yes (continuable_round? result)
    (let current (/round (load_session service/runtime/sessions session)))
    (let successor (if ($present? source/continued_by)
      (then (round_receipt service/runtime/services/values/controller session source/continued_by))
      (else nil)))
    (var available (&& (== (/id current/.get) source/id)
      (|| ($absent? source/continued_by)
          (&& (== source/continuation_stop "failed") ($absent? successor)))
      (|| ($absent? source/continuation_stop) (== source/continuation_stop "failed"))))
    (if_yes available
      (let tail (pending_request service/runtime session))
      (let reference (?? source/continuation/items_ref source/request_items_ref))
      (set available (&& ($present? reference) (== tail/round source/id)
        (== tail/turn source/last_turn)
        (try (== ($head ($serde/read_data (read_body service/runtime reference))) List) catch Any false))))
    (result .put "resumable" available))
  result)

(fn receipt [service, session : Str, id : Str]
  (require_record service/runtime/sessions session)
  (let result (round_receipt service/runtime/services/values/controller session id))
  (if ($absent? result)
    (fail (RoundError ^code "not_found" ^message "Round receipt is not retained.")))
  (public_round service session result))
(fn answer [service, session : Str, batch_id : Str, values, ^dismiss dismiss : Bool = false]
  (answer_round ^dismiss dismiss ^^operator_input service/runtime/services/values/controller session batch_id values))
(fn cancel [service, session : Str, id : Str]
  (cancel_round service/runtime/services/values/controller session id))

(fn cancel_child [service, session : Str, id : Str, admission : Int]
  (if (<= admission 0)
    (fail (RoundError ^code "invalid_request" ^message "Admission must be positive.")))
  (require_record service/runtime/sessions session)
  (cancel_delegation_admission service/runtime/services/values/delegations session id admission))

(fn recover_children [service, session : Str, round : Str, action : Str]
  (require_record service/runtime/sessions session)
  (let result (delegation_recovery service/runtime/services/values/delegations session round action))
  (queue_snapshot service session)
  result)

(fn delegation_block [session : Str, data]
  {^id $"${session}/delegation/${data/source}" ^seq ($to_str data/created_seq)
   ^round_id data/round ^turn data/turn ^role "assistant" ^kind "delegation"
   ^phase "delegation" ^order data/queued_at_ms ^text "" ^delegation data ^^durable})

(fn snapshot [service, id : Str, ^after after : Int = -1, ^before before : Int = -1, ^safe safe : Bool = false, ^console console : Bool = true]
  (let metadata (require_record service/runtime/sessions id))
  (let loaded (load_session service/runtime/sessions id))
  (let records [])
  (var cursor 0)
  (for event in (events_for service/runtime/events "session" id)
    (set cursor event/seq)
    (if (&& console (>= after 0) (<= event/seq after)) (continue))
    (if (&& console (>= before 0) (>= event/seq before)) (continue))
    (if_yes (&& (== event/type "delegation/state") ($present? event/payload/state/summary))
      (let state event/payload/state)
      (records .push
        {^id $"${id}/delegation-update/${event/seq}" ^seq ($to_str event/seq)
         ^round_id state/round ^turn state/turn ^role "assistant"
         ^phase "delegation/update" ^kind "delegation/update" ^text state/summary
         ^order state/at_ms ^^durable}))
    (if (|| (["turn/response" "turn/request" "turn/patch" "reply"] .contains? event/type) (&& console (== event/type "console")) (&& (! console) (["turn/start" "turn/end"] .contains? event/type)) (&& (== event/type "turn/end") ($present? event/payload/text)))
      (records .push (event_record id event)))
    # A later definition of a card shows a short line where it happened.
    (if_yes (== event/type "card/state")
      (let card event/payload/state)
      (if (&& ($present? card) (== card/origin "model") (!= card/updated_turn card/turn))
        (records .push
          {^id $"${id}/card-update/${card/id}/${card/definition_revision}" ^seq ($to_str event/seq)
           ^round_id (?? card/round "") ^turn card/updated_turn ^role "assistant"
           ^phase "card/update" ^kind "card/update" ^text card/title ^card_id card/id
           ^order (?? card/updated_ms event/seq) ^^durable})))
    # Answered questions with views stay in the transcript, read-only.
    (if_yes (== event/type "question/answered")
      (let batch event/payload/state)
      (if (&& ($present? batch) (question_view? batch))
        (records .push
          {^id $"${id}/questions/${batch/id}" ^seq ($to_str event/seq)
           ^round_id (?? batch/round "") ^turn (?? batch/turn 0) ^role "assistant"
           ^phase "questions" ^kind "questions" ^text ""
           ^batch {^id batch/id ^questions batch/questions ^answers batch/answers
                   ^answer_source (?? batch/answer_source nil)
                   ^intent (?? batch/intent "continue")}
           ^order (?? batch/answered_ms event/seq) ^^durable}))))
  (for card in (card_records service/runtime id)
    (let seq (?? card/created_seq 0))
    (if (&& (>= after 0) (<= seq after)) (continue))
    (if (&& (>= before 0) (>= seq before)) (continue))
    (records .push (card_block service/runtime id card)))
  (let commands (command_state service/runtime id))
  (let delegations (delegation_blocks service/runtime/services/values/delegations id))
  (for data in delegations/records
    (let seq data/created_seq)
    (if (&& (>= after 0) (<= seq after)) (continue))
    (if (&& (>= before 0) (>= seq before)) (continue))
    (records .push (delegation_block id data)))
  (for record in commands/records
    (if (== record/ui_action true) (continue))
    (let seq (?? record/start_seq 0))
    (if (&& (>= after 0) (<= seq after)) (continue))
    (if (&& (>= before 0) (>= seq before)) (continue))
    (records .push (command_input_record id record))
    (if_yes (&& console (!= record/name "sh") (!= (?? record/output "") ""))
      (records .push
        {
          ^id $"${id}/${record/id}/console"
          ^seq ($to_str seq)
          ^round_id ""
          ^turn 0
          ^role "log"
          ^phase "console"
          ^kind "console"
          ^text record/output
          ^!late
          ^order (?? record/started_ms 0)
          ^^durable}))
    (records .push
      {
        ^id $"${id}/${record/id}"
        ^seq ($to_str seq)
        ^round_id ""
        ^turn 0
        ^role "assistant"
        ^phase "command"
        ^kind "command"
        ^command_id record/id
        ^input_id (?? record/input_id nil)
        ^mode_instance (?? record/mode_instance nil)
        ^name record/name
        ^raw record/raw
        ^text (command_display record)
        ^exit (?? record/exit nil)
        ^status record/status
        ^view (?? record/view nil)
        ^order (?? record/started_ms 0)
        ^^durable}))
  (let rounds (round_state service/runtime/services/values/controller id))
  (let ordered ($order/sort_by records (fn [record] (?? record/order 0))))
  (let page [])
  (var start ($math/max 0 (- ordered/.size history_page_limit)))
  # A command's input and output share one cursor. Keep them on the same
  # page so the exclusive "before" cursor cannot skip its input.
  (while (> start 0)
    (let previous (- start 1))
    (if (!= ordered/%previous/seq ordered/%start/seq) (break))
    (set start previous))
  (var i 0)
  (for record in ordered
    (if (>= i start) (page .push record))
    (set i (+ i 1)))
  (let browser (if console {^records page ^has_older (> start 0)}
    (conversation_page (project_conversation ordered rounds/receipts) after before history_page_limit)))
  {
    ^protocol protocol_version
    ^session (public_session service metadata)
    ^records browser/records
    ^before_cursor (?? browser/before_cursor (if page/.empty? "" (/seq ($first page))))
    ^cursor ($to_str cursor)
    ^preview []
    ^has_older browser/has_older
    ^rounds ($map rounds/receipts (fn [round] (public_round service id round)))
    ^next_command_seq ($to_str commands/next_id)
    ^next_submission_seq ($to_str rounds/next_seq)
    ^round (public_round service id loaded/round/.get)
    ^delegation_recovery delegations/recovery
    ^channel_delivery (delivery_status service/runtime/services/values/channels id)
    ^mode (mode_state service/runtime/services/values/commands/modes id)
    ^status (host_status ^session id ^safe safe service)
    ^questions (if (== metadata/status "waiting")
                 ((Path "questions") loaded/round/.get)
                 nil)})

(fn web_components [service, session : Str]
  (let metadata (if (== session "") nil (require_record service/runtime/sessions session)))
  (let loaded (if (== session "") nil (load_session service/runtime/sessions session)))
  (let context
    ($freeze
      {
        ^session_id session
        ^session metadata
        ^round (if ($absent? loaded)
                 nil
                 loaded/round/.get)
        ^workspace service/runtime/root
        ^model (current_model_info service session)
        ^sessions (session_records service/runtime/sessions)}))
  (let components [])
  (for candidate in (rows service/runtime/h "web_components")
    (if (|| ($present? candidate/view_state) (== candidate/slot "settings_section")) (continue))
    (let item {^name candidate/name ^slot candidate/slot})
    (if_not ($absent? candidate/style_css)
      (item .put "style" candidate/style_css)
      (item .put "style_class" candidate/style_class))
    (try
      (let view
        (if ($absent? candidate/render)
          candidate/view
          (render_component ^sidebar (== candidate/slot "conversation_sidebar")
            service/runtime/h candidate/render context)))
      (item .put "view" view)
    catch Any
      (item .put "error" $err/message))
    (components .push item))
  components)

(fn host_status [service, ^session session : Str = "", ^safe safe : Bool = false]
  (let lease (acquire_snapshot ^label "web/status" service/runtime/h/snapshots))
  (try
    ($runtime/with_context
      {^composition service/runtime/h/snapshots ^snapshot lease/snapshot ^session session}
      (fn []
        (host_status_in_snapshot ^safe safe service session)))
  ensure
    (release_snapshot service/runtime/h/snapshots lease)))

(fn next_status_sequence [service]
  (loop
    (let current service/revision/.load)
    (if (service/revision .compare_exchange current (+ current 1)) (return current))))

(fn host_status_in_snapshot [service, session : Str, ^safe safe : Bool = false]
  # Capture freshness before callbacks can park. A render begun before a state
  # change must not be stamped with the revision current at its completion.
  (let composition (current_snapshot service/runtime/h/snapshots))
  (let status_revision (ui_data_revision service/runtime composition))
  (let status_sequence (next_status_sequence service))
  (let catalog_revision (?? (/id (catalog_snapshot service/runtime)) nil))
  (var running 0)
  (for [id frame] in service/runtime/services/values/controller/rounds/.get
    (if_not ($absent? frame/task) (set running (+ running 1))))
  (let commands (command_descriptors service/runtime/h composition))
  (let plugins [])
  (for plugin in composition/plugins
    (plugins .push {^id plugin/id ^state plugin/status}))
  (let metadata (if (== session "") nil (require_record service/runtime/sessions session)))
  (let config (effective_config service/runtime))
  (let current (if (== session "") (then nil) (else (load_session service/runtime/sessions session))))
  (let round (if ($present? current) (then current/round/.get) (else nil)))
  (let selection (if (["running" "waiting"] .contains? round/state) (then round/selection) (else nil)))
  {
    ^protocol protocol_version
    ^epoch service/epoch
    ^status_session session
    ^status_revision status_revision
    ^status_sequence ($to_str status_sequence)
    ^model (selection_view ^metadata metadata ^round round service/runtime config)
    ^catalog_revision catalog_revision
    ^profile service/runtime/profile/name
    ^appearance (appearance_mode service/runtime)
    ^keyboard (keyboard_bindings service/runtime)
    ^readiness (readiness_report ^selection selection service/runtime (session_settings metadata config))
    ^plugins plugins
    ^web_components (if safe [] (web_components service session))
    ^browser_clients (if safe [] (browser_client_descriptors service/runtime/h composition))
    ^ui (if safe nil (ui_status service/runtime))
    ^commands commands
    ^offline service/offline
    ^workspace service/runtime/root
    ^running running})

(fn close_session_service [service]
  (if (service/closed .swap true) (return nil))
  (close_session_lifecycle service/lifecycle))

# Public objects: code running in this host reaches everything through these.
# Each one holds the real internals in public properties and filters nothing.
# Their messages call the same operations as the routes above, so `self` stands in
# for the `service` argument: those operations read only its `runtime` property.

(type HarnessSession ^props {^id Str ^runtime Any ^workspace Any}
  (message state [] : Any
    @doc "The live SessionState: history, current round, outputs and console."
    (load_session self/runtime/sessions self/id))
  (message record [] : Any
    @doc "The stored session record: title, kind, status, model settings and revision."
    (require_record self/runtime/sessions self/id))
  (message title [] : Str
    @doc "The session title."
    (/title (require_record self/runtime/sessions self/id)))
  (message round [] : Any
    @doc "The current or most recent round's live record, or nil. A running /run or REPL command is not a round."
    (let loaded (load_session self/runtime/sessions self/id))
    loaded/round/.get)
  (message receipt [id : Str] : Any
    @doc "The durable receipt of one round."
    (receipt self self/id id))
  (message command_receipt [id : Str] : Any
    @doc "The durable receipt of one operator command."
    (operator_receipt self self/id id))
  (message transcript [^after after : Int = -1, ^before before : Int = -1] : Any
    @doc "The same records the operator sees, including commands and REPL activity. Page with after and before."
    (snapshot ^after after ^before before self/workspace/service/.get self/id))
  (message rename [title : Str, ^revision revision = nil] : Any
    @doc "Rename the session immediately. Uses the current revision unless one is given."
    (edit_session self self/id {^title title}
      (?? revision (?? (/revision (require_record self/runtime/sessions self/id)) 0))))
  (message edit [changes, ^revision revision = nil] : Any
    @doc "Change title or pinned immediately. Uses the current revision unless one is given."
    (edit_session self self/id changes
      (?? revision (?? (/revision (require_record self/runtime/sessions self/id)) 0))))
  (message delete [^revision revision = nil] : Any
    @doc "Delete this session and its children immediately. Fails with busy while work is running."
    (remove_session self self/id
      (?? revision (?? (/revision (require_record self/runtime/sessions self/id)) 0))))
  (message submit [text : Str, ^request_id request_id = nil, ^sequence sequence = nil, ^media media = [],
                   ^model_settings model_settings = nil] : Any
    @doc "Submit text like the operator's composer: a model round, or a command when it starts with a slash. Returns the admission receipt; work continues after it. This is not delegation and has none of its budget or parent ownership."
    (submit ^media media ^model_settings model_settings self self/id
      (?? request_id $"gene-${($crypto/random_hex 16)}")
      (?? sequence (/next_seq (round_state self/runtime/services/values/controller self/id)))
      text))
  (message command [text : Str] : Any
    @doc "Run one operator command such as /help in this session. Returns its record; work may continue after it."
    (command self self/id text))
  (message cancel [^round round_id = nil] : Any
    @doc "Cancel a round, by default the current one."
    (let loaded (load_session self/runtime/sessions self/id))
    (cancel self self/id (?? round_id (/id loaded/round/.get))))
  (message cancel_command [id : Str] : Any
    @doc "Cancel a running operator command."
    (cancel_operator_command self self/id id))
  (message answer [batch : Str, values, ^dismiss dismiss : Bool = false] : Any
    @doc "Answer or dismiss a pending question batch."
    (answer ^dismiss dismiss self self/id batch values))
  (message model [] : Any
    @doc "The model this session resolves to, with requested and effective effort."
    (current_model_info self self/id))
  (message preview_model [selection] : Any
    @doc "Resolve a selection for this session without saving it."
    (preview_model_settings self self/id selection))
  (message select_model [selection] : Any
    @doc "Save this session's model choice immediately. A running round keeps its selection; the choice applies from the next admission."
    (select_model_settings self self/id selection))
  (message card_action [card : Str, request] : Any
    @doc "Apply an action to one of this session's cards."
    (session_card_action self self/id card request))
  (message card_receipt [input_id : Str] : Any
    @doc "The outcome of a card action."
    (session_card_receipt self self/id input_id))
  (message voice [] : Any
    @doc "This session's voice state."
    (session_voice_state self self/id))
  (message cancel_delegation [id : Str, admission : Int] : Any
    @doc "Cancel one delegated child by its id and admission."
    (cancel_child self self/id id admission))
  (message cards [] : Any
    @doc "This session's cards as the operator's transcript shows them."
    ($filter (/records (snapshot self/workspace/service/.get self/id))
      (fn [record] (== record/kind "card"))))
  (message claim_voice [request] : Any
    @doc "Claim or release this session's voice for a browser client, as the browser does."
    (session_voice_claim self self/id request))
  (message voice_timings [] : Any
    @doc "Recorded voice latency for this session."
    (voice_timings self/runtime/services/values/voice self/id))
  (message media [] : Any
    @doc "This session's attachment descriptors."
    ($runtime/with_context {^session self/id} (fn [] (list_media self/runtime))))
  (message delegations [] : Any
    @doc "This session's delegated children and their state."
    (delegation_blocks self/runtime/services/values/delegations self/id))
  (message recover_delegations [round : Str, action : Str] : Any
    @doc "Resume or give up on children cut off from a round, as the browser's recovery controls do."
    (recover_children self self/id round action))
  (message slack_thread [] : Str
    @doc "The Slack thread link for this session."
    (session_slack_thread self self/id))
  (message add_to_slack [revision : Int] : Any
    @doc "Share this session to Slack. A stale revision fails with a conflict."
    (session_add_to_slack self self/id revision))
  (message acknowledge_attention [] : Any
    @doc "Clear this session's attention flag."
    (acknowledge_attention self self/id)))

(type HarnessManager ^props {^runtime Any ^root Str ^workspaces_dir Str ^archive_dir Str ^service Any?}
  (message running? [] : Bool
    @doc "Whether this host is the manager and can control workspaces."
    ($present? self/service))
  (message workspaces [] : Any
    @doc "The workspaces under the manager root. The manager host adds live status; other hosts read the directory."
    (if ($present? self/service)
      (then (manager_list self/service))
      (else (workspace_directory_list self/workspaces_dir self/archive_dir))))
  (message workspace [id : Str] : Any
    @doc "Inspect one workspace with startup diagnostics. Needs the manager host."
    (manager_inspect (require_live_manager self) id))
  (message control [operation : Str, values = {}, ^confirmed confirmed : Bool = false] : Any
    @doc "Run a manager operation such as start, stop, restart, create, port, rename, archive or restore. Needs the manager host."
    (manager_operation ^confirmed confirmed (require_live_manager self) operation values))
  (message models [] : Any
    @doc "The cached model catalog, connection states and shared default. Makes no inference call."
    (model_catalog self))
  (message refresh_models [] : Any
    @doc "Request bounded model discovery. Returns at once; read models again to see the result."
    (refresh_models self))
  (message model_configuration [] : Any
    @doc "The shared models.gene configuration, errors and digest."
    (model_configuration self))
  (message save_model_configuration [config, expected : Str] : Any
    @doc "Save shared models.gene immediately. A stale digest fails with a revision conflict."
    (save_model_configuration self config expected))
  (message set_default_model [selection, expected : Str] : Any
    @doc "Save the shared default model immediately. A stale digest fails with a revision conflict."
    (set_model_default self selection expected))
  (message settings [^group group : Str = ""] : Any
    @doc "Shared setting defaults in the manager root's settings.gene: each shared-capable setting's value, default and source, with that file's digest. Works without a running manager."
    (list_shared_settings ^group group self/runtime))
  (message setting [key : Str] : Any
    @doc "One shared setting default."
    (read_shared_setting self/runtime key))
  (message set_setting [key : Str, value, ^expected expected : Str = ""] : Any
    @doc "Save a shared setting default for every workspace without its own override. Running hosts use it from their next applicable round. A stale digest fails with a revision conflict."
    (set_shared_setting ^expected expected self/runtime key value))
  (message set_settings [changes, ^reset reset = [], ^expected expected : Str = ""] : Any
    @doc "Save and reset several shared setting defaults in one locked write to settings.gene. Keys without shared scope, including model defaults, are refused before writing."
    (commit_shared ^set changes ^reset reset ^expected expected self/runtime))
  (message reset_setting [key : Str, ^expected expected : Str = ""] : Any
    @doc "Remove a shared setting default so workspaces without an override use the definition default."
    (reset_shared_setting ^expected expected self/runtime key))
  (message connect [provider : Str, ^account account = nil] : Any
    @doc "Start sign-in for a provider. Returns an attempt with its id and browser URL; read login_status for progress."
    (model_login ^account account self "connect" provider))
  (message login_status [id : Str] : Any
    @doc "Status of one sign-in attempt."
    (model_login self "status" id))
  (message cancel_login [id : Str] : Any
    @doc "Cancel one sign-in attempt."
    (model_login self "cancel" id))
  (message accounts [] : Any
    @doc "Saved provider accounts."
    (model_accounts self))
  (message account_action [id : Str, action : Str] : Any
    @doc "Run select, sign_out or acknowledge on a saved account."
    (model_accounts ^action action ^id id self)))

(type HarnessWorkspace ^props {^runtime Any ^service Any ^root Str ^state_root Str ^h Any ^workspace Any ^profile Any
                               ^events Any ^sessions Any ^services Any ^manager Any}
  (message sessions [^q q : Str = "", ^kind kind = nil, ^status status = nil, ^attention attention = nil,
                     ^trigger trigger = nil, ^since since : Str = "", ^until until : Str = "",
                     ^after after : Str = "", ^limit limit : Int = 100] : Any
    @doc "Find sessions. Returns their records, those needing attention, and a next cursor."
    (list_sessions ^q q ^kind kind ^status status ^attention attention ^trigger trigger
      ^since since ^until until ^after after ^limit limit self))
  (message session [id : Str] : HarnessSession
    @doc "One session by id."
    (require_record self/sessions id)
    (HarnessSession ^id id ^runtime self/runtime ^workspace self))
  (message create_session [^title title : Str = "New conversation"] : HarnessSession
    @doc "Create a conversation immediately."
    (let created (create_session ^title title self))
    (HarnessSession ^id created/id ^runtime self/runtime ^workspace self))
  (message registries [] : Any
    @doc "Every registry name, including plugin-created ones."
    (registry_names self/h))
  (message rows [name : Str] : Any
    @doc "The real rows of one registry in the caller's composition, including their callbacks."
    (rows self/h name))
  (message row [name : Str, key : Str] : Any
    @doc "One real registry row, or nil."
    (row self/h name key))
  (message revision [] : Int
    @doc "The composition revision the caller is reading. Session metadata and configuration have their own revisions."
    (/id (current_snapshot self/h/snapshots)))
  (message plugins [^q q : Str = "", ^state state : Str = ""] : Any
    @doc "The plugin catalog: declared and observed contributions, state, errors and diagnostics for every plugin, including disabled and failed ones."
    (plugin_catalog ^query q ^state state self/runtime))
  (message plugin [id : Str] : Any
    @doc "One plugin's catalog row, or nil. A disabled or failed plugin keeps its declared contributions and reason."
    (for candidate in (/plugins (plugin_catalog self/runtime))
      (if (== candidate/id id) (return candidate)))
    nil)
  (message enable_plugin [id : Str] : Any
    @doc "Enable a plugin. Staged when called inside an open turn, otherwise immediate; the result's boundary says which."
    (set_plugin_enabled ^readiness self/services/values/readiness self/workspace self/h id true))
  (message disable_plugin [id : Str] : Any
    @doc "Disable a plugin. Staged when called inside an open turn, otherwise immediate; the result's boundary says which."
    (set_plugin_enabled ^readiness self/services/values/readiness self/workspace self/h id false))
  (message restore_plugin [id : Str] : Any
    @doc "Restore a built-in to its profile default. Staged when called inside an open turn, otherwise immediate."
    (restore_plugin ^readiness self/services/values/readiness self/workspace self/h id))
  (message validate_plugin_plan [request] : Any
    @doc "Validate a batch of plugin changes without applying it. Returns the plan or the reason it cannot apply."
    (validate_plan self/runtime request))
  (message apply_plugin_plan [id : Str] : Any
    @doc "Apply a validated plan immediately. A plan is never applied twice."
    (apply_plan self/runtime id))
  (message plugin_plan_result [id : Str] : Any
    @doc "The durable result of a plan."
    (plan_result self/runtime id))
  (message plugin_history [id : Str = "", ^limit limit : Int = 50, ^before before = nil] : Any
    @doc "Retained composition revisions, optionally for one plugin."
    (plugin_history_catalog ^limit limit ^before before self/runtime id))
  (message revert_plugin [id : Str, revision : Int, expected : Int] : Any
    @doc "Revert to a retained plugin entry. A stale expected revision fails with a conflict."
    (revert_plugin ^readiness self/services/values/readiness ^expected expected self/workspace self/h id revision))
  (message pin_plugin_history [revision : Int, pinned : Bool] : Any
    @doc "Pin or unpin a retained composition revision."
    (pin_history self/workspace/store self/workspace/history_head/.get revision pinned))
  (message search_sessions [query : Str, ^limit limit : Int = 50] : Any
    @doc "Search session titles and transcripts."
    (search_sessions ^limit limit self/sessions query))
  (message triggers [] : Any
    @doc "Trigger definitions."
    (list_triggers (require_trigger_manager self/runtime)))
  (message create_trigger [definition] : Any
    @doc "Create a trigger immediately. Scheduled work starts from it."
    (create_trigger (require_trigger_manager self/runtime) definition))
  (message update_trigger [id : Str, changes] : Any
    @doc "Change a trigger immediately."
    (update_trigger (require_trigger_manager self/runtime) id changes))
  (message delete_trigger [id : Str] : Any
    @doc "Delete a trigger immediately."
    (delete_trigger (require_trigger_manager self/runtime) id))
  (message trigger_occurrences [^trigger trigger = nil] : Any
    @doc "Trigger occurrences and their outcomes, optionally for one trigger."
    (if ($present? trigger)
      (then (list_occurrences (require_trigger_manager self/runtime) ^trigger trigger))
      (else (list_occurrences (require_trigger_manager self/runtime)))))
  (message notifications [] : Any
    @doc "The notification inbox."
    (inbox_snapshot self/services/values/inbox))
  (message notification [id : Str] : Any
    @doc "One notification with its detail."
    (message_detail self/services/values/inbox id))
  (message post_notification [message] : Any
    @doc "Post an operator-owned notification immediately."
    (publish_notification self/h self/services/values/inbox "operator" message))
  (message acknowledge_notifications [through : Int] : Any
    @doc "Mark notifications read through a sequence number."
    (acknowledge_messages self/services/values/inbox through))
  (message clear_notifications [messages] : Any
    @doc "Clear notifications, each with its id and revision."
    (clear_messages self/services/values/inbox messages))
  (message notification_action [request] : Any
    @doc "Invoke a notification's action. A command action returns its admission; work continues after it."
    (invoke_notification_action self/runtime request))
  (message appearance [] : Str
    @doc "The workspace theme mode."
    (appearance_mode self/runtime))
  (message set_appearance [mode : Str] : Str
    @doc "Set the workspace theme mode immediately."
    (set_appearance self/runtime mode))
  (message views [] : Any
    @doc "UI settings, registered views and their revisions."
    (ui_status self/runtime))
  (message commands [] : Any
    @doc "Registered operator commands."
    (rows self/h "commands"))
  (message voice [] : Any
    @doc "Voice engine and claim state."
    (public_voice_state (voice_snapshot self/services/values/voice)))
  (message media_limits [] : Any
    @doc "Upload limits for attachments."
    (let store (open_media_store self/state_root))
    {^max_file_bytes store/max_file_bytes ^max_files 16 ^max_message_bytes 41943040})
  (message store_media [name : Str, encoded : Str] : Any
    @doc "Store an attachment from base64 immediately, as a browser upload does. Returns its descriptor."
    (put_media_base64 (open_media_store self/state_root) name encoded))
  (message media_item [id : Str] : Any
    @doc "One attachment's descriptor."
    (media_descriptor (open_media_store self/state_root) id))
  (message media_bytes [id : Str] : Any
    @doc "One attachment's bytes."
    (media_bytes (open_media_store self/state_root) id))
  (message voice_engines [] : Any
    @doc "The registered speech recognizers and synthesizers."
    {^recognizers (rows self/h "speech_recognizers") ^synthesizers (rows self/h "speech_synthesizers")})
  (message channel_status [] : Any
    @doc "Channel accounts, health and pending incoming messages."
    (/body (channel_request self/services/values/channels "GET" (api_path ["channels"]))))
  (message channels [method : Str, endpoint : Str, data = {}] : Any
    @doc "Call a channel operation with the same method, path and data as its authenticated route."
    (channel_request self/services/values/channels method endpoint data))
  (message metadata [] : Any
    @doc "This workspace's stored metadata: port and role."
    (read_workspace_settings self/root))
  (message update_metadata [changes, ^expected expected : Str = ""] : Any
    @doc "Change this workspace's stored metadata immediately. A stale digest fails with a revision conflict."
    (update_workspace_settings ^expected expected self/root changes))
  (message settings [^group group : Str = ""] : Any
    @doc "Every setting's definition, value, default and source, with the config digest. Source is launch, workspace or default."
    (list_settings ^group group self/runtime))
  (message setting [key : Str] : Any
    @doc "One setting's definition, value, default and source."
    (read_setting self/runtime key))
  (message set_setting [key : Str, value, ^expected expected : Str = ""] : Any
    @doc "Save a workspace setting immediately. Its applies field says whether it takes effect at once, from the next round or after a restart. A stale digest fails with a revision conflict."
    (set_setting ^expected expected self/runtime key value))
  (message set_settings [changes, ^reset reset = [], ^expected expected : Str = ""] : Any
    @doc "Save several workspace settings and reset others in one write to config.gene. One invalid value or a stale digest saves nothing. Returns the settings and the new digest."
    (set_settings ^reset reset ^expected expected self/runtime changes))
  (message model_selection [] : Any
    @doc "The provider, model and effort the next round with no session choice would use, with its source, pins and any reason it is not ready."
    (current_model_info self ""))
  (message settings_groups [] : Any
    @doc "The Settings sidebar: every setting group plus contributed settings_groups rows with their label, order, doc and section, in display order."
    (list_settings_groups self/runtime))
  (message setting_choices [key : Str, ^values values = {}, ^scope scope : Str = "workspace"] : Any
    @doc "The options a setting's choice source offers for the given draft values, whether they are complete or closed, and why any are unavailable. Reads cached catalogs only."
    (setting_choices ^values values ^scope scope self/runtime (require_definition self/runtime key)))
  (message keyboard [] : Any
    @doc "Every keyboard action with its binding, default, source, context, conflicts and owning plugin, with the config digest."
    (keyboard_state self/runtime))
  (message bind_key [id : Str, chord : Str, ^expected expected : Str = ""] : Any
    @doc "Bind an action to a chord such as Ctrl+Shift+KeyK, using event codes. Connected browsers pick it up at once. The binding is kept if the owning plugin is disabled. A stale digest fails with a revision conflict."
    (let state (bind_key ^expected expected self/runtime id chord))
    (announce_keyboard self)
    state)
  (message clear_key [id : Str, ^expected expected : Str = ""] : Any
    @doc "Leave an action with no binding. A stale digest fails with a revision conflict."
    (let state (clear_key ^expected expected self/runtime id))
    (announce_keyboard self)
    state)
  (message restore_key [id : Str, ^expected expected : Str = ""] : Any
    @doc "Restore an action's default binding. A stale digest fails with a revision conflict."
    (let state (restore_key ^expected expected self/runtime id))
    (announce_keyboard self)
    state)
  (message clients [] : Any
    @doc "Connected browser tabs: client id, watched session and whether each is in safe mode."
    (connected_clients self/service/.get))
  (message client_request [client : Str, operation : Str, args = {}, ^timeout_ms timeout_ms : Int = 5000] : Any
    @doc "Ask one connected browser tab to run a client operation and wait for its reply. Fails with unavailable when the tab is absent or does not answer in time."
    (client_request ^timeout_ms timeout_ms self/service/.get client operation args))
  (message client_view [client : Str] : Any
    @doc "Read one tab's selected view and presentation. This reads tab state only and changes no workspace default."
    (client_request self/service/.get client "view/state" {}))
  (message navigate_client [client : Str, view : Str, ^presentation presentation : Str = ""] : Any
    @doc "Switch one tab to a view. This changes that tab only, not workspace defaults."
    (client_request self/service/.get client "view/navigate" {^view view ^presentation presentation}))
  (message invoke_client_action [client : Str, id : Str] : Any
    @doc "Run a keyboard action's operation in one tab, with no keypress."
    (client_request self/service/.get client "action/invoke" {^id id}))
  (message reset_setting [key : Str, ^expected expected : Str = ""] : Any
    @doc "Remove a workspace override so the setting inherits its shared value or default. A stale digest fails with a revision conflict."
    (reset_setting ^expected expected self/runtime key))
  (message stop [^session session : Str = "", ^confirm confirm : Bool = false] : Any
    @doc "Stop this host. Other running sessions need confirm."
    (request_stop self/services/values/controller session 0 confirm)
    {^^ok})
  (message restart [^session session : Str = "", ^confirm confirm : Bool = false] : Any
    @doc "Restart this host under its supervisor. Other running sessions need confirm."
    (request_stop self/services/values/controller session 75 confirm)
    {^^ok}))

(fn announce_keyboard [workspace : HarnessWorkspace]
  (let service workspace/service/.get)
  (if ($present? service)
    (publish_message service "keyboard/changed" "" {^bindings (keyboard_bindings workspace/runtime)})))

(fn connected_clients [service]
  (if (|| ($absent? service) ($absent? service/clients)) (return []))
  (service/clients))

# One request to one browser tab, over the push socket. The reply arrives on an
# authenticated route. All tabs see the frame and only the named one answers.
(fn client_request [service, client : Str, operation : Str, args, ^timeout_ms timeout_ms : Int = 5000]
  (let present ($filter (connected_clients service) (fn [peer] (== peer/client_id client))))
  (if present/.empty?
    (fail (ServiceError ^code "unavailable" ^message $"Browser client ${client} is not connected.")))
  (let id ($crypto/random_hex 16))
  (let slot ($cell nil))
  (service/client_requests/.get .put id slot)
  (try
    (publish_message service "client/request" "" {^id id ^client client ^operation operation ^args args})
    (let due (+ ($os/monotonic_ms) timeout_ms))
    (while (&& ($absent? slot/.get) (< ($os/monotonic_ms) due))
      ($sleep 5))
    (let reply slot/.get)
    (if ($absent? reply)
      (fail (ServiceError ^code "unavailable" ^message $"Browser client ${client} did not answer in time.")))
    (if (!= reply/ok true)
      (fail (ServiceError ^code "client_error" ^message ($to_str (?? reply/error "The browser refused the request.")))))
    reply/result
  ensure
    (service/client_requests/.get .delete id)))

(fn client_reply [service, reply]
  (let slot (service/client_requests/.get .get reply/id))
  (if_not ($absent? slot) (slot .set reply))
  {^^ok})

(fn workspace_directory_list [workspaces_dir : Str, archive_dir : Str]
  (let names (fn [dir : Str]
    (if ($fs/exists? dir)
      (then ($filter ($fs/list_dir dir) (fn [name] (!= name ".DS_Store"))))
      (else []))))
  {^workspaces ($map (names workspaces_dir)
     (fn [name] {^id name ^name name ^dir ($path/join workspaces_dir name) ^status "unknown"}))
   ^archived (names archive_dir)
   ^workspaces_dir workspaces_dir ^archive_dir archive_dir})

(fn require_live_manager [manager : HarnessManager]
  (if ($absent? manager/service)
    (fail (ServiceError ^code "unavailable"
      ^message "Workspace control needs the manager host. Run this from a manager conversation.")))
  manager/service)

(fn select_model_settings [service, session : Str, selection]
  (let contribution (row service/runtime/h "seams" "models/catalog"))
  (if ($absent? contribution)
    (fail (ServiceError ^code "unavailable" ^message "The Models contribution is disabled or unavailable.")))
  (contribution/value/select session selection))

(fn install_host_objects [runtime, launch]
  (let live runtime/services/values/manager)
  (let root (if ($present? live) (then runtime/root)
    (else (try (manager_root_path ^explicit (?? launch/root nil)) catch Any ""))))
  (let manager (HarnessManager ^runtime runtime ^root root
    ^workspaces_dir (if (== root "") "" ($path/join root "workspaces"))
    ^archive_dir (if (== root "") "" ($path/join root "archive"))
    ^service live))
  (let workspace (HarnessWorkspace ^runtime runtime ^root runtime/root ^state_root runtime/state_root
    ^service ($cell nil) ^h runtime/h ^workspace runtime/workspace ^profile runtime/profile
    ^events runtime/events ^sessions runtime/sessions ^services runtime/services ^manager manager))
  (let objects {^workspace workspace ^manager manager
    ^session (fn [id : Str] (HarnessSession ^id id ^runtime runtime ^workspace workspace))})
  # Behind a cell: the VM's scope and escape walks follow plain properties, and the
  # kernel Harness is reachable from nearly everywhere.
  (set runtime/h/objects ($cell objects))
  (publish_host_objects runtime/h/snapshots objects)
  objects)
