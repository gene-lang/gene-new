(mod session_service)
(import ^from "../runtime/bootstrap" [open_runtime close_runtime prepare_workspace_root])
(import ^from "../profiles/baseline" [baseline_profile])
(import ^from "../profiles/offline" [offline_profile])
(import ^from "../runtime/round_controller" ^^export
  [
    new_round_controller
    submit_round
    round_receipt
    round_state
    answer_round
    cancel_round
    close_round_controller
    RoundError])
(import ^from "../runtime/sessions"
  [
    create_session
    :
    create_record
    list_sessions
    :
    session_records
    require_record
    update_session
    load_session])
(import ^from "../agents/provider_selection" [provider_choice select_provider])
(import ^from "../storage/state" [events_for])
(import ^from "./contract" [protocol_version history_page_limit])
(import ^from "../runtime/commands"
  [parse_submission submit_command command_receipt command_request_receipt command_state cancel_command])
(import ^from "../kernel"
  [rows contribute provide withdraw_seam HarnessEvent
   RoundChanged CommandChanged SessionChanged DurableRecord])
(import ^from "../runtime/composition" [acquire_snapshot release_snapshot current_snapshot])
(import [mode_state] ^from "../runtime/input_modes")
(import [ModeChanged CompositionChanged] ^from "../kernel")
(import [ui_status ui_data_revision] ^from "../ui/state")
(import [render_component] ^from "../ui/views")
(import ^from "../runtime/cordis_adapter" [spawn_composition_call])
(import ^from "../ui/components" [bounded_component_view WebComponentError])
(import ^from "../runtime/triggers" ^^export
  [
    open_trigger_manager
    close_trigger_manager
    list_triggers
    create_trigger
    delete_trigger
    list_occurrences])

(type WorkspaceService ^props {^runtime Any ^events Any ^sessions Any ^controller Any ^epoch Str ^publisher Any ^revision Any ^closed Any ^model_info Any ^offline Bool ^subscriptions Any ^snapshot_jobs Any ^snapshot_versions Any ^ui_audience Any?})

(fn public_session [service, record]
  (let copy ($thaw ($freeze record)))
  (copy .put "revision" ($to_str (?? record/revision 0)))
  (let loaded (load_session service/sessions record/id))
  (copy .put "last_round" loaded/round/.get)
  copy)

(fn publish_message [service, kind : Str, session : Str, data, ^reason reason = nil]
  (let publisher service/publisher/.get)
  (if_not ($absent? publisher)
    (let message {^type kind ^session session ^data data})
    (if_not ($absent? reason) (message .put "reason" reason))
    (publisher message))
  nil)

(fn event_record [session : Str, event]
  (let payload event/payload)
  {
    ^seq ($to_str event/seq)
    ^id $"${session}/${event/seq}"
    ^round_id (?? payload/round "")
    ^turn (?? payload/turn 0)
    ^role (if (== payload/initial true)
            "user"
            (if (== event/type "console")
              "log"
              "assistant"))
    ^kind event/type
    ^phase (if (== event/type "turn/response")
             "code"
             (if (== event/type "turn/end")
               "turn/error"
               event/type))
    ^order (?? payload/at_ms event/seq)
    ^text (?? payload/text (?? payload/full ""))
    ^late (== payload/late true)
    ^final (== payload/final true)
    ^patch_files (?? payload/patch_files [])
    ^blobs (?? payload/blobs {})
    ^^durable})

(fn publish_transcript [service, session : Str, event]
  (let kind event/type)
  (if (|| (["turn/response" "turn/request" "turn/patch"] .contains? kind) (&& (== kind "turn/end") (! ($absent? event/payload/text))))
    (publish_message service "turn" session (event_record session event)))
  (if (["reply" "console"] .contains? kind)
    (publish_message service kind session (event_record session event)))
  nil)

(fn queue_snapshot [service, session : Str]
  (if service/closed/.get (return nil))
  (let id ($crypto/random_hex 8))
  (let versions service/snapshot_versions/.get)
  (let version (+ (?? (versions .get session) 0) 1))
  (versions .put session version)
  (let slot ($cell nil))
  (service/snapshot_jobs/.get .put id slot)
  (let job
    (spawn ^lane root
      (try
        (if_not service/closed/.get
          ($runtime/with_context nil
            (fn []
              (let safe (if ($absent? service/ui_audience) false (! (service/ui_audience))))
              (let data (snapshot ^safe safe service session))
              (if (&& (! service/closed/.get)
                       (== (service/snapshot_versions/.get .get session) version))
                (publish_message service "snapshot" session data)))))
      catch Any
        (if_not service/closed/.get
          (publish_message service "error" session
            {^message ($to_str $err/message)}))
      ensure
        (service/snapshot_jobs/.get .delete id))))
  (slot .set job)
  nil)

(fn handle_harness_event [service, event]
  (match event ^!exhaustive
    (when (changed : ModeChanged)
      (publish_message ^reason changed/reason service "mode/state" changed/session changed/mode))
    (when (changed : CompositionChanged)
      (publish_message service "ui/state" "" (ui_status service/runtime/h)))
    (when (record : DurableRecord)
      (if (&& (== record/scope "workspace") (== record/name "plugin/state"))
        (publish_message service "ui/state" "" (ui_status service/runtime/h)))
      (if (== record/scope "session")
        (publish_transcript service record/stream record/envelope)))
    (when (changed : RoundChanged)
      (publish_message service "round/state" changed/session changed/receipt)
      (if (== changed/receipt/state "waiting")
        (publish_message service "questions" changed/session
          changed/receipt/questions))
      (queue_snapshot service changed/session))
    (when (changed : SessionChanged)
      (publish_message service "session/list" "" (list_sessions service))
      (publish_message service "attention" ""
        {^sessions (session_records ^^attention service/sessions)}))
    (when (changed : CommandChanged)
      (let record changed/record)
      (let session changed/session)
      (if_yes (== record/ui_action true)
        (publish_message service "ui/action" "" {^session session ^record record})
        (return nil))
      (if (&& (!= record/name "sh") (! ($absent? record/text)))
        (publish_message service "console" session
          {^id $"${session}/${record/id}/console" ^seq "0"
           ^round_id "" ^turn 0 ^role "log" ^phase "console"
           ^kind "console" ^text record/output ^!late
           ^!durable})
        (publish_message service "command" session record))
      (if ($absent? record/text)
        (queue_snapshot service session))))
  nil)

(fn open_session_service [^workspace workspace : Str = "", ^offline offline : Bool = false,
                          ^profile supplied_profile = nil, ^ownership ownership = nil]
  (let profile (?? supplied_profile (if offline (offline_profile) (baseline_profile))))
  (let runtime
    (open_runtime ^ownership ownership ^event_scope "workspace" ^entry ($path/join ($path/parent this_mod/.path) "server.gene")
      (prepare_workspace_root ^root workspace)
      "default"
      profile))
  (contribute runtime/h "web" "prompt"
    {^name "web_components"
     ^text "This session has a browser frontend. Discover UI capabilities and start with (doc \"harness/ui\") to customize its workspace. Verify the browser as well as server previews."})
  (let settings ($serde/read_data ($fs/read_text $"${runtime/state_root}/config.gene")))
  (let model_info
    (try
      (let selected (select_provider runtime settings))
      {^provider selected/name ^model selected/settings/model
       ^effort selected/settings/effort}
    catch Any
      (let choice (provider_choice runtime settings))
      {^provider choice/name ^model "Unavailable" ^effort ""}))
  (let service
    (WorkspaceService ^runtime runtime ^events runtime/events ^sessions runtime/sessions ^controller nil ^epoch ($crypto/random_hex 16) ^publisher ($cell nil) ^revision ($atomic_cell 0) ^closed ($cell false) ^model_info model_info ^offline offline ^subscriptions [] ^snapshot_jobs ($cell {}) ^snapshot_versions ($cell {})))
  (set service/controller
    (new_round_controller runtime))
  (service/subscriptions .push
    (runtime/h/bus .subscribe HarnessEvent
      (fn [event] (handle_harness_event service event))))
  (provide runtime/h "core" "loop"
    (fn [] {^runtime runtime ^controller service/controller ^^start ^^boot}))
  service)

(fn list_sessions [service, ^after after : Str = "", ^limit limit : Int = 100, ^kind kind = nil, ^status status = nil, ^attention attention = nil, ^trigger trigger = nil, ^q q : Str = "", ^since since : Str = "", ^until until : Str = ""]
  (let results [])
  (for record in (session_records ^kind kind ^status status ^attention attention ^trigger trigger ^q q ^since since ^until until service/sessions)
    (if (&& (!= after "") (<= ($order/compare record/id after) 0)) (continue))
    (if (>= results/.size limit) (break))
    (results .push record))
  {^sessions results ^needs_attention (session_records ^^attention service/sessions) ^next ""})

(fn create_session [service, ^title title : Str = "New conversation"]
  (let record (create_record ^title title service/sessions))
  (public_session service record))

(fn rename_session [service, id : Str, title : Str, revision : Int]
  (edit_session service id {^title title} revision))

(fn edit_session [service, id : Str, changes, revision : Int]
  (let record (require_record service/sessions id))
  (if (!= (?? record/revision 0) revision)
    (fail
      (RoundError ^code "revision_conflict" ^message "Session changed; refresh before editing it.")))
  (let update {^revision (+ revision 1)})
  (if_not ($absent? changes/title)
    (if (|| (!= ($head changes/title) Str) (== ($str/trim changes/title) "") (> ($str/byte_size changes/title) 256))
      (fail (RoundError ^code "invalid_request" ^message "Session title must have 1–256 bytes")))
    (update .put "title" ($str/trim changes/title)))
  (if_not ($absent? changes/pinned)
    (if (!= ($head changes/pinned) Bool)
      (fail (RoundError ^code "invalid_request" ^message "Pinned must be boolean")))
    (update .put "pinned" changes/pinned))
  (let next (update_session service/sessions id update))
  (public_session service next))

(fn acknowledge_attention [service, id : Str]
  (let record (require_record service/sessions id))
  (if record/attention (update_session service/sessions id {^!attention}))
  {^^ok})

(fn submit [service, session : Str, request_id : Str, sequence : Int, text : Str]
  (let parsed (parse_submission service/runtime/h text))
  (if (== parsed/kind "command")
    (submit_command service/runtime/commands session text)
    (submit_round service/controller session request_id sequence parsed/text)))
(fn command [service, session : Str, text : Str, ^request_id request_id : Str = "", ^sequence sequence = nil]
  (submit_command ^request_id request_id ^sequence sequence service/runtime/commands session text))

(fn operator_receipt [service, session : Str, id : Str]
  (require_record service/sessions session)
  (let result (command_receipt service/runtime/commands session id))
  (if ($absent? result) (fail (RoundError ^code "not_found" ^message "Command receipt is not retained.")))
  result)

(fn request_receipt [service, session : Str, request_id : Str, kind : Str]
  (require_record service/sessions session)
  (if_yes (== kind "command")
    (let result (command_request_receipt service/runtime/commands session request_id))
    (if_not ($absent? result) (return result)))
  (if (== kind "round")
    (for record in (/receipts (round_state service/controller session))
      (if (== record/request_id request_id) (return record))))
  (fail (RoundError ^code "not_found" ^message "Request receipt is not retained; do not replay an uncertain operation.")))
(fn cancel_operator_command [service, session : Str, id : Str]
  (cancel_command service/runtime/commands session id))
(fn receipt [service, session : Str, id : Str]
  (require_record service/sessions session)
  (let result (round_receipt service/controller session id))
  (if ($absent? result) (fail (RoundError ^code "not_found" ^message "Round receipt is not retained.")))
  result)
(fn answer [service, session : Str, batch_id : Str, values, ^dismiss dismiss : Bool = false]
  (answer_round ^dismiss dismiss service/controller session batch_id values))
(fn cancel [service, session : Str, id : Str]
  (cancel_round service/controller session id))

(fn snapshot [service, id : Str, ^after after : Int = -1, ^before before : Int = -1, ^safe safe : Bool = false]
  (let metadata (require_record service/sessions id))
  (let loaded (load_session service/sessions id))
  (let records [])
  (var cursor 0)
  (for event in (events_for service/events "session" id)
    (set cursor event/seq)
    (if (&& (>= after 0) (<= event/seq after)) (continue))
    (if (&& (>= before 0) (>= event/seq before)) (continue))
    (if (|| (["turn/response" "turn/request" "turn/patch" "reply" "console"] .contains? event/type) (&& (== event/type "turn/end") (! ($absent? event/payload/text))))
      (records .push (event_record id event))))
  (let commands (command_state service/runtime id))
  (for record in commands/records
    (if (== record/ui_action true) (continue))
    (let seq (?? record/start_seq 0))
    (if (&& (>= after 0) (<= seq after)) (continue))
    (if (&& (>= before 0) (>= seq before)) (continue))
    (if_yes (&& (!= record/name "sh") (!= (?? record/output "") ""))
      (records .push
        {
          ^id $"${id}/${record/id}/console"
          ^seq ($to_str seq)
          ^round_id ""
          ^turn 0
          ^role "log"
          ^phase "console"
          ^kind "console"
          ^text record/output
          ^!late
          ^order (?? record/started_ms 0)
          ^^durable}))
    (records .push
      {
        ^id $"${id}/${record/id}"
        ^seq ($to_str seq)
        ^round_id ""
        ^turn 0
        ^role "assistant"
        ^phase "command"
        ^kind "command"
        ^command_id record/id
        ^input_id (?? record/input_id nil)
        ^mode_instance (?? record/mode_instance nil)
        ^name record/name
        ^raw record/raw
        ^text (?? record/display record/output)
        ^status record/status
        ^view (?? record/view nil)
        ^order (?? record/started_ms 0)
        ^^durable}))
  (let rounds (round_state service/controller id))
  (let ordered ($order/sort_by records (fn [record] (?? record/order 0))))
  (let page [])
  (let start ($math/max 0 (- ordered/.size history_page_limit)))
  (var i 0)
  (for record in ordered
    (if (>= i start) (page .push record))
    (set i (+ i 1)))
  {
    ^protocol protocol_version
    ^session (public_session service metadata)
    ^records page
    ^cursor ($to_str cursor)
    ^preview []
    ^has_older (> start 0)
    ^rounds rounds/receipts
    ^next_command_seq ($to_str commands/next_id)
    ^next_submission_seq ($to_str rounds/next_seq)
    ^round loaded/round/.get
    ^mode (mode_state service/runtime/modes id)
    ^status (host_status ^session id ^safe safe service)
    ^questions (if (== metadata/status "waiting")
                 ((Path "questions") loaded/round/.get)
                 nil)})

(fn web_components [service, session : Str]
  (let metadata (if (== session "") nil (require_record service/sessions session)))
  (let loaded (if (== session "") nil (load_session service/sessions session)))
  (let context
    ($freeze
      {
        ^session_id session
        ^session metadata
        ^round (if ($absent? loaded)
                 nil
                 loaded/round/.get)
        ^workspace service/runtime/root
        ^model service/model_info
        ^sessions (session_records service/sessions)}))
  (let components [])
  (for candidate in (rows service/runtime/h "web_components")
    (if_not ($absent? candidate/view_state) (continue))
    (let item {^name candidate/name ^slot candidate/slot})
    (try
      (let view
        (if ($absent? candidate/render)
          candidate/view
          (render_component service/runtime/h candidate/render context)))
      (item .put "view" view)
    catch Any
      (item .put "error" $err/message))
    (components .push item))
  components)

(fn host_status [service, ^session session : Str = "", ^safe safe : Bool = false]
  (let lease (acquire_snapshot service/runtime/h/snapshots))
  (try
    ($runtime/with_context
      {^composition service/runtime/h/snapshots ^snapshot lease/snapshot ^session session}
      (fn []
        (host_status_in_snapshot ^safe safe service session)))
  ensure
    (release_snapshot service/runtime/h/snapshots lease)))

(fn next_status_sequence [service]
  (loop
    (let current service/revision/.load)
    (if (service/revision .compare_exchange current (+ current 1)) (return current))))

(fn host_status_in_snapshot [service, session : Str, ^safe safe : Bool = false]
  # Capture freshness before callbacks can park. A render begun before a state
  # change must not be stamped with the revision current at its completion.
  (let composition (current_snapshot service/runtime/h/snapshots))
  (let status_revision (ui_data_revision service/runtime/h composition))
  (let status_sequence (next_status_sequence service))
  (let active service/controller/active/.get)
  (let commands [])
  (for row in (rows service/runtime/h "commands")
    (commands .push {^name row/name ^usage row/usage ^doc row/doc}))
  (let plugins [])
  (for plugin in composition/plugins
    (plugins .push {^id plugin/id ^state plugin/status}))
  {
    ^protocol protocol_version
    ^epoch service/epoch
    ^status_session session
    ^status_revision status_revision
    ^status_sequence ($to_str status_sequence)
    ^model service/model_info
    ^profile service/runtime/profile/name
    ^readiness (if ($absent? service/runtime/h/readiness)
      nil (service/runtime/h/readiness))
    ^plugins plugins
    ^web_components (if safe [] (web_components service session))
    ^ui (if safe nil (ui_status service/runtime/h))
    ^commands commands
    ^offline service/offline
    ^workspace service/runtime/root
    ^running ($size active)})

(fn close_session_service [service]
  (if (service/closed .swap true) (return nil))
  (for subscription in service/subscriptions subscription/.cancel)
  (let jobs (service/snapshot_jobs .swap {}))
  (for [id slot] in jobs
    (while ($absent? slot/.get) ($sleep 1))
    (let job slot/.get)
    job/.cancel)
  (for [id slot] in jobs
    (let job slot/.get)
    job/.join)
  (withdraw_seam service/runtime/h "core" "loop")
  (if_not ($absent? service/runtime/triggers)
    (close_trigger_manager service/runtime/triggers))
  (close_round_controller service/controller)
  (close_runtime service/runtime))
