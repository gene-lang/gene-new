# Browser appearance is cookie data, independent of workspace settings.
(mod browser_appearance)
(import ^from "./theme" [builtin_themes])
(import ^from "./theme_registry" [installed_themes theme_catalog themes_revision])
(import ^from "./theme_assets" [active_theme_assets theme_preview_asset])
(import ^from "./request" [cookie_value request_data response])
(import ^from "../runtime/appearance" [AppearanceError AppearanceChanged])
(import ^from "../kernel" [publish])

(const cookie_name "gene_harness_appearance")
(import ^from "./appearance_values" [defaults valid_field? validate_fields])

(fn read_saved [header : Str]
  (let saved {})
  (let value (cookie_value header cookie_name))
  (for part in ($str/split value "&")
    (let pair ($str/split part "="))
    (if_yes (== pair/.size 2)
      (try
        (let name ($url/decode_component pair/0))
        (let value ($url/decode_component pair/1))
        (if (valid_field? name value) (saved .put name value))
      catch Any nil)))
  saved)

(fn encode_saved [saved] : Str
  (let parts [])
  (for name in ["theme" "mode" "density" "text_size" "content_width"]
    (if ($present? (saved .get name))
      (parts .push $"${name}=${($url/encode_component (saved .get name))}")))
  ($str/join parts "&"))

(fn appearance_answer [saved, themes = builtin_themes]
  (let rendered ($thaw ($freeze defaults)))
  (map_for [name value] in saved (rendered .put name value))
  (if ($absent? (themes .get rendered/theme)) (rendered .put "theme" "default"))
  # Invalid inheritance falls back too, without replacing the saved choice.
  (let assets (active_theme_assets rendered/theme themes))
  (rendered .put "theme" assets/name)
  (rendered .put "preloads" (assets/preloads .get rendered/mode))
  (rendered .put "stylesheet" assets/stylesheet)
  (rendered .put "theme_revision" (themes_revision themes))
  {^saved saved ^rendered rendered ^themes (theme_catalog themes)})

(fn appearance_preview_request [request, runtime, safe : Bool = false]
  (let themes (installed_themes runtime safe))
  (let name (?? request/params/theme "default"))
  (try
    (response 200 {^theme name ^revision (themes_revision themes) ^stylesheet (theme_preview_asset name themes)})
  catch Any
    (response 400 {^code "invalid_request" ^message ($to_str $err/message)})))

(fn request_appearance [request, runtime = nil, safe : Bool = false]
  (appearance_answer (read_saved (?? request/headers/cookie "")) (installed_themes runtime safe)))

(fn appearance_link [appearance]
  `(link ^id "harness_theme" ^rel "stylesheet" ^href %appearance/rendered/stylesheet))

(fn appearance_preloads [appearance]
  (let nodes [])
  (for src in (?? appearance/rendered/preloads [])
    (nodes .push `(link ^rel "preload" ^as "font" ^crossorigin "anonymous" ^href %src)))
  nodes)

(fn appearance_request [request, runtime, safe : Bool = false]
  (let saved (read_saved (?? request/headers/cookie "")))
  (if (== request/method "GET")
    (return (response 200 (appearance_answer saved (installed_themes runtime safe)))))
  (let changes (validate_fields (request_data request)))
  (let merged ($thaw ($freeze saved)))
  (map_for [name value] in changes (merged .put name value))
  (let result (response 200 (appearance_answer merged (installed_themes runtime safe))))
  (if_yes (!= saved merged)
    (result/headers .put "set-cookie" $"${cookie_name}=${(encode_saved merged)}; Path=/; HttpOnly; SameSite=Strict; Max-Age=31536000")
    (publish runtime/h (AppearanceChanged ^saved merged)))
  result)
