# Layer ordering is the host contract. Theme and plugin rules are unlayered.
(mod harness_web_style)
(import styles:manager_styles ^from "./style/manager")
(import styles:preferences_styles ^from "./style/preferences")
(import styles:reset_styles ^from "./style/reset")
(import styles:root_styles ^from "./style/base")
(import styles:shell_styles ^from "./style/shell")
(import styles:components_styles ^from "./style/components")
(import styles:content_styles ^from "./style/content")
(import styles:utilities_styles ^from "./style/utilities")

(var base_styles ($to_str "@layer preferences, reset, base, shell, components, content, utilities;\n"
  preferences_styles reset_styles root_styles shell_styles components_styles content_styles utilities_styles manager_styles))
(var styles base_styles)
