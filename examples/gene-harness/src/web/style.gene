(mod harness_web_style)

(var styles """
:root{color-scheme:light;--ink:#17212f;--muted:#687387;--line:#e1e6ed;--blue:#2865dc;--surface:#f6f8fb;font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:16px;line-height:1.5;color:var(--ink);background:var(--surface)}
*{box-sizing:border-box}body{margin:0}button,input,textarea{font:inherit}button{cursor:pointer}button:disabled{cursor:not-allowed;opacity:.48}button,input,textarea{outline-offset:4px}button:focus-visible,input:focus-visible,textarea:focus-visible{outline:2px solid #6ea0ff}button{border:1px solid var(--line);background:white;border-radius:.55rem;color:inherit;padding:.5rem .85rem}button:hover:not(:disabled){background:#edf3fe;border-color:#b5caf0}[hidden]{display:none!important}
.app{height:100dvh;display:grid;grid-template-columns:260px minmax(0,1fr);overflow:hidden}.sidebar{background:#161e2b;color:#f0f4fc;display:flex;flex-direction:column;min-height:0;padding:1.5rem .85rem 1rem;border-right:1px solid #202c3f}.brand{display:flex;align-items:center;gap:.65rem;padding:0 .6rem 1.7rem;font-weight:650;letter-spacing:-.025em}.brand_mark{font:700 1.2rem ui-monospace,monospace;background:#3874e7;border-radius:.5rem;width:2rem;height:2rem;display:grid;place-items:center}.local{margin-left:auto;color:#8ca0bf;font-size:.75rem;letter-spacing:.08em}.sidebar button{background:transparent;color:inherit;border-color:#344156}.sidebar button:hover{background:#263449;border-color:#46648d}.new_session{width:100%;text-align:left;padding:.7rem .9rem}.filter{width:100%;border:0;border-bottom:1px solid #344156;background:transparent;color:#e1e8f4;padding:.7rem .4rem;margin:1rem 0 .75rem;font-size:.875rem;border-radius:0}.filter::placeholder{color:#8391a8}.session_list{overflow:auto;flex:1;min-height:0}.session{width:100%;display:flex;flex-direction:column;gap:.2rem;text-align:left;padding:.75rem .8rem!important;border:1px solid transparent!important;margin:.15rem 0}.session.selected{background:#233550!important;border-color:#35517b!important;box-shadow:inset 3px 0 #70a0ff}.session_name{font-size:.875rem;width:100%;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.session_meta{font-size:.75rem;color:#98a8c0}.sidebar_empty{font-size:.875rem;color:#94a2b9;padding:.6rem}.sidebar_footer{border-top:1px solid #344156;padding-top:.85rem;margin-top:1rem}.sidebar_footer button{border:0;font-size:.875rem;width:100%;text-align:left}.sidebar_footer p{font-size:.75rem;color:#8391a8;margin:.6rem .6rem 0}.mobile_only{display:none}
.workspace{display:flex;flex-direction:column;min-width:0;min-height:0;background:#fafbfd}.topbar{display:flex;align-items:center;gap:1rem;padding:1rem 2rem;border-bottom:1px solid var(--line);background:#fff;min-height:81px}.topbar h1{font-size:1rem;font-weight:600;letter-spacing:-.015em;margin:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.heading{min-width:0;flex:1}.mode{font-size:.75rem;color:var(--muted);margin-top:.15rem}.quiet{font-size:.875rem;background:transparent;border-color:transparent;color:var(--muted)}.transcript{overflow:auto;flex:1;min-height:0;padding:2rem max(2rem,calc((100% - 850px)/2));scroll-behavior:auto}.empty_state{max-width:600px;margin:clamp(2rem,10vh,7rem) auto 3rem;text-align:center}.gene_mark{height:3.4rem;width:3.4rem;display:grid;place-items:center;margin:auto auto 1.4rem;color:#2761ca;background:#e6edfc;border:1px solid #d7e2f7;border-radius:1rem;font:600 1.6rem ui-monospace,monospace}.empty_state h2{font-size:1.65rem;line-height:1.25;letter-spacing:-.04em;font-weight:550;margin:.75rem 0}.empty_state p{font-size:.95rem;color:var(--muted);max-width:26rem;margin:.8rem auto 1.5rem}.suggestions{display:flex;justify-content:center;gap:.7rem;flex-wrap:wrap}.suggestions button{font-size:.875rem;padding:.55rem .9rem}
.message{margin:0 auto 1.8rem;max-width:850px}.speaker{font-size:.8rem;color:var(--muted);font-weight:600;margin:0 0 .55rem}.user{padding:1rem 1.15rem;background:#edf2fa;border:1px solid #e1e8f3;border-radius:.8rem;margin-left:clamp(0rem,8%,4rem)}.user .speaker{color:#3c5b87}.agent{padding:.15rem 0}.message_text{white-space:pre-wrap;overflow-wrap:anywhere}.provisional .speaker{color:#466dba}.execution{border:1px solid #dce3ef;border-radius:.65rem;background:#fff;overflow:hidden;position:relative}.execution summary{font-size:.875rem;font-weight:550;padding:.8rem 1rem;cursor:pointer;background:#f1f4f9}.execution pre{overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere;margin:0;padding:1.1rem;font-size:.875rem;line-height:1.6;background:#f8faff}.copy{font-size:.75rem;float:right;margin:.5rem .7rem .1rem}.muted{color:var(--muted);font-size:.8rem}.run_status{font-size:.875rem;color:#697a93;max-width:850px;margin:1rem auto}.new_output{align-self:center;border-radius:2rem;margin:.25rem 0 .7rem;font-size:.875rem;box-shadow:0 2px 8px #26334d13}.composer_wrap{padding:.75rem max(2rem,calc((100% - 900px)/2)) 1.25rem;background:linear-gradient(transparent,#fafbfd 1rem)}.composer{padding:.65rem .7rem .65rem 1rem;background:white;border:1px solid #cbd6e6;border-radius:.9rem;box-shadow:0 3px 14px #29374908}.composer:focus-within{border-color:#7ca2e2;box-shadow:0 0 0 3px #2b68d80d}.composer textarea{display:block;width:100%;resize:vertical;min-height:4rem;max-height:14rem;border:0;background:transparent;padding:.35rem .35rem .7rem 0;outline:none;color:var(--ink)}.composer_actions{display:flex;align-items:center;gap:.6rem}.composer_actions .hint{font-size:.75rem;color:#7f899b;flex:1}.send{background:var(--blue);border-color:var(--blue);color:white;min-width:5rem}.send:hover:not(:disabled){background:#1c53bc;border-color:#1c53bc}.stop{color:#b13939;border-color:#e8bcbc;background:#fff9f9}.notice{font-size:.875rem;color:#8c4b31;min-height:1.6rem;padding:.5rem .2rem .15rem}.composer_footer{font-size:.75rem;color:#7a8597;display:flex;justify-content:space-between;margin:.5rem .2rem 0}.commands{max-height:14rem;overflow:auto;border:1px solid var(--line);background:#fff;padding:.4rem;border-radius:.7rem;margin-bottom:.5rem}.command{width:100%;display:flex;gap:.9rem;align-items:baseline;text-align:left;border:0;font-size:.875rem}.command strong{min-width:7rem;font:550 .875rem ui-monospace,monospace}.command span{color:var(--muted)}.resolve{font-size:.8rem;padding:.25rem .5rem;margin-left:.5rem}
.drawer{position:fixed;right:1rem;top:6rem;z-index:3;max-width:calc(100vw - 2rem);width:320px;padding:1.5rem;border:1px solid var(--line);border-radius:.8rem;background:white;box-shadow:0 12px 40px #17212f1c}.drawer h2{font-size:1.05rem;margin:0 0 1rem}.drawer p{font-size:.875rem;color:var(--muted)}.plugin_status{display:flex;justify-content:space-between;gap:1rem;padding:.55rem 0;border-bottom:1px solid #edf0f5;font-size:.875rem}.plugin_status span:last-child{color:#527361}.rename_form{display:flex;gap:.5rem;padding:.7rem 2rem;background:#f0f4fb;border-bottom:1px solid var(--line)}.rename_form input{min-width:0;flex:1;border:1px solid #cbd6e6;padding:.4rem .65rem;border-radius:.4rem}.auth_notice{padding:.8rem 2rem;background:#fff3df;color:#754b13;font-size:.875rem}.auth_notice strong{display:block;margin-bottom:.2rem}
@media(max-width:760px){.app{grid-template-columns:1fr}.sidebar{display:none}.menu_open .sidebar{display:flex;position:fixed;inset:0 auto 0 0;width:min(85vw,300px);z-index:5;box-shadow:0 0 0 100vmax #0e172755}.mobile_only{display:inline-block}.brand{padding-bottom:1rem}.close_menu{margin:0 0 1rem}.topbar{padding:.85rem 1rem;gap:.6rem}.transcript{padding:1.5rem 1rem}.composer_wrap{padding:.5rem 1rem 1rem}.composer_actions .hint{font-size:.7rem}.empty_state h2{font-size:1.4rem}.empty_state{margin:3rem auto 1rem}.composer_footer{font-size:.7rem}.rename_form,.auth_notice{padding:.7rem 1rem}.drawer{top:5.5rem}.user{margin-left:1.1rem}}
.run{max-width:850px;margin:0 auto 2rem}.run+.run{border-top:1px solid var(--line);padding-top:1.5rem}.run .message{margin-bottom:1rem}.step{border:1px solid var(--line);border-radius:.65rem;background:#fff;margin:.6rem 0}.step>summary{cursor:pointer;padding:.65rem .9rem;font-size:.875rem;color:#50617a}.step[open]>summary{border-bottom:1px solid var(--line)}.step_content{padding:.75rem}.step_content .speaker{display:none}.step_content .message{margin:0 0 .6rem}.step_content .message:last-child{margin-bottom:0}.step .execution summary{padding:.5rem .75rem;font-weight:500}.step .execution pre{padding:.75rem}.run_status{display:flex;flex-wrap:wrap;align-items:center;gap:.4rem .75rem;margin:.8rem 0 0;font-size:.8rem}.run_error{color:#a43232}.outcome_message{color:var(--muted)}.edit_retry{font-size:.8rem;padding:.25rem .55rem}.markdown{overflow-wrap:anywhere}.markdown p{margin:.6rem 0}.markdown>:first-child{margin-top:0}.markdown>:last-child{margin-bottom:0}.markdown h1,.markdown h2,.markdown h3,.markdown h4,.markdown h5,.markdown h6{line-height:1.3;margin:1.1rem 0 .6rem}.markdown h1{font-size:1.45rem}.markdown h2{font-size:1.25rem}.markdown h3{font-size:1.1rem}.markdown ul,.markdown ol{padding-left:1.5rem;margin:.6rem 0}.markdown li{margin:.3rem 0}.markdown a{color:#245dbe;text-decoration:underline;text-underline-offset:2px}.markdown code{font: .875em ui-monospace,monospace;background:#edf1f7;border-radius:.25rem;padding:.1rem .25rem}.markdown pre{overflow:auto;white-space:pre;padding:.9rem;border:1px solid var(--line);border-radius:.55rem;background:#f4f7fb}.markdown pre code{padding:0;background:none}.table_scroll{overflow:auto;margin:.8rem 0}.markdown table{border-collapse:collapse;min-width:18rem;font-size:.925rem}.markdown th,.markdown td{padding:.5rem .8rem;border:1px solid var(--line);text-align:left}.markdown th{background:#edf2fa;font-weight:600}.markdown .align_right{text-align:right}.markdown .align_center{text-align:center}.commands .muted{padding:.25rem .65rem}
.input_panel{border:1px solid #b5caf0;border-radius:.7rem;background:#f0f5ff;padding:1rem;margin-bottom:.65rem}.input_panel strong{display:block;margin-bottom:.6rem}.input_panel textarea,.input_panel select{width:100%;padding:.5rem;border:1px solid #cbd6e6;border-radius:.4rem;background:white}.input_actions{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:.7rem}.input_fields{max-height:12rem;overflow:auto}.input_option{display:flex;gap:.5rem;align-items:center;padding:.2rem}.input_actions button{font-size:.875rem}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
""")
