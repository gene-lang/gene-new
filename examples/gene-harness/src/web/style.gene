(mod harness_web_style)
(import ^from "./theme" [theme_css])

# Colors come from the theme tokens (./theme). Corners are square everywhere
# except on buttons; see docs/theming.md.
(var base_styles """
:root {
  --content-width: 760px;
  font-family: var(--font-sans);
  font-size: 16px;
  line-height: 1.6;
  color: var(--ink);
  background: var(--surface);
}
*, *::before, *::after { box-sizing: border-box; border-radius: 0; }
body { margin: 0; }
button, input, textarea, select { font: inherit; }
button, a, input, textarea, select, summary { outline-offset: 4px; }
:focus-visible { outline: 2px solid var(--accent); }
button { cursor: pointer; border: 1px solid var(--line); border-radius: var(--radius-button); background: transparent; color: inherit; padding: .45rem .8rem; }
/* Buttons that read as rows, tabs or links stay square. */
.session, .session_tab button, .command, .notification_local, .occurrence,
.sidebar_footer button, .suggestions button, .ui_panel td button,
.older_messages, .web_image_grid > .web_image_point { border-radius: 0; }
button:hover:not(:disabled) { background: var(--soft); }
button:disabled { cursor: not-allowed; opacity: .45; }
a { color: inherit; }
input, textarea, select { color: var(--ink); }
option { color: var(--ink); background: var(--surface); }
input[type=checkbox], input[type=radio], progress { accent-color: var(--accent); }
input::placeholder, textarea::placeholder { color: var(--muted); opacity: 1; }
[hidden] { display: none !important; }

/* Navigation */
.app {
  display: grid; grid-template-columns: 232px minmax(0, 1fr); height: 100dvh; overflow: hidden; }
.sidebar { display: flex; flex-direction: column; min-height: 0; padding: 1.6rem .9rem 1rem; background: var(--sidebar); }
.sidebar_content { display: flex; flex: 1; flex-direction: column; min-height: 0; }
.brand { display: flex; align-items: baseline; gap: .45rem; padding: 0 .65rem 2.2rem; }
.brand_name { font-size: 1.4rem; font-weight: 650; letter-spacing: -.065em; }
.brand_detail { font-size: .85rem; color: var(--muted); }
.local { margin-left: auto; font-size: .65rem; color: var(--muted); }
.local::before { content: ""; display: inline-block; width: 6px; height: 6px; margin-right: .35rem; background: var(--accent); vertical-align: middle; }
.new_session { display: flex; align-items: center; gap: .65rem; width: 100%; padding: .55rem .65rem; text-align: left; border-color: var(--line); font-size: .85rem; }
.new_session .plus { font-size: 1.15rem; line-height: 1; font-weight: 400; color: var(--muted); }
.filter { width: 100%; min-width: 0; border: 0; background: transparent; padding: .6rem .65rem; margin: 1rem 0 .8rem; font-size: .8rem; }
.filter:focus { background: var(--surface); }
.section_label { padding: .35rem .65rem .65rem; font-size: .68rem; font-weight: 500; color: var(--muted); letter-spacing: .07em; text-transform: uppercase; }
.session_list { flex: 1; min-height: 0; overflow: auto; }
.session { display: flex; flex-direction: column; gap: .08rem; width: 100%; border: 0; padding: .6rem .65rem; margin: .15rem 0; text-align: left; }
.session.selected { background: var(--selected-surface); }
.session_name { width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: .82rem; }
.session.selected .session_name { font-weight: 550; }
.session_meta { color: var(--muted); font-size: .7rem; }
.sidebar_empty { margin: 0; padding: .4rem .65rem; color: var(--muted); font-size: .8rem; line-height: 1.6; }
.sidebar_footer { border-top: 1px solid var(--line); margin-top: 1rem; padding-top: .75rem; }
.sidebar_footer button, .sidebar_footer a { display: block; width: 100%; border: 0; padding: .45rem .65rem; font-size: .78rem; text-align: left; color: var(--muted); text-decoration: none; }
.sidebar_footer a:hover { background: var(--soft); color: var(--ink); }
.mobile_only { display: none; }

/* Conversation */
.session_filters { display: grid; gap: .35rem; margin-bottom: .65rem; font-size: .75rem; }
.session_filters select, .session_filters input { width: 100%; min-width: 0; border: 1px solid var(--edge); padding: .3rem; background-color: var(--input-surface); }
.session_filters details { color: var(--muted); }
.session_filters label { display: grid; gap: .15rem; margin-top: .35rem; }
#attention_sessions { max-height: 180px; overflow: auto; border-left: 2px solid var(--accent); }
.session_tab_bar { display: flex; flex-shrink: 0; align-items: center; gap: .35rem; min-width: 0; padding: .5rem 1rem 0; }
.session_tab_bar .menu_toggle { flex-shrink: 0; width: 36px; height: 36px; padding: .3rem; font-size: 1.25rem; line-height: 1; }
.session_tabs { display: flex; flex: 1; gap: .35rem; min-width: 0; overflow: auto; }
.session_tab { display: flex; flex-shrink: 0; border: 1px solid var(--line); font-size: .75rem; max-width: 260px; }
.session_tab.selected { background: var(--soft); border-color: var(--accent); }
.session_tab button { border: 0; padding: .3rem .5rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.session_tab small { display: block; color: var(--muted); font-size: .65rem; }
.console_pane { flex-shrink: 0; padding: .3rem 2rem; border-top: 1px solid var(--line); font-size: .75rem; }
.console_pane summary { cursor: pointer; color: var(--muted); }
.console_pane pre { max-height: 160px; margin: .5rem 0; overflow: auto; white-space: pre-wrap; overflow-wrap: anywhere; }
.trigger_row { display: flex; justify-content: space-between; margin: .5rem 0; gap: .4rem; }
.trigger_row small { display: block; color: var(--muted); }
.trigger_create { margin-top: 1.5rem; }
.trigger_create form, .trigger_create label { display: grid; gap: .4rem; margin: .6rem 0; }
.trigger_create input, .trigger_create textarea, .trigger_create select { min-width: 0; padding: .35rem; border: 1px solid var(--edge); background-color: var(--input-surface); }
.occurrence { display: grid; gap: .25rem; width: 100%; margin: .5rem 0; text-align: left; font-size: .75rem; }
.workspace { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
.topbar { display: flex; align-items: center; flex-shrink: 0; gap: 1rem; min-height: 76px; padding: 1rem 2.25rem; }
.heading { flex: 1; min-width: 0; }
.topbar h1 { margin: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: .88rem; font-weight: 550; letter-spacing: -.015em; }
.mode { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; margin-top: .1rem; color: var(--muted); font-size: .7rem; }
.quiet { border-color: transparent; color: var(--muted); font-size: .78rem; }
.web_components:empty { display: none; }
.web_components { display: grid; gap: .65rem; }
.web_toolbar { display: flex; flex-wrap: wrap; padding: 0 2.25rem .65rem; }
.plugin_component { min-width: 0; }

.web_image_surface { position: relative; width: 100%; max-width: 960px; margin: .8rem auto; line-height: 0; }
.web_image_surface > img { display: block; width: 100%; height: auto; }
.plugin_component img, .ui_panel img { max-width: 100%; }
.web_image_grid { position: absolute; inset: 0; display: grid; grid-auto-rows: 1fr; gap: 0; }
.web_image_grid > .web_image_point { display: flex; align-items: center; justify-content: center; min-width: 0; min-height: 0; padding: 0; margin: 0; border: 0; background: transparent; line-height: 0; }
.web_image_point > img { display: block; width: 96%; height: 96%; pointer-events: none; }
.web_image_grid > .web_image_point:disabled { opacity: 1; cursor: default; }
.web_image_grid > .web_image_point:not(:disabled):hover { background: color-mix(in srgb, var(--surface) 22%, transparent); }
.web_image_grid > .web_image_point:focus-visible { outline: 3px solid var(--accent); outline-offset: -3px; z-index: 1; }

.web_image_grid[data-inset="0"] { inset: 0%; }
.web_image_grid[data-inset="1"] { inset: 1%; }
.web_image_grid[data-columns="1"] { grid-template-columns: repeat(1, minmax(0, 1fr)); }
.web_image_grid[data-inset="2"] { inset: 2%; }
.web_image_grid[data-columns="2"] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.web_image_grid[data-inset="3"] { inset: 3%; }
.web_image_grid[data-columns="3"] { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.web_image_grid[data-inset="4"] { inset: 4%; }
.web_image_grid[data-columns="4"] { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.web_image_grid[data-inset="5"] { inset: 5%; }
.web_image_grid[data-columns="5"] { grid-template-columns: repeat(5, minmax(0, 1fr)); }
.web_image_grid[data-inset="6"] { inset: 6%; }
.web_image_grid[data-columns="6"] { grid-template-columns: repeat(6, minmax(0, 1fr)); }
.web_image_grid[data-inset="7"] { inset: 7%; }
.web_image_grid[data-columns="7"] { grid-template-columns: repeat(7, minmax(0, 1fr)); }
.web_image_grid[data-inset="8"] { inset: 8%; }
.web_image_grid[data-columns="8"] { grid-template-columns: repeat(8, minmax(0, 1fr)); }
.web_image_grid[data-inset="9"] { inset: 9%; }
.web_image_grid[data-columns="9"] { grid-template-columns: repeat(9, minmax(0, 1fr)); }
.web_image_grid[data-inset="10"] { inset: 10%; }
.web_image_grid[data-columns="10"] { grid-template-columns: repeat(10, minmax(0, 1fr)); }
.web_image_grid[data-inset="11"] { inset: 11%; }
.web_image_grid[data-columns="11"] { grid-template-columns: repeat(11, minmax(0, 1fr)); }
.web_image_grid[data-inset="12"] { inset: 12%; }
.web_image_grid[data-columns="12"] { grid-template-columns: repeat(12, minmax(0, 1fr)); }
.web_image_grid[data-inset="13"] { inset: 13%; }
.web_image_grid[data-columns="13"] { grid-template-columns: repeat(13, minmax(0, 1fr)); }
.web_image_grid[data-inset="14"] { inset: 14%; }
.web_image_grid[data-columns="14"] { grid-template-columns: repeat(14, minmax(0, 1fr)); }
.web_image_grid[data-inset="15"] { inset: 15%; }
.web_image_grid[data-columns="15"] { grid-template-columns: repeat(15, minmax(0, 1fr)); }
.web_image_grid[data-inset="16"] { inset: 16%; }
.web_image_grid[data-columns="16"] { grid-template-columns: repeat(16, minmax(0, 1fr)); }
.web_image_grid[data-inset="17"] { inset: 17%; }
.web_image_grid[data-columns="17"] { grid-template-columns: repeat(17, minmax(0, 1fr)); }
.web_image_grid[data-inset="18"] { inset: 18%; }
.web_image_grid[data-columns="18"] { grid-template-columns: repeat(18, minmax(0, 1fr)); }
.web_image_grid[data-inset="19"] { inset: 19%; }
.web_image_grid[data-columns="19"] { grid-template-columns: repeat(19, minmax(0, 1fr)); }
.web_image_grid[data-inset="20"] { inset: 20%; }
.web_image_grid[data-columns="20"] { grid-template-columns: repeat(20, minmax(0, 1fr)); }
.web_image_grid[data-inset="21"] { inset: 21%; }
.web_image_grid[data-columns="21"] { grid-template-columns: repeat(21, minmax(0, 1fr)); }
.web_image_grid[data-inset="22"] { inset: 22%; }
.web_image_grid[data-columns="22"] { grid-template-columns: repeat(22, minmax(0, 1fr)); }
.web_image_grid[data-inset="23"] { inset: 23%; }
.web_image_grid[data-columns="23"] { grid-template-columns: repeat(23, minmax(0, 1fr)); }
.web_image_grid[data-inset="24"] { inset: 24%; }
.web_image_grid[data-columns="24"] { grid-template-columns: repeat(24, minmax(0, 1fr)); }
.web_image_grid[data-inset="25"] { inset: 25%; }
.web_image_grid[data-columns="25"] { grid-template-columns: repeat(25, minmax(0, 1fr)); }
.web_card { border: 1px solid var(--line); padding: 1rem; background: var(--surface); }
/* Conversation cards (docs/cards.md): the host draws the title and controls. */
.card_block { margin: .75rem 0; border: 1px solid var(--line); background: var(--surface); }
.card_header { display: flex; gap: .75rem; align-items: baseline; justify-content: space-between; padding: .55rem .85rem; border-bottom: 1px solid var(--line); background: var(--soft); }
.card_title { letter-spacing: -.02em; }
.card_status { color: var(--muted); font-size: .8rem; }
.card_body { padding: .75rem .85rem; min-width: 0; overflow-x: auto; }
.card_body img { max-width: 100%; }
.card_body button, .question_view button { margin: .25rem .4rem .25rem 0; }
.card_body input, .card_body textarea, .card_body select { max-width: 100%; padding: .4rem; border: 1px solid var(--edge); background-color: var(--input-surface); }
.card_controls { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; padding: 0 .85rem; }
.card_controls:not(:empty) { padding: .5rem .85rem .75rem; }
.card_error { margin: 0; color: var(--danger, var(--ink)); }
.card_update { margin: .4rem 0; color: var(--muted); font-size: .85rem; }
.card_question { padding: .5rem .85rem; }
.card_question p { margin: .2rem 0; }
.card_selected, button[aria-pressed=true] { border-color: var(--accent); outline: 2px solid var(--accent); }
.card_answered button[aria-pressed=true]:disabled { opacity: 1; }
.web_card h2, .web_card h3, .web_card h4 { margin: 0 0 .5rem; letter-spacing: -.025em; }
.web_card p { margin: .4rem 0; color: var(--muted); line-height: 1.5; }
.web_grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: .65rem; }
.web_actions { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem; margin-top: .65rem; }
.web_badge { display: inline-block; padding: .15rem .45rem; background: var(--soft); color: var(--ink); font-size: .72rem; }
.web_metric { font-size: 1.8rem; font-weight: 550; letter-spacing: -.04em; }
.web_muted { color: var(--muted); font-size: .8rem; }
#web_sidebar { margin: .6rem 0; }
#web_sidebar .web_card { padding: .75rem; font-size: .8rem; }
#web_sidebar .web_grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .5rem; }
#web_sidebar .web_metric { font-size: 1.4rem; }
#web_sidebar .web_grid small { display: block; }
#web_composer { margin-bottom: .65rem; }
#web_status { margin-top: 1rem; }
#rename_session:disabled { visibility: hidden; }
.transcript { flex: 1; min-height: 0; overflow: auto; padding: 2rem max(2rem, calc((100% - var(--content-width)) / 2)); scrollbar-gutter: stable; }
.transcript:has(> .empty_state) { display: flex; align-items: center; }
.empty_state { width: 100%; max-width: var(--content-width); margin: auto; padding: 2rem 0 5rem; }
.empty_state h2 { max-width: 480px; margin: 0 0 1rem; font-size: clamp(1.8rem, 2.7vw, 2.4rem); line-height: 1.22; font-weight: 450; letter-spacing: -.045em; text-wrap: balance; }
.empty_state p { margin: 0; max-width: 400px; font-size: .95rem; color: var(--muted); }
.suggestions { display: flex; flex-wrap: wrap; gap: .4rem 1.5rem; margin-top: 1.8rem; }
.suggestions button { display: flex; align-items: center; gap: .85rem; border: 0; padding: .35rem 0; font-size: .82rem; color: var(--muted); }
.suggestions button:hover:not(:disabled) { color: var(--ink); background: transparent; }
.suggestions .suggestion_symbol { font-size: .9rem; color: var(--accent); }
.run { max-width: var(--content-width); margin: 0 auto 2.75rem; }
.run + .run { padding-top: 1.25rem; }
.message { max-width: var(--content-width); margin: 0 auto 1.75rem; }
.speaker { margin: 0 0 .55rem; color: var(--muted); font-size: .72rem; font-weight: 550; }
.user { width: fit-content; max-width: 90%; margin-left: auto; margin-right: 0; padding: .85rem 1.1rem; text-align: left; color: var(--ink); background: var(--user); }
.agent { padding: .2rem 0; }
.message_text { white-space: pre-wrap; overflow-wrap: anywhere; font-size: .94rem; }
.provisional .speaker { color: var(--accent); }
.step { margin: 1rem 0 1.4rem; border-left: 1px solid var(--line); padding-left: 1rem; }
.step > summary { cursor: pointer; color: var(--muted); font-size: .78rem; padding: .25rem 0; }
.step_content { padding: .55rem 0 0; }
.step_content .speaker { display: none; }
.step_content .message { margin: 0 0 .5rem; }
.step_content .message:last-child { margin-bottom: 0; }
.execution { position: relative; overflow: hidden; }
.execution[open] { background: var(--code-surface); }
.execution summary { padding: .5rem .7rem; cursor: pointer; color: var(--muted); font-size: .78rem; }
.execution pre { margin: 0; padding: .8rem 1rem 1rem; overflow: auto; white-space: pre-wrap; overflow-wrap: anywhere; font-size: .82rem; line-height: 1.65; }
.copy { float: right; margin: .1rem .7rem; padding: .2rem .5rem; font-size: .7rem; color: var(--muted); border: 0; }
.source_preview { overflow: hidden; border: 1px solid var(--line); background: var(--code-surface); }
.source_header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .45rem .8rem; border-bottom: 1px solid var(--line); font-size: .75rem; color: var(--muted); }
.source_path { min-width: 0; overflow-wrap: anywhere; }
.source_header .copy { float: none; flex-shrink: 0; margin: 0; }
.source_pre, .user_code { margin: 0; padding: 1rem; overflow: auto; white-space: pre; tab-size: 2; font: .82rem/1.7 var(--font-mono); }
.source_pre { max-height: 32rem; }
.user_code { padding: 0; }
.source_notice { padding: 0 1rem; }
.muted { color: var(--muted); font-size: .78rem; }
.run_status { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem .65rem; margin: .75rem 0 0; font-size: .72rem; color: var(--muted); }
.run_error { color: var(--danger); }
.outcome_message { color: var(--muted); }
.edit_retry { font-size: .72rem; padding: .2rem .5rem; }
.input_mode #prompt { font-family: var(--font-mono); }
.older_messages { display: block; margin: 0 auto 1.5rem; border: 0; font-size: .78rem; color: var(--muted); }
.new_output { align-self: center; margin: 0 0 .5rem; padding: .35rem .8rem; border-color: var(--edge); background: var(--surface); font-size: .78rem; }

/* Composer and transient controls */
.composer_wrap { flex-shrink: 0; padding: .75rem max(2rem, calc((100% - var(--content-width)) / 2)) 1.8rem; }
.composer { border: 1px solid var(--edge); padding: .8rem .8rem .65rem 1rem; background: var(--input-surface); }
.composer:focus-within { border-color: var(--accent); }
.media_picker { display: flex; align-items: center; flex-wrap: wrap; gap: .4rem 1rem; padding: .35rem 0 .6rem; color: var(--muted); font-size: .72rem; }
.media_picker label { display: flex; align-items: center; gap: .5rem; }
.media_picker input { max-width: 17rem; font-size: .72rem; }
.media_drafts, .message_attachments { display: flex; flex-wrap: wrap; gap: .65rem; }
.media_drafts:empty { display: none; }
.media_drafts { max-height: 12rem; overflow: auto; margin-bottom: .6rem; }
.attachment_draft { display: flex; flex-direction: column; gap: .3rem; max-width: 14rem; padding: .5rem; border: 1px solid var(--line); }
.attachment { display: flex; flex-direction: column; gap: .3rem; max-width: 16rem; overflow-wrap: anywhere; font-size: .8rem; }
.attachment img { display: block; max-width: 100%; width: auto; max-height: 8rem; object-fit: contain; }
.message_attachments { margin-top: .6rem; }
.attachment_draft small { color: var(--muted); }
.attachment_draft button { align-self: flex-start; font-size: .7rem; padding: .15rem .45rem; }
.composer textarea { display: block; width: 100%; min-height: 3.4rem; max-height: 28dvh; resize: vertical; padding: .1rem .2rem .55rem 0; border: 0; outline: none; background: transparent; font-size: .94rem; line-height: 1.6; }
.composer_actions { display: flex; align-items: center; gap: .6rem; }
.composer_actions .hint { flex: 1; color: var(--muted); font-size: .68rem; }
.send { min-width: 4rem; border-color: var(--ink); background: var(--ink); color: var(--action-ink); font-size: .8rem; padding: .4rem .9rem; }
.send:hover:not(:disabled) { background: var(--muted); border-color: var(--muted); }
.stop { color: var(--accent); border-color: var(--line); font-size: .8rem; }
.notice { color: var(--accent); padding: .5rem .1rem 0; font-size: .78rem; }
.notice:empty { padding: 0; }
.notice { max-height: 8rem; overflow: auto; }
.notice_item { padding: .3rem 0; overflow-wrap: anywhere; color: var(--ink); }
.notice_item[data-severity="error"] { border-left: 3px solid var(--danger); padding-left: .6rem; }
.confirmation { border: 1px solid var(--accent); padding: .75rem; margin-top: .5rem; }
.confirmation button { margin: .4rem; }
.drawer.notification_center { width: 440px; }
.notification_card { padding: .75rem 0; border-top: 1px solid var(--line); overflow-wrap: anywhere; }
.notification_card h3 { margin: .3rem 0; font-size: 1rem; }
.notification_card button, .question_editor button { margin: .4rem .4rem .4rem 0; }
.notification_questions { border: 0; padding: 0; min-width: 0; }
.question_editor fieldset { min-width: 0; margin: .5rem 0; border: 1px solid var(--line); }
.question_editor textarea, .question_editor select { width: 100%; max-width: 100%; padding: .5rem; border: 1px solid var(--edge); background-color: var(--input-surface); }
.question_editor label { display: block; }
.notification_local { display: block; width: 100%; text-align: left; padding: .6rem; overflow-wrap: anywhere; }
#notification_reference_text { white-space: pre-wrap; overflow-wrap: anywhere; max-height: 20rem; overflow: auto; }
.commands { max-height: min(15rem, 35dvh); overflow: auto; border: 1px solid var(--edge); padding: .35rem; margin-bottom: .55rem; background: var(--input-surface); }
.command { display: flex; align-items: baseline; gap: 1rem; width: 100%; padding: .5rem .6rem; text-align: left; border: 0; font-size: .8rem; }
.command strong { min-width: 6.5rem; font: 500 .8rem var(--font-mono); }
.command span { color: var(--muted); }
.commands .muted { padding: .25rem .65rem; }
.resolve { font-size: .75rem; margin-top: .4rem; }
.drawer { position: fixed; right: 1.25rem; top: 4.5rem; z-index: 6; width: 320px; max-width: calc(100vw - 2.5rem); max-height: calc(100dvh - 6rem); overflow: auto; padding: 1.25rem; border: 1px solid var(--edge); background: var(--surface); }
.drawer_header { display: flex; align-items: center; justify-content: space-between; gap: .5rem; margin-bottom: .8rem; }
.drawer h2 { margin: 0; font-size: .92rem; font-weight: 550; }
.drawer p { font-size: .8rem; color: var(--muted); }
.drawer_close { border: 0; padding: .15rem .45rem; color: var(--muted); font-size: 1.25rem; line-height: 1.2; }
.plugin_status { display: flex; justify-content: space-between; gap: 1rem; padding: .5rem 0; border-bottom: 1px solid var(--line); font-size: .78rem; overflow-wrap: anywhere; }
.plugin_status span:last-child { color: var(--accent); }
.rename_form { display: flex; gap: .5rem; padding: .5rem 2.25rem 1rem; }
.rename_form input { flex: 1; min-width: 0; padding: .4rem .65rem; border: 1px solid var(--edge); background: var(--input-surface); font-size: .85rem; }
.rename_form button { font-size: .8rem; }
.auth_notice { padding: .75rem 2.25rem; border-block: 1px solid var(--line); background: var(--notice-surface); color: var(--ink); font-size: .78rem; }
.auth_notice strong { display: block; font-weight: 550; margin-bottom: .1rem; }
.input_panel { padding: 1rem; margin-bottom: .75rem; border: 1px solid var(--line); background: var(--notice-surface); }
.input_panel strong { display: block; margin-bottom: .65rem; font-size: .9rem; font-weight: 550; }
.input_panel textarea, .input_panel select { width: 100%; border: 1px solid var(--edge); padding: .5rem; background-color: var(--input-surface); font-size: .9rem; }
.input_actions { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .7rem; }
.input_actions button { font-size: .78rem; }
#input_fields { max-height: 12rem; overflow: auto; }
.input_option { display: flex; gap: .5rem; align-items: center; padding: .25rem 0; }

/* Rich text keeps its own quiet hierarchy. */
.markdown { overflow-wrap: anywhere; font-size: .94rem; line-height: 1.75; }
.markdown p { margin: .7rem 0; }
.markdown > :first-child { margin-top: 0; }
.markdown > :last-child { margin-bottom: 0; }
.markdown h1, .markdown h2, .markdown h3, .markdown h4, .markdown h5, .markdown h6 { line-height: 1.35; margin: 1.4rem 0 .65rem; font-weight: 600; letter-spacing: -.02em; }
.markdown h1 { font-size: 1.4rem; }
.markdown h2 { font-size: 1.2rem; }
.markdown h3 { font-size: 1.05rem; }
.markdown ul, .markdown ol { padding-left: 1.4rem; margin: .65rem 0; }
.markdown li { margin: .25rem 0; }
.markdown a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
.markdown code { font: .875em var(--font-mono); background: var(--soft); padding: .12rem .25rem; }
.markdown pre { margin: .9rem 0; overflow: auto; white-space: pre; padding: 1rem; border: 0; background: var(--code-surface); }
.markdown pre code { padding: 0; background: none; }
.markdown blockquote { margin: 1rem 0; padding-left: 1rem; border-left: 2px solid var(--line); color: var(--muted); }
.table_scroll { overflow: auto; margin: .9rem 0; }
.markdown table { border-collapse: collapse; min-width: 18rem; width: 100%; font-size: .85rem; }
.markdown th, .markdown td { padding: .6rem .7rem; border-bottom: 1px solid var(--line); text-align: left; }
.markdown th { font-weight: 550; }
.markdown .align_right { text-align: right; }
.markdown .align_center { text-align: center; }
.gene_code { font-family: var(--font-mono); color: var(--ink); tab-size: 2; }
.gene_comment { color: var(--muted); }
.gene_string { color: var(--syntax-string); }
.gene_number, .gene_literal { color: var(--syntax-number); }
.gene_keyword { color: var(--syntax-keyword); }
.gene_callable { color: var(--syntax-callable); }
.gene_property, .gene_type { color: var(--syntax-type); }
.gene_punctuation { color: var(--muted); }

@media (max-width: 760px) {
  .app { grid-template-columns: 1fr; }
  .sidebar { display: none; }
  .menu_open .sidebar { display: flex; position: fixed; inset: 0 auto 0 0; width: min(85vw, 280px); z-index: 5; border-right: 1px solid var(--edge); box-shadow: 0 0 0 100vmax var(--scrim); }
  .mobile_only { display: inline-block; }
  .brand { padding-bottom: 1rem; }
  .close_menu { margin-bottom: 1rem; border: 0; text-align: left; font-size: .8rem; color: var(--muted); }
  .topbar { min-height: 68px; padding: .8rem 1rem; gap: .5rem; }
  .transcript { padding: 1.5rem 1.25rem; scrollbar-gutter: auto; }
  .empty_state { padding: 1.5rem 0 2rem; }
  .empty_state h2 { max-width: 360px; font-size: 1.9rem; }
  .empty_state p { max-width: 290px; font-size: .9rem; }
  .suggestions { margin-top: 1.35rem; gap: .4rem 1.25rem; }
  .composer_wrap { padding: .5rem 1rem max(1rem, env(safe-area-inset-bottom)); }
  .composer { padding: .7rem; }
  .composer textarea { font-size: 1rem; min-height: 3.2rem; }
  .composer_actions .hint { font-size: .63rem; }
  .send, .stop { min-height: 40px; }
  .session, .sidebar_footer button, .sidebar_footer a { min-height: 40px; }
  .command { gap: .5rem; }
  .command strong { min-width: 5.5rem; }
  .rename_form, .auth_notice { padding: .6rem 1.25rem; }
  .drawer { right: 1rem; top: 4.5rem; max-width: calc(100vw - 2rem); }
  .user { max-width: calc(100% - 1rem); }
  .run { margin-bottom: 2rem; }
}
@media (max-height: 600px) {
  .empty_state { padding-block: 1rem; }
  .empty_state h2 { font-size: 1.65rem; }
  .suggestions { margin-top: .8rem; }
  .composer_wrap { padding-bottom: .75rem; }
}
@media (forced-colors: active) {
  .gene_code, .gene_code span { color: CanvasText; }
  .session.selected { outline: 1px solid Highlight; }
  .send { border-color: ButtonText; }
}
@media (prefers-reduced-motion: reduce) {
  * { scroll-behavior: auto !important; }
}
.app { grid-template-areas: "host host" "sidebar main"; grid-template-rows: auto minmax(0, 1fr); color: var(--ink); background: var(--surface); }
.ui_host { grid-area: host; padding: .55rem 1rem; border-bottom: 1px solid var(--line); background: var(--surface); font-size: .78rem; z-index: 3; }
.ui_host_navigation, .ui_host_actions { display: flex; flex-wrap: wrap; align-items: center; gap: .45rem .8rem; }
.ui_host_actions:has(> :not([hidden])) { margin-top: .25rem; }
.ui_host select { background-color: var(--input-surface); color: var(--ink); border: 1px solid var(--edge); padding: .35rem; max-width: 100%; }
.prompt_offer { padding: .75rem; border: 1px solid var(--line); margin-bottom: .75rem; font-size: .8rem; }
.prompt_offer pre { white-space: pre-wrap; overflow-wrap: anywhere; max-height: 10rem; overflow: auto; }
.prompt_offer button { margin-right: .4rem; }
.ui_host label { display: inline-flex; align-items: center; gap: .35rem; }
#ui_sizing { display: inline-flex; gap: .5rem; align-items: center; }
#ui_width { width: 90px; }
#ui_connection { margin-left: auto; color: var(--muted); }
#ui_pending_owner:empty { display: none; }
#ui_view_title { margin: 0 0 .5rem; font-size: 1rem; }
.app > .sidebar { grid-area: sidebar; }
.app > .workspace { grid-area: main; }
.app.has_ui_panel { grid-template-areas: "host host host" "sidebar panel main"; grid-template-columns: 232px minmax(280px, var(--ui-first, 1fr)) minmax(340px, var(--ui-second, 1fr)); }
.app.has_ui_panel.ui_right { grid-template-areas: "host host host" "sidebar main panel"; }
@media (min-width: 901px) {
  .app.sidebar_collapsed:not(.ui_full) { grid-template-areas: "host" "main"; grid-template-columns: minmax(0, 1fr); }
  .app.sidebar_collapsed.has_ui_panel { grid-template-areas: "host host" "panel main"; grid-template-columns: minmax(280px, var(--ui-first, 1fr)) minmax(340px, var(--ui-second, 1fr)); }
  .app.sidebar_collapsed.has_ui_panel.ui_right { grid-template-areas: "host host" "main panel"; }
}
.app.ui_full { grid-template-areas: "host" "panel"; grid-template-columns: minmax(0, 1fr); }
.app.ui_full .ui_panel { max-height: none; border: 0; }
.ui_panel { grid-area: panel; overflow: auto; padding: 1rem; border-right: 1px solid var(--line); background: var(--surface); color: var(--ink); }
.ui_panel .web_card { padding: 1rem; }
#ui_view { position: relative; isolation: isolate; contain: layout paint; }
.ui_panel label { display: grid; gap: .35rem; margin-block: .8rem; }
.ui_panel input, .ui_panel textarea, .ui_panel select { width: 100%; min-width: 0; padding: .5rem; border: 1px solid var(--edge); background-color: var(--input-surface); }
.ui_panel input[type=checkbox] { width: auto; }
.ui_panel table { width: 100%; border-collapse: collapse; margin-block: 1rem; font-size: .85rem; }
.ui_panel th, .ui_panel td { padding: .45rem; text-align: left; border-bottom: 1px solid var(--line); }
.ui_panel td button { text-align: left; border: 0; padding: .3rem; }
.ui_panel form { border-top: 1px solid var(--line); padding-top: .75rem; }
.ui_layout_controls { display: flex; align-items: center; gap: .8rem; padding: 0 2rem .5rem; font-size: .75rem; }
#ui_workspace_link { color: var(--muted); font-size: .75rem; }
#ui_workspace_link:hover { color: var(--accent); }
#ui_action_status { font-size: .8rem; overflow-wrap: anywhere; }
#ui_action_status:empty { display: none; }
@media (max-width: 900px) {
  .app { grid-template-areas: "host" "main"; grid-template-columns: minmax(0, 1fr); }
  .app > .sidebar { display: none; }
  .app.menu_open > .sidebar { display: flex; position: fixed; inset: 0 auto 0 0; width: min(85vw, 280px); z-index: 5; background: var(--sidebar); border-right: 1px solid var(--edge); box-shadow: 0 0 0 100vmax var(--scrim); }
  .mobile_only { display: inline-block; }
  .app.has_ui_panel, .app.has_ui_panel.ui_right { grid-template-areas: "host" "panel" "main"; grid-template-rows: auto minmax(0, 1fr) minmax(0, 1fr); grid-template-columns: minmax(0, 1fr); }
  .app.ui_full { grid-template-areas: "host" "panel"; grid-template-rows: auto minmax(0, 1fr); }
  .app.has_ui_panel > .workspace { min-height: 0; }
  .ui_panel { max-height: 55dvh; border-right: 0; border-bottom: 1px solid var(--line); }
}
@media (max-width: 760px) {
  #ui_workspace_link { margin-inline: 1rem; }
}
#theme_toggle { padding: .25rem .6rem; font-size: .75rem; }

/* Plugin content defaults. A view built from these elements and the web_
   primitives below looks complete in both modes without its own CSS. :where()
   keeps them at zero specificity so a plugin's style contribution wins. */
:where(.plugin_component, .ui_panel) :where(h2, h3, h4) { margin: 1rem 0 .5rem; line-height: 1.3; font-weight: 600; letter-spacing: -.015em; }
:where(.plugin_component, .ui_panel) h2 { font-size: 1.1rem; }
:where(.plugin_component, .ui_panel) h3 { font-size: 1rem; }
:where(.plugin_component, .ui_panel) h4 { font-size: .9rem; }
:where(.plugin_component, .ui_panel) :where(h2, h3, h4):first-child { margin-top: 0; }
:where(.plugin_component, .ui_panel) p { margin: .5rem 0; }
:where(.plugin_component, .ui_panel) :where(ul, ol) { margin: .5rem 0; padding-left: 1.3rem; }
:where(.plugin_component, .ui_panel) li { margin: .2rem 0; }
:where(.plugin_component, .ui_panel) a { text-decoration: underline; text-underline-offset: 3px; }
:where(.plugin_component, .ui_panel) code { font: .875em var(--font-mono); background: var(--soft); padding: .1rem .25rem; }
:where(.plugin_component, .ui_panel) pre { margin: .75rem 0; overflow: auto; padding: .8rem 1rem; background: var(--code-surface); font: .82rem/1.6 var(--font-mono); }
:where(.plugin_component, .ui_panel) pre code { padding: 0; background: none; }
:where(.plugin_component, .ui_panel) hr { margin: 1rem 0; border: 0; border-top: 1px solid var(--line); }
:where(.plugin_component, .ui_panel) progress { width: 100%; }
:where(.plugin_component, .ui_panel) summary { cursor: pointer; }
.web_stack { display: flex; flex-direction: column; gap: .65rem; min-width: 0; }
.web_row { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; min-width: 0; }
.web_spread { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem; min-width: 0; }
.web_tight { gap: .25rem; }
.web_loose { gap: 1.25rem; }
.web_badge_danger { color: var(--danger); }
.web_badge_success { color: var(--success); }
.web_notice { margin: .5rem 0; padding: .6rem .75rem; border-left: 3px solid var(--edge); background: var(--notice-surface); }
.web_notice_error { border-left-color: var(--danger); }
.web_notice_success { border-left-color: var(--success); }
.web_danger_text { color: var(--danger); }
.web_success_text { color: var(--success); }
.web_table_compact th, .web_table_compact td { padding: .2rem .4rem; font-size: .8rem; }
button.web_primary { border-color: var(--ink); background: var(--ink); color: var(--action-ink); }
button.web_primary:hover:not(:disabled) { border-color: var(--muted); background: var(--muted); }
button.web_secondary { border-color: transparent; color: var(--muted); }
button.web_secondary:hover:not(:disabled) { color: var(--ink); }
button.web_danger { border-color: var(--danger); color: var(--danger); }

/* Last, so it wins over earlier select rules of equal specificity. Native
   selects round their corners in some engines, so the arrow is drawn here. */
select:not([multiple]) { appearance: none; -webkit-appearance: none; background-image: var(--select-chevron); background-repeat: no-repeat; background-position: right .55rem center; background-size: 10px 6px; padding-right: 1.75rem; }
""")

(var styles ($to_str theme_css base_styles))
