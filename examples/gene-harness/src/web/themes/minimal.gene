(mod minimal_theme)
(var theme
  {^name "minimal" ^title "Minimal" ^doc "Neutral grays, square surfaces and quiet motion." ^extends "default"
   ^tokens {^shared {
    ^font_sans "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
    ^font_mono "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
    ^font_display "var(--font-sans)"
    ^link_decoration "underline"
    ^radius_control "5px"
    ^radius_field "0"
    ^radius_surface "0"
    ^radius_row "0"
    ^radius_chip "0"
    ^radius_message "0"
    ^shadow_overlay "none"
    ^duration_fast "0ms"
    ^duration_base "0ms"
    ^surface_raised "var(--surface)"
    ^selected "var(--soft)"
    ^action "var(--ink)"
    ^action_hover "var(--muted)"
    ^action_ink "var(--surface)"
    ^field_surface "var(--surface)"
    ^focus "var(--accent)"
    ^link_color "var(--accent)"
    ^sidebar_surface "var(--surface-alt)"
    ^code_surface "var(--soft)"
    ^notice_surface "var(--soft)"}
            ^light {
    ^surface "#ffffff"
    ^surface_alt "#f7f7f7"
    ^soft "#efefef"
    ^message_user_surface "#ebebeb"
    ^line "#e5e5e5"
    ^edge "#858585"
    ^muted "#636363"
    ^ink "#1c1c1c"
    ^accent "#1c1c1c"
    ^danger "#a8322b"
    ^success "#2d6a38"
    ^scrim "rgb(0 0 0 / .2)"
    ^shadow_raised "0 5px 18px #0002"}
            ^dark {
    ^surface "#151515"
    ^surface_alt "#1b1b1b"
    ^soft "#262626"
    ^message_user_surface "#2b2b2b"
    ^line "#2f2f2f"
    ^edge "#777777"
    ^muted "#9c9c9c"
    ^ink "#e7e7e7"
    ^accent "#e7e7e7"
    ^danger "#ef8b80"
    ^success "#8fc89b"
    ^scrim "rgb(0 0 0 / .5)"
    ^shadow_raised "0 5px 18px #000a"}}})
