# Root theme values. Host rules name roles; themes decide their values.
(mod default_theme)
(var theme
  {^name "default" ^title "Default" ^doc "The Harness base theme."
   ^tokens {^shared {
    ^font_sans "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
    ^font_mono "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
    ^font_display "var(--font-sans)"
    ^density "1"
    ^weight_regular "400"
    ^weight_medium "550"
    ^weight_bold "650"
    ^line_body "1.6"
    ^line_tight "1.25"
    ^line_heading "1.35"
    ^line_code "1.65"
    ^tracking_label ".07em"
    ^tracking_tight "-.02em"
    ^tracking_brand "-.065em"
    ^link_decoration "underline"
    ^radius_control "5px"
    ^radius_field "0"
    ^radius_surface "0"
    ^radius_row "0"
    ^radius_chip "0"
    ^radius_message "0"
    ^border_width "1px"
    ^border_width_strong "2px"
    ^rule_width "3px"
    ^focus_width "2px"
    ^focus_offset "4px"
    ^shadow_overlay "none"
    ^duration_fast "100ms"
    ^duration_base "180ms"
    ^ease_standard "cubic-bezier(.2, 0, 0, 1)"
    ^sidebar_width "14.5rem"
    ^content_width "47.5rem"
    ^topbar_height "4.75rem"
    ^drawer_width "20rem"
    ^drawer_width_wide "27.5rem"
    ^menu_width "13.75rem"
    ^panel_min "17.5rem"
    ^main_min "21.25rem"
    ^control_height "2rem"
    ^touch_target "2.75rem"
    ^gutter "2.25rem"
    ^gutter_compact "1rem"
    ^stack_gap "var(--space-3)"
    ^inline_gap "var(--space-2)"
    ^inset_control "var(--space-1) var(--space-3)"
    ^inset_field "var(--space-2)"
    ^inset_surface "var(--space-4)"
    ^icon_size "1.25em"
    ^icon_size_sm "1em"
    ^icon_size_lg "1.5em"
    ^transcript_min_height "10rem"
    ^transcript_compact_height "45dvh"
    ^status_dot_size "6px"
    ^opacity_disabled ".45"
    ^code_surface "var(--soft)"
    ^notice_surface "var(--soft)"
    ^sidebar_surface "var(--surface-alt)"
    ^field_surface "var(--surface)"
    ^surface_raised "var(--surface)"
    ^selected "var(--soft)"
    ^action "var(--ink)"
    ^action_hover "var(--muted)"
    ^action_ink "var(--surface)"
    ^focus "var(--accent)"
    ^link_color "var(--accent)"
    ^text_2xs ".68rem"
    ^text_xs ".75rem"
    ^text_sm ".82rem"
    ^text_md ".94rem"
    ^text_lg "1.05rem"
    ^text_xl "1.2rem"
    ^text_2xl "1.4rem"
    ^text_display "clamp(1.8rem, 2.7vw, 2.4rem)"
    ^space_1 "0.25rem"
    ^space_2 "0.5rem"
    ^space_3 "0.75rem"
    ^space_4 "1rem"
    ^space_5 "1.25rem"
    ^space_6 "1.5rem"
    ^space_8 "2rem"
    ^space_10 "2.5rem"
    ^space_12 "3rem"
    ^type_body "var(--weight-regular) var(--text-md)/var(--line-body) var(--font-sans)"
    ^type_ui "var(--weight-regular) var(--text-sm)/var(--line-tight) var(--font-sans)"
    ^type_small "var(--weight-regular) var(--text-xs)/var(--line-body) var(--font-sans)"
    ^type_label "var(--weight-medium) var(--text-2xs)/var(--line-tight) var(--font-sans)"
    ^type_title "var(--weight-medium) var(--text-md)/var(--line-heading) var(--font-display)"
    ^type_heading_1 "var(--weight-bold) var(--text-2xl)/var(--line-heading) var(--font-display)"
    ^type_heading_2 "var(--weight-bold) var(--text-xl)/var(--line-heading) var(--font-display)"
    ^type_heading_3 "var(--weight-bold) var(--text-lg)/var(--line-heading) var(--font-display)"
    ^type_display "var(--weight-regular) var(--text-display)/var(--line-tight) var(--font-display)"
    ^type_code "var(--weight-regular) var(--text-sm)/var(--line-code) var(--font-mono)"
    ^layer_raised "1"
    ^layer_sticky "10"
    ^layer_overlay "20"
    ^layer_drawer "30"
    ^layer_menu "40"
    ^layer_dialog "50"
    ^layer_toast "60"
    ^syntax_string "color-mix(in srgb, #23804b 55%, var(--ink))"
    ^syntax_number "color-mix(in srgb, #bc7c42 55%, var(--ink))"
    ^syntax_keyword "color-mix(in srgb, #9b64ce 55%, var(--ink))"
    ^syntax_callable "color-mix(in srgb, #4b82cf 55%, var(--ink))"
    ^syntax_type "color-mix(in srgb, #398a96 55%, var(--ink))"
    ^size_14_5 "14.5rem"
    ^size_0_375 "0.375rem"
    ^size_1_875 "1.875rem"
    ^size_13_75 "13.75rem"
    ^size_1 "1rem"
    ^size_2_25 "2.25rem"
    ^size_2_5 "2.5rem"
    ^size_11_25 "11.25rem"
    ^size_16_25 "16.25rem"
    ^size_1_75 "1.75rem"
    ^size_24 "24rem"
    ^size_4_75 "4.75rem"
    ^size_60 "60rem"
    ^size_10 "10rem"
    ^size_30 "30rem"
    ^size_25 "25rem"
    ^size_32 "32rem"
    ^size_17 "17rem"
    ^size_12 "12rem"
    ^size_14 "14rem"
    ^size_16 "16rem"
    ^size_8 "8rem"
    ^size_3_4 "3.4rem"
    ^size_4 "4rem"
    ^size_27_5 "27.5rem"
    ^size_20 "20rem"
    ^size_15 "15rem"
    ^size_6_5 "6.5rem"
    ^size_1_25 "1.25rem"
    ^size_4_5 "4.5rem"
    ^size_6 "6rem"
    ^size_18 "18rem"
    ^size_4_25 "4.25rem"
    ^size_22_5 "22.5rem"
    ^size_18_125 "18.125rem"
    ^size_3_2 "3.2rem"
    ^size_5_5 "5.5rem"
    ^size_2 "2rem"
    ^size_5_625 "5.625rem"
    ^size_17_5 "17.5rem"
    ^size_21_25 "21.25rem"
    ^size_0_55 "0.55rem"
    ^size_0_625 "0.625rem"
    ^size_80 "80rem"
    ^size_40 "40rem"
    ^size_32_25 "32.25rem"
    ^size_3_5 "3.5rem"
    ^size_1_125 "1.125rem"
    ^size_5 "5rem"
    ^size_72 "72rem"
    ^size_0_0625 "0.0625rem"
    ^size_34 "34rem"
    ^size_5_25 "5.25rem"
    ^size_44 "44rem"
    ^size_2_4 "2.4rem"
    ^size_46 "46rem"
    ^size_1_65 "1.65rem"
    ^size_52 "52rem"
    ^size_36 "36rem"
    ^size_26 "26rem"
    ^size_75 "75rem"
    ^size_1_5 "1.5rem"
    ^composer_max_height "28dvh"
    ^command_list_max_height "35dvh"
    ^media_preview_max_height "65vh"
    ^panel_narrow_max_height "55dvh"
    ^sidebar_overlay_max_width "85vw"
    ^manager_list_max_height "68vh"
    ^manager_list_compact_max_height "40vh"
    ^spotlight_inset_block "min(14vh, var(--space-12))"
    ^model_picker_max_inline "45vw"
    ^model_menu_inset_block "10vh"
    ^model_menu_max_height "80dvh"
    ^site_hero_columns "minmax(0, 1.05fr) minmax(0, 1fr)"
    ^site_shell_inset "clamp(var(--space-4), 4vw, var(--space-8))"
    ^site_hero_inset "clamp(var(--space-12), 8vw, calc(var(--space-12) * 2)) clamp(var(--space-12), 7vw, calc(var(--space-10) * 2))"
    ^site_section_inset "clamp(var(--space-12), 8vw, calc(var(--space-12) * 2))"
    ^site_hero_gap "clamp(var(--space-10), 5vw, calc(var(--space-8) * 2))"
    ^site_heading_gap "clamp(var(--space-8), 4vw, var(--space-12))"
    ^site_run_gap "clamp(var(--space-6), 4vw, var(--space-12))"
    ^link_underline_offset ".18em"
    ^image_grid_hover_surface "color-mix(in srgb, var(--surface) 22%, transparent)"
    ^image_point_preview_size "96%"
    ^message_user_max_width "90%"
    ^site_hero_measure "12ch"}
            ^light {
    ^surface "#ffffff"
    ^surface_alt "#f7f7f7"
    ^soft "#efefef"
    ^message_user_surface "#ebebeb"
    ^line "#e5e5e5"
    ^edge "#858585"
    ^muted "#636363"
    ^ink "#1c1c1c"
    ^accent "#1c1c1c"
    ^danger "#a8322b"
    ^success "#2d6a38"
    ^warning "#705000"
    ^info "#205d88"
    ^danger_surface "#fcebea"
    ^success_surface "#e9f4eb"
    ^warning_surface "#faf0d5"
    ^info_surface "#e8f1fa"
    ^scrim "rgb(0 0 0 / .2)"
    ^shadow_raised "0 5px 18px #0002"
    ^series_1 "#315e9e"
    ^series_2 "#8e406b"
    ^series_3 "#38653c"
    ^series_4 "#855318"
    ^series_5 "#6544a0"
    ^series_6 "#146c72"
    ^series_7 "#98502c"
    ^series_8 "#655c20"}
            ^dark {
    ^surface "#151515"
    ^surface_alt "#1b1b1b"
    ^soft "#262626"
    ^message_user_surface "#2b2b2b"
    ^line "#2f2f2f"
    ^edge "#777777"
    ^muted "#9c9c9c"
    ^ink "#e7e7e7"
    ^accent "#e7e7e7"
    ^danger "#ef8b80"
    ^success "#8fc89b"
    ^warning "#dfbe72"
    ^info "#8cbce9"
    ^danger_surface "#302020"
    ^success_surface "#1e3023"
    ^warning_surface "#30291b"
    ^info_surface "#1d2a35"
    ^scrim "rgb(0 0 0 / .5)"
    ^shadow_raised "0 5px 18px #000a"
    ^series_1 "#8cbce9"
    ^series_2 "#e69bc1"
    ^series_3 "#9dc99c"
    ^series_4 "#e1b778"
    ^series_5 "#bba3ef"
    ^series_6 "#82ced1"
    ^series_7 "#e7a887"
    ^series_8 "#c5c581"}}
   # Original geometric drawings, covered by the repository MIT license.
   ^icons {
    ^add "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12h14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>"
    ^close "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"m6 6 12 12M6 18 18 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>"
    ^menu "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M4 6h16M4 12h16M4 18h16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>"
    ^more "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M5 12h.01M12 12h.01M19 12h.01\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>"
    ^send "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"m3 3 18 9-18 9 4-9-4-9Zm4 9h14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>"
    ^stop "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M6 6h12v12H6Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>"
    ^copy "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M8 8h13v13H8ZM16 8V3H3v13h5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>"
    ^search "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M21 21l-6-6M17 10a7 7 0 1 1-14 0 7 7 0 0 1 14 0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>"
    ^settings "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 3v3M12 18v3M3 12h3M18 12h3M5 5l3 3M16 16l3 3M5 19l3-3M16 8l3-3M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>"
    ^notifications "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M5 17h14l-2-3V9A5 5 0 0 0 7 9v5l-2 3Zm5 3h4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>"
    ^light "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1 1M18 18l1 1M5 19l1-1M18 6l1-1M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>"
    ^dark "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M20 15A9 9 0 0 1 9 4a9 9 0 1 0 11 11Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>"
    ^chevron-down "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"m6 9 6 6 6-6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>"
    ^chevron-right "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"m9 6 6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>"
    ^arrow-down "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 3v18m-7-7 7 7 7-7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>"
    ^check "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"m4 12 5 5L20 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>"
    ^success "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"m4 12 5 5L20 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>"
    ^warning "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"m12 3 10 18H2L12 3Zm0 5v6m0 3h.01\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>"
    ^error "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"m6 6 12 12M6 18 18 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>"
    ^info "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 11v6m0-10h.01M22 12A10 10 0 1 1 2 12a10 10 0 0 1 20 0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>"
    ^external "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M14 3h7v7m0-7L10 14M10 3H3v18h18v-7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>"
    ^attachment "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"m8 13 7-7a3 3 0 0 1 4 4L9 20a5 5 0 0 1-7-7L13 2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>"
    ^microphone "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M9 4a3 3 0 0 1 6 0v8a3 3 0 0 1-6 0V4Zm-4 7v1a7 7 0 0 0 14 0v-1M12 19v3M8 22h8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>"
    ^pin "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"m8 3 8 0-1 7 4 4H5l4-4-1-7ZM12 14v8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>"
    ^edit "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"m4 16-1 5 5-1L21 7l-4-4L4 16Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>"
    ^retry "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M3 10a9 9 0 1 1 2 9M3 3v7h7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>"
    ^delete "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M3 6h18M9 6V3h6v3M6 6l1 15h10l1-15M10 10v7M14 10v7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>"
    ^sidebar "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M3 3h18v18H3ZM9 3v18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>"
    ^plugin "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M8 3v5M16 3v5M5 8h14v5a7 7 0 0 1-14 0V8ZM12 20v3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>"
    ^trigger "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"m13 2-9 12h7l-1 8 10-13h-8l1-7Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>"}})
