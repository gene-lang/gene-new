# Static session-host wiring. This owns no transport state or plugin engine.
# Controller construction and its lifetime marker are separate so channels
# remain available while admitted rounds drain during shutdown.
(mod session_service_lifecycle)
(import [new_host_services start_host_services close_host_services HostServiceError] ^from "../runtime/host_services")
(import [close_runtime] ^from "../runtime/bootstrap")
(import [new_round_controller close_round_controller resume_answered_rounds resume_continuations]
  ^from "../runtime/round_controller")
(import [open_channel_service close_channel_service] ^from "../channels/service")
(import [trigger_host_binding] ^from "../runtime/trigger_host")
(import [channel_host_binding] ^from "../channels/host")
(import [close_trigger_manager] ^from "../runtime/triggers")
(import [start_manager_polling] ^from "../runtime/workspace_manager")
(import [provide withdraw_seam HarnessEvent] ^from "../kernel")

(fn stop_observers [ctx]
  (let service ctx/service)
  (service/runtime/h/notifications/observer .set nil)
  (service/runtime/actions/log/observer .set nil)
  (let subscriptions service/subscriptions)
  (set service/subscriptions [])
  (for subscription in subscriptions subscription/.cancel)
  (let jobs (service/snapshot_jobs .swap {}))
  (for [id slot] in jobs
    (while ($absent? slot/.get) ($sleep 1))
    (let job slot/.get)
    job/.cancel)
  (for [id slot] in jobs
    (let job slot/.get)
    job/.join)
  nil)

(fn close_bindings [ctx]
  (if (== ctx/bindings_closed true) (return nil))
  (set ctx/bindings_closed true)
  (let errors [])
  (for name in ["triggers/host" "channels/host" "loop"]
    (try (withdraw_seam ctx/service/runtime/h "core" name)
      catch Any (errors .push $err/message)))
  (if_not ($absent? ctx/service/runtime/triggers)
    (try (close_trigger_manager ctx/service/runtime/triggers)
      catch Any (errors .push $err/message)))
  (if_not errors/.empty? (fail (HostServiceError ^message $"Session binding cleanup failed: ${errors}")))
  nil)

(fn drain_controller [ctx, controller]
  (if (== ctx/controller_closed true) (return nil))
  (set ctx/controller_closed true)
  (close_round_controller controller))

(fn session_service_specs [publish, on_event]
  [{^name "runtime" ^requires [] ^open (fn [ctx] ctx/service/runtime) ^recover nil
    ^close (fn [ctx, runtime] (close_runtime runtime))}
   {^name "controller" ^requires ["runtime"]
    ^open (fn [ctx]
      (let controller (new_round_controller ctx/service/runtime))
      (set ctx/service/controller controller) controller)
    ^recover nil ^close drain_controller}
   {^name "channels" ^requires ["controller"]
    ^open (fn [ctx]
      (if ($absent? ctx/service/runtime/channel_queues) (return nil))
      (let channels (open_channel_service ctx/service/runtime ctx/service/controller))
      (set ctx/service/runtime/channels channels) channels)
    ^recover nil ^close (fn [ctx, channels] (close_channel_service channels))}
   {^name "controller_lifetime" ^requires ["channels"]
    ^open (fn [ctx] ctx/service/controller) ^recover nil
    ^quiesce drain_controller ^close drain_controller}
   {^name "resumption" ^requires ["controller_lifetime"]
    ^open (fn [ctx]
      (resume_answered_rounds ctx/service/controller)
      (resume_continuations ctx/service/controller)
      nil) ^recover nil}
   {^name "manager_polling" ^requires ["controller_lifetime"]
    ^open (fn [ctx]
      (if_not ($absent? ctx/service/runtime/workspace_manager)
        (start_manager_polling ctx/service/runtime/workspace_manager))
      nil) ^recover nil}
   {^name "bindings" ^requires ["resumption" "manager_polling"]
    ^open (fn [ctx]
      (let service ctx/service)
      (let runtime service/runtime)
      (try
        (provide runtime/h "core" "triggers/host" (trigger_host_binding runtime service/controller))
        (if_not ($absent? runtime/channels)
          (provide runtime/h "core" "channels/host" (channel_host_binding runtime ^options ctx/channel_options)))
        # Compatibility only; current built-ins use narrow protocols.
        (provide runtime/h "core" "loop" (fn [] {^runtime runtime ^controller service/controller ^^start ^^boot}))
        service
      catch Any
        (let original $err)
        (close_bindings ctx)
        (fail original)))
    ^recover nil ^quiesce (fn [ctx, service] (close_bindings ctx))
    ^close (fn [ctx, service] (close_bindings ctx))}
   {^name "observers" ^requires ["bindings"]
    ^open (fn [ctx]
      (let service ctx/service)
      (try
        (service/runtime/h/notifications/observer .set (fn [kind, data]
          (let copy ($thaw ($freeze data)))
          (copy .put "epoch" service/epoch)
          (publish service kind "" copy)))
        (service/runtime/actions/log/observer .set (fn [record, metadata]
          (publish service "ui/action" "" {^record record ^actions metadata})))
        (service/subscriptions .push
          (service/runtime/h/bus .subscribe HarnessEvent (fn [event] (on_event service event))))
        service
      catch Any (stop_observers ctx) (fail $err)))
    ^recover nil ^quiesce (fn [ctx, service] (stop_observers ctx))
    ^close (fn [ctx, service] (stop_observers ctx))}])

(fn open_session_lifecycle [service, publish, on_event, ^channel_options channel_options = nil, ^observe observe = nil]
  (let ctx {^service service ^channel_options channel_options ^controller_closed false ^bindings_closed false})
  (let owner (new_host_services ctx (session_service_specs publish on_event) ^observe observe))
  (start_host_services owner "normal"))

(fn close_session_lifecycle [owner]
  (close_host_services owner))
