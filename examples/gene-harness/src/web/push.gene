# Ordered, bounded server-to-browser delivery. Commands stay on HTTP POST.
(mod harness_web_push)

(import [host_status list_sessions snapshot RoundError] ^from "./session_service")
(import [protocol_version] ^from "./contract")
(import [view_session leave_session] ^from "../runtime/sessions")
(import $net/http [ws_send ws_close])
(import $os [monotonic_ms])

(type PushHub ^props {^host Any ^peers Any})

(fn send_frame [hub : PushHub, peer, message]
  (if peer/closed (return))
  (if (&& peer/safe (["ui/state" "ui/action"] .contains? message/type)) (return))
  (if_yes (> (monotonic_ms) peer/expires)
    (peer .put "closed" true)
    (ws_close peer/connection)
    (return))
  (peer .put "sequence" (+ peer/sequence 1))
  (var data message/data)
  (if_yes (&& peer/safe (== message/type "snapshot"))
    (set data ($thaw ($freeze_shallow data)))
    (let status ($thaw ($freeze_shallow data/status)))
    (status .put "web_components" [])
    (status .put "ui" nil)
    (data .put "status" status))
  (var frame {^protocol protocol_version ^epoch hub/host/epoch
    ^sequence ($to_str peer/sequence) ^type message/type
    ^session message/session ^data data})
  (if_not ($absent? message/reason) (frame .put "reason" message/reason))
  (try
    (if_yes (!= (ws_send peer/connection ($json/stringify frame)) 0)
      # A dropped frame invalidates the stream. Reconnect gets a fresh snapshot.
      (peer .put "closed" true)
      (ws_close peer/connection))
  catch Any
    (peer .put "closed" true)
    (ws_close peer/connection)))

(fn broadcast [hub : PushHub, message]
  (for peer in hub/peers/.get
    (if_yes (|| (== message/session "") (== peer/session message/session))
      (send_frame hub peer message))))

(fn new_push_hub [host] : PushHub
  (var hub (PushHub ^host host ^peers ($cell [])))
  (host/publisher .set (fn [message] (broadcast hub message)))
  (set host/ui_audience (fn []
    (for peer in hub/peers/.get
      (if (&& (! peer/closed) (! peer/safe)) (return true)))
    false))
  hub)

(fn add_peer [hub : PushHub, connection, session : Str, expires : Int, ^safe safe : Bool = false]
  (var peer {^connection connection ^session session ^expires expires
    ^sequence 0 ^!closed ^!viewing ^safe safe})
  (hub/peers/.get .push peer)
  (try
    (send_frame hub peer {^type "status" ^session "" ^data (host_status ^safe safe hub/host)})
    (if hub/host/runtime/restarted
      (send_frame hub peer {^type "restarted" ^session "" ^data {^message "Harness restarted."}}))
    (send_frame hub peer {^type "session/list" ^session "" ^data (list_sessions hub/host)})
    (if_yes (!= session "")
      (try
        (view_session hub/host/sessions session)
        (peer .put "viewing" true)
        (send_frame hub peer {^type "snapshot" ^session session ^data (snapshot ^safe safe hub/host session)})
      catch RoundError
        (send_frame hub peer {^type "error" ^session session
          ^data {^code $err/code ^message $err/message}})))
    (send_frame hub peer {^type "ready" ^session session ^data nil})
  catch Any
    ($runtime/with_context nil (fn [] ($println $"Browser connection failed: ${$err/message}")))
    (peer .put "closed" true)
    (ws_close connection)))

(fn remove_peer [hub : PushHub, connection]
  (var kept [])
  (for peer in hub/peers/.get
    (if (same? peer/connection connection)
      (then
        (if peer/viewing (leave_session hub/host/sessions peer/session)))
      (else (kept .push peer))))
  (hub/peers .set kept))

(fn expire_peers [hub : PushHub]
  (for peer in hub/peers/.get
    (if_yes (&& (! peer/closed) (> (monotonic_ms) peer/expires))
      (peer .put "closed" true)
      (ws_close peer/connection))))
