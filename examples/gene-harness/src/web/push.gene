# Ordered, bounded server-to-browser delivery. Commands stay on HTTP POST.
(mod harness_web_push)
(import [log_event log_subscribe log_unsubscribe log_gap_record] ^from "../kernel/log")

(import ^from "./session_service" [host_status list_sessions snapshot RoundError])
(import ^from "../runtime/appearance" [report_appearance appearance_tabs])
(import ^from "./contract" [protocol_version])
(import ^from "../notifications/inbox" [inbox_snapshot])
(import ^from "../runtime/sessions" [view_session leave_session])
(import [voice_connected voice_disconnected voice_snapshot public_voice_state] ^from "../runtime/voice_state")
(import $net/http [ws_send ws_try_send ws_queued ws_close])
(import $os [monotonic_ms])

(type PushHub ^props {^host Any ^peers Any})

(fn send_frame [hub : PushHub, peer, message]
  (if peer/closed (return))
  (if (&& peer/safe (== message/type "ui/state")) (return))
  (if_yes (&& (> peer/expires 0) (> (monotonic_ms) peer/expires))
    (peer .put "closed" true)
    (ws_close peer/connection)
    (return))
  (peer .put "sequence" (+ peer/sequence 1))
  (var data message/data)
  (if_yes (&& peer/safe (== message/type "notifications/state"))
    (set data ($thaw ($freeze data)))
    (for item in data/messages (item .put "detail" nil)))
  (if_yes (&& peer/safe (== message/type "snapshot"))
    (set data ($thaw ($freeze_shallow data)))
    (let status ($thaw ($freeze_shallow data/status)))
    (status .put "web_components" [])
    (status .put "browser_clients" [])
    (status .put "ui" nil)
    (data .put "status" status))
  (var frame {^protocol protocol_version ^epoch hub/host/epoch
    ^sequence ($to_str peer/sequence) ^type message/type
    ^session message/session ^data data})
  (if_not ($absent? message/reason) (frame .put "reason" message/reason))
  (try
    (if_yes (!= (ws_send peer/connection ($json/stringify frame)) 0)
      # A dropped frame invalidates the stream. Reconnect gets a fresh snapshot.
      (peer .put "closed" true)
      (ws_close peer/connection))
  catch Error
    (peer .put "closed" true)
    (ws_close peer/connection)))

(fn broadcast [hub : PushHub, message]
  (for peer in hub/peers/.get
    (if_yes (|| (== message/session "") (== peer/session message/session))
      (send_frame hub peer message))))

(fn new_push_hub [host] : PushHub
  (var hub (PushHub ^host host ^peers ($cell [])))
  (host/publisher .set (fn [message] (broadcast hub message)))
  (set host/snapshot_audience (fn [session]
    (for peer in hub/peers/.get
      (if (&& (! peer/closed) (== peer/session session)) (return true)))
    false))
  (set host/clients
    (fn []
      (let live [])
      (for peer in hub/peers/.get
        (if (&& (! peer/closed) (!= (?? peer/client_id "") ""))
          (live .push {^client_id peer/client_id ^session peer/session ^safe peer/safe})))
      live))
  (set host/ui_audience
    (fn []
      (for peer in hub/peers/.get
        (if (&& (! peer/closed) (! peer/safe)) (return true)))
      false))
  hub)

(fn log_frame_text [hub : PushHub, peer, type : Str, data, sequence : Int] : Str
  (let frame {^protocol protocol_version ^epoch hub/host/epoch
    ^type type ^session peer/session ^log_sequence ($to_str sequence)
    ^data data})
  ($json/stringify frame))

(fn send_log_frame [hub : PushHub, peer, type : Str, data] : Str
  # Nonblocking diagnostics: drop instead of closing/evicting the state stream.
  (if (|| peer/closed peer/safe) (return "closed"))
  (if (> (ws_queued peer/connection) 65536) (return "full"))
  (let sequence (+ (?? peer/log_sequence 0) 1))
  (let accepted
    (try
      (ws_try_send ^max_bytes 65536 peer/connection
        (log_frame_text hub peer type data sequence))
    catch Throwable -1))
  (if (== accepted 1)
    (do (peer .put "log_sequence" sequence) (return "ok"))
    (if (== accepted 0) (return "full") (return "closed"))))

(fn log_drop_gap [peer, record] : Any
  (if (== (?? peer/log_dropped 0) 0) (return nil))
  {^count peer/log_dropped ^from (?? peer/log_drop_from 0) ^to (?? peer/log_drop_to 0)})

(fn note_log_drop [peer, record] : Nil
  (let at (?? record/seq 0))
  (if (== (?? peer/log_dropped 0) 0) (peer .put "log_drop_from" at))
  (peer .put "log_drop_to" at)
  (peer .put "log_dropped" (+ (?? peer/log_dropped 0) 1)))

(fn flush_log_gap [hub : PushHub, peer, record] : Bool
  (let gap (log_drop_gap peer record))
  (if ($absent? gap) (return true))
  (if (== (send_log_frame hub peer "log/gap" gap) "ok")
    (do
      (peer .put "log_dropped" 0)
      (peer .put "log_drop_from" 0)
      (peer .put "log_drop_to" 0)
      (return true)))
  false)

(fn send_record_log [hub : PushHub, peer, record] : Nil
  (if (|| peer/closed peer/safe) (return))
  (if_not (flush_log_gap hub peer record)
    (do (note_log_drop peer record) (return)))
  (let outcome (send_log_frame hub peer "log" record))
  (if (== outcome "closed")
    (peer .put "closed" true)
    (if (== outcome "full") (note_log_drop peer record))))

(fn drain_peer_logs [hub : PushHub, peer, subscription] : Nil
  (try
    (loop
      (let message subscription/channel/.recv)
      (if peer/closed (return))
      (let gap (log_gap_record message))
      (if ($present? gap) (send_record_log hub peer gap))
      (send_record_log hub peer message/record))
    catch ChannelClosed nil)
  nil)

(fn add_peer [hub : PushHub, connection, session : Str, expires : Int, ^safe safe : Bool = false, ^client_id client_id : Str = ""]
  (var peer {^connection connection ^session session ^expires expires
    ^sequence 0 ^!closed ^!viewing ^safe safe ^client_id client_id})
  (let filter (if (== session "") nil {^session session}))
  (let subscription (log_subscribe ^type "" ^target filter ^capacity 128))
  (peer .put "log_subscription" subscription)
  (peer .put "log_sequence" 0)
  (peer .put "log_dropped" 0)
  (peer .put "log_drop_from" 0)
  (peer .put "log_drop_to" 0)
  (peer .put "log_task" (spawn ^lane root (drain_peer_logs hub peer subscription)))
  (hub/peers/.get .push peer)
  (voice_connected hub/host/runtime/services/values/voice client_id)
  (try
    (send_frame hub peer {^type "status" ^session "" ^data (host_status ^safe safe hub/host)})
    (if_not safe
      (send_frame hub peer {^type "voice/state" ^session "" ^data (public_voice_state (voice_snapshot hub/host/runtime/services/values/voice))}))
    (if hub/host/runtime/restarted
      (send_frame hub peer {^type "restarted" ^session "" ^data {^message "Harness restarted."}}))
    (send_frame hub peer {^type "session/list" ^session "" ^data (list_sessions hub/host)})
    (let notifications (inbox_snapshot hub/host/runtime/services/values/inbox))
    (notifications .put "epoch" hub/host/epoch)
    (send_frame hub peer {^type "notifications/state" ^session "" ^data notifications})
    (if peer/closed (return nil))
    (if_yes (!= session "")
      (try
        (view_session hub/host/runtime/sessions session)
        (peer .put "viewing" true)
        # A reset/disconnect can happen while view_session waits for loading.
        (if_yes peer/closed
          (leave_session hub/host/runtime/sessions session)
          (peer .put "viewing" false)
          (return nil))
        (send_frame hub peer {^type "snapshot" ^session session ^data (snapshot ^!console ^safe safe hub/host session)})
      catch RoundError
        (send_frame hub peer {^type "error" ^session session
          ^data {^code $err/code ^message $err/.message}})))
    (send_frame hub peer {^type "ready" ^session session ^data nil})
  catch Error
    (log_event "web/connection_failed" $"Browser connection failed: ${$err/.message}"
      ^target {^client (?? peer/client_id "") ^session session}
      ^data {^error $err/.message})
    (peer .put "closed" true)
    (ws_close connection)))

(fn remove_peer [hub : PushHub, connection]
  (var kept [])
  (for peer in hub/peers/.get
    (if (same? peer/connection connection)
      (then
        (voice_disconnected hub/host/runtime/services/values/voice (?? peer/client_id ""))
        (peer .put "closed" true)
        (let subscription (?? peer/log_subscription nil))
        (if ($present? subscription) (log_unsubscribe subscription/id))
        (if_yes peer/viewing
          (leave_session hub/host/runtime/sessions peer/session)
          (peer .put "viewing" false)))
      (else
        (kept .push peer))))
  (hub/peers .set kept)
  (let live_ids [])
  (for peer in kept
    (if_not peer/closed (live_ids .push (?? peer/client_id ""))))
  (for report in (appearance_tabs hub/host/runtime)
    (if_not (live_ids .contains? report/tab) (report_appearance hub/host/runtime report/tab nil))))

(fn expire_peers [hub : PushHub]
  (for peer in hub/peers/.get
    (if_yes (&& (! peer/closed) (> peer/expires 0) (> (monotonic_ms) peer/expires))
      (peer .put "closed" true)
      (ws_close peer/connection))))

(fn disconnect_peers [hub : PushHub]
  (let peers ($into hub/peers/.get []))
  (for peer in peers
    (peer .put "closed" true)
    (try
      (ws_close peer/connection)
    catch Error
      nil)
    (remove_peer hub peer/connection))
  nil)
