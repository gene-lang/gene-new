# Recovery serves only host-owned management APIs. It never opens event or
# application-state streams and never constructs normal execution controllers.
(mod recovery_server)
(import log_event log_refresh_redactions log_set_workspace ^from "../kernel/log")
(import api_root ^from "./contract.gene")
(import $net/http/[serve stop html])
(import response secure_response cookie_value field number request_data ^from "./request")
(import open_auth authenticate exchange reset_auth AuthError ^from "./auth")
(import bind_workspace publish_connection publish_link clear_connection ^from "./connection")
(import plugin_page manager_client ^from "./plugin_page")
(import set_appearance ^from "../runtime/appearance")
(import request_appearance appearance_request appearance_preview_request ^from "./appearance")
(import new_plugin_control plugin_control_request close_plugin_control ^from "./plugin_control")
(import mark_ready print_browser_link ^from "./startup")
(import protocol_version ^from "./contract")
(import open_runtime close_runtime ^from "../runtime/bootstrap")
(import baseline_profile ^from "../profiles/baseline")
(import workspace_profile ^from "../profiles/registry")
(import read_workspace_settings update_workspace_settings ^from "../runtime/workspace_settings")
(import plugin_catalog inspect_descriptor plugin_history_catalog ^from "../runtime/plugin_manager")
(import composition_revision ^from "../storage/composition_store")
(import revert_entry ^from "../storage/workspace_repair")
(import pin_history ^from "../storage/plugin_history")

(fn main [options] : Int
  (manager_client)
  (let runtime
    (open_runtime ^mode "recovery" ^lock_wait_ms 250 (?? options/workspace ($os/launch_dir)) "default"
      (workspace_profile (?? options/workspace ($os/launch_dir)))))
  (var server nil)
  (let control (new_plugin_control runtime))
  (try
    (clear_connection runtime/root "")
    (set server
      (bind_workspace ^port (if ($absent? options/port) nil else ($parse/parse_int options/port)) ^restart_port (if ($absent? (options .get "restart-port")) nil else ($parse/parse_int (options .get "restart-port")))
        runtime/state_root))
    (let port server/port)
    (let origin $"http://127.0.0.1:${port}")
    (let authority $"127.0.0.1:${port}")
    (let cookie $"gene_harness_session_${port}")
    (log_set_workspace runtime/root runtime/root)
    (log_refresh_redactions)
    (let auth (open_auth runtime/state_root))
    (log_refresh_redactions)
    (let connection (publish_connection runtime/root runtime/epoch port auth/secret))
    (fn handle [request]
      (if (!= (?? request/headers/host "") authority)
        (return (response 403 {^code "forbidden" ^message "Use the canonical local address."})))
      (let request_origin (?? request/headers/origin ""))
      (if (|| (&& (!= request_origin "") (!= request_origin origin)) (&& (!= request/method "GET") (!= request_origin origin)))
        (return (response 403 {^code "forbidden" ^message "A same-origin request is required."})))
      (if (&& (== request/method "GET") (["/" "/plugins" "/plugins/" "/ui/default"] .contains? request/path))
        (return (html (plugin_page ^appearance (request_appearance request runtime true) ^workspace runtime/root))))
      (if (&& (== request/method "GET") (== request/path $"${(api_root)}/connection"))
        (return (response 200 connection)))
      (if (&& (== request/method "POST") (== request/path $"${(api_root)}/auth/exchange"))
        (let data (request_data request))
        (let session
          (exchange ^cookie (cookie_value (?? request/headers/cookie "") cookie)
            auth
            (field data "token")))
        (let result (response 200 {^csrf session/csrf}))
        (result/headers .put
          "set-cookie"
          $"${cookie}=${session/cookie}; Path=/; HttpOnly; SameSite=Strict; Max-Age=31536000")
        (return result))
      (let browser (authenticate auth (cookie_value (?? request/headers/cookie "") cookie)))
      (if (&& (!= request/method "GET") (!= request/headers/x-csrf-token browser/csrf))
        (return (response 403 {^code "forbidden" ^message "Refresh before making a change."})))
      (if runtime/stopping/.get
        (return (response 503 {^code "stopped" ^message "Recovery host is stopping."})))
      (let managed (plugin_control_request control request))
      (if ($present? managed) (return (response managed/status managed/body)))
      (if (== request/path $"${(api_root)}/workspace/settings")
        (if (== request/method "GET")
          (return (response 200 (read_workspace_settings runtime/root))))
        (if (== request/method "POST")
          (let data (request_data request))
          (return
            (response
              200
              (update_workspace_settings ^expected (?? data/expected "")
                runtime/root
                (?? data/changes data))))))
      (if (&& (== request/method "GET") (== request/path $"${(api_root)}/status"))
        (return
          (response
            200
            {
              ^epoch runtime/epoch
              ^protocol protocol_version
              ^csrf browser/csrf
              ^workspace runtime/root
              ^profile runtime/profile/name
              ^running 0
              ^plugins []
              ^mode "recovery"
              ^readiness "Recovery mode; normal execution is disabled."})))
      (if (&& (== request/method "GET") (== request/path $"${(api_root)}/plugins"))
        (let result
          (plugin_catalog ^query (field ^default "" request/params "q") ^state (field ^default "" request/params "state")
            runtime))
        (result .put "csrf" browser/csrf)
        (result .put "epoch" runtime/epoch)
        (let failure_path $"${runtime/state_root}/startup_failure")
        (if ($fs/exists? failure_path) (result .put "startup_failure" ($fs/read_text failure_path)))
        (return (response 200 result)))
      (if (&& (== request/method "GET") (== request/path $"${(api_root)}/plugins/history"))
        (return
          (response
            200
            (plugin_history_catalog ^limit (if ($absent? request/params/limit) 50 else (number request/params "limit")) ^before (if ($absent? request/params/before) nil else (number request/params "before"))
              runtime
              (field ^default "" request/params "id")))))
      (if (&& (== request/method "POST") (== request/path $"${(api_root)}/plugins/inspect"))
        (let data (request_data request))
        (return
          (response
            200
            (inspect_descriptor ^revision (?? data/revision nil) runtime (field data "id")))))
      (if (&& (== request/method "POST") (== request/path $"${(api_root)}/plugins/history/pin"))
        (let data (request_data request))
        (if (|| (!= ($head data/revision) Int) (!= ($head data/pinned) Bool))
          (return
            (response
              400
              {^code "invalid_request" ^message "Integer revision and boolean pinned are required."})))
        (return
          (response
            200
            (pin_history
              runtime/workspace/store
              runtime/workspace/history_head/.get
              data/revision
              data/pinned))))
      (if (&& (== request/method "POST") (== request/path $"${(api_root)}/plugins/revert"))
        (let data (request_data request))
        (if (|| (!= ($head data/revision) Int) (!= ($head data/expected) Int))
          (return
            (response 400 {^code "invalid_request" ^message "Integer revisions are required."})))
        (return
          (response
            200
            (revert_entry ^expected data/expected runtime/workspace (field data "id") data/revision))))
      (if (&& (== request/method "GET") (== request/path $"${(api_root)}/appearance/preview"))
        (return (appearance_preview_request request runtime true)))
      (if (&& (["GET" "POST"] .contains? request/method) (== request/path $"${(api_root)}/appearance"))
        (return (appearance_request request runtime true)))
      (if (&& (== request/method "POST") (== request/path $"${(api_root)}/auth/reset"))
        (reset_auth auth)
        (log_refresh_redactions)
        (log_event ^target {^workspace runtime/root} "host/auth_reset" "owner credentials rotated")
        (publish_link runtime/state_root origin auth/secret)
        (return (response 200 {^^ok ^message "Owner credential reset. Use the new owner link."})))
      (if (&& (== request/method "POST") (== request/path $"${(api_root)}/control"))
        (let data (request_data request))
        (if_not (["stop" "restart"] .contains? data/action)
          (return (response 400 {^code "invalid_request" ^message "Use stop or restart."})))
        (let restart (&& (== data/action "restart") (== options/supervised true)))
        (if restart
          ($fs/write_text_atomic
            $"${runtime/state_root}/restart_notice"
            ($serde/write_data {^port port ^^normal})))
        (runtime/exit_code .set (if restart 75 else 0))
        (runtime/stopping .set true)
        (return
          (response
            200
            {
              ^^ok
              ^restart restart
              ^message (if restart
                         "Retrying normal startup."
                       else
                         "Stopped. Start the normal host from the terminal.")})))
      (response
        503
        {
          ^code "recovery_required"
          ^message "Recovery mode permits plugin inspection and repair only. Normal execution is disabled."}))
    (fn safe_handle [request]
      (secure_response
        (try
          (handle request)
        catch AuthError
          (response 401 {^code $err/code ^message $err/.message})
        catch Error
          (response 400 {^code (?? $err/code "recovery_error") ^message $err/.message}))))
    (mark_ready runtime/state_root (?? (options .get "startup-id") "") runtime/epoch port true)
    (log_event "host/recovery_ready"
      $"Harness recovery is ready at ${origin}; workspace plugins are not running."
      ^target {^workspace runtime/root}
      ^data {^origin origin})
    (print_browser_link ^supervised (== options/supervised true) runtime/root)
    ($io/flush_stdout)
    (serve ^handler safe_handle ^max_body_bytes 16777216 ^request_timeout_ms 10000 ^tick_ms 250 ^on_tick (fn [] (if runtime/stopping/.get (stop server)))
      server)
    runtime/exit_code/.get
  ensure
    (close_plugin_control control)
    (clear_connection runtime/root runtime/epoch)
    (if ($present? server) (try (stop server) catch Error nil))
    (close_runtime runtime)))
