# Host-only feature routes. Called only after common HTTP admission.
(mod voice_routes)
(import [response fail_request field request_data session_path?] ^from "../request")
(import [row] ^from "../../kernel")
(import [speech_catalog] ^from "../../runtime/speech_service")
(import [add_voice_peer remove_voice_peer voice_message] ^from "../voice")
(import [session_voice_state session_voice_claim] ^from "../session_service")
(import [record_voice_timing voice_timings] ^from "../../runtime/voice_state")
(import [append_core_event] ^from "../../storage/state")
(import $net/http [ws_accept])

(fn voice_request [context, request, parts]
  (let host context/host)
  (let safe context/safe)
  (let voice_hub context/voice)
  (let browser context/browser)
  (let auth context/auth)
  (let origin context/origin)
  (let request_origin context/request_origin)
  (if_yes (&& (== request/method "GET") (== request/path "/api/v8/voice/status"))
    (if safe (fail_request "unavailable" "Voice is off in the recovery UI."))
    (return (response 200 (speech_catalog voice_hub/speech))))
  (if_yes (&& (== request/method "GET") (== request/path "/api/v8/voice"))
    (if (|| safe (!= request_origin origin) ($absent? (row host/runtime/h "browser_clients" "voice")))
      (fail_request "forbidden" "The active voice plugin and a same-origin socket are required."))
    (return (ws_accept request ^subprotocol "gene-harness-voice.1"
      ^on_open (fn [connection]
        (add_voice_peer voice_hub connection browser/csrf
          (fn [] (== browser/generation ($crypto/sha256 auth/secret)))))
      ^on_message (fn [connection payload] (voice_message voice_hub connection payload))
      ^on_close (fn [connection] (remove_voice_peer voice_hub connection)))))
  (if_yes (session_path? parts)
    (let id parts/4)
    (if_yes (&& (== parts/.size 6) (== parts/5 "voice"))
      (if safe (fail_request "unavailable" "Voice is unavailable in the recovery UI."))
      (if (== request/method "GET") (return (response 200 (session_voice_state host id))))
      (if (== request/method "POST") (return (response 200 (session_voice_claim host id (request_data request))))))
    (if_yes (&& (== parts/.size 7) (== parts/5 "voice") (== parts/6 "latency") (== request/method "POST"))
      (let data (request_data request))
      (let identity (field data "identity" ^default ""))
      (let input_kind (field data "input_kind" ^default ""))
      (if (|| (! (["input" "output" "loop" "round" "error"] .contains? data/kind)) (!= ($head data/elapsed_ms) Int)
              (> ($str/byte_size identity) 256) (! (["" "typed" "voice"] .contains? input_kind))
              (< data/elapsed_ms 0) (> data/elapsed_ms 3600000))
        (fail_request "invalid_request" "Invalid voice timing."))
      (append_core_event host/runtime/events "session" id
        {^type "trace" ^kind "voice/latency" ^text "voice/latency"
         ^timing (record_voice_timing ^identity identity ^input_kind input_kind
           host/runtime/voice id data/kind data/elapsed_ms) ^^ignorable})
      (return (response 200 {^^ok})))
    (if_yes (&& (== parts/.size 7) (== parts/5 "voice") (== parts/6 "latency") (== request/method "GET"))
      (return (response 200 {^timings (voice_timings host/runtime/voice id)})))
  )
  nil)
