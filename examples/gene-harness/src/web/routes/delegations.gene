# Host-only feature routes. Called only after common HTTP admission.
(mod delegations_routes)
(import [response field number request_data session_path?] ^from "../request")
(import [recover_children cancel_child] ^from "../session_service")

(fn delegations_request [context, request, parts]
  (let host context/host)
  (if_yes (session_path? parts)
    (let id parts/4)
    (if_yes (&& (== parts/.size 7) (== parts/5 "delegations") (== parts/6 "recovery") (== request/method "POST"))
      (let data (request_data request))
      (return (response 200 (recover_children host id (field data "round_id") (field data "action")))))
    (if_yes (&& (== parts/.size 8) (== parts/5 "delegations") (== parts/7 "cancel") (== request/method "POST"))
      (let data (request_data request))
      (let admission (if (== ($head data/admission) Int) data/admission (number data "admission")))
      (return (response 200 (cancel_child host id parts/6 admission))))
  )
  nil)
