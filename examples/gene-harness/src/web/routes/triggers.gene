# Host-only feature routes. Called only after common HTTP admission.
(mod triggers_routes)
(import [api_root api_version] ^from "../contract.gene")
(import [response request_data] ^from "../request")
(import [list_triggers create_trigger delete_trigger list_occurrences] ^from "../../runtime/triggers")
(import [require_trigger_manager] ^from "../../runtime/trigger_host")

(fn triggers_request [context, request, parts]
  (let host context/host)
  (if_yes (&& (== request/path $"${(api_root)}/trigger-occurrences") (== request/method "GET"))
    (return (response 200 {^occurrences (list_occurrences (require_trigger_manager host/runtime))})))
  (if (== request/path $"${(api_root)}/triggers")
    (then
      (if (== request/method "GET")
        (return (response 200 {^triggers (list_triggers (require_trigger_manager host/runtime))})))
      (if (== request/method "POST")
        (return (response 201 (create_trigger (require_trigger_manager host/runtime) (request_data request)))))))
  (if_yes (&& (>= parts/.size 5) (== parts/1 "api") (== parts/2 (api_version)) (== parts/3 "triggers"))
    (if (&& (== parts/.size 5) (== request/method "DELETE"))
      (return (response 200 (delete_trigger (require_trigger_manager host/runtime) parts/4))))
    (if (&& (== parts/.size 6) (== parts/5 "occurrences") (== request/method "GET"))
      (return (response 200 {^occurrences (list_occurrences (require_trigger_manager host/runtime) ^trigger parts/4)}))))
  nil)
