# Host-only feature routes. Called only after common HTTP admission.
(mod notifications_routes)
(import [api_root api_version] ^from "../contract.gene")
(import [response number request_data] ^from "../request")
(import [inbox_snapshot message_detail clear_messages acknowledge_messages] ^from "../../notifications/inbox")
(import [publish_notification] ^from "../../notifications/publisher")
(import [invoke_notification_action] ^from "../../notifications/actions")

(fn notifications_request [context, request, parts]
  (let host context/host)
  (let safe context/safe)
  (if_yes (&& (== request/path $"${(api_root)}/notifications") (== request/method "GET"))
    (let state (inbox_snapshot host/runtime/services/values/inbox))
    (state .put "epoch" host/epoch)
    (if safe (for item in state/messages (item .put "detail" nil)))
    (return (response 200 state)))
  (if_yes (&& (== request/path $"${(api_root)}/notifications") (== request/method "POST"))
    (return (response 201 (publish_notification host/runtime/h host/runtime/services/values/inbox "operator" (request_data request)))))
  (if_yes (&& (== request/path $"${(api_root)}/notifications/ack") (== request/method "POST"))
    (let data (request_data request))
    (return (response 200 (acknowledge_messages host/runtime/services/values/inbox
      (if (== ($head data/through) Int) data/through (number data "through"))))))
  (if_yes (&& (== request/path $"${(api_root)}/notifications/clear") (== request/method "POST"))
    (let data (request_data request))
    (return (response 200 (clear_messages host/runtime/services/values/inbox data/messages))))
  (if_yes (&& (== request/path $"${(api_root)}/notifications/action") (== request/method "POST"))
    (let result (invoke_notification_action host/runtime (request_data request)))
    (return (response (if (== result/kind "command") 202 200) result)))
  (if_yes (&& (== parts/.size 5) (== parts/1 "api") (== parts/2 (api_version))
              (== parts/3 "notifications") (== request/method "GET"))
    (let message (message_detail host/runtime/services/values/inbox parts/4))
    (if safe (message .put "detail" nil))
    (return (response 200 message)))
  nil)
