# Host-only feature routes. Called only after common HTTP admission.
(mod channels_routes)
(import [response fail_request field optional_field number request_data session_path?] ^from "../request")
(import [channel_request] ^from "../../channels/http")
(import [session_slack_thread session_add_to_slack] ^from "../session_service")
(import $net/http [redirect])

(fn channels_request [context, request, parts]
  (let host context/host)
  (let root context/root)
  (let safe context/safe)
  (let media_store context/media)
  (let voice_hub context/voice)
  (let browser context/browser)
  (let auth context/auth)
  (let origin context/origin)
  (let request_origin context/request_origin)
  (let plugin_control context/plugin_control)
    (let channel_result (channel_request host/runtime/channels request/method request/path
      (if (&& (== request/method "POST") (request/path .starts_with? "/api/v8/channels"))
        (request_data request) {})))
    (if_not ($absent? channel_result) (return (response channel_result/status channel_result/body)))
    (if_yes (session_path? parts)
      (let id parts/4)
      (if_yes (&& (== parts/.size 6) (== parts/5 "slack-thread") (== request/method "GET"))
        (return (redirect (session_slack_thread host id))))
      (if_yes (&& (== parts/.size 6) (== parts/5 "slack") (== request/method "POST"))
        (return (response 202 (session_add_to_slack host id (number (request_data request) "revision")))))
    )
  nil)
