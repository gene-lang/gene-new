(mod harness_style_narrow)
(var rules """
.app { --shell-narrow: 1; }
.manager_grid { grid-template-columns: minmax(0, 1fr); }

  .app { grid-template-areas: "host" "main"; grid-template-columns: minmax(0, 1fr); }
  .app > .sidebar { display: none; }
  .app.menu_open > .sidebar { display: flex; position: fixed; inset: 0 auto 0 0; width: min(var(--sidebar-overlay-max-width), var(--sidebar-width)); z-index: var(--layer-overlay); background: var(--surface-alt); border-right: var(--border-width) solid var(--edge); box-shadow: 0 0 0 100vmax var(--scrim); }
  .mobile_only { display: inline-block; }
  .app.has_ui_panel, .app.has_ui_panel.ui_right { grid-template-areas: "host" "panel" "main"; grid-template-rows: auto minmax(0, 1fr) minmax(0, 1fr); grid-template-columns: minmax(0, 1fr); }
  .app.ui_full { grid-template-areas: "host" "panel"; grid-template-rows: auto minmax(0, 1fr); }
  .app.has_ui_panel > .workspace { min-height: 0; }
  .ui_panel { max-height: var(--panel-narrow-max-height); border-right: 0; border-bottom: var(--border-width) solid var(--line); }

""")
