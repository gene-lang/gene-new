(mod harness_style_components)
(import ^from "../../public/web_style" [shell_css])
(var styles (shell_css """
@layer components {
:focus-visible { outline: var(--focus-width) solid var(--focus); outline-offset: var(--focus-offset); }
button { cursor: pointer; min-height: var(--control-height); line-height: var(--line-tight); border: var(--border-width) solid var(--edge); border-radius: var(--radius-control); background: transparent; color: inherit; padding: var(--inset-control); margin-right: var(--space-1); }
input[type=file]::file-selector-button { font: inherit; cursor: pointer; min-height: var(--control-height); line-height: var(--line-tight); border: var(--border-width) solid var(--line); border-radius: var(--radius-control); background: transparent; color: inherit; padding: var(--inset-control); margin-right: var(--space-2); }
.session, .session_tab button, .command, .notification_local, .notification_local_open, .occurrence,
.sidebar_footer button, .sidebar_footer a, .suggestions button, .ui_panel td button,
.older_messages, .web_image_grid > .web_image_point { border-radius: var(--radius-row); }
button:hover:not(:disabled) { background: var(--soft); }
button:disabled { cursor: not-allowed; opacity: var(--opacity-disabled); }
a { color: var(--link-color); text-decoration: var(--link-decoration); }
input, textarea, select { color: var(--ink); }
option { color: var(--ink); background: var(--surface); }
input[type=checkbox], input[type=radio], progress { accent-color: var(--accent); }
input::placeholder, textarea::placeholder { color: var(--muted); opacity: 1; }
.sidebar_content { display: flex; flex: 1; flex-direction: column; min-height: 0; }
.brand { display: flex; align-items: baseline; gap: var(--space-2); padding: 0 var(--space-3) var(--space-8); }
.brand_name { font-size: var(--text-2xl); font-weight: var(--weight-bold); letter-spacing: var(--tracking-brand); }
.brand_detail { font-size: var(--text-sm); color: var(--muted); }
.local { margin-left: auto; font-size: var(--text-2xs); color: var(--muted); }
.local::before { content: ""; display: inline-block; width: var(--size-0-375); height: var(--size-0-375); margin-right: var(--space-1); background: var(--accent); vertical-align: middle; }
.new_session { display: flex; align-items: center; gap: var(--space-3); width: 100%; padding: var(--inset-control); text-align: left; border-color: var(--edge); font-size: var(--text-sm); }
.new_session .plus { font-size: var(--text-xl); line-height: var(--line-tight); font-weight: var(--weight-regular); color: var(--muted); }
.filter { width: 100%; min-width: 0; border: 0; background: transparent; padding: var(--space-2) var(--space-3); margin: var(--space-4) 0 var(--space-3); font-size: var(--text-sm); }
.filter:focus { background: var(--surface); }
.app .section_label { padding: var(--space-1) var(--space-3) var(--space-3); font-size: var(--text-2xs); font-weight: var(--weight-medium); color: var(--muted); letter-spacing: var(--tracking-label); text-transform: uppercase; }
.session_list { flex: 1; min-height: 0; overflow: auto; }
.session { display: flex; flex-direction: column; gap: var(--space-1); width: 100%; border: 0; padding: var(--space-2) var(--space-3); margin: var(--space-1) 0; text-align: left; }
.session.selected { background: var(--selected); }
.session_name { width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--text-sm); }
.session.selected .session_name { font-weight: var(--weight-medium); }
.session_row { display: flex; align-items: center; min-width: 0; position: relative; }
.session_row.selected { background: var(--selected); }
.session_row .session { flex: 1; min-width: 0; margin: var(--space-1) 0; }
.session_more { flex-shrink: 0; width: var(--size-1-875); min-height: var(--control-height); padding: var(--space-1); border: 0; opacity: 0; color: var(--muted); font-size: var(--text-xl); }
.session_row:hover .session_more, .session_row:focus-within .session_more, .session_more[aria-expanded=true] { opacity: 1; }
.session_menu { row-gap: var(--space-1); position: fixed; z-index: var(--layer-menu); width: var(--menu-width); max-width: calc(100vw - var(--size-1)); max-height: calc(100dvh - var(--size-1)); overflow: auto; padding: var(--space-2); border: var(--border-width) solid var(--line); background: var(--surface); color: var(--ink); box-shadow: var(--shadow-raised); font-size: var(--text-sm); }
.session_menu[role=menu] > button { border-radius: var(--radius-row); display: block; width: 100%; border: 0; padding: var(--space-2) var(--space-2); text-align: left; }
.session_menu p { margin: var(--space-1); font-size: var(--text-xs); }
.session_menu strong, .session_menu label { display: block; margin: var(--space-1); font-weight: var(--weight-medium); }
.session_menu input { width: 100%; min-width: 0; margin: var(--space-1) 0 var(--space-2); padding: var(--space-1); border: var(--border-width) solid var(--line); background: var(--surface); }
.session_menu .danger { color: var(--danger); }
.session_menu_error:empty { display: none; }
.session_menu_error { color: var(--danger); }
@media (hover: none) { .session_more { opacity: 1; width: var(--size-2-25); min-height: var(--control-height); } }
.session_meta { color: var(--muted); font-size: var(--text-2xs); }
.sidebar_empty { margin: 0; padding: var(--space-2) var(--space-3); color: var(--muted); font-size: var(--text-sm); line-height: var(--line-body); }
.sidebar_footer { border-top: var(--border-width) solid var(--line); margin-top: var(--space-4); padding-top: var(--space-3); }
.sidebar_footer button, .sidebar_footer a { display: block; width: 100%; border: 0; padding: var(--space-2) var(--space-3); font-size: var(--text-xs); text-align: left; color: var(--muted); text-decoration: none; }
.sidebar_footer a:hover { background: var(--soft); color: var(--ink); }
.session_filters { display: grid; gap: var(--space-1); margin-bottom: var(--space-3); font-size: var(--text-xs); }
.session_filters select, .session_filters input { width: 100%; min-width: 0; border: var(--border-width) solid var(--edge); padding: var(--space-1); background-color: var(--field-surface, var(--surface)); }
.session_filters details { color: var(--muted); }
.session_filters label { display: grid; gap: var(--space-1); margin-top: var(--space-1); }
#attention_sessions { max-height: var(--size-11-25); overflow: auto; border-left: var(--border-width-strong) solid var(--accent); }
.session_tab_bar { display: flex; flex-shrink: 0; align-items: center; gap: var(--space-1); min-width: 0; padding: var(--space-2) var(--space-4) 0; }
.session_tab_bar .menu_toggle { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; width: var(--control-height); height: var(--control-height); padding: 0; font-size: var(--text-xl); line-height: var(--line-tight); }
.session_tabs { display: flex; flex: 1; gap: var(--space-1); min-width: 0; overflow: auto; }
.session_tab { display: flex; flex-shrink: 0; border: var(--border-width) solid var(--line); font-size: var(--text-xs); max-width: var(--size-16-25); }
.session_tab.selected { background: var(--selected); border-color: var(--accent); border-bottom-width: var(--border-width-strong); }
.session_tab button { border: 0; padding: var(--space-1) var(--space-2); white-space: nowrap; }
.session_tab button:first-child { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
.session_tab button:last-child { flex: 0 0 var(--size-1-75); padding: var(--space-1) 0; margin: 0; }
.session_tab small { display: block; color: var(--muted); font-size: var(--text-2xs); }
.live_output[hidden] { display: none; }
.live_output summary { color: var(--muted); }
.live_output pre { max-height: var(--size-24); overflow: auto; white-space: pre-wrap; overflow-wrap: anywhere; }
.trigger_row { display: flex; justify-content: space-between; margin: var(--space-2) 0; gap: var(--space-2); }
.trigger_row small { display: block; color: var(--muted); }
.trigger_create { margin-top: var(--space-6); }
.trigger_create form, .trigger_create label { display: grid; gap: var(--space-2); margin: var(--space-2) 0; }
.trigger_create input, .trigger_create textarea, .trigger_create select { min-width: 0; padding: var(--space-1); border: var(--border-width) solid var(--edge); background-color: var(--field-surface, var(--surface)); }
.occurrence { display: grid; gap: var(--space-1); width: 100%; margin: var(--space-2) 0; text-align: left; font-size: var(--text-xs); }
.topbar { display: flex; flex-wrap: wrap; align-items: center; flex-shrink: 0; gap: var(--space-4); min-height: var(--topbar-height); padding: var(--space-4) var(--gutter); }
.heading { flex: 1 1 var(--menu-width); min-width: 0; }
.topbar h1 { margin: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: var(--text-md); font-weight: var(--weight-medium); letter-spacing: var(--tracking-tight); }
#conversation_title a { color: var(--link-color); text-decoration: var(--link-decoration); text-decoration-color: var(--muted); text-decoration-thickness: var(--border-width); text-underline-offset: var(--rule-width); }
#conversation_title a:hover, #conversation_title a:focus-visible { color: var(--accent); text-decoration-color: currentColor; }
.mode { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; margin-top: var(--space-1); color: var(--muted); font-size: var(--text-2xs); }
.quiet { border-color: transparent; color: var(--muted); font-size: var(--text-xs); }
.plugin_component { min-width: 0; }
.plugin_component img, .ui_panel img { max-width: 100%; }
.card_block { margin: var(--space-3) 0; border: var(--border-width) solid var(--line); background: var(--surface); }
.card_header { display: flex; gap: var(--space-3); align-items: baseline; justify-content: space-between; padding: var(--space-2) var(--space-3); border-bottom: var(--border-width) solid var(--line); background: var(--soft); }
.card_title { letter-spacing: var(--tracking-tight); }
.card_status { color: var(--muted); font-size: var(--text-sm); }
.card_body { padding: var(--space-3) var(--space-3); min-width: 0; overflow-x: auto; }
.card_body img { max-width: 100%; }
.card_body button, .question_view button { margin: var(--space-1) var(--space-2) var(--space-1) 0; }
.card_body input, .card_body textarea, .card_body select { max-width: 100%; padding: var(--space-2); border: var(--border-width) solid var(--edge); background-color: var(--field-surface, var(--surface)); }
.card_controls { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; padding: 0 var(--space-3); }
.card_controls:not(:empty) { padding: var(--space-2) var(--space-3) var(--space-3); }
.card_error { margin: 0; color: var(--danger); }
.card_update { margin: var(--space-2) 0; color: var(--muted); font-size: var(--text-sm); }
.card_question { padding: var(--space-2) var(--space-3); }
.card_question p { margin: var(--space-1) 0; }
.card_selected, button[aria-pressed=true] { border-color: var(--accent); outline: var(--focus-width) solid var(--focus); }
.card_answered button[aria-pressed=true]:disabled { opacity: 1; }
#web_sidebar { margin: var(--space-2) 0; }
#web_sidebar .web_card { padding: var(--space-3); font-size: var(--text-sm); }
#web_sidebar .web_grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2); }
#web_sidebar .web_metric { font-size: var(--text-2xl); }
#web_sidebar .web_grid small { display: block; }
#web_composer { margin-bottom: var(--space-3); }
#web_status { margin-top: var(--space-4); }
#rename_session:disabled { visibility: hidden; }
.transcript { flex: 1; min-height: var(--transcript-min-height); overflow: auto; padding: var(--space-8) max(var(--space-8), calc((100% - var(--content-width)) / 2)); scrollbar-gutter: stable; }
.transcript:has(> .empty_state) { display: flex; align-items: center; }
.empty_state { width: 100%; max-width: var(--content-width); margin: auto; padding: var(--space-8) 0 var(--space-12); }
.empty_state h2 { max-width: var(--size-30); margin: 0 0 var(--space-4); font-size: var(--text-display); line-height: var(--line-tight); font-weight: var(--weight-regular); letter-spacing: var(--tracking-tight); text-wrap: balance; }
.empty_state p { margin: 0; max-width: var(--size-25); font-size: var(--text-md); color: var(--muted); }
.suggestions { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); margin-top: var(--space-8); }
.suggestions button { display: flex; align-items: center; gap: var(--space-3); border: 0; padding: var(--space-1) 0; font-size: var(--text-sm); color: var(--muted); }
.suggestions button:hover:not(:disabled) { color: var(--ink); background: transparent; }
.suggestions .suggestion_symbol { font-size: var(--text-md); color: var(--accent); }
.run { max-width: var(--content-width); margin: 0 auto var(--space-10); }
.run + .run { padding-top: var(--space-5); }
.message { max-width: var(--content-width); margin: 0 auto var(--space-6); }
.speaker { margin: 0 0 var(--space-2); color: var(--muted); font-size: var(--text-xs); font-weight: var(--weight-medium); }
.user { width: fit-content; max-width: var(--message-user-max-width); margin-left: auto; margin-right: 0; padding: var(--space-3) var(--space-4); text-align: left; color: var(--ink); background: var(--message-user-surface, var(--soft)); }
.agent { padding: var(--space-1) 0; }
.command_output { margin: 0; padding: 0; background: transparent; border: 0; font-family: var(--font-mono); font-size: var(--text-md); line-height: var(--line-code); white-space: pre-wrap; overflow-wrap: anywhere; }
.message_text { white-space: pre-wrap; overflow-wrap: anywhere; font-size: var(--text-md); }
.provisional .speaker { color: var(--accent); }
.app .step { margin: var(--space-4) 0 var(--space-6); border-left: var(--border-width) solid var(--line); padding-left: var(--space-4); }
.app .step > summary { cursor: pointer; color: var(--muted); font-size: var(--text-xs); padding: var(--space-1) 0; }
.step_content { padding: var(--space-2) 0 0; }
.step_content .speaker { display: none; }
.step_content .message { margin: 0 0 var(--space-2); }
.step_content .message:last-child { margin-bottom: 0; }
.execution { position: relative; overflow: hidden; }
.execution[open] { background: var(--code-surface, var(--soft)); }
.execution summary { padding: var(--space-2) var(--space-3); cursor: pointer; color: var(--muted); font-size: var(--text-xs); }
.execution pre { margin: 0; padding: var(--space-3) var(--space-4) var(--space-4); overflow: auto; white-space: pre-wrap; overflow-wrap: anywhere; font-size: var(--text-sm); line-height: var(--line-code); }
.copy { float: right; margin: var(--space-1) var(--space-3); padding: var(--space-1) var(--space-2); font-size: var(--text-2xs); color: var(--muted); border: 0; }
.source_preview { overflow: hidden; border: var(--border-width) solid var(--line); background: var(--code-surface, var(--soft)); }
.source_header { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); padding: var(--space-2) var(--space-3); border-bottom: var(--border-width) solid var(--line); font-size: var(--text-xs); color: var(--muted); }
.source_path { min-width: 0; overflow-wrap: anywhere; }
.source_header .copy { float: none; flex-shrink: 0; margin: 0; }
.source_pre, .user_code { margin: 0; padding: var(--space-4); overflow: auto; white-space: pre; tab-size: 2; font: var(--type-code); }
.source_pre { max-height: var(--size-32); }
.user_code { padding: 0; }
.source_notice { padding: 0 var(--space-4); }
.muted { color: var(--muted); font-size: var(--text-xs); }
.run_status { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-1) var(--space-3); margin: var(--space-3) 0 0; font-size: var(--text-xs); color: var(--muted); }
.run_error { color: var(--danger); }
.outcome_message { color: var(--muted); }
.edit_retry { font-size: var(--text-xs); padding: var(--space-1) var(--space-2); }
.input_mode #prompt { font-family: var(--font-mono); }
.older_messages { display: block; margin: 0 auto var(--space-6); border: 0; font-size: var(--text-xs); color: var(--muted); }
.new_output { align-self: center; margin: 0 0 var(--space-2); padding: var(--space-1) var(--space-3); border-color: var(--edge); background: var(--surface); font-size: var(--text-xs); }
.composer_wrap { flex-shrink: 0; padding: var(--space-3) max(var(--space-8), calc((100% - var(--content-width)) / 2)) var(--space-8); }
.composer { border: var(--border-width) solid var(--edge); padding: var(--space-3) var(--space-3) var(--space-3) var(--space-4); background: var(--field-surface, var(--surface)); }
.composer:focus-within { border-color: var(--accent); }
.media_picker { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-2) var(--space-4); padding: var(--space-1) 0 var(--space-2); color: var(--muted); font-size: var(--text-xs); }
.media_picker label { display: flex; align-items: center; gap: var(--space-2); }
.media_picker input { max-width: var(--size-17); font-size: var(--text-xs); }
.media_drafts, .message_attachments { display: flex; flex-wrap: wrap; gap: var(--space-3); }
.media_drafts:empty { display: none; }
.media_drafts { max-height: var(--size-12); overflow: auto; margin-bottom: var(--space-2); }
.attachment_draft { display: flex; flex-direction: column; gap: var(--space-1); max-width: var(--size-14); padding: var(--space-2); border: var(--border-width) solid var(--line); }
.attachment { display: flex; flex-direction: column; gap: var(--space-1); max-width: var(--size-16); overflow-wrap: anywhere; font-size: var(--text-sm); }
.attachment img { display: block; max-width: 100%; width: auto; max-height: var(--size-8); object-fit: contain; }
.message_attachments { margin-top: var(--space-2); }
.attachment_draft small { color: var(--muted); }
.attachment_draft button { align-self: flex-start; font-size: var(--text-2xs); padding: var(--space-1) var(--space-2); }
.composer textarea { display: block; width: 100%; min-height: var(--size-3-4); max-height: var(--composer-max-height); resize: vertical; padding: var(--space-1) var(--space-1) var(--space-2) 0; border: 0; outline: none; background: transparent; font-size: var(--text-md); line-height: var(--line-body); }
.composer_actions { display: flex; align-items: center; gap: var(--space-2); }
.composer_actions .hint { flex: 1; color: var(--muted); font-size: var(--text-2xs); }
.send { min-width: var(--size-4); border-color: var(--ink); background: var(--ink); color: var(--action-ink); font-size: var(--text-sm); padding: var(--inset-control); }
.send:hover:not(:disabled) { background: var(--muted); border-color: var(--muted); }
.stop { border-color: var(--edge); font-size: var(--text-sm); }
.notice { color: var(--accent); padding: var(--space-2) var(--space-1) 0; font-size: var(--text-xs); }
.notice:empty { padding: 0; }
.notice { max-height: var(--size-8); overflow: auto; }
.notice_item { display: flex; align-items: flex-start; gap: var(--space-1); padding: var(--space-1) 0; overflow-wrap: anywhere; color: var(--ink); }
.notice_item > span { flex: 1; min-width: 0; }
.notice_dismiss { flex-shrink: 0; margin: 0; padding: var(--space-1) var(--space-1); border: 0; color: var(--muted); line-height: var(--line-tight); }
.notification_message_controls { margin: var(--space-2) 0 var(--space-3); }
.notice_item[data-severity="error"] { border-left: var(--rule-width) solid var(--danger); padding-left: var(--space-2); }
.confirmation { border: var(--border-width) solid var(--accent); padding: var(--space-3); margin-top: var(--space-2); }
.confirmation button { margin: var(--space-1) var(--space-2); }
.drawer.notification_center { width: var(--drawer-width-wide); }
.notification_card { padding: var(--space-3) 0; border-top: var(--border-width) solid var(--line); overflow-wrap: anywhere; }
.notification_card h3 { margin: var(--space-1) 0; font-size: var(--text-lg); }
.notification_card button, .question_editor button { margin: var(--space-1) var(--space-2) var(--space-1) 0; }
.notification_questions { border: 0; padding: 0; min-width: 0; }
.question_editor fieldset { min-width: 0; margin: var(--space-2) 0; border: var(--border-width) solid var(--line); }
.question_editor textarea, .question_editor select { width: 100%; max-width: 100%; padding: var(--space-2); border: var(--border-width) solid var(--edge); background-color: var(--field-surface, var(--surface)); }
.question_editor label { display: block; }
.notification_local { display: flex; align-items: flex-start; width: 100%; border: var(--border-width) solid var(--line); overflow-wrap: anywhere; }
.notification_local_open { flex: 1; min-width: 0; margin: 0; padding: var(--space-2); border: 0; text-align: left; }
.notification_local > .notice_dismiss { margin: var(--space-2) var(--space-1); }
#notification_reference_text { white-space: pre-wrap; overflow-wrap: anywhere; max-height: var(--size-20); overflow: auto; }
.commands { max-height: min(var(--size-15), var(--command-list-max-height)); overflow: auto; border: var(--border-width) solid var(--edge); padding: var(--space-1); margin-bottom: var(--space-2); background: var(--field-surface, var(--surface)); }
.command { display: flex; align-items: baseline; gap: var(--space-4); width: 100%; padding: var(--space-2) var(--space-2); text-align: left; border: 0; font-size: var(--text-sm); }
.command strong { min-width: var(--size-6-5); font: var(--type-code); }
.command span { color: var(--muted); }
.commands .muted { padding: var(--space-1) var(--space-3); }
.resolve { font-size: var(--text-xs); margin-top: var(--space-2); }
.drawer { position: fixed; right: var(--size-1-25); top: var(--size-4-5); z-index: var(--layer-drawer); width: var(--drawer-width); max-width: calc(100vw - var(--size-2-5)); max-height: calc(100dvh - var(--size-6)); overflow: auto; padding: var(--inset-surface); border: var(--border-width) solid var(--edge); background: var(--surface); }
.drawer_header { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); margin-bottom: var(--space-3); }
.drawer h2 { margin: 0; font-size: var(--text-md); font-weight: var(--weight-medium); }
.drawer p { font-size: var(--text-sm); color: var(--muted); }
.drawer_close { border: 0; padding: var(--space-1) var(--space-2); color: var(--muted); font-size: var(--text-xl); line-height: var(--line-tight); }
.plugin_status { display: flex; justify-content: space-between; gap: var(--space-4); padding: var(--space-2) 0; border-bottom: var(--border-width) solid var(--line); font-size: var(--text-xs); overflow-wrap: anywhere; }
.plugin_status span:last-child { color: var(--accent); }
.rename_form { display: flex; gap: var(--space-2); padding: var(--space-2) var(--gutter) var(--space-4); }
.rename_form input { flex: 1; min-width: 0; padding: var(--space-2) var(--space-3); border: var(--border-width) solid var(--edge); background: var(--field-surface, var(--surface)); font-size: var(--text-sm); }
.rename_form button { font-size: var(--text-sm); }
.auth_notice { overflow-wrap: anywhere; padding: var(--space-3) var(--gutter); border-block: var(--border-width) solid var(--line); background: var(--notice-surface, var(--soft)); color: var(--ink); font-size: var(--text-xs); }
.auth_notice strong { display: block; font-weight: var(--weight-medium); margin-bottom: var(--space-1); }
.input_panel { padding: var(--space-4); margin-bottom: var(--space-3); border: var(--border-width) solid var(--line); background: var(--notice-surface, var(--soft)); }
.input_panel strong { display: block; margin-bottom: var(--space-3); font-size: var(--text-md); font-weight: var(--weight-medium); }
.input_panel textarea, .input_panel select { width: 100%; border: var(--border-width) solid var(--edge); padding: var(--space-2); background-color: var(--field-surface, var(--surface)); font-size: var(--text-md); }
.input_actions { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-3); }
.input_actions button { font-size: var(--text-xs); }
#input_fields { max-height: var(--size-12); overflow: auto; }
.input_option { display: flex; gap: var(--space-2); align-items: center; padding: var(--space-1) 0; }
.markdown { overflow-wrap: anywhere; font-size: var(--text-md); line-height: var(--line-code); }
.markdown p { margin: var(--space-3) 0; }
.markdown .reply_image { display: inline-flex; flex-direction: column; max-width: 100%; gap: var(--space-1); }
.markdown .reply_image img { display: block; max-width: 100%; max-height: var(--media-preview-max-height); object-fit: contain; }
.markdown > :first-child { margin-top: 0; }
.markdown > :last-child { margin-bottom: 0; }
.markdown h1, .markdown h2, .markdown h3, .markdown h4, .markdown h5, .markdown h6 { line-height: var(--line-heading); margin: var(--space-6) 0 var(--space-3); font-weight: var(--weight-bold); letter-spacing: var(--tracking-tight); }
.markdown h1 { font-size: var(--text-2xl); }
.markdown h2 { font-size: var(--text-xl); }
.markdown h3 { font-size: var(--text-lg); }
.markdown ul, .markdown ol { padding-left: var(--space-6); margin: var(--space-3) 0; }
.markdown li { margin: var(--space-1) 0; }
.markdown a { color: var(--link-color); text-decoration: var(--link-decoration); text-underline-offset: var(--rule-width); }
.markdown code { font: var(--type-code); background: var(--soft); padding: var(--space-1) var(--space-1); }
.markdown pre { margin: var(--space-4) 0; overflow: auto; white-space: pre; padding: var(--space-4); border: 0; background: var(--code-surface, var(--soft)); }
.markdown pre code { padding: 0; background: none; }
.markdown blockquote { margin: var(--space-4) 0; padding-left: var(--space-4); border-left: var(--border-width-strong) solid var(--line); color: var(--muted); }
.table_scroll { overflow: auto; margin: var(--space-4) 0; }
.markdown table { border-collapse: collapse; min-width: var(--size-18); width: 100%; font-size: var(--text-sm); }
.markdown th, .markdown td { padding: var(--space-2) var(--space-3); border-bottom: var(--border-width) solid var(--line); text-align: left; }
.markdown th { font-weight: var(--weight-medium); }
.markdown .align_right { text-align: right; }
.markdown .align_center { text-align: center; }
@media (max-height: 600px) {
  .empty_state { padding-block: var(--space-4); }
  .empty_state h2 { font-size: var(--text-2xl); }
  .suggestions { margin-top: var(--space-3); }
  .composer_wrap { padding-bottom: var(--space-3); }
}
.ui_host_navigation, .ui_host_actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-3); }
.ui_host_actions:has(> :not([hidden])) { margin-top: var(--space-1); }
.prompt_offer { padding: var(--space-3); border: var(--border-width) solid var(--line); margin-bottom: var(--space-3); font-size: var(--text-sm); }
.prompt_offer pre { white-space: pre-wrap; overflow-wrap: anywhere; max-height: var(--size-10); overflow: auto; }
.prompt_offer button { margin-right: var(--space-2); }
#ui_sizing { display: inline-flex; gap: var(--space-2); align-items: center; }
#ui_width { width: var(--size-5-625); }
#ui_connection { margin-left: auto; color: var(--muted); }
#ui_pending_owner:empty { display: none; }
#ui_view_title { margin: 0 0 var(--space-2); font-size: var(--text-lg); }
#ui_view_title:focus-visible { outline: none; }
.ui_panel .web_card { padding: var(--space-4); }
.drawer { container: drawer / inline-size; }
.ui_panel label { display: grid; gap: var(--space-1); margin-block: var(--space-3); }
.ui_panel input, .ui_panel textarea, .ui_panel select { width: 100%; min-width: 0; padding: var(--space-2); border: var(--border-width) solid var(--edge); background-color: var(--field-surface, var(--surface)); }
.ui_panel input[type=checkbox] { width: auto; }
.ui_panel table { width: 100%; border-collapse: collapse; margin-block: var(--space-4); font-size: var(--text-sm); }
.ui_panel th, .ui_panel td { padding: var(--space-2); text-align: left; border-bottom: var(--border-width) solid var(--line); }
.ui_panel td button { text-align: left; border: 0; padding: var(--space-1); }
.ui_panel form { border-top: var(--border-width) solid var(--line); padding-top: var(--space-3); }
.ui_layout_controls { display: flex; align-items: center; gap: var(--space-3); padding: 0 var(--space-8) var(--space-2); font-size: var(--text-xs); }
#ui_workspace_link { color: var(--muted); font-size: var(--text-xs); }
#ui_workspace_link:hover { color: var(--accent); }
#ui_action_status { font-size: var(--text-sm); overflow-wrap: anywhere; }
#ui_action_status:empty { display: none; }
#theme_toggle { padding: var(--space-1) var(--space-2); font-size: var(--text-xs); }
select:not([multiple]) { appearance: none; -webkit-appearance: none; background-image: var(--select-chevron); background-repeat: no-repeat; background-position: right var(--size-0-55) center; background-size: var(--icon-size-sm) var(--icon-size-sm); padding-right: var(--space-6); }
select:not([multiple]):not([size]), select:not([multiple])[size="1"] { height: var(--control-height); min-height: var(--control-height); line-height: var(--line-tight); padding-block: 0; padding-left: var(--space-1); vertical-align: middle; }
input:not([type=radio]):not([type=checkbox]), textarea, select, .composer { border-radius: var(--radius-field); }
.user { border-radius: var(--radius-message); }
.drawer, .session_menu { background: var(--surface-raised); border-color: var(--edge); border-radius: var(--radius-surface); }
.drawer { box-shadow: var(--shadow-overlay); }
.send, button.web_primary { background: var(--action); border-color: var(--action); }
.send:hover:not(:disabled), button.web_primary:hover:not(:disabled) { background: var(--action-hover); border-color: var(--action-hover); }
.suggestions button:hover:not(:disabled) { text-decoration: underline; }
.icon { display: inline-block; flex: none; width: var(--icon-size); height: var(--icon-size); vertical-align: middle; background: currentColor; mask: var(--icon) center / contain no-repeat; -webkit-mask: var(--icon) center / contain no-repeat; }

.message_text, .composer textarea { font: var(--type-body); }
.app .section_label { font: var(--type-label); }
.empty_state h2 { font: var(--type-display); }
.drawer h2, .topbar h1 { font: var(--type-title); }
@compact {
  .brand { padding-bottom: var(--space-4); }
  .close_menu { margin-bottom: var(--space-4); border: 0; text-align: left; font-size: var(--text-sm); color: var(--muted); }
  .topbar { min-height: var(--size-4-25); padding: var(--space-3) var(--space-4); gap: var(--space-2); }
  .transcript { padding: var(--space-6) var(--space-5); scrollbar-gutter: auto; }
  .empty_state { padding: var(--space-6) 0 var(--space-8); }
  .empty_state h2 { max-width: var(--size-22-5); font-size: var(--text-display); }
  .empty_state p { max-width: var(--size-18-125); font-size: var(--text-md); }
  .suggestions { margin-top: var(--space-5); gap: var(--space-2) var(--space-5); }
  .composer_wrap { padding: var(--space-2) var(--space-4) max(var(--space-4), env(safe-area-inset-bottom)); }
  .composer { padding: var(--space-3); }
  .composer textarea { font-size: var(--text-lg); min-height: var(--size-3-2); }
  .composer_actions .hint { font-size: var(--text-2xs); }
  .send, .stop { min-height: var(--control-height); }
  .session, .sidebar_footer button, .sidebar_footer a { min-height: var(--control-height); }
  .command { gap: var(--space-2); }
  .command strong { min-width: var(--size-5-5); }
  .rename_form, .auth_notice { overflow-wrap: anywhere; padding: var(--space-2) var(--space-5); }
  .drawer { right: var(--size-1); top: var(--size-4-5); max-width: calc(100vw - var(--size-2)); }
  .user { max-width: calc(100% - var(--size-1)); }
  .run { margin-bottom: var(--space-8); }}
@compact { .drawer, .drawer.notification_center { left: 0; right: 0; width: 100%; max-width: 100%; } }
.media_picker label { max-width: 100%; min-width: 0; flex-wrap: wrap; }
.media_picker input { min-width: 0; max-width: min(100%, var(--size-17)); }
.ui_host label, .ui_host select { min-width: 0; max-width: 100%; }

.composer_actions { flex-wrap: wrap; }
.composer_actions .hint { min-width: 0; overflow-wrap: anywhere; }
#ui_sizing { flex-wrap: wrap; min-width: 0; max-width: 100%; }
@compact {
 .workspace .transcript { height: var(--transcript-compact-height); flex: none; }
}
}
"""))
