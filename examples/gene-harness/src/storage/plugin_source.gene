# Session attribution belongs to saved source, independently of the operation
# that most recently enabled, disabled or reverted it. No plugin code is read
# or executed here, and no conversation store is needed.
(mod plugin_source_attribution)

(fn session_reference [value]
  (if (|| (!= ($head value/session) Str) (== value/session "")) (return nil))
  (let result {^session value/session})
  (if_not ($absent? value/turn) (result .put "turn" ($to_str value/turn)))
  result)

(fn capture_source_origin [context]
  # Operator evaluations also own a turn-shaped execution scope for media and
  # queued publication. That scope does not make their source model-authored.
  (let command ($present? context/command))
  (let turn (if command nil context/turn))
  (let result
    {^kind (if command
      (then "command")
      (elif ($absent? turn) "direct")
      (else "model"))})
  (if (&& (== ($head context/session) Str) (!= context/session ""))
    (result .put "session" context/session))
  (if_not ($absent? turn/turn) (result .put "turn" ($to_str turn/turn)))
  result)

(fn source_attribution [entry]
  (if ($absent? entry/module_digest)
    (return {^created_in nil ^source_origin nil}))
  {^created_in (session_reference entry/created_in)
   ^source_origin (if (== ($head entry/source_origin) Map) entry/source_origin nil)})

# Called with the entry that actually exists at publication (or at a plan's
# validated base). A later replacement must not become the original creation.
(fn assign_creation [entry, previous]
  (entry .delete "created_in")
  (let creation
    (if ($absent? previous/module_digest)
      (session_reference entry/source_origin)
      (session_reference previous/created_in)))
  (if_not ($absent? creation) (entry .put "created_in" creation))
  entry)

(fn preserve_creation_on_revert [saved, previous]
  (if_not ($absent? previous/module_digest)
    (let creation (session_reference previous/created_in))
    (saved .delete "created_in")
    (if_not ($absent? creation) (saved .put "created_in" creation)))
  saved)
