# Desired composition generations, published by the workspace owner.

(mod workspace)

(import $store/fs [open : store_open Store StoreError])
(import $serde [write_data read_data])
(import $fs [make_dir real_path read_text write_text_atomic exists?])
(import $crypto [sha256])
(import $str [slice_bytes byte_size contains? starts_with? ends_with? split])
(import ^from "../kernel"
  [
    Harness
    ExecutionLimits
    default_execution_limits
    describe_plugin_module
    put_cordis_plugin
    put_cordis_plugins
    status_of
    configure_plugin_module
    invoke_bounded
    plugin_error
    log_append
    record_turn_start
    record_turn_end
    record_composition_change
    flush_harness
    hydrate_harness_log
    contribute
    row
    rows
    remove_owner
    uninstall
    module_dir])
(import ^from "./state" [validate_event_catalog repair_interrupted_turns])
(import ^from "../runtime/interface_policy"
  [current_interfaces latest_interfaces source_interfaces entry_core_interface retired_requirement
   interface_diagnostic InterfacePolicyError])
(import [public_modules public_import?] ^from "../runtime/public_modules")
(import [reset_participant_quarantine] ^from "./participant_health")
(import ^from "./plugin_history"
  [archive_host_build archive_baseline archive_candidate archived_record
   history_list history_revision history_entry append_history_result history_results])
(import ^from "./plugin_metadata" [remember_descriptor remember_failure])
(import ^from "./plugin_source"
  [capture_source_origin assign_creation preserve_creation_on_revert])
(import ^from "../runtime/composition"
  [queue_composition_change take_composition_changes run_composition_change])

(type CompositionError ^props {^message Str} ^impl [Error])
(impl Error for CompositionError)

(type CompositionConflict ^props {^message Str ^code Str ^expected Int ^actual Int} ^impl [Error])
(impl Error for CompositionConflict)

(type CompositionCommitUncertain ^props {^message Str ^code Str} ^impl [Error])
(impl Error for CompositionCommitUncertain)

(type Workspace ^props {^root Str ^state_root Str ^workspace_root Str ^store Any ^blob_store Any ^revision Any ^entries Any ^busy Any ^closed Any ^generated_dir Str ^shared Any ^interfaces Any ^core_interface Str ^errors Any ^active_revision Any ^profile_plugins Any ^history_head Any ^history_build Any ^history_profile Any ^metadata_errors Any})

(type WorkspaceRestorePlan ^props {^workspace Workspace ^entries Any ^descriptors Any ^session Str})

(fn fresh_list []
  ($thaw #[]))
(fn fresh_map []
  ($thaw #{}))

(fn data_copy [value]
  (read_data (write_data value)))

(fn require_open [workspace : Workspace]
  (if workspace/closed/.get
    (fail (CompositionError ^message "workspace composition store is closed")))
  workspace)

(fn validate_entry [entry, ids]
  (if (== entry/id void)
    (fail (CompositionError ^message "composition entry requires id")))
  (var id ($to_str entry/id))
  (if (== id "") (fail (CompositionError ^message "composition entry id is empty")))
  (if_not (== (ids .get id) void)
    (fail (CompositionError ^message $"duplicate composition entry ${id}")))
  (ids .put id true)
  (if (== entry/builtin true)
    (then
      (if_not (== entry/disabled true)
        (fail (CompositionError ^message $"built-in record ${id} must be disabled")))
      (if (|| (!= entry/module_digest void) (!= entry/closure void))
        (fail (CompositionError ^message $"built-in record ${id} cannot name a stored module"))))
    (else
      (if (|| (== entry/module_digest void) (== entry/closure void) (== entry/interfaces void))
        (fail
          (CompositionError ^message "composition entry requires module_digest closure interfaces")))
      (if_not (entry/closure .contains? entry/module_digest)
        (fail (CompositionError ^message $"composition entry ${id} closure omits its root digest")))))
  entry)

(fn validate_entries [entries]
  (var ids (fresh_map))
  (var checked (fresh_list))
  (for entry in entries
    (checked .push (validate_entry entry ids)))
  checked)

(fn load_composition [workspace : Workspace]
  (var loaded workspace/store/.Store:load_checkpoint)
  (if ($absent? loaded)
    (then
      (workspace/revision .set 0)
      (workspace/entries .set (fresh_list)))
    (else
      (var manifest (loaded/records .get "composition"))
      (if (== manifest void)
        (fail (CompositionError ^message "composition generation has no composition record")))
      (if_not ([1 2] .contains? manifest/format)
        (fail
          (CompositionError ^message $"unsupported composition format ${manifest/format}; expected 1 or 2")))
      (if (&& (== manifest/format 2) (!= ($head manifest/history_head) Str))
        (fail (CompositionError ^message "composition format 2 requires an archive head")))
      (var checked (validate_entries manifest/entries))
      (workspace/revision .set manifest/revision)
      (workspace/history_head .set (?? manifest/history_head nil))
      (workspace/entries .set checked)))
  workspace)

(fn harness_package_root [] : Str
  (module_dir (module_dir (module_dir this_mod/.path))))

(fn active_revision_path [workspace : Workspace] : Str
  $"${workspace/root}/ACTIVE")

(fn open_workspace [root : Str, ^blob_root blob_root : Str = "", ^state_root state_root : Str = "", ^workspace_root workspace_root : Str = "", ^generated_dir generated_dir : Str = ""] : Workspace
  (var canonical_root (real_path root))
  (var canonical_blob_root
    (if (== blob_root "")
      (then
        (var default_blob_root $"${canonical_root}/blobs")
        (make_dir default_blob_root)
        (real_path default_blob_root))
      (else
        (make_dir blob_root)
        (real_path blob_root))))
  (var package_root (harness_package_root))
  (var canonical_state_root (real_path (if (== state_root "") canonical_root state_root)))
  (var canonical_workspace_root (real_path (if (== workspace_root "") package_root workspace_root)))
  (var generated
    (if (== generated_dir "")
      (then
        (var scoped $"${canonical_blob_root}/source")
        (make_dir scoped)
        (real_path scoped))
      (else
        (make_dir generated_dir)
        (real_path generated_dir))))
  (var interfaces (current_interfaces))
  (var workspace
    (Workspace ^root canonical_root ^state_root canonical_state_root ^workspace_root canonical_workspace_root ^store (store_open ^root canonical_root) ^blob_store (store_open ^root canonical_blob_root) ^revision ($cell 0) ^entries ($cell (fresh_list)) ^busy ($cell false) ^closed ($cell false) ^generated_dir generated ^shared (public_modules) ^interfaces interfaces ^core_interface (/core (latest_interfaces)) ^active_revision ($cell nil) ^errors ($cell (fresh_map)) ^profile_plugins ($cell (fresh_map)) ^history_head ($cell nil) ^history_build ($cell nil) ^history_profile ($cell nil) ^metadata_errors ($cell [])))
  (load_composition workspace)
  (let marker (active_revision_path workspace))
  (if ($fs/exists? marker)
    (then
      (let recorded (read_data (read_text marker)))
      (if (|| (!= ($head recorded) Int) (< recorded 0))
        (fail (CompositionError ^message
          "composition ACTIVE marker must hold a non-negative revision")))
      (workspace/active_revision .set recorded)))
  workspace)

(fn set_profile_plugins [workspace : Workspace, admissions]
  (let defaults (fresh_map))
  (for item in admissions
    (let id item/plugin/id)
    (if_not ($absent? (defaults .get id))
      (fail (CompositionError ^message $"duplicate profile plugin ${id}")))
    (defaults .put id item))
  (workspace/profile_plugins .set defaults)
  nil)

(fn composition_revision [workspace : Workspace] : Int
  (require_open workspace)
  workspace/revision/.get)

(fn composition_entries [workspace : Workspace]
  (require_open workspace)
  (data_copy workspace/entries/.get))

(fn attach_history [workspace : Workspace, build, profile]
  (require_open workspace)
  (let identity (archive_host_build workspace/store build))
  (workspace/history_build .set identity)
  (workspace/history_profile .set (data_copy profile))
  (for builtin in (?? profile/builtins [])
    (try (remember_descriptor ^mode "host" workspace/store identity "builtin" builtin)
      catch Any (workspace/metadata_errors/.get .push {^id builtin/id ^message $err/message})))
  (if ($absent? workspace/history_head/.get)
    (workspace/history_head .set
      (archive_baseline workspace/store
        {^revision workspace/revision/.get ^entries workspace/entries/.get}
        identity profile))
    (do
      (let saved (archived_record workspace/store workspace/history_head/.get))
      (if (|| (!= saved/revision workspace/revision/.get) (!= saved/entries workspace/entries/.get))
        (fail (CompositionError ^message "composition checkpoint disagrees with its history record")))))
  identity)

(fn composition_history [workspace : Workspace, ^limit limit : Int = 100, ^before before = nil]
  (require_open workspace)
  (history_list ^limit limit ^before before workspace/store workspace/history_head/.get))

(fn composition_history_result [workspace : Workspace, result]
  (if_not ($absent? workspace/history_head/.get)
    (append_history_result workspace/store workspace/history_head/.get result)))

(fn record_application_result [workspace : Workspace, h : Harness, result]
  (let expected {})
  (for [id default] in workspace/profile_plugins/.get
    (expected .put ($to_str id) {^id ($to_str id) ^!disabled}))
  (for entry in (composition_entries workspace) (expected .put entry/id entry))
  (let active h/composition/.current_revisions)
  (var reason nil)
  (for [id entry] in expected
    (if (== entry/disabled true) (continue))
    (let live (active .get id))
    (if (|| (!= live/active true) (!= (status_of h ($to_str id)) "ready")
            (&& (! ($absent? entry/module_digest)) (!= entry/module_digest live/options/digest)))
      (set reason $"${id} is not active at its requested revision")))
  (if (&& ($absent? reason) (> ($size workspace/errors/.get) 0))
    (set reason "The desired composition contains quarantined entries"))
  (if_yes (&& ($absent? reason) (! ($absent? h/readiness)))
    (set reason (try (h/readiness) catch Any $err/message)))
  (let observation (data_copy result))
  (observation .put "readiness" (if ($absent? h/readiness) "unverified" (if ($absent? reason) "ready" "degraded")))
  (observation .put "readiness_reason" reason)
  (observation .put "host_build_id" workspace/history_build/.get)
  (observation .put "accepted_revision" workspace/active_revision/.get)
  (composition_history_result workspace observation))

(fn commit_composition [workspace : Workspace, entries, ^origin origin = nil]
  (require_open workspace)
  (if ($absent? workspace/history_build/.get)
    (fail (CompositionError ^message "attach the executing host identity before changing archived composition")))
  (if workspace/busy/.get
    (fail (CompositionError ^message "composition mutation is already active")))
  (var actual workspace/revision/.get)
  (var checked (validate_entries (data_copy entries)))
  (if (== checked workspace/entries/.get) (return actual))
  (var next (+ actual 1))
  # Older hosts must refuse this format instead of silently dropping history
  # when committing a revision with their pre-archive writer.
  (var manifest {^format 2 ^revision next ^entries checked})
  (workspace/busy .set true)
  (try
    (let history (archive_candidate workspace/store workspace/history_head/.get next checked
      workspace/history_build/.get workspace/history_profile/.get
      (?? origin {^kind "direct" ^operation "composition"})))
    (manifest .put "history_head" history)
    (try
      (workspace/store .Store:checkpoint next {^composition manifest})
    catch Any
      (let original $err)
      # A backend may report a maintenance/acknowledgment error after CURRENT
      # advanced. Resolve that outcome before treating an accepted plan as a
      # rejection. Unreadable authority is explicitly uncertain, never retried.
      (let recovered (try workspace/store/.Store:load_checkpoint
        catch Any (fail (CompositionCommitUncertain ^code "commit_uncertain"
          ^message "Composition commit outcome is unreadable. Restart and inspect the authoritative checkpoint before another change."))))
      (if (|| ($absent? recovered) (!= recovered/records/composition/history_head history))
        (fail original)))
    (workspace/revision .set next)
    (workspace/entries .set checked)
    (workspace/history_head .set history)
    next
  ensure
    (workspace/busy .set false)))

(fn safe_module_id? [id : Str] : Bool
  (var safe (&& (> (byte_size id) 0) (<= (byte_size id) 64)))
  (for forbidden in ["/" "\\" ".." ":" "\0"]
    (if (contains? id forbidden) (set safe false)))
  safe)

(fn digest_hex [digest : Str]
  (if ($absent? (#"^sha256:[0-9a-f]{64}$" .match digest))
    (fail (CompositionError ^message $"unsupported module digest ${digest}")))
  (slice_bytes digest 7 (- (byte_size digest) 7)))

(fn module_path [workspace : Workspace, digest : Str]
  $"${workspace/generated_dir}/${(digest_hex digest)}.gene")

(fn parse_plugin_source [source]
  (if_not (== ($head source) Str) (return source))
  (let forms [])
  (for form in ($parse/read_all source)
    (forms .push form))
  (if_not (== forms/.size 1)
    (fail (CompositionError ^message "plugin source must contain exactly one mod form")))
  forms/0)

(fn source_without_locations [form]
  (if (== ($head form) List) (return ($map form source_without_locations)))
  (if (== ($head form) Map) (return ($map form source_without_locations)))
  (match form
    (when (node : Node)
      (let meta ($meta form))
      (for key in ["source" "line" "col"] (meta .delete key))
      ($node/rebuild form
        ^head (source_without_locations ($head form))
        ^body ($map ($body form) source_without_locations)
        ^props ($map ($props form) source_without_locations)
        ^meta ($map meta source_without_locations)))
    (else form)))

(fn canonical_module_source
  [source, ^require_init require_init : Bool = true]
  (if_not (== ($head source) (quote mod))
    (fail (CompositionError
      ^message "module source must be a quoted mod node")))
  (if_yes (&& require_init (!= source/0 (quote plugin)))
    (fail (CompositionError
      ^message "register_plugin root source must name (mod plugin ...)")))
  # Module top level is structurally inert. The untrusted executable bodies
  # live inside functions and are bounded when called; allowing arbitrary
  # top-level expressions would let a loop hang before the limiter exists.
  (var allowed ["import" "import_impl" "fn" "type" "impl" "protocol"
                "alias" "enum"])
  (var saw_init false)
  (var i 1)
  (while (< i source/body/.size)
    (var form source/body/%i)
    (var kind ($to_str ($head form)))
    (if_not (allowed .contains? kind)
      (fail (CompositionError
        ^message $"generated module top level may not contain ${kind}; read (doc \"harness/plugins\") for inert declarations and imports")))
    (if_yes (&& (== kind "fn") (== ($to_str form/0) "init"))
      (set saw_init true))
    (set i (+ i 1)))
  (if_yes (&& require_init (! saw_init))
    (fail (CompositionError ^message "generated module must define init")))
  # Model response readers attach diagnostic locations to quoted nodes.
  # Those locations are not module content and must not change import hashes.
  # Keep other metadata, literal container immutability, and syntax intact.
  (var text ($to_str (source_without_locations source)))
  (if (> (byte_size text) 262144)
    (fail (CompositionError ^message "generated module exceeds 262144 bytes")))
  text)

(fn module_digest [source] : Str
  $"sha256:${(sha256 (canonical_module_source ^!require_init source))}")

(fn dependency_module_texts [source, dependencies]
  (let modules [source])
  (for dependency in dependencies (modules .push (parse_plugin_source dependency)))
  (let requested [])
  (for module in modules
    (for form in module/body
      (if (&& (["import" "import_impl"] .contains? ($to_str ($head form)))
              (== ($head form/from) Str))
        (requested .push form/from))))
  (let texts [])
  (for dependency in dependencies
    (let parsed (parse_plugin_source dependency))
    (let canonical (canonical_module_source ^!require_init parsed))
    (texts .push canonical)
    # Existing authors may hash the exact quoted node inside a model response,
    # including its reader locations. Keep such explicitly referenced spellings
    # valid while also accepting location-independent canonical imports.
    (let original ($to_str parsed))
    (if_yes (&& (!= original canonical)
                (requested .contains? $"./${(sha256 original)}.gene"))
      (if (> (byte_size original) 262144)
        (fail (CompositionError ^message "generated module exceeds 262144 bytes")))
      (texts .push original)))
  texts)

(fn relative_import_digest [path : Str]
  (if_yes (&& (starts_with? path "./") (ends_with? path ".gene"))
    (var hex (slice_bytes path 2 (- (byte_size path) 7)))
    (if_yes (== (byte_size hex) 64) $"sha256:${hex}")))

(fn validate_source_imports [source, closure]
  (var i 1)
  (while (< i source/body/.size)
    (var form source/body/%i)
    (var kind ($to_str ($head form)))
    (if_yes (["import" "import_impl"] .contains? kind)
      (var path form/from)
      (if_yes (== ($head path) Str)
        (if_not (public_import? path)
          (var digest (relative_import_digest path))
          (if (|| ($absent? digest) (! (closure .contains? digest)))
            (fail
              (CompositionError ^message $"generated import is outside its dependency closure: ${path}"))))))
    (set i (+ i 1)))
  source)

(fn materialize_module_blob [workspace : Workspace, digest : Str, source : Str]
  (var path (module_path workspace digest))
  (var present (exists? path))
  (if_yes present
    (if_not (== (read_text path) source)
      (fail (CompositionError ^message $"module blob collision for ${digest}"))))
  (if_not present (write_text_atomic path source))
  path)

(fn write_module_blob [workspace : Workspace, digest : Str, source : Str]
  (var path (materialize_module_blob workspace digest source))
  (var key $"blob/${digest}")
  (if_not (workspace/blob_store .Store:has? key) (workspace/blob_store .Store:put key source))
  path)

(fn ensure_module_blob [workspace : Workspace, digest : Str]
  (var path (module_path workspace digest))
  (var key $"blob/${digest}")
  (if_not (exists? path)
    (if_not (workspace/blob_store .Store:has? key)
      (fail (CompositionError ^message $"module blob is missing: ${digest}")))
    (var source (workspace/blob_store .Store:get key))
    (if_not (== $"sha256:${(sha256 source)}" digest)
      (fail (CompositionError ^message $"stored module blob digest mismatch: ${digest}")))
    (write_text_atomic path source))
  path)

(fn find_entry_index [entries, id : Str] : Int
  (var found -1)
  (var i 0)
  (for entry in entries
    (if (&& (== found -1) (== entry/id id)) (set found i))
    (set i (+ i 1)))
  found)

(fn previous_module_digest [entries, id : Str]
  (var index (find_entry_index entries id))
  (if_not (== index -1) entries/%index/module_digest))

(fn entries_with [entries, replacement, replace : Bool]
  (var out (fresh_list))
  (var found false)
  (for entry in entries
    (if (== entry/id replacement/id)
      (then
        (set found true)
        (if replace
          (out .push replacement)
          (fail (CompositionError ^message $"composition entry ${replacement/id} already exists"))))
      (else
        (out .push entry))))
  (if_not found (out .push replacement))
  out)

(fn load_entry_descriptor [workspace : Workspace, h : Harness, entry, ^events events : Bool = true]
  (let mismatch (interface_diagnostic entry/interfaces workspace/interfaces))
  (if (!= mismatch "") (fail (CompositionError ^message mismatch)))
  (if_not (entry/closure .contains? entry/module_digest)
    (fail (CompositionError ^message $"plugin ${entry/id} dependency closure omits its root")))
  (for digest in entry/closure
    (var path (ensure_module_blob workspace ($to_str digest)))
    (var actual $"sha256:${(sha256 (read_text path))}")
    (if_not (== actual digest)
      (fail (CompositionError ^message $"plugin ${entry/id} blob digest mismatch: ${digest}"))))
  (var root_file $"${(digest_hex entry/module_digest)}.gene")
  (var isolation_key
    ($to_str
      entry/id
      ":"
      (sha256 (write_data {^digest entry/module_digest ^limits (entry_limits entry)}))))
  (var loaded
    ($runtime/load_sandboxed
      workspace/generated_dir
      root_file
      ($runtime/sandbox_namespaces)
      workspace/shared
      isolation_key))
  (configure_plugin_module loaded (runtime_limits entry))
  (var descriptor
    (describe_plugin_module ^core_interface (entry_core_interface entry) ^limits (runtime_limits entry)
      h
      loaded
      ($to_str entry/id)))
  (let retired (retired_requirement descriptor))
  (if (!= retired "") (fail (CompositionError ^message retired)))
  (if events (validate_descriptor_events h descriptor))
  (if_not ($absent? workspace/history_build/.get)
    (try (remember_descriptor workspace/store workspace/history_build/.get entry/module_digest descriptor)
      catch Any (workspace/metadata_errors/.get .push {^id entry/id ^message $err/message})))
  descriptor)

(fn validate_descriptor_events [h : Harness, descriptor]
  (var seen (fresh_map))
  (for event in (if ($absent? descriptor/events) (fresh_list) descriptor/events)
    (if (|| (== event/name void) (== event/version void) (== event/ignorable void) (== event/schema void))
      (fail
        (CompositionError ^message $"plugin ${descriptor/id} event descriptor requires name version ignorable schema")))
    (if_not ($runtime/callable? event/schema)
      (fail (CompositionError ^message $"plugin ${descriptor/id} event schema must be callable")))
    (var name ($to_str event/name))
    (if_not (== (seen .get name) void)
      (fail (CompositionError ^message $"plugin ${descriptor/id} duplicates event type ${name}")))
    (seen .put name true)
    (var existing (row h "event_types" name))
    (if_yes (&& (!= existing void) (|| (!= existing/origin "plugin") (!= existing/owner descriptor/id)))
      (fail (CompositionError ^message $"event type ${name} is already owned by ${existing/owner}"))))
  descriptor)

(fn entry_limits [entry]
  (if (== entry/limits void)
    (default_limits_data)
    entry/limits))

(fn default_limits_data []
  (var limits (default_execution_limits))
  {^max_memory_mb limits/max_memory_mb ^timeout_ms limits/timeout_ms})

(fn runtime_limits [entry] : ExecutionLimits
  (var limits (entry_limits entry))
  (ExecutionLimits ^max_memory_mb limits/max_memory_mb ^timeout_ms limits/timeout_ms))

(fn descriptor_entry_options [workspace : Workspace, entry]
  {
    ^module $"${(digest_hex entry/module_digest)}.gene"
    ^digest entry/module_digest
    ^closure entry/closure
    ^init_limits (runtime_limits entry)
    ^core_interface (entry_core_interface entry)
    ^!host})

(fn activate_descriptor [workspace : Workspace, h : Harness, descriptor, entry]
  (put_cordis_plugin ^^replace h descriptor (descriptor_entry_options workspace entry)))

(fn update_active_revision [workspace : Workspace, h : Harness]
  (if_not (== workspace/errors/.get #{}) (return nil))
  (var snapshot h/composition/.inspect)
  (for desired in (composition_entries workspace)
    (if_yes (entry_enabled? desired)
      (var matched false)
      (for live in snapshot/entries
        (if_yes (&& (== live/id desired/id) (! ($absent? live/graph)) (["active" "pending"] .contains? live/state))
          (for node in live/graph/nodes
            (if (&& (== node/identity live/graph/root) (== node/source_digest desired/module_digest))
              (set matched true)))))
      (if_not matched (return nil))))
  # Desired state is committed before admission. Advance ACTIVE only after
  # reconciliation accepts the desired set, including valid pending entries.
  (let desired (composition_revision workspace))
  (if (!= workspace/active_revision/.get desired)
    (write_text_atomic (active_revision_path workspace) (write_data desired)))
  (workspace/active_revision .set desired)
  nil)

(fn workspace_status [workspace : Workspace]
  {
    ^desired_revision (composition_revision workspace)
    ^active_revision workspace/active_revision/.get
    ^errors (data_copy workspace/errors/.get)})

(fn change_origin [h : Harness, operation : Str, id : Str]
  (let context ($runtime/context))
  (let source (capture_source_origin context))
  {^kind source/kind
   ^operation operation ^plugin id ^session (?? context/session nil)
   ^turn (if (== source/kind "model") context/turn/turn nil)
   ^command (?? context/command nil)})

(fn source_entry_interfaces [workspace : Workspace, source]
  (let required (try (source_interfaces source)
    catch InterfacePolicyError (fail (CompositionError ^message $err/message))))
  (let diagnostic (interface_diagnostic required workspace/interfaces))
  (if (!= diagnostic "") (fail (CompositionError ^message diagnostic)))
  required)

(fn stage_plugin_entry [workspace : Workspace, id : Str, source, ^dependencies dependencies = []]
  (require_open workspace)
  (if_not (safe_module_id? id) (fail (CompositionError ^message "unsafe plugin id")))
  (if (!= ($head dependencies) List) (fail (CompositionError ^message "dependencies must be a list of modules")))
  (let parsed (parse_plugin_source source))
  (let required (source_entry_interfaces workspace parsed))
  (let text (canonical_module_source parsed))
  (let digest $"sha256:${(sha256 text)}")
  (let closure [digest])
  (let blobs [{^digest digest ^text text ^parsed parsed}])
  (for dependency in dependencies
    (let module (parse_plugin_source dependency))
    (let encoded (canonical_module_source ^!require_init module))
    (let hash $"sha256:${(sha256 encoded)}")
    (if_not (closure .contains? hash)
      (closure .push hash)
      (blobs .push {^digest hash ^text encoded ^parsed module})))
  (for blob in blobs (validate_source_imports blob/parsed closure))
  (for blob in blobs
    (write_module_blob workspace blob/digest blob/text)
    (materialize_module_blob workspace blob/digest blob/text))
  (let entry {^id id ^module_digest digest ^closure closure
    ^interfaces required ^limits (default_limits_data) ^!disabled})
  (if_not ($absent? (workspace/profile_plugins/.get .get id))
    (entry .put "replaces_builtin" true))
  entry)

(fn register_plugin
  [workspace : Workspace, h : Harness, id : Str, source,
   ^limits limits = nil,
   ^dependencies dependencies = nil,
   ^by by : Str = "",
   ^model model : Str = "",
   ^at at : Str = "",
   ^replace replace : Bool = false]
  (require_open workspace)
  (if_not (safe_module_id? id)
    (fail (CompositionError ^message $"unsafe module id ${id}")))
  # Refuse a claimed id before anything is written. `entries_with` below also
  # refuses, but only after every dependency blob and the module itself have
  # been materialized and the descriptor loaded — so a refused rebuild left an
  # unreferenced blob in the generated directory and in the loader cache, and
  # the caller had no way to tell it apart from a blob a live entry needs.
  # That check stays where it is: it is the invariant on the entry list, and
  # this one is the early answer to a question already decided.
  (if_not replace
    (if_not ($absent? (workspace/profile_plugins/.get .get id))
      (fail (CompositionError
        ^message $"profile plugin ${id} already exists; use ^^replace")))
    (var claimed (composition_entries workspace))
    (if_not (== (find_entry_index claimed id) -1)
      (fail (CompositionError
        ^message $"composition entry ${id} already exists"))))
  (set source (parse_plugin_source source))
  (let required (source_entry_interfaces workspace source))
  (var bounded
    (if ($absent? limits)
      (default_limits_data)
      (data_copy limits)))
  (var text (canonical_module_source source))
  (var digest $"sha256:${(sha256 text)}")
  (var closure [digest])
  (var dependency_blobs (fresh_list))
  (var dependency_sources
    (if ($absent? dependencies) (fresh_list) dependencies))
  (for dependency_text in (dependency_module_texts source dependency_sources)
    (var dependency_digest $"sha256:${(sha256 dependency_text)}")
    (if_yes (! (closure .contains? dependency_digest))
      (closure .push dependency_digest)
      (dependency_blobs .push
        {^digest dependency_digest ^source dependency_text})
      (materialize_module_blob workspace dependency_digest dependency_text)))
  (validate_source_imports source closure)
  (for dependency in dependency_sources
    (validate_source_imports (parse_plugin_source dependency) closure))
  (materialize_module_blob workspace digest text)
  (let caller ($runtime/context))
  (let source_origin (capture_source_origin caller))
  (var authenticated_turn (if (== source_origin/kind "model") source_origin/turn "direct"))
  (var entry
    {^id id ^module_digest digest ^closure closure
     ^interfaces required
     ^limits bounded ^!disabled
     ^by by ^model model ^at at
     ^session (?? caller/session nil) ^turn authenticated_turn
     ^source_origin source_origin})
  (entry .put "origin" (change_origin h (if replace "replace" "register") id))
  (if_not ($absent? (workspace/profile_plugins/.get .get id))
    (entry .put "replaces_builtin" true))

  # Descriptor-only preflight: load and run `init`, but do not install or
  # activate anything until the generation is authoritative.
  (var descriptor (load_entry_descriptor workspace h entry))
  (entry/origin .put "validation"
    {^kind "bounded_descriptor" ^status "passed" ^source_digest digest
     ^host_build_id workspace/history_build/.get})
  # Only a valid descriptor enters the durable blob store. Materializations
  # used by a failed preflight are unreferenced content-addressed cache files.
  (for dependency in dependency_blobs
    (write_module_blob workspace dependency/digest dependency/source))
  (write_module_blob workspace digest text)
  (let context ($runtime/context))
  (if_yes (&& (! ($absent? context)) (! ($absent? context/turn)))
    (queue_composition_change h/snapshots
      {^kind "registration" ^id id
       ^apply (fn [] (publish_registration workspace h descriptor entry replace authenticated_turn))})
    (return {^id id ^digest digest ^status "queued"}))
  (publish_registration workspace h descriptor entry replace authenticated_turn))

(fn publish_registration [workspace : Workspace, h : Harness, descriptor, entry, replace : Bool, authenticated_turn : Str]
  (run_composition_change
    h/snapshots
    (fn []
      (publish_registration_serial workspace h descriptor entry replace authenticated_turn))))

(fn publish_registration_serial [workspace : Workspace, h : Harness, descriptor, entry, replace : Bool, authenticated_turn : Str]
  (let id ($to_str entry/id))
  (let digest entry/module_digest)
  (var before (composition_entries workspace))
  (var previous_digest (previous_module_digest before id))
  (let previous_index (find_entry_index before id))
  (assign_creation workspace entry (if (== previous_index -1) nil before/%previous_index))
  (var next_entries (entries_with before entry replace))
  (var revision (commit_composition ^origin entry/origin workspace next_entries))
  (var status "error")
  (try
    (register_descriptor_events h descriptor)
    (set status (activate_descriptor workspace h descriptor entry))
    (if (== status "error")
      (record_quarantine workspace id (plugin_error h id))
      (workspace/errors
        .get
        ; .delete id))
  catch Any
    (record_quarantine workspace id ($to_str $err)))
  (if (== status "ready") (reset_participant_quarantine workspace id))
  (record_composition_change
    h
    id
    previous_digest
    digest
    revision
    authenticated_turn
    (if (== previous_digest nil)
      "registered"
      "replaced"))
  (flush_harness h)
  (update_active_revision workspace h)
  (record_application_result workspace h
    {^plugin id ^status status ^message (workspace/errors/.get .get id)})
  {^id id ^revision revision ^digest digest ^status status
   ^state (if (== status "ready") "active"
     (if (== status "error") "quarantined" status))
   ^message (if (== status "error") (workspace/errors/.get .get id) nil)
   ^entry entry})

(fn drain_workspace_changes [workspace : Workspace, h : Harness, ^origin origin = nil]
  (let results [])
  ($runtime/with_context
    nil
    (fn []
      (for change in (take_composition_changes ^origin origin h/snapshots)
        (try
          (results .push (change/apply))
        catch CompositionConflict
          (results .push {^status "stale" ^state "unchanged"
            ^id change/id ^message $err/message ^code $err/code})
        catch Any
          (record_quarantine workspace change/id ($to_str $err/message))
          (results .push {^status "error" ^state "quarantined"
            ^id change/id ^message $err/message})))))
  results)

(fn run_workspace_turn [workspace : Workspace, h : Harness, id : Str, program, ^limits limits = nil]
  (record_turn_start h id)
  (flush_harness h)
  (try
    (let result (scope (invoke_bounded program nil (?? limits (default_execution_limits)))))
    (drain_workspace_changes workspace h)
    (record_turn_end h id "committed")
    (flush_harness h)
    {^status "completed" ^result result ^revision (composition_revision workspace)}
  catch Any
    (record_turn_end h id "aborted")
    (flush_harness h)
    {^status "failed" ^error $err ^revision (composition_revision workspace)}))

(fn entry_enabled? [entry]
  (! (== entry/disabled true)))

(fn record_quarantine [workspace : Workspace, id : Str, message : Str]
  (var errors workspace/errors/.get)
  (errors .put id message)
  (workspace/errors .set errors)
  (if_not ($absent? workspace/history_build/.get)
    (try
      (remember_failure workspace/store workspace/history_build/.get
        (?? (previous_module_digest (composition_entries workspace) id) "builtin") id message)
    catch Any
      (workspace/metadata_errors/.get .push {^id id ^message $err/message}))))

(fn register_descriptor_events [h : Harness, descriptor]
  (var descriptor_owner $"descriptor:${descriptor/id}")
  (remove_owner h descriptor_owner)
  (for event in (if ($absent? descriptor/events) (fresh_list) descriptor/events)
    (if (|| (== event/name void) (== event/version void) (== event/ignorable void) (== event/schema void))
      (fail
        (CompositionError ^message $"plugin ${descriptor/id} event descriptor requires name version ignorable schema")))
    (var catalog_row (fresh_map))
    (for [name value] in event
      (catalog_row .put name value))
    (catalog_row .put "origin" "plugin")
    (catalog_row .put "owner" ($to_str descriptor/id))
    (contribute h descriptor_owner "event_types" catalog_row))
  nil)

(fn known_event_types [h : Harness]
  (var known (fresh_map))
  (for event in (rows h "event_types")
    (known .put event/name event))
  known)

(fn prepare_workspace
  [workspace : Workspace, h : Harness, ^session session : Str = "default", ^recover recover : Bool = true]
  (require_open workspace)
  (workspace/errors .set (fresh_map))
  (var entries (composition_entries workspace))
  (var descriptors (fresh_map))

  # Phase 1: bounded descriptor load only. This is what makes plugin event
  # schemas available before state reconstruction or activation.
  (for entry in entries
    (if (== entry/builtin true)
      (then
        (if ($absent? (workspace/profile_plugins/.get .get entry/id))
          (record_quarantine workspace ($to_str entry/id)
            $"built-in default ${entry/id} is missing from this profile")))
      (else
        (if (&& (! ($absent? (workspace/profile_plugins/.get .get entry/id)))
                (!= entry/replaces_builtin true))
          (then
            (record_quarantine workspace ($to_str entry/id)
              $"stored plugin ${entry/id} collides with a profile plugin; replace it explicitly"))
          (else
            (if_yes (entry_enabled? entry)
              (try
                (var descriptor (load_entry_descriptor workspace h entry))
                (descriptors .put entry/id descriptor)
                (register_descriptor_events h descriptor)
              catch Any
                (record_quarantine workspace ($to_str entry/id) ($to_str $err/message)))))))))

  # Phase 2: validate the already-decoded generic envelopes against the core +
  # descriptor catalog. Missing plugin vocabulary quarantines that projection;
  # an unknown required core event refuses reconstruction in state.gene.
  (if_not ($absent? h/event_store)
    (for plugin in (validate_event_catalog h/event_store (known_event_types h))
      (record_quarantine workspace ($to_str plugin)
        "required plugin event schema is unavailable"))
    # Repair is deliberately after catalog validation: recovery must never
    # modify a stream this build is about to refuse as unreadable.
    (if recover (repair_interrupted_turns h/event_store ^session h/event_stream))
    (hydrate_harness_log h))

  (WorkspaceRestorePlan ^workspace workspace ^entries entries
    ^descriptors descriptors ^session session))

(fn activate_workspace_plan [plan : WorkspaceRestorePlan, h : Harness, ^profile_admissions profile_admissions = []]
  (var workspace plan/workspace)
  (var ready (fresh_list))
  (var pending (fresh_list))
  # A stored replacement takes the profile default's id before admission.
  # A legacy stored entry with the same id but no replacement record is a
  # clash: keep the default and quarantine that entry without blocking peers.
  (var blocked_defaults (fresh_map))
  (for entry in plan/entries
    (if_yes (&& (! ($absent? (workspace/profile_plugins/.get .get entry/id)))
                (|| (== entry/replaces_builtin true) (== entry/builtin true)))
      (blocked_defaults .put entry/id true)))
  (var admissions (fresh_list))
  (for item in profile_admissions
    (if ($absent? (blocked_defaults .get item/plugin/id))
      (admissions .push item)))
  (for entry in plan/entries
    (if (== entry/builtin true)
      (then nil)
      (else
        (if (&& (! ($absent? (workspace/profile_plugins/.get .get entry/id)))
                (!= entry/replaces_builtin true))
          (then
            (record_quarantine workspace ($to_str entry/id)
              $"stored plugin ${entry/id} collides with a profile plugin; replace it explicitly"))
          (else
            (var descriptor (plan/descriptors .get entry/id))
            (if_yes (&& (!= descriptor void) (== (workspace/errors/.get .get entry/id) void))
              (try
                (admissions .push
                  {^plugin descriptor ^options (descriptor_entry_options workspace entry)})
              catch Any
                (record_quarantine workspace ($to_str entry/id) ($to_str $err/message)))))))))
  (if (> admissions/.size 0)
    (try
      (put_cordis_plugins h admissions)
    catch Any
      (for entry in plan/entries
        (if (== (workspace/errors/.get .get entry/id) void)
          (record_quarantine workspace ($to_str entry/id) ($to_str $err/message))))))
  (for item in admissions
    (var id ($to_str item/plugin/id))
    (var status (status_of h id))
    (if (== status "ready")
      (then (ready .push id))
      (elif (== status "error")
        (record_quarantine workspace id (plugin_error h id)))
      (else (pending .push id))))
  (update_active_revision workspace h)
  {^ready ready ^pending pending ^errors (data_copy workspace/errors/.get)
   ^session plan/session})

(fn doctor [workspace : Workspace]
  (var out (fresh_list))
  (var active workspace/active_revision/.get)
  (var desired (composition_revision workspace))
  (for entry in (composition_entries workspace)
    (if (== entry/builtin true)
      (out .push $"${entry/id}: built-in disabled")
      (out .push
        ($to_str entry/id ": stored "
          (if (entry_enabled? entry) "enabled" "disabled")
          (if (== entry/replaces_builtin true) " (replaces built-in)" "")))))
  (for [id message] in workspace/errors/.get
    (out .push
      (if ($absent? active)
        $"${id}: ${message}"
        $"${id}: ${message} (desired ${desired}, active ${active})")))
  (if (&& (== workspace/errors/.get #{}) ($absent? active) (> desired 0))
    (out .push $"composition desired ${desired}: no successful activation revision recorded"))
  (if (&& (== workspace/errors/.get #{}) (! ($absent? active)) (!= desired active))
    (out .push $"composition desired ${desired}, active ${active}: reconciliation pending"))
  out)

(fn set_entry_disabled [workspace : Workspace, id : Str, disabled : Bool, ^h h = nil, ^origin origin = nil]
  (var entries (composition_entries workspace))
  (var found false)
  (var next_entries (fresh_list))
  (for entry in entries
    (if (== entry/id id)
      (then
        (set found true)
        (if (== entry/builtin true)
          (then
            (if disabled (next_entries .push entry)))
          (else
            (let next_entry (data_copy entry))
            (if_not (== (entry_enabled? entry) (! disabled))
              (next_entry .put "disabled" disabled))
            (next_entries .push next_entry))))
      (else (next_entries .push entry))))
  (if_not found
    (if ($absent? (workspace/profile_plugins/.get .get id))
      (fail (CompositionError ^message $"composition entry ${id} does not exist"))
      (if disabled
        (next_entries .push {^id id ^^builtin ^^disabled})
        (do
          (reset_participant_quarantine workspace id)
          (return (composition_revision workspace))))))
  (if_not disabled (reset_participant_quarantine workspace id))
  (if (== next_entries entries) (return (composition_revision workspace)))
  (var revision (commit_composition ^origin (?? origin
    {^kind (if ($absent? h) "direct" "offline") ^operation (if disabled "disable" "enable") ^plugin id})
    workspace next_entries))
  (if_not ($absent? h)
    (var digest (previous_module_digest next_entries id))
    (record_composition_change
      h
      id
      digest
      digest
      revision
      "recovery"
      (if disabled
        "disabled"
        "enabled"))
    (flush_harness h)
    (composition_history_result workspace {^plugin id ^status "unverified" ^operation "offline_repair"}))
  revision)

(fn disable_entry [workspace : Workspace, id : Str, ^h h = nil]
  (set_entry_disabled ^h h workspace id true))

(fn restore_entry [workspace : Workspace, id : Str, ^h h = nil, ^origin origin = nil]
  (if ($absent? (workspace/profile_plugins/.get .get id))
    (fail (CompositionError ^message $"plugin ${id} has no profile default to restore")))
  (reset_participant_quarantine workspace id)
  (let entries (composition_entries workspace))
  (let kept (fresh_list))
  (var removed false)
  (for entry in entries
    (if (== entry/id id)
      (set removed true)
      (kept .push entry)))
  (if_not removed (return (composition_revision workspace)))
  (let revision (commit_composition ^origin (?? origin
    {^kind (if ($absent? h) "direct" "offline") ^operation "restore_default" ^plugin id}) workspace kept))
  (if_not ($absent? h)
    (record_composition_change h id (previous_module_digest entries id) nil
      revision "recovery" "restored")
    (flush_harness h)
    (composition_history_result workspace {^plugin id ^status "unverified" ^operation "offline_repair"}))
  revision)

(fn set_plugin_enabled [workspace, h, id : Str, enabled : Bool]
  (let context ($runtime/context))
  (let origin (change_origin h (if enabled "enable" "disable") id))
  (let apply (fn [] (run_composition_change h/snapshots (fn []
    (let revision (set_entry_disabled ^origin origin workspace id (! enabled)))
    (activate_desired_plugin workspace h id)
    (let digest (previous_module_digest (composition_entries workspace) id))
    (record_composition_change h id digest digest revision "runtime" (if enabled "enabled" "disabled"))
    (flush_harness h)
    (update_active_revision workspace h)
    (record_application_result workspace h {^plugin id ^status (if enabled (status_of h id) "disabled")})
    {^id id ^revision revision ^status (if enabled (status_of h id) "disabled")}))))
  (if (&& (! ($absent? context/turn)) (== context/turn/state/.get "open"))
    (then (queue_composition_change h/snapshots {^id id ^kind "enabled" ^apply apply}) "queued")
    (else (apply))))

(fn activate_desired_plugin [workspace : Workspace, h : Harness, id : Str]
  (let entries (composition_entries workspace))
  (let index (find_entry_index entries id))
  (if (== index -1)
    (then
      (let default (workspace/profile_plugins/.get .get id))
      (if ($absent? default)
        (if_not ($absent? (h/plugins/.get .get id)) (uninstall h id))
        (put_cordis_plugin ^^replace h default/plugin default/options)))
    (else
      (let entry entries/%index)
      (if (entry_enabled? entry)
        (then
          (let descriptor (load_entry_descriptor workspace h entry))
          (register_descriptor_events h descriptor)
          (activate_descriptor workspace h descriptor entry))
        (else
          (if_not ($absent? (h/plugins/.get .get id)) (uninstall h id)))))))

(fn restore_plugin [workspace : Workspace, h : Harness, id : Str]
  (let context ($runtime/context))
  (let origin (change_origin h "restore_default" id))
  (let apply (fn [] (run_composition_change h/snapshots (fn []
    (let revision (restore_entry ^origin origin workspace id))
    (activate_desired_plugin workspace h id)
    (record_composition_change h id nil nil revision "runtime" "restored")
    (flush_harness h)
    (update_active_revision workspace h)
    (record_application_result workspace h {^plugin id ^status (status_of h id)})
    {^id id ^revision revision ^status (status_of h id)}))))
  (if (&& (! ($absent? context/turn)) (== context/turn/state/.get "open"))
    (then (queue_composition_change h/snapshots {^id id ^kind "restored" ^apply apply}) "queued")
    (else (apply))))

(fn enable_entry [workspace : Workspace, id : Str, ^h h = nil]
  (set_entry_disabled ^h h workspace id false))

(fn plugin_history [workspace : Workspace, id : Str = "", ^limit limit : Int = 50, ^before before = nil]
  (let records (composition_history ^limit limit ^before before workspace))
  (for record in records
    (record .put "outcomes" (history_results workspace/store record/id))
    (record .put "attempts" (history_results ^kind "attempt" workspace/store record/id))
    (if_not ($absent? record/origin/plan)
      (let key $"plugin_plan/${record/origin/plan}")
      (if_yes (workspace/store .Store:has? key)
        (let plan (workspace/store .Store:get key))
        (if (!= ($pkg/canonical_digest plan) record/origin/plan)
          (fail (CompositionError ^message "archived validation plan digest mismatch")))
        (record .put "validation" {^plan record/origin/plan ^warnings plan/warnings ^errors plan/errors}))))
  (if (== id "") (return records))
  (let selected [])
  (for record in records
    (for item in record/entries
      (if_yes (== item/id id)
        (let row (data_copy record))
        (row .put "entry" item)
        (row .delete "entries")
        (selected .push row)
        (break))))
  selected)

(fn plugin_history_page [workspace : Workspace, id : Str = "", ^limit limit : Int = 50, ^before before = nil]
  (let records (composition_history ^limit limit ^before before workspace))
  (let history (plugin_history ^limit limit ^before before workspace id))
  (var next nil)
  (if_yes (&& (== records/.size limit) (> records/.size 0))
    (let index (- records/.size 1))
    (let last records/%index)
    (if (> last/revision 0) (set next last/revision)))
  {^revision (composition_revision workspace) ^history history ^next_before next})

(fn verify_stored_entry [workspace : Workspace, saved]
  (require_open workspace)
  (validate_entry saved (fresh_map))
  (if (|| (== saved/builtin true) ($absent? saved/module_digest))
    (fail (CompositionError ^message "revert requires a stored plugin version; use restore for a built-in default")))
  (let mismatch (interface_diagnostic saved/interfaces workspace/interfaces))
  (if (!= mismatch "") (fail (CompositionError ^message mismatch)))
  # Verify inert source bytes without loading or invoking the historical code.
  (for digest in saved/closure
    (digest_hex digest)
    (let key $"blob/${digest}")
    (if_not (workspace/blob_store .Store:has? key)
      (fail (CompositionError ^message $"historical plugin blob is missing: ${digest}")))
    (let source (workspace/blob_store .Store:get key))
    (if (|| (!= ($head source) Str) (!= $"sha256:${(sha256 source)}" digest))
      (fail (CompositionError ^message $"historical plugin blob digest mismatch: ${digest}")))
    (let path (ensure_module_blob workspace digest))
    (if (!= $"sha256:${(sha256 (read_text path))}" digest)
      (fail (CompositionError ^message $"historical plugin blob digest mismatch: ${digest}"))))
  saved)

(fn prepare_reversion [workspace : Workspace, id : Str, revision : Int]
  (let saved (history_entry workspace/store workspace/history_head/.get id revision))
  (verify_stored_entry workspace saved)
  (let current (composition_entries workspace))
  (let index (find_entry_index current id))
  (preserve_creation_on_revert workspace saved (if (== index -1) nil current/%index))
  (saved .put "disabled" (if (== index -1) false (== current/%index/disabled true)))
  (if_not ($absent? (workspace/profile_plugins/.get .get id))
    (saved .put "replaces_builtin" true))
  saved)

(fn check_reversion_base [workspace : Workspace, expected : Int]
  (let actual (composition_revision workspace))
  (if (!= expected actual)
    (fail (CompositionConflict ^code "stale_composition" ^expected expected ^actual actual
      ^message $"composition changed: expected revision ${expected}, current ${actual}; inspect history again"))))

(fn revert_entry [workspace : Workspace, id : Str, revision : Int, ^expected expected = nil]
  (let base (?? expected (composition_revision workspace)))
  (check_reversion_base workspace base)
  (let saved (prepare_reversion workspace id revision))
  (check_reversion_base workspace base)
  (let origin {^kind "offline" ^operation "revert" ^plugin id ^source_revision revision})
  (saved .put "origin" origin)
  (let next (entries_with (composition_entries workspace) saved true))
  (let committed (commit_composition ^origin origin workspace next))
  (reset_participant_quarantine workspace id)
  (composition_history_result workspace {^plugin id ^status "unverified" ^operation "revert"})
  {^id id ^revision committed ^source_revision revision ^status "unverified"})

(fn revert_plugin [workspace : Workspace, h : Harness, id : Str, revision : Int, ^expected expected = nil]
  (let context ($runtime/context))
  (let base (?? expected (composition_revision workspace)))
  (check_reversion_base workspace base)
  (let saved (prepare_reversion workspace id revision))
  (let origin (change_origin h "revert" id))
  (origin .put "source_revision" revision)
  (saved .put "origin" origin)
  (let descriptor (if (entry_enabled? saved) (load_entry_descriptor workspace h saved) nil))
  (let apply (fn []
    (run_composition_change h/snapshots (fn []
      (check_reversion_base workspace base)
      (let previous (previous_module_digest (composition_entries workspace) id))
      (let committed (commit_composition ^origin origin workspace
        (entries_with (composition_entries workspace) saved true)))
      (var status "disabled")
      (try
        (if (entry_enabled? saved)
          (do
            (register_descriptor_events h descriptor)
            (set status (activate_descriptor workspace h descriptor saved))
            (if (== status "error")
              (record_quarantine workspace id (plugin_error h id))
              (workspace/errors/.get .delete id)))
          (do
            (if_not ($absent? (h/plugins/.get .get id)) (uninstall h id))
            (workspace/errors/.get .delete id)))
      catch Any
        (set status "error")
        (record_quarantine workspace id $err/message))
      (if (== status "ready") (reset_participant_quarantine workspace id))
      (record_composition_change h id previous saved/module_digest committed
        (if ($absent? origin/turn) "direct" ($to_str origin/turn)) "reverted")
      (flush_harness h)
      (update_active_revision workspace h)
      (record_application_result workspace h
        {^plugin id ^status status ^message (?? (workspace/errors/.get .get id) nil)})
      {^id id ^revision committed ^source_revision revision ^digest saved/module_digest ^status status}))))
  (if (&& (! ($absent? context/turn)) (== context/turn/state/.get "open"))
    (do
      (queue_composition_change h/snapshots {^id id ^kind "revert" ^apply apply})
      {^id id ^source_revision revision ^status "queued"})
    (apply)))

(fn close_workspace [workspace : Workspace]
  (if workspace/closed/.get (return))
  workspace/store/.Store:close
  workspace/blob_store/.Store:close
  (workspace/closed .set true)
  nil)
