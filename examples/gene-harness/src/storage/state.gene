# Durable event streams, owned by the workspace process and loaded on demand.

(mod state)

(import $store/fs [open : store_open Store StoreError])
(import $serde [write_data])
(import $crypto [sha256])
(import $str [byte_size starts_with? slice_bytes])
(import $fs [real_path])

(type HarnessStateError ^props {^message Str} ^impl [Error])
(impl Error for HarnessStateError)

(type EventStore
  ^props {^root Str ^backend Any ^streams Any ^next_sequences Any ^projections Any
          ^core_projections Any
          ^generation Any ^last_manifest Any ^dirty Any
          ^dirty_streams Any ^closed Any ^catalog Any ^quarantined Any ^writing Any
          ^formats_validated Any
          ^segment_events Int ^retained_segments Int
          ^max_event_bytes Int ^max_state_bytes Int
          ^gc_interval Int ^gc_countdown Any})

(fn fresh_list [] ($thaw #[]))
(fn fresh_map [] ($thaw #{}))

(fn stream_key [scope : Str, stream : Str] : Str
  $"${scope}:${stream}")

(fn require_open [events : EventStore]
  (if (events/closed .get)
    (fail (HarnessStateError ^message "event store is closed")))
  events)

(fn validate_scope [scope : Str]
  (if_not (["workspace" "session"] .contains? scope)
    (fail (HarnessStateError
      ^message $"event scope must be workspace or session, got ${scope}")))
  scope)

(fn event_version [event]
  (if (== event/version void) 1 event/version))

(fn event_ignorable [event]
  (if (== event/ignorable void) false event/ignorable))

(fn mark_stream_dirty [events : EventStore, key : Str]
  (ensure_projections_loaded events key)
  ((events/dirty_streams .get) .put key true)
  (events/dirty .set true))

(fn current_events [events : EventStore, key : Str]
  (require_open events)
  (var streams (events/streams .get))
  (var found (streams .get key))
  (if_not (== found void) (return found))
  (var values (fresh_list))
  (var manifest (events/last_manifest .get))
  (if_not ($absent? manifest)
    (var descriptor (manifest/streams .get key))
    (if_not (== descriptor void)
      (for digest in descriptor/segments
        (var segment (events/backend .Store:get $"segment/${digest}"))
        (if ($absent? segment)
          (fail (HarnessStateError ^message $"missing event segment ${digest} for ${key}")))
        (for envelope in segment
          (validate_loaded_envelope events envelope)
          (values .push envelope)))))
  (streams .put key values)
  values)

(fn ensure_projections_loaded [events : EventStore, key : Str]
  (var projections (events/projections .get))
  (if_not (== (projections .get key) void) (return nil))
  (var plugin (fresh_map))
  (var core (fresh_map))
  (var manifest (events/last_manifest .get))
  (if_not ($absent? manifest)
    (var descriptor (manifest/streams .get key))
    (if_not ($absent? descriptor)
      (var saved (events/backend .Store:get $"projection/${descriptor/projection}"))
      (if ($absent? saved)
        (fail (HarnessStateError ^message $"missing stream projection for ${key}")))
      (set plugin (copy_data saved/plugin))
      (set core (copy_data saved/core))))
  (projections .put key plugin)
  ((events/core_projections .get) .put key core)
  nil)

(fn validate_loaded_envelope [events : EventStore, envelope]
  (if_not (== envelope/format 2)
    (fail (HarnessStateError ^message "unsupported event envelope; start a fresh workspace")))
  (var catalog (events/catalog .get))
  (if_not ($absent? catalog)
    (var known (catalog .get envelope/type))
    (var quarantined (events/quarantined .get))
    (var seen (fresh_map))
    (for owner in quarantined (seen .put owner true))
    (if (== known void)
      (validate_unknown_event quarantined seen envelope)
      (validate_known_event quarantined seen envelope known)))
  nil)

(fn unload_event_stream [events : EventStore, scope : Str, stream : Str]
  (var key (stream_key scope stream))
  (if_not (== ((events/dirty_streams .get) .get key) void)
    (flush_event_store events))
  ((events/streams .get) .delete key)
  ((events/projections .get) .delete key)
  ((events/core_projections .get) .delete key)
  nil)

(fn set_current_events [events : EventStore, key : Str, values]
  (var streams (events/streams .get))
  (streams .put key values)
  (events/streams .set streams))

(fn next_sequence [events : EventStore, key : Str] : Int
  (var sequences (events/next_sequences .get))
  (var found (sequences .get key))
  (if (== found void) 1 found))

(fn set_next_sequence [events : EventStore, key : Str, value : Int]
  (var sequences (events/next_sequences .get))
  (sequences .put key value)
  (events/next_sequences .set sequences))

(fn update_projection [events : EventStore, key : Str, plugin : Str, state]
  (var all (events/projections .get))
  (var stream_states (all .get key))
  (if (== stream_states void) (set stream_states (fresh_map)))
  (stream_states .put plugin state)
  (all .put key stream_states)
  (events/projections .set all))

(fn copy_data [value] ($thaw ($freeze value)))

(fn update_core_projection [events : EventStore, key : Str, name : Str, state]
  (var all (events/core_projections .get))
  (var states (all .get key))
  (if (== states void) (set states (fresh_map)))
  (states .put name (copy_data state))
  (all .put key states)
  (events/core_projections .set all))

(fn stamped_envelope [scope : Str, stream : Str, event,
                      origin : Str, owner : Str, projection : Str, seq : Int]
  ($freeze
    {^format 2 ^origin origin ^owner owner ^projection projection
     ^scope scope ^stream stream ^seq seq
     ^type event/type ^version (event_version event)
     ^ignorable (event_ignorable event) ^payload event}))

# Reserve the widest sequence number when preparing data before commit. A
# queued event must still fit after other records advance the stream.
(fn core_event_size [scope : Str, stream : Str, event,
                     ^projection projection : Str = ""] : Int
  (byte_size (write_data
    (stamped_envelope scope stream event "core" "core" projection 9223372036854775807))))

(fn acquire_event_writer [events : EventStore]
  (while (events/writing .swap true) ($sleep 1))
  nil)

(fn append_stamped_event
  [events : EventStore, scope : Str, stream : Str, event,
   origin : Str, owner : Str, projection : Str]
  (require_open events)
  (acquire_event_writer events)
  (try
    (append_stamped_event_unlocked events scope stream event origin owner projection)
    ensure (events/writing .set false)))

(fn append_stamped_event_unlocked
  [events : EventStore, scope : Str, stream : Str, event,
   origin : Str, owner : Str, projection : Str]
  (require_open events)
  (validate_scope scope)
  (if (== event/type void)
    (fail (HarnessStateError ^message "event requires ^type")))
  (if_not (["core" "plugin"] .contains? origin)
    (fail (HarnessStateError ^message $"invalid event origin ${origin}")))
  (if (== owner "")
    (fail (HarnessStateError ^message "event owner is empty")))
  (var key (stream_key scope stream))
  (var seq (next_sequence events key))
  # A frozen deep copy: the caller keeps no reference into history or into a
  # projection, and an envelope handed back to a plugin cannot rewrite either.
  (var envelope (stamped_envelope scope stream event origin owner projection seq))
  (var encoded (write_data envelope))
  (if (> (byte_size encoded) events/max_event_bytes)
    (fail (HarnessStateError
      ^message $"event exceeds ${events/max_event_bytes} bytes")))
  (mark_stream_dirty events key)
  (var values (current_events events key))
  (values .push envelope)
  (set_current_events events key values)
  (set_next_sequence events key (+ seq 1))
  (if_yes (== ($to_str event/type) "plugin/state")
    (update_projection events key ($to_str event/plugin) envelope/payload/state))
  (if_yes (&& (== origin "core")
              (["session/state" "round/state" "question/asked" "question/answered"
                "run/state" "input/request" "input/reply"] .contains? event/type))
    (update_core_projection events key event/key event/state))
  envelope)

(fn append_core_event
  [events : EventStore, scope : Str, stream : Str, event,
   ^projection projection : Str = ""]
  (append_stamped_event events scope stream event "core" "core" projection))

(fn append_plugin_event
  [events : EventStore, scope : Str, stream : Str, plugin : Str, event]
  (if (== plugin "")
    (fail (HarnessStateError ^message "plugin event owner is empty")))
  (append_stamped_event events scope stream event "plugin" plugin plugin))

# Compatibility surface for core/tests. An explicit plugin projection selects
# plugin origin; core code uses append_core_event so plugin/state remains a
# core-defined record routed to a plugin projection.
(fn append_event [events : EventStore, scope : Str, stream : Str, event]
  (if (== event/plugin void)
    (append_core_event events scope stream event)
    (append_plugin_event events scope stream ($to_str event/plugin) event)))

(fn prepare_plugin_state
  [events : EventStore, scope : Str, stream : Str, plugin : Str, state,
   ^version version : Int = 1]
  (require_open events)
  (validate_scope scope)
  (var event ($freeze
    {^type "plugin/state" ^plugin plugin ^state_version version ^state state}))
  (var encoded (write_data event/state))
  (if (> (byte_size encoded) events/max_state_bytes)
    (fail (HarnessStateError
      ^message $"plugin state exceeds ${events/max_state_bytes} bytes")))
  (if (> (core_event_size scope stream event ^projection plugin) events/max_event_bytes)
    (fail (HarnessStateError
      ^message $"event exceeds ${events/max_event_bytes} bytes")))
  event)

(fn record_plugin_state
  [events : EventStore, scope : Str, stream : Str, plugin : Str, state,
   ^version version : Int = 1]
  (var event (prepare_plugin_state events scope stream plugin state ^version version))
  (append_core_event events scope stream
    event ^projection plugin))

# Core projections are deliberately separate from plugin state. Checkpoints
# retain them even when the event that established them leaves the log window.
(fn record_core_state
  [events : EventStore, scope : Str, stream : Str, kind : Str, key : Str, state]
  (if_not (["session/state" "round/state" "question/asked" "question/answered"
            "run/state" "input/request" "input/reply"] .contains? kind)
    (fail (HarnessStateError ^message "unknown core state kind")))
  (append_core_event events scope stream
    {^type kind ^key key ^state (copy_data state)}))

(fn core_state [events : EventStore, scope : Str, stream : Str, key : Str]
  (require_open events)
  (ensure_projections_loaded events (stream_key scope stream))
  (var states ((events/core_projections .get) .get (stream_key scope stream)))
  (if (== states void) (return nil))
  (var state (states .get key))
  (if ($absent? state) nil (copy_data state)))

(fn core_states [events : EventStore, scope : Str, stream : Str]
  (require_open events)
  (ensure_projections_loaded events (stream_key scope stream))
  (var states ((events/core_projections .get) .get (stream_key scope stream)))
  (if (== states void) (fresh_map) (copy_data states)))

(fn events_for [events : EventStore, scope : Str, stream : Str]
  (require_open events)
  (copy_events (current_events events (stream_key scope stream))))

(fn copy_events [source]
  (var out (fresh_list))
  (for event in source (out .push event))
  out)

(fn plugin_state
  [events : EventStore, scope : Str, stream : Str, plugin : Str]
  (require_open events)
  (ensure_projections_loaded events (stream_key scope stream))
  (var all (events/projections .get))
  (var stream_states (all .get (stream_key scope stream)))
  (if_not (== stream_states void)
    (var found (stream_states .get plugin))
    # A detached copy, as `core_state` returns: changing it stores nothing.
    (if_not (== found void) (copy_data found))))

(fn quarantine_projection [quarantined, seen, envelope]
  (var plugin ($to_str envelope/projection))
  (if (== plugin "")
    (fail (HarnessStateError
      ^message $"plugin event ${envelope/type} has no projection owner")))
  (if_yes (== (seen .get plugin) void)
    (seen .put plugin true)
    (quarantined .push plugin)))

(fn validate_unknown_event [quarantined, seen, envelope]
  (if_yes (== envelope/ignorable true) (return))
  (if (== envelope/origin "core")
    (then
      (fail (HarnessStateError
        ^message $"unknown required core event type ${envelope/type}")))
    (elif (== envelope/origin "plugin")
      (quarantine_projection quarantined seen envelope))
    (else
      (fail (HarnessStateError
        ^message $"event ${envelope/type} has invalid origin")))))

(fn validate_known_event [quarantined, seen, envelope, known]
  (if (|| (!= envelope/origin known/origin)
          (!= envelope/owner known/owner))
    (fail (HarnessStateError
      ^message $"event ${envelope/type} origin does not match its catalog row")))
  (var accepted_version (== envelope/version known/version))
  (if_yes (&& (! accepted_version) (!= known/versions void))
    (set accepted_version (!= (known/versions .get $"v${envelope/version}") void)))
  (if_yes (! accepted_version)
    (if_yes (== envelope/ignorable true) (return))
    (if (== envelope/origin "core")
      (fail (HarnessStateError
        ^message $"unsupported core event version ${envelope/type}/${envelope/version}"))
      (then
        (quarantine_projection quarantined seen envelope)
        (return))))
  (var schema_error nil)
  (if ($absent? known/schema)
    (set schema_error "catalog row has no payload schema")
    (try
      (var schema_payload
        (if (== known/origin "plugin")
          envelope/payload/data envelope/payload))
      (var schema known/schema)
      (if_yes (!= known/versions void)
        (var version_schema (known/versions .get $"v${envelope/version}"))
        (if_not (== version_schema void) (set schema version_schema)))
      (var guarded ($runtime/guard_call schema schema_payload))
      (if_not guarded/ok (set schema_error guarded/message))
    catch Any
      (set schema_error ($to_str $err/message))))
  (if_not (== schema_error nil)
    (if (== envelope/origin "core")
      (fail (HarnessStateError
        ^message $"invalid core event ${envelope/type}: ${schema_error}"))
      (quarantine_projection quarantined seen envelope))))

(fn validate_event_catalog [events : EventStore, known_types]
  (require_open events)
  (events/catalog .set known_types)
  (events/quarantined .set (fresh_list))
  (for [stream values] in (events/streams .get)
    (for envelope in values (validate_loaded_envelope events envelope)))
  (copy_data (events/quarantined .get)))

(fn validate_envelope_formats [events : EventStore]
  (for [stream values] in (events/streams .get)
    (for envelope in values (validate_loaded_envelope events envelope)))
  (events/formats_validated .set true)
  events)

(fn slice_events [source, start : Int, finish : Int]
  (var out (fresh_list))
  (var i start)
  (while (&& (< i finish) (< i source/.size))
    (out .push source/%i)
    (set i (+ i 1)))
  out)

(fn tail_items [source, count : Int]
  (var start (- source/.size count))
  (if (< start 0) (set start 0))
  (slice_events source start source/.size))

(fn unique_strings [values]
  (var seen (fresh_map))
  (var out (fresh_list))
  (for value in values
    (if_yes (== (seen .get value) void)
      (seen .put value true)
      (out .push value)))
  out)

(fn segment_stream [events : EventStore, values]
  (var backend events/backend)
  (var all_digests (fresh_list))
  (var segments (fresh_list))
  (var start 0)
  (while (< start values/.size)
    (var segment
      (slice_events values start (+ start events/segment_events)))
    (var digest (sha256 (write_data segment)))
    (if_not ($absent? backend)
      (var key $"segment/${digest}")
      (if_not (backend .Store:has? key)
        (backend .Store:put key segment)))
    (all_digests .push digest)
    (segments .push segment)
    (set start (+ start events/segment_events)))
  (var kept_digests all_digests)
  (var kept_segments segments)
  (var retained (fresh_list))
  (for segment in kept_segments
    (for event in segment (retained .push event)))
  {^digests kept_digests ^events retained})

(fn all_manifest_digests [manifest]
  (var out (fresh_list))
  (for generation_digests in manifest/history
    (for digest in generation_digests (out .push digest)))
  (unique_strings out))

(fn garbage_collect_segments [events : EventStore, manifest]
  # The workspace lock gives this process sole publication ownership.
  (var backend events/backend)
  (if ($absent? backend) (return))
  (var retained (fresh_map))
  (for digest in (all_manifest_digests manifest)
    (retained .put digest true))
  (for key in (backend .Store:keys)
    (if_yes (|| (starts_with? key "segment/") (starts_with? key "projection/"))
      (var prefix (if (starts_with? key "segment/") 8 11))
      (var digest (slice_bytes key prefix (- (byte_size key) prefix)))
      (if (== (retained .get digest) void)
        (backend .Store:delete key)))))

(fn build_event_manifest [events : EventStore, generation : Int]
  (var descriptors (fresh_map))
  (var previous (events/last_manifest .get))
  (if_not ($absent? previous)
    (for [key descriptor] in previous/streams
      (descriptors .put key descriptor)))
  (var streams (events/streams .get))
  (for [key ignored] in (events/dirty_streams .get)
    (var values (streams .get key))
    (var segmented (segment_stream events values))

    (var projection
      {^plugin ((events/projections .get) .get key)
       ^core ((events/core_projections .get) .get key)})
    (var projection_digest (sha256 (write_data projection)))
    (if_not (events/backend .Store:has? $"projection/${projection_digest}")
      (events/backend .Store:put $"projection/${projection_digest}" projection))
    (descriptors .put key
      {^segments segmented/digests ^projection projection_digest
       ^next_seq (next_sequence events ($to_str key))})
    (streams .put key segmented/events))
  (events/streams .set streams)

  (var current_digests (fresh_list))
  (for [key descriptor] in descriptors
    (for digest in descriptor/segments (current_digests .push digest))
    (current_digests .push descriptor/projection))

  (var history (fresh_list))
  (history .push (unique_strings current_digests))
  (if_not ($absent? previous)
    (var i 0)
    (while (&& (< i previous/history/.size) (< history/.size 3))
      (history .push previous/history/%i)
      (set i (+ i 1))))
  (var manifest
    {^format 3 ^generation generation ^streams descriptors ^history history})
  manifest)

(fn manifest_data [events : EventStore, manifest]
  (if_not (== manifest/format 3)
    (fail (HarnessStateError ^message "event store predates this Harness; start a fresh workspace")))
  (var sequences (fresh_map))
  (for [key descriptor] in manifest/streams
    (sequences .put key descriptor/next_seq))
  {^streams (fresh_map) ^sequences sequences ^projections (fresh_map)
   ^core_projections (fresh_map)})

(fn install_manifest_data [events : EventStore, manifest, data]
  (events/streams .set data/streams)
  (events/next_sequences .set data/sequences)
  (events/projections .set data/projections)
  (events/core_projections .set data/core_projections)
  (events/generation .set manifest/generation)
  (events/last_manifest .set manifest)
  (events/formats_validated .set false))

(fn clear_dirty [events : EventStore]
  (events/dirty .set false)
  (events/dirty_streams .set (fresh_map)))

(fn publish_event_generation [events : EventStore]
  (var generation (+ (events/generation .get) 1))
  (var manifest (build_event_manifest events generation))
  (events/backend .Store:checkpoint generation {^event_manifest manifest})
  (events/generation .set generation)
  (events/last_manifest .set manifest)
  (clear_dirty events)
  {^generation generation ^manifest manifest})

(fn flush_event_store [events : EventStore]
  (require_open events)
  (acquire_event_writer events)
  (try
    (if_not (events/dirty .get)
      (return {^generation (events/generation .get) ^manifest (events/last_manifest .get)}))
    (var published (publish_event_generation events))
    (var countdown (- (events/gc_countdown .get) 1))
    (if (<= countdown 0)
      (then
        (garbage_collect_segments events published/manifest)
        (events/gc_countdown .set events/gc_interval))
      (else (events/gc_countdown .set countdown)))
    published
    ensure (events/writing .set false)))

(fn restore_manifest [events : EventStore, manifest]
  (install_manifest_data events manifest (manifest_data events manifest)))

(fn repair_interrupted_turns [events : EventStore, ^session session = nil] : Int
  (if_not ($absent? session)
    (current_events events (stream_key "session" session)))
  (var repairs (fresh_list))
  (for [key values] in (events/streams .get)
    (if_yes (&& (! ($absent? session)) (!= ($to_str key) (stream_key "session" session)))
      (continue))
    (var open_turns (fresh_map))
    (for envelope in values
      (if (== envelope/type "turn/start")
        (then
          (open_turns .put ($to_str envelope/payload/turn) envelope))
        (elif (== envelope/type "turn/end")
          (open_turns .delete ($to_str envelope/payload/turn)))))
    (for [turn envelope] in open_turns
      (repairs .push envelope)))
  (for started in repairs
    (append_core_event events ($to_str started/scope) ($to_str started/stream)
      {^type "turn/end" ^turn started/payload/turn
       ^reason "interrupted" ^synthetic true}))
  (if (> repairs/.size 0) (flush_event_store events))
  repairs/.size)

(fn open_event_store
  [root : Str,
   ^segment_events segment_events : Int = 64,
   ^retained_segments retained_segments : Int = 64,
   ^max_event_bytes max_event_bytes : Int = 262144,
   ^max_state_bytes max_state_bytes : Int = 1048576,
   ^gc_interval gc_interval : Int = 16] : EventStore
  (if (|| (<= segment_events 0) (<= retained_segments 0))
    (fail (HarnessStateError
      ^message "segment and retention counts must be positive")))
  (if (<= gc_interval 0)
    (fail (HarnessStateError ^message "event GC interval must be positive")))
  # Keep the retained root and every later Store path in the same
  # canonical vocabulary. Passing a relative root to Store/open and then
  # joining it again would resolve the root beneath itself.
  (var canonical_root (real_path root))
  (var backend (store_open ^root canonical_root))
  (var events
    (EventStore ^root canonical_root ^backend backend ^streams ($cell (fresh_map))
                ^next_sequences ($cell (fresh_map))
                ^projections ($cell (fresh_map)) ^generation ($cell 0)
                ^core_projections ($cell (fresh_map))
                ^last_manifest ($cell nil) ^dirty ($cell false)
                ^dirty_streams ($cell (fresh_map))
                ^catalog ($cell nil) ^quarantined ($cell (fresh_list))
                ^writing ($cell false)
                ^formats_validated ($cell false)
                ^closed ($cell false) ^segment_events segment_events
                ^retained_segments retained_segments
                ^max_event_bytes max_event_bytes
                ^max_state_bytes max_state_bytes
                ^gc_interval gc_interval ^gc_countdown ($cell 1)))
  (var loaded (backend .Store:load_checkpoint))
  (if_yes (! ($absent? loaded))
    (var manifest (loaded/records .get "event_manifest"))
    (restore_manifest events manifest))
  (validate_envelope_formats events)
  events)

(fn close_event_store [events : EventStore]
  (if (events/closed .get) (return))
  (if (events/dirty .get) (flush_event_store events))
  (events/backend .Store:close)
  (events/closed .set true)
  nil)
