(mod host_log)
(import ^from "../public/text" byte_prefix)
(let IoResource $io/IoResource)
(type HostLog ^props {^path Str ^limit Int ^size Int ^writer Any})

(fn open_host_log [root : Str, ^limit limit : Int = 1048576]
  (let path $"${root}/.gene-harness/host.log")
  (HostLog ^path path ^limit limit ^size (if ($fs/exists? path) ((Path "size") ($fs/info path)) else 0) ^writer nil))

(fn close_host_log [log]
  (if_not ($absent? log/writer)
    log/writer/.IoResource:close
    (await log/writer/.IoResource:wait_closed)
    (set log/writer nil)))

(fn write_host_log [log, text : Str]
  # One record per line, rotated before the line that would cross the bound.
  # A single bounded record is far smaller than the segment, so it is never
  # split across segments.
  (if (> (+ log/size ($str/byte_size text)) log/limit)
    (close_host_log log)
    ($fs/rename log/path $"${log/path}.1")
    (set log/size 0))
  (if (>= log/size log/limit)
    (close_host_log log)
    ($fs/rename log/path $"${log/path}.1")
    (set log/size 0))
  (if ($absent? log/writer)
    (set log/writer (await ($io/open_write ^mode "append" log/path))))
  (await ($io/write_all log/writer ($binary/from_str text)))
  (set log/size (+ log/size ($str/byte_size text)))
  nil)
