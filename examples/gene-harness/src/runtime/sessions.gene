(mod sessions)

(import ^from "../storage/state"
  [
    core_states
    core_state
    record_core_state
    append_core_event
    events_for
    flush_event_store
    unload_event_stream
    delete_event_stream
    repair_interrupted_turns
    copy_data])
(import ^from "../agents/history" [history_state read_body write_body])
(import ^from "./patch" [recover_patch_temporaries])
(import ^from "../kernel" [SessionChanged publish])

(type SessionError ^props {^code Str ^message Str} ^impl [Error])
(impl Error for SessionError)

(type SessionState ^props {^id Str ^runtime Any ^history Any ^round Any ^outputs Any ^console Any ^last_access Any ^viewers Any})

(type SessionManager ^props {^runtime Any ^events Any ^state_root Str ^index Any ^loaded Any ^idle_timeout_ms Int ^closed Any ^mutating Any ^index_writing Any ^gates Any ^gate_mutex Any ^before_remove Any? ^resumes Any? ^metadata_revision Int?})

(fn with_session_gate [manager, key : Str, thunk]
  (let gate (manager/gate_mutex (fn []
    (let previous (manager/gates/.get .get key))
    (if ($absent? previous)
      (then
        (let created ($sync/gate))
        (manager/gates/.get .put key created)
        created)
      (else previous)))))
  (gate thunk))

(fn notify_session [manager, record]
  (set manager/metadata_revision (+ (?? manager/metadata_revision 0) 1))
  (if_not ($absent? manager/runtime/h)
    (publish manager/runtime/h (SessionChanged ^record record)))
  nil)

(fn require_open [manager : SessionManager]
  (if manager/closed/.get
    (fail (SessionError ^code "closed" ^message "the session manager is closed")))
  manager)

(fn safe_id? [id : Str]
  (if (|| (== id "") (> ($str/byte_size id) 128)) (return false))
  (for forbidden in ["/" "\\" ".." ":" "\0"]
    (if ($str/contains? id forbidden) (return false)))
  true)

(fn require_record [manager : SessionManager, id : Str]
  (require_open manager)
  (let record (manager/index .get; .get id))
  (if ($absent? record)
    (fail (SessionError ^code "not_found" ^message $"session ${id} does not exist")))
  record)

(fn restore_round [manager : SessionManager, id : Str]
  (let saved (core_state manager/events "session" id "round"))
  (if ($absent? saved) (return nil))
  (if ($absent? saved/digest) (return saved))
  (let round ($serde/read_data (read_body manager/runtime saved/digest)))
  (round .put "state" saved/state)
  round)

(fn write_index [manager : SessionManager]
  (manager/index_writing (fn []
    ($fs/write_text_atomic
      $"${manager/state_root}/sessions/index"
      ($serde/write_data {^format 1 ^sessions manager/index/.get})))))

(fn open_session_manager [runtime, events, state_root : Str,
                          ^idle_timeout_ms idle_timeout_ms : Int = 600000] : SessionManager
  (if (< idle_timeout_ms 0)
    (fail (SessionError ^code "invalid_request" ^message "idle timeout must be non-negative")))
  ($fs/make_dir $"${state_root}/sessions")
  (for [key intent] in (core_states events "workspace" "workspace")
    (if (&& ($str/starts_with? ($to_str key) "session_delete/") (!= intent/done true))
      (finish_session_deletion events ($to_str key) intent)))
  (let index {})
  # Workspace projections are authoritative if a crash preceded index publication.
  # This reads projection metadata, never session event segments or plugins.
  (for [key record] in (core_states events "workspace" "workspace")
    (if (&& ($str/starts_with? ($to_str key) "session/") (!= record/deleted true)) (index .put record/id record)))
  (let manager (SessionManager ^runtime runtime ^events events ^state_root state_root
    ^index ($cell index) ^loaded ($cell {}) ^idle_timeout_ms idle_timeout_ms ^closed ($cell false)
    ^mutating ($sync/gate) ^index_writing ($sync/gate)
    ^gates ($cell {}) ^gate_mutex ($sync/gate) ^resumes ($cell [])))
  (write_index manager)
  (recover_sessions manager)
  manager)

# A crash between finalizing a question batch and updating its round leaves
# an answered batch on a waiting round. The batch records the intended action.
(fn answered_waiting_batch [manager : SessionManager, id : Str]
  (let round (restore_round manager id))
  (if (|| ($absent? round) (!= round/state "waiting") ($absent? round/questions)) (return nil))
  (let batch (core_state manager/events "session" id $"questions/${round/questions/id}"))
  (if (|| ($absent? batch) (!= batch/status "answered")) nil batch))

(fn recover_sessions [manager : SessionManager]
  (let marker $"${manager/state_root}/shutdown.gene")
  (let cancelled (if ($fs/exists? marker) ($serde/read_data ($fs/read_text marker)) {}))
  (let interrupted [])
  (let reasons {})
  (for [id record] in manager/index/.get
    (if (["running" "cancelled"] .contains? record/status) (interrupted .push ($to_str id)))
    (if_yes (== record/status "waiting")
      (let batch (answered_waiting_batch manager ($to_str id)))
      (if_not ($absent? batch)
        # Only a recorded continuation resumes, once rounds can run again. A
        # recorded cancellation cancels; an older record without an intended
        # action is interrupted, never resumed.
        (if (== batch/intent "continue")
          (then (manager/resumes/.get .push ($to_str id)))
          (else
            (interrupted .push ($to_str id))
            (reasons .put ($to_str id) (if (== batch/intent "cancel") "cancelled" "interrupted")))))))
  (for id in interrupted
    (let previous (require_record manager id))
    (let round (restore_round manager id))
    (let reason (?? (reasons .get id) (if (|| (== previous/status "cancelled")
      (&& (! ($absent? round)) (== (cancelled .get round/id) true))) "cancelled" "interrupted")))
    (let warnings [])
    (for [key patch] in (core_states manager/events "session" id)
      (if_yes (&& ($str/starts_with? ($to_str key) "patch/") (== patch/state "started"))
        (let warning (recover_patch_temporaries manager/runtime/root patch/files))
        (warnings .push warning)
        (record_core_state
          manager/events
          "session"
          id
          "session/state"
          ($to_str key)
          {^state "recovered" ^files patch/files ^warning warning ^turn patch/turn})
        (record_core_state
          manager/events
          "session"
          id
          "session/state"
          "recovery"
          {^warnings warnings})
        (append_core_event manager/events "session" id {^type "trace" ^text warning ^^ignorable})))
    (repair_interrupted_turns ^session id ^reason reason manager/events)
    (if_not ($absent? round)
      (round .put "state" reason)
      (record_core_state
        manager/events
        "session"
        id
        "round/state"
        "round"
        {
          ^id round/id
          ^state reason
          ^digest (write_body manager/runtime ($serde/write_data round))})
      (let receipts_ref (core_state manager/events "session" id "rounds"))
      (if_not ($absent? receipts_ref)
        (let receipts
          (if ($absent? receipts_ref/digest)
            receipts_ref
            ($serde/read_data (read_body manager/runtime receipts_ref/digest))))
        (for old in receipts/receipts
          (if (== old/id round/id) (old .put "state" reason)))
        (record_core_state
          manager/events
          "session"
          id
          "round/state"
          "rounds"
          {
            ^next_seq receipts/next_seq
            ^digest (write_body manager/runtime ($serde/write_data receipts))})))
    (let record (require_record manager id))
    (update_session
      manager
      id
      {
        ^status reason
        ^attention (|| record/attention (&& (== reason "interrupted") (!= record/kind "interactive")) (! warnings/.empty?))})
    (unload_event_stream manager/events "session" id))
  (if ($fs/exists? marker) ($fs/remove marker))
  interrupted/.size)

(fn update_session [manager : SessionManager, id : Str, changes]
  (require_open manager)
  (manager/mutating (fn [] (update_session_unlocked manager id changes))))

(fn update_session_unlocked [manager : SessionManager, id : Str, changes]
  (let previous (require_record manager id))
  (let record (copy_data (require_record manager id)))
  (for [key value] in changes
    (if (== key "id")
      (fail (SessionError ^code "invalid_request" ^message "session identity cannot change")))
    (record .put key value))
  (if_yes (== record/kind "child")
    (let owner (require_record manager record/parent/session))
    (record .put "pinned" owner/pinned))
  (record_core_state manager/events "workspace" "workspace" "session/state" $"session/${id}" record)
  (flush_event_store manager/events)
  (manager/index
    .get
    ; .put id record)
  (write_index manager)
  (notify_session manager record)
  (if_yes (&& (== record/kind "child") record/attention
              (|| (! previous/attention)
                  (&& (!= previous/status record/status)
                      (["waiting" "failed" "interrupted"] .contains? record/status))))
    (let parent (manager/index/.get .get record/parent/session))
    (if (&& (! ($absent? parent)) (! parent/attention))
      (update_session_unlocked manager parent/id {^^attention})))
  (if_yes (&& (!= record/kind "child") (! ($absent? changes/pinned)))
    (let children [])
    (for [child_id child] in manager/index/.get
      (if (== child/parent/session id) (children .push ($to_str child_id))))
    (for child in children (update_session_unlocked manager child {^pinned record/pinned})))
  (copy_data record))

(fn create_session [manager : SessionManager, ^id id : Str = "", ^kind kind : Str = "interactive", ^title title : Str = "New conversation", ^trigger trigger = nil, ^occurrence occurrence = nil, ^first_request first_request : Str = "", ^pinned pinned : Bool = false, ^parent parent = nil, ^model_settings model_settings = nil]
  (require_open manager)
  (manager/mutating (fn []
    (create_session_unlocked ^id id ^kind kind ^title title ^trigger trigger ^occurrence occurrence ^first_request first_request ^pinned pinned ^parent parent ^model_settings model_settings
      manager))))

(fn create_session_unlocked [manager : SessionManager, ^id id : Str = "", ^kind kind : Str = "interactive", ^title title : Str = "New conversation", ^trigger trigger = nil, ^occurrence occurrence = nil, ^first_request first_request : Str = "", ^pinned pinned : Bool = false, ^parent parent = nil, ^model_settings model_settings = nil]
  (require_open manager)
  (let chosen (if (== id "") $"s-${($crypto/random_hex 12)}" id))
  (if_not (safe_id? chosen)
    (fail (SessionError ^code "invalid_request" ^message "invalid session id")))
  (let previous (manager/index .get; .get chosen))
  (if_not ($absent? previous)
    (if (&& (== previous/kind kind) (== previous/trigger trigger) (== previous/occurrence occurrence)
            (|| (!= kind "child")
                (&& (== previous/parent/session parent/session) (== previous/parent/delegation parent/delegation))))
      (return (copy_data previous)))
    (fail (SessionError ^code "conflict" ^message $"session ${chosen} already exists")))
  (if_not (["interactive" "heartbeat" "scheduled" "cron" "child"] .contains? kind)
    (fail (SessionError ^code "invalid_request" ^message "invalid session kind")))
  (if_yes (== kind "child")
    (if (|| (!= ($head parent) Map) (!= ($head parent/session) Str)
            (!= ($head parent/round) Str) (!= ($head parent/delegation) Str))
      (fail (SessionError ^code "invalid_request" ^message "A child session requires its parent session, round and delegation.")))
    (let owner (require_record manager parent/session))
    (if (== owner/kind "child")
      (fail (SessionError ^code "depth_limit" ^message "Nested child sessions are not supported."))))
  (let name ($str/trim title))
  (if (|| (== name "") (> ($str/byte_size name) 256))
    (fail (SessionError ^code "invalid_request" ^message "session title must have 1–256 bytes")))
  (let now ($to_str ($now)))
  (let record
    {
      ^id chosen
      ^kind kind
      ^title name
      ^status "done"
      ^created now
      ^last_active now
      ^last_active_ms ($os/wall_ms)
      ^!attention
      ^pinned pinned
      ^trigger trigger
      ^occurrence occurrence
      ^turns 0
      ^first_request first_request
      ^first_request_media []})
  (if_not ($absent? parent) (record .put "parent" (copy_data parent)))
  (if_yes (== kind "child")
    (let parent_record (require_record manager parent/session))
    (record .put "pinned" parent_record/pinned))
  (if_not ($absent? model_settings) (record .put "model_settings" (copy_data model_settings)))
  (record_core_state
    manager/events
    "workspace"
    "workspace"
    "session/state"
    $"session/${chosen}"
    record)
  (flush_event_store manager/events)
  (manager/index
    .get
    ; .put chosen record)
  (write_index manager)
  (notify_session manager record)
  (copy_data record))

(fn list_sessions [manager : SessionManager, ^kind kind = nil, ^status status = nil, ^attention attention = nil, ^trigger trigger = nil, ^q q : Str = "", ^since since : Str = "", ^until until : Str = "", ^all all : Bool = false]
  (require_open manager)
  (let filtered
    (||
      all
      (! ($absent? kind))
      (! ($absent? status))
      (! ($absent? attention))
      (! ($absent? trigger))
      (!= q "")
      (!= since "")
      (!= until "")))
  (let query ($str/lower q))
  (let results [])
  (for [id record] in manager/index/.get
    (if (&& (! filtered) (== record/kind "child")) (continue))
    (if (&& (! filtered) (!= record/kind "interactive") (! record/pinned)) (continue))
    (if (&& (! ($absent? kind)) (!= record/kind kind)) (continue))
    (if (&& (! ($absent? status)) (!= record/status status)) (continue))
    (if (&& (! ($absent? attention)) (!= record/attention attention)) (continue))
    (if (&& (! ($absent? trigger)) (!= record/trigger trigger)) (continue))
    (if (&& (!= since "") (< ($order/compare record/last_active since) 0)) (continue))
    (if (&& (!= until "") (> ($order/compare record/last_active until) 0)) (continue))
    (if (&& (!= query "") (! ($str/contains? ($str/lower record/title) query)) (! ($str/contains? ($str/lower record/first_request) query)))
      (continue))
    (results .push (copy_data record)))
  ($order/sort_by ^compare (fn [a b] ($order/compare b a)) results (fn [record] record/last_active)))

(fn session_busy? [state : SessionState] : Bool
  (let round state/round/.get)
  (&& (! ($absent? round)) (["running" "waiting"] .contains? round/state)))

(fn session_running? [state : SessionState] : Bool
  (let round state/round/.get)
  (&& (! ($absent? round)) (== round/state "running")))

(fn load_session [manager : SessionManager, id : Str] : SessionState
  (with_session_gate manager $"load/${id}" (fn [] (load_session_unlocked manager id))))

(fn load_session_unlocked [manager : SessionManager, id : Str] : SessionState
  (require_record manager id)
  (let loaded manager/loaded/.get)
  (let previous (loaded .get id))
  (if_not ($absent? previous)
    (previous/last_access .set ($os/monotonic_ms))
    (return previous))
  (let history (history_state manager/runtime id))
  (let state
    (SessionState ^id id ^runtime manager/runtime ^history ($cell history/messages) ^round ($cell (restore_round manager id)) ^outputs ($cell history/outputs) ^console ($cell []) ^last_access ($cell ($os/monotonic_ms)) ^viewers ($cell 0)))
  (loaded .put id state)
  state)

(fn view_session [manager : SessionManager, id : Str] : SessionState
  (let state (with_session_gate manager $"load/${id}" (fn []
    (let loaded (load_session_unlocked manager id))
    (loaded/viewers .set (+ loaded/viewers/.get 1))
    loaded)))
  (let record (require_record manager id))
  (if record/attention (update_session manager id {^!attention}))
  state)

(fn leave_session [manager : SessionManager, id : Str]
  (let state (manager/loaded .get; .get id))
  (if_not ($absent? state)
    (state/viewers .set ($math/max 0 (- state/viewers/.get 1)))
    (state/last_access .set ($os/monotonic_ms)))
  nil)

(fn unload_session [manager : SessionManager, id : Str] : Bool
  (with_session_gate manager $"round/${id}" (fn []
    (with_session_gate manager $"load/${id}" (fn [] (unload_session_unlocked manager id))))))

(fn unload_session_unlocked [manager : SessionManager, id : Str] : Bool
  (require_open manager)
  (let state (manager/loaded .get; .get id))
  (if ($absent? state) (return false))
  (if (|| (session_running? state) (> state/viewers/.get 0)) (return false))
  # Client departure and idle collection must not cancel admitted commands.
  (if_not ($absent? manager/runtime/commands)
    (for [key task] in manager/runtime/commands/active/.get
      (if ($str/starts_with? ($to_str key) $"${id}:") (return false))))
  (if_not ($absent? manager/runtime/modes)
    (let mode (manager/runtime/modes/states/.get .get id))
    (if_not ($absent? mode/running) (return false)))
  (if_not ($absent? manager/before_remove) (manager/before_remove id "unloaded"))
  (flush_event_store manager/events)
  (unload_event_stream manager/events "session" id)
  (manager/loaded
    .get
    ; .delete id)
  true)

(fn unload_idle_sessions [manager : SessionManager] : Int
  (require_open manager)
  (let due [])
  (let now ($os/monotonic_ms))
  (for [id state] in manager/loaded/.get
    (if (>= (- now state/last_access/.get) manager/idle_timeout_ms) (due .push ($to_str id))))
  (var count 0)
  (for id in due
    (if (unload_session manager id) (set count (+ count 1))))
  count)

(fn delete_session [manager : SessionManager, id : Str, ^explicit explicit : Bool = false, ^revision revision = nil] : Bool
  (let record (require_record manager id))
  (let root (if (== record/kind "child") record/parent/session id))
  (with_session_gate manager $"round/${root}" (fn []
    (let ids [id])
    (if_yes (== root id)
      (for [child_id child] in manager/index/.get
        (if (== child/parent/session id) (ids .push ($to_str child_id)))))
    (with_delete_gates manager ids 0 root (fn []
      (let remove (fn []
        (if (&& (! ($absent? revision)) (!= revision (?? (/revision (require_record manager id)) 0)))
          (fail (SessionError ^code "revision_conflict" ^message "Conversation changed; refresh before deleting it.")))
        (delete_session_locked ^explicit explicit manager id ids)))
      (if ($absent? manager/runtime/commands) (remove) (manager/runtime/commands/gate remove)))))))

(fn with_delete_gates [manager, ids, offset : Int, root : Str, body]
  (if (>= offset ids/.size) (return (body)))
  (let id ids/%offset)
  (let next (fn []
    (with_session_gate manager $"load/${id}" (fn []
      (with_delete_gates manager ids (+ offset 1) root body)))))
  (if (== id root) (next) (with_session_gate manager $"round/${id}" next)))

(fn finish_session_deletion [events, key : Str, intent]
  (for record in intent/records
    (let tombstone (copy_data record))
    (tombstone .put "deleted" true)
    (record_core_state events "workspace" "workspace" "session/state" $"session/${record/id}" tombstone)
    (delete_event_stream events "session" record/id))
  (record_core_state events "workspace" "workspace" "session/state" key {^^done})
  (flush_event_store events))

(fn delete_session_locked [manager : SessionManager, id : Str, ids, ^explicit explicit : Bool = false] : Bool
  (require_open manager)
  (manager/mutating (fn []
    (let records [])
    (for candidate in ids
      (let record (require_record manager candidate))
      (let loaded (manager/loaded/.get .get candidate))
      (if (|| (["running" "waiting"] .contains? record/status)
              (&& (! explicit) (|| record/pinned record/attention
                (&& (! ($absent? loaded)) (> loaded/viewers/.get 0)))))
        (return false))
      (if_not ($absent? manager/runtime/commands)
        (for [key task] in manager/runtime/commands/active/.get
          (if ($str/starts_with? ($to_str key) $"${candidate}:") (return false)))
        # Admission persists a running receipt before its task is installed.
        (let commands (core_state manager/events "session" candidate "commands"))
        (if_not ($absent? commands/digest)
          (for command in (/records ($serde/read_data (read_body manager/runtime commands/digest)))
            (if (&& (== command/status "running") (== command/runtime_epoch manager/runtime/epoch))
              (return false)))))
      (records .push record))
    (for candidate in ids
      (if_not ($absent? manager/before_remove) (manager/before_remove candidate "deleted")))
    (let key $"session_delete/${id}")
    (let intent {^records records ^done false})
    (record_core_state manager/events "workspace" "workspace" "session/state" key intent)
    (flush_event_store manager/events)
    (finish_session_deletion manager/events key intent)
    (for candidate in ids
      (manager/index/.get .delete candidate)
      (manager/loaded/.get .delete candidate))
    (write_index manager)
    (manager/runtime/body_gc_pending .set true)
    (for record in records
      (let tombstone (copy_data record))
      (tombstone .put "deleted" true)
      (notify_session manager tombstone))
    true)))

(fn close_session_manager [manager : SessionManager]
  (if manager/closed/.get (return nil))
  (for [id state] in manager/loaded/.get
    (if (session_running? state)
      (fail (SessionError ^code "busy" ^message $"session ${id} still has a round"))))
  (flush_event_store manager/events)
  (let ids [])
  (for [id state] in manager/loaded/.get
    (ids .push ($to_str id)))
  (for id in ids
    (unload_event_stream manager/events "session" id))
  (manager/loaded .set {})
  (set manager/runtime nil)
  (manager/closed .set true)
  nil)
