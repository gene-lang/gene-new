(mod round_controller)
(import [operator_round?] ^from "./round_policy")
(import [normalize_message] ^from "../channels/model")
(import [resolve_initiator make_initiator] ^from "./initiators")
(import [RoundError] ^from "./round_errors" ^^export)
(import [observe_round : observe_channel_round
         observe_rounds : observe_channel_rounds snapshot : channel_queue_snapshot
         queue_status : channel_queue_status pending_parts : channel_pending_parts
         claim_batch : claim_channel_batch finish_admission : finish_channel_admission
         release_batch : release_channel_batch hold_queue : hold_channel_queue]
  ^from "../channels/queue")
(import [open_media_store validate_media_refs] ^from "../storage/media")
(import [prompt_limit] ^from "../web/contract")
(import ^from "../agents/turn_loop" [run_round transcript finish_turn])
(import ^from "../agents/provider_selection" [readiness_report session_settings])
(import ^from "../agents/harness_turn" [answer_validators])
(import ^from "./composition" [acquire_snapshot release_snapshot])
(import ^from "./input_modes" [require_chat])
(import ^from "../agents/history"
  [
    append_message
    bounded_request
    pending_request
    write_body
    read_body
    acquire_body_use
    release_body_use
    with_body_use])
(import ^from "../storage/state"
  [core_state record_core_state flush_event_store copy_data append_core_event])
(import ^from "./sessions"
  [load_session require_record update_session session_busy? with_session_gate])
(import ^from "./questions" [answer_questions submitted_digest QuestionError])
(import ^from "./cards" [wait_for_card_actions card_send_item])
(import ^from "./commands" [take_command_attachments])
(import ^from "./workspace_lock" [close_workspace_lock])
(import ^from "../kernel" [RoundChanged publish])
(import [connect_delegation_host note_delegation_round queue_delegation_answer
  close_delegation_owner prepare_delegations_stop] ^from "./delegations")

(type RoundController ^props {^runtime Any ^active Any ^watchers Any ^completions Any})

(fn new_round_controller [runtime]
  (let controller
    (RoundController ^runtime runtime ^active ($cell {}) ^watchers ($cell {}) ^completions ($cell {})))
  (if_not ($absent? runtime/commands)
    (set runtime/commands/cancel
      (fn [session]
        (let loaded (load_session runtime/sessions session))
        (let receipt loaded/round/.get)
        (if (|| ($absent? receipt) (! (["running" "waiting" "paused"] .contains? receipt/state)))
          (return false))
        (cancel_round controller session receipt/id)
        true)))
  (if_not ($absent? runtime/commands)
    (set runtime/commands/stop
      (fn [session code confirmed]
        (request_stop controller session code confirmed))))
  # Session recovery can change receipts before channel stores are opened.
  # Reconcile ended task blockers before any transport or delegation resumes.
  (if_not ($absent? runtime/channel_queues)
    (let queues (/queues (channel_queue_snapshot runtime/channel_queues)))
    (for [id queue] in queues
      (let session ($to_str id))
      (if_not ($absent? (runtime/sessions/index/.get .get session))
        (observe_channel_rounds runtime/channel_queues session (/receipts (round_state controller session))))))
  (if_not ($absent? runtime/delegations)
    (connect_delegation_host runtime/delegations (delegation_callbacks controller)))
  controller)

(fn delegation_callbacks [controller]
  {^owner (fn [session round] (round_receipt controller session round))
   ^active (fn [session request_id]
     (let task (controller/active/.get .get session))
     (let loaded (controller/runtime/sessions/loaded/.get .get session))
     (&& (! ($absent? task)) (! ($absent? loaded))
       (== loaded/round/.get/request_id request_id)))
   ^find (fn [session request_id]
     (if ($absent? (controller/runtime/sessions/index/.get .get session)) (return nil))
     (let state (round_state controller session))
     (for receipt in state/receipts
       (if (== receipt/request_id request_id) (return receipt)))
     nil)
   ^admit (fn [parent admission] (admit_child_round controller parent admission))
   ^cancel (fn [session round] (cancel_round controller session round ^^from_delegation))
   ^resume (fn [session receipt batch]
     (with_session_gate controller/runtime/sessions $"round/${session}"
       (fn [] (continue_answered_round controller session receipt batch ^^dispatched))))
   ^resume_parent (fn [session round wait items collection]
     (resume_delegation_parent controller session round wait items collection))
   ^answer (fn [session batch values] (answer_round controller session batch values))})

(fn admit_child_round [controller, parent, admission]
  (with_body_use controller/runtime (fn []
    (with_session_gate controller/runtime/sessions $"round/${admission/session}" (fn []
      (let state (round_state controller admission/session))
      (for old in state/receipts
        (if (== old/request_id admission/request_id) (return old)))
      (let metadata (require_record controller/runtime/sessions admission/session))
      (let link {^session parent/session ^round admission/owner_round
        ^delegation admission/id ^admission admission/number ^turn admission/starting_turn})
      (update_session controller/runtime/sessions admission/session
        {^parent link ^model_settings admission/provider_settings})
      (let brief (read_body controller/runtime admission/brief_ref))
      (let text ($to_str "[delegated by " parent/session " round " admission/owner_round
        " turn " admission/starting_turn " · " admission/id "]\n"
        (?? admission/child_prompt "") "\n\n" brief))
      (submit_round_impl controller admission/session admission/request_id state/next_seq text
        ^initiator (make_initiator controller/runtime/h "parent" $"${parent/session}/${admission/id}")
        ^limits {^turn_limit admission/turn_limit ^timeout_ms admission/timeout_ms}
        ^delegation {^parent parent/session ^id admission/id ^admission admission/number
          ^source admission/source}))))))

(fn round_state [controller : RoundController, session : Str]
  (let saved (core_state controller/runtime/events "session" session "rounds"))
  (if ($absent? saved) (return {^next_seq 1 ^receipts []}))
  (if_not ($absent? saved/digest)
    (return ($serde/read_data (read_body controller/runtime saved/digest))))
  saved)

(fn round_receipt [controller : RoundController, session : Str, id : Str]
  (let state (round_state controller session))
  (for receipt in state/receipts
    (if (== receipt/id id) (return receipt)))
  nil)

(fn round_for_request [controller : RoundController, session : Str, request_id : Str]
  (for receipt in (/receipts (round_state controller session))
    (if (== receipt/request_id request_id) (return receipt)))
  nil)

(fn round_digest [text : Str, media, card_ref, checked_input]
  ($crypto/sha256 (if ($absent? checked_input)
    (if (&& media/.empty? ($absent? card_ref)) text
      ($serde/write_data {^text text ^media media ^card card_ref}))
    ($serde/write_data {^text text ^media media ^card card_ref ^input checked_input}))))

# Batch selection, authorization and engine admission share the browser's
# existing session gate. The callback queries the configured policy authority.
(fn admit_channel_queue [controller : RoundController, session : Str, authorize]
  (with_body_use controller/runtime (fn []
    (with_session_gate controller/runtime/sessions $"round/${session}" (fn []
      (let queues controller/runtime/channel_queues)
      (let loaded (load_session controller/runtime/sessions session))
      (let current loaded/round/.get)
      (if_not ($absent? current) (observe_channel_round queues session current))
      (let state (round_state controller session))
      (let status (channel_queue_status queues session))
      (if_yes (! ($absent? status/batch))
        (let stored (/batch (claim_channel_batch queues session {} state/next_seq)))
        (let found (round_for_request controller session stored/request_id))
        (if_yes (! ($absent? found))
          (if (!= found/digest (round_digest stored/text [] nil stored/input))
            (fail (RoundError ^code "submission_conflict" ^message "Stored channel batch differs from its round receipt.")))
          (finish_channel_admission queues stored/id found)
          (observe_channel_round queues session found)
          (return {^kind "admitted" ^batch stored/id ^receipt found ^^recovered}))
        (var covered (== stored/sequence state/next_seq))
        (for receipt in state/receipts
          (if (== receipt/submission_seq stored/sequence) (set covered true)))
        (if_not covered
          (hold_channel_queue queues session "uncertain_admission" stored/id)
          (return {^kind "uncertain" ^batch stored/id}))
        # A retained receipt or the unused next sequence covers the claim. A
        # different browser request may have used it while Slack was disabled;
        # absence of this request ID now proves no channel admission occurred.
        (release_channel_batch queues stored/id))
      (if (|| (session_busy? loaded) (! ($absent? (controller/active/.get .get session))))
        (return {^kind "busy"}))
      (if (&& (== current/state "paused") ($absent? current/continuation_stop))
        (return {^kind "held" ^reason "manual_pause"}))
      (let ready (channel_queue_status queues session))
      (if ready/held (return {^kind "held"}))
      (let parts (channel_pending_parts queues session))
      (if parts/.empty? (return {^kind "empty"}))
      (let decisions (authorize parts))
      (let prepared (claim_channel_batch queues session decisions state/next_seq
        ^members ($map parts (fn [part] part/id))))
      (if (!= prepared/kind "prepared") (return prepared))
      (let batch prepared/batch)
      (try
        (let admitted (submit_round_impl controller session batch/request_id batch/sequence batch/text
          ^initiator (make_initiator controller/runtime/h "channel" batch/input/account ^transport batch/input/transport)
          ^input batch/input
          ^on_admit (fn [receipt] (finish_channel_admission queues batch/id receipt))))
        {^kind "admitted" ^batch batch/id ^receipt admitted}
      catch Error
        (let failure $err)
        (let recorded (round_for_request controller session batch/request_id))
        (if_yes (! ($absent? recorded))
          (finish_channel_admission queues batch/id recorded)
          (if (&& (== recorded/state "running")
                  ($absent? (controller/active/.get .get session)))
            (do
              (recorded .put "state" "interrupted")
              (recorded .put "message" "Channel admission was recorded but execution did not start; it was not replayed.")
              (save_round controller session recorded)))
          (return {^kind "admitted" ^batch batch/id ^receipt recorded ^^recovered}))
        (release_channel_batch queues batch/id ^reason (if (== failure/code "busy") "busy" "admission_failed"))
        (fail failure)))))))

(fn changed [controller : RoundController, session : Str, receipt]
  (publish controller/runtime/h (RoundChanged ^session session ^receipt receipt))
  nil)

(fn save_round [controller : RoundController, session : Str, receipt, ^current current : Bool = true]
  (let events controller/runtime/events)
  (let state (round_state controller session))
  (let receipts [])
  (let superseded_receipts [])
  (var found false)
  (for old in state/receipts
    (if (== old/id receipt/id)
      (then
        (receipts .push (copy_data receipt))
        (set found true))
      (else
        (if (&& (== receipt/initiator "user") (> receipt/submission_seq old/submission_seq)
                (== old/state "paused")
                (|| ($absent? old/continued_by) (== old/continued_by receipt/id)))
          (do (let superseded (copy_data old))
            (superseded .put "continuation_stop" "superseded")
            (superseded .put "continuation_error" nil)
            (superseded .put "continued_by" nil)
            (if (!= old/continuation_stop "superseded") (superseded_receipts .push superseded))
            (receipts .push superseded))
          (receipts .push old)))))
  (if_not found (receipts .push (copy_data receipt)))
  (let retained (if (> receipts/.size 128)
    ($drop receipts (- receipts/.size 128)) receipts))
  (let all {^next_seq ($math/max state/next_seq (+ receipt/submission_seq 1)) ^receipts retained})
  (record_core_state
    events
    "session"
    session
    "round/state"
    "rounds"
    {^next_seq all/next_seq ^digest (write_body controller/runtime ($serde/write_data all))})
  (if_yes current
  (record_core_state
    events
    "session"
    session
    "round/state"
    "round"
    {
      ^id receipt/id
      ^state receipt/state
      ^digest (write_body controller/runtime ($serde/write_data receipt))})
  (let loaded (load_session controller/runtime/sessions session))
  (loaded/round .set (copy_data receipt))
  (update_session
    controller/runtime/sessions
    session
    {^status receipt/state ^last_active ($to_str ($now)) ^last_active_ms ($os/wall_ms)}))
  (flush_event_store events)
  (if_yes (&& (! ($absent? controller/runtime/channel_queues))
          (! ($absent? (/channel (controller/runtime/sessions/index/.get .get session)))))
    (for superseded in superseded_receipts
      (observe_channel_round controller/runtime/channel_queues session superseded))
    (observe_channel_round controller/runtime/channel_queues session receipt))
  (changed controller session receipt)
  receipt)

(fn finish_round [controller : RoundController, session : Str, receipt, outcome, ^completion completion = nil]
  (let claim (?? completion (controller/completions/.get .get session)))
  (if (&& (! ($absent? claim)) (claim .swap true)) (return nil))
  (let failure (match outcome
    (when (TaskOutcome/ok result) (["failed" "cancelled" "interrupted"] .contains? result/state))
    (else true)))
  (if (&& failure (! ($absent? controller/runtime/delegations)))
    (close_delegation_owner controller/runtime/delegations session receipt/id "The parent round failed or was cancelled."))
  (let saved (with_session_gate
    controller/runtime/sessions
    $"round/${session}"
    (fn []
      (finish_round_unlocked controller session receipt outcome))))
  (if_yes (&& (== saved/state "paused") (== saved/continuation_mode "automatic")
              (! controller/runtime/stopping/.get))
    (try (continue_round controller session saved/id "automatic")
      catch Any (stop_continuation controller session saved/id $err)))
  saved)

(fn finish_round_unlocked [controller : RoundController, session : Str, receipt, outcome]
  (let saved (copy_data receipt))
  (match outcome ^!exhaustive
    (when (TaskOutcome/ok result)
      (for [name value] in result
        (saved .put name value)))
    (when (TaskOutcome/error error)
      (saved .put "state" "failed")
      (saved .put "message" error/message))
    (when (TaskOutcome/panic message)
      (saved .put "state" "failed")
      (saved .put "message" message))
    (when TaskOutcome/cancelled
      (saved .put "state" "cancelled")))
  (if_yes controller/runtime/stopping/.get
    (saved .put "state" "cancelled")
    (saved .put "message" "Workspace stopped.")
    (saved .put "last_turn" ((Path "turns") (require_record controller/runtime/sessions session))))
  (if_yes (&& (["cancelled" "failed"] .contains? saved/state) (! ($absent? saved/last_turn)))
    (finish_turn
      controller/runtime
      session
      {
        ^type "turn/end"
        ^turn saved/last_turn
        ^round saved/id
        ^text (?? saved/message "Response cancelled.")
        ^reason (if (== saved/state "cancelled")
                  "cancelled"
                  "error")
        ^!synthetic}))
  (if_not (== saved/state "waiting") (saved .put "finished_at" ($to_str ($now))))
  (if (&& (== saved/state "waiting") (! (operator_round? saved)))
    (saved .put "remaining_ms" ($math/max 0 (- saved/deadline_ms ($os/wall_ms)))))
  (if (|| (["failed" "interrupted"] .contains? saved/state)
          (&& (== saved/state "paused") (!= saved/continuation_mode "automatic")))
    (update_session controller/runtime/sessions session {^^attention}))
  (save_round controller session saved)
  (controller/active
    .get
    ; .delete session)
  (if_not ($absent? controller/runtime/delegations)
    (note_delegation_round controller/runtime/delegations session saved))
  saved)

(fn start_round_task [controller : RoundController, session : Str, receipt, ^resume resume : Bool = false]
  (if_yes controller/runtime/stopping/.get
    (receipt .put "state" "cancelled")
    (receipt .put "message" "Workspace stopped.")
    (save_round controller session receipt)
    (return receipt))
  (acquire_body_use controller/runtime)
  (let completion ($cell false))
  (controller/completions/.get .put session completion)
  (let task
    (spawn ^lane root (run_round ^resume resume controller/runtime session receipt)))
  (controller/active
    .get
    ; .put session task)
  (let expired ($cell false))
  (let deadline
    (if (operator_round? receipt)
      nil
      (spawn ^lane root (do ($sleep ($math/max 0 (- receipt/deadline_ms ($os/wall_ms)))) (expired .set true) task/.cancel))))
  (let watcher
    (spawn ^lane root (do (try (let outcome (try task/.join ensure (if_not ($absent? deadline) deadline/.cancel deadline/.join))) (finish_round ^completion completion controller session receipt (if expired/.get (TaskOutcome/ok {^state "failed" ^message (if ($absent? receipt/delegation) "trigger round budget timed out" "child round budget timed out")}) outcome)) ensure (release_body_use controller/runtime)))))
  (controller/watchers
    .get
    ; .put session watcher)
  receipt)

(fn submit_round [controller : RoundController, session : Str, request_id : Str, sequence : Int, text : Str, ^initiator initiator : Str = "user", ^on_admit on_admit = nil, ^media media = [], ^card card = nil, ^input input = nil]
  (with_body_use
    controller/runtime
    (fn []
      (with_session_gate
        controller/runtime/sessions
        $"round/${session}"
        (fn []
          (submit_round_impl ^initiator initiator ^on_admit on_admit ^media media ^card card ^input input
            controller
            session
            request_id
            sequence
            text))))))

(fn submit_round_impl [controller : RoundController, session : Str, request_id : Str, sequence : Int, text : Str, ^initiator initiator : Str = "user", ^on_admit on_admit = nil, ^media media = [], ^card card = nil, ^limits limits = nil, ^delegation delegation = nil, ^input input = nil, ^continuation continuation = nil]
  (let source (resolve_initiator controller/runtime session initiator text input continuation))
  (let user_source (== source/kind "user"))
  (let channel_source source/channel)
  (let checked_input source/input)
  (require_chat controller/runtime/modes session)
  (if (> ($str/byte_size text) prompt_limit)
    (fail (RoundError ^code "too_large" ^message "Message text exceeds 64 KiB; attach the document instead.")))
  (if controller/runtime/stopping/.get
    (fail (RoundError ^code "stopped" ^message "workspace is stopping")))
  (let state (round_state controller session))
  (if_not (== ($head media) List)
    (fail (RoundError ^code "invalid_request" ^message "Attachments must be a list of media IDs.")))
  # A card send's identity covers the card revisions the user saw, so a retry
  # resolves to the payload admitted the first time.
  (let card_ref (if ($absent? card) nil
    {^id card/id ^definition_revision card/definition_revision ^revision card/revision}))
  (if (&& (! ($absent? checked_input)) (|| (! media/.empty?) (! ($absent? card_ref))))
    (fail (RoundError ^code "invalid_request" ^message
      (if (== checked_input/kind "voice") "Voice input does not attach composer media or cards."
        "Channel input does not attach browser composer media or cards."))))
  (let digest (round_digest text media card_ref checked_input))
  (for old in state/receipts
    (if (|| (== old/request_id request_id) (== old/submission_seq sequence))
      (then
        (if (&& (== old/request_id request_id) (== old/submission_seq sequence) (== old/digest digest))
          (return old))
        # A browser draft can carry the sequence a channel drain just claimed.
        # Preserve request-ID conflicts, but report this admission race as busy
        # while the channel round is active so the draft remains retryable.
        (if_yes (&& user_source (!= old/request_id request_id))
          (let competing (load_session controller/runtime/sessions session))
          (if (&& (== competing/round/.get/input/kind "channel") (session_busy? competing))
            (fail (RoundError ^code "busy" ^message "this session already has a channel round"))))
        (fail
          (RoundError ^code "submission_conflict" ^message "submission identity has different content")))))
  (let loaded (load_session controller/runtime/sessions session))
  (if (&& channel_source (== loaded/round/.get/state "paused")
          ($absent? loaded/round/.get/continuation_stop))
    (fail (RoundError ^code "paused" ^message "Choose continuation or explicit supersession before admitting a queued request.")))
  (let attachments (if media/.empty? []
    (validate_media_refs (open_media_store controller/runtime/state_root) media)))
  (if (|| (session_busy? loaded) (! ($absent? (controller/active/.get .get session))))
    (fail (RoundError ^code "busy" ^message "this session already has a round")))
  (if (!= sequence state/next_seq)
    (fail (RoundError ^code "submission_conflict" ^message "unexpected submission sequence")))
  (let card_item (if ($absent? card_ref) nil
    (do
      (if_not user_source
        (fail (RoundError ^code "invalid_request" ^message "Only the user sends cards.")))
      (card_send_item controller/runtime session card_ref text))))
  (let admission_lease (acquire_snapshot controller/runtime/h/snapshots))
  (let ready_message
    (try
      ($runtime/with_context
        {^composition controller/runtime/h/snapshots
         ^snapshot admission_lease/snapshot}
        (fn []
          (let settings (session_settings (require_record controller/runtime/sessions session)
            ($serde/read_data ($fs/read_text $"${controller/runtime/state_root}/config.gene"))))
          (readiness_report controller/runtime settings)))
    ensure
      (release_snapshot controller/runtime/h/snapshots admission_lease)))
  (if_not ($absent? ready_message)
    (fail (RoundError ^code "not_ready" ^message ready_message)))
  (let metadata (require_record controller/runtime/sessions session))
  (let changes {})
  (let display_request (if (&& (== ($str/trim text) "") (! attachments/.empty?))
    $"Attachment: ${attachments/0/name}" text))
  (if source/operator (changes .put "attention" false))
  (if_yes (== metadata/first_request "")
    (changes .put "first_request" display_request)
    (changes .put "first_request_media" attachments)
    (if_yes (&& user_source (== metadata/title "New conversation"))
      (let normalized ($str/trim ($regex/replace_all #"\s+" display_request " ")))
      (let title ($first ($regex/split #"[.!?](?:\s|$)" normalized)))
      (if_yes (!= title "")
        (var prefix "")
        (for character in ($take ($graphemes title) 64)
          (if (> ($str/byte_size ($to_str prefix character)) 256) (break))
          (set prefix ($to_str prefix character)))
        (if (== prefix "") (set prefix "New conversation"))
        (changes .put "title" ($str/trim prefix))
        (changes .put "revision" (+ (?? metadata/revision 0) 1)))))
  (if (> ($size changes) 0) (update_session controller/runtime/sessions session changes))
  (let receipt
    {
      ^id $"round-${($str/slice_bytes ($crypto/sha256 session) 0 16)}-${sequence}"
      ^request_id request_id
      ^submission_seq sequence
      ^digest digest
      ^state "running"
      ^initiator initiator
      ^initiator_kind source/name ^operator source/operator
      ^prompt text
      ^request text
      ^turn_count 0
      ^accepted_at ($to_str ($now))})
  (if_not attachments/.empty? (receipt .put "media" attachments))
  (if_not ($absent? checked_input) (receipt .put "input" checked_input))
  (if_not ($absent? limits) (receipt .put "effective_limits" (copy_data limits)))
  (if_not ($absent? delegation) (receipt .put "delegation" (copy_data delegation)))
  (receipt .put "task_root" (?? continuation/task_root receipt/id))
  (receipt .put "task_turns_base" (?? continuation/task_turns 0))
  (receipt .put "continuation_mode" (?? continuation/mode "manual"))
  (if_not ($absent? continuation)
    (receipt .put "continuation" (copy_data continuation))
    (receipt .put "continued_from" continuation/source_round))
  (if (! (operator_round? receipt))
    (then
      (let config
        ($serde/read_data ($fs/read_text $"${controller/runtime/state_root}/config.gene")))
      (receipt .put "deadline_ms" (+ ($os/wall_ms) (?? limits/timeout_ms (?? config/trigger_timeout_ms 300000))))))
  (if user_source
    (then
      (let items (take_command_attachments controller/runtime session))
      (if_not items/.empty?
        (let rendered (bounded_request controller/runtime session items))
        (receipt .put
          "request"
          ($to_str
            rendered/full
            """
"""
            text)))))
  (if_yes (! ($absent? card_item))
    (let rendered (bounded_request controller/runtime session [card_item]))
    (receipt .put "card" card_ref)
    (receipt .put "request" ($to_str receipt/request "\n" rendered/full)))
  (if (== source/kind "trigger")
    (then
      (receipt .put
        "request"
        ($to_str
          "[trigger "
          metadata/trigger
          " occurrence "
          metadata/occurrence
          """]
"""
          text))))
  (loaded/round .set receipt)
  (save_round controller session receipt)
  (if_not ($absent? on_admit) (on_admit receipt))
  (start_round_task controller session receipt))

(fn stop_continuation [controller, session : Str, source : Str, failure]
  (with_session_gate controller/runtime/sessions $"round/${session}"
    (fn [] (stop_continuation_locked controller session source failure))))

(fn stop_continuation_locked [controller, session : Str, source : Str, failure]
  (let original (round_receipt controller session source))
  (if ($absent? original) (return nil))
  (if_not ($absent? original/continuation_stop) (return nil))
  (let stopped (copy_data original))
  (stopped .put "continuation_stop"
    (if (["stale" "busy" "not_found"] .contains? failure/code) "superseded" "failed"))
  (stopped .put "continuation_error" ($to_str failure/message))
  (let loaded (load_session controller/runtime/sessions session))
  (let current (== (/id loaded/round/.get) source))
  (save_round ^current current controller session stopped)
  (if current (update_session controller/runtime/sessions session {^^attention}))
  nil)

(fn continue_round [controller : RoundController, session : Str, source : Str, mode : Str]
  (if_not (["manual" "automatic"] .contains? mode)
    (fail (RoundError ^code "invalid_request" ^message "Unknown continuation mode.")))
  (with_body_use controller/runtime (fn []
    (with_session_gate controller/runtime/sessions $"round/${session}"
      (fn [] (continue_round_locked controller session source mode))))))

# Caller holds the session gate and has durably claimed an explicit operator
# choice to replace this paused task. The claim ID makes crash recovery safe.
(fn replace_paused_round_locked [controller, session : Str, source : Str, claim : Str]
  (let loaded (load_session controller/runtime/sessions session))
  (let receipt loaded/round/.get)
  (if (|| (!= receipt/id source) (!= receipt/state "paused")
          (!= receipt/continuation_mode "manual"))
    (fail (RoundError ^code "stale" ^message "The named manual pause is no longer current.")))
  (if (&& (== receipt/continuation_stop "superseded") (== receipt/queue_replacement claim))
    (return receipt))
  (if (|| (! ($absent? receipt/continuation_stop)) (! ($absent? receipt/continued_by)))
    (fail (RoundError ^code "stale" ^message "This paused task already has a continuation decision.")))
  (receipt .put "continuation_stop" "superseded")
  (receipt .put "queue_replacement" claim)
  (save_round controller session receipt)
  receipt)

(fn continue_round_locked [controller, session : Str, source : Str, mode : Str]
  (let old (round_receipt controller session source))
  (if ($absent? old) (fail (RoundError ^code "not_found" ^message "Paused round not found.")))
  (if_not ($absent? old/continued_by)
    (let successor (round_receipt controller session old/continued_by))
    (if_not ($absent? successor)
      (if (&& (== successor/request_id $"continue/${source}")
              (== successor/continued_from source))
        (return successor)
        (fail (RoundError ^code "stale" ^message "Continuation admission was superseded.")))))
  (let loaded (load_session controller/runtime/sessions session))
  (if (|| (!= (/id loaded/round/.get) source) (! ($absent? old/continuation_stop)))
    (fail (RoundError ^code "stale" ^message "Continuation was superseded.")))
  (if_not (&& (operator_round? old)
    (|| (== old/state "paused") (&& (== old/state "failed") (== old/message "turn limit reached"))))
    (fail (RoundError ^code "invalid_request" ^message "This round has no pending continuation.")))
  (let state (round_state controller session))
  (let intent old/continuation_intent)
  (let sequence (?? intent/sequence state/next_seq))
  (if (!= sequence state/next_seq) (fail (RoundError ^code "stale" ^message "Continuation sequence was superseded.")))
  (let chosen (?? intent/mode mode))
  (let descriptor (copy_data (?? old/continuation
    {^items_ref old/request_items_ref ^history (pending_request controller/runtime session)
     ^media (?? old/request_media []) ^request_sources (?? old/request_sources [])
     ^task_root (?? old/task_root old/id) ^task_turns (?? old/task_turns old/turn_count)})))
  (if_not ($absent? old/input) (descriptor .put "input" (copy_data old/input)))
  (if (|| ($absent? descriptor/items_ref) ($absent? descriptor/history))
    (fail (RoundError ^code "unavailable" ^message "Pending input cannot be safely restored.")))
  (descriptor .put "mode" chosen)
  (descriptor .put "source_round" source)
  (descriptor .put "source_turn" old/last_turn)
  (let request_id $"continue/${source}")
  (let successor_id $"round-${($str/slice_bytes ($crypto/sha256 session) 0 16)}-${sequence}")
  (let claimed (copy_data old))
  (claimed .put "continued_by" successor_id)
  (claimed .put "continuation_mode" chosen)
  (claimed .put "continuation_intent" {^sequence sequence ^mode chosen ^request_id request_id})
  (claimed .put "continuation" descriptor)
  (claimed .put "task_root" descriptor/task_root)
  (claimed .put "task_turns" descriptor/task_turns)
  (save_round controller session claimed)
  (try
    (submit_round_impl controller session request_id sequence ""
      ^initiator (make_initiator controller/runtime/h "continue" source)
      ^limits old/effective_limits ^continuation descriptor
      ^input (?? descriptor/input nil))
  catch Any
    (let failure $err)
    (let admitted (round_receipt controller session successor_id))
    (if (&& (! ($absent? admitted)) (== admitted/request_id request_id)) (return admitted))
    (stop_continuation_locked controller session source failure)
    (fail failure)))

(fn resume_continuations [controller : RoundController]
  (for [id metadata] in controller/runtime/sessions/index/.get
    (if_not (["paused" "failed"] .contains? metadata/status) (continue))
    (let session ($to_str id))
    (let loaded (load_session controller/runtime/sessions session))
    (let receipt loaded/round/.get)
    (if_not ($absent? receipt/continuation_stop) (continue))
    (if (|| (== receipt/continuation_mode "automatic") (! ($absent? receipt/continuation_intent)))
      (try (continue_round controller session receipt/id (?? receipt/continuation_mode "manual"))
        catch Any (stop_continuation controller session receipt/id $err))))
  nil)

(fn answer_round [controller : RoundController, session : Str, batch_id : Str, values,
                 ^dismiss dismiss : Bool = false, ^operator_input operator_input : Bool = false]
  (with_body_use
    controller/runtime
    (fn []
      (with_session_gate
        controller/runtime/sessions
        $"round/${session}"
        (fn []
          (answer_round_impl ^dismiss dismiss ^operator_input operator_input controller session batch_id values))))))

(fn batch_round_id [batch, batch_id : Str] : Str
  (if_not ($absent? batch/round) (return batch/round))
  (let parts ($str/split batch_id "-q-"))
  (if (< ($size parts) 2) "" parts/0))

(fn answer_round_impl [controller : RoundController, session : Str, batch_id : Str, values,
                      ^dismiss dismiss : Bool = false, ^channel_input channel_input = nil,
                      ^operator_input operator_input : Bool = false]
  (let loaded (load_session controller/runtime/sessions session))
  (let receipt loaded/round/.get)
  (if (&& operator_input (! ($absent? channel_input)))
    (fail (RoundError ^code "invalid_request" ^message "A question answer has one input origin.")))
  (let source (if ($absent? channel_input)
    (if operator_input {^kind "harness" ^transport "harness"} nil) (normalize_message channel_input)))
  (if_yes (== source/transport "slack")
    (let bound (/channel (require_record controller/runtime/sessions session)))
    (if (|| ($absent? bound) (!= source/account bound/account) (!= source/team bound/team)
            (!= source/channel bound/channel) (!= source/thread bound/thread))
      (fail (RoundError ^code "forbidden" ^message "The channel answer belongs to a different conversation."))))
  # A finalized batch answers retries before round admission: an identical
  # reply returns its stored result without resuming anything, even after the
  # session moved on; any other reply is refused.
  (let stored (core_state controller/runtime/events "session" session $"questions/${batch_id}"))
  (if_yes (&& (! ($absent? stored)) (== stored/status "answered") (! ($absent? stored/submitted_digest)))
    (if (|| (!= stored/submitted_digest (submitted_digest values dismiss))
            (!= (?? stored/intent "continue") "continue"))
      (fail (QuestionError ^message $"question batch ${batch_id} already has different answers")))
    (let owner (round_receipt controller session (batch_round_id stored batch_id)))
    (if_not ($absent? owner) (return (copy_data owner)))
    (if_not ($absent? receipt) (return (copy_data receipt)))
    (fail (RoundError ^code "not_found" ^message "The round for this answered batch is not retained.")))
  (if (|| ($absent? receipt) (!= receipt/questions/id batch_id))
    (fail (RoundError ^code "invalid_request" ^message "session is not waiting on this batch")))
  (let lease (acquire_snapshot controller/runtime/h/snapshots))
  (let batch
    (try
      ($runtime/with_context
        {^composition controller/runtime/h/snapshots ^snapshot lease/snapshot ^session session}
        (fn []
          (scope
            (answer_questions ^dismiss dismiss ^validators (answer_validators lease/snapshot) ^source source
              controller/runtime/events
              session
              batch_id
              values))))
    ensure
      (release_snapshot controller/runtime/h/snapshots lease)))
  (if_not (== receipt/state "waiting") (return (copy_data receipt)))
  (continue_answered_round controller session receipt batch))

# The recorded continuation of an answered batch: answering, and recovery
# after a crash between the answer and this step, both run it exactly once.
(fn continue_answered_round [controller : RoundController, session : Str, receipt, batch, ^dispatched dispatched : Bool = false]
  (if_yes (&& (! dispatched) (! ($absent? controller/runtime/delegations))
          (queue_delegation_answer controller/runtime/delegations session receipt batch))
    (receipt .put "questions" batch)
    (receipt .put "resume_queued" true)
    (save_round controller session receipt)
    (return (copy_data receipt)))
  # Card clicks admitted before the answer finish before the model runs.
  (wait_for_card_actions controller/runtime session)
  (let items
    (if ($absent? receipt/request_items_ref)
      []
      ($serde/read_data
        ($fs/read_text $"${controller/runtime/state_root}/blobs/${receipt/request_items_ref}"))))
  (let answer_base $"${receipt/last_turn}.answers")
  (var answer_id answer_base)
  (var answer_index 1)
  (loop
    (var claimed false)
    (for item in items
      (if (== item/id answer_id) (set claimed true)))
    (if_not claimed (break))
    (set answer_index (+ answer_index 1))
    (set answer_id $"${answer_base}#${answer_index}"))
  (let answer_origin (if ($absent? batch/answer_source) ""
    (if (== batch/answer_source/transport "slack")
      ($to_str " [Slack message " batch/answer_source/message " from " batch/answer_source/author "]")
      " [User via Harness]")))
  (items .push {^id answer_id ^header ($to_str "[" answer_id "]" answer_origin) ^value ($to_str batch/answers)})
  (let requests (bounded_request controller/runtime session items))
  (let request requests/full)
  (receipt .put "request" request)
  (receipt .put "logical_items_ref" (write_body controller/runtime
    ($serde/write_data ($filter items (fn [item] (!= item/settled false))))))
  (receipt .put "state" "running")
  (receipt .put "resume_queued" false)
  (if (! (operator_round? receipt))
    (receipt .put "deadline_ms" (+ ($os/wall_ms) (?? receipt/remaining_ms 300000))))
  (append_message ^media (?? receipt/request_media []) ^settled requests/settled ^round receipt/id ^turn receipt/last_turn
    controller/runtime
    session
    "user"
    request)
  (transcript
    controller/runtime
    session
    {
      ^type "turn/request"
      ^turn receipt/last_turn
      ^for_turn (+ receipt/last_turn 1) ^combine "replace"
      ^round receipt/id
      ^full request
      ^settled requests/settled
      ^answer_source (?? batch/answer_source nil)
      ^^answers})
  (save_round controller session receipt)
  (start_round_task ^^resume controller session receipt))

# The delegation coordinator already holds the parent's round gate and its
# workspace admission gate. Do not reacquire either gate from this callback.
(fn resume_delegation_parent [controller, session : Str, round : Str, wait, incoming, collection : Bool]
  (let loaded (load_session controller/runtime/sessions session))
  (let current loaded/round/.get)
  (if (|| ($absent? current) (!= current/id round) (!= current/state "waiting")
          ($absent? current/delegation_wait)
          (!= current/delegation_wait/generation wait/generation)) (return false))
  (let receipt (copy_data current))
  (let items (if ($absent? receipt/request_items_ref) []
    ($serde/read_data (read_body controller/runtime receipt/request_items_ref))))
  (let sources ($map items (fn [item] (?? item/delegation_source ""))))
  (for item in incoming
    (if_not (sources .contains? item/delegation_source)
      (items .push item)
      (sources .push item/delegation_source)))
  (if collection
    (items .push {^id $"${receipt/last_turn}.collection" ^header "[harness_budget]"
      ^value "This is the final collection turn after the normal round limit. All owned work settled. Do not delegate or wait; finish with Outcome ^^done and a nonempty reply." ^settled false}))
  (let rendered (bounded_request controller/runtime session items))
  (receipt .put "request" rendered/full)
  (receipt .put "logical_items_ref" (write_body controller/runtime
    ($serde/write_data ($filter items (fn [item] (!= item/settled false))))))
  (receipt .put "request_settled" rendered/settled)
  (receipt .put "request_items_ref" (write_body controller/runtime ($serde/write_data rendered/items)))
  (receipt .put "request_sources" ($filter sources (fn [source] (!= source ""))))
  (receipt .put "delegation_collection" collection)
  (receipt .put "collection_turns" (if collection 1 0))
  (receipt .put "delegation_wait" nil)
  (receipt .put "questions" nil)
  (receipt .put "state" "running")
  (if (! (operator_round? receipt))
    (receipt .put "deadline_ms" (+ ($os/wall_ms) (?? receipt/remaining_ms 300000))))
  (append_message ^settled rendered/settled ^round round ^turn receipt/last_turn
    controller/runtime session "user" rendered/full)
  (transcript controller/runtime session {^type "turn/request" ^turn receipt/last_turn
    ^round round ^for_turn (+ receipt/last_turn 1) ^combine "replace"
    ^full rendered/full ^settled rendered/settled ^delegation true})
  (save_round controller session receipt)
  (start_round_task controller session receipt ^^resume)
  true)

# Recovery found waiting rounds whose batch was answered with a recorded
# continuation but never resumed. Resume each once, now that rounds can run.
(fn resume_answered_rounds [controller : RoundController]
  (let sessions controller/runtime/sessions)
  (let pending sessions/resumes/.get)
  (sessions/resumes .set [])
  (for session in pending
    (try
      (with_body_use controller/runtime (fn []
        (with_session_gate sessions $"round/${session}" (fn []
          (let loaded (load_session sessions session))
          (let receipt loaded/round/.get)
          (if_yes (&& (! ($absent? receipt)) (== receipt/state "waiting") (! ($absent? receipt/questions)))
            (let batch (core_state controller/runtime/events "session" session $"questions/${receipt/questions/id}"))
            (if (&& (! ($absent? batch)) (== batch/status "answered") (== batch/intent "continue"))
              (continue_answered_round controller session receipt batch)))))))
    catch Any
      (append_core_event controller/runtime/events "session" session
        {^type "trace" ^text $"answered round did not resume: ${$err/message}" ^^ignorable})))
  pending/.size)

(fn cancel_round [controller : RoundController, session : Str, id : Str, ^from_delegation from_delegation : Bool = false]
  (let result (with_session_gate controller/runtime/sessions $"round/${session}"
    (fn [] (cancel_round_locked controller session id))))
  (if (&& (! from_delegation) (! ($absent? controller/runtime/delegations)))
    (close_delegation_owner controller/runtime/delegations session result/id "The parent round was cancelled."))
  result)

(fn cancel_round_locked [controller, session : Str, id : Str]
  (let loaded (load_session controller/runtime/sessions session))
  (let receipt loaded/round/.get)
  (if ($absent? receipt)
    (fail (RoundError ^code "not_found" ^message "round not found")))
  (if_yes (!= receipt/id id)
    (let source (round_receipt controller session id))
    (if_not (&& (== source/continuation_mode "automatic")
      (== (?? source/task_root source/id) (?? receipt/task_root receipt/id)))
      (fail (RoundError ^code "not_found" ^message "round not found"))))
  (let task (controller/active .get; .get session))
  (if_not ($absent? task) task/.cancel)
  (if (["waiting" "paused"] .contains? receipt/state)
    (then
      (if_not ($absent? receipt/questions)
        (let batch (core_state controller/runtime/events "session" session $"questions/${receipt/questions/id}"))
        (if (== batch/status "waiting")
          (answer_questions ^^dismiss ^intent "cancel" controller/runtime/events session receipt/questions/id {})))
      (receipt .put "state" "cancelled")
      (receipt .put "continuation_stop" "cancelled")
      (save_round controller session receipt)))
  receipt)

(fn close_round_controller [controller : RoundController]
  (if_not ($absent? controller/runtime/delegations)
    (prepare_delegations_stop controller/runtime/delegations []))
  (for [session task] in controller/active/.get
    task/.cancel)
  (for [session watcher] in controller/watchers/.get
    watcher/.join)
  (controller/active .set {})
  nil)

(fn request_stop [controller : RoundController, session : Str, code : Int, confirmed : Bool]
  (let others [])
  (for [id task] in controller/active/.get
    (if (!= ($to_str id) session) (others .push ($to_str id))))
  (let runtime controller/runtime)
  (if_not ($absent? runtime/commands)
    (for [id task] in runtime/commands/active/.get
      (if (|| (== session "") (! ($str/starts_with? ($to_str id) $"${session}:")))
        (others .push $"command ${id}"))))
  (if_not ($absent? runtime/actions)
    (for [id task] in runtime/actions/active/.get (others .push $"view action ${id}")))
  (let names ($str/join others ", "))
  (if (&& (! others/.empty?) (! confirmed))
    (fail
      (RoundError ^code "confirmation_required" ^message $"Other sessions are running: ${names}. Confirm /stop or /restart.")))
  (runtime/stopping .set true)
  (if_not ($absent? runtime/delegations)
    (prepare_delegations_stop runtime/delegations []))
  (runtime/commands/accepting .set false)
  (var exit_code code)
  (if (&& (== code 75) (!= runtime/supervised true) (!= ($os/env? "GENE_HARNESS_SUPERVISED") "1"))
    (then
      ($println "Direct gene run: restart stops this process; start it again from the terminal.")
      (set exit_code 0)))
  (runtime/exit_code .set exit_code)
  (if ($absent? runtime/shutdown_watchdog/.get)
    (then
      (let watchdog (spawn ^lane root (do
        ($sleep 5000)
        (if_not runtime/closed/.get
          (if runtime/owns_ownership (close_workspace_lock runtime/ownership))
          ($os/exit runtime/exit_code/.get)))))
      watchdog/.detach
      (runtime/shutdown_watchdog .set watchdog)))
  (if (== exit_code 75)
    ($fs/write_text_atomic $"${runtime/state_root}/restart_notice"
      ($serde/write_data {^at ($to_str ($now)) ^port runtime/listen_port})))
  (let running [])
  (for [id task] in controller/active/.get
    (running .push {^id ($to_str id) ^task task}))
  (let cancelled {})
  (for entry in running
    entry/task/.cancel
    (let state (load_session runtime/sessions entry/id))
    (let receipt state/round/.get)
    (if_not ($absent? receipt) (cancelled .put receipt/id true)))
  # One durable admission marker covers every active round before any slow
  # receipt publication or uncooperative cleanup can consume the grace time.
  ($fs/write_text_atomic $"${runtime/state_root}/shutdown.gene" ($serde/write_data cancelled))
  (for entry in running
    (let state (load_session runtime/sessions entry/id))
    (let receipt state/round/.get)
    (if_not ($absent? receipt)
      (receipt .put "state" "cancelled")
      (receipt .put "message" "Workspace stopped.")
      (receipt .put "last_turn" (/turns (require_record runtime/sessions entry/id)))
      (finish_round controller entry/id receipt TaskOutcome/cancelled)))
  nil)
