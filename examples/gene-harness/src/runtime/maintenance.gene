# Offline repair keeps the previous activation-free bootstrap and its durable
# crash recovery. Ordinary CLI operations never enter this module's runtime.
(mod maintenance)
(import open_runtime close_runtime prepare_workspace_root ^from "./bootstrap")
(import plugin_catalog ^from "./plugin_manager")
(import baseline_profile ^from "../profiles/baseline")
(import workspace_profile ^from "../profiles/registry")
(import doctor disable_entry enable_entry restore_entry revert_entry plugin_history_page
  ^from "../storage/workspace_repair")
(import composition_revision ^from "../storage/composition_store")
(import acquire_workspace_lock close_workspace_lock ^from "./workspace_lock")
(import reset_auth_at ^from "../web/auth")
(import clear_connection ^from "../web/connection")

(fn repair [root : Str, action : Str, id : Str = "", ^revision revision = nil,
            ^expected expected = nil, ^before before = nil, ^limit limit : Int = 50,
            ^query query : Str = "", ^state state : Str = ""]
  (let runtime
    (open_runtime ^entry "offline maintenance" ^!activate ^mode (if (== action "doctor") "doctor" else "recovery")
      (prepare_workspace_root ^root root)
      "default"
      (workspace_profile root)))
  (try
    (if (== action "plugins") (return (plugin_catalog ^query query ^state state runtime)))
    (if (== action "doctor")
      (return {^findings (doctor runtime/workspace)}))
    (if (== action "history")
      (return (plugin_history_page ^limit limit ^before before runtime/workspace id)))
    (if (== id "") (fail (Error ^_msg "A plugin id is required.")))
    (if (== action "revert")
      (if (!= ($head revision) Int)
        (fail (Error ^_msg "revert requires a historical composition revision")))
      (return (revert_entry ^expected expected runtime/workspace id revision)))
    (let base (composition_revision runtime/workspace))
    (let committed_revision
      (match action
        when "disable"
          (disable_entry ^h runtime/h runtime/workspace id)
        when "enable"
          (enable_entry ^h runtime/h runtime/workspace id)
        when "restore"
          (restore_entry ^h runtime/h runtime/workspace id)
        else
          (fail (Error ^_msg "Unknown maintenance operation."))))
    {^action action ^id id ^revision committed_revision ^changed (!= base committed_revision)}
  ensure
    (close_runtime runtime)))

(fn reset_offline [root : Str]
  (let canonical (prepare_workspace_root ^root root))
  (let lock (acquire_workspace_lock canonical "offline credential reset"))
  (try
    (reset_auth_at $"${canonical}/.gene-harness")
    (clear_connection canonical "")
    {
      ^^ok
      ^message "Owner credential reset. Start the web host and use gene-harness link to connect."}
  ensure
    (close_workspace_lock lock)))
