(mod tool_execution)

(import [Harness HarnessError ToolRequest ToolTask ToolError PluginInputRequest row_record status_of invoke_owned_callable
         callback_receiver validate_tool_delegation validate_plugin_input log_append flush_harness set_run_round]
  ^from "../kernel")
(import [composition_entries] ^from "../storage/workspace")
(import [request_input] ^from "./interactions")
(import $crypto [sha256])

(type PendingToolInput ^private true ^props {^plan Any})

(fn await_owned_tasks [h : Harness, owner : Str, value]
  (var current value)
  (var count 0)
  (while (== ($head current) ToolTask)
    (set count (+ count 1))
    (if (> count 16) (fail (ToolError ^code "task_limit" ^message "Too many asynchronous tool stages.")))
    (var task current/task)
    (var outcome (try (task .join) ensure (task .cancel)))
    (var result nil)
    (match outcome
      (when (TaskOutcome/ok value) (set result value))
      (when (TaskOutcome/error error) (fail error))
      (when (TaskOutcome/panic message) (fail (ToolError ^code "tool_panic" ^message message)))
      (when TaskOutcome/cancelled (fail (ToolError ^code "tool_cancelled" ^message "The tool task was cancelled."))))
    (if ($absent? current/continuation)
      (set current result)
      (set current (invoke_owned_callable h owner current/continuation [result]))))
  current)

(fn plugin_digest [h : Harness, owner : Str]
  (if_not ($absent? h/workspace)
    (for entry in (composition_entries h/workspace)
      (if_yes (== entry/id owner) (return (sha256 ($to_str entry))))))
  "builtin")

(fn validate_input [schema, value, ^path path : Str = "input", ^depth depth : Int = 0]
  (if (> depth 32) (fail (HarnessError ^message "tool input nesting exceeds 32 levels")))
  (if ($absent? schema) (return nil))
  (var kind (?? schema/type ""))
  (if_yes (== ($head kind) List)
    (var accepted false)
    (for typ in kind
      (var variant ($thaw ($freeze schema)))
      (variant .put "type" typ)
      (try
        (validate_input variant value ^path path ^depth (+ depth 1))
        (set accepted true)
      catch Any nil))
    (if_not accepted (fail (HarnessError ^message $"${path} does not match any of ${kind}")))
    (return nil))
  (if_not (["" "string" "integer" "number" "boolean" "object" "array" "null"] .contains? kind)
    (fail (HarnessError ^message $"Unsupported tool schema type ${kind}")))
  (if_not ($absent? schema/anyOf)
    (var accepted false)
    (for variant in schema/anyOf
      (try
        (validate_input variant value ^path path ^depth (+ depth 1))
        (set accepted true)
      catch Any nil))
    (if_not accepted (fail (HarnessError ^message $"${path} does not match any allowed shape"))))
  (var head ($head value))
  (var valid
    (if (== kind "string") (== head Str)
      (if (== kind "integer") (== head Int)
        (if (== kind "number") (|| (== head Int) (== head F64))
          (if (== kind "boolean") (== head Bool)
            (if (== kind "object") (== head Map)
              (if (== kind "array") (== head List)
                (if (== kind "null") (== value nil) true))))))))
  (if_not valid (fail (HarnessError ^message $"${path} must be ${kind}")))
  (if_yes (&& (== head Str)
              (|| (! ($absent? schema/minLength)) (! ($absent? schema/maxLength))))
    (var bytes ($str/to_utf8 value))
    (var count 0)
    (var i 0)
    (while (< i ($str/byte_size value))
      (var byte (bytes .get i))
      (if_yes (|| (< byte 128) (>= byte 192)) (set count (+ count 1)))
      (set i (+ i 1)))
    (if_yes (&& (! ($absent? schema/minLength)) (< count schema/minLength))
      (fail (HarnessError ^message $"${path} is too short")))
    (if_yes (&& (! ($absent? schema/maxLength)) (> count schema/maxLength))
      (fail (HarnessError ^message $"${path} is too long"))))
  (if_yes (|| (== head F64) (== head Int))
    (if_yes (&& (! ($absent? schema/minimum)) (< value schema/minimum))
      (fail (HarnessError ^message $"${path} is below its minimum")))
    (if_yes (&& (! ($absent? schema/maximum)) (> value schema/maximum))
      (fail (HarnessError ^message $"${path} is above its maximum"))))
  (if_not ($absent? schema/enum)
    (if_not (schema/enum .contains? value)
      (fail (HarnessError ^message $"${path} must be one of ${schema/enum}"))))
  (if (== head Map)
    (then
      (for name in (?? schema/required [])
        (if (== (value .get name) void) (fail (HarnessError ^message $"${path}.${name} is required"))))
      (var properties (?? schema/properties {}))
      (for [name field] in value
        (var spec (properties .get name))
        (if_yes (&& ($absent? spec) (== schema/additionalProperties false))
          (fail (HarnessError ^message $"${path}.${name} is not supported")))
        (if_not ($absent? spec)
          (validate_input spec field ^path $"${path}.${name}" ^depth (+ depth 1)))))
    (elif (== head List)
      (var n value/.size)
      (if_yes (&& (! ($absent? schema/minItems)) (< n schema/minItems))
        (fail (HarnessError ^message $"${path} needs at least ${schema/minItems} items")))
      (if_yes (&& (! ($absent? schema/maxItems)) (> n schema/maxItems))
        (fail (HarnessError ^message $"${path} accepts at most ${schema/maxItems} items")))
      (var i 0)
      (for item in value
        (var prefix (?? schema/prefixItems []))
        (var spec (if (< i prefix/.size) prefix/%i schema/items))
        (if_not (|| ($absent? spec) (== spec false))
          (validate_input spec item ^path $"${path}[${i}]" ^depth (+ depth 1)))
        (set i (+ i 1)))))
  nil)

# All entries happen from the host's scope, after the caller's restricted
# invocation has returned. Each callee and continuation gets its own policy.
(fn call_tool [h : Harness, name : Str, input, ^depth depth : Int = 0]
  (if (>= depth 16) (fail (HarnessError ^message "tool delegation exceeds 16 calls")))
  (var record (row_record h "tools" name))
  (if ($absent? record) (fail (HarnessError ^message $"no tool ${name}")))
  (if_not (== (status_of h record/owner) "ready")
    (fail (HarnessError ^message $"tool ${name} is not ready")))
  (validate_input record/payload/input_schema input)
  (var args (if (== record/payload/contextual true)
    [(callback_receiver h record/owner) input] [input]))
  (var value (await_owned_tasks h record/owner
    (invoke_owned_callable h record/owner record/payload/run args)))
  (var calls depth)
  (while (== ($head value) ToolRequest)
    (set calls (+ calls 1))
    (if (>= calls 16) (fail (HarnessError ^message "tool delegation exceeds 16 calls")))
    (validate_tool_delegation h record/owner value)
    (var result (tool_result h value/name value/input ^depth calls))
    (if_not ($absent? result/pending)
      (if_not ($absent? value/continuation)
        (fail (HarnessError ^message "A question cannot persist a function continuation. Request input directly with a named resume tool.")))
      (return (PendingToolInput ^plan result/pending)))
    (if ($absent? value/continuation)
      (then
        (if_not result/ok (fail (ToolError ^code result/error/code
          ^message result/error/message ^data result/error/details)))
        (return result/value))
      (else (set value (await_owned_tasks h record/owner
        (invoke_owned_callable h record/owner value/continuation [result]))))))
  (if_yes (== ($head value) PluginInputRequest)
    (validate_plugin_input h record/owner value)
    (return (PendingToolInput ^plan
      {^request value/request ^resume_tool value/resume_tool ^input value/input
       ^owner record/owner ^digest (plugin_digest h record/owner)})))
  value)

(fn tool_result [h : Harness, name : Str, input, ^depth depth : Int = 0]
  (try
    (var value (call_tool h name input ^depth depth))
    (if (== ($head value) PendingToolInput)
      {^ok true ^pending value/plan}
      {^ok true ^value value})
  catch ToolError
    {^ok false ^error {^code $err/code ^message $err/message ^details $err/data}}
  catch Any
    {^ok false ^error {^code "tool_failed" ^message $err/message}}))

(fn execute_tool [h : Harness, name : Str, input, ^round round : Int = 0,
                  ^continuation continuation = nil]
  (set_run_round h round)
  (log_append h "output" $"${name}\n${input}" ^phase "tool_call" ^round round)
  (flush_harness h)
  (var result (tool_result h name input))
  (if_not ($absent? result/pending)
    (var pending result/pending)
    (var next (if ($absent? continuation)
      {^kind "tool_command" ^prompt $"/tool ${name} ${input}" ^round round}
      ($thaw ($freeze continuation))))
    (next .put "tool" pending/resume_tool)
    (next .put "input" pending/input)
    (next .put "owner" pending/owner)
    (next .put "digest" pending/digest)
    (next .put "round" round)
    (var request
      (try (request_input h pending/request next)
        catch Any (set result {^ok false ^error {^code "invalid_input_request" ^message $err/message}}) nil))
    (if_not ($absent? request)
      (flush_harness h)
      (return {^ok true ^waiting true ^request request})))
  (log_append h "output" ($to_str result) ^phase "tool_result" ^round round)
  (flush_harness h)
  result)

(fn resume_tool [h : Harness, continuation, reply]
  (var record (row_record h "tools" continuation/tool))
  (if (|| ($absent? record) (!= record/owner continuation/owner)
          (!= (plugin_digest h continuation/owner) continuation/digest))
    (fail (ToolError ^code "stale_plugin" ^message "The plugin changed while waiting. Start a new request to use its current version.")))
  (execute_tool h continuation/tool {^input continuation/input ^reply reply}
    ^round (+ continuation/round 1) ^continuation continuation))
