# Core initiator spellings are data. This module also reads old receipts that
# predate explicit initiator-kind/operator metadata; it activates no plugins.
(mod initiator_specs)
(import [normalize_round_input] ^from "./input_metadata")
(import [legacy_channel_operator?] ^from "../channels/initiators")

(const core_source_owner "$host/initiators")

(fn normalize_user_source [context, value] (normalize_round_input value))

(fn core_initiators []
  [{^name "core/user" ^kind "user" ^prefix "user" ^^exact ^^operator ^normalize normalize_user_source}
   {^name "core/trigger" ^kind "trigger" ^prefix "trigger:" ^!operator ^normalize normalize_user_source}
   {^name "core/parent" ^kind "parent" ^prefix "parent:" ^!operator ^normalize normalize_user_source}
   {^name "core/continue" ^kind "continue" ^prefix "continue:" ^^operator ^^requires_continuation
    ^normalize normalize_user_source}])

(fn initiator_matches? [policy, value : Str]
  (if (== policy/exact true) (== policy/prefix value) ($str/starts_with? value policy/prefix)))

(fn legacy_operator_round? [round]
  (let value (?? round/initiator ""))
  (for policy in (core_initiators)
    (if (initiator_matches? policy value)
      (return (&& policy/operator
        (|| (!= policy/requires_continuation true) (! ($absent? round/continuation)))))))
  (legacy_channel_operator? round))
