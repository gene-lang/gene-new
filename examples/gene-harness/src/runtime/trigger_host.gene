# Scoped scheduler activation and ID-based operations. Only the host sees the
# controller, scheduler manager and effect scope.
(mod trigger_host)
(import [TriggerHost ServiceError] ^from "../plugin_api")
(import [service_binding require_service] ^from "./service_handles")
(import [immutable_view] ^from "./composition")
(import [open_trigger_manager close_trigger_manager TriggerError
  list_triggers create_trigger delete_trigger list_occurrences] ^from "./triggers")
(import [composition_entries] ^from "../storage/composition_store")

(fn new_trigger_host [runtime, controller]
  {^runtime runtime ^controller controller ^managers {} ^accepting ($cell true)})

(fn close_trigger_host [state]
  (state/accepting .set false)
  (for [revision manager] in state/managers (close_trigger_manager manager))
  nil)

(fn trigger_manager [runtime]
  (let state runtime/services/values/trigger_host)
  (let policy (runtime/h/plugin_policies/.get .get "triggers"))
  (let manager (if ($absent? state) nil (state/managers .get (?? policy/activation_revision ""))))
  (if (|| ($absent? manager) manager/closed/.get) (return nil))
  manager)

(fn require_trigger_manager [runtime]
  (for entry in (composition_entries runtime/workspace)
    (if (&& (== entry/id "triggers") (== entry/disabled true))
      (fail (TriggerError ^code "unavailable" ^message "The trigger scheduler is disabled or unavailable."))))
  (let manager (trigger_manager runtime))
  (if (|| ($absent? manager) manager/closed/.get)
    (fail (TriggerError ^code "unavailable" ^message "The trigger scheduler is disabled or unavailable.")))
  manager)

(fn scheduler [handle]
  (let service (require_service handle))
  (let state service/config/state)
  (let manager (state/managers .get service/host/notification_revision))
  (if (|| ($absent? manager) manager/closed/.get)
    (fail (ServiceError ^code "unavailable" ^message "This scheduler activation is unavailable.")))
  manager)

(fn start_scheduler [handle]
  (let service (require_service handle))
  (if (!= service/host/owner "triggers")
    (fail (ServiceError ^code "forbidden" ^message "Scheduler activation belongs to the triggers plugin.")))
  (let state service/config/state)
  (if_not state/accepting/.get
    (fail (ServiceError ^code "unavailable" ^message "The scheduler host is closing.")))
  (let revision service/host/notification_revision)
  (let previous (state/managers .get revision))
  (if (&& (! ($absent? previous)) (! previous/closed/.get)) (return {^^available}))
  (let manager (open_trigger_manager service/runtime state/controller
    ^owner service/host/effects ^start service/config/start ^boot service/config/boot))
  (fn close []
    (close_trigger_manager manager)
    (if (same? (state/managers .get revision) manager) (state/managers .delete revision)))
  (try
    (state/managers .put revision manager)
    (service/host/effects .defer close)
    {^^available}
  catch Any (close) (fail $err)))

(type HostedTriggers ^^private ^props {^token Any}
  (impl TriggerHost
    (message start [] : Any (start_scheduler self))
    (message list [] : Any (immutable_view (list_triggers (scheduler self))))
    (message create [definition] : Any (immutable_view (create_trigger (scheduler self) definition)))
    (message delete [id : Str] : Any (immutable_view (delete_trigger (scheduler self) id)))
    (message occurrences [^trigger trigger : Str = ""] : Any
      (immutable_view (list_occurrences (scheduler self) ^trigger (if (== trigger "") nil trigger))))))

(fn trigger_host_binding [runtime, ^start start : Bool = true, ^boot boot : Bool = true]
  (service_binding runtime "triggers" (fn [token] (HostedTriggers ^token token))
    ^config {^state runtime/services/values/trigger_host ^start start ^boot boot}))
