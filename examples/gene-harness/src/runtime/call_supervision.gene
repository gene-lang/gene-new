(mod call_supervision)

# Keep owned callbacks on resumable VM frames, with an explicit deadline and
# a join boundary for errors, panics and cancellation.
(fn supervised_call [callable, args, limits, ^deadline_ms deadline_ms = nil]
  (scope
    (let deadline_at (if ($absent? deadline_ms)
      (+ ($os/monotonic_ms) limits/timeout_ms)
      ($math/min deadline_ms (+ ($os/monotonic_ms) limits/timeout_ms))))
    (let invoke
      ($runtime/bind_call ^policy {^max_steps limits/max_steps ^max_memory_mb limits/max_memory_mb
        ^timeout_ms ($math/max 1 (- deadline_at ($os/monotonic_ms)))}
        callable
        args))
    (let task (spawn ^lane root (scope (invoke))))
    (let deadline (spawn ^lane root
      (do ($sleep ($math/max 0 (- deadline_at ($os/monotonic_ms)))) task/.cancel)))
    (try
      task/.join
    ensure
      deadline/.cancel
      deadline/.join)))
