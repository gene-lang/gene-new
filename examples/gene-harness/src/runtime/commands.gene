(mod commands)
(import [with_command_scope] ^from "./command_scope")
(import [byte_prefix] ^from "../public/text")
(import [command_identity same_command_identity?] ^from "./command_identity")
(import [ui_record] ^from "../ui/state")
(import ^from "../kernel" [rows row contribute CommandChanged publish])
(import ^from "../plugin_api" ^^export [CommandContext CommandResult])
(import ^from "./composition" [acquire_snapshot release_snapshot take_composition_changes discard_composition_changes])
(import [drain_workspace_changes] ^from "../storage/workspace_activation")
(import ^from "../agents/harness_turn" [workspace_bindings])
(import ^from "../agents/eval_site" [evaluate_response])
(import [close_execution_scope] ^from "./execution_budget")
(import [operator_turn operator_bindings operator_forms operator_result operator_context operator_scope] ^from "./operator_eval")
(import ^from "../agents/history"
  [write_body read_body bounded_request acquire_body_use release_body_use with_body_use])
(import ^from "../storage/state"
  [core_state record_core_state flush_event_store next_sequence stream_key])
(import ^from "./sessions" [load_session require_record])
(import ^from "./appearance" [appearance_mode set_appearance])
(import ^from "../web/theme" [theme_modes])
(import ^from "./input_modes"
  [new_input_modes enter_mode close_mode_locked close_input_modes mode_command_finished])

(type CommandError ^props {^code Str ^message Str} ^impl [Error])
(impl Error for CommandError)
(type CommandManager ^props {^runtime Any ^active Any ^watchers Any ^gate Any ^accepting Any ^closed Any ^modes Any?})

(fn command_state [runtime, session : Str]
  (with_body_use runtime (fn [] (command_state_impl runtime session))))

(fn command_state_impl [runtime, session : Str]
  (let manager runtime/services/values/commands)
  (if ($absent? manager) (return (read_command_state runtime session)))
  (manager/gate (fn [] (read_command_state runtime session))))

# Internal callers already holding the command gate use this helper.
(fn read_command_state [runtime, session : Str]
  (let ref (core_state runtime/events "session" session "commands"))
  (if ($absent? ref) (return {^next_id 1 ^records [] ^attached []}))
  (let state ($serde/read_data (read_body runtime ref/digest)))
  (var recovered false)
  (for record in state/records
    (if_yes (&& (== record/status "running") (!= record/runtime_epoch runtime/epoch))
      (record .put "status" "interrupted")
      (record .put "display" "Command interrupted by host restart; it was not replayed.")
      (record .put "finished" ($to_str ($now)))
      (set recovered true)))
  (if recovered (save_command_state runtime session state))
  state)

(fn save_command_state [runtime, session : Str, state]
  (record_core_state
    runtime/events
    "session"
    session
    "command"
    "commands"
    {^digest (write_body runtime ($serde/write_data state))})
  (flush_event_store runtime/events)
  state)

(fn edit_distance [a : Str, b : Str]
  (let left ($graphemes a))
  (let right ($graphemes b))
  (var previous [0])
  (var j 1)
  (while (<= j right/.size)
    (previous .push j)
    (set j (+ j 1)))
  (var i 1)
  (while (<= i left/.size)
    (let current [i])
    (set j 1)
    (while (<= j right/.size)
      (let before (- j 1))
      (let row_before (- i 1))
      (let cost (if (== left/%row_before right/%before) 0 1))
      (current .push
        ($math/min (+ previous/%j 1) ($math/min (+ current/%before 1) (+ previous/%before cost))))
      (set j (+ j 1)))
    (set previous current)
    (set i (+ i 1)))
  (let last right/.size)
  previous/%last)

(fn parse_submission [h, text : Str]
  (if ($str/starts_with? text "//")
    (return {^kind "prompt" ^text ($str/slice_bytes text 1 (- ($str/byte_size text) 1))}))
  (if_not ($str/starts_with? text "/") (return {^kind "prompt" ^text text}))
  (let parts ($str/split text " "))
  (let token parts/0)
  (let name ($str/slice_bytes token 1 (- ($str/byte_size token) 1)))
  (let selected (row h "commands" name))
  (if ($absent? selected)
    (then
      (var closest "help")
      (var distance 1000000)
      (for command in (rows h "commands")
        (let score (edit_distance name command/name))
        (if_yes (< score distance)
          (set closest command/name)
          (set distance score)))
      (fail
        (CommandError ^code "unknown_command" ^message $"unknown command /${name}; try /${closest}"))))
  (let offset (+ ($str/byte_size token) 1))
  (let raw
    (if (>= offset ($str/byte_size text))
      ""
      ($str/slice_bytes text offset (- ($str/byte_size text) offset))))
  {^kind "command" ^name name ^raw raw ^input_text text ^handler selected/run})

(fn help_command [ctx]
  (let name ($str/trim ctx/raw))
  (if (!= name "")
    (then
      (let command (row ctx/runtime/h "commands" name))
      (if ($absent? command)
        (fail (CommandError ^code "unknown_command" ^message $"unknown command /${name}")))
      (return
        (CommandResult ^display ($to_str command/usage "\n" command/doc)))))
  (let lines [])
  (for command in (rows ctx/runtime/h "commands")
    (lines .push $"${command/usage} — ${command/doc}"))
  (CommandResult ^display ($str/join lines "\n")))

(fn run_command [ctx]
  (let forms ($into ($parse/read_all ^source ctx/id ^^locs ctx/raw) []))
  (let bindings
    (workspace_bindings ctx/runtime/h ctx/snapshot ctx/session ctx/runtime/root))
  (let turn (operator_turn ctx))
  (let environment (env ^bindings (operator_bindings bindings ctx/runtime/root turn ctx/snapshot)))
  (let context (operator_context ctx turn))
  (let rewritten (operator_forms forms))
  (let scope (operator_scope ctx context))
  (let completed ($cell false))
  (let value (try
    (let evaluated ($runtime/with_context scope/context (fn []
      (evaluate_response `(scope %rewritten...) environment))))
    (turn/state .set "closed")
    (close_execution_scope scope)
    (if ($absent? ctx/runtime/h/workspace)
      (for change in (take_composition_changes ^origin turn ctx/runtime/h/snapshots) (change/apply))
      (drain_workspace_changes ^origin turn ctx/runtime/workspace ctx/runtime/h))
    (completed .set true)
    evaluated
    ensure
      (turn/state .set "closed")
      (if_not completed/.get (discard_composition_changes ctx/runtime/h/snapshots turn))
      (close_execution_scope scope)))
  # Keep an evaluated nil distinct from an omitted display value.
  (CommandResult ^display (operator_result turn (if ($nil? value) "nil" value)) ^!attached ^status "done"))

(fn view_command [ctx]
  (let specification ($str/trim ctx/raw))
  (let pieces ($str/split specification ":"))
  (var relative specification)
  (var first 1)
  (var last 400)
  (if_yes (&& (> pieces/.size 1) (! ($fs/exists? ($path/join ctx/runtime/root specification))))
    (let suffix ($last pieces))
    (if_not ($absent? (#"^[0-9]+(-[0-9]+)?$" .match suffix))
      (let range ($str/split suffix "-"))
      (set first ($parse/parse_int range/0))
      (set last (if (> range/.size 1) ($parse/parse_int range/1) (+ first 399)))
      (set relative
        ($str/slice_bytes
          specification
          0
          (- ($str/byte_size specification) (+ ($str/byte_size suffix) 1))))))
  (if (|| ($str/starts_with? relative "/") (($str/split relative "/") .contains? ".."))
    (fail (CommandError ^code "invalid_path" ^message "view needs a workspace-relative path")))
  (let path ($path/join ctx/runtime/root relative))
  (let info ($fs/info path))
  (if (== info/kind "directory")
    (return
      (CommandResult ^display ($fs/list_dir path) ^^attached ^view {^path relative ^kind "directory"})))
  (if (|| (< first 1) (< last first))
    (fail (CommandError ^code "invalid_range" ^message "invalid line range")))
  (set last ($math/min last (+ first 399)))
  (let page ($fs/read_text_page ^from first ^lines (+ (- last first) 1) path))
  (if page/binary
    (return
      (CommandResult ^display $"${relative}: ${info/size} bytes, binary" ^^attached ^view {^path relative ^kind "binary" ^bytes info/size})))
  (let text
    (if page/truncated
      ($to_str
        page/text
        """
[page truncated at byte limit]""")
      page/text))
  (CommandResult ^display text ^^attached ^view {^path relative ^kind (if ($str/ends_with? relative ".gene")
    (then "gene")
    (elif ($str/ends_with? relative ".md") "markdown")
    (else "text")) ^from first ^to page/to ^next page/next ^truncated page/truncated}))

(fn shared_command_rows []
  [
    {^name "help" ^usage "/help [command]"
     ^doc "List commands or show a command's usage." ^run help_command ^^raw_input}
    {^name "run" ^usage "/run <Gene code>"
     ^doc "Evaluate Gene with plugin functions and the standard library."
     ^run run_command ^^raw_input}
    {^name "view" ^usage "/view <path>[:from-to]"
     ^doc "View a file or directory, up to 400 lines."
     ^run view_command ^^raw_input}])

(fn install_theme_command [runtime]
  (let definitions
    [
      [
        "theme"
        "/theme [light|dark]"
        "Show or switch the web UI theme for this workspace."
        (fn [ctx]
          (let requested ($str/trim ctx/raw))
          (if (== requested "")
            (return (CommandResult ^display $"Theme: ${(appearance_mode ctx/runtime)}." ^!attached)))
          (if_not (theme_modes .contains? requested)
            (return (CommandResult ^display "Use /theme light or /theme dark." ^!attached)))
          (CommandResult ^display $"Theme set to ${(set_appearance ctx/runtime requested)}." ^!attached))]])
  (for entry in definitions
    (if ($absent? (row runtime/h "commands" entry/0))
      (contribute
        runtime/h
        "core"
        "commands"
        {^name entry/0 ^usage entry/1 ^doc entry/2 ^run entry/3 ^^raw_input}))))

(fn command_session_busy? [manager, session : Str]
  (for [key task] in manager/active/.get
    (if ($str/starts_with? ($to_str key) $"${session}:") (return true)))
  (let mode (manager/modes/states/.get .get session))
  (if_not ($absent? mode/running) (return true))
  # Admission saves its receipt before installing the task. Read the durable
  # projection too, without acquiring the command gate under a session gate.
  (let ref (core_state manager/runtime/events "session" session "commands"))
  (if_not ($absent? ref/digest)
    (for command in (/records ($serde/read_data (read_body manager/runtime ref/digest)))
      (if (&& (== command/status "running") (== command/runtime_epoch manager/runtime/epoch))
        (return true))))
  false)

(fn new_command_manager [runtime]
  (install_theme_command runtime)
  (let manager (CommandManager ^runtime runtime ^active ($cell {}) ^watchers ($cell {}) ^gate ($sync/gate) ^accepting ($cell true) ^closed ($cell false)))
  (set manager/modes (new_input_modes runtime
    (fn [session parsed]
      (with_body_use runtime (fn [] (submit_routed_command manager session parsed))))
    (fn [session id] (cancel_command manager session id))
    (fn [session] (/records (command_state runtime session)))))
  (set runtime/sessions/unload_policy
    {^busy? (fn [session] (command_session_busy? manager session))
     ^on_unload (fn [session reason] (close_mode_locked manager/modes session reason))})
  manager)

(fn command_changed [manager, session : Str, record]
  (publish manager/runtime/h (CommandChanged ^session session ^record record))
  nil)

(fn update_command [manager, session : Str, record]
  (manager/gate (fn []
    (let state (read_command_state manager/runtime session))
    (let records [])
    (var found false)
    (for previous in state/records
      (if (== previous/id record/id)
        (then
          (records .push record)
          (set found true))
        (else
          (records .push previous))))
    (if_not found (records .push record))
    (let retained [])
    (var excess ($math/max 0 (- records/.size 128)))
    (for candidate in records
      (if (&& (> excess 0) (!= candidate/status "running"))
        (then (set excess (- excess 1)))
        (else (retained .push candidate))))
    (state .put "records" retained)
    (save_command_state manager/runtime session state)))
  record)

(fn append_command_output [manager, session : Str, record, text : Str]
  (let original (?? record/output ""))
  (let remaining (- 1048576 ($str/byte_size original)))
  (if (> remaining 0) (record .put "output" ($to_str original (byte_prefix text remaining))))
  (command_changed
    manager
    session
    {^id record/id ^name record/name ^status "running" ^text text ^output record/output
     ^mode_instance (?? record/mode_instance nil)
     ^ui_action (== record/ui_action true)})
  nil)

(fn finish_command [manager, session : Str, record, lease, outcome]
  (try
  (match outcome ^!exhaustive
      (when (TaskOutcome/ok value)
        (var result (if (== ($head value) CommandResult) value (CommandResult ^display value)))
        (if_not ($absent? result/mode)
          (try
            (enter_mode manager/modes session result/mode lease/snapshot)
          catch Any
            (set result (CommandResult ^status "failed" ^display $err/message))
            (record .put "error_code" (?? $err/code "mode_closed"))))
        (let text
          (if ($absent? result/display)
            (then "")
            (elif (== ($head result/display) Str) result/display)
            (else ($to_str result/display))))
        (let id $"${record/id}.${record/name}")
        (let pointer (if (== record/name "view") $"user viewed ${record/raw}" text))
        (let exit_label (if ($absent? result/exit) "" $" (exit ${result/exit})"))
        (let header $"[${id}] /${record/name} ${record/raw}${exit_label}")
        (let bounded
          (bounded_request manager/runtime session [{^id id ^header header ^value pointer}]))
        (record .put "status" (?? result/status "done"))
        (record .put "display" (if (== record/name "view")
          (then text)
          (elif (&& (== record/name "repl") ($present? record/mode_instance)) bounded/items/0/value)
          (else bounded/full)))
        (record .put "attached" (== result/attached true))
        (record .put "item" bounded/items/0)
        (let properties ($props result))
        (for key in ["exit" "view" "selected" "stop"]
          (let field (properties .get key))
          (if_not ($absent? field) (record .put key field))))
      (when (TaskOutcome/error error)
        (record .put "status" "failed")
        (if_not ($absent? error/code) (record .put "error_code" error/code))
        (let location (?? error/line "?"))
        (record .put "display" (if (== record/ui_action true)
          error/message $"line ${location}: ${error/message}")))
      (when (TaskOutcome/panic message)
        (record .put "status" "failed")
        (record .put "display" message))
      (when TaskOutcome/cancelled
        (record .put "status" "cancelled")
        (record .put
          "display"
          ($to_str
            "["
            record/id
            "."
            record/name
            "] /"
            record/name
            " "
            record/raw
            """
Stopped."""))))
    (if_yes (&& (== record/ui_action true) (== record/status "failed"))
      (let diagnostic $"UI action ${record/name} (${record/id}, view ${record/ui_request/component}, revision ${record/ui_request/revision}) failed: ${record/display}")
      (let bounded (bounded_request manager/runtime session
        [{^id record/id ^header $"[${record/id}.ui-error]" ^value diagnostic}]))
      (record .put "attached" true)
      (record .put "item" bounded/items/0))
    (let output (?? record/output ""))
    (if (!= output "")
      (then
        (record .put "output_ref" (write_body manager/runtime output))
        (record .put "output" (byte_prefix output 16384))))
    (record .put "finished" ($to_str ($now)))
    (update_command manager session record)
    (if (== record/attached true)
      (then
        (manager/gate (fn []
          (let state (read_command_state manager/runtime session))
          (state/attached .push record/item)
          (save_command_state manager/runtime session state)))))
  ensure
    (manager/active
      .get
      ; .delete $"${session}:${record/id}")
    (release_snapshot manager/runtime/h/snapshots lease))
  (command_changed manager session record)
  record)

(fn submit_command [manager, session : Str, text : Str, ^request_id request_id : Str = "", ^sequence sequence = nil,
                     ^expected expected = nil, ^on_admit on_admit = nil, ^on_finish on_finish = nil]
  (with_body_use manager/runtime
    (fn [] (submit_command_impl ^request_id request_id ^sequence sequence ^expected expected ^on_admit on_admit ^on_finish on_finish
      manager session text))))

(fn submit_command_impl [manager, session : Str, text : Str, ^request_id request_id : Str = "", ^sequence sequence = nil,
                         ^expected expected = nil, ^on_admit on_admit = nil, ^on_finish on_finish = nil]
  (let digest ($crypto/sha256 text))
  (if_not ($absent? expected)
    (if (|| (!= ($head expected) Map) (== request_id ""))
      (fail (CommandError ^code "invalid_request" ^message "A revision-bound command needs an identity and request id.")))
    (for key in ["name" "owner" "revision"]
      (let value (expected .get key))
      (if (|| (!= ($head value) Str) (== value "") (> ($str/byte_size value) 256))
        (fail (CommandError ^code "invalid_request" ^message "Invalid expected command identity.")))))
  (if_yes (!= request_id "")
    (if (|| (> ($str/byte_size request_id) 256) (!= ($head sequence) Int) (< sequence 1))
      (fail (CommandError ^code "invalid_request" ^message "A command request id requires a positive submission sequence.")))
    (let old (command_request_receipt manager session request_id))
    (if_not ($absent? old)
      (if (&& (== old/request_digest digest) (== old/request_seq sequence)
              (same_command_identity? old/expected_command expected)) (return old))
      (fail (CommandError ^code "submission_conflict" ^message "Command request identity has different content."))))
  # Defer revision-bound resolution until after duplicate detection under the
  # admission gate. The same lease selects the handler and owns its execution.
  (let lease (if ($absent? expected) nil (acquire_snapshot manager/runtime/h/snapshots)))
  (let parsed (if ($absent? expected) (parse_submission manager/runtime/h text)
    {^kind "command" ^name expected/name ^input_text text ^expected_command expected}))
  # on_admit runs only for a new admission; on_finish runs when its task ends.
  (if_not ($absent? on_admit) (parsed .put "on_admit" on_admit))
  (if_not ($absent? on_finish) (parsed .put "on_finish" on_finish))
  (if_yes (!= request_id "")
    (parsed .put "request_id" request_id)
    (parsed .put "request_seq" sequence)
    (parsed .put "request_digest" digest))
  (try
    (submit_routed_command ^lease lease manager session parsed)
  ensure
    (if (&& ($present? lease) (!= parsed/lease_transferred true))
      (release_snapshot manager/runtime/h/snapshots lease))))

(fn submit_routed_command [manager, session : Str, parsed, ^lease supplied_lease = nil]
  (if (! manager/accepting/.get)
    (fail (CommandError ^code "stopped" ^message "workspace is stopping")))
  (if_not (== parsed/kind "command")
    (fail (CommandError ^code "invalid_request" ^message "expected a command")))
  (load_session manager/runtime/sessions session)
  (var duplicate false)
  (let record
    (manager/gate (fn []
      (require_record manager/runtime/sessions session)
      (let state (read_command_state manager/runtime session))
      (if_not ($absent? parsed/request_id)
        (for previous in state/records
          (if_yes (== previous/request_id parsed/request_id)
            (if_yes (&& (== previous/request_digest parsed/request_digest)
                    (== previous/request_seq parsed/request_seq)
                    (same_command_identity? previous/expected_command parsed/expected_command))
              (set duplicate true)
              (return previous))
            (fail (CommandError ^code "submission_conflict" ^message "Command request identity has different content."))))
        (if (!= parsed/request_seq state/next_id)
          (fail (CommandError ^code "submission_conflict" ^message "Unexpected command sequence; refresh or look up the previous receipt."))))
      (if_not ($absent? parsed/expected_command)
        (let expected parsed/expected_command)
        (let contribution (ui_record supplied_lease/snapshot "commands" expected/name))
        (if (|| ($absent? contribution)
                (! (same_command_identity? expected (command_identity manager/runtime/h contribution))))
          (fail (CommandError ^code "revision_conflict" ^message "This command was replaced or disabled. Refresh and select it again.")))
        (let resolved ($runtime/with_context
          {^composition manager/runtime/h/snapshots ^snapshot supplied_lease/snapshot}
          (fn [] (parse_submission manager/runtime/h parsed/input_text))))
        (if (!= resolved/name expected/name)
          (fail (CommandError ^code "invalid_request" ^message "Command text does not match its expected identity.")))
        (for key in ["raw" "handler"] (parsed .put key (resolved .get key)))
        (parsed .put "admitted_command" (command_identity manager/runtime/h contribution)))
      (let id $"c${state/next_id}")
      (state .put "next_id" (+ state/next_id 1))
      (let allocated
        {
          ^id id
          ^runtime_epoch manager/runtime/epoch
          ^name parsed/name
          ^raw parsed/raw
          ^status "running"
          ^!attached
          ^output ""
          ^started_ms ($os/wall_ms)
          ^start_seq (next_sequence manager/runtime/events (stream_key "session" session))})
      (for key in ["input_text" "mode_instance" "input_id" "ui_action" "ui_request" "ui_action_id" "request_id" "request_seq" "request_digest" "expected_command" "admitted_command"]
        (let value (parsed .get key))
        (if_not ($absent? value) (allocated .put key value)))
      (state/records .push allocated)
      (save_command_state manager/runtime session state)
      allocated)))
  (if duplicate (return record))
  (if_not ($absent? parsed/on_admit) (parsed/on_admit record))
  # A setup failure before the watcher exists still runs on_finish, so a
  # caller's registration (such as a card command's) is always released.
  (var watched false)
  (var lease nil)
  (try
    (set lease (if ($absent? supplied_lease) (acquire_snapshot manager/runtime/h/snapshots) supplied_lease))
    (let sink (fn [output] (append_command_output manager session record output)))
    (let ctx
      (CommandContext ^manager manager ^runtime manager/runtime ^session session ^raw parsed/raw ^id record/id ^output sink ^snapshot lease/snapshot))
    (let config ($serde/read_data ($fs/read_text $"${manager/runtime/state_root}/config.gene")))
    (let budget (?? config/response_budget {^timeout_ms 600000 ^max_memory_mb 1024}))
    (let timeout (?? budget/timeout_ms 600000))
    (let invoke
      ($runtime/bind_call ^policy {^timeout_ms timeout ^max_memory_mb (?? budget/max_memory_mb 1024)}
        parsed/handler
        [ctx]))
    (let task
      (spawn ^lane root ($runtime/with_context {^session session ^composition manager/runtime/h/snapshots ^snapshot lease/snapshot ^output sink ^command record/id}
        (fn [] (with_command_scope manager/runtime ctx (fn [] (scope (invoke))))))))
    (acquire_body_use manager/runtime)
    (manager/active
      .get
      ; .put $"${session}:${record/id}" task)
    (let deadline (spawn ^lane root (do ($sleep timeout) task/.cancel)))
    (let watcher
      (spawn ^lane root
        (try
          (let outcome (try task/.join ensure deadline/.cancel deadline/.join))
          (try (finish_command manager session record lease outcome)
            ensure
              (mode_command_finished manager/modes session record)
              (if_not ($absent? parsed/on_finish) (try (parsed/on_finish) catch Any nil)))
        ensure (release_body_use manager/runtime))))
    (set watched true)
    (parsed .put "lease_transferred" true)
    (manager/watchers
      .get
      ; .put $"${session}:${record/id}" watcher)
    (command_changed manager session record)
    record
  ensure
    (if_yes (! watched)
      # The watcher owns the lease once it exists; before that, release it here.
      (if (&& ($absent? supplied_lease) ($present? lease))
        (release_snapshot manager/runtime/h/snapshots lease))
      (if_not ($absent? parsed/on_finish)
        (try (parsed/on_finish) catch Any nil)))))

(fn command_receipt [manager, session : Str, id : Str]
  (let state (command_state manager/runtime session))
  (for record in state/records
    (if (== record/id id) (return record)))
  nil)

(fn command_request_receipt [manager, session : Str, request_id : Str]
  (let state (command_state manager/runtime session))
  (for record in state/records
    (if (== record/request_id request_id) (return record)))
  nil)

(fn cancel_command [manager, session : Str, id : Str]
  (let receipt (command_receipt manager session id))
  (if ($absent? receipt) (fail (CommandError ^code "not_found" ^message "command not found")))
  (let task (manager/active/.get .get $"${session}:${id}"))
  (if_not ($absent? task) task/.cancel)
  receipt)

(fn take_command_attachments [runtime, session : Str]
  (let manager runtime/services/values/commands)
  (manager/gate (fn []
    (let state (read_command_state runtime session))
    (let items state/attached)
    (state .put "attached" [])
    (save_command_state runtime session state)
    items)))

(fn quiesce_command_manager [manager]
  (manager/accepting .set false)
  (if_not ($absent? manager/modes) (close_input_modes manager/modes))
  (for [id task] in manager/active/.get
    task/.cancel)
  (for [id watcher] in manager/watchers/.get
    watcher/.join)
  nil)

(fn close_command_manager [manager]
  (if (manager/closed .swap true) (return nil))
  (try (quiesce_command_manager manager)
    ensure (set manager/runtime/sessions/unload_policy nil)))
