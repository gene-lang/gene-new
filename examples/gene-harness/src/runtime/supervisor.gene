(mod supervisor)
(import ^from "../cli/options" [parse_options])

(fn main [args]
  (let parsed (parse_options args))
  (let hosting (== parsed/command "web"))
  (let root ($path/parent ($path/parent this_mod/.path)))
  (var restart_port nil)
  (loop
    (let child_args ["run" ($path/join root "main.gene")])
    (for arg in args
      (child_args .push ($to_str arg)))
    (if hosting (child_args .push "--supervised"))
    (if_not ($absent? restart_port)
      (child_args .push "--restart-port")
      (child_args .push ($to_str restart_port)))
    (let task
      ($os/exec_stdio_async (?? ($os/env? "GENE_BINARY") ($os/executable_path)) child_args...))
    (let status (await task))
    (if (|| (! hosting) (!= status 75)) (return status))
    (let workspace ($fs/real_path (?? parsed/options/workspace ($os/launch_dir))))
    (let notice ($serde/read_data ($fs/read_text $"${workspace}/.gene-harness/restart_notice")))
    (set restart_port notice/port)
    (if (|| (!= ($head restart_port) Int) (< restart_port 1024) (> restart_port 65535))
      (fail "Restart handoff did not retain a valid listening port.")))
  0)
