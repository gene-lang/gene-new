(mod supervisor)
(import ^from "../cli/options" [parse_options])
(import ^from "../public/text" [byte_suffix])
(import ^from "./workspace_settings" [initialize_manager_workspace])
(import ^from "./workspace_lock" [try_lock_wait])
(import ^from "./host_log" [open_host_log write_host_log close_host_log])

(fn child_entry [source_root : Str, hosting : Bool, offline : Bool, scripted : Bool, recovery : Bool,
  ^source_only source_only : Bool = false]
  (if (&& hosting (! offline) (! scripted) (! recovery) (! source_only))
    (then ["run" "--package-root" source_root "harness"])
    (else ["run" "--snapshot" ($path/join source_root "src" "main.gene")])))

(fn main [args]
  (let parsed (parse_options args))
  (let hosting (&& (["web" "manager"] .contains? parsed/command) (!= parsed/options/help true)))
  (let application ($pkg/application))
  (let root ($path/join application/source_root "src"))
  # Capturing the child's diagnostics hides our terminal from it. Forward the
  # actual output destination, including false when our stdout is redirected.
  (let child_environment
    {^GENE_HARNESS_STDOUT_TTY (if ($os/stdout_tty?) "1" "0")})
  (var restart_port nil)
  (var recovery (== parsed/options/recovery true))
  (var source_only false)
  (var workspace (?? parsed/options/workspace ($os/launch_dir)))
  (if (&& hosting (== parsed/command "manager"))
    (set workspace (initialize_manager_workspace ^root parsed/options/root)))
  (if_yes hosting
    ($fs/make_dir workspace)
    (set workspace ($fs/real_path workspace)))
  (var launch_lock nil)
  (var logger nil)
  (if_yes hosting
    ($fs/make_dir $"${workspace}/.gene-harness")
    (set launch_lock (try_lock_wait $"${workspace}/.gene-harness/launcher_lock" 250))
    (if ($absent? launch_lock) (fail "A launcher is already running for this workspace."))
    (if (== parsed/options/managed true) (set logger (open_host_log workspace))))
  (fn emit [line : Str]
    (if ($absent? logger)
      (do ($println line) ($io/flush_stdout))
      (write_host_log logger ($to_str line "\n"))))
  (try
  (loop
    (let startup_id ($crypto/random_hex 16))
    (child_environment .put "GENE_HARNESS_ENTRY_MARKER"
      $"${workspace}/.gene-harness/startup/${startup_id}.entered")
    # Native resources enable optional provider features. A build failure must
    # not prevent the ordinary host from using CLI or HTTP providers.
    (let child_args (child_entry ^source_only source_only application/source_root hosting
      (|| (== parsed/options/offline true) (== ($os/env? "GENE_HARNESS_OFFLINE") "1"))
      ($present? parsed/options/script) recovery))
    (let packaged (== child_args/1 "--package-root"))
    (for arg in args
      (if (!= ($to_str arg) "--recovery") (child_args .push ($to_str arg))))
    (if_yes hosting
      (child_args .push "--supervised")
      (child_args .push "--startup-id") (child_args .push startup_id)
      (if recovery (child_args .push "--recovery")))
    (if_not ($absent? restart_port)
      (child_args .push "--restart-port")
      (child_args .push ($to_str restart_port)))
    (let lines ($channel ^capacity 128))
    (let tail ($cell ""))
    (let task ($os/exec_stream_async ^env child_environment
      (?? ($os/env? "GENE_BINARY") ($os/executable_path))
      child_args... ^^merge_stderr ^stdout_chan lines ^max_bytes 65536))
    (let printer (spawn ^lane root (try
      (loop (let line lines/.recv)
        (emit line)
        (tail .set (byte_suffix ($to_str tail/.get line "\n") 16384)))
      catch ChannelClosed nil)))
    (let result (try (await task) ensure (if_not task/.done? task/.cancel task/.join)))
    printer/.join
    (let status result/status)
    (if_not hosting (return status))
    (let marker $"${workspace}/.gene-harness/startup/${startup_id}")
    (let ready ($fs/exists? marker))
    (if ready ($fs/remove marker))
    (let entered_marker ($to_str marker ".entered"))
    (let entered ($fs/exists? entered_marker))
    (if entered ($fs/remove entered_marker))
    (let restart $"${workspace}/.gene-harness/restart_notice")
    (if_yes (&& entered (== status 75) ($fs/exists? restart))
      (let notice ($serde/read_data ($fs/read_text restart)))
      (set restart_port notice/port)
      (set source_only false)
      (if (== notice/normal true) (set recovery false))
      (if (|| (!= ($head restart_port) Int) (< restart_port 1024) (> restart_port 65535))
        (fail "Restart handoff did not retain a valid listening port."))
      (continue))
    (if (|| recovery ready ([130 143 -2 -15] .contains? status)) (return status))
    (if (&& packaged (! entered))
      (then
        (emit "Packaged startup failed before main. Starting the normal source host; optional native features may be unavailable.")
        (set source_only true)
        (continue)))
    ($fs/make_dir $"${workspace}/.gene-harness")
    ($fs/write_text_atomic ^^owner_only $"${workspace}/.gene-harness/startup_failure"
      ($to_str "Normal startup exited before readiness (status " status ").\n" tail/.get))
    (emit "Normal startup failed. Starting the plugin recovery interface.")
    (set recovery true))
  0
  ensure
    (if_not ($absent? logger) (close_host_log logger))
    (if_not ($absent? launch_lock) launch_lock/.close)))
