# The built-in setting definitions as plain data. Startup consumers that run before
# the settings registry exists read these, and the registry later installs the same
# rows, so the screen and execution agree on every default.
(mod setting_definitions)
(import [ServiceError] ^from "../plugin_api")

(const portable_efforts ["auto" "none" "minimal" "low" "medium" "high" "xhigh" "max"])

# Keys the model-selection resolver owns. The generic resolver passes their stored
# values through untouched and never injects their defaults.
(const model_setting_keys ["provider" "model" "effort"])

# Portable levels always pass; a native level such as ultra passes here and is then
# checked against the selected model's advertised efforts by the efforts choices.
(fn check_effort [value]
  (if (|| (portable_efforts .contains? value) ($present? (#"^[a-z][a-z0-9_]{0,31}$" .match value)))
    (return value))
  (let levels ($str/join portable_efforts ", "))
  (fail (ServiceError ^code "invalid_request"
    ^message $"Effort must be one of ${levels}, or a level the model advertises.")))

# {^engine "jev" ^model "jev-1.14.0" ^uses {^"round/check_in" {^engine "model" ^preset "fast"}}}
(fn check_decisions [value]
  (if ($absent? value) (return value))
  (fn require_entry [entry, label : Str]
    (if (!= ($head entry) Map)
      (fail (ServiceError ^code "invalid_request" ^message $"${label} must be a map.")))
    (if (&& ($present? entry/engine) (|| (!= ($head entry/engine) Str) (== ($str/trim entry/engine) "")))
      (fail (ServiceError ^code "invalid_request" ^message $"${label} names its ^engine as a non-empty string."))))
  (require_entry value "The decisions setting")
  (if_not ($absent? value/uses)
    (if (!= ($head value/uses) Map)
      (fail (ServiceError ^code "invalid_request" ^message "Decision ^uses is a map from use id to an engine entry.")))
    (map_for [use entry] in value/uses
      (require_entry entry $"The ${use} entry")
      (if ($absent? entry/engine)
        (fail (ServiceError ^code "invalid_request" ^message $"The ${use} entry needs an ^engine.")))))
  value)

(fn core_setting_definitions []
  (let group "General")
  (let shared ["workspace" "shared"])
  [{^key "provider" ^label "Provider" ^group "Models" ^type "str" ^default "" ^applies "next_round"
    ^doc "Provider for this workspace. Empty follows the selection order."}
   {^key "model" ^label "Model" ^group "Models" ^type "str" ^default "" ^applies "next_round" ^choices "models"
    ^doc "Model for this workspace. Empty follows the selection order."}
   {^key "effort" ^label "Effort" ^group "Models" ^type "str" ^default "auto" ^applies "next_round" ^choices "efforts"
    ^validate check_effort
    ^doc "Requested effort: auto, none, minimal, low, medium, high, xhigh, max, or a native level the model advertises."}
   {^key "context_window" ^label "Context window" ^group "Models" ^type "int" ^default nil ^min 1 ^applies "next_round"
    ^doc "Optional cap on the selected model's window in tokens."}
   {^key "provider_timeout_ms" ^label "Provider timeout" ^group group ^type "int" ^default 600000 ^min 1 ^applies "next_round"
    ^doc "Timeout per provider attempt in milliseconds."}
   {^key "response_budget" ^label "Response budget" ^group group ^type "map"
    ^default {^timeout_ms 600000 ^max_memory_mb 1024} ^applies "next_round"
    ^doc "Runaway limit for each response evaluation and command. Plugin admission limits take it at startup."}
   {^key "turn_limit" ^label "Turn limit" ^group group ^type "int" ^default 24 ^min 1 ^applies "next_round" ^scopes shared
    ^doc "Turns per operator round. Reaching it pauses for continuation. With check-ins, it counts from the last answered check-in."}
   {^key "check_ins" ^label "Progress check-ins" ^group group ^type "bool" ^default true ^applies "next_round" ^scopes shared
    ^doc "When a decision engine is available, ask it every check_in_turns turns whether an operator round should continue or pause for you."}
   {^key "check_in_turns" ^label "Check-in interval" ^group group ^type "int" ^default 10 ^min 1 ^applies "next_round" ^scopes shared
    ^doc "Task turns between progress check-ins."}
   {^key "decisions" ^label "Decision engines" ^group "Decisions" ^type "map" ^default nil ^applies "next_round"
    ^validate check_decisions
    ^doc "Quick-decision engine selection: ^engine with its settings, such as ^model or ^preset, and per-use entries under ^uses."}
   {^key "trigger_turn_limit" ^label "Trigger turn limit" ^group "Triggers" ^type "int" ^default 12 ^min 1 ^applies "next_round" ^scopes shared
    ^doc "Turns per trigger round."}
   {^key "trigger_timeout_ms" ^label "Trigger timeout" ^group "Triggers" ^type "int" ^default 300000 ^min 1 ^applies "next_round" ^scopes shared
    ^doc "Running time per trigger round in milliseconds."}
   {^key "trigger_concurrency" ^label "Trigger concurrency" ^group "Triggers" ^type "int" ^default 2 ^min 1 ^applies "restart"
    ^doc "Unfinished trigger rounds across the workspace."}
   {^key "question_timeout_ms" ^label "Question timeout" ^group "Triggers" ^type "int" ^default 86400000 ^min 1 ^applies "next_round" ^scopes shared
    ^doc "Deadline for a trigger round's question batch in milliseconds."}
   {^key "trigger_occurrence_keep" ^label "Occurrences kept" ^group "Triggers" ^type "int" ^default 256 ^min 1 ^applies "restart"
    ^doc "Recent terminal occurrences kept per trigger."}
   {^key "idle_timeout_ms" ^label "Idle timeout" ^group group ^type "int" ^default 600000 ^min 1 ^applies "restart"
    ^doc "How long an idle session stays loaded, in milliseconds."}
   {^key "body_gc_interval_ms" ^label "Blob collection interval" ^group group ^type "int" ^default 60000 ^min 1 ^applies "restart"
    ^doc "Interval for idle collection of unreferenced blobs in milliseconds."}
   {^key "computer" ^label "Computer driver" ^group "Computer" ^type "map" ^default nil ^applies "restart"
    ^doc "Optional driver command and socket for computer use."}
   {^key "voice" ^label "Voice" ^group "Voice" ^type "map" ^default nil ^applies "next_round" ^choices "voices"
    ^doc "Speech engine settings: recognizer, synthesizer, voice, language and rate."}
   {^key "image" ^label "Images" ^group "Images" ^type "map" ^default nil ^applies "next_round"
    ^doc "Default image generator and generation model."}
   {^key "keyboard_bindings" ^label "Keyboard shortcuts" ^group "Keyboard Shortcuts" ^type "map" ^default {} ^applies "immediate"
    ^doc "Overrides by keyboard action id. An empty chord clears a binding."}
   {^key "delegation" ^label "Delegation" ^group "Delegation" ^type "map" ^default nil ^applies "next_round"
    ^doc "Limits on delegated child sessions."}])

(fn definition_scopes [definition]
  (?? definition/scopes ["workspace"]))

(fn supports_scope? [definition, scope : Str] : Bool
  ((definition_scopes definition) .contains? scope))
