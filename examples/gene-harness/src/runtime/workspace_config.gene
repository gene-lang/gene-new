# The single writer of a workspace's config.gene, and the host-owned definitions of
# what it holds. Readers elsewhere keep reading the file directly, which is why most
# settings apply from the next read. Plugins add settings through the `settings`
# registry, and each definition says when a change applies.
(mod workspace_config)
(import [ServiceError] ^from "../plugin_api")
(import [contribute rows row] ^from "../kernel")

(let config_gate ($sync/gate))

(fn config_path [runtime] : Str
  $"${runtime/state_root}/config.gene")

(fn read_config [runtime]
  ($serde/read_data ($fs/read_text (config_path runtime))))

(fn config_digest [config] : Str
  ($pkg/canonical_digest config))

(fn check_setting_value [definition, value]
  (let expected definition/type)
  (let actual ($head value))
  (let matches
    (match expected
      (when "int" (== actual Int))
      (when "str" (== actual Str))
      (when "bool" (== actual Bool))
      (when "map" (== actual Map))
      (else true)))
  (if_not matches
    (fail (ServiceError ^code "invalid_request"
      ^message $"Setting ${definition/key} must be a ${expected}.")))
  (if (&& (== expected "int") ($present? definition/min) (< value definition/min))
    (fail (ServiceError ^code "invalid_request"
      ^message $"Setting ${definition/key} must be at least ${definition/min}.")))
  (if ($present? definition/validate)
    (definition/validate value))
  value)

(fn require_definition [runtime, key : Str]
  (let definition (row runtime/h "settings" key))
  (if ($absent? definition)
    (fail (ServiceError ^code "not_found" ^message $"Unknown setting ${key}.")))
  definition)

# A launch flag overrides the saved value for this process only.
(fn launch_override [runtime, key : Str]
  (let launch runtime/launch)
  (if ($absent? launch) (return nil))
  (if (["provider" "model" "effort"] .contains? key)
    (launch .get key)
    nil))

(fn setting_view [runtime, config, definition]
  (let key definition/key)
  (let stored (config .get key))
  (let override (launch_override runtime key))
  (let effective
    (if ($present? override)
      (then override)
      (elif ($present? stored) stored)
      (else definition/default)))
  {^key key ^label definition/label ^doc definition/doc ^group definition/group
   ^type definition/type ^applies definition/applies ^owner_scope "workspace"
   ^default definition/default ^stored stored ^override override ^value effective
   ^source (if ($present? override)
     (then "launch")
     (elif ($present? stored) "workspace")
     (else "default"))})

(fn list_settings [runtime, ^group group : Str = ""]
  (let config (read_config runtime))
  (let views [])
  (for definition in (rows runtime/h "settings")
    (if (|| (== group "") (== group definition/group))
      (views .push (setting_view runtime config definition))))
  {^settings views ^digest (config_digest config)})

(fn read_setting [runtime, key : Str]
  (setting_view runtime (read_config runtime) (require_definition runtime key)))

(fn write_config [runtime, change, expected : Str]
  (config_gate
    (fn []
      (let config (read_config runtime))
      (if (&& (!= expected "") (!= expected (config_digest config)))
        (fail (ServiceError ^code "revision_conflict"
          ^message "Workspace settings changed. Read them again before saving.")))
      (change config)
      ($fs/write_text_atomic (config_path runtime) ($serde/write_data config))
      (config_digest config))))

(fn set_setting [runtime, key : Str, value, ^expected expected : Str = ""]
  (let definition (require_definition runtime key))
  (check_setting_value definition value)
  (let digest (write_config runtime (fn [config] (config .put key value)) expected))
  (let view (read_setting runtime key))
  (view .put "digest" digest)
  view)

(fn reset_setting [runtime, key : Str, ^expected expected : Str = ""]
  (require_definition runtime key)
  (let digest (write_config runtime (fn [config] (config .delete key)) expected))
  (let view (read_setting runtime key))
  (view .put "digest" digest)
  view)

(fn core_setting_definitions []
  (let group "General")
  [{^key "provider" ^label "Provider" ^group "Models" ^type "str" ^default "" ^applies "next_round"
    ^doc "Provider for this workspace. Empty follows the selection order."}
   {^key "model" ^label "Model" ^group "Models" ^type "str" ^default "" ^applies "next_round"
    ^doc "Model for this workspace. Empty follows the selection order."}
   {^key "effort" ^label "Effort" ^group "Models" ^type "str" ^default "auto" ^applies "next_round"
    ^doc "Requested effort: auto, none, minimal, low, medium, high, xhigh or max."}
   {^key "context_window" ^label "Context window" ^group "Models" ^type "int" ^default nil ^min 1 ^applies "next_round"
    ^doc "Optional cap on the selected model's window in tokens."}
   {^key "provider_timeout_ms" ^label "Provider timeout" ^group group ^type "int" ^default 600000 ^min 1 ^applies "next_round"
    ^doc "Timeout per provider attempt in milliseconds."}
   {^key "response_budget" ^label "Response budget" ^group group ^type "map"
    ^default {^timeout_ms 600000 ^max_memory_mb 1024} ^applies "next_round"
    ^doc "Runaway limit for each response evaluation and command."}
   {^key "turn_limit" ^label "Turn limit" ^group group ^type "int" ^default 24 ^min 1 ^applies "next_round"
    ^doc "Turns per operator round. Reaching it pauses for continuation."}
   {^key "trigger_turn_limit" ^label "Trigger turn limit" ^group "Triggers" ^type "int" ^default 12 ^min 1 ^applies "next_round"
    ^doc "Turns per trigger round."}
   {^key "trigger_timeout_ms" ^label "Trigger timeout" ^group "Triggers" ^type "int" ^default 300000 ^min 1 ^applies "next_round"
    ^doc "Running time per trigger round in milliseconds."}
   {^key "trigger_concurrency" ^label "Trigger concurrency" ^group "Triggers" ^type "int" ^default 2 ^min 1 ^applies "restart"
    ^doc "Unfinished trigger rounds across the workspace."}
   {^key "question_timeout_ms" ^label "Question timeout" ^group "Triggers" ^type "int" ^default 86400000 ^min 1 ^applies "next_round"
    ^doc "Deadline for a trigger round's question batch in milliseconds."}
   {^key "trigger_occurrence_keep" ^label "Occurrences kept" ^group "Triggers" ^type "int" ^default 256 ^min 1 ^applies "restart"
    ^doc "Recent terminal occurrences kept per trigger."}
   {^key "idle_timeout_ms" ^label "Idle timeout" ^group group ^type "int" ^default 600000 ^min 1 ^applies "restart"
    ^doc "How long an idle session stays loaded, in milliseconds."}
   {^key "body_gc_interval_ms" ^label "Blob collection interval" ^group group ^type "int" ^default 60000 ^min 1 ^applies "restart"
    ^doc "Interval for idle collection of unreferenced blobs in milliseconds."}
   {^key "computer" ^label "Computer driver" ^group "Computer" ^type "map" ^default nil ^applies "restart"
    ^doc "Optional driver command and socket for computer use."}
   {^key "voice" ^label "Voice" ^group "Voice" ^type "map" ^default nil ^applies "next_round"
    ^doc "Speech engine settings."}
   {^key "image" ^label "Images" ^group "Images" ^type "map" ^default nil ^applies "next_round"
    ^doc "Default image generator and generation model."}
   {^key "keyboard_bindings" ^label "Keyboard shortcuts" ^group "Keyboard Shortcuts" ^type "map" ^default {} ^applies "next_round"
    ^doc "Overrides by keyboard action id. An empty chord clears a binding."}
   {^key "delegation" ^label "Delegation" ^group "Delegation" ^type "map" ^default nil ^applies "next_round"
    ^doc "Limits on delegated child sessions."}])

# Host-owned so a setting stays defined when the plugin that shows or uses it is disabled.
(fn install_setting_rows [runtime]
  (for definition in (core_setting_definitions)
    (if ($absent? (row runtime/h "settings" definition/key))
      (contribute runtime/h "core" "settings" definition)))
  nil)
