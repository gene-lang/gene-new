# The single writer of a workspace's config.gene and of the shared generic settings
# in <manager root>/.gene-harness/settings.gene. Definitions come from the host-owned
# `settings` registry; consumers read effective values through settings_resolver.
# Every write goes through one transaction per store: read under the gate, check the
# expected digest, validate every affected key, then write once.
(mod workspace_config)
(import [ServiceError HarnessEvent] ^from "../plugin_api")
(import [contribute rows row publish registry_row_records] ^from "../kernel")
(import [core_setting_definitions model_setting_keys definition_scopes supports_scope?] ^from "./setting_definitions")
(import [read_shared_settings write_shared_settings shared_settings_root] ^from "./shared_settings")
(import [setting_definitions layered_value bump_settings_revision active_settings settings_state] ^from "./settings_resolver")

# After a committed write or reset, and when another host's shared write is observed.
(type SettingsChanged : HarnessEvent ^props {^scope Str ^digest Str ^keys Any})

(let config_gate ($sync/gate))

(fn config_path [runtime] : Str
  $"${runtime/state_root}/config.gene")

(fn read_config [runtime]
  ($serde/read_data ($fs/read_text (config_path runtime))))

(fn config_digest [config] : Str
  ($pkg/canonical_digest config))

(fn invalid [message : Str]
  (fail (ServiceError ^code "invalid_request" ^message message)))

(fn error_text [error] : Str
  ($to_str (?? error/message error)))

(fn check_setting_value [definition, value]
  (let expected definition/type)
  (let actual ($head value))
  (let matches
    (match expected
      (when "int" (== actual Int))
      (when "str" (== actual Str))
      (when "bool" (== actual Bool))
      (when "map" (== actual Map))
      (else true)))
  (if_not matches (invalid $"Setting ${definition/key} must be a ${expected}."))
  (if (&& (== expected "int") ($present? definition/min) (< value definition/min))
    (invalid $"Setting ${definition/key} must be at least ${definition/min}."))
  (if ($present? definition/validate)
    (try (definition/validate value)
      catch Any
        (if (== ($head $err) ServiceError) (fail $err))
        (let reason (error_text $err))
        (invalid $"Setting ${definition/key} was rejected: ${reason}")))
  value)

(fn require_definition [runtime, key : Str]
  (let definition (row runtime/h "settings" key))
  (if ($absent? definition)
    (fail (ServiceError ^code "not_found" ^message $"Unknown setting ${key}.")))
  definition)

# A launch flag overrides the saved value for this process only.
(fn launch_override [runtime, key : Str]
  (let launch runtime/launch)
  (if ($absent? launch) (return nil))
  (if (model_setting_keys .contains? key)
    (launch .get key)
    nil))

# Choice sources

# Options for one setting from its named `setting_choices` source. Evaluation is a
# read of cached catalogs. A failure leaves the saved value inspectable.
(fn setting_choices [runtime, definition, ^values values = {}, ^scope scope : Str = "workspace"]
  (let name definition/choices)
  (if ($absent? name) (return nil))
  (let source (row runtime/h "setting_choices" name))
  (if ($absent? source)
    (return {^source name ^options [] ^complete false ^closed false
             ^reason $"The ${name} choices are unavailable while their plugin is disabled."}))
  (try
    (let result (source/choices {^key definition/key ^values values ^scope scope}))
    (let shaped (if (== ($head result) List) {^options result} result))
    {^source name ^options (?? shaped/options []) ^complete (?? shaped/complete true)
     ^closed (== source/closed true) ^reason (?? shaped/reason nil)}
  catch Any
    {^source name ^options [] ^complete false ^closed (== source/closed true)
     ^reason ($to_str "The " name " choices could not be read: " (error_text $err)) ^^failed}))

# A closed source rejects a new value it does not offer. An incomplete or failed
# source cannot prove a value invalid, so it does not block the save.
(fn check_choice [runtime, definition, value, values, scope : Str]
  (if (|| ($absent? definition/choices) ($absent? value) (== value "")) (return nil))
  (let choices (setting_choices runtime definition ^values values ^scope scope))
  (if (|| (! choices/closed) (! choices/complete) (== choices/failed true)) (return nil))
  (for option in choices/options
    (if (&& (== option/value value) (!= option/available false)) (return nil)))
  (invalid $"${value} is not an available choice for ${definition/key}."))

# Views

(fn setting_view [runtime, definition, workspace_values, shared_values, active]
  (let key definition/key)
  (let stored_here ($has_key? workspace_values key))
  (let shared_supported (supports_scope? definition "shared"))
  (let shared_here (&& shared_supported ($has_key? shared_values key)))
  (let override (launch_override runtime key))
  (let inherited (if shared_here (then (shared_values .get key)) (else definition/default)))
  (let intended (layered_value definition workspace_values shared_values))
  (let effective (if ($present? override) override intended))
  (let view
    {^key key ^label definition/label ^doc definition/doc ^group definition/group
     ^type definition/type ^applies definition/applies ^owner_scope "workspace"
     ^scopes (definition_scopes definition) ^choices (?? definition/choices nil)
     ^default definition/default ^stored (workspace_values .get key) ^has_stored stored_here
     ^shared (if shared_here (then (shared_values .get key)) (else nil)) ^has_shared shared_here
     ^inherited inherited ^inherited_source (if shared_here "shared" "default")
     ^override override ^value effective
     ^source (if ($present? override)
       (then "launch")
       (elif stored_here "workspace")
       (elif shared_here "shared")
       (else "default"))})
  # Restart-applied values report what the running consumer started with.
  (if (== definition/applies "restart")
    (then
      (let known ($has_key? active key))
      (view .put "active_known" known)
      (view .put "active" (if known (then (active .get key)) (else nil)))
      (view .put "pending_restart" (if known (then (!= (active .get key) effective)) (else nil)))))
  view)

(fn shared_view [definition, shared_values]
  (let key definition/key)
  (let here ($has_key? shared_values key))
  {^key key ^label definition/label ^doc definition/doc ^group definition/group
   ^type definition/type ^applies definition/applies ^owner_scope "shared"
   ^scopes (definition_scopes definition) ^choices (?? definition/choices nil)
   ^default definition/default ^stored (shared_values .get key) ^has_stored here
   ^value (if here (then (shared_values .get key)) (else definition/default))
   ^source (if here "shared" "default")})

(fn shared_values_for [runtime]
  (read_shared_settings (shared_settings_root runtime)))

(fn listed_definitions [runtime, group : Str]
  ($filter (rows runtime/h "settings") (fn [definition] (|| (== group "") (== group definition/group)))))

(fn list_settings [runtime, ^group group : Str = ""]
  (let config (read_config runtime))
  (let shared (shared_values_for runtime))
  (let active (active_settings runtime))
  (let views [])
  (for definition in (listed_definitions runtime group)
    (views .push (setting_view runtime definition config shared/values active)))
  {^settings views ^digest (config_digest config) ^scope "workspace"
   ^shared_digest shared/digest ^shared_errors shared/errors})

(fn read_setting [runtime, key : Str]
  (let definition (require_definition runtime key))
  (let shared (shared_values_for runtime))
  (setting_view runtime definition (read_config runtime) shared/values (active_settings runtime)))

(fn list_shared_settings [runtime, ^group group : Str = ""]
  (let shared (shared_values_for runtime))
  (let views [])
  (for definition in (listed_definitions runtime group)
    (if (supports_scope? definition "shared")
      (views .push (shared_view definition shared/values))))
  {^settings views ^digest shared/digest ^scope "shared" ^root shared/root ^errors shared/errors})

(fn read_shared_setting [runtime, key : Str]
  (let definition (require_definition runtime key))
  (if_not (supports_scope? definition "shared")
    (invalid $"${key} has no shared value; it is a workspace setting."))
  (shared_view definition (/values (shared_values_for runtime))))

# Sidebar destinations: every active setting's group, plus explicit settings_groups
# rows that add presentation or a custom section. Sorted by order, label, then name.
(fn list_settings_groups [runtime]
  (let groups {})
  (for definition in (rows runtime/h "settings")
    (let name definition/group)
    (if_not ($has_key? groups name)
      (groups .put name {^name name ^label name ^order nil ^doc nil ^section nil ^settings 0 ^shared 0}))
    (let entry (groups .get name))
    (entry .put "settings" (+ entry/settings 1))
    (if (supports_scope? definition "shared") (entry .put "shared" (+ entry/shared 1))))
  (for record in (registry_row_records runtime/h "settings_groups")
    (let explicit record/payload)
    (let name explicit/name)
    (if_not ($has_key? groups name)
      (groups .put name {^name name ^label name ^order nil ^doc nil ^section nil ^settings 0 ^shared 0}))
    (let entry (groups .get name))
    (for field in ["label" "order" "doc" "section"]
      (if ($present? (explicit .get field)) (entry .put field (explicit .get field))))
    (entry .put "owner" record/owner))
  (let listed [])
  (for [name entry] in groups (listed .push entry))
  ($order/sort_by listed group_sort_key))

# Explicit order first (unordered groups after), then label, then the stable name.
(fn group_sort_key [entry] : Str
  (let order (+ 100000 (?? entry/order 1000)))
  $"${order}|${entry/label}|${entry/name}")

# Transactions

(fn announce [runtime, scope : Str, digest : Str, keys]
  (bump_settings_revision runtime)
  (let state (settings_state runtime))
  (if (&& (== scope "shared") ($present? state)) (state/observed .set digest))
  (publish runtime/h (SettingsChanged ^scope scope ^digest digest ^keys keys))
  nil)

# Refreshes open Settings screens when another host changes the shared file.
# Execution never depends on this: consumers read settings.gene on use.
(fn observe_shared_settings [runtime, ^interval_ms interval_ms : Int = 1000]
  (let watch {^closed ($cell false) ^worker ($cell nil)})
  (let shared_root (shared_settings_root runtime))
  (let state (settings_state runtime))
  (if (|| (== shared_root "") ($absent? state)) (return watch))
  (state/observed .set (/digest (read_shared_settings shared_root)))
  (watch/worker .set (spawn ^lane root
    ($runtime/with_context nil (fn []
      (while (! watch/closed/.get)
        ($sleep interval_ms)
        (let digest (try (/digest (read_shared_settings shared_root)) catch Any state/observed/.get))
        (if_yes (&& (! watch/closed/.get) (!= digest state/observed/.get))
          (announce runtime "shared" digest [])))))))
  watch)

(fn close_shared_observation [watch]
  (if (watch/closed .swap true) (return nil))
  (let worker watch/worker/.get)
  (if (&& ($present? worker) (! worker/.done?)) (then worker/.cancel worker/.join))
  nil)

(fn request_keys [changes, reset]
  (let keys [])
  (for [key value] in changes (keys .push ($to_str key)))
  (for key in reset
    (if (keys .contains? key) (invalid $"${key} cannot be both set and reset in one save."))
    (keys .push key))
  keys)

(fn check_model_pair [candidate]
  (let model (candidate .get "model"))
  (let provider (candidate .get "provider"))
  (if (&& (== ($head model) Str) (!= model "") (|| ($absent? provider) (== provider "")))
    (invalid "A workspace model needs its provider; save them together.")))

# One commit to config.gene. `mutate` edits the candidate read under the gate,
# for keyboard helpers that change one entry of a map setting.
(fn commit_workspace [runtime, ^set changes = {}, ^reset reset = [], ^mutate mutate = nil,
  ^touches touches = [], ^expected expected : Str = ""]
  (let keys (request_keys changes reset))
  (for key in touches (if_not (keys .contains? key) (keys .push key)))
  (if keys/.empty? (invalid "A save needs at least one setting to set or reset."))
  (let definitions {})
  (for key in keys (definitions .put key (require_definition runtime key)))
  (let committed
    (config_gate
      (fn []
        (let config (read_config runtime))
        (if (&& (!= expected "") (!= expected (config_digest config)))
          (fail (ServiceError ^code "revision_conflict"
            ^message "Workspace settings changed. Read them again before saving.")))
        (let candidate ($thaw ($freeze config)))
        (for [key value] in changes (candidate .put ($to_str key) value))
        (for key in reset (candidate .delete key))
        (if ($present? mutate) (mutate candidate))
        (for key in keys
          (if_yes ($has_key? candidate key)
            (let definition (definitions .get key))
            (check_setting_value definition (candidate .get key))
            (check_choice runtime definition (candidate .get key) candidate "workspace")))
        (if (|| (keys .contains? "provider") (keys .contains? "model")) (check_model_pair candidate))
        ($fs/write_text_atomic (config_path runtime) ($serde/write_data candidate))
        {^config candidate ^digest (config_digest candidate)})))
  (announce runtime "workspace" committed/digest keys)
  (let shared (shared_values_for runtime))
  (let active (active_settings runtime))
  (let views [])
  (for key in keys
    (views .push (setting_view runtime (definitions .get key) committed/config shared/values active)))
  {^settings views ^digest committed/digest ^scope "workspace"})

(fn set_settings [runtime, changes, ^reset reset = [], ^expected expected : Str = ""]
  (if (!= ($head changes) Map) (invalid "Settings changes must be a map of key to value."))
  (commit_workspace runtime ^set changes ^reset reset ^expected expected))

(fn set_setting [runtime, key : Str, value, ^expected expected : Str = ""]
  (let changes {})
  (changes .put key value)
  (let result (commit_workspace runtime ^set changes ^expected expected))
  (let view result/settings/0)
  (view .put "digest" result/digest)
  view)

(fn reset_setting [runtime, key : Str, ^expected expected : Str = ""]
  (let result (commit_workspace runtime ^reset [key] ^expected expected))
  (let view result/settings/0)
  (view .put "digest" result/digest)
  view)

# One commit to the shared settings.gene, under its cross-process lock. Only keys
# whose definitions advertise shared scope belong there; anything else is
# refused before writing, including model defaults, which live in models.gene.
(fn commit_shared [runtime, ^set changes = {}, ^reset reset = [], ^expected expected : Str = ""]
  (let keys (request_keys changes reset))
  (if keys/.empty? (invalid "A save needs at least one setting to set or reset."))
  (let definitions {})
  (for key in keys
    (let definition (require_definition runtime key))
    (if (model_setting_keys .contains? key)
      (invalid "Shared model defaults are saved with manager .set_default_model."))
    (if_not (supports_scope? definition "shared")
      (invalid $"${key} has no shared value; it is a workspace setting."))
    (definitions .put key definition))
  (for [key value] in changes
    (let name ($to_str key))
    (let definition (definitions .get name))
    (check_setting_value definition value)
    (check_choice runtime definition value changes "shared"))
  (let saved (write_shared_settings (shared_settings_root runtime) expected
    (fn [values]
      (for [key value] in changes (values .put ($to_str key) value))
      (for key in reset (values .delete key)))))
  (announce runtime "shared" saved/digest keys)
  (let views [])
  (for key in keys (views .push (shared_view (definitions .get key) saved/values)))
  {^settings views ^digest saved/digest ^scope "shared"})

(fn set_shared_setting [runtime, key : Str, value, ^expected expected : Str = ""]
  (let changes {})
  (changes .put key value)
  (let result (commit_shared runtime ^set changes ^expected expected))
  (let view result/settings/0)
  (view .put "digest" result/digest)
  view)

(fn reset_shared_setting [runtime, key : Str, ^expected expected : Str = ""]
  (let result (commit_shared runtime ^reset [key] ^expected expected))
  (let view result/settings/0)
  (view .put "digest" result/digest)
  view)

# Registry rows

# Host-owned so a setting stays defined when the plugin that shows or uses it is disabled.
(fn install_setting_rows [runtime]
  (for definition in (core_setting_definitions)
    (if ($absent? (row runtime/h "settings" definition/key))
      (contribute runtime/h "core" "settings" definition)))
  nil)
