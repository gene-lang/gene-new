# Exact source requirements and host-supported versions are different data.
(mod interface_policy)
(type InterfacePolicyError ^props {^message Str} ^impl [Error])
(impl Error for InterfacePolicyError)

(const public_core "gene-harness/PluginHost:3")
(const plugin_interface "gene-harness/Plugin:3")

(fn current_interfaces []
  {^core [public_core] ^plugin_api [plugin_interface]})

(fn latest_interfaces [] {^core public_core ^plugin_api plugin_interface})

(fn requirements_diagnostic [required] : Str
  (if (!= ($head required) Map) (return "stored plugin interface requirements must be a map"))
  (for name in ["core" "plugin_api"]
    (if_not (required .has_key? name) (return $"stored plugin interface requirements omit ${name}")))
  (for [name version] in required
    (if (|| (!= ($head version) Str) (== version ""))
      (return $"interface ${name} requires one exact version string, not a supported-version set")))
  "")

(fn interface_diagnostic [required, offered] : Str
  (let invalid (requirements_diagnostic required))
  (if (!= invalid "") (return invalid))
  (for [field version] in required
    (let name ($to_str field))
    (let available (offered .get name))
    (if ($absent? available)
      (return $"unsupported interface ${name}: requires ${version}; this host does not provide it"))
    (let supported (if (== ($head available) List) available [available]))
    (if_not (supported .contains? version)
      (return $"unsupported interface ${name}: requires ${version}; this host provides ${supported}")))
  "")

(fn source_interfaces [source]
  (let meta ($meta source))
  (let declared (?? (meta .get "interfaces") {}))
  (if (!= ($head declared) Map)
    (fail (InterfacePolicyError ^message "@interfaces must declare a map of exact required versions.")))
  (let required (latest_interfaces))
  (for [key version] in declared (required .put key version))
  (let invalid (requirements_diagnostic required))
  (if (!= invalid "") (fail (InterfacePolicyError ^message invalid)))
  required)

(fn entry_core_interface [entry] entry/interfaces/core)
