# Server commands request changes from connected browsers. No workspace file.
(mod appearance)
(import ^from "../kernel" [publish contribute row])
(import ^from "../plugin_api" [HarnessEvent])
(import ^from "./appearance_error" [AppearanceError] ^^export)
(import ^from "../web/specimen" [install_specimen])
(import ^from "../web/appearance_values" [validate_fields])

(type AppearanceChanged : HarnessEvent ^props {^saved Any})
(type AppearanceRequest : HarnessEvent ^props {^fields Any})
(type Appearance ^props {^tabs Any ^gate Any})

(fn open_appearance [state_root : Str] : Appearance
  (Appearance ^tabs ($cell {}) ^gate ($sync/gate)))

(fn appearance_tabs [runtime]
  (let result [])
  (for [id value] in runtime/services/values/appearance/tabs/.get
    (result .push {^tab ($to_str id) ^saved value/saved ^rendered value/rendered}))
  result)

(fn report_appearance [runtime, id : Str, value]
  (let state runtime/services/values/appearance)
  (state/gate (fn []
    (let tabs ($thaw ($freeze state/tabs/.get)))
    (if ($absent? value) (then (tabs .delete id)) (else (tabs .put id value)))
    (state/tabs .set tabs)))
  nil)

(fn set_appearance [runtime, fields]
  (validate_fields fields)
  (publish runtime/h (AppearanceRequest ^fields fields))
  fields)

(fn install_appearance_rows [runtime]
  (install_specimen runtime)
  (let h runtime/h)
  (if ($absent? (row h "functions" "set_appearance"))
    (contribute h "core" "functions"
      {^name "set_appearance" ^doc "Request appearance preferences in every connected browser, e.g. {^mode \"dark\"}."
       ^tags ["ui" "theme" "appearance"] ^docs ["harness/ui/configuration"]
       ^fn (fn [fields] (set_appearance runtime fields))}))
  nil)
