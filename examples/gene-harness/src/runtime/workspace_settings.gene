# Small, inert workspace metadata. Call writes only with workspace ownership.
(mod workspace_settings)
(import ^from "./workspace_lock" [acquire_workspace_lock close_workspace_lock])

(type WorkspaceSettingsError ^props {^code Str ^message Str} ^impl [Error])
(impl Error for WorkspaceSettingsError)
(let edit_gate ($sync/gate))

(fn settings_error [message : Str]
  (fail (WorkspaceSettingsError ^code "invalid_workspace_settings" ^message message)))

(fn validate_settings [value]
  (if (!= ($head value) Map) (settings_error "Workspace settings must be an inert map."))
  (if (!= (?? value/version 1) 1) (settings_error "Unsupported workspace settings version."))
  (let port (?? value/port 0))
  (for [key field] in value
    (if_not (["version" "port" "role"] .contains? ($to_str key))
      (settings_error $"Unknown workspace setting ${key}.")))
  (if (|| (!= ($head port) Int) (&& (!= port 0) (|| (< port 1024) (> port 65535))))
    (settings_error "Workspace port must be 0 or 1024–65535."))
  (if (&& ($present? value/role) (!= value/role "manager"))
    (settings_error "Unknown workspace role."))
  (let result {^version 1 ^port port})
  (if_not ($absent? value/role) (result .put "role" value/role))
  result)

(fn read_workspace_settings [root : Str]
  (let path $"${root}/.gene-harness/workspace.gene")
  (if_not ($fs/exists? path) (return {^version 1 ^port 0}))
  (validate_settings ($serde/read_data ($fs/read_text path))))

(fn write_workspace_settings [root : Str, value]
  (let checked (validate_settings value))
  ($fs/write_text_atomic $"${root}/.gene-harness/workspace.gene" ($serde/write_data checked))
  checked)

(fn update_workspace_settings [root : Str, changes, ^expected expected : Str = ""]
  (edit_gate
    (fn []
      (let next (read_workspace_settings root))
      (if (&& (!= expected "") (!= expected ($pkg/canonical_digest next)))
        (fail
          (WorkspaceSettingsError ^code "revision_conflict" ^message "Workspace settings changed. Refresh and review before saving.")))
      (for [key value] in changes
        (if (!= ($to_str key) "port")
          (settings_error "Only the port can be edited."))
        (next .put ($to_str key) value))
      (write_workspace_settings root next))))

# The manager root holds the manager's own state in .gene-harness and every
# managed workspace under workspaces/<name>. Relative paths use the launch
# directory, like --workspace.
(fn manager_root_path [^explicit explicit = nil, ^environment environment = nil] : Str
  (let configured (?? environment ($os/get_env "GENE_HARNESS_ROOT" "")))
  (var selected (if (&& ($present? explicit) (!= explicit "")) explicit configured))
  (if_yes (== selected "")
    (let home ($os/get_env "HOME" ""))
    (if (== home "") (settings_error "HOME is required to locate the manager root; use --root DIR."))
    (set selected ($path/join home ".gene-harness-root")))
  (if ($str/starts_with? selected "/") selected ($path/join ($os/launch_dir) selected)))

(fn initialize_manager_workspace [^root explicit = nil]
  (let selected (manager_root_path ^explicit explicit))
  ($fs/make_dir selected)
  (let root ($fs/real_path selected))
  (if (== root "/") (settings_error "The manager root cannot be the filesystem root."))
  (let path $"${root}/.gene-harness/workspace.gene")
  (if_yes ($fs/exists? path)
    (if (== ((Path "role") (read_workspace_settings root)) "manager")
      (do ($fs/make_dir $"${root}/workspaces") (return root)))
    (settings_error $"${root} is an ordinary Harness workspace; choose another manager root."))
  # Started workspaces always have a config. Without workspace.gene this is
  # still someone's workspace, not an interrupted manager initialization.
  (if ($fs/exists? $"${root}/.gene-harness/config.gene")
    (settings_error $"${root} is an ordinary Harness workspace; choose another manager root."))
  (let lock (acquire_workspace_lock root "initialize manager"))
  (try
    (write_workspace_settings root {^version 1 ^port 8580 ^role "manager"})
    ($fs/make_dir $"${root}/workspaces")
    root
  ensure
    (close_workspace_lock lock)))

(fn manager_workspace? [root : Str]
  (== ((Path "role") (read_workspace_settings root)) "manager"))
