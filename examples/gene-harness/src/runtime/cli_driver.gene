(mod cli_driver)
(import ^from "./round_controller"
  [
    new_round_controller
    submit_round
    round_state
    round_receipt
    answer_round
    cancel_round
    close_round_controller])
(import ^from "./sessions" [load_session])
(import ^from "./commands" [parse_submission submit_command command_receipt])

(fn wait_round [controller, session : Str]
  (let watcher (controller/watchers .get; .get session))
  (if_not ($absent? watcher) watcher/.join)
  (let state (load_session controller/runtime/sessions session))
  state/round/.get)

(fn cli_questions [controller, session : Str, receipt]
  (let answers {})
  (for question in receipt/questions/questions
    ($println question/prompt)
    (let choices (?? question/choices nil))
    (if_not ($absent? choices)
      (var index 1)
      (for choice in choices
        ($println index ". " choice)
        (set index (+ index 1))))
    ($print "> ")
    (let text (await ($os/read_line_async)))
    (if (== text "/dismiss")
      (return (answer_round ^^dismiss controller session receipt/questions/id {})))
    (if (== text "-") (continue))
    (let value
      (if (&& (== text "") (! ($absent? question/recommended)))
        question/recommended
        (if ($absent? choices)
          text
          (do
            (let index (- ($parse/parse_int text) 1))
            choices/%index))))
    (answers .put question/id value))
  (answer_round controller session receipt/questions/id answers))

(fn ask [controller, session : Str, text : Str]
  (let parsed (parse_submission controller/runtime/h text))
  (if (== parsed/kind "command")
    (then
      (let manager controller/runtime/commands)
      (let command (submit_command manager session text))
      (manager/watchers
        .get
        ; .get $"${session}:${command/id}"
        ; .join)
      (let result (command_receipt manager session command/id))
      ($println (?? result/display ""))
      (return result)))
  (let state (round_state controller session))
  (let receipt
    (submit_round controller session $"cli-${state/next_seq}" state/next_seq parsed/text))
  (var current (wait_round controller session))
  (while (== current/state "waiting")
    (cli_questions controller session current)
    (set current (wait_round controller session)))
  (if_not ($absent? current/reply) ($println current/reply))
  (if (== current/state "failed") ($println (?? current/request current/message)))
  current)
