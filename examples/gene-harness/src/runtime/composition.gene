(mod composition)

(type CompositionSnapshot ^props {^id Int ^registries Any ^instances Any ^plugins Any?})
(type SnapshotLease ^props {^snapshot CompositionSnapshot ^counter Any ^closed Any})
(type CompositionState ^props {^current Any ^next_id Any ^snapshots Any ^counts Any ^pending Any ^retiring Any ^retire Any ^closed Any ^publishing Any ^mutating Any ^on_publish Any?})
(type CompositionClosed ^props {^message Str} ^impl [Error])
(impl Error for CompositionClosed)

# Collection data is copied and frozen; callables and resource handles retain
# their identity. A plugin's mutable state is independent of registry visibility.
(fn immutable_view [value]
  (if (== ($head value) Map)
    (then
      (let copied {})
      (for [key item] in value
        (copied .put key (immutable_view item)))
      (return ($freeze_shallow copied))))
  (if (== ($head value) List)
    (then
      (let copied [])
      (for item in value
        (copied .push (immutable_view item)))
      (return ($freeze_shallow copied))))
  value)

(fn require_open [state : CompositionState]
  (if state/closed/.get (fail (CompositionClosed ^message "workspace composition is closed")))
  state)

(fn new_composition_state [registries, instances, retire] : CompositionState
  (let snapshot
    ($freeze_shallow
      (CompositionSnapshot ^id 0 ^registries (immutable_view registries) ^instances ($freeze_shallow instances))))
  (let snapshots {})
  (snapshots .put "0" snapshot)
  (let counts {})
  (counts .put "0" ($atomic_cell 0))
  (CompositionState ^current ($cell snapshot) ^next_id ($cell 1) ^snapshots ($cell snapshots) ^counts ($cell counts) ^pending ($cell []) ^retiring ($cell []) ^retire retire ^closed ($cell false) ^publishing ($cell false) ^mutating ($cell false)))

(fn run_composition_change [state : CompositionState, change]
  (require_open state)
  (let context (?? ($runtime/context) {}))
  (if (same? context/composition_step state) (return (change)))
  (while (state/mutating .swap true)
    ($sleep 1))
  (try
    (let scoped ($thaw ($freeze_shallow context)))
    (scoped .put "composition_step" state)
    ($runtime/with_context scoped change)
  ensure
    (state/mutating .set false)))

(fn adjust_count [counter, delta : Int]
  (while true
    (let before counter/.load)
    (let after (+ before delta))
    (if (counter .compare_exchange before after) (return after)))
  nil)

(fn current_snapshot [state : CompositionState] : CompositionSnapshot
  (require_open state)
  (let context ($runtime/context))
  (if (&& (! ($absent? context)) (same? context/composition state) (! ($absent? context/snapshot)))
    (return context/snapshot))
  state/current/.get)

(fn acquire_snapshot [state : CompositionState] : SnapshotLease
  (require_open state)
  (while true
    (let snapshot state/current/.get)
    (let counter (state/counts/.get .get ($to_str snapshot/id)))
    (if ($absent? counter) (continue))
    (adjust_count counter 1)
    # Publication can occur at any VM safepoint. Recheck after incrementing so
    # a reader never acquires a revision whose retirement already started.
    (if (same? snapshot state/current/.get)
      (return (SnapshotLease ^snapshot snapshot ^counter counter ^closed ($cell false))))
    (adjust_count counter -1)
    (drain_retirements state))
  nil)

(fn release_snapshot [state : CompositionState, lease : SnapshotLease]
  (if (lease/closed .swap true) (return nil))
  (adjust_count lease/counter -1)
  (drain_retirements state)
  nil)

# Publication observers can retain the previous revision while they close a
# withdrawn resource. Call before publication's retirement drain.
(fn retain_snapshot [state : CompositionState, snapshot] : SnapshotLease
  (require_open state)
  (let counter (state/counts/.get .get ($to_str snapshot/id)))
  (if ($absent? counter)
    (fail (CompositionClosed ^message "snapshot has already retired")))
  (adjust_count counter 1)
  (SnapshotLease ^snapshot snapshot ^counter counter ^closed ($cell false)))

(fn queue_composition_change [state : CompositionState, change]
  (require_open state)
  (let context ($runtime/context))
  (if (&& (! ($absent? context)) (! ($absent? context/turn)))
    (then
      (change .put "origin_turn" context/turn)
      (context/turn/composition_queued .set true)))
  (state/pending
    .get
    ; .push change)
  nil)

(fn take_composition_changes [state : CompositionState, ^origin origin = nil]
  (require_open state)
  (let ready []) (let waiting [])
  (for change in (state/pending .swap [])
    (let owner change/origin_turn)
    (if ($absent? owner)
      (ready .push change)
      (if (&& (! ($absent? origin))
              (== owner/queue_token origin/queue_token))
        (if (== owner/state/.get "cancelled")
          nil
          (if (== owner/state/.get "open")
            (waiting .push change)
            (ready .push change)))
        (waiting .push change))))
  (for change in waiting (state/pending/.get .push change))
  ready)

(fn discard_composition_changes [state : CompositionState, origin]
  (require_open state)
  (let kept [])
  (for change in (state/pending .swap [])
    (let owner change/origin_turn)
    (if (|| ($absent? owner)
            (!= owner/queue_token origin/queue_token))
      (kept .push change)))
  (for change in kept (state/pending/.get .push change))
  nil)

(fn publish_snapshot [state : CompositionState, registries, instances, ^plugins plugins = []] : CompositionSnapshot
  (require_open state)
  (while (state/publishing .swap true)
    ($sleep 1))
  (try
    (publish_snapshot_serial state registries instances ^plugins plugins)
  ensure
    (state/publishing .set false)))

(fn publish_snapshot_serial [state : CompositionState, registries, instances, ^plugins plugins = []] : CompositionSnapshot
  (let previous state/current/.get)
  (let id (state/next_id .swap (+ state/next_id/.get 1)))
  (let snapshot ($freeze_shallow
    (CompositionSnapshot ^id id ^registries (immutable_view registries)
      ^instances ($freeze_shallow instances) ^plugins (immutable_view plugins))))
  (state/snapshots/.get .put ($to_str id) snapshot)
  (state/counts/.get .put ($to_str id) ($atomic_cell 0))
  # Publication itself is one native Cell operation and cannot yield.
  (state/current .set snapshot)
  (if_not ($absent? state/on_publish) (state/on_publish previous snapshot))
  (drain_retirements state)
  snapshot)

(fn instance_is_leased? [state : CompositionState, instance] : Bool
  (let current state/current/.get)
  (for live in current/instances
    (if (== live instance) (return true)))
  (for [id counter] in state/counts/.get
    (if (> counter/.load 0)
      (then
        (let snapshot (state/snapshots .get; .get id))
        (for live in snapshot/instances
          (if (== live instance) (return true))))))
  false)

(fn queue_retirement [state : CompositionState, ticket, instances]
  (state/retiring
    .get
    ; .push {^ticket ticket ^instances instances})
  (drain_retirements state)
  nil)

(fn drain_retirements [state : CompositionState]
  (let waiting [])
  (let ready [])
  (let pending (state/retiring .swap []))
  (for retirement in pending
    (var leased false)
    (for instance in retirement/instances
      (if (instance_is_leased? state instance) (set leased true)))
    (if leased (waiting .push retirement) (ready .push retirement)))
  # Publish the waiting queue before cleanup, which can run application code.
  (for retirement in waiting (state/retiring/.get .push retirement))
  (for retirement in ready (state/retire retirement/ticket))
  (let expired [])
  (let current state/current/.get)
  (for [id counter] in state/counts/.get
    (if (&& (== counter/.load 0) (!= ($to_str id) ($to_str current/id)))
      (expired .push id)))
  (for id in expired
    (state/counts/.get .delete id)
    (state/snapshots/.get .delete id))
  nil)

(fn close_composition_state [state : CompositionState]
  (if state/closed/.get (return nil))
  (for [id counter] in state/counts/.get
    (if (> counter/.load 0)
      (fail (CompositionClosed ^message
        $"composition still has active turn leases at snapshot ${id}: ${counter/.load}"))))
  (drain_retirements state)
  (state/pending .set [])
  (state/snapshots .set {})
  (state/counts .set {})
  (state/closed .set true)
  nil)
