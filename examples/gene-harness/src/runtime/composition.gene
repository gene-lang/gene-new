(mod composition)

(type CompositionSnapshot ^props {^id Int ^registries Any ^instances Any ^plugins Any? ^registry_owners Any?})
(type SnapshotLease ^props {^snapshot CompositionSnapshot ^counter Any ^closed Any ^label Str?})
(type CompositionState ^props {^current Any ^next_id Any ^snapshots Any ^counts Any ^pending Any ^retiring Any ^retire Any ^closed Any ^closing Any ^publishing Any ^mutating Any ^publications Any ^publication_gate Any ^leases Any ^publication_diagnostics Any})
(type CompositionClosed : Error)

# Collection data is copied and frozen; callables and resource handles retain
# their identity. A plugin's mutable state is independent of registry visibility.
(fn immutable_view [value]
  (if (== ($head value) Map)
    (do (let copied {})
      (map_for [key item] in value
        (copied .put key (immutable_view item)))
      (return ($freeze_shallow copied))))
  (if (== ($head value) List)
    (do (let copied [])
      (for item in value
        (copied .push (immutable_view item)))
      (return ($freeze_shallow copied))))
  value)

(fn require_open [state : CompositionState]
  (if state/closed/.get (fail (CompositionClosed ^_msg "workspace composition is closed")))
  state)

(fn new_composition_state [registries, instances, retire] : CompositionState
  (let snapshot
    ($freeze_shallow
      (CompositionSnapshot ^id 0 ^registries (immutable_view registries) ^instances ($freeze_shallow instances))))
  (let snapshots {})
  (snapshots .put "0" snapshot)
  (let counts {})
  (counts .put "0" ($atomic_cell 0))
  (CompositionState ^current ($cell snapshot) ^next_id ($cell 1) ^snapshots ($cell snapshots) ^counts ($cell counts) ^pending ($cell []) ^retiring ($cell []) ^retire retire ^closed ($cell false) ^closing ($cell false) ^publishing ($sync/gate) ^mutating ($sync/gate)
    ^publications ($cell []) ^publication_gate ($sync/gate) ^leases ($cell [])
    ^publication_diagnostics ($cell [])))

(type PublicationSubscription ^^private ^props {^rows Any ^gate Any ^token Any ^active Any}
  (message cancel [] : Nil
    (self/active .set false)
    (self/gate (fn []
      (self/rows .set ($filter self/rows/.get (fn [row] (! (same? row/token self/token)))))))
    nil))

(fn subscribe_publications [state : CompositionState, callback]
  (require_open state)
  (let token ($cell nil))
  (let active ($cell true))
  (state/publication_gate (fn []
    (require_open state)
    (state/publications/.get .push {^token token ^active active ^callback callback})))
  (PublicationSubscription ^rows state/publications ^gate state/publication_gate
    ^token token ^active active))

(fn run_composition_change [state : CompositionState, change]
  (require_open state)
  (let context (?? ($runtime/context) {}))
  (if (same? context/composition_step state) (return (change)))
  (state/mutating (fn []
    (require_open state)
    (let scoped (context .assoc "composition_step" state))
    ($runtime/with_context scoped change))))

(fn adjust_count [counter, delta : Int]
  (while true
    (let before counter/.load)
    (let after (+ before delta))
    (if (counter .compare_exchange before after) (return after)))
  nil)

(fn current_snapshot [state : CompositionState] : CompositionSnapshot
  (require_open state)
  (let context ($runtime/context))
  (if (&& ($present? context) (same? context/composition state) ($present? context/snapshot))
    (return context/snapshot))
  state/current/.get)

(fn acquire_snapshot [state : CompositionState, ^label label : Str = "unlabelled"] : SnapshotLease
  (require_open state)
  (if state/closing/.get (fail (CompositionClosed ^_msg "workspace composition is closing")))
  (while true
    (let snapshot state/current/.get)
    (let counter (state/counts/.get .get ($to_str snapshot/id)))
    (if ($absent? counter) (continue))
    (adjust_count counter 1)
    # Publication can occur at any VM safepoint. Recheck after incrementing so
    # a reader never acquires a revision whose retirement already started.
    (if (same? snapshot state/current/.get)
      (do (let lease (SnapshotLease ^snapshot snapshot ^counter counter ^closed ($cell false) ^label label))
        (state/leases/.get .push lease)
        (return lease)))
    (adjust_count counter -1)
    (drain_retirements state))
  nil)

(fn release_snapshot [state : CompositionState, lease : SnapshotLease]
  (if (lease/closed .swap true) (return nil))
  (adjust_count lease/counter -1)
  (state/leases .set ($filter state/leases/.get (fn [held] (! (same? held/closed lease/closed)))))
  (drain_retirements state)
  nil)

# Publication observers can retain the previous revision while they close a
# withdrawn resource. Call before publication's retirement drain.
(fn retain_snapshot [state : CompositionState, snapshot] : SnapshotLease
  (require_open state)
  (if state/closing/.get (fail (CompositionClosed ^_msg "workspace composition is closing")))
  (let counter (state/counts/.get .get ($to_str snapshot/id)))
  (if ($absent? counter)
    (fail (CompositionClosed ^_msg "snapshot has already retired")))
  (adjust_count counter 1)
  (let lease (SnapshotLease ^snapshot snapshot ^counter counter ^closed ($cell false) ^label "publication observer"))
  (state/leases/.get .push lease)
  lease)

(fn queue_composition_change [state : CompositionState, change]
  (require_open state)
  (let context ($runtime/context))
  (if (&& ($present? context) ($present? context/turn))
    (do (change .put "origin_turn" context/turn)
      (context/turn/composition_queued .set true)))
  (state/pending
    .get
    ; .push change)
  nil)

(fn take_composition_changes [state : CompositionState, ^origin origin = nil]
  (require_open state)
  (let ready []) (let waiting [])
  (for change in (state/pending .swap [])
    (let owner change/origin_turn)
    (if ($absent? owner)
      (ready .push change)
      elif (&& ($present? origin)
              (== owner/queue_token origin/queue_token)) (if (== owner/state/.get "cancelled")
          nil
          elif (== owner/state/.get "open") (waiting .push change)
          else (ready .push change))
      else (waiting .push change)))
  (for change in waiting (state/pending/.get .push change))
  ready)

(fn discard_composition_changes [state : CompositionState, origin]
  (require_open state)
  (let kept [])
  (for change in (state/pending .swap [])
    (let owner change/origin_turn)
    (if (|| ($absent? owner)
            (!= owner/queue_token origin/queue_token))
      (kept .push change)))
  (for change in kept (state/pending/.get .push change))
  nil)

(fn publish_snapshot [state : CompositionState, registries, instances,
  ^plugins plugins = [], ^registry_owners registry_owners = {}] : CompositionSnapshot
  (require_open state)
  (state/publishing (fn [] (publish_snapshot_serial state registries instances
    ^plugins plugins ^registry_owners registry_owners))))

# Diagnostics belong to a publication, not to its caller. Publication commits
# at the cell write below; a failing observer, metadata pass or retirement is
# recorded against the snapshot that is serving when it fails and never rolls
# back a composition that went live. The most recent ones outlive their
# snapshot so the plugin catalog can still report them.
(var ^^private diagnostic_limit 32)

(fn ^^private snapshot_key [revision] : Str
  ($to_str (if (== ($head revision) CompositionSnapshot) revision/id else revision)))

(fn record_publication_diagnostic [state : CompositionState, revision, diagnostic]
  (let entry {^snapshot (snapshot_key revision)})
  (map_for [key value] in diagnostic (entry .put key value))
  (let entries state/publication_diagnostics/.get)
  (entries .push entry)
  (if (> entries/.size diagnostic_limit)
    (do
      (let kept [])
      (var at (- entries/.size diagnostic_limit))
      (while (< at entries/.size)
        (kept .push entries/%at)
        (set at (+ at 1)))
      (state/publication_diagnostics .set kept)))
  nil)

# One publication's diagnostics, oldest first; without a revision, every
# recent diagnostic.
(fn publication_diagnostics [state : CompositionState, revision = nil] : Any
  (let wanted (if ($absent? revision) nil else (snapshot_key revision)))
  (let found [])
  (for diagnostic in state/publication_diagnostics/.get
    (if (|| ($absent? wanted) (== diagnostic/snapshot wanted))
      (found .push diagnostic)))
  found)

(fn publish_snapshot_serial [state : CompositionState, registries, instances,
  ^plugins plugins = [], ^registry_owners registry_owners = {}] : CompositionSnapshot
  (let previous state/current/.get)
  (let id (state/next_id .swap (+ state/next_id/.get 1)))
  (let snapshot ($freeze_shallow
    (CompositionSnapshot ^id id ^registries (immutable_view registries)
      ^instances ($freeze_shallow instances) ^plugins (immutable_view plugins)
      ^registry_owners (immutable_view registry_owners))))
  (state/snapshots/.get .put ($to_str id) snapshot)
  (state/counts/.get .put ($to_str id) ($atomic_cell 0))
  # Publication itself is one native Cell operation and cannot yield. Everything
  # after it is post-commit work: failure is a diagnostic, never a rollback.
  (state/current .set snapshot)
  (let listeners (state/publication_gate (fn [] ($into state/publications/.get []))))
  (for listener in listeners
    (if_not listener/active/.get (continue))
    (try (listener/callback previous snapshot)
      catch Error
        (record_publication_diagnostic state id
          {^kind "observer" ^message $err/.message})))
  (drain_retirements state)
  snapshot)

(fn instance_is_leased? [state : CompositionState, instance] : Bool
  (let current state/current/.get)
  (if_not state/closing/.get
    (for live in current/instances
      (if (== live instance) (return true))))
  (map_for [id counter] in state/counts/.get
    (if (> counter/.load 0)
      (do (let snapshot (state/snapshots .get; .get id))
        (for live in snapshot/instances
          (if (== live instance) (return true))))))
  false)

(fn queue_retirement [state : CompositionState, ticket, instances]
  (state/retiring
    .get
    ; .push {^ticket ticket ^instances instances})
  (drain_retirements state)
  nil)

# A deferred retirement fails with one error whose cause lists every cleanup
# that failed, each with its own causes. The diagnostic keeps the innermost
# messages and the plugin each one came from.
(fn ^^private error_causes [error] : Any
  # Cordis aggregates keep their failures in `errors`; Harness errors in `cause`.
  (let causes (try (?? error/errors error/cause) catch Throwable nil))
  (if (&& ($present? causes) (== ($head causes) List)) causes else nil))

(fn ^^private leaf_messages [error] : Any
  (let causes (error_causes error))
  (if ($absent? causes)
    (return [($to_str (try (?? error/.message error) catch Error error))]))
  (let out [])
  (for cause in causes
    (for message in (leaf_messages cause) (out .push message)))
  out)

(fn ^^private failure_message [error] : Str
  (let causes (error_causes error))
  (if ($absent? causes) (return ($to_str error/.message)))
  (let parts [])
  (for cause in causes
    (let plugin (try cause/plugin catch Error nil))
    (for message in (leaf_messages cause)
      (parts .push (if ($absent? plugin) message else $"${plugin}: ${message}"))))
  (let detail ($str/join parts "; "))
  $"${error/.message}: ${detail}")

# A retirement ticket is independent of every other ticket. One failing
# cleanup is recorded and the rest still run: a single failure must not strand
# later tickets, and a drain triggered by an unrelated turn must not fail it.
# The failure is recorded when it happens, against the serving snapshot, and
# returned to the caller.
(fn drain_retirements [state : CompositionState] : Any
  (let waiting [])
  (let ready [])
  (let pending (state/retiring .swap []))
  (for retirement in pending
    (var leased false)
    (for instance in retirement/instances
      (if (instance_is_leased? state instance) (set leased true)))
    (if leased (waiting .push retirement) else (ready .push retirement)))
  # Publish the waiting queue before cleanup, which can run application code.
  (for retirement in waiting (state/retiring/.get .push retirement))
  (let failures [])
  (for retirement in ready
    (try
      (state/retire retirement/ticket)
    catch Error
      (let failure {^kind "retirement" ^message (failure_message $err)})
      (failures .push failure)
      (record_publication_diagnostic state state/current/.get failure)))
  (let expired [])
  (let current state/current/.get)
  (map_for [id counter] in state/counts/.get
    (if (&& (== counter/.load 0) (!= ($to_str id) ($to_str current/id)))
      (expired .push id)))
  (for id in expired
    (state/counts/.get .delete id)
    (state/snapshots/.get .delete id))
  failures)

# Returns the retirement failures of the final drain. They are reported, but a
# failing cleanup does not stop the rest of the composition from closing.
(fn ^^private leases_held? [state : CompositionState] : Bool
  (map_for [id counter] in state/counts/.get
    (if (> counter/.load 0) (return true)))
  false)

(fn begin_close_composition_state [state : CompositionState] : Any
  (if state/closed/.get (return []))
  # A turn that is finishing as shutdown begins still holds its lease for a
  # moment; give in-flight turns a bounded chance to release before refusing.
  (var waited 0)
  (while (&& (leases_held? state) (< waited 2000))
    ($sleep 10)
    (set waited (+ waited 10)))
  (map_for [id counter] in state/counts/.get
    (if (> counter/.load 0)
      (do (let held ($map ($filter state/leases/.get
          (fn [lease] (== ($to_str lease/snapshot/id) ($to_str id)))) (fn [lease] lease/label)))
        (fail (CompositionClosed ^_msg
          $"composition still has active turn leases at snapshot ${id}: ${counter/.load}; holders ${held}")))))
  (state/closing .set true)
  (drain_retirements state))

(fn close_composition_state [state : CompositionState]
  (if state/closed/.get (return nil))
  (begin_close_composition_state state)
  (drain_retirements state)
  (state/pending .set [])
  (state/snapshots .set {})
  (state/counts .set {})
  (state/closed .set true)
  (state/publication_gate (fn []
    (for listener in state/publications/.get (listener/active .set false))
    (state/publications .set [])))
  nil)
