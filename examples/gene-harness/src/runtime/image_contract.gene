(mod image_contract)
(import [ImageError] ^from "../plugin_api")

(fn image_error [code : Str, message : Str]
  (fail (ImageError ^code code ^message message)))

(fn nonempty [value]
  (&& (== ($head value) Str) (!= ($str/trim value) "")))

(fn input_fields []
  ["prompt" "reference_images" "max_attempts" "generator" "generation_model" "size" "background"])

(fn normalize_image_request [input, defaults]
  (if (!= ($head input) Map) (image_error "invalid_request" "Image request must be a map."))
  (for [key value] in input
    (if_not ((input_fields) .contains? ($to_str key))
      (image_error "invalid_request" $"Unknown image input ${key}; MVP output is PNG only.")))
  (let values {^prompt input/prompt ^reference_images [] ^max_attempts 3
    ^generator nil ^generation_model nil ^size "1024x1024" ^background "auto"})
  (for key in (input_fields)
    (if (== key "prompt") (continue))
    (if_not ($absent? (defaults .get key)) (values .put key (defaults .get key)))
    (if ($has_key? input key) (values .put key (input .get key))))
  (for key in ["prompt" "generator" "generation_model" "size"]
    (if_not (nonempty (values .get key))
      (image_error "invalid_request" $"Image ${key} must be explicitly supplied or configured and nonempty.")))
  (if (|| (!= ($head values/max_attempts) Int) (< values/max_attempts 1) (> values/max_attempts 10))
    (image_error "invalid_request" "Image max_attempts must be an integer from 1 through 10."))
  (if (!= ($head values/reference_images) List)
    (image_error "invalid_request" "Image references must be a list of media IDs."))
  (for id in values/reference_images
    (if_not (nonempty id) (image_error "invalid_request" "Image reference IDs must be nonempty strings.")))
  (if_not (["auto" "transparent" "opaque"] .contains? values/background)
    (image_error "invalid_request" "Image background must be auto, transparent or opaque."))
  ($freeze values))

(fn image_limits [config]
  (let result {^run_timeout_ms 590000 ^generation_timeout_ms 240000
    ^review_timeout_ms 60000 ^persistence_margin_ms 5000})
  (for [key fallback] in result
    (let value (?? (config .get key) fallback))
    (if (|| (!= ($head value) Int) (< value 1) (> value 86400000))
      (image_error "invalid_request" $"Image ${key} must be an integer from 1 through 86400000."))
    (result .put key value))
  (if (>= result/persistence_margin_ms result/run_timeout_ms)
    (image_error "invalid_request" "Image persistence margin must be below its run timeout."))
  ($freeze result))

(fn pixel_dimensions [size : Str]
  (if ($absent? (#"^[0-9]+x[0-9]+$" .match size)) (return nil))
  (let pieces ($str/split size "x"))
  (let width ($parse/parse_int pieces/0))
  (let height ($parse/parse_int pieces/1))
  (if (|| (< width 1) (< height 1))
    (image_error "invalid_request" "Image dimensions must be positive."))
  {^width width ^height height})

(fn capability [caps, key : Str]
  (let value (?? (caps .get key) "unknown"))
  (if_not (["yes" "no" "unknown"] .contains? value)
    (image_error "invalid_capabilities" $"Invalid ${key} capability."))
  value)

(fn require_capability [caps, key : Str, role : Str]
  (let value (capability caps key))
  (if (== value "no")
    (image_error "unsupported_capability" $"${role} does not support required ${key}."))
  value)

(fn invalid_review [message : Str]
  {^valid false ^error message})

(fn image_usage [value, ^depth depth : Int = 0]
  (if (|| (!= ($head value) Map) (> depth 4)) (return nil))
  (let result {})
  (for [key item] in value
    (if ($absent? (#"^[a-zA-Z_][a-zA-Z0-9_]{0,63}$" .match ($to_str key))) (continue))
    (if (&& ([Int Float] .contains? ($head item)) (== item item)
            (> item -1e100) (< item 1e100))
      (result .put key item))
    (if_yes (== ($head item) Map)
      (let child (image_usage item ^depth (+ depth 1)))
      (if_not ($absent? child) (result .put key child))))
  result)

(fn parse_image_review [text]
  (if (|| (!= ($head text) Str) (> ($str/byte_size text) 65536))
    (return (invalid_review "Review must be a JSON object no larger than 64 KiB.")))
  (var body ($str/trim text))
  (if_yes ($str/starts_with? body "```")
    (let lines ($str/split body "\n"))
    (if (|| (< lines/.size 3) (! (["```" "```json"] .contains? lines/0))
            (!= ($str/trim ($last lines)) "```"))
      (return (invalid_review "Use one JSON object, optionally in a json code fence, without surrounding prose.")))
    (set body ($str/join ($take ($drop lines 1) (- lines/.size 2)) "\n")))
  (let value (try ($json/parse body) catch Any nil))
  (if (!= ($head value) Map) (return (invalid_review "Review must be a JSON object.")))
  (if (|| (!= ($head value/score) Int) (< value/score 0) (> value/score 100))
    (return (invalid_review "score must be a JSON integer from 0 through 100, without coercion.")))
  (if (|| (!= ($head value/comments) List) value/comments/.empty?)
    (return (invalid_review "comments must be a nonempty list of nonempty strings.")))
  (for comment in value/comments
    (if_not (nonempty comment)
      (return (invalid_review "Every review comment must be a nonempty string."))))
  (if (|| (!= ($head value/revision) Str)
          (&& (< value/score 85) (! (nonempty value/revision))))
    (return (invalid_review "revision must be a string and nonempty below score 85.")))
  {^valid true ^review {^score value/score ^comments value/comments ^revision value/revision}})
