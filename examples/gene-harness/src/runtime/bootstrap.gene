(mod bootstrap)

(import [new_harness module_dir shutdown_harness] ^from "../kernel")
(import [boot] ^from "../profiles/profile")
(import [open_event_store close_event_store flush_event_store] ^from "../storage/state")
(import [open_workspace close_workspace prepare_workspace activate_workspace_plan]
  ^from "../storage/workspace")
(import [claim_session] ^from "./session_claim")
(import $fs [make_dir real_path])
(import $os [get_env])

(type HarnessRuntime ^props {^h Any ^workspace Any ^events Any ^claim Any
                            ^owns_events Bool ^closed Any})
(type RuntimeCleanupError ^props {^message Str} ^impl [Error])
(impl Error for RuntimeCleanupError)

(fn prepare_home [^root root : Str = ""] : Str
  (var chosen root)
  (if (== chosen "")
    (set chosen (get_env "GENE_HARNESS_HOME"
      $"${(module_dir (module_dir (module_dir this_mod/.path)))}/tmp/workspace")))
  (make_dir chosen)
  (for directory in ["composition" "modules" "events" "claims"]
    (make_dir $"${chosen}/${directory}"))
  (real_path chosen))

(fn close_runtime [runtime : HarnessRuntime]
  (if (runtime/closed .get) (return nil))
  (var outcome nil)
  (try
    (try (set outcome (shutdown_harness runtime/h))
    ensure (close_workspace runtime/workspace))
  ensure
    (try
      (if runtime/owns_events (close_event_store runtime/events)
        (flush_event_store runtime/events))
    ensure
      (runtime/claim .close)
      (runtime/closed .set true)))
  (if_yes (&& (! ($absent? outcome)) (== outcome/status "recovery_required"))
    (fail (RuntimeCleanupError ^message "Session cleanup requires recovery. Inspect the local Harness output before continuing.")))
  nil)

(fn open_runtime [home : Str, session : Str, profile,
                  ^events supplied_events = nil,
                  ^project_root project_root : Str = "",
                  ^activate activate : Bool = true] : HarnessRuntime
  (var claim (claim_session home session))
  (var events supplied_events)
  (var workspace nil)
  (var h nil)
  (var ready false)
  (var owned ($absent? supplied_events))
  (try
    (if_yes owned (set events (open_event_store $"${home}/events")))
    (set workspace (open_workspace $"${home}/composition"
      ^blob_root $"${home}/modules" ^state_root home
      ^workspace_root (if (== project_root "") (get_env "GENE_HARNESS_PROJECT" "") project_root)))
    (set h (new_harness ^event_store events ^event_scope "session"
      ^event_stream session ^workspace workspace))
    (if_yes activate
      (var prepared (prepare_workspace workspace h ^session session))
      (boot profile ^h h)
      (activate_workspace_plan prepared h))
    (set ready true)
    (HarnessRuntime ^h h ^workspace workspace ^events events ^claim claim
      ^owns_events owned ^closed ($cell false))
  ensure
    (if_not ready
      (try
        (if_not ($absent? h) (shutdown_harness h))
      ensure
        (try
          (if_not ($absent? workspace) (close_workspace workspace))
        ensure
          (try
            (if_yes (&& owned (! ($absent? events))) (close_event_store events))
          ensure (claim .close)))))))
