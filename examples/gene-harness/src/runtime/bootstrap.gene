(mod bootstrap)

(import ^from "../kernel" [new_harness module_dir shutdown_harness])
(import ^from "../profiles/profile" [profile_admissions])
(import ^from "../storage/state" [open_event_store close_event_store flush_event_store])
(import ^from "../storage/workspace"
  [open_workspace close_workspace prepare_workspace activate_workspace_plan set_profile_plugins])
(import ^from "./workspace_lock" ^^export
  [acquire_workspace_lock close_workspace_lock WorkspaceInUse])
(import ^from "./sessions" [open_session_manager close_session_manager create_session load_session])
(import ^from "./commands" [new_command_manager close_command_manager])
(import ^from "./triggers" [close_trigger_manager])
(import ^from "../agents/history" [collect_unreferenced_bodies])
(import ^from "../agents/instructions" [install_core_prompt_rows])
(import ^from "../agents/provider_selection" [readiness_report])
(import ^from "../plugin_api" [ExecutionLimits response_execution_limits])

(type HarnessRuntime ^props {^root Str ^state_root Str ^h Any ^workspace Any ^profile Any ^events Any ^sessions Any ^commands Any ^triggers Any ^body_users Any ^body_collecting Any ^body_gc_pending Any ^stopping Any ^exit_code Any ^stdin_task Any ^ownership Any ^owns_ownership Bool ^owns_events Bool ^closed Any ^restarted Bool ^shutdown_watchdog Any})
(type RuntimeCleanupError ^props {^message Str} ^impl [Error])
(impl Error for RuntimeCleanupError)

(fn prepare_workspace_root [^root root : Str = ""] : Str
  (let chosen (if (== root "") ($os/launch_dir) root))
  ($fs/make_dir chosen)
  ($fs/real_path chosen))

(fn prepare_layout [root : Str]
  (let state_root $"${root}/.gene-harness")
  (for directory in ["composition" "modules" "blobs" "events" "sessions" "triggers"]
    ($fs/make_dir $"${state_root}/${directory}"))
  (if_not ($fs/exists? $"${state_root}/config.gene")
    ($fs/write_text_atomic
      $"${state_root}/config.gene"
      ($serde/write_data
        {
          ^provider ""
          ^model ""
          ^provider_timeout_ms 600000
          ^response_budget {^timeout_ms 600000 ^max_memory_mb 1024}
          ^turn_limit 24
          ^trigger_turn_limit 12
          ^trigger_timeout_ms 300000
          ^idle_timeout_ms 600000
          ^trigger_concurrency 2
          ^question_timeout_ms 86400000})))
  state_root)

(fn close_runtime [runtime : HarnessRuntime]
  (if runtime/closed/.get (return nil))
  (var outcome nil)
  (try
    (try
      (if_not ($absent? runtime/triggers) (close_trigger_manager runtime/triggers))
      (if_not ($absent? runtime/commands) (close_command_manager runtime/commands))
      (close_session_manager runtime/sessions)
      (set outcome (shutdown_harness runtime/h))
      (if runtime/body_gc_pending/.get (collect_unreferenced_bodies runtime))
    ensure
      (close_workspace runtime/workspace))
  ensure
    (try
      (if runtime/owns_events
        (close_event_store runtime/events)
        (flush_event_store runtime/events))
    ensure
      (if runtime/owns_ownership (close_workspace_lock runtime/ownership))
      (runtime/closed .set true)
      (let watchdog runtime/shutdown_watchdog/.get)
      (if_not ($absent? watchdog)
        watchdog/.cancel
        watchdog/.join)))
  (if_yes (&& (! ($absent? outcome)) (== outcome/status "recovery_required"))
    (fail
      (RuntimeCleanupError ^message
        $"Composition cleanup requires recovery: ${outcome/errors}")))
  nil)

(fn open_runtime [root : Str, session : Str, profile, ^events supplied_events = nil, ^ownership supplied_ownership = nil, ^entry entry : Str = "", ^event_scope event_scope : Str = "session", ^activate activate : Bool = true] : HarnessRuntime
  (let canonical (prepare_workspace_root ^root root))
  (let owns_ownership ($absent? supplied_ownership))
  (let ownership
    (if owns_ownership
      (acquire_workspace_lock canonical (if (== entry "") this_mod/.path entry))
      supplied_ownership))
  (var events supplied_events)
  (var workspace nil)
  (var h nil)
  (var runtime nil)
  (var ready false)
  (let owned ($absent? supplied_events))
  (try
    (let state_root (prepare_layout canonical))
    (let settings ($serde/read_data ($fs/read_text $"${state_root}/config.gene")))
    (let response_budget (?? settings/response_budget {}))
    (let base_limits (?? profile/limits (response_execution_limits)))
    (let profile_limits
      (ExecutionLimits ^max_steps base_limits/max_steps
        ^max_memory_mb (?? response_budget/max_memory_mb base_limits/max_memory_mb)
        ^timeout_ms (?? response_budget/timeout_ms base_limits/timeout_ms)))
    (let restarted ($fs/exists? $"${state_root}/restart_notice"))
    (if restarted ($fs/remove $"${state_root}/restart_notice"))
    ($os/set_cwd canonical)
    (if owned (set events (open_event_store $"${state_root}/events")))
    (set workspace
      (open_workspace ^blob_root $"${state_root}/modules" ^state_root state_root ^workspace_root canonical ^generated_dir $"${state_root}/modules/source"
        $"${state_root}/composition"))
    (set_profile_plugins workspace (profile_admissions ^limits profile_limits profile))
    (set h
      (new_harness ^event_store events ^event_scope event_scope ^event_stream session ^workspace workspace ^limits profile_limits))
    (install_core_prompt_rows h)
    (if_yes activate
      (let prepared (prepare_workspace ^session session workspace h))
      (activate_workspace_plan ^profile_admissions (profile_admissions ^limits profile_limits profile) prepared h))
    (set runtime
      (HarnessRuntime ^root canonical ^state_root state_root ^sessions nil ^commands nil ^triggers nil ^body_users ($atomic_cell 0) ^body_collecting ($cell false) ^body_gc_pending ($cell false) ^stopping ($cell false) ^exit_code ($cell 0) ^stdin_task ($cell nil) ^restarted restarted ^shutdown_watchdog ($cell nil) ^h h ^workspace workspace ^profile profile ^events events ^ownership ownership ^owns_ownership owns_ownership ^owns_events owned ^closed ($cell false)))
    (set h/readiness
      (fn []
        (let current ($serde/read_data ($fs/read_text $"${state_root}/config.gene")))
        (readiness_report runtime current)))
    (set runtime/sessions (open_session_manager runtime events state_root))
    (set runtime/commands (new_command_manager runtime))
    (if (&& activate (== event_scope "session"))
      (then
        (create_session ^id session runtime/sessions)
        (load_session runtime/sessions session)))
    (set ready true)
    runtime
  ensure
    (if_not ready
      (try
        (if (&& (! ($absent? runtime)) (! ($absent? runtime/sessions)))
          (close_session_manager runtime/sessions))
        (if_not ($absent? h) (shutdown_harness h))
      ensure
        (try
          (if_not ($absent? workspace) (close_workspace workspace))
        ensure
          (try
            (if (&& owned (! ($absent? events))) (close_event_store events))
          ensure
            (if owns_ownership (close_workspace_lock ownership))))))))
