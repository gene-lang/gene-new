(mod bootstrap)

(import [new_harness module_dir shutdown_harness] ^from "../kernel")
(import [boot] ^from "../profiles/profile")
(import [open_event_store close_event_store flush_event_store] ^from "../storage/state")
(import [open_workspace close_workspace prepare_workspace activate_workspace_plan]
  ^from "../storage/workspace")
(import [persist_registry_generation record_registry_generation] ^from "../storage/workspace")
(import [acquire_workspace_lock close_workspace_lock WorkspaceInUse] ^from "./workspace_lock" ^export true)
(import [open_session_manager close_session_manager create_session load_session]
  ^from "./sessions")
(import [new_command_manager close_command_manager] ^from "./commands")
(import [close_trigger_manager] ^from "./triggers")
(import [collect_unreferenced_bodies] ^from "../agents/history")

(type HarnessRuntime ^props {^root Str ^state_root Str ^h Any ^workspace Any ^events Any
                            ^sessions Any ^commands Any ^triggers Any ^functions Any ^body_users Any ^body_collecting Any ^body_gc_pending Any ^stopping Any ^exit_code Any ^stdin_task Any
                            ^ownership Any ^owns_ownership Bool ^owns_events Bool ^closed Any ^on_event Any? ^restarted Bool ^shutdown_watchdog Any})
(type RuntimeCleanupError ^props {^message Str} ^impl [Error])
(impl Error for RuntimeCleanupError)

(fn prepare_workspace_root [^root root : Str = ""] : Str
  (let chosen (if (== root "") ($os/launch_dir) root))
  ($fs/make_dir chosen)
  ($fs/real_path chosen))

(fn prepare_layout [root : Str]
  (let state_root $"${root}/.gene-harness")
  (for directory in ["composition" "modules" "blobs" "events" "sessions" "triggers"]
    ($fs/make_dir $"${state_root}/${directory}"))
  (if_not ($fs/exists? $"${state_root}/config.gene")
    ($fs/write_text_atomic $"${state_root}/config.gene"
      ($serde/write_data
        {^provider "" ^model ""
         ^response_budget {^timeout_ms 600000 ^max_memory_mb 1024}
         ^turn_limit 24 ^trigger_turn_limit 12 ^trigger_timeout_ms 300000
         ^idle_timeout_ms 600000 ^trigger_concurrency 2 ^question_timeout_ms 86400000})))
  state_root)

(fn close_runtime [runtime : HarnessRuntime]
  (if (runtime/closed .get) (return nil))
  (var outcome nil)
  (try
    (try
      (if_not ($absent? runtime/triggers) (close_trigger_manager runtime/triggers))
      (if_not ($absent? runtime/commands) (close_command_manager runtime/commands))
      (close_session_manager runtime/sessions)
      (set outcome (shutdown_harness runtime/h))
      (if (runtime/body_gc_pending .get) (collect_unreferenced_bodies runtime))
    ensure (close_workspace runtime/workspace))
  ensure
    (try
      (if runtime/owns_events (close_event_store runtime/events)
        (flush_event_store runtime/events))
    ensure
      (if runtime/owns_ownership (close_workspace_lock runtime/ownership))
      (runtime/closed .set true)
      (let watchdog (runtime/shutdown_watchdog .get))
      (if_not ($absent? watchdog) (watchdog .cancel) (watchdog .join))))
  (if_yes (&& (! ($absent? outcome)) (== outcome/status "recovery_required"))
    (fail (RuntimeCleanupError ^message "Composition cleanup requires recovery. Inspect the Harness output.")))
  nil)

(fn open_runtime [root : Str, session : Str, profile,
                  ^events supplied_events = nil, ^ownership supplied_ownership = nil,
                  ^entry entry : Str = "", ^event_scope event_scope : Str = "session",
                  ^activate activate : Bool = true] : HarnessRuntime
  (let canonical (prepare_workspace_root ^root root))
  (let owns_ownership ($absent? supplied_ownership))
  (let ownership (if owns_ownership
    (acquire_workspace_lock canonical (if (== entry "") this_mod/.path entry))
    supplied_ownership))
  (var events supplied_events)
  (var workspace nil)
  (var h nil)
  (var runtime nil)
  (var ready false)
  (let owned ($absent? supplied_events))
  (try
    (let state_root (prepare_layout canonical))
    (let restarted ($fs/exists? $"${state_root}/restart_notice"))
    (if restarted ($fs/remove $"${state_root}/restart_notice"))
    ($os/set_cwd canonical)
    (if owned (set events (open_event_store $"${state_root}/events")))
    (set workspace (open_workspace $"${state_root}/composition"
      ^blob_root $"${state_root}/modules" ^state_root state_root
      ^workspace_root canonical ^generated_dir $"${state_root}/modules/source"))
    (set h (new_harness ^event_store events ^event_scope event_scope
      ^event_stream session ^workspace workspace ^limits profile/limits))
    (set h/registry_commit (fn [owner] (persist_registry_generation workspace h owner)))
    (set h/registry_record (fn [owner revision] (record_registry_generation workspace h owner revision)))
    (if_yes activate
      (let prepared (prepare_workspace workspace h ^session session))
      (boot profile ^h h)
      (activate_workspace_plan prepared h))
    (set runtime (HarnessRuntime ^root canonical ^state_root state_root ^sessions nil ^commands nil ^triggers nil ^functions {}
      ^body_users ($atomic_cell 0) ^body_collecting ($cell false) ^body_gc_pending ($cell false)
      ^stopping ($cell false) ^exit_code ($cell 0) ^stdin_task ($cell nil)
      ^restarted restarted
      ^shutdown_watchdog ($cell nil)
      ^h h ^workspace workspace ^events events ^ownership ownership
      ^owns_ownership owns_ownership ^owns_events owned ^closed ($cell false)))
    (set runtime/sessions (open_session_manager runtime events state_root))
    (set runtime/commands (new_command_manager runtime))
    (if (&& activate (== event_scope "session"))
      (then
        (create_session runtime/sessions ^id session)
        (load_session runtime/sessions session)))
    (set ready true)
    runtime
  ensure
    (if_not ready
      (try
        (if (&& (! ($absent? runtime)) (! ($absent? runtime/sessions)))
          (close_session_manager runtime/sessions))
        (if_not ($absent? h) (shutdown_harness h))
      ensure
        (try
          (if_not ($absent? workspace) (close_workspace workspace))
        ensure
          (try
            (if (&& owned (! ($absent? events))) (close_event_store events))
          ensure
            (if owns_ownership (close_workspace_lock ownership))))))))
