# Public work admission for plugins (AdmissionHost). A plugin creates sessions
# and submits rounds through its own `initiators` row; the round controller
# keeps admission identity, sequence, digest and cancellation. Session origin
# is an opaque record supplied by the feature, not a per-feature parameter.
(mod admission_host)
(import [AdmissionHost ServiceError] ^from "../plugin_api")
(import [service_binding require_service] ^from "./service_handles")
(import [immutable_view] ^from "./composition")
(import [create_session require_record list_sessions update_session delete_session load_session session_busy?]
  ^from "./sessions")
(import [submit_round round_state round_for_request RoundError] ^from "./round_controller")
(import [copy_data] ^from "../storage/state")

(fn ^^private controller_of [handle]
  (let record (require_service handle))
  (let controller record/runtime/services/values/controller)
  (if (|| ($absent? controller) controller/closed/.get)
    (fail (ServiceError ^code "unavailable" ^message "Round admission is unavailable.")))
  {^runtime record/runtime ^controller controller})

(fn ^^private receipt_view [receipt]
  (if ($absent? receipt) (return nil))
  (immutable_view {^id receipt/id ^request_id receipt/request_id ^state receipt/state
    ^initiator receipt/initiator ^initiator_kind receipt/initiator_kind
    ^submission_seq receipt/submission_seq ^accepted_at receipt/accepted_at}))

(fn ^^private session_view [record]
  (if ($absent? record) nil (immutable_view record)))

(fn ^^private find_receipt [controller, runtime, session : Str, request_id : Str]
  (if ($absent? (runtime/sessions/index/.get .get session)) (return nil))
  (let loaded (runtime/sessions/loaded/.get .get session))
  (if_not ($absent? loaded)
    (let current loaded/round/.get)
    (if (&& ($present? current) (== current/request_id request_id)) (return (copy_data current))))
  (round_for_request controller session request_id))

(type HostedAdmission ^^private ^props {^token Any}
  (impl AdmissionHost
    (message create_session [^id id : Str = "", ^kind kind : Str = "automated", ^title title : Str = "",
                             ^first_request first_request : Str = "", ^origin origin = nil] : Any
      (let context (controller_of self))
      (session_view (create_session context/runtime/sessions ^id id ^kind kind
        ^title (if (== title "") "Automated work" title) ^first_request first_request
        ^origin (if ($absent? origin) nil (copy_data origin)))))
    (message session [session : Str] : Any
      (let context (controller_of self))
      (if ($absent? (context/runtime/sessions/index/.get .get session)) (return nil))
      (session_view (require_record context/runtime/sessions session)))
    (message sessions [^origin_owner owner : Str = ""] : Any
      (let context (controller_of self))
      (let out [])
      (for record in (list_sessions ^^all context/runtime/sessions)
        (if (|| (== owner "") (== record/origin/owner owner)) (out .push record)))
      (immutable_view out))
    (message busy? [session : Str] : Bool
      (let context (controller_of self))
      (if ($absent? (context/runtime/sessions/index/.get .get session)) (return false))
      (session_busy? (load_session context/runtime/sessions session)))
    (message update_session [session : Str, changes] : Any
      (let context (controller_of self))
      (session_view (update_session context/runtime/sessions session (copy_data changes))))
    (message delete_session [session : Str] : Bool
      (let context (controller_of self))
      (delete_session context/runtime/sessions session))
    (message receipt [session : Str, request_id : Str] : Any
      (let context (controller_of self))
      (receipt_view (find_receipt context/controller context/runtime session request_id)))
    (message submit [session : Str, request_id : Str, text : Str, ^initiator initiator : Str,
                     ^input input = nil, ^model_settings model_settings = nil] : Any
      (let context (controller_of self))
      # A retried request id returns its recorded receipt rather than
      # admitting the same work twice.
      (let existing (find_receipt context/controller context/runtime session request_id))
      (if ($present? existing) (return (receipt_view existing)))
      (let sequence (/next_seq (round_state context/controller session)))
      (let admitted ($cell nil))
      (try
        (submit_round context/controller session request_id sequence text
          ^initiator initiator ^input input ^model_settings model_settings
          ^on_admit (fn [receipt] (admitted .set (copy_data receipt))))
      catch RoundError
        (fail (ServiceError ^code $err/code ^message $err/message)))
      (receipt_view admitted/.get))))

(fn admission_host_binding [runtime]
  (service_binding runtime "admission" (fn [token] (HostedAdmission ^token token))))
