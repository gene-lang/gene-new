# Deterministic spoken rendering; never evaluates reply text or invokes a model.
(mod speech_text)

(fn replace_matches [pattern, source : Str, render]
  (var rest source)
  (var result "")
  (loop
    (let found (pattern .match rest))
    (if ($absent? found) (return ($to_str result rest)))
    (set result ($to_str result ($str/slice_bytes rest 0 found/start) (render found)))
    (set rest ($str/slice_bytes rest found/end ($str/byte_size rest)))))

(fn speech_token [token : Str] : Str
  (if_not ($absent? (#"^[0-9]{8,}[.,;:!?]?$" .match token)) (return "a long number"))
  (if_not ($absent? (#"^(?=[0-9a-fA-F]*[a-fA-F])[0-9a-fA-F]{10,}[.,;:!?]?$" .match token))
    (return "a hash"))
  # Bare slash choices and decimal/version ratios are ambiguous prose. Only
  # shorten rooted paths or a path ending in an alphabetic file extension.
  (if_not ($absent? (#"^(?:\.{1,2}/\S+|/\S+|(?:[^\s/]+/)+[^\s/]+\.[A-Za-z][A-Za-z0-9_-]*[.,;:!?]?)$" .match token))
    (return ($last ($str/split token "/"))))
  token)

(fn speech_line [source : Str] : Str
  (var text
    (replace_matches #"\[([^]]+)\]\([^)]+\)" source (fn [match] match/groups/0)))
  (set text (replace_matches #"https?://([^/\s]+)[^\s]*" text (fn [match] match/groups/0)))
  (set text
    (replace_matches #"`([^`]+)`" text (fn [match]
      (let content match/groups/0)
      (if (&& (<= ($str/byte_size content) 40)
              (! ($absent? (#"^[A-Za-z_][A-Za-z0-9_:?.-]*$" .match content))))
        content "code"))))
  (set text ($regex/replace_all #"<[^>]*>" text ""))
  (set text ($regex/replace_all #"(*UTF8)[\x{1F000}-\x{1FAFF}\x{2600}-\x{27BF}\x{FE0F}\x{200D}]" text ""))
  (let item (! ($absent? (#"^\s*(?:#{1,6}\s+|[-*+]\s+|[0-9]+[.)]\s+)" .match text))))
  (set text ($regex/replace_all #"^\s*(?:#{1,6}\s+|[-*+]\s+|[0-9]+[.)]\s+)" text ""))
  (set text ($regex/replace_all #"\*\*|__|~~" text ""))
  (set text ($str/trim ($regex/replace_all #"\s+" text " ")))
  (set text ($str/join ($map ($str/split text " ") speech_token) " "))
  (if (&& item (!= text "") ($absent? (#"[.!?]$" .match text))) (set text ($to_str text ".")))
  text)

(fn speech_needs_audio_reply? [text : Str] : Bool
  (! ($absent? (#"(?m)^\s*(?:`{3}|~{3}|\|)" .match text))))

(fn speech_text [text : Str] : Str
  (let lines [])
  (var fence "")
  (var table false)
  (for raw in ($str/split text "\n")
    (let line ($str/trim raw))
    (var marker "")
    (if ($str/starts_with? line "```") (set marker "```"))
    (if ($str/starts_with? line "~~~") (set marker "~~~"))
    (if_yes (!= marker "")
      (if (== fence "")
        (do (set fence marker) (lines .push "Code on screen."))
        (if (== fence marker) (set fence "")))
      (set table false)
      (continue))
    (if (!= fence "") (continue))
    (if_yes (! ($absent? (#"^\|.*\|$" .match line)))
      (if_not table (lines .push "Table on screen."))
      (set table true)
      (continue))
    (set table false)
    (let spoken (speech_line line))
    (if (!= spoken "") (lines .push spoken)))
  ($str/trim ($str/join lines " ")))
