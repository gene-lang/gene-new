(mod host_identity)
(import current_interfaces ^from "./interface_policy")

(type HostIdentityError : Error)

(fn host_build []
  (let app ($pkg/application))
  (let captured app/provenance)
  (if ($absent? captured)
    (fail
      (HostIdentityError ^_msg "Harness history requires captured host inputs; run Gene with --snapshot or use the Harness launcher")))
  {
    ^format 1
    ^runtime_digest captured/runtime_digest
    ^host_inputs captured/host_inputs
    ^interfaces (current_interfaces)})
