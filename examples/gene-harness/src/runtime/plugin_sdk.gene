# Declared application SDK modules. This is shared by source validation,
# descriptor loading and the runtime loader; no directory-wide import bypass.
(mod plugin_sdk)
(fn sdk_modules []
  ["src/plugin_api.gene" "src/public/response.gene" "src/public/text.gene" "src/web/contract.gene"
   "src/public/documentation.gene" "src/public/provider.gene"
   "src/public/history_policy.gene" "src/public/model_content.gene"
   "src/public/image_contract.gene" "src/public/model_text.gene"
   "src/public/speech_engines.gene" "src/public/mac_recognition.gene"
   "src/public/voice_frames.gene"])

(fn sdk_import? [path : Str] : Bool
  ((sdk_modules) .contains? path))
