# The harness kernel: plugin lifecycle and the effect ledger.
#
# The kernel owns four tables. A plugin never touches them — it contributes
# through `provide`, and every contribution is recorded against the plugin id so
# the kernel can reverse it without the plugin's cooperation. That is what makes
# activation all-or-nothing and uninstall complete: cleanup was never the
# plugin's job.
#
# See docs/design.md for why this is a subsystem rather than a mapping onto
# packages, `try`, and scoped impls.

(mod kernel)

(import ^from "./plugin_api" ^^export
  [
    Plugin
    DescriptorContext
    PluginHost
    HarnessEvent
    DurableRecord
    ExecutionLimits
    default_execution_limits
    response_execution_limits])
(import ^from "./storage/state"
  [
    append_core_event
    append_plugin_event
    prepare_plugin_state
    plugin_state
    copy_data
    core_event_size
    events_for
    flush_event_store])
(import ^from "./storage/generated_event_catalog" [core_event_types])
(import ^from "./views/view_api" [HarnessView view_provider])
(import ^from "./ui/components" [validate_web_component])
(import ^from "./notifications/publisher"
  [safe_publish update_notification list_source_messages clear_source_message])
(import ^from "./runtime/call_supervision" [supervised_call])
(import ^from "./runtime/cordis_adapter"
  [RegistryHost retain_callback retained_callback? expire_scope_callbacks new_composition])
(import ^from "." ^pkg "cordis" [LoaderOptions])
(import ^from "./runtime/composition"
  [
    new_composition_state
    current_snapshot
    publish_snapshot
    queue_composition_change
    take_composition_changes
    run_composition_change
    queue_retirement
    close_composition_state
    immutable_view])

(type HarnessError ^props {^message Str} ^impl [Error])
(type CommandError ^props {^code Str ^message Str} ^impl [Error])
(impl Error for CommandError)

(impl Error for HarnessError)

(type Registry ^props {^name Str ^unique Bool ^ordered Bool ^schema Any ^on_remove Any ^owner Str ^rows Any})

(type RegistryRow ^props {^row_id Str ^owner Str ^registry Str ^key Str ^payload Any ^priority Int ^config_order Int ^acquired Int ^effects Any? ^cleanup_state Any?})

(type Harness ^props {^plugins Any ^plugin_errors Any ^log Any ^log_hydrated Any ^bus Any ^registries Any ^ledger Any ^row_index Any ^next_row_id Any ^event_store Any ^event_scope Str ^event_stream Str ^plugin_policies Any ^plugin_depth Any ^workspace Any ^ui_epoch Str? ^readiness Any? ^registry_observer Any? ^composition Any? ^composition_entries Any? ^snapshots Any? ^publishing Any? ^published_plugins Any? ^notifications Any? ^ui_action_log Any?})

(type Host ^props {^h Harness ^owner Str ^effects Any ^notification_revision Str})

(type GuardedHandler ^^private ^props {^h Harness ^owner Str ^handler Any})

(type GuardedView ^^private ^props {^h Harness ^owner Str ^view Any})

(impl Callable for GuardedHandler
  (message apply [self call]
    (invoke_owned_callable self/h self/owner self/handler [((Path 0) call)])))

# One `invoke_owned_callable` per message, so both halves of a turn get a fresh
# deadline and a fresh step/memory budget under the owner's policy. A view that
# owned its own loop drew one budget for the whole conversation; a view that
# also owned the read drew one for the human's thinking time. Neither of these
# two calls can block on a person, so a wall-clock deadline finally measures
# something the plugin controls.
(fn guarded_view_prompt [bundle]
  (bundle/view .HarnessView:show_prompt bundle/receiver))

(fn guarded_view_line [bundle]
  (bundle/view .HarnessView:handle_line bundle/receiver bundle/line))

(impl HarnessView for GuardedView
  (message show_prompt [h] : Any
    (invoke_owned_callable
      self/h
      self/owner
      guarded_view_prompt
      [{^view self/view ^receiver (callback_receiver self/h self/owner)}]))
  (message handle_line [h, line] : Any
    (invoke_owned_callable
      self/h
      self/owner
      guarded_view_line
      [{^view self/view ^receiver (callback_receiver self/h self/owner) ^line line}])))

# --- registry kernel -------------------------------------------------------

(fn fresh_list []
  ($thaw #[]))
(fn fresh_map []
  ($thaw #{}))

(fn copy_list [source]
  (var out (fresh_list))
  (for item in source
    (out .push item))
  out)

(fn registry_named [h : Harness, name : Str] : Registry
  (var registries h/registries/.get)
  (var found (registries .get name))
  (if (== found void)
    (fail (HarnessError ^message $"registry ${name} is not defined"))
    found))

(fn registry_exists? [h : Harness, name : Str] : Bool
  (var registries h/registries/.get)
  (!= (registries .get name) void))

(fn registry [h : Harness, name : Str, ^unique unique : Bool = false, ^ordered ordered : Bool = false, ^schema schema = nil, ^on_remove on_remove = nil, ^owner owner : Str = "core"] : Registry
  (if (queue_registry_change? h)
    (then
      (let placeholder
        (Registry ^name name ^unique unique ^ordered ordered ^schema schema ^on_remove on_remove ^owner owner ^rows ($cell [])))
      (queue_composition_change
        h/snapshots
        {
          ^id owner
          ^kind "registry"
          ^apply (fn []
                   (registry ^unique unique ^ordered ordered ^schema schema ^on_remove on_remove ^owner owner
                     h
                     name))})
      (return placeholder)))
  (if (serialize_registry_change? h)
    (return
      (registry_change
        h
        owner
        (fn []
          (registry ^unique unique ^ordered ordered ^schema schema ^on_remove on_remove ^owner owner
            h
            name)))))
  (var registries_cell h/registries)
  (var registries registries_cell/.get)
  (if_not (== (registries .get name) void)
    (fail (HarnessError ^message $"registry ${name} already defined")))
  (var created
    (Registry ^name name ^unique unique ^ordered ordered ^schema schema ^on_remove on_remove ^owner owner ^rows ($cell (fresh_list))))
  (registries .put name created)
  (registries_cell .set registries)
  (publish_direct_registry_change h)
  created)

(fn queue_registry_change? [h : Harness] : Bool
  (let context ($runtime/context))
  (&&
    (! ($absent? h/snapshots))
    (! ($absent? context))
    (! ($absent? context/turn))
    (== context/turn/state/.get "open")
    (! (&& (! ($absent? context/publication)) context/publication/.get))))

(fn serialize_registry_change? [h : Harness] : Bool
  (let context ($runtime/context))
  (&&
    (! ($absent? h/snapshots))
    (!= context/registry_step true)
    (! (&& (! ($absent? context/publication)) context/publication/.get))))

(fn registry_change [h : Harness, thunk]
  (run_composition_change
    h/snapshots
    (fn []
      (let context (?? ($runtime/context) {}))
      (let scoped ($thaw ($freeze_shallow context)))
      (scoped .put "registry_step" true)
      (let publication ($cell true))
      (scoped .put "publication" publication)
      (try
        ($runtime/with_context scoped thunk)
      ensure
        (publication .set false)))))

(fn registry_names [h : Harness]
  (var out (fresh_list))
  (let view (registry_read_view h))
  (let registries (if (== view void) h/registries/.get view))
  (for [name value] in registries
    (out .push ($to_str name)))
  out)

(fn next_registry_row_id [h : Harness, owner : Str, registry_name : Str] : Str
  (var n h/next_row_id/.get)
  (h/next_row_id .set (+ n 1))
  $"${owner}:${registry_name}:${n}")

(fn string_before? [left : Str, right : Str] : Bool
  (var a (($str/to_utf8 left) .to_list))
  (var b (($str/to_utf8 right) .to_list))
  (var limit (if (< a/.size b/.size) a/.size b/.size))
  (var i 0)
  (while (< i limit)
    (if_not (== a/%i b/%i) (return (< a/%i b/%i)))
    (set i (+ i 1)))
  (< a/.size b/.size))

(fn registry_row_before? [a : RegistryRow, b : RegistryRow] : Bool
  (if (!= a/priority b/priority)
    (< a/priority b/priority)
    (if (!= a/config_order b/config_order)
      (< a/config_order b/config_order)
      (if (!= a/owner b/owner)
        (string_before? a/owner b/owner)
        (string_before? a/row_id b/row_id)))))

(fn insert_registry_row [r : Registry, record : RegistryRow]
  (if_not r/ordered
    (r/rows
      .get
      ; .push record)
    (return nil))
  (var next (fresh_list))
  (var inserted false)
  (for current in r/rows/.get
    (if_yes (&& (! inserted) (registry_row_before? record current))
      (next .push record)
      (set inserted true))
    (next .push current))
  (if_not inserted (next .push record))
  (r/rows .set next))

(fn registry_read_view [h : Harness]
  (let context ($runtime/context))
  (let candidate
    (&&
      (! ($absent? context))
      (same? context/composition h/snapshots)
      (! ($absent? context/publication))
      context/publication/.get))
  (if (&& (! ($absent? h/snapshots)) (! candidate))
    (then
      (let snapshot (current_snapshot h/snapshots))
      (return snapshot/registries)))
  void)

(fn registry_row_records [h : Harness, registry_name : Str]
  (let view (registry_read_view h))
  (if_not (== view void)
    (let records (view .get registry_name))
    (if (== records void)
      (fail (HarnessError ^message $"registry ${registry_name} is not defined")))
    (return records))
  (var r (registry_named h registry_name))
  r/rows/.get)

(fn snapshot_registries [h : Harness]
  (let snapshot {})
  (for [name registry] in h/registries/.get
    (let records [])
    (for record in registry/rows/.get
      (records .push
        {
          ^row_id record/row_id
          ^owner record/owner
          ^plugin (?? (h/plugins/.get .get record/owner) nil)
          ^cleanup_state (?? record/cleanup_state nil)
          ^registry record/registry
          ^key record/key
          ^payload (immutable_view record/payload)
          ^priority record/priority
          ^config_order record/config_order
          ^acquired record/acquired
          ^effects record/effects}))
    (snapshot .put name records))
  snapshot)

(fn publish_registry_snapshot [h : Harness]
  (if_yes (&& (! ($absent? h/snapshots)) (! h/snapshots/closed/.get))
    (let plugins [])
    (let seen {})
    (for [id plugin] in h/plugins/.get
      (seen .put id true)
      (plugins .push
        {
          ^id ($to_str id)
          ^status (status_of h ($to_str id))
          ^provides plugin/provides
          ^requires plugin/requires}))
    (if_not ($absent? h/workspace)
      (for entry in h/workspace/entries/.get
        (if ($absent? (seen .get entry/id))
          (plugins .push
            {
              ^id entry/id
              ^status (if entry/disabled
                        "disabled"
                        "error")
              ^module_digest entry/module_digest
              ^error (h/workspace/errors/.get .get entry/id)}))))
    (let snapshot
      (publish_snapshot ^plugins plugins
        h/snapshots
        (snapshot_registries h)
        h/composition/.instances))
    (notify h (CompositionChanged ^revision snapshot/id)))
  nil)

(fn publish_direct_registry_change [h : Harness]
  (if (&& (! ($absent? h/snapshots)) (! h/publishing/.get)) (publish_registry_snapshot h))
  nil)

(fn rows [h : Harness, registry_name : Str]
  (var out (fresh_list))
  (for record in (registry_row_records h registry_name)
    (out .push record/payload))
  out)

(fn row_record [h : Harness, registry_name : Str, key : Str]
  (var found void)
  (for record in (registry_row_records h registry_name)
    (if (&& (== found void) (== record/key key)) (set found record)))
  found)

(fn row [h : Harness, registry_name : Str, key : Str]
  (var found (row_record h registry_name key))
  (if (== found void)
    void
    found/payload))

(fn ledger_record [h : Harness, owner : Str, row_id : Str]
  (var ledger_cell h/ledger)
  (var ledger ledger_cell/.get)
  (var owned (?? (ledger .get owner) (fresh_list)))
  (owned .push row_id)
  (ledger .put owner owned)
  (ledger_cell .set ledger))

(fn ledger_forget [h : Harness, owner : Str, row_id : Str]
  (var ledger_cell h/ledger)
  (var ledger ledger_cell/.get)
  (var kept (fresh_list))
  (for candidate in (?? (ledger .get owner) (fresh_list))
    (if_not (== candidate row_id) (kept .push candidate)))
  (if (== kept/.size 0)
    (ledger .delete owner)
    (ledger .put owner kept))
  (ledger_cell .set ledger))

(fn remove_registry_row [h : Harness, row_id : Str, ^cleanup cleanup = true]
  (var row_index_cell h/row_index)
  (var row_index row_index_cell/.get)
  (var record (row_index .get row_id))
  (if (== record void) (return false))
  (if (queue_registry_change? h)
    (then
      (queue_composition_change
        h/snapshots
        {
          ^id record/owner
          ^kind "removal"
          ^apply (fn []
                   (remove_registry_row ^cleanup cleanup h row_id))})
      (return true)))
  (if (serialize_registry_change? h)
    (return (registry_change h (fn [] (remove_registry_row ^cleanup cleanup h row_id)))))
  (var r (registry_named h record/registry))
  (var kept (fresh_list))
  (for candidate in r/rows/.get
    (if_not (== candidate/row_id row_id) (kept .push candidate)))
  (r/rows .set kept)
  (row_index .delete row_id)
  (row_index_cell .set row_index)
  (ledger_forget h record/owner row_id)
  (if_not ($absent? h/registry_observer) (h/registry_observer record/registry record/key))
  (if_yes cleanup
    (if_not ($absent? record/cleanup_state) (record/cleanup_state .set false))
    (if_not ($absent? r/on_remove)
      (invoke_owned_callable h r/owner r/on_remove [(callback_receiver h r/owner) record/payload])))
  (publish_direct_registry_change h)
  true)

(fn contribute
  [h : Harness, owner : Str, registry_name : Str, payload,
   ^key key = void,
   ^priority priority : Int = 0,
   ^config_order config_order : Int = 0,
   ^replace replace : Bool = false] : Str
  (if (queue_registry_change? h)
    (then
      (queue_composition_change h/snapshots {^id owner ^kind "contribution"
        ^apply (fn [] (contribute h owner registry_name payload ^key key ^priority priority ^config_order config_order ^replace replace))})
      (return $"queued:${owner}:${registry_name}")))
  (if (serialize_registry_change? h)
    (return (registry_change h (fn [] (contribute h owner registry_name payload ^key key ^priority priority ^config_order config_order ^replace replace)))))
  (if (== registry_name "commands")
    (then
      (let reserved_owner
        (if (["help" "run" "sh" "view"] .contains? payload/name)
          "core_commands"
          (if (["cancel" "stop" "restart"] .contains? payload/name)
            "core"
            (if (["new" "sessions"] .contains? payload/name) "cli"
              (if (== payload/name "repl") "repl" nil)))))
      (if (&& (! ($absent? reserved_owner))
              (!= owner reserved_owner))
        (fail (HarnessError ^message
          $"command ${payload/name} is reserved by ${reserved_owner}")))))
  (var r (registry_named h registry_name))
  (var checked
    (if ($absent? r/schema)
      payload
      (invoke_owned_callable h r/owner r/schema [payload])))
  (validate_discovery_metadata checked)
  (if_yes (== registry_name "event_types")
    (set checked (validate_event_type_owner owner checked)))
  # `Fn` is a type-level constructor for signatures, not a runtime value, and
  # `$head` of a function is the function itself — so a `(== ($head run) Fn)`
  # test both fails to resolve and could not answer the question. A row that
  # carries a `run` is the row that gets a supervision boundary; whether that
  # value is callable is settled when it is applied.
  (if_yes (&& (== registry_name "commands")
              (!= checked/run void)
              ($runtime/callable? checked/run))
    (var guarded (fresh_map))
    (for [name value] in checked (guarded .put name value))
    (guarded .put "run"
      (guard_callback h owner checked/run false))
    (set checked guarded))
  (if_yes (== registry_name "functions")
    (let guarded {})
    (for [name value] in checked (guarded .put name value))
    (guarded .put "signature" ($runtime/signature checked/fn))
    (guarded .put "fn" (guard_callback h owner checked/fn false))
    (set checked guarded))
  (if_yes (== registry_name "providers")
    (let guarded ($thaw ($freeze_shallow checked)))
    (for field in ["available" "configure" "prepare" "send"]
      (let callback (checked .get field))
      (if_not ($absent? callback)
        (guarded .put field (guard_callback h owner callback false))))
    (set checked guarded))
  (if_yes (== registry_name "input_modes")
    (let guarded ($thaw ($freeze_shallow checked)))
    (for field in ["classify" "run" "close"]
      (guarded .put field (guard_callback h owner (checked .get field) false)))
    (set checked guarded))
  (if_yes (== registry_name "hooks")
    (let guarded ($thaw ($freeze_shallow checked)))
    (guarded .put "run" (guard_callback h owner checked/run false))
    (set checked guarded))
  (if_yes (&& (== registry_name "prompt") (! ($absent? checked/render)))
    (let guarded ($thaw ($freeze_shallow checked)))
    (guarded .put "render" (guard_callback h owner checked/render false))
    (set checked guarded))
  (if_yes (&& (== registry_name "web_components") (! ($absent? checked/render)))
    (let guarded ($thaw ($freeze_shallow checked)))
    (guarded .put "render" (guard_callback h owner checked/render false))
    (set checked guarded))
  (if_yes (&& (== registry_name "seams")
              (!= checked/value void)
              ($runtime/callable? checked/value))
    (var guarded_seam_row (fresh_map))
    (for [name value] in checked (guarded_seam_row .put name value))
    (guarded_seam_row .put "value"
      (guard_callback h owner checked/value false))
    (set checked guarded_seam_row))
  (if_yes (== registry_name "views")
    (var guarded_view_row (fresh_map))
    (for [name value] in checked (guarded_view_row .put name value))
    (guarded_view_row .put "value"
      (view_provider (GuardedView ^h h ^owner owner ^view checked/value)))
    (set checked guarded_view_row))
  (var logical_key
    (if ($absent? key)
      (if (== registry_name "triggers")
        ($to_str checked/id)
        (if (== registry_name "hooks")
          $"${checked/point}/${checked/name}"
          (if (!= checked/name void) ($to_str checked/name) "")))
      ($to_str key)))
  (if (&& r/unique (== logical_key ""))
    (fail (HarnessError
      ^message $"registry ${registry_name} requires a logical key")))
  (var existing void)
  (for candidate in r/rows/.get
    (if (&& (== existing void) (== candidate/key logical_key))
      (set existing candidate)))
  (if_yes (&& (== registry_name "event_types") (!= existing void)
              (!= existing/owner owner))
    (fail (HarnessError
      ^message $"event type ${logical_key} is owned by ${existing/owner}")))
  (if_yes (&& r/unique (!= existing void) (! replace))
    (fail (HarnessError
      ^message $"registry ${registry_name} key ${logical_key} already exists")))
  (if_yes (&& r/unique (!= existing void))
    (remove_registry_row h existing/row_id))
  (var row_id (next_registry_row_id h owner registry_name))
  (var acquired h/next_row_id/.get)
  (var policy (policy_for_owner h owner))
  (var record
    (RegistryRow ^row_id row_id ^owner owner ^registry registry_name
                 ^key logical_key ^payload checked ^priority priority
                 ^config_order config_order ^acquired acquired ^effects policy/effects
                 ^cleanup_state (if ($absent? policy/effects) nil ($cell true))))
  (insert_registry_row r record)
  (var row_index_cell h/row_index)
  (var row_index row_index_cell/.get)
  (row_index .put row_id record)
  (row_index_cell .set row_index)
  (ledger_record h owner row_id)
  (if_not ($absent? policy/owned_rows)
    (policy/owned_rows/.get .push {^record record ^registry r}))
  (if_not ($absent? h/registry_observer)
    (h/registry_observer registry_name logical_key))
  (publish_direct_registry_change h)
  row_id)

(fn release_activation_rows [h : Harness, effects, owned_rows]
  # Rows leave in reverse acquisition order, then the revision's callbacks
  # expire. Every row is attempted; the first failure is reported afterwards.
  (var owned owned_rows/.get)
  (owned_rows .set (fresh_list))
  (var failure nil)
  (var i (- owned/.size 1))
  (while (>= i 0)
    (var entry owned/%i)
    (try
      (cleanup_owned_registry_row h entry/record entry/registry)
    catch Any
      (if ($absent? failure) (set failure $err)))
    (set i (- i 1)))
  (expire_scope_callbacks effects)
  (if_not ($absent? failure) (fail failure))
  nil)

(fn cleanup_owned_registry_row [h : Harness, record : RegistryRow, r : Registry]
  (if_not record/cleanup_state/.get (return nil))
  (record/cleanup_state .set false)
  (try
    (remove_registry_row h record/row_id ^!cleanup)
  ensure
    # Publication may already have removed this ID from discovery. Its owned
    # cleanup still runs once with the captured old payload and registry hook.
    (if_not ($absent? r/on_remove)
      (invoke_owned_callable h r/owner r/on_remove
        [(callback_receiver h r/owner) record/payload])))
  nil)

(fn guard_callback [h : Harness, owner : Str, callable, inject_context : Bool]
  (var policy (policy_for_owner h owner))
  # Rows contributed outside a Cordis activation are still bounded when
  # invoked; there is no activation revision to own them.
  (if ($absent? policy/effects) (return callable))
  # Same receiver rule as `callback_receiver`: host plugins receive the
  # Harness, generated plugins their context.
  (retain_callback policy/effects $"${owner}/callback" callable
    ^host_context (if policy/host h policy/context)
    ^inject_context inject_context))

(fn remove_owner [h : Harness, owner : Str]
  (if (queue_registry_change? h)
    (then
      (queue_composition_change
        h/snapshots
        {^id owner ^kind "removal" ^apply (fn [] (remove_owner h owner))})
      (return [])))
  (if (serialize_registry_change? h) (return (registry_change h (fn [] (remove_owner h owner)))))
  (var ledger h/ledger/.get)
  (var owned (?? (ledger .get owner) (fresh_list)))
  (var errors (fresh_list))
  (var i (- owned/.size 1))
  (while (>= i 0)
    (try
      (remove_registry_row h owned/%i)
    catch Any
      (errors .push ($to_str $err/message)))
    (set i (- i 1)))
  (var owned_registries (fresh_list))
  (for [name r] in h/registries/.get
    (if (&& (== r/owner owner) (!= name "seams") (!= name "commands") (!= name "prompt") (!= name "views") (!= name "event_types") (!= name "subscriptions"))
      (owned_registries .push ($to_str name))))
  (for name in owned_registries
    (var registry_errors (remove_registry h name))
    (for message in registry_errors
      (errors .push message)))
  errors)

(fn remove_registry [h : Harness, name : Str]
  (var r (registry_named h name))
  (if (== r/owner "core") (fail (HarnessError ^message $"core registry ${name} cannot be removed")))
  (if (queue_registry_change? h)
    (then
      (queue_composition_change
        h/snapshots
        {^id r/owner ^kind "removal" ^apply (fn [] (remove_registry h name))})
      (return [])))
  (if (serialize_registry_change? h) (return (registry_change h (fn [] (remove_registry h name)))))
  (var errors (fresh_list))
  (var records (copy_list r/rows/.get))
  (var i (- records/.size 1))
  (while (>= i 0)
    (try
      (remove_registry_row h records/%i/row_id)
    catch Any
      (errors .push ($to_str $err/message)))
    (set i (- i 1)))
  (var registries_cell h/registries)
  (var registries registries_cell/.get)
  (registries .delete name)
  (registries_cell .set registries)
  (publish_direct_registry_change h)
  errors)

(fn clone_registries [h : Harness]
  (var out (fresh_map))
  (for [name source] in h/registries/.get
    (var cloned
      (Registry ^name source/name ^unique source/unique ^ordered source/ordered ^schema source/schema ^on_remove source/on_remove ^owner source/owner ^rows ($cell (copy_list source/rows/.get))))
    (out .put name cloned))
  out)

(fn clone_ledger [h : Harness]
  (var out (fresh_map))
  (for [owner row_ids] in h/ledger/.get
    (out .put owner (copy_list row_ids)))
  out)

(fn clone_row_index [h : Harness]
  (var out (fresh_map))
  (for [row_id record] in h/row_index/.get
    (out .put row_id record))
  out)

# Cordis owns plugin lifecycle; this host owns the registry collections plugins
# activate into. Activations contribute to the live tables and each revision's
# single deferred cleanup removes exactly its rows and callbacks, so reconciles
# need no registry draft and an unchanged plugin stays live across them.
(type CordisRegistryHost ^^private
  ^props {^h Harness}
  (impl RegistryHost
    (message activate [thunk] : Any
      (let publication ($cell true))
      (try
        ($runtime/with_context {^composition self/h/snapshots ^publication publication
          ^output (fn [text]
            (if_not ($absent? self/h/event_store)
              (append_core_event self/h/event_store "workspace" "workspace"
                {^type "console" ^turn 0 ^text text ^!late ^^ignorable}))
            ($runtime/with_context nil (fn [] ($print text))))} thunk)
      ensure (publication .set false)))
    (message enter_call [] : Nil (enter_plugin_execution self/h) nil)
    (message leave_call [] : Nil (leave_plugin_execution self/h) nil)
    (message describe [module, id : Str, limits] : Plugin
      (var h self/h)
      (var bounded (ExecutionLimits ^max_steps limits/max_steps
        ^max_memory_mb limits/max_memory_mb ^timeout_ms limits/timeout_ms))
      (configure_plugin_module module (response_execution_limits))
      (describe_plugin_module h module id
        ^core_interface (if ($absent? h/workspace) "" h/workspace/core_interface)
        ^limits bounded))
    (message context [plugin, effects, observer, policy] : PluginHost
      (var h self/h)
      (set h/registry_observer observer)
      (var context (Host ^h h ^owner plugin/id ^effects effects ^notification_revision ($crypto/random_hex 16)))
      (var owned_rows ($cell (fresh_list)))
      (h/plugin_policies/.get .put plugin/id
        {^limits (ExecutionLimits ^max_steps policy/limits/max_steps
           ^max_memory_mb policy/limits/max_memory_mb ^timeout_ms policy/limits/timeout_ms)
         ^host policy/host ^context context ^effects effects ^owned_rows owned_rows})
      # One deferred cleanup per activation revision. Cordis runs every deferred
      # cleanup as a bounded plugin invocation, so a cleanup per contributed row
      # and per callback made retiring a generation cost one invocation per row.
      (effects .defer (fn []
        (try (release_activation_rows h effects owned_rows)
        ensure (release_activation_policy h plugin/id context))))
      context)
    (message selected [registry_name : Str, key : Str] : Any
      (var h self/h)
      (if_not (registry_exists? h registry_name) (return nil))
      (var selected (row_record h registry_name key))
      (if (== selected void) (return nil))
      {^row_id selected/row_id ^payload selected/payload ^effects selected/effects})))

(fn make_cordis_registry_host [h : Harness] : RegistryHost
  (CordisRegistryHost ^h h))

(fn release_activation_policy [h : Harness, owner : Str, context : Host]
  (var policies h/plugin_policies/.get)
  (var current (policies .get owner))
  (if_yes (&& (!= current void) (== current/context context)) (policies .delete owner))
  nil)

(fn validate_seam_row [candidate]
  (if (|| (== candidate/name void) (== candidate/value void))
    (fail (HarnessError ^message "a seam row requires ^name and ^value"))
    candidate))

(fn validate_command_row [candidate]
  (if (|| (== candidate/name void) (== candidate/doc void) (== candidate/run void))
    (fail (HarnessError ^message "a command row requires name doc run"))
    candidate))

(fn validate_function_row [candidate]
  (if (|| ($absent? candidate/name) (== candidate/name "") ($absent? candidate/doc) (! ($runtime/callable? candidate/fn)))
    (fail (HarnessError ^message "a function row requires name, doc and a callable fn")))
  (if (["discover" "doc"] .contains? candidate/name)
    (fail
      (HarnessError ^message $"function ${candidate/name} is reserved by the shared discovery context")))
  candidate)

(fn validate_input_mode_row [candidate]
  (for field in ["name" "label" "hint" "submit_label" "prompt"]
    (let value (candidate .get field))
    (if (|| (!= ($head value) Str) (== value ""))
      (fail (HarnessError ^message $"an input mode needs a non-empty ${field}"))))
  (for field in ["classify" "run" "close"]
    (if_not ($runtime/callable? (candidate .get field))
      (fail (HarnessError ^message $"an input mode needs a callable ${field}"))))
  candidate)

(fn validate_provider_row [candidate]
  (if (|| ($absent? candidate/name) (== candidate/name "") ($absent? candidate/doc) (! ($runtime/callable? candidate/configure)) (! ($runtime/callable? candidate/prepare)) (! ($runtime/callable? candidate/send)) (&& (! ($absent? candidate/available)) (! ($runtime/callable? candidate/available))) (&& (! ($absent? candidate/auto)) (!= ($head candidate/auto) Int)))
    (fail (HarnessError ^message "a provider row needs name, doc, configure, prepare and send")))
  candidate)

(fn validate_hook_row [candidate]
  (if (|| ($absent? candidate/name) (== candidate/name "") (! (["request/prepare" "history/compact"] .contains? candidate/point)) (! ($runtime/callable? candidate/run)))
    (fail (HarnessError ^message "a hook row needs point, name and a callable run")))
  candidate)

(fn validate_trigger_row [candidate]
  (if (|| (!= ($head candidate/id) Str) (!= ($head candidate/request) Str) (! (["heartbeat" "scheduled" "cron"] .contains? candidate/kind)))
    (fail (HarnessError ^message "a trigger row requires id, kind and request")))
  candidate)

(fn validate_interaction_row [candidate]
  (if (|| ($absent? candidate/name) (! ($runtime/callable? candidate/validate_request)) (! ($runtime/callable? candidate/validate_reply)))
    (fail (HarnessError ^message "an interaction needs a name and request/reply validators")))
  candidate)

(fn validate_view_row [candidate]
  (if (|| (== candidate/name void) (== candidate/value void))
    (fail (HarnessError ^message "a view row requires name and value")))
  (view_provider candidate/value)
  candidate)

(fn validate_prompt_row [candidate]
  (if (|| (== candidate/name void) (== ($absent? candidate/text) ($absent? candidate/render)) (&& (! ($absent? candidate/render)) (! ($runtime/callable? candidate/render))))
    (fail
      (HarnessError ^message "a prompt row requires name and exactly one of text or callable render")))
  candidate)

(fn validate_discovery_metadata [candidate]
  (if (&& (! ($absent? candidate/summary)) (!= ($head candidate/summary) Str))
    (fail (HarnessError ^message "a discovery summary must be a string")))
  (for field in ["tags" "docs"]
    (let values (candidate .get field))
    (if_not ($absent? values)
      (if (!= ($head values) List)
        (fail (HarnessError ^message $"discovery ${field} must be a list of strings")))
      (for value in values
        (if (|| (!= ($head value) Str) (== ($str/trim value) ""))
          (fail (HarnessError ^message $"discovery ${field} must contain nonempty strings"))))))
  candidate)

(fn validate_docs_row [candidate]
  (if (|| (== candidate/name void) (== ($absent? candidate/text) ($absent? candidate/path)) (&& (! ($absent? candidate/text)) (!= ($head candidate/text) Str)) (&& (! ($absent? candidate/path)) (!= ($head candidate/path) Str)))
    (fail (HarnessError ^message "a docs row requires name and exactly one of text or path")))
  candidate)

(fn validate_event_type_row [candidate]
  (if (|| (== candidate/name void) (== candidate/version void) (== candidate/ignorable void))
    (fail (HarnessError ^message "an event type row requires name version ignorable")))
  (if_yes (&& (!= candidate/schema void) (! ($runtime/callable? candidate/schema)))
    (fail (HarnessError ^message "event type schema must be callable")))
  candidate)

(fn validate_event_type_owner [owner : Str, candidate]
  (if (== owner "core")
    (then
      (if_not (&& (== candidate/origin "core") (== candidate/owner "core"))
        (fail (HarnessError ^message "core event rows must be stamped core/core"))))
    (else
      (if_not (== candidate/origin "plugin")
        (fail (HarnessError ^message "plugins cannot declare core event origin")))
      (var declared_owner ($to_str candidate/owner))
      (if_not (|| (== declared_owner owner) (== owner $"descriptor:${declared_owner}"))
        (fail
          (HarnessError ^message $"event owner ${declared_owner} does not match contributor ${owner}")))))
  candidate)

(fn cancel_subscription_row [context, candidate]
  candidate/sub/.cancel)

# Harness events. A plugin observes the harness through the event bus rather
# than by being called back, because observation is what the bus is for and
# substitution is what the seams are for (design §2.2). The lifecycle is the
# first thing worth observing: a plugin can watch its own dependencies come and
# go without the kernel knowing anything about it.
(type HarnessLog : HarnessEvent ^props {^kind Str ^text Str ^record Any?})
(type HarnessFlushed : HarnessEvent ^props {^through Int})
(type RoundChanged : HarnessEvent ^props {^session Str ^receipt Any})
(type CommandChanged : HarnessEvent ^props {^session Str ^record Any})
(type ModeChanged : HarnessEvent ^props {^session Str ^mode Any ^instance Any ^running Any ^reason Str})
(type SessionChanged : HarnessEvent ^props {^record Any})
(type CompositionChanged : HarnessEvent ^props {^revision Int})

(type PluginInstalled : HarnessEvent ^props {^plugin Str})
(type PluginActivated : HarnessEvent ^props {^plugin Str})
(type PluginDeactivated : HarnessEvent ^props {^plugin Str ^reason Str})
(type PluginFailed : HarnessEvent ^props {^plugin Str ^message Str})
(type PluginUninstalled : HarnessEvent ^props {^plugin Str})

(fn new_harness
  [^event_store event_store = nil,
   ^event_scope event_scope : Str = "session",
   ^event_stream event_stream : Str = "default",
   ^workspace workspace = nil,
   ^limits limits = nil] : Harness
  (var h
    (Harness ^plugins ($cell (fresh_map))
             ^plugin_errors ($cell (fresh_map))
             ^log ($cell (fresh_list)) ^log_hydrated ($cell false)
             ^bus ($event/Bus ^error_policy $event/collect)
             ^registries ($cell (fresh_map)) ^ledger ($cell (fresh_map))
             ^row_index ($cell (fresh_map)) ^next_row_id ($cell 1)
             ^event_store event_store
             ^event_scope event_scope ^event_stream event_stream
             ^plugin_policies ($cell (fresh_map))
             ^plugin_depth ($cell 0) ^workspace workspace ^ui_epoch ($crypto/random_hex 12)))
  (registry h "seams" ^^unique ^schema validate_seam_row)
  (registry h "commands" ^^unique ^schema validate_command_row)
  (registry h "input_modes" ^^unique ^schema validate_input_mode_row)
  (registry h "functions" ^^unique ^schema validate_function_row)
  (registry h "providers" ^^unique ^schema validate_provider_row)
  (registry h "hooks" ^^unique ^^ordered ^schema validate_hook_row)
  (registry h "triggers" ^^unique ^schema validate_trigger_row)
  (registry h "interactions" ^^unique ^schema validate_interaction_row)
  (registry h "prompt" ^!unique ^^ordered ^schema validate_prompt_row)
  (registry h "docs" ^^unique ^schema validate_docs_row)
  (registry h "views" ^^unique ^schema validate_view_row)
  (registry h "web_components" ^^unique ^^ordered ^schema validate_web_component)
  (registry h "event_types" ^^unique ^schema validate_event_type_row)
  (registry h "subscriptions" ^!unique
    ^on_remove cancel_subscription_row)
  (for event in core_event_types
    (contribute h "core" "event_types" event))
  # Plugin lifecycle is a Cordis composition. Activation happens in a staged
  # candidate that publishes as a whole, and every contribution belongs to the
  # exact activation revision that made it. `^limits` is the ceiling every
  # plugin's limits narrow from.
  (set h/composition_entries ($cell (fresh_map)))
  (var package_root (module_dir (module_dir this_mod/.path)))
  (set h/publishing ($cell false))
  (set h/published_plugins ($cell {}))
  (set h/snapshots (new_composition_state (snapshot_registries h) []
    (fn [ticket] (h/composition .retire ticket))))
  (set h/composition
    (new_composition (make_cordis_registry_host h)
      ^limits (if ($absent? limits)
        (response_execution_limits)
        limits)
      ^options (LoaderOptions
        ^plugin_root (if ($absent? workspace) $"${package_root}/plugins/generated" workspace/generated_dir)
        ^shared ["src/plugin_api.gene"]
        ^max_namespaces ($runtime/sandbox_namespaces)
        ^default_limits nil ^reload_policy nil
        ^retirement (fn [ticket]
          (queue_retirement h/snapshots ticket ticket/.instances)))))
  (publish_registry_snapshot h)
  (if_not ($absent? event_store)
    (set event_store/observer
      (fn [envelope]
        (publish h
          (DurableRecord ^scope envelope/scope ^stream envelope/stream
            ^name envelope/type ^envelope envelope)))))
  h)

(fn reconcile_cordis_harness [h : Harness]
  (while (h/publishing .swap true)
    ($sleep 1))
  (let publication ($cell true))
  (try
    ($runtime/with_context
      {^composition h/snapshots ^publication publication}
      (fn []
        (reconcile_cordis_harness_serial h)))
  ensure
    (publication .set false)
    (h/publishing .set false)))

(fn hide_owner_rows [h : Harness, owner : Str]
  (let ids (copy_list (?? (h/ledger .get; .get owner) [])))
  (for id in ids
    (remove_registry_row ^!cleanup h id))
  nil)

(fn reconcile_cordis_harness_serial [h : Harness]
  (let baseline h/registries/.get)
  (let baseline_ledger h/ledger/.get)
  (let baseline_index h/row_index/.get)
  (let baseline_policies h/plugin_policies/.get)
  (let baseline_observer h/registry_observer)
  (try
    (reconcile_registry_candidate h)
  catch Any
    (h/registries .set baseline)
    (h/ledger .set baseline_ledger)
    (h/row_index .set baseline_index)
    (h/plugin_policies .set baseline_policies)
    (set h/registry_observer baseline_observer)
    (fail $err)))

(fn reconcile_registry_candidate [h : Harness]
  (let previous h/published_plugins/.get)
  (h/registries .set (clone_registries h))
  (h/ledger .set (clone_ledger h))
  (h/row_index .set (clone_row_index h))
  (h/plugin_policies .set ($thaw ($freeze_shallow h/plugin_policies/.get)))
  (set h/registry_observer nil)
  # Cordis stages every loader-owned activation revision. Remove their
  # discoverable rows from the candidate while old snapshot rows and effects
  # remain usable until their retirement tickets drain.
  (for [id prior] in previous
    (hide_owner_rows h ($to_str id)))
  (let departed_registries [])
  (for [name registry] in h/registries/.get
    (if (!= (previous .get registry/owner) void)
      (departed_registries .push ($to_str name))))
  (for name in departed_registries
    (let registry (registry_named h name))
    (for record in (copy_list registry/rows/.get)
      (remove_registry_row h record/row_id ^!cleanup))
    (h/registries/.get .delete name))
  (var plugins (fresh_list))
  (var failed (fresh_list))
  (for [id plugin] in h/plugins/.get (plugins .push plugin))
  (for [id message] in h/plugin_errors/.get (failed .push ($to_str id)))
  # Reconcile the candidate before publishing its immutable registry view.
  # A rejected candidate leaves the previous registry tables and leases live.
  (var result
    (h/composition .reconcile_available plugins h/composition_entries/.get failed))
  (for failure in result/failures
    (h/plugin_errors/.get .put failure/id failure/message))
  (let active h/composition/.current_plugins)
  (h/published_plugins .set active)
  (publish_registry_snapshot h)
  result/snapshot)

(fn put_cordis_plugin [h : Harness, plugin : Plugin, entry_options, ^replace replace : Bool = false]
  (if ($absent? h/composition) (fail (HarnessError ^message "Harness has no Cordis composition")))
  (if_yes (&& (! replace) (!= (h/plugins .get; .get plugin/id) void))
    (fail (HarnessError ^message $"plugin ${plugin/id} already installed")))
  (validate_plugin_descriptor h plugin/id plugin)
  (h/plugins
    .get
    ; .put plugin/id plugin)
  (h/composition_entries
    .get
    ; .put plugin/id entry_options)
  (h/plugin_errors
    .get
    ; .delete plugin/id)
  (try
    (reconcile_cordis_harness h)
  catch Any
    (h/plugin_errors
      .get
      ; .put plugin/id ($to_str $err)))
  (status_of h plugin/id))

(fn put_cordis_plugins [h : Harness, admissions]
  # Boot stages every profile plugin and reconciles once. A plugin whose
  # activation fails is recorded by the reconcile itself; only a failure of the
  # reconcile as a whole marks every admission.
  (if ($absent? h/composition)
    (fail (HarnessError ^message "Harness has no Cordis composition")))

  (for admission in admissions
    (var plugin admission/plugin)
    (if_yes (!= (h/plugins/.get .get plugin/id) void)
      (fail (HarnessError ^message $"plugin ${plugin/id} already installed")))
    (validate_plugin_descriptor h plugin/id plugin))
  (for admission in admissions
    (var plugin admission/plugin)
    (h/plugins/.get .put plugin/id plugin)
    (h/composition_entries/.get .put plugin/id admission/options)
    (h/plugin_errors/.get .delete plugin/id))
  (try
    (reconcile_cordis_harness h)
  catch Any
    (var failure ($to_str $err))
    (for admission in admissions
      (h/plugin_errors/.get .put admission/plugin/id failure)))
  (for admission in admissions
    (var id admission/plugin/id)
    (log_append h "lifecycle" $"installed ${id} (${(status_of h id)})"))
  nil)

(fn hydrate_harness_log [h : Harness]
  (if_yes h/log_hydrated/.get (return))
  (if_not ($absent? h/event_store)
    (for envelope in (events_for h/event_store h/event_scope h/event_stream)
      (if_yes (["lifecycle" "message" "output" "trace"] .contains? ($to_str envelope/type))
        (if_not (== envelope/payload/text void)
          (var record {^kind envelope/type ^text envelope/payload/text ^seq envelope/seq})
          (for name in ["truncated" "original_bytes"]
            (if_not (== (envelope/payload .get name) void)
              (record .put name (envelope/payload .get name))))
          (h/log
            .get
            ; .push record)))))
  (h/log_hydrated .set true)
  h/log/.get)

# The kernel log records lifecycle and plugin diagnostics. Session transcripts
# and model history are owned by the round loop.

(fn log_event_payload [record]
  (var payload {^type record/kind ^text record/text})
  (if_yes (== record/truncated true)
    (payload .put "truncated" true)
    (payload .put "original_bytes" record/original_bytes))
  payload)

(fn text_prefix [text : Str, maximum : Int] : Str
  (if (<= ($str/byte_size text) maximum) (return text))
  (var end maximum)
  (while (> end 0)
    (var prefix (try ($str/slice_bytes text 0 end) catch Any nil))
    (if_not ($absent? prefix) (return prefix))
    (set end (- end 1)))
  "")

(fn bounded_log_record [h : Harness, record]
  (var original record/text)
  (var size ($str/byte_size original))
  (var limit 65536)
  (while true
    (if_yes (> size limit)
      (var marker $"\n[truncated; original ${size} bytes]")
      (record .put "text"
        $"${(text_prefix original ($math/max 0 (- limit ($str/byte_size marker))))}${marker}")
      (record .put "truncated" true)
      (record .put "original_bytes" size))
    # Check the serialized envelope too: escaping can exceed the byte cap.
    (if (|| ($absent? h/event_store)
            (<= (core_event_size h/event_scope h/event_stream (log_event_payload record))
                h/event_store/max_event_bytes))
      (return record))
    (if (== limit 0)
      (fail (HarnessError ^message "log metadata exceeds the event byte limit")))
    (set limit (/ ($math/min limit size) 2))))

(fn log_record [h : Harness, kind : Str, text : Str]
  (bounded_log_record h {^kind kind ^text text}))

(fn append_log_record [h : Harness, record] : Any
  (var events h/log/.get)
  (events .push record)
  # Views observe the same typed feed core persists. Publication errors are
  # collected by the bus and intentionally do not recursively append another
  # log record.
  (publish h (HarnessLog ^kind record/kind ^text record/text ^record record))
  events)

(fn append_log_only [h : Harness, kind : Str, text : Str] : Any
  (append_log_record h {^kind kind ^text text}))

(fn append_committed_record [h : Harness, record] : Any
  (if_not ($absent? h/event_store)
    (var payload (log_event_payload record))
    (var envelope (append_core_event h/event_store h/event_scope h/event_stream payload))
    (record .put "seq" envelope/seq))
  (append_log_record h record))

(fn append_committed_log [h : Harness, kind : Str, text : Str] : Any
  (append_committed_record h (log_record h kind text)))

(fn record_turn_start [h : Harness, id : Str]
  (append_log_only h "turn" $"started ${id}")
  (if_not ($absent? h/event_store)
    (append_core_event h/event_store h/event_scope h/event_stream {^type "turn/start" ^turn id}))
  nil)

(fn record_turn_end [h : Harness, id : Str, reason : Str, ^synthetic synthetic : Bool = false]
  (if_yes (&& (== reason "interrupted") (! synthetic))
    (fail (HarnessError ^message "interrupted turn boundaries are reserved for cold repair")))
  (append_log_only h "turn" $"${reason} ${id}")
  (if_not ($absent? h/event_store)
    (append_core_event
      h/event_store
      h/event_scope
      h/event_stream
      {^type "turn/end" ^turn id ^reason reason ^synthetic synthetic}))
  nil)

(fn record_composition_change [h : Harness, id : Str, previous_digest, new_digest, revision : Int, turn : Str, operation : Str]
  (append_log_only h "composition" $"${operation} ${id} at revision ${revision}")
  (if_not ($absent? h/event_store)
    (append_core_event
      h/event_store
      h/event_scope
      h/event_stream
      {
        ^type "composition/changed"
        ^entry id
        ^operation operation
        ^previous_digest (?? previous_digest "")
        ^new_digest (?? new_digest "")
        ^revision revision
        ^session h/event_stream
        ^turn turn}))
  nil)

(fn log_append [h : Harness, kind : Str, text : Str] : Any
  (var record (log_record h kind text))
  (append_committed_record h record))

(fn flush_harness [h : Harness]
  (if_not ($absent? h/event_store)
    (var flushed (flush_event_store h/event_store))
    (var next (h/event_store/next_sequences .get; .get $"${h/event_scope}:${h/event_stream}"))
    (publish h (HarnessFlushed ^through (- (?? next 1) 1)))
    flushed))

# --- seams -----------------------------------------------------------------

(fn provide [h : Harness, id : Str, seam : Str, value] : Str
  # Binding is explicit: a seam already bound is refused rather than shadowed.
  # There is no last-wins, so no registration order decides behaviour.
  (if_yes (seam_bound h seam)
    (fail (HarnessError ^message $"seam ${seam} already bound; replace it explicitly")))
  (contribute h id "seams" {^name seam ^value value} ^key seam)
  (if_not h/publishing/.get (reconcile_cordis_harness h))
  seam)

(fn replace [h : Harness, id : Str, seam : Str, value] : Str
  # §3.3.3: a bound seam is never shadowed by a second `provide`, because then
  # registration order would decide behaviour. Replacement is this — a named
  # operation the operator asked for.
  #
  # The ledger moves with the binding. Without that, uninstalling the *previous*
  # owner would unbind a seam it no longer provides, and the new provider would
  # vanish for a reason nothing in the log explains.
  #
  # Note this is also why a dependent does not churn across a provider swap:
  # the seam stays bound throughout, so `requires` never goes unmet and no
  # dependent is deactivated for a substitution it was never meant to notice.
  (if_not (seam_bound h seam)
    (fail (HarnessError ^message $"seam ${seam} is not bound; provide it first")))
  (contribute h id "seams" {^name seam ^value value}
    ^key seam ^^replace)
  (if_not h/publishing/.get (reconcile_cordis_harness h))
  seam)

(fn resolve [h : Harness, seam : Str] : Any
  (var found (row h "seams" seam))
  (if_yes (== found void) (fail (HarnessError ^message $"no provider for seam ${seam}")))
  found/value)

(fn withdraw_seam [h : Harness, owner : Str, seam : Str] : Bool
  (let record (row_record h "seams" seam))
  (if ($absent? record) (return false))
  (if_not (== record/owner owner)
    (fail (HarnessError ^message $"seam ${seam} belongs to ${record/owner}")))
  (remove_registry_row h record/row_id)
  (if_not h/publishing/.get (reconcile_cordis_harness h))
  true)

(fn seam_bound [h : Harness, seam : Str] : Bool
  # Asking without committing. `resolve` raises, which is right for a consumer
  # that cannot proceed without the seam and wrong for a caller deciding whether
  # a deployment offers something at all.
  (!= (row h "seams" seam) void))

(fn bound_seams [h : Harness] : Any
  (var out (fresh_list))
  (for candidate in (rows h "seams")
    (out .push ($to_str candidate/name)))
  out)

(fn doc [h : Harness, name : Str, ^snapshot snapshot = nil] : Str
  (let chapters
    (if ($absent? snapshot)
      (rows h "docs")
      ($map (?? (snapshot/registries .get "docs") []) (fn [record] record/payload))))
  (let names [])
  (for chapter in chapters
    (if_yes (== chapter/name name)
      (if_not ($absent? chapter/text) (return chapter/text))
      (return ($fs/read_text chapter/path)))
    (names .push chapter/name))
  (let listed ($str/join names ", "))
  (fail
    (HarnessError ^message $"unknown documentation ${name}; valid chapters: ${listed}. Use (discover \"topic\" ^kind \"docs\") to find the relevant chapter.")))

# --- observation (design §2.2: the bus is for observing, seams for swapping) -

(fn subscribe [h : Harness, id : Str, selector, handler] : Any
  # A plugin's subscription is an effect like any other: recorded against the
  # plugin id, and cancelled by `unwind` without the plugin's cooperation. A
  # listener that outlived its plugin is the classic plugin-system leak, and
  # the ledger is what makes it structurally impossible here.
  (var guarded (GuardedHandler ^h h ^owner id ^handler handler))
  (var sub (h/bus .subscribe selector guarded))
  (contribute h id "subscriptions" {^name "" ^sub sub})
  sub)

# --- plugin descriptor -------------------------------------------------

(fn validate_plugin_descriptor [h : Harness, expected_id : Str, p : Plugin]
  (if_not (== p/id expected_id)
    (fail (HarnessError
      ^message $"plugin descriptor id ${p/id} does not match ${expected_id}")))
  (if_not ($runtime/callable? p/activate)
    (fail (HarnessError ^message "plugin activate must be callable")))
  (for requirement in (?? p/requires (fresh_list))
    # Requirements accept the seam shorthand and the explicit
    # [registry key] pair. Validate the registry vocabulary without requiring
    # the row to be present yet; absence is the lifecycle's `pending` state.
    (if (== ($head requirement) List)
      (then
        (if_not (== requirement/.size 2)
          (fail (HarnessError ^message "plugin requirement pair needs registry and key")))
        (registry_named h ($to_str requirement/0)))
      (else (registry_named h "seams"))))
  p)

(fn invoke_bounded [callable, argument, limits : ExecutionLimits]
  (var program (quote ($runtime/guard_call callable argument)))
  (var guarded
    (eval ^in (env ^bindings {^callable callable ^argument argument} ^imports [$runtime] ^policy {^max_steps limits/max_steps ^max_memory_mb limits/max_memory_mb ^timeout_ms limits/timeout_ms})
      program))
  (if guarded/ok
    guarded/value
    (fail (HarnessError ^message $"plugin panic: ${guarded/message}"))))

(fn apply_argument_list [bundle]
  (bundle/callable bundle/args...))

(fn invoke_supervised [callable, args, limits : ExecutionLimits]
  (let outcome (supervised_call callable args limits))
  (match ^!exhaustive outcome
    (when (TaskOutcome/ok value)
      value)
    (when (TaskOutcome/error error)
      (fail error))
    (when (TaskOutcome/panic message)
      (fail (HarnessError ^message $"plugin panic: ${message}")))
    (when TaskOutcome/cancelled
      (fail (HarnessError ^message "plugin invocation was cancelled or exceeded its deadline")))))

(fn configure_plugin_module [module, limits : ExecutionLimits]
  (var policy
    {^max_steps limits/max_steps ^max_memory_mb limits/max_memory_mb ^timeout_ms limits/timeout_ms})
  (var program (quote ($runtime/configure_module module policy)))
  (eval ^in (env ^bindings {^module module ^policy policy} ^imports [$runtime]) program))

(fn policy_for_owner [h : Harness, owner : Str]
  (var policy (h/plugin_policies .get; .get owner))
  (if (== policy void)
    {^limits (default_execution_limits) ^^host ^context nil}
    policy))

(fn callback_receiver [h : Harness, owner : Str]
  (var policy (policy_for_owner h owner))
  (if policy/host
    h
    (if ($absent? policy/context)
      (fail (HarnessError ^message $"plugin ${owner} callback context is unavailable"))
      policy/context)))

(fn enter_plugin_execution [h : Harness]
  (h/plugin_depth .set (+ h/plugin_depth/.get 1)))

(fn leave_plugin_execution [h : Harness]
  (var depth (- h/plugin_depth/.get 1))
  (h/plugin_depth .set depth)
  (if_yes (&& (== depth 0) (! ($absent? h/event_store))) (flush_event_store h/event_store)))

(fn invoke_owned_callable [h : Harness, owner : Str, callable, args]
  (var policy (policy_for_owner h owner))
  (enter_plugin_execution h)
  (try
    (if (retained_callback? callable)
      # Cordis already applies the contributing revision's limits, by joining a
      # supervised task. Wrapping that in a second bounded evaluator would make
      # the join suspend outside a fiber.
      (apply_argument_list {^callable callable ^args args})
      (invoke_supervised callable args policy/limits))
  ensure
    # PluginHost state mutations are queued while the bounded callback is
    # active. Flush only after it has unwound, at the core boundary that owns
    # the retained Store.
    (leave_plugin_execution h)))

(fn describe_plugin_module [h : Harness, module, expected_id : Str, ^core_interface core_interface : Str = "", ^limits limits = nil] : Plugin
  (var context (DescriptorContext ^module_id expected_id ^core_interface core_interface))
  (var bounded (if ($absent? limits) (default_execution_limits) limits))
  (var p (invoke_bounded module/init context bounded))
  (validate_plugin_descriptor h expected_id p))

(fn registry_row_keys [h : Harness, registry_name : Str]
  (var out (fresh_list))
  (for record in (registry_row_records h registry_name)
    (out .push record/key))
  out)

(impl PluginHost for Host
  (message notify [message] : Any
    (safe_publish ^revision self/notification_revision self/h self/owner message))
  (message notifications [] : Any
    (list_source_messages self/h self/owner))
  (message notification_update [id : Str, changes] : Any
    (update_notification ^revision self/notification_revision self/h self/owner id changes))
  (message notification_clear [id : Str, revision : Int] : Any
    (clear_source_message self/h self/owner id revision))
  (message registry_names [] : Any
    (var record self)
    (registry_names record/h))
  (message row_keys [registry_name : Str] : Any
    (var record self)
    (registry_row_keys record/h registry_name))
  (message create_registry [spec] : Any
    (var record self)
    (if (== spec/name void) (fail (HarnessError ^message "registry spec requires ^name")))
    (registry ^unique (if (== spec/unique void) false spec/unique) ^ordered (if (== spec/ordered void) false spec/ordered) ^schema (if_not (== spec/schema void) spec/schema) ^on_remove (if_not (== spec/on_remove void) spec/on_remove) ^owner record/owner
      record/h
      ($to_str spec/name)))
  (message resolve [seam : Str] : Any
    (var record self)
    (resolve record/h seam))
  (message provide [seam : Str, value] : Str
    (var record self)
    (provide record/h record/owner seam value))
  (message replace [seam : Str, value] : Str
    (var record self)
    (replace record/h record/owner seam value))
  (message contribute [registry_name : Str, payload] : Str
    (var record self)
    (contribute record/h record/owner registry_name payload))
  (message replace_contribution [registry_name : Str, payload] : Str
    (var record self)
    (contribute ^^replace record/h record/owner registry_name payload))
  (message subscribe [selector, handler] : Any
    (var record self)
    (subscribe record/h record/owner selector handler))
  (message emit_event [name : Str, payload] : Any
    (var record self)
    (if ($absent? record/h/event_store)
      (fail (HarnessError ^message "plugin events require a durable event store")))
    (var event_record (row_record record/h "event_types" name))
    (if (== event_record void)
      (fail (HarnessError ^message $"plugin event type ${name} is not registered")))
    (var event_type event_record/payload)
    (if (|| (!= event_type/origin "plugin") (!= event_type/owner record/owner))
      (fail (HarnessError ^message $"plugin ${record/owner} does not own event type ${name}")))
    (var checked
      (if ($absent? event_type/schema)
        payload
        (invoke_owned_callable record/h record/owner event_type/schema [payload])))
    (let context ($runtime/context))
    (let session (if ($absent? context) nil (?? context/session nil)))
    (let scope (if ($absent? session) "workspace" "session"))
    (let stream (if ($absent? session) "workspace" ($to_str session)))
    (append_plugin_event
      record/h/event_store
      scope
      stream
      record/owner
      {^type name ^version event_type/version ^ignorable event_type/ignorable ^data checked}))
  (message state [^session session = nil] : Any
    (var record self)
    (if ($absent? record/h/event_store) (return nil))
    (let scope (if ($absent? session) "workspace" "session"))
    (let stream (if ($absent? session) "workspace" ($to_str session)))
    (plugin_state record/h/event_store scope stream record/owner))
  (message update_state [value, ^session session = nil] : Any
    (var record self)
    (if ($absent? record/h/event_store)
      (fail (HarnessError ^message "plugin state requires a durable event store")))
    (let scope (if ($absent? session) "workspace" "session"))
    (let stream (if ($absent? session) "workspace" ($to_str session)))
    (var event (prepare_plugin_state record/h/event_store scope stream record/owner value))
    (append_core_event ^projection record/owner record/h/event_store scope stream event)
    value))

(fn publish [h : Harness, event] : Any
  (h/bus .publish event))

(fn notify [h : Harness, event] : Any
  # Lifecycle events go out through the same bus, with one difference: a
  # subscriber must not be able to stall the state machine. The kernel's bus is
  # `event/collect` (docs/stdlib.md), so one raising observer cannot abort a
  # publication and `publish` returns a `PublishResult` instead of raising. A
  # plugin system whose dependency resolution can be halted by an unrelated
  # observer is not one you can recompose at 3am.
  #
  # `collect` leaves reporting to the publisher, which makes the kernel the
  # reporter. Not doing this is the other way the design goes wrong: an
  # observer that fails silently is worse than one that stops the world,
  # because nothing anywhere records that it happened.
  (var r (publish h event))
  (if_yes (> r/failed 0)
    (for err in r/errors
      (log_append h "lifecycle" $"observer failed: ${err/message}")))
  nil)

# --- lifecycle -------------------------------------------------------------
#
# A plugin is in exactly one of three states:
#
#   pending  installed, but at least one seam it `requires` is unbound.
#   ready    activated; its contributions are in the tables.
#   error    its `activate` raised. Effects unwound, plugin still installed,
#            and *not* retried — see `retry`.
#
# `pending` is a state, not a failure. A dependency cycle therefore does not
# hang or raise: the plugins involved simply stay pending and say so in
# `plugin_states`, which is a far better 3am outcome than either alternative.

(fn status_of [h : Harness, id : Str] : Str
  (if (== (h/plugins .get; .get id) void) (return "absent"))
  (if (!= (h/plugin_errors .get; .get id) void) (return "error"))
  (var snapshot h/composition/.inspect)
  (for entry in snapshot/entries
    (if (== entry/id id)
      (return
        (if (== entry/state "active")
          "ready"
          (if (== entry/state "failed")
            "error"
            entry/state)))))
  "pending")

(fn plugin_error [h : Harness, id : Str]
  (var found (h/plugin_errors .get; .get id))
  (if_not (== found void) ($to_str found)))

(fn plugin_ids [h : Harness] : Any
  # Gene maps keep insertion order, so ids come back in install order.
  (var out (fresh_list))
  (for [k v] in h/plugins/.get
    (out .push ($to_str k)))
  out)

(fn plugin_states [h : Harness] : Any
  (var out (fresh_list))
  (for id in (plugin_ids h)
    (out .push $"${id}:${(status_of h id)}"))
  out)

(fn requirements_of [p : Plugin] : Any
  (?? p/requires (fresh_list)))

(fn requirement_registry [requirement] : Str
  (if (== ($head requirement) List)
    ($to_str requirement/0)
    "seams"))

(fn requirement_key [requirement] : Str
  (if (== ($head requirement) List)
    ($to_str requirement/1)
    ($to_str requirement)))

(fn install [h : Harness, p : Plugin] : Str
  # Installing registers the plugin and reconciles the composition. A failed
  # activation is a state (`error`) the caller reads, not an exception.
  (var state (put_cordis_plugin h p {^^host}))
  (log_append h "lifecycle" $"installed ${p/id} (${state})")
  $"installed ${p/id} (${state})")

(fn uninstall [h : Harness, id : Str] : Str
  (if (== (h/plugins .get; .get id) void)
    (fail (HarnessError ^message $"plugin ${id} not installed")))
  (h/plugins
    .get
    ; .delete id)
  (h/composition_entries
    .get
    ; .delete id)
  (h/plugin_errors
    .get
    ; .delete id)
  (reconcile_cordis_harness h)
  (log_append h "lifecycle" $"uninstalled ${id}")
  $"uninstalled ${id}")

(fn retry [h : Harness, id : Str] : Str
  # A failed plugin is not retried automatically: an activation that raised
  # raises again until something outside it changes.
  (if_not (== (status_of h id) "error")
    (fail (HarnessError ^message $"plugin ${id} is not in error")))
  (var p (h/plugins/.get .get id))
  (var options (h/composition_entries/.get .get id))
  (var state (put_cordis_plugin h p options ^^replace))
  $"retried ${id} (${state})")

(fn shutdown_harness [h : Harness]
  (var errors (fresh_list))
  (try
    (close_composition_state h/snapshots)
  catch Any
    (errors .push ($to_str $err)))
  (if (> errors/.size 0) (return {^status "recovery_required" ^errors errors}))
  (try
    h/composition/.close
  catch Any
    (errors .push ($to_str $err)))
  (h/plugins .set (fresh_map))
  (h/composition_entries .set (fresh_map))
  (h/plugin_errors .set (fresh_map))
  (flush_harness h)
  {^status (if (== errors/.size 0) "closed" "recovery_required") ^errors errors})

# --- runtime install (design §4 item 4) ------------------------------------

(fn module_dir [path : Str] : Str
  # The directory holding a module, from its own `this_mod/.path`. Plugin paths
  # are resolved against the harness rather than the working directory, so
  # `gene run` works from anywhere.
  (var parts ($str/split path "/"))
  (var out (fresh_list))
  (var i 0)
  (while (< i (- parts/.size 1))
    (out .push parts/%i)
    (set i (+ i 1)))
  ($str/join out "/"))

(fn installed [h : Harness] : Any
  (plugin_ids h))

(fn composition_info [h : Harness]
  (let snapshot (current_snapshot h/snapshots))
  {^snapshot snapshot/id ^registries (registry_names h) ^plugins h/composition/.inspect})
