# The harness kernel: plugin lifecycle and the effect ledger.
#
# The kernel owns four tables. A plugin never touches them — it contributes
# through `provide`, and every contribution is recorded against the plugin id so
# the kernel can reverse it without the plugin's cooperation. That is what makes
# activation all-or-nothing and uninstall complete: cleanup was never the
# plugin's job.
#
# See docs/design.md for why this is a subsystem rather than a mapping onto
# packages, `try`, and scoped impls.

(mod kernel)

(import [Plugin DescriptorContext PluginContext PluginHost
         ExecutionLimits default_execution_limits]
  from "./plugin_api" ^export true)
(import [append_core_event append_plugin_event
         record_plugin_state plugin_state events_for flush_event_store]
  from "./state")
(import [core_event_types] from "./generated_event_catalog")
(import [HarnessView view_provider] from "./view_api")

(type HarnessError ^props {^message Str} ^impl [Error])

(impl Error for HarnessError)

# `activate` is a thunk *returning* the activation function, called as
# `((p/activate) h id)`. A prop can hold a callable directly and `(p/activate h
# id)` works, so this looks like a layer worth deleting — it is not. docs/
# design.md §5 records a closure-lifetime SIGSEGV for a closure that outlives
# the frame that built it and is then called across a module boundary, which is
# exactly the shape of an activation stored in a plugin value in one module and
# run by the kernel in another. The thunk builds the inner closure fresh at each
# activation instead, which also happens to be what re-activation after a
# cascade (§3.3.5) wants.

(type Registry
  ^props {^name Str ^unique Bool ^ordered Bool ^schema Any ^on_remove Any
          ^owner Str ^rows Any})

(type RegistryRow
  ^props {^row_id Str ^owner Str ^registry Str ^key Str ^payload Any
          ^priority Int ^config_order Int ^acquired Int})

(type TurnTransaction
  ^props {^id Str ^registries Any ^ledger Any ^row_index Any
          ^baseline Any ^new_rows Any ^new_order Any ^deferred Any
          ^events Any ^notifications Any
          ^plugins Any ^status Any ^plugin_policies Any ^plugin_errors Any
          ^baseline_plugins Any ^activated_plugins Any
          ^deferred_plugins Any ^use_baseline Any
          ^workspace_entries Any ^workspace_baseline Any
          ^workspace_revision Any ^pending_plugins Any})

(type Harness ^props {^plugins Any ^status Any ^plugin_errors Any
                      ^log Any ^log_hydrated Any ^bus Any
                      ^registries Any ^ledger Any ^row_index Any
                      ^next_row_id Any ^transaction Any
                      ^event_store Any ^event_scope Str ^event_stream Str
                      ^plugin_policies Any ^plugin_depth Any ^workspace Any})

(type GuardedHandler ^private true
  ^props {^h Harness ^owner Str ^handler Any})

(type GuardedCallable ^private true
  ^props {^h Harness ^owner Str ^callable Any ^inject_context Bool})

(type GuardedView ^private true
  ^props {^h Harness ^owner Str ^view Any})

(impl Callable for GuardedHandler
  (message apply [self call]
    (invoke_owned_callable self/h self/owner self/handler [(call ~ /0)])))

(impl Callable for GuardedCallable
  (message apply [self call]
    (var args (copy_list call/body))
    (if_yes (&& self/inject_context (> args/~size 0))
      (args ~ set 0 (callback_receiver self/h self/owner)))
    (invoke_owned_callable self/h self/owner self/callable args)))

(fn run_guarded_view [bundle]
  (bundle/view ~ HarnessView:run bundle/receiver))

(impl HarnessView for GuardedView
  (message run [h] : Any
    (invoke_owned_callable self/h self/owner run_guarded_view
      [{^view self/view
        ^receiver (callback_receiver self/h self/owner)}])))

# --- registry kernel -------------------------------------------------------

(fn fresh_list [] ($thaw #[]))
(fn fresh_map [] ($thaw #{}))

(type ContextRecord ^private true
  ^props {^token Any ^h Harness ^owner Str ^writable Bool})

(var plugin_context_records ^private true ($cell ($thaw #[])))

(fn copy_list [source]
  (var out (fresh_list))
  (for item in source (out ~ push item))
  out)

(fn active_transaction [h : Harness]
  (h/transaction ~ get))

(fn transaction_uses_baseline? [tx]
  (&& (! ($absent? tx)) (tx/use_baseline ~ get)))

(fn active_registries_cell [h : Harness]
  (var tx (active_transaction h))
  (if (|| ($absent? tx) (transaction_uses_baseline? tx))
    h/registries tx/registries))

(fn active_ledger_cell [h : Harness]
  (var tx (active_transaction h))
  (if (|| ($absent? tx) (transaction_uses_baseline? tx))
    h/ledger tx/ledger))

(fn active_row_index_cell [h : Harness]
  (var tx (active_transaction h))
  (if (|| ($absent? tx) (transaction_uses_baseline? tx))
    h/row_index tx/row_index))

(fn active_plugins_cell [h : Harness]
  (var tx (active_transaction h))
  (if (|| ($absent? tx) (transaction_uses_baseline? tx))
    h/plugins tx/plugins))

(fn active_status_cell [h : Harness]
  (var tx (active_transaction h))
  (if (|| ($absent? tx) (transaction_uses_baseline? tx))
    h/status tx/status))

(fn active_plugin_policies_cell [h : Harness]
  (var tx (active_transaction h))
  (if (|| ($absent? tx) (transaction_uses_baseline? tx))
    h/plugin_policies tx/plugin_policies))

(fn active_plugin_errors_cell [h : Harness]
  (var tx (active_transaction h))
  (if (|| ($absent? tx) (transaction_uses_baseline? tx))
    h/plugin_errors tx/plugin_errors))

(fn registry_named [h : Harness, name : Str] : Registry
  (var registries ((active_registries_cell h) ~ get))
  (var found (registries ~ get name))
  (if (== found void)
    (fail (HarnessError ^message $"registry ${name} is not defined"))
    found))

(fn registry_exists? [h : Harness, name : Str] : Bool
  (var registries ((active_registries_cell h) ~ get))
  (!= (registries ~ get name) void))

(fn registry
  [h : Harness, name : Str,
   ^unique unique : Bool = false,
   ^ordered ordered : Bool = false,
   ^schema schema = nil,
   ^on_remove on_remove = nil,
   ^owner owner : Str = "core"] : Registry
  (var registries_cell (active_registries_cell h))
  (var registries (registries_cell ~ get))
  (if_not (== (registries ~ get name) void)
    (fail (HarnessError ^message $"registry ${name} already defined")))
  (var created
    (Registry ^name name ^unique unique ^ordered ordered
              ^schema schema ^on_remove on_remove ^owner owner
              ^rows ($cell (fresh_list))))
  (registries ~ put name created)
  (registries_cell ~ set registries)
  created)

(fn registry_names [h : Harness]
  (var out (fresh_list))
  (for [name value] in ((active_registries_cell h) ~ get)
    (out ~ push ($to_str name)))
  out)

(fn next_registry_row_id [h : Harness, owner : Str, registry_name : Str] : Str
  (var n (h/next_row_id ~ get))
  (h/next_row_id ~ set (+ n 1))
  $"${owner}:${registry_name}:${n}")

(fn string_before? [left : Str, right : Str] : Bool
  (var a (($str/to_utf8 left) ~ to_list))
  (var b (($str/to_utf8 right) ~ to_list))
  (var limit (if (< a/~size b/~size) a/~size b/~size))
  (var i 0)
  (while (< i limit)
    (if_not (== a/%i b/%i) (return (< a/%i b/%i)))
    (set i (+ i 1)))
  (< a/~size b/~size))

(fn registry_row_before? [a : RegistryRow, b : RegistryRow] : Bool
  (if (!= a/priority b/priority)
    (< a/priority b/priority)
    (if (!= a/config_order b/config_order)
      (< a/config_order b/config_order)
      (if (!= a/owner b/owner)
        (string_before? a/owner b/owner)
        (string_before? a/row_id b/row_id)))))

(fn insert_registry_row [r : Registry, record : RegistryRow]
  (if_not r/ordered
    ((r/rows ~ get) ~ push record)
    (return nil))
  (var next (fresh_list))
  (var inserted false)
  (for current in (r/rows ~ get)
    (if_yes (&& (! inserted) (registry_row_before? record current))
      (next ~ push record)
      (set inserted true))
    (next ~ push current))
  (if_not inserted (next ~ push record))
  (r/rows ~ set next))

(fn registry_row_records [h : Harness, registry_name : Str]
  (var r (registry_named h registry_name))
  (r/rows ~ get))

(fn rows [h : Harness, registry_name : Str]
  (var out (fresh_list))
  (for record in (registry_row_records h registry_name)
    (out ~ push record/payload))
  out)

(fn row_record [h : Harness, registry_name : Str, key : Str]
  (var found void)
  (for record in (registry_row_records h registry_name)
    (if (&& (== found void) (== record/key key))
      (set found record)))
  found)

(fn row [h : Harness, registry_name : Str, key : Str]
  (var found (row_record h registry_name key))
  (if (== found void) void found/payload))

(fn ledger_record [h : Harness, owner : Str, row_id : Str]
  (var ledger_cell (active_ledger_cell h))
  (var ledger (ledger_cell ~ get))
  (var owned (?? (ledger ~ get owner) (fresh_list)))
  (owned ~ push row_id)
  (ledger ~ put owner owned)
  (ledger_cell ~ set ledger))

(fn ledger_forget [h : Harness, owner : Str, row_id : Str]
  (var ledger_cell (active_ledger_cell h))
  (var ledger (ledger_cell ~ get))
  (var kept (fresh_list))
  (for candidate in (?? (ledger ~ get owner) (fresh_list))
    (if_not (== candidate row_id) (kept ~ push candidate)))
  (if (== kept/~size 0)
    (ledger ~ delete owner)
    (ledger ~ put owner kept))
  (ledger_cell ~ set ledger))

(fn remove_registry_row [h : Harness, row_id : Str, ^cleanup cleanup = true]
  (var row_index_cell (active_row_index_cell h))
  (var row_index (row_index_cell ~ get))
  (var record (row_index ~ get row_id))
  (if (== record void) (return false))
  (var r (registry_named h record/registry))
  (var kept (fresh_list))
  (for candidate in (r/rows ~ get)
    (if_not (== candidate/row_id row_id) (kept ~ push candidate)))
  (r/rows ~ set kept)
  (row_index ~ delete row_id)
  (row_index_cell ~ set row_index)
  (ledger_forget h record/owner row_id)
  (if_yes cleanup
    (var tx (active_transaction h))
    (if (&& (! ($absent? tx))
      (== (tx/baseline ~ get row_id) true))
      ((tx/deferred ~ get) ~ push
        {^record record ^on_remove r/on_remove ^hook_owner r/owner})
      (if_not ($absent? r/on_remove)
        (invoke_owned_callable h r/owner r/on_remove
          [(callback_receiver h r/owner) record/payload]))))
  true)

(fn contribute
  [h : Harness, owner : Str, registry_name : Str, payload,
   ^key key = void,
   ^priority priority : Int = 0,
   ^config_order config_order : Int = 0,
   ^replace replace : Bool = false] : Str
  (var r (registry_named h registry_name))
  (var checked
    (if ($absent? r/schema)
      payload
      (invoke_owned_callable h r/owner r/schema [payload])))
  (if_yes (== registry_name "event_types")
    (set checked (validate_event_type_owner owner checked)))
  # `Fn` is a type-level constructor for signatures, not a runtime value, and
  # `$head` of a function is the function itself — so a `(== ($head run) Fn)`
  # test both fails to resolve and could not answer the question. A row that
  # carries a `run` is the row that gets a supervision boundary; whether that
  # value is callable is settled when it is applied.
  (if_yes (&& (["commands" "tools"] ~ contains? registry_name)
              (!= checked/run void)
              ($runtime/callable? checked/run))
    (var guarded (fresh_map))
    (for [name value] in checked (guarded ~ put name value))
    (guarded ~ put "run"
      (GuardedCallable ^h h ^owner owner ^callable checked/run
        ^inject_context (== registry_name "commands")))
    (set checked guarded))
  (if_yes (&& (== registry_name "seams")
              (!= checked/value void)
              ($runtime/callable? checked/value))
    (var guarded_seam_row (fresh_map))
    (for [name value] in checked (guarded_seam_row ~ put name value))
    (guarded_seam_row ~ put "value"
      (GuardedCallable ^h h ^owner owner ^callable checked/value
        ^inject_context false))
    (set checked guarded_seam_row))
  (if_yes (== registry_name "views")
    (var guarded_view_row (fresh_map))
    (for [name value] in checked (guarded_view_row ~ put name value))
    (guarded_view_row ~ put "value"
      (view_provider (GuardedView ^h h ^owner owner ^view checked/value)))
    (set checked guarded_view_row))
  (var logical_key
    (if ($absent? key)
      (if (!= checked/name void) ($to_str checked/name) "")
      ($to_str key)))
  (if (&& r/unique (== logical_key ""))
    (fail (HarnessError
      ^message $"registry ${registry_name} requires a logical key")))
  (var existing void)
  (for candidate in (r/rows ~ get)
    (if (&& (== existing void) (== candidate/key logical_key))
      (set existing candidate)))
  (if_yes (&& (== registry_name "event_types") (!= existing void)
              (!= existing/owner owner))
    (fail (HarnessError
      ^message $"event type ${logical_key} is owned by ${existing/owner}")))
  (if_yes (&& r/unique (!= existing void) (! replace))
    (fail (HarnessError
      ^message $"registry ${registry_name} key ${logical_key} already exists")))
  (if_yes (&& r/unique (!= existing void))
    (remove_registry_row h existing/row_id))
  (var row_id (next_registry_row_id h owner registry_name))
  (var acquired (h/next_row_id ~ get))
  (var record
    (RegistryRow ^row_id row_id ^owner owner ^registry registry_name
                 ^key logical_key ^payload checked ^priority priority
                 ^config_order config_order ^acquired acquired))
  (insert_registry_row r record)
  (var row_index_cell (active_row_index_cell h))
  (var row_index (row_index_cell ~ get))
  (row_index ~ put row_id record)
  (row_index_cell ~ set row_index)
  (ledger_record h owner row_id)
  (var tx (active_transaction h))
  (if_yes (! ($absent? tx))
    (var new_rows (tx/new_rows ~ get))
    (new_rows ~ put row_id true)
    (tx/new_rows ~ set new_rows)
    ((tx/new_order ~ get) ~ push row_id))
  row_id)

(fn remove_owner [h : Harness, owner : Str]
  (var ledger ((active_ledger_cell h) ~ get))
  (var owned (?? (ledger ~ get owner) (fresh_list)))
  (var errors (fresh_list))
  (var i (- owned/~size 1))
  (while (>= i 0)
    (try
      (remove_registry_row h owned/%i)
    catch e
      (errors ~ push ($to_str e/message)))
    (set i (- i 1)))
  (var owned_registries (fresh_list))
  (for [name r] in ((active_registries_cell h) ~ get)
    (if (&& (== r/owner owner) (!= name "seams")
            (!= name "commands") (!= name "tools")
            (!= name "prompt") (!= name "views")
            (!= name "event_types") (!= name "subscriptions"))
      (owned_registries ~ push ($to_str name))))
  (for name in owned_registries
    (var registry_errors (remove_registry h name))
    (for message in registry_errors (errors ~ push message)))
  errors)

(fn remove_registry [h : Harness, name : Str]
  (var r (registry_named h name))
  (if (== r/owner "core")
    (fail (HarnessError ^message $"core registry ${name} cannot be removed")))
  (var errors (fresh_list))
  (var records (copy_list (r/rows ~ get)))
  (var i (- records/~size 1))
  (while (>= i 0)
    (try
      (remove_registry_row h records/%i/row_id)
    catch e
      (errors ~ push ($to_str e/message)))
    (set i (- i 1)))
  (var registries_cell (active_registries_cell h))
  (var registries (registries_cell ~ get))
  (registries ~ delete name)
  (registries_cell ~ set registries)
  errors)

(fn clone_registries [h : Harness]
  (var out (fresh_map))
  (for [name source] in (h/registries ~ get)
    (var cloned
      (Registry ^name source/name ^unique source/unique
                ^ordered source/ordered ^schema source/schema
                ^on_remove source/on_remove ^owner source/owner
                ^rows ($cell (copy_list (source/rows ~ get)))))
    (out ~ put name cloned))
  out)

(fn clone_ledger [h : Harness]
  (var out (fresh_map))
  (for [owner row_ids] in (h/ledger ~ get)
    (out ~ put owner (copy_list row_ids)))
  out)

(fn clone_row_index [h : Harness]
  (var out (fresh_map))
  (for [row_id record] in (h/row_index ~ get)
    (out ~ put row_id record))
  out)

(fn clone_cell_map [cell]
  (var out (fresh_map))
  (for [key value] in (cell ~ get) (out ~ put key value))
  out)

(fn clone_policy_map [h : Harness]
  (var out (fresh_map))
  (for [owner policy] in (h/plugin_policies ~ get)
    (var cloned (fresh_map))
    (for [name value] in policy (cloned ~ put name value))
    (out ~ put owner cloned))
  out)

(fn begin_turn [h : Harness, id : Str] : TurnTransaction
  (if_not ($absent? (active_transaction h))
    (fail (HarnessError ^message "nested harness transactions are not supported")))
  (var baseline (fresh_map))
  (for [row_id record] in (h/row_index ~ get)
    (baseline ~ put row_id true))
  (var baseline_plugins (fresh_map))
  (for [plugin_id plugin] in (h/plugins ~ get)
    (baseline_plugins ~ put plugin_id true))
  (var tx
    (TurnTransaction ^id id ^registries ($cell (clone_registries h))
                     ^ledger ($cell (clone_ledger h))
                     ^row_index ($cell (clone_row_index h))
                     ^baseline baseline ^new_rows ($cell (fresh_map))
                     ^new_order ($cell (fresh_list))
                     ^deferred ($cell (fresh_list))
                     ^events ($cell (fresh_list))
                     ^notifications ($cell (fresh_list))
                     ^plugins ($cell (clone_cell_map h/plugins))
                     ^status ($cell (clone_cell_map h/status))
                     ^plugin_policies ($cell (clone_policy_map h))
                     ^plugin_errors ($cell (clone_cell_map h/plugin_errors))
                     ^baseline_plugins baseline_plugins
                     ^activated_plugins ($cell (fresh_list))
                     ^deferred_plugins ($cell (fresh_list))
                     ^use_baseline ($cell false)
                     ^workspace_entries ($cell nil)
                     ^workspace_baseline ($cell nil)
                     ^workspace_revision ($cell nil)
                     ^pending_plugins ($cell (fresh_list))))
  (h/transaction ~ set tx)
  tx)

(fn row_diff_summary [record : RegistryRow]
  {^row_id record/row_id ^owner record/owner ^registry record/registry
   ^key record/key})

(fn entry_by_id [entries, id : Str]
  (for entry in entries
    (if_yes (== entry/id id) (return entry)))
  nil)

(fn composition_diff [baseline, staged]
  (var changes (fresh_list))
  (for entry in staged
    (var before (entry_by_id baseline ($to_str entry/id)))
    (if (== before nil)
      (changes ~ push
        {^id entry/id ^change "added" ^from nil ^to entry/module_digest})
      (if_not (== ($to_str before) ($to_str entry))
        (changes ~ push
          {^id entry/id ^change "changed" ^from before/module_digest
           ^to entry/module_digest}))))
  (for entry in baseline
    (if (== (entry_by_id staged ($to_str entry/id)) nil)
      (changes ~ push
        {^id entry/id ^change "removed" ^from entry/module_digest ^to nil})))
  changes)

(fn transaction_diff [h : Harness]
  (var tx (active_transaction h))
  (if ($absent? tx)
    (fail (HarnessError ^message "no active harness transaction")))
  (var added (fresh_list))
  (var removed (fresh_list))
  (var active_index (tx/row_index ~ get))
  (for [row_id record] in active_index
    (if (== (tx/baseline ~ get row_id) void)
      (added ~ push (row_diff_summary record))))
  (for [row_id present] in tx/baseline
    (if (== (active_index ~ get row_id) void)
      (removed ~ push row_id)))
  (var baseline_entries (tx/workspace_baseline ~ get))
  (var staged_entries (tx/workspace_entries ~ get))
  {^rows {^added added ^removed removed}
   ^composition
     (if (|| (== baseline_entries nil) (== staged_entries nil))
       (fresh_list)
       (composition_diff baseline_entries staged_entries))})

(fn cleanup_transaction_row [h : Harness, tx : TurnTransaction, row_id : Str]
  (var row_index (tx/row_index ~ get))
  (var record (row_index ~ get row_id))
  (if (== record void) (return))
  (var registries (tx/registries ~ get))
  (var r (registries ~ get record/registry))
  (if (&& (!= r void) (! ($absent? r/on_remove)))
    (invoke_owned_callable h r/owner r/on_remove
      [(callback_receiver h r/owner) record/payload])))

(fn baseline_plugin? [tx : TurnTransaction, id : Str]
  (== (tx/baseline_plugins ~ get id) true))

(fn defer_plugin_deactivation
  [h : Harness, tx : TurnTransaction, p : Plugin]
  (for deferred in (tx/deferred_plugins ~ get)
    (if_yes (== deferred/id p/id) (return)))
  (var baseline_policy ((h/plugin_policies ~ get) ~ get p/id))
  ((tx/deferred_plugins ~ get) ~ push
    {^id p/id ^plugin p
     ^context
       (if_not (|| (== baseline_policy void)
                   ($absent? baseline_policy/context))
         baseline_policy/context)}))

(fn plugin_deactivation_deferred? [tx : TurnTransaction, id : Str]
  (for deferred in (tx/deferred_plugins ~ get)
    (if_yes (== deferred/id id) (return true)))
  false)

(fn release_policy_context [policy]
  (if_yes (&& (!= policy void) (! ($absent? policy/context)))
    (release_plugin_context policy/context)))

(fn abort_turn [h : Harness, tx : TurnTransaction]
  (if_not (== (active_transaction h) tx)
    (fail (HarnessError ^message "turn transaction is not active")))
  (var errors (fresh_list))
  (var contexts_to_release (fresh_list))
  (var activated (tx/activated_plugins ~ get))
  (var activated_index (- activated/~size 1))
  (while (>= activated_index 0)
    (var id ($to_str activated/%activated_index))
    (var p (((active_plugins_cell h) ~ get) ~ get id))
    (if_yes (&& (!= p void) (== (status_of h id) "ready"))
      (if_not (run_deactivate h p)
        (errors ~ push $"deactivate ${id} failed during abort"))
      (var policy (((active_plugin_policies_cell h) ~ get) ~ get id))
      (if_yes (&& (!= policy void) (! ($absent? policy/context)))
        (contexts_to_release ~ push policy/context)))
    (set activated_index (- activated_index 1)))
  (var order (tx/new_order ~ get))
  (var new_rows (tx/new_rows ~ get))
  (var i (- order/~size 1))
  (while (>= i 0)
    (var row_id order/%i)
    (if (== (new_rows ~ get row_id) true)
      (try
        (cleanup_transaction_row h tx row_id)
      catch e
        (errors ~ push e/message)))
    (set i (- i 1)))
  (for context in contexts_to_release (release_plugin_context context))
  (h/transaction ~ set nil)
  {^status (if (== errors/~size 0) "aborted" "recovery_required")
   ^errors errors})

(fn commit_turn [h : Harness, tx : TurnTransaction]
  (if_not (== (active_transaction h) tx)
    (fail (HarnessError ^message "turn transaction is not active")))
  # Baseline plugins being removed/demoted must deactivate while their
  # committed rows and contexts are still visible. Logs remain staged.
  (var errors (fresh_list))
  (tx/use_baseline ~ set true)
  (try
    (for deferred in (tx/deferred_plugins ~ get)
      (if_not (run_deactivate h deferred/plugin)
        (errors ~ push $"deactivate ${deferred/id} failed during commit")))
  ensure
    (tx/use_baseline ~ set false))
  (h/registries ~ set (tx/registries ~ get))
  (h/ledger ~ set (tx/ledger ~ get))
  (h/row_index ~ set (tx/row_index ~ get))
  (h/plugins ~ set (tx/plugins ~ get))
  (h/status ~ set (tx/status ~ get))
  (h/plugin_errors ~ set (tx/plugin_errors ~ get))
  # Cleanup hooks must observe the committed registry state, not the staging
  # overlay that just superseded them.
  (h/transaction ~ set nil)
  (for deferred in (tx/deferred ~ get)
    (if_not ($absent? deferred/on_remove)
      (try
        (invoke_owned_callable h deferred/hook_owner deferred/on_remove
          [(callback_receiver h deferred/hook_owner)
           deferred/record/payload])
      catch e
        (errors ~ push e/message))))
  # Cleanup ran with baseline owner policies/contexts. Publish the staged
  # policy table only now, then expire contexts belonging to removed plugins.
  (h/plugin_policies ~ set (tx/plugin_policies ~ get))
  (for deferred in (tx/deferred_plugins ~ get)
    (if_not (== deferred/context nil)
      (release_plugin_context deferred/context)))
  (for event in (tx/events ~ get)
    (append_committed_log h ($to_str event/kind) ($to_str event/text)))
  (for event in (tx/notifications ~ get)
    (notify h event))
  {^status (if (== errors/~size 0) "committed" "recovery_required")
   ^errors errors})

(fn run_turn_transaction [h : Harness, id : Str, program]
  (record_turn_start h id)
  (flush_harness h)
  (var tx (begin_turn h id))
  (try
    (var result
      (invoke_bounded apply_zero_arguments program (fresh_list)
        (default_execution_limits) ^inherit true))
    (var committed (commit_turn h tx))
    (committed ~ put "result" result)
    (record_turn_end h id "committed")
    (flush_harness h)
    committed
  catch e
    (var aborted (abort_turn h tx))
    (aborted ~ put "error" e)
    (record_turn_end h id "aborted")
    (flush_harness h)
    aborted
  ensure
    # Panics and cancellation bypass ordinary catch clauses. `ensure` is the
    # last line of defense against leaving a staging overlay installed.
    (if_yes (== (active_transaction h) tx)
      (abort_turn h tx)
      (record_turn_end h id "cancelled")
      (flush_harness h))))

(fn validate_seam_row [candidate]
  (if (|| (== candidate/name void) (== candidate/value void))
    (fail (HarnessError ^message "a seam row requires ^name and ^value"))
    candidate))

(fn validate_command_row [candidate]
  (if (|| (== candidate/name void) (== candidate/doc void)
          (== candidate/run void))
    (fail (HarnessError ^message "a command row requires name doc run"))
    candidate))

(fn validate_tool_row [candidate]
  (if (|| (== candidate/name void) (== candidate/doc void)
          (== candidate/run void))
    (fail (HarnessError ^message "a tool row requires name doc run"))
    candidate))

(fn validate_view_row [candidate]
  (if (|| (== candidate/name void) (== candidate/value void))
    (fail (HarnessError ^message "a view row requires name and value")))
  (view_provider candidate/value)
  candidate)

(fn validate_prompt_row [candidate]
  (if (|| (== candidate/name void) (== candidate/text void))
    (fail (HarnessError ^message "a prompt row requires name and text"))
    candidate))

(fn validate_event_type_row [candidate]
  (if (|| (== candidate/name void) (== candidate/version void)
          (== candidate/ignorable void))
    (fail (HarnessError
      ^message "an event type row requires name version ignorable")))
  (if_yes (&& (!= candidate/schema void)
              (! ($runtime/callable? candidate/schema)))
    (fail (HarnessError ^message "event type schema must be callable")))
  candidate)

(fn validate_event_type_owner [owner : Str, candidate]
  (if (== owner "core")
    (then
      (if_not (&& (== candidate/origin "core") (== candidate/owner "core"))
        (fail (HarnessError
          ^message "core event rows must be stamped core/core"))))
    (else
      (if_not (== candidate/origin "plugin")
        (fail (HarnessError ^message "plugins cannot declare core event origin")))
      (var declared_owner ($to_str candidate/owner))
      (if_not (|| (== declared_owner owner)
                  (== owner $"descriptor:${declared_owner}"))
        (fail (HarnessError
          ^message $"event owner ${declared_owner} does not match contributor ${owner}")))))
  candidate)

(fn cancel_subscription_row [context, candidate]
  (candidate/sub ~ cancel))

# Harness events. A plugin observes the harness through the event bus rather
# than by being called back, because observation is what the bus is for and
# substitution is what the seams are for (design §2.2). The lifecycle is the
# first thing worth observing: a plugin can watch its own dependencies come and
# go without the kernel knowing anything about it.
(type HarnessEvent ^is $event/Event)
(type HarnessLog ^is HarnessEvent ^props {^kind Str ^text Str})
(type ToolInvoked ^is HarnessEvent ^props {^tool Str ^arg Str})
(type PluginInstalled ^is HarnessEvent ^props {^plugin Str})
(type PluginActivated ^is HarnessEvent ^props {^plugin Str})
(type PluginDeactivated ^is HarnessEvent ^props {^plugin Str ^reason Str})
(type PluginFailed ^is HarnessEvent ^props {^plugin Str ^message Str})
(type PluginUninstalled ^is HarnessEvent ^props {^plugin Str})

(fn new_harness
  [^event_store event_store = nil,
   ^event_scope event_scope : Str = "session",
   ^event_stream event_stream : Str = "default",
   ^workspace workspace = nil] : Harness
  (var h
    (Harness ^plugins ($cell (fresh_map)) ^status ($cell (fresh_map))
             ^plugin_errors ($cell (fresh_map))
             ^log ($cell (fresh_list)) ^log_hydrated ($cell false)
             ^bus ($event/Bus ^error_policy $event/collect)
             ^registries ($cell (fresh_map)) ^ledger ($cell (fresh_map))
             ^row_index ($cell (fresh_map)) ^next_row_id ($cell 1)
             ^transaction ($cell nil) ^event_store event_store
             ^event_scope event_scope ^event_stream event_stream
             ^plugin_policies ($cell (fresh_map))
             ^plugin_depth ($cell 0) ^workspace workspace))
  (registry h "seams" ^unique true ^schema validate_seam_row)
  (registry h "commands" ^unique true ^schema validate_command_row)
  (registry h "tools" ^unique true ^schema validate_tool_row)
  (registry h "prompt" ^unique false ^ordered true ^schema validate_prompt_row)
  (registry h "views" ^unique true ^schema validate_view_row)
  (registry h "event_types" ^unique true ^schema validate_event_type_row)
  (registry h "subscriptions" ^unique false
    ^on_remove cancel_subscription_row)
  (for event in core_event_types
    (contribute h "core" "event_types" event))
  h)

(fn hydrate_harness_log [h : Harness]
  (if_yes (h/log_hydrated ~ get) (return))
  (if_not ($absent? h/event_store)
    (for envelope in (events_for h/event_store h/event_scope h/event_stream)
      (if_yes (["lifecycle" "message" "output" "trace"]
                ~ contains? ($to_str envelope/type))
        (if_not (== envelope/payload/text void)
          ((h/log ~ get) ~ push
            {^kind envelope/type ^text envelope/payload/text})))))
  (h/log_hydrated ~ set true)
  (h/log ~ get))

(fn effects_of [h : Harness, id : Str] : Any
  (var out (fresh_list))
  (var ledger ((active_ledger_cell h) ~ get))
  (var row_index ((active_row_index_cell h) ~ get))
  (for row_id in (?? (ledger ~ get id) (fresh_list))
    (var record (row_index ~ get row_id))
    (if_not (== record void) (out ~ push record)))
  out)

(fn unwind [h : Harness, id : Str]
  # Registry rows are the effect records. `remove_owner` performs their
  # registry-owned cleanup in strict reverse acquisition order.
  (var errors (remove_owner h id))
  (for message in errors
    (log_append h "lifecycle"
      $"cleanup ${id} requires recovery: ${message}"))
  errors)

# --- the session log (design §3.6) -----------------------------------------
#
# **Model-visible <=> logged.** Anything that reaches a model request must be
# reconstructible from the log. The log belongs to core, not to a plugin: a
# plugin appends to it and reads nothing else, so replay fidelity is structural
# rather than something someone remembered to maintain.
#
# The kernel writes its own lifecycle record here under `^kind "lifecycle"`.
# That is the same log and deliberately not a second one: `assemble_request`
# selects `message` events, so a lifecycle entry is durable, inspectable, and
# structurally incapable of reaching a model request.

(fn append_log_only [h : Harness, kind : Str, text : Str] : Any
  (var events (h/log ~ get))
  (events ~ push {^kind kind ^text text})
  # Views observe the same typed feed core persists. Publication errors are
  # collected by the bus and intentionally do not recursively append another
  # log record.
  (publish h (HarnessLog ^kind kind ^text text))
  events)

(fn append_committed_log [h : Harness, kind : Str, text : Str] : Any
  (var events (append_log_only h kind text))
  (if_not ($absent? h/event_store)
    (append_core_event h/event_store h/event_scope h/event_stream
      {^type kind ^text text}))
  events)

(fn record_turn_start [h : Harness, id : Str]
  (append_log_only h "turn" $"started ${id}")
  (if_not ($absent? h/event_store)
    (append_core_event h/event_store h/event_scope h/event_stream
      {^type "turn/start" ^turn id}))
  nil)

(fn record_turn_end
  [h : Harness, id : Str, reason : Str, ^synthetic synthetic : Bool = false]
  (if_yes (&& (== reason "interrupted") (! synthetic))
    (fail (HarnessError
      ^message "interrupted turn boundaries are reserved for cold repair")))
  (append_log_only h "turn" $"${reason} ${id}")
  (if_not ($absent? h/event_store)
    (append_core_event h/event_store h/event_scope h/event_stream
      {^type "turn/end" ^turn id ^reason reason ^synthetic synthetic}))
  nil)

(fn record_composition_change
  [h : Harness, id : Str, previous_digest, new_digest, revision : Int,
   turn : Str, operation : Str]
  (append_log_only h "composition"
    $"${operation} ${id} at revision ${revision}")
  (if_not ($absent? h/event_store)
    (append_core_event h/event_store h/event_scope h/event_stream
      {^type "composition/changed" ^entry id ^operation operation
       ^previous_digest previous_digest ^new_digest new_digest
       ^revision revision ^session h/event_stream ^turn turn}))
  nil)

(fn log_append [h : Harness, kind : Str, text : Str] : Any
  (var tx (active_transaction h))
  (if ($absent? tx)
    (then (append_committed_log h kind text))
    (else
      ((tx/events ~ get) ~ push {^kind kind ^text text})
      (tx/events ~ get))))

(fn flush_harness [h : Harness]
  (if_not ($absent? h/event_store)
    (flush_event_store h/event_store)))

(fn log_events [h : Harness] : Any
  (h/log ~ get))

(fn lifecycle_log [h : Harness] : Any
  (var out (fresh_list))
  (for e in (h/log ~ get)
    (if_yes (== ($to_str e/kind) "lifecycle")
      (out ~ push ($to_str e/text))))
  out)

(fn assemble_request [events] : (List Str)
  # The whole invariant is this signature plus the empty capability row.
  #
  # It takes the log and nothing else — not the harness, not the seam table,
  # not the filesystem. `^capabilities []` makes "reads only the log"
  # enforceable rather than a convention: an assembler that tried to read a
  # file or the environment would be refused at the declaration, so a plugin
  # cannot smuggle model-visible content in around the log.
  #
  # Replay is then an ordinary fold over the log rather than a bespoke
  # deserializer, which is the part Gene gets more cheaply than TypeScript:
  # the log is Gene data.
  ^capabilities []
  (var out (fresh_list))
  (for e in events
    (if_yes (== ($to_str e/kind) "message")
      (out ~ push ($to_str e/text))))
  out)

# --- seams -----------------------------------------------------------------

(fn provide [h : Harness, id : Str, seam : Str, value] : Str
  # Binding is explicit: a seam already bound is refused rather than shadowed.
  # There is no last-wins, so no registration order decides behaviour.
  (if_yes (seam_bound h seam)
    (fail (HarnessError ^message $"seam ${seam} already bound; replace it explicitly")))
  (contribute h id "seams" {^name seam ^value value} ^key seam)
  seam)

(fn replace [h : Harness, id : Str, seam : Str, value] : Str
  # §3.3.3: a bound seam is never shadowed by a second `provide`, because then
  # registration order would decide behaviour. Replacement is this — a named
  # operation the operator asked for.
  #
  # The ledger moves with the binding. Without that, uninstalling the *previous*
  # owner would unbind a seam it no longer provides, and the new provider would
  # vanish for a reason nothing in the log explains.
  #
  # Note this is also why a dependent does not churn across a provider swap:
  # the seam stays bound throughout, so `requires` never goes unmet and no
  # dependent is deactivated for a substitution it was never meant to notice.
  (if_not (seam_bound h seam)
    (fail (HarnessError ^message $"seam ${seam} is not bound; provide it first")))
  (contribute h id "seams" {^name seam ^value value}
    ^key seam ^replace true)
  seam)

(fn resolve [h : Harness, seam : Str] : Any
  (var found (row h "seams" seam))
  (if_yes (== found void)
    (fail (HarnessError ^message $"no provider for seam ${seam}")))
  found/value)

(fn seam_bound [h : Harness, seam : Str] : Bool
  # Asking without committing. `resolve` raises, which is right for a consumer
  # that cannot proceed without the seam and wrong for a caller deciding whether
  # a deployment offers something at all.
  (!= (row h "seams" seam) void))

(fn bound_seams [h : Harness] : Any
  (var out (fresh_list))
  (for candidate in (rows h "seams")
    (out ~ push ($to_str candidate/name)))
  out)

(fn render_registry_introspection [h : Harness] : Str
  (var lines (fresh_list))
  (for registry_name in ["commands" "tools" "seams" "views" "prompt"]
    (var keys (registry_row_keys h registry_name))
    (lines ~ push $"${registry_name}: ${keys}"))
  ($str/join lines "\n"))

(fn render_prompt [h : Harness] : Str
  (var sections (fresh_list))
  (for section in (rows h "prompt")
    (if_not (== section/pull_only true)
      (sections ~ push ($to_str section/text))))
  (sections ~ push (render_registry_introspection h))
  ($str/join sections "\n\n"))

(fn doc [h : Harness, name : Str] : Str
  (for registry_name in ["prompt" "commands" "tools" "seams" "views"]
    (var candidate (row h registry_name name))
    (if_not (== candidate void)
      (if_not (== candidate/text void) (return ($to_str candidate/text)))
      (if_not (== candidate/doc void) (return ($to_str candidate/doc)))
      (return ($to_str candidate))))
  (fail (HarnessError ^message $"no registry documentation named ${name}")))

# --- observation (design §2.2: the bus is for observing, seams for swapping) -

(fn subscribe [h : Harness, id : Str, selector, handler] : Any
  # A plugin's subscription is an effect like any other: recorded against the
  # plugin id, and cancelled by `unwind` without the plugin's cooperation. A
  # listener that outlived its plugin is the classic plugin-system leak, and
  # the ledger is what makes it structurally impossible here.
  (var guarded (GuardedHandler ^h h ^owner id ^handler handler))
  (var sub (h/bus ~ subscribe selector guarded))
  (contribute h id "subscriptions" {^name "" ^sub sub})
  sub)

# --- opaque plugin context -------------------------------------------------

(fn make_plugin_context [h : Harness, owner : Str, writable : Bool]
  (var token ($cell nil))
  ((plugin_context_records ~ get) ~ push
    (ContextRecord ^token token ^h h ^owner owner ^writable writable))
  (PluginContext ^token token))

(fn plugin_context_record [context : PluginContext] : ContextRecord
  (var found nil)
  (for record in (plugin_context_records ~ get)
    (if_yes (&& (== found nil) (== record/token context/token))
      (set found record)))
  (if (== found nil)
    (fail (HarnessError ^message "plugin context is expired or foreign"))
    found))

(fn release_plugin_context [context : PluginContext]
  (var kept (fresh_list))
  (for record in (plugin_context_records ~ get)
    (if_not (== record/token context/token) (kept ~ push record)))
  (plugin_context_records ~ set kept)
  nil)

(fn validate_plugin_descriptor [h : Harness, expected_id : Str, p : Plugin]
  (if_not (== p/id expected_id)
    (fail (HarnessError
      ^message $"plugin descriptor id ${p/id} does not match ${expected_id}")))
  (if_not (== p/contextual true)
    (fail (HarnessError
      ^message "generated plugins must use the PluginContext activation API")))
  (if_not ($runtime/callable? p/activate)
    (fail (HarnessError ^message "plugin activate must be callable")))
  (for requirement in (?? p/requires (fresh_list))
    # Version 1 accepts the existing seam shorthand and the explicit
    # [registry key] pair. Validate the registry vocabulary without requiring
    # the row to be present yet; absence is the lifecycle's `pending` state.
    (if (== ($head requirement) List)
      (then
        (if_not (== requirement/~size 2)
          (fail (HarnessError ^message "plugin requirement pair needs registry and key")))
        (registry_named h ($to_str requirement/0)))
      (else (registry_named h "seams"))))
  p)

(fn invoke_bounded
  [callable, argument, selector_forms, limits : ExecutionLimits,
   ^inherit inherit : Bool = false]
  (var program
    (if inherit
      (quote ($runtime/guard_call callable argument))
      `(with_capabilities [(unquote (... selector_forms))]
         ($runtime/guard_call callable argument))))
  (var guarded
    (eval program
      ^in (env ^bindings {^callable callable ^argument argument}
               ^imports [$runtime]
               ^policy {^max_steps limits/max_steps
                        ^max_memory_mb limits/max_memory_mb
                        ^timeout_ms limits/timeout_ms})))
  (if guarded/ok
    guarded/value
    (fail (HarnessError ^message $"plugin panic: ${guarded/message}"))))

(fn apply_argument_list [bundle]
  (bundle/callable bundle/args...))

(fn apply_zero_arguments [callable]
  (callable))

(fn configure_plugin_module [module, selector_forms, limits : ExecutionLimits]
  (var policy
    {^max_steps limits/max_steps ^max_memory_mb limits/max_memory_mb
     ^timeout_ms limits/timeout_ms})
  (var program
    `(with_capabilities [(unquote (... selector_forms))]
       ($runtime/configure_module module policy)))
  (eval program
    ^in (env ^bindings {^module module ^policy policy}
             ^imports [$runtime])))

(fn policy_for_owner [h : Harness, owner : Str]
  (var policy (((active_plugin_policies_cell h) ~ get) ~ get owner))
  (if (== policy void)
    {^selectors (fresh_list) ^scope "session"
     ^limits (default_execution_limits) ^inherit true ^context nil}
    policy))

(fn callback_receiver [h : Harness, owner : Str]
  (var policy (policy_for_owner h owner))
  (if policy/inherit
    h
    (if ($absent? policy/context)
      (fail (HarnessError
        ^message $"plugin ${owner} callback context is unavailable"))
      policy/context)))

(fn enter_plugin_execution [h : Harness]
  (h/plugin_depth ~ set (+ (h/plugin_depth ~ get) 1)))

(fn leave_plugin_execution [h : Harness]
  (var depth (- (h/plugin_depth ~ get) 1))
  (h/plugin_depth ~ set depth)
  (if_yes (&& (== depth 0) (! ($absent? h/event_store)))
    (flush_event_store h/event_store)))

(fn invoke_owned_callable [h : Harness, owner : Str, callable, args]
  (var policy (policy_for_owner h owner))
  (enter_plugin_execution h)
  (try
    (invoke_bounded apply_argument_list {^callable callable ^args args}
      policy/selectors policy/limits ^inherit policy/inherit)
  ensure
    # PluginHost state mutations are queued while the attenuated callback is
    # active. Flush only after its capability scope has unwound, at the core
    # boundary that owns the retained Store authority.
    (leave_plugin_execution h)))

(fn invoke_registry_row [h : Harness, registry_name : Str, key : Str, args]
  (var record (row_record h registry_name key))
  (if (== record void)
    (fail (HarnessError
      ^message $"registry ${registry_name} has no row ${key}")))
  (invoke_owned_callable h record/owner record/payload/run args))

(fn describe_plugin_module
  [h : Harness, module, expected_id : Str,
   ^core_interface core_interface : Str = "",
   ^limits limits = nil] : Plugin
  (var context
    (DescriptorContext ^module_id expected_id
                       ^core_interface core_interface))
  (var bounded
    (if ($absent? limits) (default_execution_limits) limits))
  (var p
    (invoke_bounded module/init context (fresh_list) bounded))
  (validate_plugin_descriptor h expected_id p))

(fn require_writable_context [record : ContextRecord]
  (if_not record/writable
    (fail (HarnessError
      ^message "plugin descriptor context is read-only")))
  record)

(fn registry_row_keys [h : Harness, registry_name : Str]
  (var out (fresh_list))
  (for record in (registry_row_records h registry_name)
    (out ~ push record/key))
  out)

(impl PluginHost for PluginContext ^export true
  (message registry_names [] : Any
    (var record (plugin_context_record self))
    (registry_names record/h))

  (message row_keys [registry_name : Str] : Any
    (var record (plugin_context_record self))
    (registry_row_keys record/h registry_name))

  (message create_registry [spec] : Any
    (var record (require_writable_context (plugin_context_record self)))
    (if (== spec/name void)
      (fail (HarnessError ^message "registry spec requires ^name")))
    (registry record/h ($to_str spec/name)
      ^unique (if (== spec/unique void) false spec/unique)
      ^ordered (if (== spec/ordered void) false spec/ordered)
      ^schema (if_not (== spec/schema void) spec/schema)
      ^on_remove (if_not (== spec/on_remove void) spec/on_remove)
      ^owner record/owner))

  (message resolve [seam : Str] : Any
    (var record (require_writable_context (plugin_context_record self)))
    (resolve record/h seam))

  (message provide [seam : Str, value] : Str
    (var record (require_writable_context (plugin_context_record self)))
    (provide record/h record/owner seam value))

  (message replace [seam : Str, value] : Str
    (var record (require_writable_context (plugin_context_record self)))
    (replace record/h record/owner seam value))

  (message contribute [registry_name : Str, payload] : Str
    (var record (require_writable_context (plugin_context_record self)))
    (contribute record/h record/owner registry_name payload))

  (message replace_contribution [registry_name : Str, payload] : Str
    (var record (require_writable_context (plugin_context_record self)))
    (contribute record/h record/owner registry_name payload ^replace true))

  (message subscribe [selector, handler] : Any
    (var record (require_writable_context (plugin_context_record self)))
    (subscribe record/h record/owner selector handler))

  (message emit_event [name : Str, payload] : Any
    (var record (require_writable_context (plugin_context_record self)))
    (if ($absent? record/h/event_store)
      (fail (HarnessError ^message "plugin events require a durable event store")))
    (var event_record (row_record record/h "event_types" name))
    (if (== event_record void)
      (fail (HarnessError ^message $"plugin event type ${name} is not registered")))
    (var event_type event_record/payload)
    (if (|| (!= event_type/origin "plugin")
            (!= event_type/owner record/owner))
      (fail (HarnessError
        ^message $"plugin ${record/owner} does not own event type ${name}")))
    (var checked
      (if ($absent? event_type/schema)
        payload
        (invoke_owned_callable record/h record/owner event_type/schema [payload])))
    (var policy (policy_for_owner record/h record/owner))
    (var scope (if (== policy/scope "workspace") "workspace" "session"))
    (var stream
      (if (== scope "workspace") "workspace" record/h/event_stream))
    (append_plugin_event record/h/event_store scope stream record/owner
      {^type name ^version event_type/version
       ^ignorable event_type/ignorable ^data checked}))

  (message state [] : Any
    (var record (require_writable_context (plugin_context_record self)))
    (if ($absent? record/h/event_store) (return nil))
    (var policy (policy_for_owner record/h record/owner))
    (var scope (if (== policy/scope "workspace") "workspace" "session"))
    (var stream
      (if (== scope "workspace") "workspace" record/h/event_stream))
    (plugin_state record/h/event_store scope stream record/owner))

  (message update_state [value] : Any
    (var record (require_writable_context (plugin_context_record self)))
    (if ($absent? record/h/event_store)
      (fail (HarnessError ^message "plugin state requires a durable event store")))
    (var policy (policy_for_owner record/h record/owner))
    (var scope (if (== policy/scope "workspace") "workspace" "session"))
    (var stream
      (if (== scope "workspace") "workspace" record/h/event_stream))
    (record_plugin_state record/h/event_store scope stream record/owner value)
    value))

(fn publish [h : Harness, event] : Any
  (h/bus ~ publish event))

(fn notify [h : Harness, event] : Any
  # Lifecycle events go out through the same bus, with one difference: a
  # subscriber must not be able to stall the state machine. The kernel's bus is
  # `event/collect` (docs/events.md §8), so one raising observer cannot abort a
  # publication and `publish` returns a `PublishResult` instead of raising. A
  # plugin system whose dependency resolution can be halted by an unrelated
  # observer is not one you can recompose at 3am.
  #
  # `collect` leaves reporting to the publisher, which makes the kernel the
  # reporter. Not doing this is the other way the design goes wrong: an
  # observer that fails silently is worse than one that stops the world,
  # because nothing anywhere records that it happened.
  (var tx (active_transaction h))
  (if_not ($absent? tx)
    ((tx/notifications ~ get) ~ push event)
    (return nil))
  (var r (publish h event))
  (if_yes (> r/failed 0)
    (for err in r/errors
      (log_append h "lifecycle" $"observer failed: ${err/message}")))
  nil)

# --- lifecycle -------------------------------------------------------------
#
# A plugin is in exactly one of three states:
#
#   pending  installed, but at least one seam it `requires` is unbound.
#   ready    activated; its contributions are in the tables.
#   error    its `activate` raised. Effects unwound, plugin still installed,
#            and *not* retried — see `retry`.
#
# `pending` is a state, not a failure. A dependency cycle therefore does not
# hang or raise: the plugins involved simply stay pending and say so in
# `plugin_states`, which is a far better 3am outcome than either alternative.

(fn status_of [h : Harness, id : Str] : Str
  (var s (((active_status_cell h) ~ get) ~ get id))
  (if (== s void) "absent" ($to_str s)))

(fn plugin_error [h : Harness, id : Str]
  (var found (((active_plugin_errors_cell h) ~ get) ~ get id))
  (if_not (== found void) ($to_str found)))

(fn plugin_ids [h : Harness] : Any
  # Keys are collected before any pass that may write the table. Gene maps keep
  # insertion order, so a settle pass visits plugins in install order and the
  # whole lifecycle is deterministic.
  (var out (fresh_list))
  (for [k v] in ((active_plugins_cell h) ~ get)
    (out ~ push ($to_str k)))
  out)

(fn plugin_states [h : Harness] : Any
  (var out (fresh_list))
  (for id in (plugin_ids h) (out ~ push $"${id}:$(status_of h id)"))
  out)

(fn requirements_of [p : Plugin] : Any
  (?? p/requires (fresh_list)))

(fn requirement_registry [requirement] : Str
  (if (== ($head requirement) List)
    ($to_str requirement/0)
    "seams"))

(fn requirement_key [requirement] : Str
  (if (== ($head requirement) List)
    ($to_str requirement/1)
    ($to_str requirement)))

(fn provided_registry [provided] : Str
  (if (== ($head provided) List)
    ($to_str provided/0)
    "seams"))

(fn provided_key [provided] : Str
  (if (== ($head provided) List)
    ($to_str provided/1)
    ($to_str provided)))

(fn requires_met [h : Harness, p : Plugin] : Bool
  (var met true)
  (for requirement in (requirements_of p)
    (var registry_name (requirement_registry requirement))
    (if (|| (! (registry_exists? h registry_name))
            (== (row h registry_name (requirement_key requirement)) void))
      (set met false)))
  met)

(fn missing_requirements [h : Harness, p : Plugin] : Any
  (var out (fresh_list))
  (for requirement in (requirements_of p)
    (var registry_name (requirement_registry requirement))
    (var key (requirement_key requirement))
    (if (|| (! (registry_exists? h registry_name))
            (== (row h registry_name key) void))
      (out ~ push $"${registry_name}/${key}")))
  out)

(fn run_deactivate [h : Harness, p : Plugin] : Bool
  # "If deactivate fails, the plugin is removed as planned; the failure is
  # logged." The kernel can afford that because it does not *depend* on the
  # hook: the ledger reverses every registration either way. A deactivate hook
  # is for a plugin's own private state — a flushed buffer, a closed handle —
  # and losing it degrades that plugin, not the harness.
  #
  # An omitted optional prop reads as `void`, not `nil`, so `(!= … nil)` would
  # be true for a plugin that declared no deactivate.
  (if ($absent? p/deactivate)
    true
    (try
      (var policy (policy_for_owner h p/id))
      (if ($absent? policy/context)
        (fail (HarnessError
          ^message $"plugin ${p/id} deactivation context is unavailable")))
      (var deactivation
        (invoke_owned_callable h p/id p/deactivate (fresh_list)))
      (invoke_owned_callable h p/id deactivation [policy/context])
      true
      catch e
      (log_append h "lifecycle" $"deactivate ${p/id} failed: ${e/message}")
      false)))

(fn promote [h : Harness, id : Str]
  # pending -> ready, or pending -> error.
  (var p (((active_plugins_cell h) ~ get) ~ get id))
  (var context nil)
  (var activated false)
  (try
    (enter_plugin_execution h)
    (try
      (set context (make_plugin_context h id true))
      (var activation
        (invoke_owned_callable h id p/activate (fresh_list)))
      (invoke_owned_callable h id activation [context])
    ensure
      (leave_plugin_execution h))
    (if_not (== context nil)
      (var policies ((active_plugin_policies_cell h) ~ get))
      (var committed_policy (policies ~ get id))
      (if (== committed_policy void)
        (set committed_policy
          {^selectors (fresh_list) ^scope "session"
           ^limits (default_execution_limits) ^inherit true ^context nil}))
      (committed_policy ~ put "context" context)
      (policies ~ put id committed_policy)
      ((active_plugin_policies_cell h) ~ set policies))
    (set activated true)
    (((active_status_cell h) ~ get) ~ put id "ready")
    (((active_plugin_errors_cell h) ~ get) ~ delete id)
    (var tx (active_transaction h))
    (if_yes (&& (! ($absent? tx)) (! (transaction_uses_baseline? tx))
                (|| (!= ((h/status ~ get) ~ get id) "ready")
                    (plugin_deactivation_deferred? tx id))
                (! ((tx/activated_plugins ~ get) ~ contains? id)))
      ((tx/activated_plugins ~ get) ~ push id))
    (log_append h "lifecycle" $"activated ${id}")
    (notify h (PluginActivated ^plugin id))
    catch e
    # §3.3.2 is unchanged: a failure part-way through `activate` unwinds
    # whatever it already registered, so a half-activated plugin is never left
    # behind. What is new is where the plugin lands — installed and in `error`,
    # rather than gone. A failure that erases its own subject is a failure you
    # cannot investigate.
    (unwind h id)
    (((active_status_cell h) ~ get) ~ put id "error")
    (((active_plugin_errors_cell h) ~ get) ~ put id ($to_str e/message))
    (log_append h "lifecycle" $"activate ${id} failed: ${e/message}")
    (notify h (PluginFailed ^plugin id ^message ($to_str e/message)))
  ensure
    (if_yes (&& (!= context nil) (! activated))
      (release_plugin_context context))))

(fn demote [h : Harness, id : Str, why : Str]
  # ready -> pending. The plugin stays installed, because the thing that went
  # away was its dependency, not the operator's intent. If the seam comes back,
  # so does the plugin, and that reversibility is what makes a cascade safe
  # enough to allow at all.
  (var p (((active_plugins_cell h) ~ get) ~ get id))
  # Deactivation runs before the ledger is reversed, so the hook still sees the
  # seams its own plugin provided.
  (var tx (active_transaction h))
  (var deferred false)
  (if (&& (! ($absent? tx)) (! (transaction_uses_baseline? tx))
          (baseline_plugin? tx id)
          (== ((h/status ~ get) ~ get id) "ready"))
    (then
      (defer_plugin_deactivation h tx p)
      (set deferred true))
    (else (run_deactivate h p)))
  (unwind h id)
  (var policies ((active_plugin_policies_cell h) ~ get))
  (var policy (policies ~ get id))
  (if_yes (&& (!= policy void) (! ($absent? policy/context)))
    (if_not deferred (release_plugin_context policy/context))
    (policy ~ put "context" nil)
    (policies ~ put id policy)
    ((active_plugin_policies_cell h) ~ set policies))
  (((active_status_cell h) ~ get) ~ put id "pending")
  (log_append h "lifecycle" $"deactivated ${id}: ${why}")
  (notify h (PluginDeactivated ^plugin id ^reason why)))

(fn settle [h : Harness] : Any
  # Drive the table to a fixpoint. Two phases, and the order matters.
  #
  # Demote first: a demotion unbinds seams, which can starve a dependent, which
  # can starve *its* dependents. Promote second: a promotion only ever *binds*
  # seams, so it can satisfy another plugin but can never starve one — which is
  # why phase 2 can never send us back to phase 1.
  #
  # Running demotions first also avoids activating a plugin whose provider is
  # about to disappear in the same settle. Interleaving the two phases would
  # still converge, but it would churn: a plugin would be activated and then
  # immediately deactivated, and its `activate` would have run for nothing.
  (var changed true)
  (while changed
    (set changed false)
    (for id in (plugin_ids h)
      (if_yes (== (status_of h id) "ready")
        (var p (((active_plugins_cell h) ~ get) ~ get id))
        (if_not (requires_met h p)
          (demote h id $"missing $(missing_requirements h p)")
          (set changed true)))))
  (set changed true)
  (while changed
    (set changed false)
    (for id in (plugin_ids h)
      (if_yes (== (status_of h id) "pending")
        (var p (((active_plugins_cell h) ~ get) ~ get id))
        (if_yes (requires_met h p)
          (promote h id)
          (set changed true)))))
  nil)

(fn install [h : Harness, p : Plugin] : Str
  # Installing is *registering*, not activating. Whether the plugin activates
  # is a question about the world — are its seams bound? — and the answer can
  # change later, so it is a state the plugin carries rather than a verdict
  # thrown at the caller.
  #
  # This is why install no longer raises when `activate` fails: one install can
  # promote a whole chain of waiting plugins, so there is no single failure to
  # raise, and the plugin has to survive its own failure in order to be in
  # `error`. Check the returned status, `status_of`, or subscribe to
  # `PluginFailed`.
  (var plugins ((active_plugins_cell h) ~ get))
  (if_yes (|| (== p/id "core")
              ($str/starts_with? ($to_str p/id) "descriptor:"))
    (fail (HarnessError ^message $"plugin id ${p/id} is reserved by core")))
  (if_not (== p/contextual true)
    (fail (HarnessError
      ^message $"plugin ${p/id} must use the PluginContext activation API")))
  (if_yes (!= (plugins ~ get p/id) void)
    (fail (HarnessError ^message $"plugin ${p/id} already installed")))
  (for requirement in (requirements_of p)
    (for provided in p/provides
      (if_yes (&& (== (requirement_registry requirement)
                       (provided_registry provided))
                   (== (requirement_key requirement)
                       (provided_key provided)))
        (fail (HarnessError
          ^message $"plugin ${p/id} requires $(provided_registry provided)/$(provided_key provided), which it provides itself")))))
  (plugins ~ put p/id p)
  (((active_status_cell h) ~ get) ~ put p/id "pending")
  (((active_plugin_errors_cell h) ~ get) ~ delete p/id)
  (log_append h "lifecycle" $"installed ${p/id}")
  (notify h (PluginInstalled ^plugin p/id))
  (settle h)
  $"installed ${p/id} (${(status_of h p/id)})")

(fn install_with_policy
  [h : Harness, p : Plugin, selectors,
   ^scope scope : Str = "session",
   ^limits limits = nil] : Str
  (var policies ((active_plugin_policies_cell h) ~ get))
  (var bounded
    (if ($absent? limits) (default_execution_limits) limits))
  (policies ~ put p/id
    {^selectors (copy_list selectors) ^scope scope
     ^limits bounded ^inherit false ^context nil})
  ((active_plugin_policies_cell h) ~ set policies)
  (try
    (install h p)
  catch e
    (policies ~ delete p/id)
    ((active_plugin_policies_cell h) ~ set policies)
    (fail e)))

(fn uninstall [h : Harness, id : Str] : Str
  (var plugins ((active_plugins_cell h) ~ get))
  (var p (plugins ~ get id))
  (if_yes (== p void)
    (fail (HarnessError ^message $"plugin ${id} not installed")))
  # Only a `ready` plugin has anything to deactivate. A `pending` one never
  # activated, and an `error` one was unwound when it failed.
  (var tx (active_transaction h))
  (var deferred false)
  (if_yes (== (status_of h id) "ready")
    (if (&& (! ($absent? tx)) (! (transaction_uses_baseline? tx))
            (baseline_plugin? tx id)
            (== ((h/status ~ get) ~ get id) "ready"))
      (then
        (defer_plugin_deactivation h tx p)
        (set deferred true))
      (else (run_deactivate h p))))
  (var cleanup_errors (unwind h id))
  (plugins ~ delete id)
  (((active_status_cell h) ~ get) ~ delete id)
  (((active_plugin_errors_cell h) ~ get) ~ delete id)
  (var policies ((active_plugin_policies_cell h) ~ get))
  (var policy (policies ~ get id))
  (if_yes (&& (!= policy void) (! ($absent? policy/context)))
    (if_not deferred (release_plugin_context policy/context)))
  (policies ~ delete id)
  ((active_plugin_policies_cell h) ~ set policies)
  (log_append h "lifecycle" $"uninstalled ${id}")
  (notify h (PluginUninstalled ^plugin id))
  # Removing this plugin's seams can starve a dependent, which can starve its
  # dependents in turn.
  (settle h)
  (if (== cleanup_errors/~size 0)
    $"uninstalled ${id}"
    $"uninstalled ${id} (recovery_required)"))

(fn retry [h : Harness, id : Str] : Str
  # A failed plugin is not retried automatically, because an activate that
  # raised will raise again until something outside it changes, and a kernel
  # that retries on its own turns one bad plugin into a loop. `retry` is the
  # operator saying the something changed.
  (var p (((active_plugins_cell h) ~ get) ~ get id))
  (if_yes (== p void)
    (fail (HarnessError ^message $"plugin ${id} not installed")))
  (if_yes (!= (status_of h id) "error")
    (fail (HarnessError
      ^message $"plugin ${id} is $(status_of h id), not error; nothing to retry")))
  (((active_status_cell h) ~ get) ~ put id "pending")
  (((active_plugin_errors_cell h) ~ get) ~ delete id)
  (log_append h "lifecycle" $"retrying ${id}")
  (settle h)
  $"retried ${id} (${(status_of h id)})")

(fn shutdown_harness [h : Harness]
  (var ids (plugin_ids h))
  (var errors (fresh_list))
  (var i (- ids/~size 1))
  (while (>= i 0)
    (try
      (var result (uninstall h ids/%i))
      (if_yes ($str/contains? result "recovery_required")
        (errors ~ push result))
    catch e
      (errors ~ push ($to_str e/message)))
    (set i (- i 1)))
  (flush_harness h)
  {^status (if (== errors/~size 0) "closed" "recovery_required")
   ^errors errors})

# --- runtime install (design §4 item 4) ------------------------------------

(fn module_dir [path : Str] : Str
  # The directory holding a module, from its own `this_mod/~path`. Plugin paths
  # are resolved against the harness rather than the working directory, so
  # `gene run` works from anywhere.
  (var parts ($str/split path "/"))
  (var out (fresh_list))
  (var i 0)
  (while (< i (- parts/~size 1))
    (out ~ push parts/%i)
    (set i (+ i 1)))
  ($str/join out "/"))

(fn install_sandboxed [h : Harness, dir : Str, entry : Str, grants, shared] : Str
  # A plugin that was never compiled in. `grants` is the operator-readable
  # statement of what the new code may reach: `[]` means it gets computation
  # and nothing that touches the world outside the process.
  #
  # `shared` is how a sandboxed plugin can still implement a *typed* seam. The
  # sandbox covers everything the module imports, so without sharing the seam
  # definition the plugin would compile its own copy of the protocol and its
  # impl would satisfy a different identity than the consumer sends to. Sharing
  # the one definition file is narrower than granting a namespace and is what
  # keeps the seam a seam across the boundary.
  #
  # `plugin_requires` is optional, so a plugin loaded at runtime joins the same
  # dependency lifecycle as a compiled-in one without having to know it exists.
  (var m ($runtime/load_sandboxed dir entry grants shared))
  (var id ($to_str m/plugin_id))
  (var seam ($to_str m/plugin_seam))
  (var provider (m/plugin_build))
  (install h (Plugin ^id id ^provides [seam]
    ^requires (?? m/plugin_requires (fresh_list))
    ^contextual true
    ^activate (fn [] (fn [host]
      (host ~ PluginHost:provide seam provider))))))

(fn installed [h : Harness] : Any
  (plugin_ids h))
