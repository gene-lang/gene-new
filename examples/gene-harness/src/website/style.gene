(mod harness_website_style)

# The website's rules, as structured CSS scoped to the page body. Colors, fonts
# and the button radius are the host theme's tokens (src/web/theme.gene), so the
# page follows the Harness theme. Selectors and values are strings; the
# stylesheet itself is Gene data until `render_css` turns it into the generated
# .css route.

(import ^from "../public/web_style" [compact_query])
(import $css [css rule decl media container scoped class_name render : render_css])

(var site_styles
  (scoped "harness_site"
    (css
      (rule "&"
        (decl margin 0)
        (decl background "var(--surface)")
        (decl color "var(--ink)")
        (decl font "var(--type-body)")
        (decl overflow_wrap "anywhere")
        (decl "-webkit-font-smoothing" "antialiased"))
      (rule "*, *::before, *::after" (decl box_sizing "border-box") (decl border_radius 0))
      (rule "[hidden]" (decl display "none !important"))
      (rule "[id]" (decl scroll_margin_top "var(--site-anchor-offset)"))
      (rule "a" (decl color "var(--link-color)") (decl text_decoration "var(--link-decoration)") (decl text_underline_offset "var(--link-underline-offset)"))
      (rule "a:hover" (decl color "var(--link-color)") (decl text_decoration "underline"))
      (rule ":not(pre) > code"
        (decl font "var(--type-code)")
        (decl padding "var(--space-1) var(--space-1)")
        (decl border "var(--border-width) solid var(--line)")
        (decl background "var(--soft)")
        (decl overflow_wrap "anywhere"))
      (rule ".shell"
        (decl width "100%")
        (decl max_width "var(--site-shell-max-width)")
        (decl margin_inline "auto")
        (decl padding_inline "var(--site-shell-inset)"))
      (rule ".skip_link"
        (decl position "absolute")
        (decl left "var(--site-skip-link-inset)")
        (decl top "calc(-1 * var(--site-skip-link-hidden-offset))")
        (decl z_index "var(--layer-menu)")
        (decl padding "var(--space-2) var(--space-4)")
        (decl background "var(--ink)")
        (decl color "var(--action-ink)"))
      (rule ".skip_link:focus" (decl top "var(--site-skip-link-inset)") (decl color "var(--action-ink)"))
      # One-pixel clipping is structural screen-reader support, not theme sizing.
      (rule ".visually_hidden"
        (decl position "absolute")
        (decl width "1px")
        (decl height "1px")
        (decl overflow "hidden")
        (decl clip "rect(0 0 0 0)")
        (decl white_space "nowrap"))

      (rule ".card, .step, .workflow, .code_block, .disclosure, .aside_panel, .faq_item, .table_scroll, .request_quote"
        (decl border_radius "var(--radius-surface)"))

      # Header and navigation
      (rule ".site_header"
        (decl position "sticky")
        (decl top 0)
        (decl z_index "var(--layer-sticky)")
        (decl border_bottom "var(--border-width) solid var(--line)")
        (decl background "var(--surface)"))
      (rule ".header_inner"
        (decl display "flex")
        (decl flex_wrap "wrap")
        (decl align_items "center")
        (decl gap "var(--space-2) var(--space-6)")
        (decl min_height "var(--site-header-min-height)"))
      (rule ".wordmark"
        (decl display "inline-flex")
        (decl align_items "center")
        (decl gap "var(--space-2)")
        (decl margin_right "auto")
        (decl color "var(--ink)")
        (decl font_weight "var(--weight-bold)")
        (decl letter_spacing "var(--tracking-tight)")
        (decl text_decoration "none"))
      (rule ".wordmark:hover" (decl color "var(--ink)"))
      (rule ".wordmark_mark"
        (decl display "grid")
        (decl place_items "center")
        (decl width "var(--site-wordmark-size)")
        (decl height "var(--site-wordmark-size)")
        (decl background "var(--ink)")
        (decl color "var(--surface)")
        (decl font "var(--type-code)"))
      (rule ".site_nav"
        (decl display "flex")
        (decl flex_wrap "wrap")
        (decl align_items "center")
        (decl gap "var(--space-1) var(--space-5)")
        (decl font_size "var(--text-md)"))
      (rule ".site_nav a"
        (decl padding "var(--space-1) 0")
        (decl color "var(--muted)")
        (decl text_decoration "none"))
      (rule ".site_nav a:hover" (decl color "var(--link-color)") (decl text_decoration "underline"))
      (rule ".site_nav .nav_app"
        (decl padding "var(--space-2) var(--space-3)")
        (decl border_radius "var(--radius-control)")
        (decl background "var(--action)")
        (decl color "var(--action-ink)"))
      (rule ".site_nav .nav_app:hover" (decl background "var(--action-hover)") (decl color "var(--action-ink)"))
      (rule ".nav_toggle"
        (decl display "none")
        (decl padding "var(--space-2) var(--space-3)")
        (decl border "var(--border-width) solid var(--edge)")
        (decl border_radius "var(--radius-control)")
        (decl background "var(--surface)")
        (decl color "var(--ink)")
        (decl font "var(--type-ui)")
        (decl cursor "pointer"))
      (container compact_query
        (rule ".header_inner" (decl padding_block "var(--space-2)"))
        (rule ".site_nav" (decl width "100%"))
        (rule ".enhanced .nav_toggle" (decl display "inline-flex"))
        (rule ".enhanced .site_nav" (decl display "none"))
        (rule ".enhanced .nav_open .site_nav"
          (decl display "flex")
          (decl flex_direction "column")
          (decl align_items "flex-start")
          (decl padding_block "var(--space-1) var(--space-3)")))

      # Hero
      (rule ".hero" (decl padding_block "var(--site-hero-inset)"))
      (rule ".hero_grid"
        (decl display "grid")
        (decl gap "var(--site-hero-gap)")
        (decl align_items "center"))
      (rule ".eyebrow, .section_label"
        (decl margin "0 0 var(--space-4)")
        (decl color "var(--ink)")
        (decl font_size "var(--text-sm)")
        (decl font_weight "var(--weight-bold)")
        (decl letter_spacing "var(--tracking-label)")
        (decl text_transform "uppercase"))
      (rule ".hero_title"
        (decl max_width "var(--site-hero-measure)")
        (decl margin 0)
        (decl font_size "var(--text-display)")
        (decl font_weight "var(--weight-bold)")
        (decl line_height "var(--line-tight)")
        (decl letter_spacing "var(--tracking-tight)"))
      (rule ".hero_lede"
        (decl max_width "var(--site-hero-copy-measure)")
        (decl margin "var(--space-6) 0 0")
        (decl color "var(--muted)")
        (decl font_size "var(--text-lg)"))
      (rule ".actions"
        (decl display "flex")
        (decl flex_wrap "wrap")
        (decl gap "var(--space-3)")
        (decl margin_top "var(--space-8)"))
      (rule ".button"
        (decl display "inline-flex")
        (decl align_items "center")
        (decl padding "var(--space-3) var(--space-5)")
        (decl border "var(--border-width) solid transparent")
        (decl border_radius "var(--radius-control)")
        (decl font_weight "var(--weight-bold)")
        (decl text_decoration "none"))
      (rule ".button_primary" (decl background "var(--action)") (decl color "var(--action-ink)"))
      (rule ".button_primary:hover" (decl background "var(--action-hover)") (decl color "var(--action-ink)"))
      (rule ".button_secondary"
        (decl border_color "var(--edge)")
        (decl background "var(--surface)")
        (decl color "var(--ink)"))
      (rule ".button_secondary:hover" (decl border_color "var(--muted)") (decl color "var(--ink)"))
      (rule ".workflow"
        (decl margin 0)
        (decl overflow "hidden")
        (decl border "var(--border-width) solid var(--line)")
        (decl background "var(--surface)"))
      (rule ".workflow_head"
        (decl display "flex")
        (decl flex_wrap "wrap")
        (decl justify_content "space-between")
        (decl gap "var(--space-1) var(--space-4)")
        (decl padding "var(--space-3) var(--space-4)")
        (decl border_bottom "var(--border-width) solid var(--line)")
        (decl background "var(--soft)")
        (decl color "var(--muted)")
        (decl font_size "var(--text-sm)"))
      (rule ".workflow_steps" (decl margin 0) (decl padding "var(--space-1) 0") (decl list_style "none"))
      (rule ".workflow_step"
        (decl display "flex")
        (decl flex_wrap "wrap")
        (decl gap "var(--space-3)")
        (decl padding "var(--space-3) var(--space-4)"))
      (rule ".workflow_step + .workflow_step" (decl border_top "var(--border-width) dashed var(--line)"))
      (rule ".workflow_who"
        (decl flex "0 1 var(--site-workflow-label-width)")
        (decl padding_top "var(--space-1)")
        (decl color "var(--muted)")
        (decl font_size "var(--text-xs)")
        (decl font_weight "var(--weight-bold)")
        (decl letter_spacing "var(--tracking-label)")
        (decl text_transform "uppercase"))
      (rule ".workflow_body" (decl flex "1 1 var(--main-min)") (decl min_width 0) (decl font_size "var(--text-md)"))
      (rule ".workflow_body p" (decl margin 0))
      (rule ".workflow_code"
        (decl margin "var(--space-2) 0 0")
        (decl color "var(--ink)")
        (decl font "var(--type-code)")
        (decl white_space "pre-wrap")
        (decl overflow_wrap "anywhere"))
      (rule ".totals" (decl display "flex") (decl flex_wrap "wrap") (decl gap "var(--space-2)"))
      (rule ".total"
        (decl border_radius "var(--radius-chip)")
        (decl display "inline-flex")
        (decl align_items "baseline")
        (decl gap "var(--space-1)")
        (decl padding "var(--space-1) var(--space-3)")
        (decl background "var(--soft)")
        (decl color "var(--ink)")
        (decl font_size "var(--text-sm)"))
      (rule ".total strong" (decl font_size "var(--text-lg)"))
      (rule ".workflow_note" (decl margin "var(--space-2) 0 0") (decl color "var(--muted)") (decl font_size "var(--text-sm)"))

      # Sections
      (rule ".section"
        (decl padding_block "var(--site-section-inset)")
        (decl border_top "var(--border-width) solid var(--line)"))
      (rule ".section_alt" (decl background "var(--soft)"))
      (rule ".section_head" (decl max_width "var(--site-section-heading-measure)") (decl margin_bottom "var(--site-heading-gap)"))
      (rule ".section_title"
        (decl margin 0)
        (decl font_size "var(--text-display)")
        (decl line_height "var(--line-tight)")
        (decl letter_spacing "var(--tracking-tight)"))
      (rule ".section_intro" (decl margin "var(--space-4) 0 0") (decl color "var(--muted)") (decl font_size "var(--text-lg)"))
      (rule ".card_grid, .steps"
        (decl display "grid")
        (decl gap "var(--space-4)")
        (decl margin 0)
        (decl padding 0)
        (decl list_style "none"))
      (rule ".card_grid" (decl grid_template_columns "repeat(auto-fit, minmax(min(100%, var(--site-card-min-width)), 1fr))"))
      (rule ".card"
        (decl padding "var(--space-6)")
        (decl border "var(--border-width) solid var(--line)")
        (decl background "var(--surface)"))
      (rule ".card h3" (decl margin "0 0 var(--space-2)") (decl font_size "var(--text-xl)") (decl letter_spacing "var(--tracking-tight)"))
      (rule ".card p" (decl margin 0) (decl color "var(--muted)"))
      (rule ".card .card_detail"
        (decl margin_top "var(--space-4)")
        (decl padding_top "var(--space-4)")
        (decl border_top "var(--border-width) solid var(--line)")
        (decl color "var(--muted)")
        (decl font "var(--type-code)"))
      (rule ".steps"
        (decl grid_template_columns "repeat(auto-fit, minmax(min(100%, var(--site-step-min-width)), 1fr))")
        (decl counter_reset "step"))
      (rule ".step"
        (decl padding "var(--space-5) var(--space-5) var(--space-5)")
        (decl border_top "var(--rule-width) solid var(--ink)")
        (decl background "var(--surface)")
        (decl counter_increment "step"))
      (rule ".step::before"
        (decl content "counter(step, decimal-leading-zero)")
        (decl display "block")
        (decl margin_bottom "var(--space-2)")
        (decl color "var(--ink)")
        (decl font "var(--type-code)"))
      (rule ".step h3" (decl margin "0 0 var(--space-2)") (decl font_size "var(--text-lg)"))
      (rule ".step p" (decl margin 0) (decl color "var(--muted)") (decl font_size "var(--text-md)"))
      (rule ".step .step_note" (decl margin_top "var(--space-3)") (decl color "var(--muted)") (decl font_size "var(--text-sm)"))

      # Code
      (rule ".code_block"
        (decl min_width 0)
        (decl margin 0)
        (decl overflow "hidden")
        (decl border "var(--border-width) solid var(--line)")
        (decl background "var(--soft)"))
      (rule ".code_bar"
        (decl display "flex")
        (decl align_items "center")
        (decl justify_content "space-between")
        (decl gap "var(--space-3)")
        (decl min_height "var(--site-code-bar-min-height)")
        (decl padding "var(--space-1) var(--space-2) var(--space-1) var(--space-4)")
        (decl border_bottom "var(--border-width) solid var(--line)")
        (decl background "var(--soft)")
        (decl color "var(--muted)")
        (decl font "var(--type-code)"))
      (rule ".code_pre"
        (decl max_height "var(--site-code-max-height)")
        (decl margin 0)
        (decl padding "var(--space-4) var(--space-4)")
        (decl overflow "auto")
        (decl color "var(--ink)")
        (decl font "var(--type-code)")
        (decl tab_size 2))
      (rule ".code_pre:focus-visible" (decl outline_offset "calc(-1 * var(--focus-offset))"))
      (rule ".code_wrap .code_pre" (decl white_space "pre-wrap") (decl overflow_wrap "anywhere"))
      (rule ".copy_button"
        (decl padding "var(--space-2) var(--space-3)")
        (decl border "var(--border-width) solid var(--edge)")
        (decl border_radius "var(--radius-control)")
        (decl background "var(--surface)")
        (decl color "var(--ink)")
        (decl font "var(--type-ui)")
        (decl cursor "pointer"))
      (rule ".copy_button:hover" (decl border_color "var(--muted)"))
      (rule ".gene_comment" (decl color "var(--muted)"))
      (rule ".gene_string" (decl color "var(--syntax-string)"))
      (rule ".gene_number, .gene_literal" (decl color "var(--syntax-number)"))
      (rule ".gene_keyword" (decl color "var(--syntax-keyword)"))
      (rule ".gene_callable" (decl color "var(--syntax-callable)"))
      (rule ".gene_property, .gene_type" (decl color "var(--syntax-type)"))
      (rule ".gene_punctuation" (decl color "var(--muted)"))

      # Worked example
      (rule ".view_tabs"
        (decl display "inline-flex")
        (decl gap "var(--space-1)")
        (decl max_width "100%")
        (decl margin_bottom "var(--space-6)")
        (decl padding "var(--space-1)")
        (decl overflow_x "auto")
        (decl border "var(--border-width) solid var(--line)")
        (decl background "var(--surface)"))
      (rule ".view_tab"
        (decl border_radius "var(--radius-row)")
        (decl padding "var(--space-2) var(--space-4)")
        (decl border 0)
        (decl background "transparent")
        (decl color "var(--muted)")
        (decl font "var(--type-ui)")
        (decl white_space "nowrap")
        (decl cursor "pointer"))
      (rule ".view_tab:hover" (decl background "var(--soft)") (decl color "var(--ink)"))
      (rule ".view_tab[aria-selected=\"true\"]" (decl background "var(--ink)") (decl color "var(--surface)"))
      (rule ".view" (decl grid_template_columns "minmax(0, 1fr)") (decl display "grid") (decl gap "var(--space-5)") (decl min_width 0))
      (rule ".view + .view"
        (decl margin_top "var(--space-12)")
        (decl padding_top "var(--space-10)")
        (decl border_top "var(--border-width) solid var(--edge)"))
      (rule ".enhanced .view + .view" (decl margin_top 0) (decl padding_top 0) (decl border_top 0))
      (rule ".view_title" (decl margin 0) (decl font_size "var(--text-xl)"))
      (rule ".enhanced .view_title"
        (decl position "absolute")
        (decl width "1px")
        (decl height "1px")
        (decl overflow "hidden")
        (decl clip "rect(0 0 0 0)")
        (decl white_space "nowrap"))
      (rule ".view_text" (decl max_width "var(--site-example-copy-measure)") (decl margin 0) (decl color "var(--muted)"))
      (rule ".request_quote"
        (decl margin 0)
        (decl padding "var(--space-5) var(--space-6)")
        (decl border_left "var(--rule-width) solid var(--ink)")
        (decl background "var(--surface)"))
      (rule ".request_quote p" (decl margin 0))
      (rule ".meta_list"
        (decl display "flex")
        (decl flex_wrap "wrap")
        (decl gap "var(--space-2) var(--space-6)")
        (decl margin 0)
        (decl padding 0)
        (decl list_style "none")
        (decl color "var(--muted)")
        (decl font_size "var(--text-md)"))
      (rule ".meta_list strong" (decl color "var(--ink)") (decl font_weight "var(--weight-bold)"))
      (rule ".two_up" (decl display "grid") (decl grid_template_columns "minmax(0, 1fr)") (decl gap "var(--space-4)"))
      (rule ".two_up" (decl grid_template_columns "repeat(auto-fit, minmax(min(100%, var(--main-min)), 1fr))") (decl align_items "start"))
      (rule ".disclosure"
        (decl border "var(--border-width) solid var(--line)")
        (decl background "var(--surface)"))
      (rule ".disclosure > summary" (decl padding "var(--space-4) var(--space-4)") (decl font_weight "var(--weight-bold)") (decl cursor "pointer"))
      (rule ".disclosure[open] > summary" (decl border_bottom "var(--border-width) solid var(--line)"))
      (rule ".disclosure_body" (decl display "grid") (decl gap "var(--space-4)") (decl min_width 0) (decl padding "var(--space-4)"))
      (rule ".table_scroll"
        (decl overflow_x "auto")
        (decl border "var(--border-width) solid var(--line)")
        (decl background "var(--surface)"))
      (rule ".result_table" (decl width "100%") (decl border_collapse "collapse") (decl font_size "var(--text-md)"))
      (rule ".result_table caption"
        (decl padding "var(--space-3) var(--space-4)")
        (decl color "var(--muted)")
        (decl font_size "var(--text-sm)")
        (decl text_align "left"))
      (rule ".result_table th, .result_table td"
        (decl padding "var(--space-3) var(--space-4)")
        (decl border_top "var(--border-width) solid var(--line)")
        (decl text_align "left")
        (decl white_space "nowrap"))
      (rule ".result_table thead th" (decl background "var(--soft)") (decl color "var(--muted)") (decl font_size "var(--text-sm)"))
      (rule ".result_table .num" (decl text_align "right") (decl font_variant_numeric "tabular-nums"))
      (rule ".result_table tfoot th, .result_table tfoot td" (decl font_weight "var(--weight-bold)"))
      (rule ".evidence" (decl display "grid") (decl gap "var(--space-2)") (decl margin 0) (decl padding 0) (decl list_style "none"))
      (rule ".evidence li"
        (decl position "relative")
        (decl padding_left "var(--space-8)")
        (decl color "var(--muted)"))
      (rule ".evidence li::before"
        (decl content "\"\"")
        (decl width "var(--icon-size)") (decl height "var(--icon-size)")
        (decl background "currentColor") (decl mask "var(--icon-check) center / contain no-repeat")
        (decl position "absolute")
        (decl left 0)
        (decl color "var(--ink)")
        (decl font_weight "var(--weight-bold)"))

      # Written in Gene
      (rule ".gene_grid"
        (decl display "grid")
        (decl grid_template_columns "repeat(auto-fit, minmax(min(100%, var(--site-example-min-width)), 1fr))")
        (decl gap "var(--space-5)"))
      (rule ".gene_item" (decl display "grid") (decl align_content "start") (decl gap "var(--space-3)") (decl min_width 0))
      (rule ".gene_item h3" (decl margin 0) (decl font_size "var(--text-lg)"))
      (rule ".gene_item p" (decl margin 0) (decl color "var(--muted)") (decl font_size "var(--text-md)"))

      # Run locally
      (rule ".run_grid" (decl display "grid") (decl grid_template_columns "minmax(0, 1fr)") (decl gap "var(--site-run-gap)"))
      (rule ".run_grid" (decl grid_template_columns "repeat(auto-fit, minmax(min(100%, var(--main-min)), 1fr))"))
      (rule ".aside_panel"
        (decl align_self "start")
        (decl padding "var(--space-6)")
        (decl border "var(--border-width) solid var(--line)")
        (decl background "var(--surface)"))
      (rule ".aside_panel h3" (decl margin "0 0 var(--space-3)") (decl font_size "var(--text-lg)"))
      (rule ".aside_panel ul" (decl display "grid") (decl gap "var(--space-2)") (decl margin 0) (decl padding_left "var(--space-4)") (decl color "var(--muted)"))
      (rule ".run_steps"
        (decl display "grid")
        (decl gap "var(--space-8)")
        (decl min_width 0)
        (decl margin 0)
        (decl padding 0)
        (decl list_style "none")
        (decl counter_reset "run"))
      (rule ".run_step" (decl display "grid") (decl gap "var(--space-3)") (decl min_width 0) (decl counter_increment "run"))
      (rule ".run_step > h3"
        (decl display "flex")
        (decl align_items "center")
        (decl gap "var(--space-3)")
        (decl margin 0)
        (decl font_size "var(--text-lg)"))
      (rule ".run_step > h3::before"
        (decl content "counter(run)")
        (decl display "inline-grid")
        (decl place_items "center")
        (decl flex "none")
        (decl width "var(--site-step-marker-size)")
        (decl height "var(--site-step-marker-size)")
        (decl background "var(--ink)")
        (decl color "var(--surface)")
        (decl font "var(--type-code)"))
      (rule ".run_step p" (decl margin 0) (decl color "var(--muted)"))
      (rule ".dirs" (decl display "grid") (decl gap "var(--space-3)") (decl margin 0))
      (rule ".dirs dt" (decl color "var(--ink)") (decl font "var(--type-code)"))
      (rule ".dirs dd" (decl margin "var(--space-1) 0 0") (decl color "var(--muted)") (decl font_size "var(--text-md)"))

      # FAQ and footer
      (rule ".faq_list" (decl display "grid") (decl gap "var(--space-3)") (decl max_width "var(--site-faq-measure)"))
      (rule ".faq_item"
        (decl border "var(--border-width) solid var(--line)")
        (decl background "var(--surface)"))
      (rule ".faq_item > summary" (decl padding "var(--space-4) var(--space-5)") (decl font_weight "var(--weight-bold)") (decl cursor "pointer"))
      (rule ".faq_item p" (decl margin 0) (decl padding "0 var(--space-5) var(--space-4)") (decl color "var(--muted)"))
      (rule ".site_footer"
        (decl padding_block "var(--space-12)")
        (decl border_top "var(--border-width) solid var(--line)")
        (decl background "var(--surface-alt)")
        (decl color "var(--ink)"))
      (rule ".footer_inner"
        (decl display "grid")
        (decl grid_template_columns "repeat(auto-fit, minmax(min(100%, var(--site-footer-column-min-width)), 1fr))")
        (decl gap "var(--space-8)"))
      (rule ".site_footer a" (decl color "var(--ink)"))
      (rule ".footer_title" (decl margin 0) (decl color "var(--ink)") (decl font_weight "var(--weight-bold)"))
      (rule ".footer_note" (decl max_width "var(--site-footer-note-measure)") (decl margin "var(--space-2) 0 0") (decl color "var(--muted)") (decl font_size "var(--text-md)"))
      (rule ".footer_links"
        (decl display "flex")
        (decl flex_wrap "wrap")
        (decl gap "var(--space-2) var(--space-5)")
        (decl margin 0)
        (decl padding 0)
        (decl list_style "none"))

      (media "(prefers-reduced-motion: no-preference)"
        (rule ".button, .view_tab, .copy_button, .site_nav a"
          (decl transition "background-color var(--duration-fast) var(--ease-standard), color var(--duration-fast) var(--ease-standard), border-color var(--duration-fast) var(--ease-standard)"))))))

(var website_css (render_css site_styles))
(var website_class (class_name site_styles))
