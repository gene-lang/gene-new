(mod harness_website_style)

# The website's design tokens and rules, as structured CSS scoped to the page
# body. Selectors and values are strings; the stylesheet itself is Gene data
# until `render_css` turns it into the generated .css route.

(import $css [css rule decl media scoped class_name render : render_css])

(var site_styles
  (scoped "harness_site"
    (css
      (rule "&"
        (decl "--paper" "#faf8f3")
        (decl "--surface" "#f2efe7")
        (decl "--panel" "#ffffff")
        (decl "--ink" "#14213d")
        (decl "--ink-soft" "#3d4a63")
        (decl "--muted" "#5f6b7d")
        (decl "--line" "#e3ddd0")
        (decl "--line-strong" "#cfc7b6")
        (decl "--blue" "#1f5fd1")
        (decl "--blue-dark" "#174aa6")
        (decl "--teal" "#0d766e")
        (decl "--teal-soft" "#e0f1ed")
        (decl "--teal-ink" "#0a5b55")
        (decl "--code-bg" "#fdfcf9")
        (decl "--code-line" "#e8e3d8")
        (decl "--focus" "#1f5fd1")
        (decl "--sans" "ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif")
        (decl "--mono" "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace")
        (decl margin 0)
        (decl background "var(--paper)")
        (decl color "var(--ink)")
        (decl font "1rem/1.6 var(--sans)")
        (decl "-webkit-font-smoothing" "antialiased"))
      (rule "*, *::before, *::after" (decl box_sizing "border-box"))
      (rule "[hidden]" (decl display "none !important"))
      (rule "[id]" (decl scroll_margin_top "5rem"))
      (rule "a" (decl color "var(--blue)") (decl text_underline_offset "0.18em"))
      (rule "a:hover" (decl color "var(--blue-dark)"))
      (rule ":focus-visible"
        (decl outline "3px solid var(--focus)")
        (decl outline_offset "3px"))
      (rule ":not(pre) > code"
        (decl font "0.88em/1.4 var(--mono)")
        (decl padding "0.1em 0.35em")
        (decl border "1px solid var(--line)")
        (decl border_radius "0.3rem")
        (decl background "var(--surface)")
        (decl overflow_wrap "anywhere"))
      (rule ".shell"
        (decl width "100%")
        (decl max_width "72rem")
        (decl margin_inline "auto")
        (decl padding_inline "clamp(1rem, 4vw, 2rem)"))
      (rule ".skip_link"
        (decl position "absolute")
        (decl left "1rem")
        (decl top "-4rem")
        (decl z_index 20)
        (decl padding "0.5rem 0.9rem")
        (decl border_radius "0.4rem")
        (decl background "var(--ink)")
        (decl color "#ffffff"))
      (rule ".skip_link:focus" (decl top "1rem") (decl color "#ffffff"))
      (rule ".visually_hidden"
        (decl position "absolute")
        (decl width "1px")
        (decl height "1px")
        (decl overflow "hidden")
        (decl clip "rect(0 0 0 0)")
        (decl white_space "nowrap"))

      # Header and navigation
      (rule ".site_header"
        (decl position "sticky")
        (decl top 0)
        (decl z_index 10)
        (decl border_bottom "1px solid var(--line)")
        (decl background "rgba(250, 248, 243, 0.95)"))
      (rule ".header_inner"
        (decl display "flex")
        (decl flex_wrap "wrap")
        (decl align_items "center")
        (decl gap "0.5rem 1.5rem")
        (decl min_height "4rem"))
      (rule ".wordmark"
        (decl display "inline-flex")
        (decl align_items "center")
        (decl gap "0.6rem")
        (decl margin_right "auto")
        (decl color "var(--ink)")
        (decl font_weight 700)
        (decl letter_spacing "-0.02em")
        (decl text_decoration "none"))
      (rule ".wordmark:hover" (decl color "var(--ink)"))
      (rule ".wordmark_mark"
        (decl display "grid")
        (decl place_items "center")
        (decl width "2rem")
        (decl height "2rem")
        (decl border_radius "0.5rem")
        (decl background "var(--ink)")
        (decl color "var(--paper)")
        (decl font "700 1.05rem/1 var(--mono)"))
      (rule ".site_nav"
        (decl display "flex")
        (decl flex_wrap "wrap")
        (decl align_items "center")
        (decl gap "0.25rem 1.25rem")
        (decl font_size "0.94rem"))
      (rule ".site_nav a"
        (decl padding "0.35rem 0")
        (decl color "var(--ink-soft)")
        (decl text_decoration "none"))
      (rule ".site_nav a:hover" (decl color "var(--blue)"))
      (rule ".site_nav .nav_app"
        (decl padding "0.4rem 0.85rem")
        (decl border_radius "0.5rem")
        (decl background "var(--blue)")
        (decl color "#ffffff"))
      (rule ".site_nav .nav_app:hover" (decl background "var(--blue-dark)") (decl color "#ffffff"))
      (rule ".nav_toggle"
        (decl display "none")
        (decl padding "0.45rem 0.8rem")
        (decl border "1px solid var(--line-strong)")
        (decl border_radius "0.5rem")
        (decl background "var(--panel)")
        (decl color "var(--ink)")
        (decl font "600 0.9rem/1 var(--sans)")
        (decl cursor "pointer"))
      (media "(max-width: 760px)"
        (rule ".header_inner" (decl padding_block "0.6rem"))
        (rule ".site_nav" (decl width "100%"))
        (rule ".enhanced .nav_toggle" (decl display "inline-flex"))
        (rule ".enhanced .site_nav" (decl display "none"))
        (rule ".enhanced .nav_open .site_nav"
          (decl display "flex")
          (decl flex_direction "column")
          (decl align_items "flex-start")
          (decl padding_block "0.25rem 0.75rem")))

      # Hero
      (rule ".hero" (decl padding_block "clamp(3rem, 8vw, 6rem) clamp(3rem, 7vw, 5rem)"))
      (rule ".hero_grid"
        (decl display "grid")
        (decl grid_template_columns "minmax(0, 1fr)")
        (decl gap "clamp(2.5rem, 5vw, 4rem)")
        (decl align_items "center"))
      (rule ".eyebrow, .section_label"
        (decl margin "0 0 1rem")
        (decl color "var(--teal)")
        (decl font_size "0.8rem")
        (decl font_weight 650)
        (decl letter_spacing "0.08em")
        (decl text_transform "uppercase"))
      (rule ".hero_title"
        (decl max_width "12ch")
        (decl margin 0)
        (decl font_size "clamp(2.5rem, 6.2vw, 4.5rem)")
        (decl font_weight 750)
        (decl line_height 1.03)
        (decl letter_spacing "-0.045em"))
      (rule ".hero_lede"
        (decl max_width "34rem")
        (decl margin "1.5rem 0 0")
        (decl color "var(--ink-soft)")
        (decl font_size "clamp(1.08rem, 1.6vw, 1.25rem)"))
      (rule ".actions"
        (decl display "flex")
        (decl flex_wrap "wrap")
        (decl gap "0.75rem")
        (decl margin_top "2rem"))
      (rule ".button"
        (decl display "inline-flex")
        (decl align_items "center")
        (decl padding "0.75rem 1.2rem")
        (decl border "1px solid transparent")
        (decl border_radius "0.6rem")
        (decl font_weight 600)
        (decl text_decoration "none"))
      (rule ".button_primary" (decl background "var(--blue)") (decl color "#ffffff"))
      (rule ".button_primary:hover" (decl background "var(--blue-dark)") (decl color "#ffffff"))
      (rule ".button_secondary"
        (decl border_color "var(--line-strong)")
        (decl background "var(--panel)")
        (decl color "var(--ink)"))
      (rule ".button_secondary:hover" (decl border_color "var(--ink-soft)") (decl color "var(--ink)"))
      (rule ".workflow"
        (decl margin 0)
        (decl overflow "hidden")
        (decl border "1px solid var(--line)")
        (decl border_radius "1rem")
        (decl background "var(--panel)")
        (decl box_shadow "0 1px 0 rgba(20, 33, 61, 0.04), 0 28px 56px -36px rgba(20, 33, 61, 0.4)"))
      (rule ".workflow_head"
        (decl display "flex")
        (decl flex_wrap "wrap")
        (decl justify_content "space-between")
        (decl gap "0.25rem 1rem")
        (decl padding "0.75rem 1.1rem")
        (decl border_bottom "1px solid var(--line)")
        (decl background "var(--surface)")
        (decl color "var(--muted)")
        (decl font_size "0.8rem"))
      (rule ".workflow_steps" (decl margin 0) (decl padding "0.35rem 0") (decl list_style "none"))
      (rule ".workflow_step"
        (decl display "grid")
        (decl grid_template_columns "5.25rem minmax(0, 1fr)")
        (decl gap "0.75rem")
        (decl padding "0.75rem 1.1rem"))
      (rule ".workflow_step + .workflow_step" (decl border_top "1px dashed var(--line)"))
      (rule ".workflow_who"
        (decl padding_top "0.15rem")
        (decl color "var(--muted)")
        (decl font_size "0.72rem")
        (decl font_weight 650)
        (decl letter_spacing "0.05em")
        (decl text_transform "uppercase"))
      (rule ".workflow_body" (decl min_width 0) (decl font_size "0.93rem"))
      (rule ".workflow_body p" (decl margin 0))
      (rule ".workflow_code"
        (decl margin "0.4rem 0 0")
        (decl color "var(--ink)")
        (decl font "0.8rem/1.55 var(--mono)")
        (decl white_space "pre-wrap")
        (decl overflow_wrap "anywhere"))
      (rule ".totals" (decl display "flex") (decl flex_wrap "wrap") (decl gap "0.5rem"))
      (rule ".total"
        (decl display "inline-flex")
        (decl align_items "baseline")
        (decl gap "0.35rem")
        (decl padding "0.25rem 0.65rem")
        (decl border_radius "999px")
        (decl background "var(--teal-soft)")
        (decl color "var(--teal-ink)")
        (decl font_size "0.82rem"))
      (rule ".total strong" (decl font_size "1rem"))
      (rule ".workflow_note" (decl margin "0.6rem 0 0") (decl color "var(--muted)") (decl font_size "0.82rem"))
      (media "(min-width: 960px)"
        (rule ".hero_grid" (decl grid_template_columns "minmax(0, 1.05fr) minmax(0, 1fr)")))

      # Sections
      (rule ".section"
        (decl padding_block "clamp(3.5rem, 8vw, 6rem)")
        (decl border_top "1px solid var(--line)"))
      (rule ".section_alt" (decl background "var(--surface)"))
      (rule ".section_head" (decl max_width "44rem") (decl margin_bottom "clamp(2rem, 4vw, 3rem)"))
      (rule ".section_title"
        (decl margin 0)
        (decl font_size "clamp(1.8rem, 3.6vw, 2.6rem)")
        (decl line_height 1.12)
        (decl letter_spacing "-0.03em"))
      (rule ".section_intro" (decl margin "1rem 0 0") (decl color "var(--ink-soft)") (decl font_size "1.08rem"))
      (rule ".card_grid, .steps"
        (decl display "grid")
        (decl gap "1rem")
        (decl margin 0)
        (decl padding 0)
        (decl list_style "none"))
      (rule ".card_grid" (decl grid_template_columns "repeat(auto-fit, minmax(16rem, 1fr))"))
      (rule ".card"
        (decl padding "1.5rem")
        (decl border "1px solid var(--line)")
        (decl border_radius "0.9rem")
        (decl background "var(--panel)"))
      (rule ".card h3" (decl margin "0 0 0.5rem") (decl font_size "1.15rem") (decl letter_spacing "-0.01em"))
      (rule ".card p" (decl margin 0) (decl color "var(--ink-soft)"))
      (rule ".card .card_detail"
        (decl margin_top "1rem")
        (decl padding_top "0.9rem")
        (decl border_top "1px solid var(--line)")
        (decl color "var(--muted)")
        (decl font "0.8rem/1.5 var(--mono)"))
      (rule ".steps"
        (decl grid_template_columns "repeat(auto-fit, minmax(14rem, 1fr))")
        (decl counter_reset "step"))
      (rule ".step"
        (decl padding "1.35rem 1.25rem 1.25rem")
        (decl border_top "3px solid var(--ink)")
        (decl border_radius "0 0 0.75rem 0.75rem")
        (decl background "var(--panel)")
        (decl counter_increment "step"))
      (rule ".step::before"
        (decl content "counter(step, decimal-leading-zero)")
        (decl display "block")
        (decl margin_bottom "0.6rem")
        (decl color "var(--teal)")
        (decl font "600 0.85rem/1 var(--mono)"))
      (rule ".step h3" (decl margin "0 0 0.5rem") (decl font_size "1.08rem"))
      (rule ".step p" (decl margin 0) (decl color "var(--ink-soft)") (decl font_size "0.95rem"))
      (rule ".step .step_note" (decl margin_top "0.8rem") (decl color "var(--muted)") (decl font_size "0.86rem"))

      # Code
      (rule ".code_block"
        (decl min_width 0)
        (decl margin 0)
        (decl overflow "hidden")
        (decl border "1px solid var(--code-line)")
        (decl border_radius "0.75rem")
        (decl background "var(--code-bg)"))
      (rule ".code_bar"
        (decl display "flex")
        (decl align_items "center")
        (decl justify_content "space-between")
        (decl gap "0.75rem")
        (decl min_height "2.4rem")
        (decl padding "0.35rem 0.5rem 0.35rem 0.9rem")
        (decl border_bottom "1px solid var(--code-line)")
        (decl background "var(--surface)")
        (decl color "var(--muted)")
        (decl font "0.78rem/1.3 var(--mono)"))
      (rule ".code_pre"
        (decl max_height "34rem")
        (decl margin 0)
        (decl padding "1rem 1.1rem")
        (decl overflow "auto")
        (decl color "var(--ink)")
        (decl font "0.84rem/1.65 var(--mono)")
        (decl tab_size 2))
      (rule ".code_pre:focus-visible" (decl outline_offset "-3px"))
      (rule ".code_wrap .code_pre" (decl white_space "pre-wrap") (decl overflow_wrap "anywhere"))
      (rule ".copy_button"
        (decl padding "0.4rem 0.65rem")
        (decl border "1px solid var(--line-strong)")
        (decl border_radius "0.4rem")
        (decl background "var(--panel)")
        (decl color "var(--ink)")
        (decl font "600 0.75rem/1 var(--sans)")
        (decl cursor "pointer"))
      (rule ".copy_button:hover" (decl border_color "var(--ink-soft)"))
      (rule ".gene_comment" (decl color "#5e6b7e"))
      (rule ".gene_string" (decl color "#236638"))
      (rule ".gene_number, .gene_literal" (decl color "#925016"))
      (rule ".gene_keyword" (decl color "#7b36a3"))
      (rule ".gene_callable" (decl color "#235eae"))
      (rule ".gene_property, .gene_type" (decl color "#176b70"))
      (rule ".gene_punctuation" (decl color "#566579"))
      (media "(forced-colors: active)"
        (rule ".gene_code span" (decl color "CanvasText")))

      # Worked example
      (rule ".view_tabs"
        (decl display "inline-flex")
        (decl gap "0.25rem")
        (decl max_width "100%")
        (decl margin_bottom "1.5rem")
        (decl padding "0.3rem")
        (decl overflow_x "auto")
        (decl border "1px solid var(--line)")
        (decl border_radius "0.7rem")
        (decl background "var(--panel)"))
      (rule ".view_tab"
        (decl padding "0.6rem 1.1rem")
        (decl border 0)
        (decl border_radius "0.45rem")
        (decl background "transparent")
        (decl color "var(--ink-soft)")
        (decl font "600 0.92rem/1 var(--sans)")
        (decl white_space "nowrap")
        (decl cursor "pointer"))
      (rule ".view_tab:hover" (decl background "var(--surface)") (decl color "var(--ink)"))
      (rule ".view_tab[aria-selected=\"true\"]" (decl background "var(--ink)") (decl color "var(--paper)"))
      (rule ".view" (decl display "grid") (decl gap "1.25rem") (decl min_width 0))
      (rule ".view + .view"
        (decl margin_top "3rem")
        (decl padding_top "2.5rem")
        (decl border_top "1px solid var(--line-strong)"))
      (rule ".enhanced .view + .view" (decl margin_top 0) (decl padding_top 0) (decl border_top 0))
      (rule ".view_title" (decl margin 0) (decl font_size "1.25rem"))
      (rule ".enhanced .view_title"
        (decl position "absolute")
        (decl width "1px")
        (decl height "1px")
        (decl overflow "hidden")
        (decl clip "rect(0 0 0 0)")
        (decl white_space "nowrap"))
      (rule ".view_text" (decl max_width "46rem") (decl margin 0) (decl color "var(--ink-soft)"))
      (rule ".request_quote"
        (decl margin 0)
        (decl padding "1.25rem 1.4rem")
        (decl border_left "3px solid var(--teal)")
        (decl border_radius "0 0.75rem 0.75rem 0")
        (decl background "var(--panel)"))
      (rule ".request_quote p" (decl margin 0))
      (rule ".meta_list"
        (decl display "flex")
        (decl flex_wrap "wrap")
        (decl gap "0.4rem 1.5rem")
        (decl margin 0)
        (decl padding 0)
        (decl list_style "none")
        (decl color "var(--muted)")
        (decl font_size "0.88rem"))
      (rule ".meta_list strong" (decl color "var(--ink)") (decl font_weight 600))
      (rule ".two_up" (decl display "grid") (decl grid_template_columns "minmax(0, 1fr)") (decl gap "1rem"))
      (media "(min-width: 960px)"
        (rule ".two_up" (decl grid_template_columns "minmax(0, 1fr) minmax(0, 1fr)") (decl align_items "start")))
      (rule ".disclosure"
        (decl border "1px solid var(--line)")
        (decl border_radius "0.75rem")
        (decl background "var(--panel)"))
      (rule ".disclosure > summary" (decl padding "0.9rem 1.1rem") (decl font_weight 600) (decl cursor "pointer"))
      (rule ".disclosure[open] > summary" (decl border_bottom "1px solid var(--line)"))
      (rule ".disclosure_body" (decl display "grid") (decl gap "1rem") (decl min_width 0) (decl padding "1.1rem"))
      (rule ".table_scroll"
        (decl overflow_x "auto")
        (decl border "1px solid var(--line)")
        (decl border_radius "0.75rem")
        (decl background "var(--panel)"))
      (rule ".result_table" (decl width "100%") (decl border_collapse "collapse") (decl font_size "0.95rem"))
      (rule ".result_table caption"
        (decl padding "0.75rem 1rem")
        (decl color "var(--muted)")
        (decl font_size "0.85rem")
        (decl text_align "left"))
      (rule ".result_table th, .result_table td"
        (decl padding "0.65rem 1rem")
        (decl border_top "1px solid var(--line)")
        (decl text_align "left")
        (decl white_space "nowrap"))
      (rule ".result_table thead th" (decl background "var(--surface)") (decl color "var(--ink-soft)") (decl font_size "0.82rem"))
      (rule ".result_table .num" (decl text_align "right") (decl font_variant_numeric "tabular-nums"))
      (rule ".result_table tfoot th, .result_table tfoot td" (decl font_weight 700))
      (rule ".evidence" (decl display "grid") (decl gap "0.6rem") (decl margin 0) (decl padding 0) (decl list_style "none"))
      (rule ".evidence li"
        (decl position "relative")
        (decl padding_left "1.9rem")
        (decl color "var(--ink-soft)"))
      (rule ".evidence li::before"
        (decl content "\"✓\"")
        (decl position "absolute")
        (decl left 0)
        (decl color "var(--teal)")
        (decl font_weight 700))

      # Written in Gene
      (rule ".gene_grid"
        (decl display "grid")
        (decl grid_template_columns "repeat(auto-fit, minmax(min(100%, 20rem), 1fr))")
        (decl gap "1.25rem"))
      (rule ".gene_item" (decl display "grid") (decl align_content "start") (decl gap "0.75rem") (decl min_width 0))
      (rule ".gene_item h3" (decl margin 0) (decl font_size "1.08rem"))
      (rule ".gene_item p" (decl margin 0) (decl color "var(--ink-soft)") (decl font_size "0.95rem"))

      # Run locally
      (rule ".run_grid" (decl display "grid") (decl grid_template_columns "minmax(0, 1fr)") (decl gap "clamp(1.5rem, 4vw, 3rem)"))
      (media "(min-width: 960px)"
        (rule ".run_grid" (decl grid_template_columns "minmax(0, 0.75fr) minmax(0, 1.25fr)")))
      (rule ".aside_panel"
        (decl align_self "start")
        (decl padding "1.5rem")
        (decl border "1px solid var(--line)")
        (decl border_radius "0.9rem")
        (decl background "var(--panel)"))
      (rule ".aside_panel h3" (decl margin "0 0 0.75rem") (decl font_size "1.05rem"))
      (rule ".aside_panel ul" (decl display "grid") (decl gap "0.6rem") (decl margin 0) (decl padding_left "1.1rem") (decl color "var(--ink-soft)"))
      (rule ".run_steps"
        (decl display "grid")
        (decl gap "2rem")
        (decl min_width 0)
        (decl margin 0)
        (decl padding 0)
        (decl list_style "none")
        (decl counter_reset "run"))
      (rule ".run_step" (decl display "grid") (decl gap "0.75rem") (decl min_width 0) (decl counter_increment "run"))
      (rule ".run_step > h3"
        (decl display "flex")
        (decl align_items "center")
        (decl gap "0.65rem")
        (decl margin 0)
        (decl font_size "1.1rem"))
      (rule ".run_step > h3::before"
        (decl content "counter(run)")
        (decl display "inline-grid")
        (decl place_items "center")
        (decl flex "none")
        (decl width "1.65rem")
        (decl height "1.65rem")
        (decl border_radius "50%")
        (decl background "var(--ink)")
        (decl color "var(--paper)")
        (decl font "600 0.8rem/1 var(--mono)"))
      (rule ".run_step p" (decl margin 0) (decl color "var(--ink-soft)"))
      (rule ".dirs" (decl display "grid") (decl gap "0.75rem") (decl margin 0))
      (rule ".dirs dt" (decl color "var(--ink)") (decl font "600 0.85rem/1.4 var(--mono)"))
      (rule ".dirs dd" (decl margin "0.2rem 0 0") (decl color "var(--ink-soft)") (decl font_size "0.95rem"))

      # FAQ and footer
      (rule ".faq_list" (decl display "grid") (decl gap "0.75rem") (decl max_width "52rem"))
      (rule ".faq_item"
        (decl border "1px solid var(--line)")
        (decl border_radius "0.75rem")
        (decl background "var(--panel)"))
      (rule ".faq_item > summary" (decl padding "1rem 1.2rem") (decl font_weight 600) (decl cursor "pointer"))
      (rule ".faq_item p" (decl margin 0) (decl padding "0 1.2rem 1.1rem") (decl color "var(--ink-soft)"))
      (rule ".site_footer"
        (decl padding_block "3rem")
        (decl background "var(--ink)")
        (decl color "#d9dfeb"))
      (rule ".footer_inner"
        (decl display "grid")
        (decl grid_template_columns "repeat(auto-fit, minmax(min(100%, 16rem), 1fr))")
        (decl gap "2rem"))
      (rule ".site_footer a" (decl color "#ffffff"))
      (rule ".footer_title" (decl margin 0) (decl color "#ffffff") (decl font_weight 700))
      (rule ".footer_note" (decl max_width "30rem") (decl margin "0.5rem 0 0") (decl color "#aab4c6") (decl font_size "0.92rem"))
      (rule ".footer_links"
        (decl display "flex")
        (decl flex_wrap "wrap")
        (decl gap "0.5rem 1.25rem")
        (decl margin 0)
        (decl padding 0)
        (decl list_style "none"))

      (media "(prefers-reduced-motion: no-preference)"
        (rule ".button, .view_tab, .copy_button, .site_nav a"
          (decl transition "background-color 120ms ease, color 120ms ease, border-color 120ms ease"))))))

(var website_css (render_css site_styles))
(var website_class (class_name site_styles))
