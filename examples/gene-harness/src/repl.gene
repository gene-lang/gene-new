# The terminal driver: read a prompt, hand it to the agent, print the answer.
#
# It knows nothing about what any prompt means. That is the `HarnessPrompt`
# seam's job, and the reason this file is short: swapping the agent for a
# model-backed one changes everything the harness can do and none of this.
#
# The driver is itself a plugin contributing a `views` row, so "is this
# deployment interactive?" is answered by profile composition rather than by a
# flag in main.gene.

(mod repl)

(import [Plugin PluginContext PluginHost Harness HarnessLog row] from "./kernel")
(import_impl PluginHost for PluginContext from "./kernel")
(import [ask] from "./agent")
(import [HarnessView view_provider] from "./view_api")

# A literal escape byte, because Gene has no string escape that produces one:
# `\e`, `\x1b` and `\u001b` are all read errors, `$str/from_utf8` wants a
# `(Buffer U8)`, and there is no `chr`. So the byte sits in the source between
# the quotes. It is invisible in most editors and `cat -v` shows it as `^[`.
(const ESC "")

(fn colored [text : Str] : Str
  ($str/join [ESC "[94m" text ESC "[0m"] ""))

(fn user_prompt [] : Str
  # Colour only when a terminal is on the other end. Piped input is how the
  # regression sweep drives this, and escape bytes in that output would be
  # noise in a transcript nobody is looking at in colour.
  (if ($os/stdin_tty?) (colored "User>") "User>"))

(fn quitting? [line : Str] : Bool
  (if (== line "quit") true (== line "exit")))

(type TerminalOutput)

(impl Callable for TerminalOutput
  (message apply [self call]
    (var event (call ~ /0))
    (if_yes (== event/kind "output") ($println event/text))))

(fn run_repl [h : Harness, implementation : Str] : Int
  ($println "Gene Agent — type `help`, or `quit` / Ctrl-D to leave")
  (var running true)
  (while running
    # A replacement becomes visible only here, between prompts. The old view
    # always finishes the turn that was already in progress, then hands control
    # to the newly committed active row.
    (var active (row h "views" "active"))
    (if_yes (|| (== active void)
                (!= active/implementation implementation))
      (if (== active void)
        (return 0)
        (return (active/value ~ HarnessView:run h))))
    # The prompt goes out with a newline rather than as `User> `. stdout is
    # line-buffered on a terminal and Gene exposes no flush, so a prompt
    # without a newline would sit in the buffer until after the answer it was
    # asking for — invisible exactly when it matters.
    ($println "")
    ($println (user_prompt))
    (var line ($os/read_line))
    (if_yes (== line nil)
      # Ctrl-D. `os/read_line` returns nil at EOF and needs no capability:
      # reading your own stdin is not host authority.
      ($println "bye")
      (set running false))
    (if_not (== line nil)
      (var text ($str/trim line))
      (if_yes (quitting? text)
        ($println "bye")
        (set running false))
      (if_not (quitting? text)
        (if_yes (!= text "")
          # One speaker label per exchange. The agent may take several turns
          # after this, and those are marked as rounds rather than repeating
          # the label — the harness is still the one talking.
          ($println "Gene>")
          (ask h text)))))
  0)

(type TerminalView ^props {^implementation Str})
(impl HarnessView for TerminalView
  (message run [h] : Any (run_repl h self/implementation)))

(fn driver_plugin [] : Plugin
  (Plugin ^id "driver" ^provides [["views" "active"]]
    ^requires ["HarnessPrompt"] ^contextual true
    ^activate (fn [] (fn [host]
      (host ~ PluginHost:subscribe HarnessLog (TerminalOutput))
      (host ~ PluginHost:contribute "views"
        {^name "active" ^implementation "terminal"
         ^value (view_provider
           (TerminalView ^implementation "terminal"))})))))
