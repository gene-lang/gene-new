(mod process_tools)
(import [Plugin PluginContext PluginHost HarnessError ToolError ToolTask] ^from "../../src/kernel")
(import_impl PluginHost for PluginContext ^from "../../src/kernel")
(import $os [exec_async])

(fn run_process [h input]
  (var dir (?? input/directory "."))
  (if (|| ($str/starts_with? dir "/") (($str/split dir "/") .contains? ".."))
    (fail (HarnessError ^message "directory must be relative to the project root")))
  (var root h/workspace/workspace_root)
  (var timeout ($math/min 90000 ($math/max 1 (?? input/timeout_ms 30000))))
  (var task (exec_async ^cmd input/command ^args (?? input/args [])
    ^dir (if (== dir ".") root $"${root}/${dir}") ^timeout_ms timeout ^max_bytes 32768))
  (ToolTask ^task task ^continuation process_result))

(fn process_result [result]
  (if_yes (|| result/timed_out (!= result/status 0))
    (fail (ToolError ^code (if result/timed_out "process_timeout" "process_exit")
      ^message $"Process exited with status ${result/status}" ^data result)))
  result)

(fn process_plugin [] : Plugin
  (Plugin ^id "process" ^contextual true ^provides [["tools" "process.run"]]
    ^activate (fn [] (fn [host]
      (host .PluginHost:contribute "tools"
        {^name "process.run" ^contextual true ^run run_process
         ^doc "Run an executable with an argument list in the project directory. No shell parsing. Returns status, stdout, stderr and timeout/truncation flags; nonzero status means the command failed. Uses the launcher's os/Exec authority, not a subprocess filesystem sandbox."
         ^input_schema {^type "object" ^required ["command"] ^additionalProperties false
           ^properties {^command {^type "string"}
             ^args {^type "array" ^items {^type "string"}}
             ^directory {^type "string"} ^timeout_ms {^type "integer"}}}})))))
