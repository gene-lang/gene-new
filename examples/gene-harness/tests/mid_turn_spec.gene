(import $test [describe it])
(import [isolated run_spec] ^from "./support")
(import ^from "../src/runtime/bootstrap" [open_runtime close_runtime])
(import ^from "../src/profiles/baseline" [baseline_profile])
(import ^from "../src/kernel" [Plugin PluginHost install row])
(import ^from "../src/agents/harness_turn" [evaluate_harness_turn])
(describe "Harness composition"
  (it "publishes contributions on the next turn through the origin-owned queue" []
    (isolated this_mod/.path "publishes contributions on the next turn through the origin-owned queue"
      (fn [workspace]
        (let runtime (open_runtime workspace "default" (baseline_profile)))
        (let entered ($cell false))
        (let release ($cell false))
        (try
          (install runtime/h (Plugin ^id "dynamic" ^activate (fn [host]
            (host .PluginHost:contribute "functions" {^name "add_later" ^doc "Contribute at the turn boundary."
              ^fn (fn []
                (host .PluginHost:contribute "functions" {^name "later" ^doc "Added function." ^fn (fn [] "later")})
                ($assert ($absent? (row runtime/h "functions" "later")) "host lookup saw mid-turn mutation")
                (entered .set true)
                (while (! (release .get)) ($sleep 1))
                "queued")}))))
          (let task (spawn ^lane root (evaluate_harness_turn runtime/h 1 runtime/root
            "(add_later) (Outcome ^done true ^reply session_id)" ^session "a")))
          (while (! (entered .get)) ($sleep 1))
          (let other (evaluate_harness_turn runtime/h 1 runtime/root "(Outcome ^done true ^reply \"other\")" ^session "b"))
          ($assert ($absent? (row runtime/h "functions" "later")) "another turn published the still-open origin's queue")
          (release .set true)
          (let result (await task))
          ($assert (== result/validated/outcome/reply "a") "session_id binding was absent")
          ($assert (! ($absent? (row runtime/h "functions" "later"))) "turn boundary did not publish contribution")
          (let next (evaluate_harness_turn runtime/h 2 runtime/root "(Outcome ^done true ^reply (later))"))
          ($assert (== next/validated/outcome/reply "later") "next turn could not call new function")
          ($println "mid-turn contribution: immutable visibility, origin-owned queue and next-turn publication")
        ensure
          (release .set true)
          (close_runtime runtime))))))

(fn main [args] : Int (run_spec args))
