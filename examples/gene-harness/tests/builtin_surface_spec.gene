(import $test [describe it])
(import [isolated run_spec] ^from "./support")
(import ^from "../src/runtime/bootstrap" [open_runtime close_runtime])
(import ^from "../src/profiles/baseline" [baseline_profile])
(import ^from "../src/kernel" [row doc])
(import ^from "../src/storage/workspace" [set_plugin_enabled])
(import ^from "../src/agents/instructions" [assemble_instructions])
(import ^from "../src/web/session_service" [open_session_service close_session_service])

(describe "Built-in contributions"
  (it "unwinds command, plugin and reference rows while retaining loop controls" []
    (isolated this_mod/.path "unwinds command, plugin and reference rows while retaining loop controls"
      (fn [workspace]
        (let runtime (open_runtime workspace "default" (baseline_profile)))
        (try
          ($assert (! ($absent? (row runtime/h "commands" "help")))
            "core command plugin did not mount")
          ($assert (! ($absent? (row runtime/h "functions" "register_plugin")))
            "plugin administration did not mount")
          ($assert ($str/contains? (doc runtime/h "gene/stdlib") "stdlib")
            "language reference did not mount")
          ($assert
            (! ($str/contains? (assemble_instructions runtime {^kind "interactive"})
                 "web_components registry"))
            "CLI prompt describes the web-only contribution")
          ($assert (== (row runtime/h "commands" "new") void)
            "CLI command was mounted before the CLI entry point")
          (set_plugin_enabled runtime/workspace runtime/h "core_commands" false)
          ($assert (== (row runtime/h "commands" "help") void)
            "disabled core command stayed visible")
          ($assert (! ($absent? (row runtime/h "commands" "cancel")))
            "loop control disappeared with core commands")
          (set_plugin_enabled runtime/workspace runtime/h "core_commands" true)
          ($assert (! ($absent? (row runtime/h "commands" "help")))
            "enable did not restore shared commands")
          (set_plugin_enabled runtime/workspace runtime/h "gene_reference" false)
          ($assert
            (try (doc runtime/h "gene/stdlib") false catch Any true)
            "language chapter survived its plugin's disable")
          (set_plugin_enabled runtime/workspace runtime/h "gene_reference" true)
          (set_plugin_enabled runtime/workspace runtime/h "plugin_admin" false)
          ($assert (== (row runtime/h "functions" "register_plugin") void)
            "disabled plugin administration remained callable")
          (set_plugin_enabled runtime/workspace runtime/h "plugin_admin" true)
        ensure
          (close_runtime runtime))
        (let web_root ($path/join workspace "web"))
        ($fs/make_dir web_root)
        (let service (open_session_service ^workspace web_root ^^offline))
        (try
          ($assert ($str/contains? (doc service/runtime/h "harness/web_components") "web")
            "web entry did not contribute its documentation")
          ($assert ($str/contains?
            (assemble_instructions service/runtime {^kind "interactive"})
            "web_components registry")
            "web entry did not contribute its prompt paragraph")
          ($assert (== (row service/runtime/h "commands" "new") void)
            "web host received a CLI-only command")
        ensure
          (close_session_service service)))))

  (it "uses the response budget for host plugin callbacks" []
    (isolated this_mod/.path "uses the response budget for host plugin callbacks"
      (fn [workspace]
        (let initial (open_runtime workspace "default" (baseline_profile)))
        (let config_path $"${initial/state_root}/config.gene")
        (close_runtime initial)
        (let config ($serde/read_data ($fs/read_text config_path)))
        (config .put "response_budget" {^timeout_ms 610000 ^max_memory_mb 768})
        ($fs/write_text_atomic config_path ($serde/write_data config))
        (let runtime (open_runtime workspace "default" (baseline_profile)))
        (try
          (let policy (runtime/h/plugin_policies/.get .get "core_commands"))
          ($assert (== policy/limits/timeout_ms 610000)
            "host plugin kept the old timeout ceiling")
          ($assert (== policy/limits/max_memory_mb 768)
            "host plugin kept the old memory ceiling")
        ensure
          (close_runtime runtime))))))

(fn main [args] : Int (run_spec args))
