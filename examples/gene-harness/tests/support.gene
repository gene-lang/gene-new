# Runtime specs need independent Applications as well as fresh workspaces:
# opening a harness changes cwd, and crash fixtures deliberately kill processes.
# Both the parent and child use the ordinary $test registry and reports.
(import $test [assert_equal run])
(import [Plugin PluginHost] ^from "../src/plugin_api")
(import [put_cordis_plugin] ^from "../src/kernel")
(import [Profile] ^from "../src/profiles/profile")
(import [baseline_profile] ^from "../src/profiles/baseline")
(import [start_delegation_host] ^from "../src/runtime/delegations")
(import [open_session_service] ^from "../src/web/session_service")

(let package_root ($path/parent ($path/parent this_mod/.path)))
(let application ($pkg/application))
(let source_root application/source_root)
(let active_workspace ($cell nil))
(let callback_cells ($cell {}))
(let native_tools ($cell nil))

(fn test_native_tools []
  (if ($present? native_tools/.get) (return native_tools/.get))
  (let tools {})
  (for name in ["cc" "pkg-config"]
    (let found (try (await ($os/exec_async "/usr/bin/which" name ^timeout_ms 1000 ^max_bytes 4096)) catch Any nil))
    (if (== found/status 0)
      (then
        (let path ($str/trim found/stdout))
        (if (&& ($str/starts_with? path "/") (! ($str/contains? path "\n"))) (tools .put name path)))))
  (native_tools .set tools)
  tools)

(fn callback_plugin [cell]
  (Plugin ^id "provider_test" ^provides [["providers" "test"]]
    ^activate (fn [host]
      (host .PluginHost:contribute "providers"
        {^name "test" ^doc "Model-free test callback."
         ^configure (fn [model, effort, timeout]
           {^model "test" ^effort "none" ^timeout_ms timeout})
         ^prepare (fn [call] call)
         ^send (fn [prepared]
           (let callback cell/.get)
           {^text (callback prepared)})}))))

(fn set_test_provider [runtime, callback]
  (let cell (callback_cells/.get .get runtime/root))
  (if ($absent? cell) (fail "test provider was not installed"))
  (cell .set callback)
  nil)

(fn test_controller [runtime, callback]
  (if_not ($absent? callback)
    (let cell ($cell callback))
    (put_cordis_plugin ^^replace runtime/h (callback_plugin cell)
      {^^host ^limits runtime/profile/limits})
    (callback_cells/.get .put runtime/root cell)
    (set runtime/profile/provider "test"))
  (start_delegation_host runtime/services/values/delegations)
  runtime/services/values/controller)

(fn test_service [^workspace workspace : Str = "", ^provider provider, ^without_plugins without_plugins = [],
  ^channel_options channel_options = nil]
  (let cell ($cell provider))
  (let base (baseline_profile))
  (let plugins [])
  (for plugin in base/plugins
    (if_not (without_plugins .contains? plugin/id) (plugins .push plugin)))
  (plugins .push (callback_plugin cell))
  (let profile (Profile ^name "test" ^plugins plugins ^limits base/limits
    ^requires base/requires ^provider "test"))
  (let service (open_session_service ^workspace workspace ^profile profile ^channel_options channel_options))
  (callback_cells/.get .put service/runtime/root cell)
  service)

(fn package_path [path : Str] : Str
  ($path/join package_root path))

(fn source_path [path : Str] : Str
  ($path/join source_root path))

(fn fixture_path [name : Str] : Str
  ($path/join source_root $"tests/fixtures/${name}.gene"))

# `$fs` has no recursive delete. Walk entries are preorder, so removing them in
# reverse empties each directory before it is removed; symlinks are removed,
# never followed.
(fn remove_tree [root : Str]
  (let entries (($fs/walk root) -> $into []))
  # Snapshot artifacts in a spec's private HOME are read-only directories;
  # make every directory writable so its entries can be removed.
  (for entry in entries
    (if (== entry/kind "directory") (try ($fs/set_mode entry/path 448) catch Any nil)))
  (var at entries/.size)
  (while (> at 0)
    (set at (- at 1))
    (let entry entries/%at)
    (if (== entry/kind "directory")
      ($fs/remove_dir entry/path)
      ($fs/remove entry/path)))
  ($fs/remove_dir root))

(fn isolated [spec_path : Str, name : Str, body, ^timeout_ms timeout_ms : Int = 120000]
  (let selected active_workspace/.get)
  (if_not ($absent? selected) (return (body selected)))
  (let workspace ($path/join source_root $"tmp/spec-${($crypto/random_hex 12)}"))
  ($fs/make_dir workspace)
  # Vendor probes must never inspect the developer's accounts or API keys.
  # These tiny executables stand in for external CLIs at the process boundary.
  (let bin ($path/join workspace "probe-bin"))
  ($fs/make_dir bin)
  (for name in ["claude" "ant"]
    (let path ($path/join bin name))
    ($fs/write_text path "#!/bin/sh\nexit 1\n")
    ($fs/set_mode path 493))
  # Normal supervised hosts select declared native recipes. Expose only their
  # public build tools alongside the fake vendor binaries, keeping other host
  # programs and real login tools off this test PATH.
  (let tools (test_native_tools))
  (for [name path] in tools ($fs/create_symlink path ($path/join bin ($to_str name))))
  (let environment
    {^GENE_HARNESS_ROOT ($path/join workspace "manager-root")
     ^GENE_HARNESS_CLAUDE_COMMAND ($path/join bin "claude")
     ^GENE_HARNESS_ANT_COMMAND ($path/join bin "ant")
     ^GENE_HARNESS_AUTH_HOME ($path/join workspace "provider-logins")
     ^GENE_C_COMPILER (?? ($os/env? "GENE_C_COMPILER") (tools .get "cc"))
     ^GENE_HARNESS_PROVIDER nil ^GENE_HARNESS_MODEL nil ^GENE_HARNESS_THINKING_EFFORT nil
     ^OPENROUTER_MODEL nil
     ^ANTHROPIC_API_KEY nil ^ANTHROPIC_AUTH_TOKEN nil ^CLAUDE_CODE_OAUTH_TOKEN nil
     ^OPENROUTER_API_KEY nil ^OPENROUTER_KEY nil
     ^PATH bin})
  (let progress (== ($os/get_env "GENE_HARNESS_TEST_PROGRESS" "") "1"))
  (let started ($os/monotonic_ms))
  (if progress (then ($println $"Running: ${name}") ($io/flush_stdout)))
  (let result (await ($os/exec_async ($os/executable_path)
    "run" "--snapshot" ($path/join source_root ($path/relative spec_path package_root)) workspace name ^dir source_root
    ^env environment ^timeout_ms timeout_ms ^max_bytes 1048576)))
  (if progress (then ($println $"Finished in ${(- ($os/monotonic_ms) started)} ms: ${name}") ($io/flush_stdout)))
  (assert_equal result/status 0
    $"Isolated spec failed. Workspace: ${workspace}; status ${result/status}; timed_out ${result/timed_out}\n${result/stdout}${result/stderr}")
  ($assert (! result/truncated) "isolated spec output exceeded its capture bound")
  # A failed run keeps its workspace for inspection; the message names it.
  (remove_tree workspace))

# Used by `gene run file_spec.gene` and by isolated children. Ordinary `gene
# test` discovery registers examples without invoking main or creating files.
(fn run_spec [args] : Int
  (if_not ($absent? args/0) (active_workspace .set args/0))
  (let result (run ^name (?? args/1 "")))
  result/exit_code)
