(import $test [describe it])
(import [isolated run_spec] ^from "./support")
(import ^from "../src/web/session_service"
  [
    open_session_service
    close_session_service
    create_session
    submit
    receipt
    answer
    snapshot
    host_status])
(describe "Harness web turn loop"
  (it "serves code responses and questions with deduplicated replies" []
    (isolated this_mod/.path "serves code responses and questions with deduplicated replies"
      (fn [workspace]
        (let calls ($cell 0))
        (let service
          (open_session_service ^workspace workspace ^provider (fn [request] (let count (calls .swap (+ calls/.get 1))) (if (== count 0) "# Ask\n(Outcome ^questions [{^id \"ok\" ^prompt \"Continue?\" ^kind \"confirm\"}])" "# Finish\n(Outcome ^done true ^reply \"web done\")"))))
        (try
          (let session (create_session ^title "Web scripted" service))
          (let round (submit service session/id "web-1" 1 "start"))
          (service/controller/watchers
            .get
            ; .get session/id
            ; .join)
          (let waiting (receipt service session/id round/id))
          ($assert (== waiting/state "waiting") $"web round failed: ${waiting}")
          (let view (snapshot service session/id))
          ($assert (== view/protocol 4) "snapshot retained protocol 3")
          ($assert (== view/questions/questions/.size 1) "web snapshot lost the batch")
          (answer service session/id waiting/questions/id {^^ok})
          (service/controller/watchers
            .get
            ; .get session/id
            ; .join)
          (let done (receipt service session/id round/id))
          ($assert (== done/reply "web done") "web answer did not execute a code response")
          (let replay (answer service session/id waiting/questions/id {^^ok}))
          ($assert (== replay/id round/id) "answer retry changed the round")
          ($assert
            (try
              (answer service session/id waiting/questions/id {^ok false})
              false
            catch Any
              true)
            "conflicting answer retry was accepted")
          ($println "web turn loop: protocol 4 service, code-only provider, questions and reply dedupe")
        ensure
          (close_session_service service))))))

(fn main [args] : Int (run_spec args))
