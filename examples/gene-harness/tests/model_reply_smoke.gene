(mod model_reply_smoke)

(import $fs [make_dir])
(import
  [HarnessError new_harness install resolve status_of log_events shutdown_harness]
  from
  "../src/kernel")
(import [parse_envelope] from "../src/model_reply")
(import
  [
    run_task
    run_program
    harness_bindings
    llm_agent_plugin
    module_from_reply
    system_prompt
    codegen_system_prompt]
  from
  "../src/llm")
(import [open_workspace close_workspace] from "../src/workspace")
(import [open_event_store close_event_store plugin_state] from "../src/state")

(fn rejects [call, expected : Str]
  (var message "")
  (try
    (call)
  catch HarnessError
    (set message $err/message))
  ($assert ($str/contains? message expected) $"expected '${expected}', got '${message}'"))

(fn output_texts [h]
  (var out [])
  (for event in (log_events h)
    (if_yes (== event/kind "output") (out .push event/text)))
  out)

(fn scripted [replies, calls, histories]
  (fn [h, prompt, history]
    (var i (calls .get))
    ($assert (< i replies/.size) "unexpected extra model round")
    (calls .set (+ i 1))
    (histories .push history)
    replies/%i))

(fn main [args]
  # Parsing validates the tagged union without evaluating code or payload.
  (var plain (parse_envelope "{^type \"response\" ^response \"hello\"}"))
  ($assert (== plain/response "hello"))
  (for kind in ["code" "code-with-response"]
    (var without_text (parse_envelope $"{^type \"${kind}\" ^code (do 7)}"))
    ($assert ($absent? without_text/response))
    (var with_text
      (parse_envelope $"{^type \"${kind}\" ^response \"working\" ^code (do 7)}"))
    ($assert (== with_text/response "working")))
  (for raw in ["nil" "[]" "(do 1)" "hello"]
    (rejects (fn [] (parse_envelope raw)) "one Gene map"))
  (rejects (fn [] (parse_envelope "{^status \"done\" ^response \"old\"}")) "^type")
  (rejects (fn [] (parse_envelope "{^type \"unknown\"}")) "^type")
  (rejects (fn [] (parse_envelope "{^type \"response\"}")) "require ^response")
  (rejects (fn [] (parse_envelope "{^type \"response\" ^response 3}")) "must be a string")
  (rejects (fn [] (parse_envelope
    "{^type \"response\" ^response \"x\" ^code (do 1)}")) "cannot contain ^code")
  (rejects (fn [] (parse_envelope "{^type \"code\"}")) "^code (do ...)")
  (rejects (fn [] (parse_envelope "{^type \"code\" ^code \"(do 1)\"}")) "^code (do ...)")
  (rejects (fn [] (parse_envelope "{^type \"code\" ^code (+ 1 2)}")) "^code (do ...)")
  (rejects (fn [] (parse_envelope
    "{^type \"code\" ^code (do 1) ^payload []}")) "^payload must be a map")
  (rejects (fn [] (parse_envelope
    "{^type \"code\" ^code (do 1) ^payload nil}")) "^payload must be a map")
  (rejects (fn [] (parse_envelope
    "{^type \"code\" ^code (do 1) ^response nil}")) "^response must be a string")
  (rejects (fn [] (parse_envelope
    "{^type \"response\" ^response \"x\"} (do ($panic \"never\"))")) "exactly one map")
  (rejects (fn [] (parse_envelope "{^type \"response\" ^response \"x\"")) "not readable")
  (rejects (fn [] (parse_envelope
    "```gene\n{^type \"response\" ^response \"x\"}\n```")) "model reply")

  (make_dir $"${args/0}/workspace")
  (make_dir $"${args/0}/events")
  (var workspace (open_workspace $"${args/0}/workspace"))
  (var events (open_event_store $"${args/0}/events"))
  (var h (new_harness ^workspace workspace ^event_store events ^event_stream "session-7"))
  (install h (llm_agent_plugin))
  ($assert (== (status_of h "agent") "ready"))
  (var provider (resolve h "HarnessPrompt"))
  (var session provider/session)
  (var host provider/state_host)

  (var data {^answer 42 ^inert (quote (do ($panic "payload was evaluated")))})
  (var bindings (harness_bindings h [] ^session session ^state_host host ^payload data))
  ($assert (== bindings/harness h))
  ($assert (== bindings/h h))
  ($assert (== bindings/session/history session))
  ($assert (== bindings/session/state_host host))
  ($assert (== bindings/context/workspace workspace))
  ($assert (== bindings/payload data))
  ($assert (== (bindings/get_payload) data))
  (var accessed
    (run_program h
      (quote (do
        ($assert (== h harness))
        ($assert (== ($head harness) Harness))
        ($assert (== context/harness harness))
        ($assert (== session/id harness/event_stream))
        ($assert (== session/scope harness/event_scope))
        ($assert (== context/session session))
        ($assert (== context/prompt "inspect context"))
        ($assert (== context/round 3))
        ($assert (! ($absent? (harness/transaction .get))))
        ($assert (== (session/state_host .PluginHost:state) nil))
        (var supplied (get_payload))
        ($assert (== ($head supplied/inert) (quote do)))
        (+ payload/answer supplied/answer)))
      ^session session ^state_host host ^payload data ^prompt "inspect context" ^round 3))
  ($assert (== accessed "84") accessed)
  (run_program h (quote (do (session/history .set ["context edit"])))
    ^session session ^state_host host)
  ($assert (== (session .get) ["context edit"]))
  (session .set [])
  ($assert (== (run_program h (quote (do (get_payload)))) "{}"))
  (var denied (run_program h (quote (do ($os/env? "HOME")))))
  ($assert ($str/starts_with? denied "refused:") denied)

  # Narration must be visible in the log before either code type executes.
  (var narrated
    "{^type \"code-with-response\" ^response \"Counting now.\"
      ^payload {^items [1 2 3] ^inert (do ($panic \"never evaluate payload\"))}
      ^code (do
        (var seen false)
        (for event in (harness/log .get)
          (if_yes (== event/text \"Counting now.\") (set seen true)))
        ($assert seen)
        (var supplied (get_payload))
        supplied/items/.size)}")
  (var calls ($cell 0))
  (var histories [])
  (var result (run_task h "count" session host
    ^complete (scripted [narrated] calls histories)))
  ($assert (== result "3") result)
  ($assert (== (calls .get) 1))
  ($assert ((output_texts h) .contains? "Counting now."))
  (var persisted (plugin_state events "session" "session-7" "agent"))
  ($assert ($str/contains? persisted/history/0 "harness: 3"))
  ($assert (! ($str/contains? persisted/history/0 "Counting now.")))

  # Plain code always requests another round, with code, payload and result.
  (calls .set 0)
  (set histories [])
  (set result (run_task h "inspect" session host
    ^complete (scripted
      ["{^type \"code\" ^response \"Inspecting now.\" ^payload {^value 17}
          ^code (do
            (var seen false)
            (for event in (harness/log .get)
              (if_yes (== event/text \"Inspecting now.\") (set seen true)))
            ($assert seen)
            payload/value)}"
       "{^type \"response\" ^response \"The value is seventeen.\"}"] calls histories)))
  ($assert (== result "The value is seventeen."))
  ($assert (== (calls .get) 2))
  ($assert ($str/contains? histories/1 "output: 17"))
  ($assert ($str/contains? histories/1 "^payload"))
  (var saved (session .get))
  ($assert ($str/contains? saved/1 "harness: The value is seventeen."))

  # Omitted response text is valid for both code types. Omitted payload does
  # not reuse an earlier round's payload; even (do nil) is a real result.
  (calls .set 0)
  (set result (run_task h "silent code" session host
    ^complete (scripted
      ["{^type \"code\" ^payload {^old true} ^code (do nil)}"
       "{^type \"code-with-response\" ^code (do (get_payload))}"] calls [])))
  ($assert (== result "{}") result)
  ($assert (== (calls .get) 2))
  (calls .set 0)
  (set result (run_task h "nil result" session host
    ^complete (scripted ["{^type \"code-with-response\" ^code (do nil)}"] calls [])))
  ($assert (== result "nil"))
  ($assert (== (calls .get) 1))

  # Rejected envelopes never execute. The model sees the validation failure
  # and can repair it; code-with-response returns execution errors directly.
  (calls .set 0)
  (set histories [])
  (set result (run_task h "repair format" session host
    ^complete (scripted
      ["{^type \"response\" ^response \"bad\" ^code (do ($panic \"never\"))}"
       "{^type \"response\" ^response \"Repaired.\"}"] calls histories)))
  ($assert (== result "Repaired."))
  ($assert ($str/contains? histories/1 "cannot contain ^code"))
  (calls .set 0)
  (set result (run_task h "runtime error" session host
    ^complete (scripted
      ["{^type \"code-with-response\" ^code (do (fail (HarnessError ^message \"deliberate\")))}"] calls [])))
  ($assert ($str/contains? result "error: deliberate") result)
  ($assert (== (calls .get) 1))
  (var forever_calls ($cell 0))
  (set result (run_task h "bounded loop" session host
    ^complete (fn [h, prompt, history]
      (forever_calls .set (+ (forever_calls .get) 1))
      "{^type \"code\" ^code (do nil)}")))
  ($assert (== (forever_calls .get) 8))
  ($assert ($str/contains? result "without a final response"))

  # Plugin authoring follows the envelope too; extracting a module is inert.
  (var module (module_from_reply
    "{^type \"response\" ^response \"Authored.\"
      ^payload {^module (mod plugin (fn init [] ($panic \"never run here\")))}}"))
  ($assert (== ($head module) (quote mod)))
  (rejects (fn [] (module_from_reply "(mod plugin)")) "one Gene map")
  (rejects (fn [] (module_from_reply "{^type \"response\" ^response \"Missing.\"}"))
    "^payload/^module")
  (rejects (fn [] (module_from_reply "{^type \"code\" ^code (do 1)}"))
    "response envelope")
  (for text in [(system_prompt h) (codegen_system_prompt "")]
    ($assert ($str/contains? text "OPTIONAL for either code type"))
    ($assert ($str/contains? text "code-with-response")))

  (shutdown_harness h)
  (close_workspace workspace)
  (close_event_store events)
  ($println "model_reply_smoke: ok"))
