(import $test [describe it])
(import [isolated run_spec test_controller] ^from "./support")
(import ^from "../src/runtime/bootstrap" [open_runtime close_runtime])
(import ^from "../src/profiles/baseline" [baseline_profile])
(import ^from "../src/runtime/round_controller" [new_round_controller close_round_controller])
(import ^from "../src/runtime/triggers"
  [open_trigger_manager close_trigger_manager create_trigger tick_triggers list_occurrences apply_retention])
(import ^from "../src/runtime/sessions" [require_record update_session view_session leave_session create_session list_sessions])
(import ^from "../src/kernel" [contribute])
(describe "Harness trigger policies"
  (it "enforces caps, queueing, coalescing and retention protections" []
    (isolated this_mod/.path "enforces caps, queueing, coalescing and retention protections"
      (fn [workspace]
        (let runtime (open_runtime workspace "default" (baseline_profile)))
        (let config ($serde/read_data ($fs/read_text $"${runtime/state_root}/config.gene")))
        (config .put "trigger_concurrency" 1)
        (config .put "trigger_timeout_ms" 10000)
        ($fs/write_text_atomic $"${runtime/state_root}/config.gene" ($serde/write_data config))
        (let release ($cell false))
        (let controller (test_controller runtime (fn [request]
          (while (! release/.get) ($sleep 1))
          "(Outcome ^done true ^reply \"nothing to do\")")))
        (let manager (open_trigger_manager runtime controller ^start false ^now 1000))
        (try
          (create_trigger manager {^id "queue" ^kind "heartbeat" ^every_ms 100 ^request "check" ^overlap "queue_one" ^retention {^keep 1}} ^now 1000)
          (tick_triggers manager ^now 1100)
          (tick_triggers manager ^now 1200)
          (tick_triggers manager ^now 1300)
          (let pending (list_occurrences manager ^trigger "queue"))
          ($assert (== pending/0/state "started") "first occurrence did not start")
          ($assert (== pending/1/state "due") "cap dropped queued occurrence")
          ($assert (== pending/2/state "skipped") "queue_one did not coalesce")
          ($assert (== pending/2/reason "coalesced") "wrong skipped reason")
          (release .set true)
          (for [id watcher] in controller/watchers/.get watcher/.join)
          (tick_triggers manager ^now 1300)
          (for [id watcher] in controller/watchers/.get watcher/.join)
          (tick_triggers manager ^now 1300)
          (let finished (list_occurrences manager ^trigger "queue"))
          ($assert (== finished/1/state "finished") "queued occurrence did not start when slot freed")
          (update_session runtime/sessions finished/1/session {^^pinned})
          (let kept (create_session runtime/sessions ^id "needs-attention" ^kind "heartbeat" ^trigger "queue"))
          (update_session runtime/sessions kept/id {^^attention})
          (let patched (create_session runtime/sessions ^id "patched" ^kind "heartbeat" ^trigger "queue"))
          (update_session runtime/sessions patched/id {^^has_patch})
          (let removed (apply_retention manager ^now 1300))
          ($assert (== removed/0 finished/0/session) "retention did not collect empty heartbeats first")
          ($assert (require_record runtime/sessions finished/1/session; .get "pinned") "retention collected pinned session")
          ($assert (require_record runtime/sessions kept/id; .get "attention") "retention collected attention session")
          (view_session runtime/sessions kept/id)
          ($assert (! (require_record runtime/sessions kept/id; .get "attention")) "opening did not clear attention")
          (leave_session runtime/sessions kept/id)
          (create_trigger manager {^id "missed-once" ^kind "cron" ^cron "* * * * *" ^timezone "UTC" ^request "audit" ^missed "once"} ^now 1000)
          (create_trigger manager {^id "missed-skip" ^kind "cron" ^cron "* * * * *" ^timezone "UTC" ^request "audit" ^missed "skip"} ^now 1000)
          (tick_triggers manager ^now 180000 ^^boot)
          ($assert (== (list_occurrences manager ^trigger "missed-once"; .size) 1) "downtime created three occurrences")
          (let skipped (list_occurrences manager ^trigger "missed-skip"))
          ($assert (== skipped/0/state "skipped") "missed skip started a round")
          ($assert (== skipped/0/at_ms 180000) "missed cron was not coalesced to latest time")
          (contribute runtime/h "core" "triggers" {^id "plugin-trigger" ^kind "scheduled" ^at 999999 ^request "plugin work"})
          (tick_triggers manager ^now 180000)
          ($assert (! ($absent? (manager/definitions/.get .get "plugin-trigger"))) "plugin trigger was not durable")
          ($println "trigger policies: cap, queue_one, coalescing, slot release, retention protections, attention and missed cron")
        ensure
          (close_trigger_manager manager)
          (close_round_controller controller)
          (close_runtime runtime))))))

(fn main [args] : Int (run_spec args))
