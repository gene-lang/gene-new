(import $test [describe it])
(import [isolated run_spec] ^from "./support")
(import ^from "../src/runtime/bootstrap" [open_runtime close_runtime])
(import ^from "../src/profiles/baseline" [baseline_profile])
(import ^from "../src/runtime/round_controller"
  [new_round_controller close_round_controller])
(import ^from "../src/agents/harness_turn" [evaluate_harness_turn])
(import ^from "../src/agents/instructions" [assemble_instructions])
(import ^from "../src/kernel" [provide withdraw_seam status_of row])

(describe "Trigger host plugin"
  (it "waits for the loop seam and stops with it" []
    (isolated this_mod/.path "waits for the loop seam and stops with it"
      (fn [workspace]
        (let runtime (open_runtime workspace "default" (baseline_profile)))
        (let controller (new_round_controller runtime))
        (try
          ($assert (== (status_of runtime/h "triggers") "pending")
            "trigger plugin activated before the loop existed")
          ($assert (== (row runtime/h "functions" "create_trigger") void)
            "pending trigger callable was visible")
          (provide runtime/h "core" "loop"
            (fn [] {^runtime runtime ^controller controller ^start false ^boot false}))
          (let active_status (status_of runtime/h "triggers"))
          ($assert (== active_status "ready")
            $"loop seam did not activate triggers: ${active_status}; ${runtime/h/plugin_errors/.get}")
          ($assert (! ($absent? runtime/triggers)) "trigger manager did not start")
          ($assert (! ($absent? (row runtime/h "functions" "list_triggers")))
            "trigger functions were not contributed")
          ($assert ($str/contains?
            (assemble_instructions runtime {^kind "interactive"})
            "Use (create_trigger")
            "trigger prompt paragraph was missing")
          (let result (evaluate_harness_turn runtime/h 1 runtime/root
            "(append_prompt \"triggers\" (list_triggers)) (Outcome ^prompt \"continue\")"))
          ($assert (== result/kind "continue")
            "response code could not call the trigger plugin")
          (let manager runtime/triggers)
          (withdraw_seam runtime/h "core" "loop")
          ($assert manager/closed/.get "trigger scheduler did not close on seam loss")
          ($assert (== runtime/triggers nil) "closed manager stayed on runtime")
          ($assert (== (row runtime/h "functions" "list_triggers") void)
            "trigger callable survived seam loss")
        ensure
          (withdraw_seam runtime/h "core" "loop")
          (close_round_controller controller)
          (close_runtime runtime))))))

(fn main [args] : Int (run_spec args))
