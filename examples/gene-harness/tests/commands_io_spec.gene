(import $test [describe it])
(import [isolated run_spec] ^from "./support")
(import ^from "../src/runtime/bootstrap" [open_runtime close_runtime])
(import ^from "../src/profiles/baseline" [baseline_profile])
(import ^from "../src/runtime/commands" [submit_command command_receipt])
(fn command [runtime, text]
  (let receipt (submit_command runtime/commands "default" text))
  (runtime/commands/watchers .get; .get $"default:${receipt/id}"; .join)
  (command_receipt runtime/commands "default" receipt/id))
(describe "Harness command I/O"
  (it "closes omitted stdin and supports shell-neutral stderr merging and colon paths" []
    (isolated this_mod/.path "closes omitted stdin and supports shell-neutral stderr merging and colon paths"
      (fn [workspace]
        (let runtime (open_runtime workspace "default" (baseline_profile)))
        (try
          (let config ($serde/read_data ($fs/read_text $"${runtime/state_root}/config.gene")))
          (config .put "response_budget" {^timeout_ms 2000 ^max_memory_mb 1024})
          ($fs/write_text $"${runtime/state_root}/config.gene" ($serde/write_data config))
          (let cat (command runtime "/sh cat"))
          ($assert (== cat/exit 0) "omitted shell stdin did not reach EOF")
          (let shell (command runtime "/sh echo hello"))
          ($assert (== shell/exit 0) $"shell-specific redirection failed: ${shell/display}")
          ($fs/write_text "colon:name.txt" "one\ntwo\nthree\n")
          (let range (command runtime "/view colon:name.txt:2-3"))
          ($assert (== range/display "two\nthree") "view lost a colon path or line range")
          ($fs/write_text "file:123" "literal\n")
          ($assert (== (/display (command runtime "/view file:123")) "literal") "existing numeric-colon filename was parsed as a range")
          (let channel ($channel ^capacity 4))
          (let process ($os/exec_stream_async ^cmd "/bin/sh" ^args ["-c" "printf 'out\\n'; printf 'err\\n' >&2"] ^stdout_chan channel ^merge_stderr true))
          (let lines [])
          (try (loop (lines .push channel/.recv)) catch ChannelClosed nil)
          (let result (await process))
          ($assert (== lines ["out" "err"]) "merged stderr did not stream in order")
          ($assert (== result/stderr "") "merged stderr was duplicated")
          ($println "command I/O: empty stdin, shell-neutral execution, colon paths and merged stderr")
        ensure (close_runtime runtime))))))

(fn main [args] : Int (run_spec args))
