(mod cordis_durable_fixture)
(import $fs [make_dir write_text])
(import [Plugin PluginContext PluginHost] from "../src/plugin_api")
(import_impl PluginHost for PluginContext from "../src/kernel")
(import [new_cordis_harness install resolve invoke_registry_row status_of
         shutdown_harness] from "../src/kernel")
(import [open_workspace close_workspace register_module prepare_workspace
         activate_workspace_plan run_workspace_turn composition_revision
         workspace_status doctor composition_entries commit_composition
         module_digest write_module_blob load_entry_descriptor] from "../src/workspace")
(import [open_event_store close_event_store plugin_state] from "../src/state")

(fn search_source [version : Str, broken : Bool = false]
  `(mod plugin
     (import [Plugin DescriptorContext PluginContext PluginHost]
       from "../../../src/plugin_api")
     (import_impl PluginHost for PluginContext from "../../../src/kernel")
     (fn init [ctx : DescriptorContext] : Plugin ^capabilities []
       (Plugin ^id "search" ^provides ["Search"] ^requires [] ^contextual true
         ^activate (fn [] (fn [host]
           (fn search [query]
             (let previous (host .PluginHost:state))
             (let calls (+ (if ($absent? previous) 0 previous/calls) 1))
             (host .PluginHost:update_state {^calls calls})
             ($str/join [(unquote version) "(" query ")"] ""))
           (host .PluginHost:provide "Search" search)
           (host .PluginHost:contribute "tools"
             {^name "search" ^doc "deterministic search" ^run search})
           (if (unquote broken) ($panic "search candidate failed"))))))))

(fn model_plugin []
  (Plugin ^id "model" ^provides ["Model"] ^requires [] ^contextual true
    ^activate (fn [] (fn [host]
      (host .PluginHost:provide "Model" (fn [prompt]
        (let previous (host .PluginHost:state))
        (let requests (+ (if ($absent? previous) 0 previous/requests) 1))
        (host .PluginHost:update_state {^requests requests})
        {^tool "report" ^argument prompt}))))))

(fn report_plugin []
  (Plugin ^id "report" ^provides [] ^requires [["tools" "search"]] ^contextual true
    ^activate (fn [] (fn [host]
      (let search (host .PluginHost:resolve "Search"))
      (host .PluginHost:contribute "tools"
        {^name "report" ^doc "report using selected search"
         ^run (fn [query] $"report:${(search query)}")})))))

(fn ask [workspace, h, id : Str]
  (let result
    (run_workspace_turn workspace h id (fn [unused]
      (let model (resolve h "Model"))
      (let plan (model "query"))
      (invoke_registry_row h "tools" plan/tool [plan/argument]))))
  ($assert (== result/status "committed") ($to_str result))
  result/result)

(fn assert_counts [events, count : Int]
  ($assert (== (plugin_state events "workspace" "workspace" "search") {^calls count}))
  ($assert (== (plugin_state events "session" "durable-session" "model") {^requests count})))

(fn main [args]
  (let mode args/0)
  (let root args/1)
  (make_dir $"${root}/composition")
  (make_dir $"${root}/events")
  (let workspace (open_workspace $"${root}/composition"))
  (let events (open_event_store $"${root}/events"))
  (let h (new_cordis_harness ^workspace workspace ^event_store events
    ^event_stream "durable-session"))
  (try
    (let prepared (prepare_workspace workspace h ^session "durable-session"))
    (install h (model_plugin))
    (install h (report_plugin))
    (activate_workspace_plan prepared h)
    (if_yes (["crash" "crash_bad"] .contains? mode)
      (assert_counts events 5)
      (let source (search_source "v4" (== mode "crash_bad")))
      (let digest (module_digest source))
      (write_module_blob workspace digest ($to_str source))
      (let entries (composition_entries workspace))
      (entries/0 .put "module_digest" digest)
      (entries/0 .put "closure" [digest])
      # The same public preflight and CAS primitives used by registration.
      # The parent kills this process after the durable marker, before any
      # live reconciliation or normal shutdown can run.
      (load_entry_descriptor workspace h entries/0)
      ($assert (== (commit_composition workspace 4 entries) 5))
      (write_text $"${root}/committed" "5")
      (while true ($sleep 10)))
    (if_yes (== mode "restore_bad")
      ($assert (== (composition_revision workspace) 5))
      ($assert (== (status_of h "search") "error"))
      (let facts (workspace_status workspace))
      ($assert (== facts/desired_revision 5))
      ($assert (== facts/active_revision 0))
      ($assert ($str/contains? ($to_str (doctor workspace)) "search candidate failed"))
      (assert_counts events 5)
      ($println "cordis crash recovery failure: ok")
      (return 0))
    (if_yes (== mode "restore_crash")
      ($assert (== (composition_revision workspace) 5))
      ($assert (== (status_of h "search") "ready") ($to_str (doctor workspace)))
      (assert_counts events 5)
      ($assert (== (ask workspace h "after-crash") "report:v4(query)"))
      (assert_counts events 6)
      ($assert (== (doctor workspace) []))
      ($println "cordis crash recovery uses committed desired source: ok")
      (return 0))
    (if (== mode "seed")
      (then
        (let first (register_module workspace h "search" (search_source "v1")
          ^scope "workspace" ^selectors []))
        ($assert (== first/status "ready") ($to_str (doctor workspace)))
        ($assert (== (ask workspace h "one") "report:v1(query)"))
        (let replacement (run_workspace_turn workspace h "replacement" (fn [unused]
          (register_module workspace h "search" (search_source "v2")
            ^scope "workspace" ^selectors [] ^replace true))))
        ($assert (== replacement/status "committed") ($to_str replacement))
        ($assert (== (status_of h "search") "ready") ($to_str (doctor workspace)))
        (assert_counts events 1)
        (let second_answer (ask workspace h "two"))
        ($assert (== second_answer "report:v2(query)") second_answer)
        (let rejected (register_module workspace h "search" (search_source "broken" true)
          ^scope "workspace" ^selectors [] ^replace true))
        ($assert (== rejected/status "error"))
        (let facts (workspace_status workspace))
        ($assert (== facts/desired_revision 3))
        ($assert (== facts/active_revision 2))
        ($assert ($str/contains? ($to_str (doctor workspace)) "search candidate failed"))
        ($assert (== (ask workspace h "continued") "report:v2(query)"))
        (let fixed (register_module workspace h "search" (search_source "v3")
          ^scope "workspace" ^selectors [] ^replace true))
        ($assert (== fixed/status "ready") ($to_str (doctor workspace)))
        (assert_counts events 3)
        ($assert (== (ask workspace h "three") "report:v3(query)"))
        (assert_counts events 4)
        ($assert (== (doctor workspace) []))
        ($println "cordis durable seed: ok"))
      (else
        ($assert (== (composition_revision workspace) 4))
        ($assert (== (status_of h "search") "ready") ($to_str (doctor workspace)))
        (assert_counts events 4)
        ($assert (== (doctor workspace) []))
        ($assert (== (ask workspace h "restored") "report:v3(query)"))
        (assert_counts events 5)
        ($println "cordis durable fresh-process restore: ok")))
  ensure
    (shutdown_harness h)
    (close_workspace workspace)
    (close_event_store events))
  0)
