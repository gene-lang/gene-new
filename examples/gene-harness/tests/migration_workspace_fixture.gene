# Seed/inspect a durable workspace using public Harness interfaces. The golden
# fixture is captured with the pre-Cordis kernel and never regenerated by the
# migration test under the new implementation.
(mod migration_workspace_fixture)

(import [new_harness new_cordis_harness resolve status_of shutdown_harness] from "../src/kernel")
(import [open_workspace register_module restore_workspace close_workspace
         composition_entries composition_revision commit_composition
         module_digest write_module_blob
         upgrade_workspace_interfaces CompositionError disable_entry doctor] from "../src/workspace")
(import [open_event_store close_event_store plugin_state] from "../src/state")

(fn counter_source [id : Str, key : Str]
  `(mod plugin
     (import [Plugin DescriptorContext PluginContext PluginHost]
       from "../../../src/plugin_api")
     (import_impl PluginHost for PluginContext from "../../../src/kernel")
     (fn init [ctx : DescriptorContext] : Plugin ^capabilities []
       (Plugin ^id %id ^provides [(unquote key)] ^requires [] ^contextual true
         ^activate (fn [] (fn [host]
           (fn increment []
             (let current (host .PluginHost:state))
             (let count (if (== current nil) 0 current/count))
             (let next {^count (+ count 1)})
             (host .PluginHost:update_state next)
             next/count)
           (host .PluginHost:provide (unquote key) increment)))))))

(fn main [args]
  (let cordis (["upgrade_cordis" "inspect_cordis"] .contains? args/0))
  (let mode (if (== args/0 "upgrade_cordis") "upgrade"
    (if (== args/0 "inspect_cordis") "inspect" args/0)))
  (let workspace (open_workspace args/1))
  (let events (open_event_store args/2))
  (let h (if cordis
    (new_cordis_harness ^workspace workspace ^event_store events
      ^event_scope "session" ^event_stream "migration-session")
    (new_harness ^workspace workspace ^event_store events
      ^event_scope "session" ^event_stream "migration-session")))
  (try
    (if_yes (== mode "damaged")
      ($assert (try (upgrade_workspace_interfaces workspace h) false
                catch CompositionError true))
      ($assert (== (composition_revision workspace) 4))
      ($assert (== (status_of h "session_counter") "absent"))
      ($println "damaged disabled source refuses upgrade CAS: ok")
      (return nil))
    (if_yes (== mode "hostile")
      (let source
        (quote (mod plugin
           (fn init [ctx] ^capabilities [] (while true nil)))))
      (let digest (module_digest source))
      (write_module_blob workspace digest ($to_str source))
      (let entries (composition_entries workspace))
      (entries/2 .put "module_digest" digest)
      (entries/2 .put "closure" [digest])
      (commit_composition workspace 4 entries)
      ($assert (try (upgrade_workspace_interfaces workspace h) false
                catch Any ($str/contains? $err/message "eval max steps exceeded")))
      ($assert (== (composition_revision workspace) 5))
      ($assert (== (composition_entries workspace) entries))
      ($assert (== (status_of h "session_counter") "absent"))
      ($assert (== (status_of h "dormant") "absent"))
      ($println "hostile disabled init refuses upgrade CAS: ok")
      (return nil))
    (if_yes (== mode "refuse")
      (restore_workspace workspace h ^session "migration-session")
      ($assert (== (composition_revision workspace) 4))
      ($assert (== (status_of h "session_counter") "absent"))
      ($assert (== (status_of h "workspace_counter") "absent"))
      (let findings (doctor workspace))
      ($assert (== findings/.size 2))
      ($println "legacy workspace requires explicit upgrade: ok")
      (return nil))
    (if_yes (== mode "unknown")
      (let changed (composition_entries workspace))
      (changed/0/interfaces .put "core" "unknown-interface")
      (commit_composition workspace 4 changed)
      ($assert (try (upgrade_workspace_interfaces workspace h) false
                catch CompositionError true))
      ($assert (== (composition_revision workspace) 5))
      ($assert (== (composition_entries workspace) changed))
      ($assert (== (status_of h "session_counter") "absent"))
      ($println "unknown interfaces refused without activation or CAS: ok")
      (return nil))
    (if_yes (== mode "upgrade")
      ($assert (== (upgrade_workspace_interfaces workspace h) 5))
      ($assert (== (status_of h "session_counter") "absent"))
      ($assert (== (status_of h "workspace_counter") "absent"))
      ($assert (== (status_of h "dormant") "absent"))
      ($assert (== (upgrade_workspace_interfaces workspace h) 5)))
    (if (== mode "seed")
      (then
        (register_module workspace h "session_counter"
          (counter_source "session_counter" "SessionCounter")
          ^scope "session" ^selectors [] ^by "migration-fixture"
          ^model "offline" ^at "2026-09-10T00:00:00Z")
        (register_module workspace h "workspace_counter"
          (counter_source "workspace_counter" "WorkspaceCounter")
          ^scope "workspace" ^selectors [] ^by "migration-fixture"
          ^model "offline" ^at "2026-09-10T00:00:00Z")
        (register_module workspace h "dormant"
          (counter_source "dormant" "Dormant")
          ^scope "workspace" ^selectors [] ^by "migration-fixture"
          ^model "offline" ^at "2026-09-10T00:00:00Z")
        ($assert (== ((resolve h "SessionCounter")) 1))
        ($assert (== ((resolve h "WorkspaceCounter")) 1))
        (disable_entry workspace "dormant" ^h h))
      (else
        (restore_workspace workspace h ^session "migration-session")
        ($assert (== (status_of h "session_counter") "ready"))
        ($assert (== (status_of h "workspace_counter") "ready"))
        ($assert (== (status_of h "dormant") "absent"))
        ($assert (== (doctor workspace) []))))
    (let entries (composition_entries workspace))
    ($assert (== entries/.size 3))
    (for entry in entries
      ($assert (== entry/by "migration-fixture"))
      ($assert (== entry/model "offline"))
      ($assert (== entry/at "2026-09-10T00:00:00Z")))
    (let session (plugin_state events "session" "migration-session" "session_counter"))
    (let shared (plugin_state events "workspace" "workspace" "workspace_counter"))
    ($assert (== session/count 1))
    ($assert (== shared/count 1))
    ($println ($json/stringify
      {^revision (composition_revision workspace) ^entries entries
       ^session_state session ^workspace_state shared
       ^session_status (status_of h "session_counter")
       ^workspace_status (status_of h "workspace_counter")
       ^dormant_status (status_of h "dormant")}))
  ensure
    (shutdown_harness h)
    (close_workspace workspace)
    (close_event_store events)))
