(import $test [describe it])
(import [isolated run_spec] ^from "./support")
(import ^from "../src/runtime/bootstrap" [open_runtime close_runtime])
(import ^from "../src/profiles/baseline" [baseline_profile])
(import ^from "../src/kernel" [row])

(describe "First-party provider rows"
  (it "prepares each provider's model-visible input without credentials" []
    (isolated this_mod/.path "prepares each provider's model-visible input without credentials"
      (fn [workspace]
        (let runtime (open_runtime workspace "default" (baseline_profile)))
        (try
          (let messages
            [{^role "system" ^content "rules"}
             {^role "user" ^content "first"}
             {^role "assistant" ^content "reply"}
             {^role "user" ^content "next"}])
          (let codex (row runtime/h "providers" "codex"))
          (let codex_settings (codex/configure "model-a" "high" 1234))
          (let codex_input (codex/prepare
            {^purpose "turn" ^messages messages ^settings codex_settings}))
          ($assert (== codex_input/body/instructions "rules")
            "Codex lost its system instructions")
          ($assert (== codex_input/body/input/.size 3)
            "Codex did not keep conversation roles")
          ($assert (== codex_input/timeout_ms 1234)
            "Codex lost the selected timeout")
          ($assert (! ($str/contains? ($to_str codex_input) "Bearer"))
            "Codex prepared input contains authentication")
          (let openrouter (row runtime/h "providers" "openrouter"))
          (let openrouter_settings (openrouter/configure "model-b" "medium" 5678))
          (let openrouter_input (openrouter/prepare
            {^purpose "turn" ^messages messages ^settings openrouter_settings
             ^max_tokens 77}))
          ($assert (== openrouter_input/body/messages messages)
            "OpenRouter rewrote the canonical messages")
          ($assert (== openrouter_input/body/max_tokens 77)
            "OpenRouter dropped the output budget")
          (let anthropic (row runtime/h "providers" "anthropic"))
          (let anthropic_settings (anthropic/configure "model-c" "minimal" 91011))
          (let anthropic_input (anthropic/prepare
            {^purpose "turn" ^messages messages ^settings anthropic_settings
             ^max_tokens 88}))
          ($assert (== anthropic_settings/effort "low")
            "Anthropic did not map minimal effort to low")
          ($assert (== anthropic_input/body/system "rules")
            "Anthropic lost the separate system message")
          ($assert (== anthropic_input/body/messages/.size 3)
            "Anthropic dropped conversation history")
          ($assert (== anthropic_input/body/max_tokens 88)
            "Anthropic lost the output budget")
          (let claude (row runtime/h "providers" "claude"))
          (let claude_settings (claude/configure "sonnet" "medium" 12345))
          (let claude_input (claude/prepare
            {^purpose "turn" ^messages messages ^settings claude_settings}))
          ($assert (== ($last claude_input/args) ($serde/write_data messages))
            "Claude CLI did not flatten the complete history")
          ($assert (== claude_input/timeout_ms 12345)
            "Claude CLI lost the selected timeout")
        ensure
          (close_runtime runtime))))))

(fn main [args] : Int (run_spec args))
