(fn hold [root, mode]
  (let channel ($channel ^capacity 1))
  (let process ($os/exec_stream_async ^cmd "/bin/sh" ^args ["-c" "echo $$; exec sleep 30"] ^stdout_chan channel))
  (let pid (channel .recv))
  ($fs/write_text_atomic $"${root}/gene.pid" ($to_str ($os/process_id)))
  ($fs/write_text_atomic $"${root}/child.pid" pid)
  (if (== mode "exit") ($os/exit 0))
  (await process))
(fn main [args] (hold args/0 args/1))
