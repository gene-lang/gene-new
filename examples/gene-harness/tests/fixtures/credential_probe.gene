(type CredentialProbeError ^props {^message Str} ^impl [Error])
(impl Error for CredentialProbeError)

(fn main [args] : Int
  (match args/0
    (when "fail" (fail (CredentialProbeError ^message "SECRET_SENTINEL must not reach the parent error")))
    (when "slow" ($sleep 1000))
    (when "count"
      (let count (if ($fs/exists? args/1) (then ($parse/parse_int ($fs/read_text args/1))) (else 0)))
      ($fs/write_text args/1 ($to_str (+ count 1))))
    (else nil))
  ($println "fixture-token")
  0)
