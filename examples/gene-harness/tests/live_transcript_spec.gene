(import $test [describe it])
(import [isolated run_spec] ^from "./support")
(import ^from "../src/web/session_service"
  [open_session_service close_session_service create_session submit receipt snapshot answer])
(import ^from "../src/runtime/sessions" [load_session unload_session])
(import ^from "../src/storage/state" [events_for])
(import ^from "../src/kernel" [contribute])
(describe "Harness live delivery"
  (it "publishes prompts, responses, console and progress before completion" []
    (isolated this_mod/.path "publishes prompts, responses, console and progress before completion"
      (fn [workspace]
        (let entered ($cell false))
        (let release ($cell false))
        (let service (open_session_service ^workspace workspace ^provider (fn [request]
          (if (== request/turn 1)
            "(append_prompt \"first\" 1) ($println \"console now\") (Outcome ^prompt \"continue\" ^reply \"Progress now.\")"
            (do (entered .set true) (while (! release/.get) ($sleep 1))
              "(Outcome ^done true ^reply \"Finished.\")")))))
        (let messages ($cell []))
        (service/publisher .set (fn [message] (messages/.get .push message)))
        (try
          (let record (create_session service))
          (let round (submit service record/id "live" 1 "original prompt"))
          (while (! entered/.get) ($sleep 1))
          ($assert (== (/state (receipt service record/id round/id)) "running") "stream check happened after completion")
          (let kinds [])
          (for message in messages/.get
            (if (== message/session record/id)
              (kinds .push message/type)))
          ($assert (kinds .contains? "turn") "response code was not sent while running")
          ($assert (kinds .contains? "console") "console waited for completion")
          ($assert (kinds .contains? "reply") "progress reply waited for completion")
          (let state (snapshot service record/id))
          ($assert (== state/records/0/text "original prompt") "initial user request is missing")
          ($assert (== state/records/0/role "user") "initial request has the wrong role")
          (release .set true)
          (service/controller/watchers .get; .get record/id; .join)
          ($assert (== (/state (receipt service record/id round/id)) "done") "streamed round did not complete")
          (let validations ($cell 0))
          (let answers ($cell []))
          (contribute service/runtime/h "core" "interactions" {^name "custom" ^validate_request (fn [question]
            (validations .set (+ validations/.get 1)) question) ^validate_reply (fn [value]
              (answers/.get .push value) value)})
          (set service/controller/provider (fn [request] "(append_prompt \"answers\" \"reserved label\") (Outcome ^questions [{^id \"choice\" ^kind \"custom\" ^prompt \"Choose a value.\"}])"))
          (let custom (submit service record/id "custom" 2 "ask"))
          (service/controller/watchers .get; .get record/id; .join)
          ($assert (== (/state (receipt service record/id custom/id)) "waiting") "custom interaction did not wait")
          ($assert (== validations/.get 1) "custom question was not validated under its turn lease")
          (set service/controller/provider (fn [request] "(Outcome ^done true ^reply \"answered\")"))
          (let waiting (receipt service record/id custom/id))
          (answer service record/id waiting/questions/id {^choice "ok"})
          (service/controller/watchers .get; .get record/id; .join)
          ($assert (== answers/.get ["ok"]) "custom answer bypassed its validator")
          (let answered (snapshot service record/id))
          (var recorded false)
          (for block in answered/records
            (if (&& (== block/kind "turn/request") ($str/contains? block/text ".answers#2]"))
              (set recorded true)))
          ($assert recorded "answer request was absent from the operator transcript")
          (let huge ($cell "x"))
          (repeat i in 18 (huge .set ($to_str huge/.get huge/.get)))
          (service/runtime/functions .put "noise" (fn [] ($print huge/.get)))
          (set service/controller/provider (fn [request] "(noise) (Outcome ^done true ^reply \"bounded console\")"))
          (let noisy (submit service record/id "noisy" 3 "print"))
          (service/controller/watchers .get; .get record/id; .join)
          ($assert (== (/state (receipt service record/id noisy/id)) "done") "large console output exceeded an event envelope")
          (var noisy_bytes 0)
          (var truncated false)
          (for event in (events_for service/events "session" record/id)
            (if_yes (&& (== event/type "console") (== event/payload/round noisy/id))
              (set noisy_bytes (+ noisy_bytes ($str/byte_size event/payload/text)))
              (if ($str/contains? event/payload/text "[console truncated]") (set truncated true))))
          ($assert (<= noisy_bytes 262144) "durable console exceeded its per-turn byte cap")
          ($assert truncated "durable console omitted its truncation marker")
          ($println "live transcript: initial prompt, response, console and progress before completion; custom question validator")
        ensure
          (release .set true)
          (close_session_service service))))))

(fn main [args] : Int (run_spec args))
