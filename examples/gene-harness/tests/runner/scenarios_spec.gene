# Scenario programs keep their own Application and module cache.
(mod harness_scenarios_spec)
(import $test [describe it run])
(import $fs [make_dir])
(import $os [get_env executable_path exec])
(import $crypto [random_hex])

# Artifact tests supply the checkout explicitly: materialized package trees
# intentionally omit the repository-level language skill used by LLM fixtures.
(let package_root (get_env "GENE_HARNESS_PACKAGE_ROOT" this_pkg/root))
(var test_root (get_env "GENE_HARNESS_TEST_ROOT" ""))
(if (== test_root "")
  (set test_root $"${this_pkg/root}/.cache/harness-tests-${(random_hex 8)}"))
(make_dir test_root)

(fn run_scenario [name : Str, root_count : Int, marker : Str]
  (let root $"${test_root}/${name}")
  (make_dir root)
  (let command ["run" "--allow_read_write_dir" root
    "--allow_read_dir" $"${package_root}/../../tools/gene-lang-skill"
    $"${package_root}/tests/${name}.gene"])
  (var i 0)
  (while (< i root_count)
    (let data $"${root}/${i}")
    (make_dir data)
    (command .push data)
    (set i (+ i 1)))
  (let result (exec ^cmd (executable_path) ^args command
    ^dir package_root ^timeout_ms 30000))
  ($assert (== result/status 0) $"${name}: ${result/stdout}${result/stderr}")
  ($assert ($str/contains? result/stdout marker) $"${name}: missing completion marker")
  ($println marker))

(describe "Harness"
  (it "attenuation_smoke" []
    (run_scenario "attenuation_smoke" 1 "attenuation_smoke: ok"))
  (it "blob_repair_smoke" []
    (run_scenario "blob_repair_smoke" 1 "blob_repair_smoke: ok"))
  (it "bounded_preflight_smoke" []
    (run_scenario "bounded_preflight_smoke" 1 "bounded_preflight_smoke: ok"))
  (it "build_provenance_smoke" []
    (run_scenario "build_provenance_smoke" 1 "build_provenance_smoke: ok"))
  (it "build_replace_smoke" []
    (run_scenario "build_replace_smoke" 1 "build_replace_smoke: ok"))
  (it "callback_supervision_smoke" []
    (run_scenario "callback_supervision_smoke" 0 "callback_supervision_smoke: ok"))
  (it "codegen_seam_smoke" []
    (run_scenario "codegen_seam_smoke" 1 "codegen_seam_smoke: ok"))
  (it "composition_audit_smoke" []
    (run_scenario "composition_audit_smoke" 2 "composition_audit_smoke: ok"))
  (it "dependency_closure_smoke" []
