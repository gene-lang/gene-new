(import $test [describe it assert_equal run])
(import ^from "../src/agents/response" [split_response])
(import ^from "../src/builtin/provider_codex" [response_text codex_stream_text])
(import ^from "../src/builtin/provider_openrouter" [openrouter_text])
(import ^from "../src/builtin/provider_anthropic" [anthropic_text])
(import ^from "../src/builtin/provider_claude" [claude_text])
(import ^from "../src/builtin/provider_common" [configure_model http_json_attempt])
(import ^from "../src/agents/provider_selection" [complete_messages])
(import ^from "../src/kernel" [new_harness shutdown_harness contribute])
(import ^from "../src/profiles/profile" [Profile])
(import ^from "./support" [isolated run_spec])
(import $net/http [listen serve stop json])
(import $net/http_client [request])

(fn raw_blocks [read_text]
  (for text in ["\n(+ 1 2)\n<<<raw END\nexact body\nEND" "*** Begin Patch\n*** Add File: model.txt\n+ok\n*** End Patch"]
    (let output (read_text text))
    (assert_equal output text)
    (split_response output)
    (split_response ($str/trim output))))

(describe
  "Harness provider response bytes"
  (it
    "selects final answers from phased Codex output without duplicating code"
    []
    (raw_blocks
      (fn [text]
        (response_text
          {
            ^status "completed"
            ^output [
                      {
                        ^type "message"
                        ^role "assistant"
                        ^phase "commentary"
                        ^content [{^type "output_text" ^text "I’ll inspect the files."}]}
                      {
                        ^type "message"
                        ^role "assistant"
                        ^phase "commentary"
                        ^content [{^type "output_text" ^text text}]}
                      {
                        ^type "message"
                        ^role "assistant"
                        ^content [{^type "output_text" ^text "unphased commentary"}]}
                      {
                        ^type "message"
                        ^role "assistant"
                        ^phase "final_answer"
                        ^content [{^type "output_text" ^text text}]}]}))))
  (it
    "selects phased final answers when completed SSE output arrives as separate items"
    []
    (let code """# goal
(Outcome ^done true ^reply "done")""")
    (let messages
      [
        {
          ^type "message"
          ^role "assistant"
          ^phase "commentary"
          ^content [{^type "output_text" ^text code}]}
        {
          ^type "message"
          ^role "assistant"
          ^phase "final_answer"
          ^content [{^type "output_text" ^text code}]}])
    (let lines [])
    (for item in messages
      (lines .push
        ($to_str
          "data: "
          ($json/stringify {^type "response.output_item.done" ^item item})
          """

""")))
    (lines .push
      ($to_str
        "data: "
        ($json/stringify {^type "response.completed" ^response {^status "completed" ^output []}})
        """

"""))
    (assert_equal (codex_stream_text ($str/join lines "")) code))
  (it
    "retries one provider timeout and preserves other failures"
    []
    (let h (new_harness))
    (let calls ($cell 0))
    (let mode ($cell "recover"))
    (try
      (contribute h "core" "providers"
        {^name "retry" ^doc "Synthetic timeout provider."
         ^configure (fn [model, effort, timeout]
           (configure_model model effort timeout "retry"))
         ^prepare (fn [call] call/messages)
         ^send (fn [prepared]
           (calls .set (+ calls/.get 1))
           (if (== mode/.get "error")
             (fail (HttpClientError ^message "certificate rejected")))
           (if (|| (== mode/.get "timeout") (== calls/.get 1))
             {^timeout true}
             {^text "complete response"}))})
      (let runtime {^h h ^profile (Profile ^name "test" ^plugins []
        ^provider "retry")})
      (let request {^config {^provider_timeout_ms 1500}
        ^messages [{^role "system" ^content "rules"}
                   {^role "user" ^content "go"}]})
      (assert_equal (complete_messages runtime request) "complete response")
      (assert_equal calls/.get 2)
      (calls .set 0)
      (mode .set "timeout")
      (let exhausted (try (complete_messages runtime request) "accepted"
        catch Any $err/message))
      (assert_equal calls/.get 2)
      ($assert ($str/contains? exhausted
        "retry model provider request exceeded 1.5 s (2 attempts)"))
      (calls .set 0)
      (mode .set "error")
      (let other (try (complete_messages runtime request) "accepted"
        catch HttpClientError $err/message))
      (assert_equal calls/.get 1)
      (assert_equal other "certificate rejected")
      (let configured (configure_model nil nil 900000 "model"))
      (assert_equal configured/timeout_ms 900000)
    ensure
      (shutdown_harness h)))
  (it
    "wraps real HTTP timeout errors and retries the transfer once"
    []
    (isolated
      this_mod/.path
      "wraps real HTTP timeout errors and retries the transfer once"
      (fn [workspace]
        (let server (listen ^host "127.0.0.1" ^port 0))
        (let h (new_harness))
        (let calls ($cell 0))
        (contribute h "core" "providers"
          {^name "retry" ^doc "HTTP timeout provider."
           ^configure (fn [model, effort, timeout]
             (configure_model model effort timeout "retry"))
           ^prepare (fn [call] call/messages)
           ^send (fn [prepared]
             (calls .set (+ calls/.get 1))
             (http_json_attempt $"http://127.0.0.1:${server/port}/slow"
               {^content-type "application/json"} {^prompt "go"} 30
               (fn [response] {^text response/body})))})
        (let runtime {^h h ^profile (Profile ^name "test" ^plugins []
          ^provider "retry")})
        (let tester
          (spawn ^lane root (try
            (let failure
              (try
                (complete_messages runtime
                  {^config {^provider_timeout_ms 30}
                   ^messages [{^role "system" ^content "rules"}
                              {^role "user" ^content "go"}]})
                "accepted"
              catch Any $err/message))
            ($assert (== calls/.get 2)
              "real transfer timeout was not retried once")
            ($assert ($str/contains? failure
              "retry model provider request exceeded 0.03 s")
              "real timeout was not identified as provider failure")
          ensure
            (stop server)
            (shutdown_harness h))))
        (serve ^handler (fn [req] ($sleep 200) (json "{}")) server)
        (match tester/.join
          (when (TaskOutcome/ok value)
            value)
          (when (TaskOutcome/error error)
            (fail error))
          (else
            ($assert false "timeout test task did not finish"))))))
  (it
    "preserves OpenAI output text and EOF blocks"
    []
    (raw_blocks
      (fn [text]
        (response_text
          {
            ^status "completed"
            ^output [
                      {
                        ^type "message"
                        ^role "assistant"
                        ^content [{^type "output_text" ^text text}]}]}))))
  (it
    "preserves OpenRouter output text and EOF blocks"
    []
    (raw_blocks
      (fn [text]
        (openrouter_text
          {^status 200 ^body ($json/stringify {^choices [{^message {^content text}}]})}))))
  (it
    "preserves Anthropic output text and EOF blocks"
    []
    (raw_blocks
      (fn [text]
        (anthropic_text
          {
            ^status 200
            ^body ($json/stringify
                    {
                      ^type "message"
                      ^role "assistant"
                      ^stop_reason "end_turn"
                      ^content [{^type "text" ^text text}]})}))))
  (it
    "preserves Claude CLI output text and EOF blocks"
    []
    (raw_blocks
      (fn [text]
        (claude_text
          {
            ^status 0
            ^stdout ($json/stringify
                      {^type "result" ^subtype "success" ^is_error false ^result text})})))))

(fn main [args] : Int
  (run_spec args))
