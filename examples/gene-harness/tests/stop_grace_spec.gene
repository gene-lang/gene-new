(import $test [describe it])
(import [isolated run_spec] ^from "./support")
(import $io [IoResource pipe write_all])
(import ^from "../src/web/session_service" [open_session_service close_session_service])
(import ^from "../src/runtime/sessions" [list_sessions])
(describe "Harness shutdown"
  (it "stops within the grace period and restores the cancelled receipt" []
    (isolated this_mod/.path "stops within the grace period and restores the cancelled receipt"
      (fn [workspace]
        ($fs/make_dir workspace)
        (let root ($fs/real_path workspace))
        (let entry ($path/join ($path/parent ($path/parent this_mod/.path)) "src/main.gene"))
        (let script $"${root}/responses.gene")
        ($fs/write_text script ($to_str [
          "(try (do ($fs/write_text \"entered\" \"yes\") (while true ($sleep 10))) ensure (do (var i 0) (while true (set i (+ i 1)))))"]))
        (let input (pipe))
        (let lines ($channel ^capacity 128))
        (let process ($os/exec_stream_async ($os/executable_path)
          "run" entry "scripted" "--script" script "--workspace" $"${root}/workspace"
          ^stdin_pipe input/0 ^stdout_chan lines ^timeout_ms 25000 ^max_bytes 1048576))
        (await (write_all input/1 ($binary/from_str "start\n")))
        (let due (+ ($os/monotonic_ms) 15000))
        (while (&& (! ($fs/exists? $"${root}/workspace/entered")) (< ($os/monotonic_ms) due))
          ($sleep 1))
        ($assert ($fs/exists? $"${root}/workspace/entered") "round did not enter its uncooperative cleanup fixture")
        (let before ($os/monotonic_ms))
        (await (write_all input/1 ($binary/from_str "/stop\n")))
        input/1/.IoResource:close
        (let result (await process))
        (let elapsed (- ($os/monotonic_ms) before))
        ($assert (== result/status 0) $"stop did not exit zero: ${result}")
        ($assert (< elapsed 6500) $"shutdown exceeded its five-second grace: ${elapsed} ms")
        ($assert (>= elapsed 4500) "fixture did not exercise the shutdown grace deadline")
        (let reopened (open_session_service ^workspace $"${root}/workspace" ^^offline))
        (try
          (let records (list_sessions reopened/sessions))
          ($assert (== records/0/status "cancelled") "forced shutdown replayed or interrupted a cancelled round")
          ($println $"shutdown grace: stopped after ${elapsed} ms, released lock, restored cancelled receipt")
        ensure (close_session_service reopened))))))

(fn main [args] : Int (run_spec args))
