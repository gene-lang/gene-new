(import $test [describe it])
(import [isolated run_spec fixture_path] ^from "./support")
(import ^from "../src/runtime/bootstrap" [open_runtime close_runtime])
(import ^from "../src/profiles/baseline" [baseline_profile])
(import ^from "../src/runtime/round_controller" [new_round_controller close_round_controller])
(import ^from "../src/runtime/triggers"
  [open_trigger_manager close_trigger_manager create_trigger tick_triggers list_occurrences])
(import ^from "../src/runtime/sessions" [require_record])
(describe "Harness trigger recovery"
  (it "recovers due work without losing occurrences or replaying admitted rounds" []
    (isolated this_mod/.path "recovers due work without losing occurrences or replaying admitted rounds"
      (fn [home]
        ($fs/make_dir home)
        (let root ($fs/real_path home))
        (let executable ($os/executable_path))
        (let fixture (fixture_path "trigger_recovery"))
        (for point in ["due" "session" "admitted" "started" "running"]
          (let workspace $"${root}/${point}")
          (let killed (await ($os/exec_async executable "run" fixture workspace point ^timeout_ms 30000)))
          ($assert (!= killed/status 0) "crash child unexpectedly succeeded")
          (let runtime (open_runtime workspace "default" (baseline_profile)))
          (let calls ($cell 0))
          (let controller (new_round_controller runtime (fn [request]
            (calls .set (+ calls/.get 1))
            "(Outcome ^done true ^reply \"recovered\")")))
          (let manager (open_trigger_manager runtime controller ^start false ^now 2000))
          (try
            (for [id watcher] in controller/watchers/.get watcher/.join)
            (tick_triggers manager ^now 2000)
            (let records (list_occurrences manager))
            ($assert (== records/.size 1) $"Duplicate occurrence after ${point}: ${records}")
            (let record records/0)
            ($assert (== record/state "finished") $"Occurrence lost after ${point}: ${record}")
            (if (["due" "session"] .contains? point)
              (then
                ($assert (== calls/.get 1) $"Due occurrence not started after ${point}")
                ($assert (== record/outcome "done") "recovered due occurrence did not finish"))
              (else
                ($assert (== calls/.get 0) $"Admitted round replayed after ${point}")
                ($assert (== record/outcome "interrupted") $"Wrong crash outcome: ${record}")
                (let metadata (require_record runtime/sessions record/session))
                ($assert metadata/attention "interrupted trigger needs attention")))
            (tick_triggers manager ^now 2000)
            ($assert (== (list_occurrences manager; .size) 1) "repeated boot scheduled duplicate")
          ensure
            (close_trigger_manager manager)
            (close_round_controller controller)
            (close_runtime runtime)))
        ($println "trigger crash recovery: due, existing session, admission, started and running; no lost occurrences or replay")))))

(fn main [args] : Int (run_spec args))
