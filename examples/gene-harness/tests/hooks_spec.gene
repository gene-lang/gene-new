(import $test [describe it])
(import [isolated run_spec] ^from "./support")
(import ^from "../src/runtime/bootstrap" [open_runtime close_runtime])
(import ^from "../src/profiles/scripted" [scripted_profile])
(import ^from "../src/kernel" [contribute put_cordis_plugin plugin_error])
(import ^from "../src/plugin_api" [Plugin PluginHost ExecutionLimits])
(import ^from "../src/runtime/composition" [acquire_snapshot release_snapshot])
(import ^from "../src/runtime/round_controller"
  [new_round_controller submit_round round_receipt close_round_controller])
(import ^from "../src/agents/hooks" [request_prepare history_policy hook_rows])
(import ^from "../src/storage/state" [events_for])

(fn prepare_context []
  {^session "default" ^round "r" ^turn 1 ^round_turn 1
   ^limit 3 ^items []})

(type HookFailure ^props {^message Str} ^impl [Error])
(impl Error for HookFailure)

(fn count_events [runtime, name : Str]
  (var count 0)
  (for event in (events_for runtime/events "session" "default")
    (if (== event/type name) (set count (+ count 1))))
  count)

(describe "Leased turn hooks"
  (it "skips a failure, preserves protocol records and honors the lease" []
    (isolated this_mod/.path "skips a failure, preserves protocol records and honors the lease"
      (fn [workspace]
        (let runtime (open_runtime workspace "default"
          (scripted_profile ["(Outcome ^done true ^reply \"done\")"
                             "(Outcome ^done true ^reply \"done again\")"])))
        (let controller (new_round_controller runtime))
        (try
          (let old_lease (acquire_snapshot runtime/h/snapshots))
          (contribute ^priority -10 runtime/h "core" "hooks"
            {^point "request/prepare" ^name "fail"
             ^run (fn [context, next]
               (fail (HookFailure ^message "hook exploded")))})
          (let old_result (request_prepare runtime old_lease/snapshot
            (prepare_context)))
          ($assert (== old_result/items/.size 1)
            "old lease lost its budget listener")
          (release_snapshot runtime/h/snapshots old_lease)
          (let accepted (submit_round controller "default" "first" 1 "go"))
          (controller/watchers .get; .get "default"; .join)
          (let receipt (round_receipt controller "default" accepted/id))
          ($assert (== receipt/state "done")
            "failing hook suppressed the provider call")
          ($assert (== (count_events runtime "model/request") 1)
            "failing hook suppressed model/request")
          ($assert (== (count_events runtime "turn/end") 1)
            "failing hook suppressed turn/end")
          (var diagnosed false)
          (let traces [])
          (for event in (events_for runtime/events "session" "default")
            (if (== event/type "trace")
              (then
                (traces .push event/payload/text)
                (if ($str/contains? event/payload/text "hook exploded")
                  (set diagnosed true)))))
          ($assert diagnosed $"hook failure was not logged: ${traces}")
          (contribute ^priority -20 runtime/h "core" "hooks"
            {^point "request/prepare" ^name "early"
             ^run (fn [context, next] context)})
          (let new_lease (acquire_snapshot runtime/h/snapshots))
          (try
            (let decided (request_prepare runtime new_lease/snapshot
              (prepare_context)))
            ($assert (== decided/items/.size 0)
              "early waterfall return did not decide the request")
            (let basic (history_policy runtime new_lease/snapshot
              {^session "default" ^window_tokens 1000}))
            ($assert (== basic/trigger_bytes 2625.0)
              "basic history policy was not contributed")
          ensure
            (release_snapshot runtime/h/snapshots new_lease))
          (let next_round (submit_round controller "default" "second" 2 "again"))
          (controller/watchers .get; .get "default"; .join)
          (let next_receipt (round_receipt controller "default" next_round/id))
          ($assert (== next_receipt/state "done")
            "early hook suppressed the second provider call")
          ($assert (== (count_events runtime "model/request") 2)
            "early return suppressed a protocol request")
          ($assert (== (count_events runtime "turn/end") 2)
            "early return suppressed a turn ending")
          (contribute ^priority -20 runtime/h "core" "hooks"
            {^point "history/compact" ^name "custom"
             ^run (fn [context]
               {^trigger_bytes 900 ^target_bytes 400})})
          (let policy_lease (acquire_snapshot runtime/h/snapshots))
          (try
            (let chosen (history_policy runtime policy_lease/snapshot
              {^session "default" ^window_tokens 1000}))
            ($assert (== chosen/trigger_bytes 900)
              "first history policy did not decide")
          ensure
            (release_snapshot runtime/h/snapshots policy_lease))
        ensure
          (close_round_controller controller)
          (close_runtime runtime)))))

  (it "skips a timed-out listener and runs the next one" []
    (isolated this_mod/.path "skips a timed-out listener and runs the next one"
      (fn [workspace]
        (let runtime (open_runtime workspace "default"
          (scripted_profile ["(Outcome ^done true ^reply \"done\")"])))
        (try
          (let slow
            (Plugin ^id "aaa_slow_hook" ^activate (fn [host]
              (host .PluginHost:contribute "hooks"
                {^point "request/prepare" ^name "slow"
                 ^run (fn [context, next] ($sleep 5000) (next context))}))))
          (let installed (put_cordis_plugin runtime/h slow
            {^host true
             ^limits (ExecutionLimits ^max_steps 1000000
               ^max_memory_mb 64 ^timeout_ms 1000)}))
          (let activation_error (plugin_error runtime/h "aaa_slow_hook"))
          ($assert (== installed "ready")
            $"slow hook did not activate: ${installed}; ${activation_error}")
          (let lease (acquire_snapshot runtime/h/snapshots))
          (try
            (let prepared (request_prepare runtime lease/snapshot
              (prepare_context)))
            (var diagnosed false)
            (let traces [])
            (for event in (events_for runtime/events "session" "default")
              (if (== event/type "trace")
                (then
                  (traces .push event/payload/text)
                  (if ($str/contains? event/payload/text "hook request/prepare/slow")
                    (set diagnosed true)))))
            (let hook_list (hook_rows lease/snapshot "request/prepare"))
            ($assert diagnosed $"timed-out hook was not logged: ${traces}; rows ${hook_list}; prepared ${prepared}")
            ($assert (== prepared/items/.size 1)
              $"timed-out hook suppressed the budget listener: ${prepared}; ${traces}")
          ensure
            (release_snapshot runtime/h/snapshots lease))
          (let controller (new_round_controller runtime))
          (try
            (let accepted (submit_round controller "default" "slow" 1 "go"))
            (controller/watchers .get; .get "default"; .join)
            (let receipt (round_receipt controller "default" accepted/id))
            ($assert (== receipt/state "done")
              "timed-out hook prevented the provider call")
            ($assert (== (count_events runtime "model/request") 1)
              "timed-out hook suppressed model/request")
            ($assert (== (count_events runtime "turn/end") 1)
              "timed-out hook suppressed turn/end")
          ensure
            (close_round_controller controller))
        ensure
          (close_runtime runtime)))))

  (it "runs downstream listeners once when a hook calls next twice" []
    (isolated this_mod/.path "runs downstream listeners once when a hook calls next twice"
      (fn [workspace]
        (let runtime (open_runtime workspace "default"
          (scripted_profile ["(Outcome ^done true ^reply \"done\")"])))
        (let calls ($cell 0))
        (try
          (contribute ^priority -20 runtime/h "core" "hooks"
            {^point "request/prepare" ^name "double"
             ^run (fn [context, next]
               (next context)
               (next context))})
          (contribute ^priority -10 runtime/h "core" "hooks"
            {^point "request/prepare" ^name "count"
             ^run (fn [context, next]
               (calls .set (+ calls/.get 1))
               (next context))})
          (let lease (acquire_snapshot runtime/h/snapshots))
          (try
            (let prepared (request_prepare runtime lease/snapshot
              (prepare_context)))
            ($assert (== calls/.get 1)
              "calling next twice ran downstream hooks twice")
            ($assert (== prepared/items/.size 1)
              "a duplicate next call lost the prepared request")
            (var diagnosed false)
            (let traces [])
            (for event in (events_for runtime/events "session" "default")
              (if (== event/type "trace")
                (then
                  (traces .push event/payload/text)
                  (if ($str/contains? event/payload/text "more than once")
                    (set diagnosed true)))))
            ($assert diagnosed $"duplicate next call was not diagnosed: ${traces}")
          ensure
            (release_snapshot runtime/h/snapshots lease))
        ensure
          (close_runtime runtime)))))

  (it "skips a panicking plugin listener" []
    (isolated this_mod/.path "skips a panicking plugin listener"
      (fn [workspace]
        (let runtime (open_runtime workspace "default"
          (scripted_profile ["(Outcome ^done true ^reply \"done\")"])))
        (try
          (let panicking
            (Plugin ^id "aaa_panic_hook" ^activate (fn [host]
              (host .PluginHost:contribute "hooks"
                {^point "request/prepare" ^name "panic"
                 ^run (fn [context, next] ($panic "hook panic probe"))}))))
          ($assert (== (put_cordis_plugin runtime/h panicking
            {^host true ^limits (ExecutionLimits ^max_steps 1000000
              ^max_memory_mb 64 ^timeout_ms 1000)}) "ready")
            "panic probe plugin did not activate")
          (let lease (acquire_snapshot runtime/h/snapshots))
          (try
            (let prepared (request_prepare runtime lease/snapshot
              (prepare_context)))
            ($assert (== prepared/items/.size 1)
              "panicking hook suppressed the next listener")
            (var diagnosed false)
            (for event in (events_for runtime/events "session" "default")
              (if (&& (== event/type "trace")
                       ($str/contains? event/payload/text "hook panic probe"))
                (set diagnosed true)))
            ($assert diagnosed "panicking hook was not diagnosed")
          ensure
            (release_snapshot runtime/h/snapshots lease))
        ensure
          (close_runtime runtime))))))

(fn main [args] : Int (run_spec args))
