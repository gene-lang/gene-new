(import $test [describe it])
(import [isolated run_spec] ^from "./support")
(import [open_event_store close_event_store append_core_event record_core_state
         flush_event_store core_states]
  ^from "../src/storage/state")
(import [open_session_manager close_session_manager create_session list_sessions load_session
         view_session leave_session unload_session unload_idle_sessions update_session session_busy?]
  ^from "../src/runtime/sessions")
(import [append_message] ^from "../src/agents/history")

(describe "Harness sessions"
  (it "shares the runtime while preserving histories, idle unload and recovery" []
    (isolated this_mod/.path "shares the runtime while preserving histories, idle unload and recovery"
      (fn [workspace]
        (let root workspace)
        ($fs/make_dir $"${root}/events")
        (let events (open_event_store $"${root}/events"))
        ($fs/make_dir $"${root}/blobs")
        (let runtime {^events events ^state_root root ^root root ^sessions nil ^body_gc_pending ($cell false)})
        (let manager (open_session_manager runtime events root ^idle_timeout_ms 0))
        (runtime .put "sessions" manager)
        (create_session manager ^id "a" ^title "Alpha")
        (create_session manager ^id "b" ^title "Beta")
        (create_session manager ^id "heartbeat" ^kind "heartbeat" ^trigger "tick"
          ^first_request "Audit this project")
        (create_session manager ^id "pinned" ^kind "cron" ^trigger "nightly" ^^pinned)
        (let default_sessions (list_sessions manager))
        ($assert (== default_sessions/.size 3) "default list did not select interactive and pinned sessions")
        ($assert (== ($size (list_sessions manager ^q "audit")) 1) "request search failed")
        ($assert (== ($size events/streams/.get) 1) "listing loaded session streams")
        (scope
          (let rename (spawn ^lane root (update_session manager "a" {^title "Renamed"})))
          (let state (spawn ^lane root (update_session manager "a" {^status "done" ^attention true})))
          (await rename) (await state))
        (let renamed (list_sessions manager ^q "renamed"))
        ($assert (== renamed/.size 1) "parallel metadata update lost the rename")
        ($assert renamed/0/attention "parallel metadata update lost attention")
        (update_session manager "a" {^attention false})
        (for id in ["a" "b"]
          (append_message runtime id "user" $"Question from ${id}")
          (append_message runtime id "assistant" $"Response to ${id}")
          (append_core_event events "session" id {^type "turn/response" ^turn 1 ^text id})
          (append_core_event events "session" id {^type "turn/end" ^turn 1 ^reason "done"}))
        (let a (load_session manager "a"))
        (let b (load_session manager "b"))
        ($assert (same? a/runtime b/runtime) "session load created another runtime")
        (let history_a a/history/.get)
        (let history_b b/history/.get)
        ($assert (== history_a/.size 2) "reload test has no actual history")
        (view_session manager "a")
        ($assert (! (unload_session manager "a")) "viewed session unloaded")
        (leave_session manager "a")
        (b/round .set {^state "running"})
        ($assert (== (unload_idle_sessions manager) 1) "idle unload interrupted a running session")
        (let reloaded_a (load_session manager "a"))
        ($assert (== reloaded_a/history/.get history_a) "a history changed on reload")
        (b/round .set nil)
        ($assert (unload_session manager "b") "idle b did not unload")
        (let reloaded_b (load_session manager "b"))
        ($assert (== reloaded_b/history/.get history_b) "b history changed on reload")
        (record_core_state events "session" "a" "round/state" "round"
          {^id "waiting-round" ^state "waiting" ^questions [{^id "q" ^prompt "Choose"}]})
        (update_session manager "a" {^status "waiting"})
        (record_core_state events "session" "heartbeat" "round/state" "round"
          {^id "trigger-round" ^state "running"})
        (append_core_event events "session" "heartbeat" {^type "turn/start" ^turn 1})
        (update_session manager "heartbeat" {^status "running" ^turns 1})
        (close_session_manager manager)
        (close_event_store events)
        (let restored_events (open_event_store $"${root}/events"))
        (runtime .put "events" restored_events)
        (let restored (open_session_manager runtime restored_events root ^idle_timeout_ms 0))
        (runtime .put "sessions" restored)
        (try
          ($assert (== ($size restored_events/streams/.get) 1) "startup retained session streams")
          ($assert (== (restored_events/streams/.get .get "session:heartbeat") void)
            "recovery retained the interrupted session stream")
          (let waiting (load_session restored "a"))
          ($assert (session_busy? waiting) "waiting round did not restore")
          (let waiting_round waiting/round/.get)
          ($assert (== waiting_round/questions/0/id "q") "waiting question was lost")
          ($assert (unload_session restored "a") "waiting session could not unload")
          (let attention (list_sessions restored ^attention true))
          ($assert (== attention/.size 1) "interrupted trigger lost attention")
          ($assert (== attention/0/status "interrupted") "running round was not interrupted")
          (let trigger_state (view_session restored "heartbeat"))
          (let interrupted_round trigger_state/round/.get)
          ($assert (== interrupted_round/state "interrupted") "interrupted round projection did not restore")
          ($assert (== ($size (list_sessions restored ^attention true)) 0) "opening did not clear attention")
          (let restored_b (load_session restored "b"))
          ($assert (== restored_b/history/.get history_b) "restart changed b history")
          ($println "sessions: index, shared runtime, history, idle unload and crash recovery passed")
          ensure
            (close_session_manager restored)
            (close_event_store restored_events))))))

(fn main [args] : Int (run_spec args))
