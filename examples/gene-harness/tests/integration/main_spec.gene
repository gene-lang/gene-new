# Real CLI processes talk to the same host and HTTP contract as the browser.
(import $test [describe it])
(import ^from "../support" [isolated run_spec package_path])
(import ^from "../web_support" [start_host launch_host ready_host stop_host cli])
(import ^from "../../src/cli/client" [connect api wire checked session_path wait_for])
(import ^from "../../src/runtime/workspace_lock" [acquire_workspace_lock close_workspace_lock])
(import $net/http [listen stop])
(import $io [tcp_connect AsyncReader IoResource write_all])
(import $net/http_client [request])

(describe
  "Harness owner clients"
  (it
    "shares sessions, literal prompts, commands and receipts across independent CLI clients"
    []
    (isolated
      this_mod/.path
      "shares sessions, literal prompts, commands and receipts across independent CLI clients"
      (fn [workspace]
        (let host (start_host $"${workspace}/host"))
        (try
          (let listing (cli host/root ["sessions"]))
          ($assert listing/sessions/.empty? "host created an implicit terminal conversation")
          (let record (cli host/root ["sessions" "create" "--title" "Shared conversation"]))
          (let session record/id)
          (let left_job (spawn ^lane root (cli host/root ["sessions" "create" "--title" "Left"])))
          (let right_job (spawn ^lane root (cli host/root ["sessions" "create" "--title" "Right"])))
          (let left (await left_job))
          (let right (await right_job))
          ($assert (!= left/id right/id) "concurrent CLI clients collided on session creation")
          (let command (cli host/root ["--session" session "run" "(+ 2 3)"]))
          ($assert (== command/status "done") "operator command did not finish")
          ($assert ($str/contains? command/display "5") "operator result missing")
          (let text "($fs/write_text \"once\" ($to_str (+ 1 (if ($fs/exists? \"once\") ($parse/parse_int ($fs/read_text \"once\")) 0))))")
          (let identity "once / owner")
          (let first
            (cli
              host/root
              ["--session" session "run" text "--request-id" identity "--sequence" "2"]))
          (let repeated
            (cli
              host/root
              ["--session" session "run" text "--request-id" identity "--sequence" "2"]))
          ($assert (== first/id repeated/id) "retry allocated another command")
          ($assert (== ($fs/read_text $"${host/root}/once") "1") "retry repeated the side effect")
          (let found
            (cli
              host/root
              ["--session" session "receipt" "--request-id" identity "--kind" "command"]))
          ($assert (== found/id first/id) "request identity lookup lost command")
          (let conflict
            (cli ^expected 1
              host/root
              ["--session" session "run" "(+ 9 9)" "--request-id" identity "--sequence" "2"]))
          ($assert
            (== conflict/code "submission_conflict")
            "identity reuse did not reject changed content")
          ($assert (== conflict/request_id identity) "structured error lost request identity")
          (let shell (cli host/root ["--session" session "sh" "printf shell-ok"]))
          ($assert ($str/contains? shell/display "shell-ok") "CLI shell output was lost")
          (let failed_shell (cli host/root ["--session" session "sh" "exit 7"] ^expected 1))
          ($assert (== failed_shell/exit 7) "CLI hid shell exit status")
          (let code_file $"${host/root}/operator.gene")
          ($fs/write_text code_file "(+ 6 7)")
          ($assert ($str/contains? (/display (cli host/root ["--session" session "run" "--file" code_file])) "13")
            "CLI did not evaluate a local code file")
          ($assert ($str/contains? (/display (cli host/root ["--session" session "view" "operator.gene"])) "(+ 6 7)")
            "CLI file view did not use the host workspace")
          ($assert ($str/contains? (/display (cli host/root ["--session" session "command" "/help"])) "/run")
            "CLI did not invoke the registered command")
          (let prompt (cli host/root ["--session" session "send" "--wait" "/this-is-literal"]))
          ($assert (== prompt/state "done") "literal prompt was routed as a slash command")
          (let transcript (cli host/root ["--session" session "transcript"]))
          ($assert (> transcript/records/.size 0) "transcript is empty")
          (let browser (connect host/root))
          (let snapshot (api browser "GET" (session_path session "/snapshot?ui=default")))
          ($assert (== snapshot/round/id prompt/id) "browser and CLI see different conversations")
          (let prompt_file $"${host/root}/prompt.txt")
          ($fs/write_text prompt_file "Prompt from a client file")
          (let from_file (cli host/root ["--session" session "send" "--wait" "--file" prompt_file]))
          ($assert (== from_file/prompt "Prompt from a client file") "CLI prompt file changed contents")
          (let status (cli host/root ["status"]))
          ($assert ($absent? status/csrf) "CLI diagnostics exposed a CSRF credential")
          (let repair (cli ^expected 1 host/root ["doctor"]))
          ($assert
            ($str/contains? repair/message "in use")
            "offline maintenance bypassed the host lock")
        ensure
          (let stopped (stop_host host))
          ($assert (== stopped/status 0) stopped/stderr))))))

(describe
  "Harness owner credentials"
  (it
    "reuses owner links, preserves independent clients and resets access without cancelling work"
    []
    (isolated
      this_mod/.path
      "reuses owner links, preserves independent clients and resets access without cancelling work"
      (fn [workspace]
        (let host
          (start_host ^script ["($sleep 1500) (Outcome ^^done ^reply \"still finished\")"]
            $"${workspace}/host"))
        (try
          (let token ($fs/read_text $"${host/root}/.gene-harness/web_secret"))
          (let first (wire host/connection "POST" "/auth/exchange" {^token token}))
          (let second (wire host/connection "POST" "/auth/exchange" {^token token}))
          ($assert (== first/status 200) "first browser exchange failed")
          ($assert (== second/status 200) "owner token was consumed")
          (let first_parts ($str/split (first/headers .get "set-cookie") ";"))
          (let second_parts ($str/split (second/headers .get "set-cookie") ";"))
          (let cookie1 {^cookie first_parts/0 ^csrf first/body/csrf})
          (let cookie2 {^cookie second_parts/0 ^csrf second/body/csrf})
          (let another_tab
            (wire ^credentials cookie1 host/connection "POST" "/auth/exchange" {^token token}))
          ($assert
            (== another_tab/body/csrf first/body/csrf)
            "another tab changed the browser's CSRF value")
          ($assert
            (== (another_tab/headers .get "set-cookie") (first/headers .get "set-cookie"))
            "another tab replaced the shared cookie")
          ($assert
            (==
              ((Path "status")
                (wire ^credentials cookie1 host/connection "GET" "/status?ui=default"))
              200)
            "second browser invalidated first")
          (let record (cli host/root ["sessions" "create"]))
          (let round (cli host/root ["--session" record/id "send" "continue after reset"]))
          (cli host/root ["auth" "reset"])
          ($assert
            (!= token ($fs/read_text $"${host/root}/.gene-harness/web_secret"))
            "reset retained owner token")
          ($assert
            (== ((Path "status") (wire host/connection "POST" "/auth/exchange" {^token token})) 401)
            "old owner token survived reset")
          (for credentials in [cookie1 cookie2]
            ($assert
              (==
                ((Path "status")
                  (wire ^credentials credentials host/connection "GET" "/status?ui=default"))
                401)
              "old client survived reset"))
          (let finished (cli host/root ["--session" record/id "wait" round/id]))
          ($assert (== finished/reply "still finished") "reset cancelled admitted work")
          (let link (cli host/root ["link"]))
          ($assert ($str/starts_with? link host/connection/origin) "link points at the wrong host")
          ($assert
            ($str/contains? link ($fs/read_text $"${host/root}/.gene-harness/web_secret"))
            "link retained old credential")
        ensure
          (stop_host host))))))

(describe
  "Harness CLI control"
  (it
    "answers and dismisses questions, rejects busy submissions and cancels host work explicitly"
    []
    (isolated
      this_mod/.path
      "answers and dismisses questions, rejects busy submissions and cancels host work explicitly"
      (fn [workspace]
        (let host
          (start_host ^script ["(Outcome ^questions [{^id \"name\" ^prompt \"Name?\"}])" "(Outcome ^^done ^reply \"answered\")" "(Outcome ^questions [{^id \"ok\" ^prompt \"Continue?\" ^kind \"confirm\"}])" "(Outcome ^^done ^reply \"dismissed\")" "($sleep 5000) (Outcome ^^done ^reply \"slow\")" "(Outcome ^^done ^reply \"other\")"]
            $"${workspace}/host"))
        (try
          (let session ((Path "id") (cli host/root ["sessions" "create"])))
          (let other ((Path "id") (cli host/root ["sessions" "create"])))
          (let waiting (cli ^expected 2 host/root ["--session" session "send" "--wait" "ask"]))
          (let resumed
            (cli
              host/root
              [
                "--session"
                session
                "answer"
                "--batch"
                waiting/questions/id
                "--answers"
                "{\"name\":\"Gene\"}"]))
          ($assert
            (== ((Path "reply") (cli host/root ["--session" session "wait" resumed/id])) "answered")
            "answer did not resume")
          (let question
            (cli ^expected 2 host/root ["--session" session "send" "--wait" "ask again"]))
          (let dismissed
            (cli host/root ["--session" session "dismiss" "--batch" question/questions/id]))
          ($assert
            (==
              ((Path "reply") (cli host/root ["--session" session "wait" dismissed/id]))
              "dismissed")
            "dismiss did not resume")
          (let slow (cli host/root ["--session" session "send" "slow"]))
          ($assert
            (==
              ((Path "code") (cli ^expected 1 host/root ["--session" session "send" "collision"]))
              "busy")
            "busy session accepted another round")
          ($assert
            (==
              ((Path "reply") (cli host/root ["--session" other "send" "--wait" "parallel"]))
              "other")
            "other session was blocked")
          ($assert
            (== ((Path "code") (cli ^expected 1 host/root ["stop"])) "confirmation_required")
            "stop skipped confirmation")
          (cli host/root ["--session" session "cancel" "--round" slow/id])
          ($assert
            (==
              ((Path "state") (cli ^expected 1 host/root ["--session" session "wait" slow/id]))
              "cancelled")
            "round did not cancel")
          (let command (cli host/root ["--session" session "run" "($sleep 5000) 42" "--no-wait"]))
          ($assert
            (==
              ((Path "code")
                (cli ^expected 1
                  host/root
                  ["--session" session "wait" "--command" command/id "--timeout-ms" "10"]))
              "wait_timeout")
            "wait did not time out locally")
          ($assert
            (==
              ((Path "status")
                (cli host/root ["--session" session "receipt" "--command" command/id]))
              "running")
            "ending a wait cancelled command")
          (cli host/root ["--session" session "cancel" "--command" command/id])
          ($assert
            (==
              ((Path "status")
                (cli ^expected 1 host/root ["--session" session "wait" "--command" command/id]))
              "cancelled")
            "command did not cancel")
          (let definition $"${host/root}/trigger.gene")
          ($fs/write_text
            definition
            ($serde/write_data {^id "check" ^kind "heartbeat" ^every_ms 60000 ^request "check"}))
          (cli host/root ["triggers" "create" definition])
          ($assert
            (== (((Path "triggers") (cli host/root ["triggers" "list"])) .size) 1)
            "trigger missing")
          (cli host/root ["triggers" "occurrences" "check"])
          (cli host/root ["triggers" "occurrences"])
          (cli host/root ["triggers" "delete" "check"])
        ensure
          (stop_host host))))))

(describe
  "Harness host lifecycle"
  (it
    "remembers ports and credentials across fresh starts and announces only remembered-port fallback"
    []
    (isolated
      this_mod/.path
      "remembers ports and credentials across fresh starts and announces only remembered-port fallback"
      (fn [workspace]
        (let host (start_host ^!offline $"${workspace}/host"))
        (let first host/connection)
        (let token ($fs/read_text $"${host/root}/.gene-harness/web_secret"))
        (let credentials ((Path "credentials") (connect host/root)))
        ($assert
          (== ((Path "profile") (cli host/root ["status"])) "web")
          "production profile is not web")
        ($assert (== ((Path "status") (stop_host host)) 0))
        ($assert
          (! ($fs/exists? $"${host/root}/.gene-harness/connection"))
          "stop left a ready descriptor")
        ($assert (! ($fs/exists? $"${host/root}/.gene-harness/link")) "stop left an active link")
        (let restarted (start_host host/root))
        (try
          ($assert (== restarted/connection/port first/port) "fresh start changed port")
          ($assert (!= restarted/connection/epoch first/epoch) "restart reused instance")
          ($assert
            (==
              ((Path "status")
                (wire ^credentials credentials restarted/connection "GET" "/status?ui=default"))
              200)
            "restart expired client credentials")
          (let other (start_host $"${workspace}/other"))
          (try
            ($assert (!= other/connection/port first/port) "workspaces shared a live port")
          ensure
            (stop_host other))
          (let rejected (launch_host ^port first/port $"${workspace}/rejected"))
          (let failure (await rejected/process))
          ($assert (!= failure/status 0) "explicit port silently fell back")
          ($assert
            ($str/contains? failure/stdout "address_in_use")
            "bind error lacks structured reason")
          (let lock (acquire_workspace_lock rejected/root "verify cleanup"))
          (close_workspace_lock lock)
        ensure
          (stop_host restarted))
        (let blocker (listen ^host "127.0.0.1" ^port first/port))
        (try
          (let strict (launch_host ^restart_port first/port $"${workspace}/strict-restart"))
          ($assert
            (!= ((Path "status") (await strict/process)) 0)
            "supervised port collision silently fell back")
          (let moved (start_host host/root))
          (try
            ($assert
              (!= moved/connection/port first/port)
              "occupied remembered port did not fall back")
            ($assert
              (== token ($fs/read_text $"${host/root}/.gene-harness/web_secret"))
              "fallback reset owner credential")
          ensure
            (let result (stop_host moved))
            ($assert ($str/contains? result/stdout "address changed") "fallback was silent"))
        ensure
          (stop blocker)))))
  (it
    "restarts under supervision on the same port with the same credentials"
    []
    (isolated
      this_mod/.path
      "restarts under supervision on the same port with the same credentials"
      (fn [workspace]
        (let host (start_host ^^supervised $"${workspace}/host"))
        (try
          (let first host/connection)
          (let credentials ((Path "credentials") (connect host/root)))
          (let result (cli host/root ["restart"]))
          ($assert result/restart "launcher did not supervise restart")
          (let second (ready_host ^previous first/epoch host))
          ($assert (== second/port first/port) "supervised restart changed port")
          ($assert
            (==
              ((Path "status") (wire ^credentials credentials second "GET" "/status?ui=default"))
              200)
            "supervised restart revoked cookie")
        ensure
          (stop_host host))))))

(describe
  "Harness connection recovery"
  (it
    "revokes browser streams while retaining work and enforcing browser request checks"
    []
    (isolated
      this_mod/.path
      "revokes browser streams while retaining work and enforcing browser request checks"
      (fn [workspace]
        (let host (start_host $"${workspace}/host"))
        (var socket nil)
        (var reader nil)
        (try
          (let client (connect host/root))
          (let session ((Path "id") (api client "POST" "/sessions" {})))
          ($assert
            (== ((Path "status") (wire host/connection "GET" "/sessions")) 401)
            "unauthenticated workspace read succeeded")
          (let wrong {^cookie client/credentials/cookie ^csrf "wrong"})
          ($assert
            (==
              ((Path "status") (wire ^credentials wrong host/connection "POST" "/sessions" {}))
              403)
            "CSRF check was bypassed")
          (for headers in [{^origin "http://other.invalid" ^cookie client/credentials/cookie ^x-csrf-token client/credentials/csrf} {^origin host/connection/origin ^host "other.invalid" ^cookie client/credentials/cookie ^x-csrf-token client/credentials/csrf}]
            (let denied
              (await
                (request ^method "POST" ^url $"${host/connection/origin}/api/v6/sessions" ^headers headers ^body "{}" ^timeout_ms 5000)))
            ($assert (== denied/status 403) "Host or Origin validation was bypassed"))
          (let descriptor_path $"${host/root}/.gene-harness/connection")
          (let saved ($fs/read_text descriptor_path))
          (try
            (for change in [{^protocol 999} {^epoch "stale-instance"}]
              (let descriptor ($serde/read_data saved))
              (for [key value] in change
                (descriptor .put key value))
              ($fs/write_text descriptor_path ($serde/write_data descriptor))
              ($assert
                (== ((Path "code") (cli ^expected 1 host/root ["status"])) "connection_mismatch")
                "CLI accepted stale or incompatible metadata"))
          ensure
            ($fs/write_text descriptor_path saved))
          (set socket (await (tcp_connect "127.0.0.1" host/connection/port)))
          (let header
            ($str/join
              [$"GET /api/v6/events?ui=default&session=${session} HTTP/1.1"
               $"Host: 127.0.0.1:${host/connection/port}"
               $"Origin: ${host/connection/origin}"
               $"Cookie: ${client/credentials/cookie}"
               "Upgrade: websocket" "Connection: Upgrade" "Sec-WebSocket-Version: 13"
               "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==" "" ""]
              "\r\n"))
          (await (write_all socket ($binary/from_str header)))
          (var response "")
          (while (! ($str/ends_with? response "\r\n\r\n"))
            (let byte (await (socket .AsyncReader:read 1)))
            ($assert (! ($absent? byte)) "socket closed before upgrade")
            (set response ($to_str response ($binary/to_str byte))))
          ($assert ($str/starts_with? response "HTTP/1.1 101") "browser socket did not upgrade")
          (set reader
            (spawn ^lane root (loop (let bytes (await (socket .AsyncReader:read 65536))) (if ($absent? bytes) (return true)))))
          (cli host/root ["auth" "reset"])
          (let due (+ ($os/monotonic_ms) 3000))
          (while (&& (! reader/.done?) (< ($os/monotonic_ms) due))
            ($sleep 10))
          ($assert reader/.done? "credential reset left an authenticated stream open")
          (for name in ["web_secret" "web_sessions" "link"]
            ($assert
              (== ((Path "mode") ($fs/info $"${host/root}/.gene-harness/${name}")) 384)
              "credential file is not owner-only"))
          (cli host/root ["status"])
          ($assert
            (== ((Path "mode") ($fs/info $"${host/root}/.gene-harness/cli_cookie")) 384)
            "CLI cookie is not owner-only")
        ensure
          (if_not ($absent? socket) socket/.IoResource:close)
          (if_not ($absent? reader)
            reader/.cancel
            reader/.join)
          (stop_host host)))))
  (it
    "cleans up failed startup and preserves offline repair and credential reset"
    []
    (isolated
      this_mod/.path
      "cleans up failed startup and preserves offline repair and credential reset"
      (fn [workspace]
        (let host (start_host $"${workspace}/host"))
        (let port host/connection/port)
        (let secret ($fs/read_text $"${host/root}/.gene-harness/web_secret"))
        (stop_host host)
        (let config_path $"${host/root}/.gene-harness/config.gene")
        (let original ($fs/read_text config_path))
        ($fs/write_text config_path "broken(")
        (let broken (launch_host host/root))
        ($assert (!= ((Path "status") (await broken/process)) 0) "invalid configuration started")
        ($assert
          (! ($fs/exists? $"${host/root}/.gene-harness/connection"))
          "failed startup advertised ready")
        (let listener (listen ^host "127.0.0.1" ^port port))
        (stop listener)
        (let lock (acquire_workspace_lock host/root "failed-start check"))
        (close_workspace_lock lock)
        ($fs/write_text config_path original)
        (cli host/root ["doctor"])
        (cli host/root ["disable" "gene_reference"])
        (cli host/root ["enable" "gene_reference"])
        (cli host/root ["disable" "gene_reference"])
        (cli host/root ["restore" "gene_reference"])
        ($fs/write_text $"${host/root}/.gene-harness/web_secret" "damaged")
        ($fs/write_text $"${host/root}/.gene-harness/web_sessions" "damaged(")
        (cli host/root ["auth" "reset"])
        ($assert
          (!= secret ($fs/read_text $"${host/root}/.gene-harness/web_secret"))
          "offline reset retained token")
        ($assert
          (== ((Path "code") (cli ^expected 1 host/root ["link"])) "unavailable")
          "link advertised a stopped host")
        (let resumed (start_host host/root))
        (try
          (cli resumed/root ["sessions"])
        ensure
          (stop_host resumed))))))

(describe
  "Harness durable interruption"
  (it
    "recovers crashed rounds and commands without replaying uncertain submissions"
    []
    (isolated
      this_mod/.path
      "recovers crashed rounds and commands without replaying uncertain submissions"
      (fn [workspace]
        (let response "($fs/write_text \"round-entered\" \"yes\") ($sleep 60000) (Outcome ^^done ^reply \"never\")")
        (var host (start_host ^script [response] $"${workspace}/host"))
        (try
          (let session ((Path "id") (cli host/root ["sessions" "create"])))
          (let round (cli host/root ["--session" session "send" "long work"]))
          (let code "($fs/write_text \"command-count\" ($to_str (+ 1 (if ($fs/exists? \"command-count\") ($parse/parse_int ($fs/read_text \"command-count\")) 0)))) ($sleep 60000) 42")
          (let command
            (cli
              host/root
              ["--session" session "run" code "--no-wait" "--request-id" "held" "--sequence" "1"]))
          (let due (+ ($os/monotonic_ms) 5000))
          (while (&& (|| (! ($fs/exists? $"${host/root}/round-entered")) (! ($fs/exists? $"${host/root}/command-count"))) (< ($os/monotonic_ms) due))
            ($sleep 10))
          ($assert ($fs/exists? $"${host/root}/command-count") "command did not start")
          (let client (connect host/root))
          (try
            (api
              client
              "POST"
              (session_path session "/commands")
              {^text "/run ($os/exit 17)" ^request_id "crash" ^submission_seq "2"})
          catch Any
            nil)
          ($assert (== ((Path "status") (await host/process)) 17) "fixture did not crash the host")
          ($assert
            (== ((Path "code") (cli ^expected 1 host/root ["link"])) "unavailable")
            "stale descriptor was treated as live")
          (set host (start_host ^script [response] host/root))
          ($assert
            (==
              ((Path "state") (cli ^expected 1 host/root ["--session" session "receipt" round/id]))
              "interrupted")
            "round was not interrupted")
          ($assert
            (==
              ((Path "status")
                (cli ^expected 1 host/root ["--session" session "receipt" "--command" command/id]))
              "interrupted")
            "command was left running forever")
          (let retry
            (cli ^expected 1
              host/root
              ["--session" session "run" code "--request-id" "held" "--sequence" "1"]))
          ($assert (== retry/id command/id) "uncertain command was re-admitted")
          ($assert
            (== ($fs/read_text $"${host/root}/command-count") "1")
            "crash recovery repeated command side effect")
        ensure
          (stop_host host))))))

(describe
  "Harness shutdown grace"
  (it
    "bounds uncooperative cleanup and preserves cancelled receipts and waiting questions"
    []
    (isolated
      this_mod/.path
      "bounds uncooperative cleanup and preserves cancelled receipts and waiting questions"
      (fn [workspace]
        (var host
          (start_host ^script ["(Outcome ^questions [{^id \"name\" ^prompt \"Name?\"}])" "(try (do ($fs/write_text \"entered\" \"yes\") (while true ($sleep 10))) ensure (do (var i 0) (while true (set i (+ i 1)))))"]
            $"${workspace}/host"))
        (try
          (let waiting_session ((Path "id") (cli host/root ["sessions" "create"])))
          (let busy_session ((Path "id") (cli host/root ["sessions" "create"])))
          (let waiting
            (cli ^expected 2 host/root ["--session" waiting_session "send" "--wait" "ask"]))
          (let busy (cli host/root ["--session" busy_session "send" "spin"]))
          (let due (+ ($os/monotonic_ms) 5000))
          (while (&& (! ($fs/exists? $"${host/root}/entered")) (< ($os/monotonic_ms) due))
            ($sleep 10))
          ($assert ($fs/exists? $"${host/root}/entered") "cleanup fixture did not start")
          (let before ($os/monotonic_ms))
          (try
            (api (connect host/root) "POST" "/control" {^action "stop" ^^confirm})
          catch Any
            nil)
          ($assert
            (== ((Path "status") (await host/process)) 0)
            "shutdown watchdog returned failure")
          (let elapsed (- ($os/monotonic_ms) before))
          ($assert (&& (>= elapsed 4500) (< elapsed 7500)) $"shutdown grace took ${elapsed} ms")
          (set host (start_host host/root))
          ($assert
            (==
              ((Path "state")
                (cli ^expected 1 host/root ["--session" busy_session "receipt" busy/id]))
              "cancelled")
            "shutdown lost cancelled receipt")
          (let pending (cli ^expected 2 host/root ["--session" waiting_session "status"]))
          ($assert
            (== pending/questions/id waiting/questions/id)
            "shutdown lost pending question batch")
        ensure
          (stop_host host))))))

(fn main [args] : Int
  (run_spec args))
