# Tests src/main.gene.
(import $test [describe it])
(import [isolated run_spec test_controller package_path] ^from "../support")
(import $io [IoResource pipe write_all])
(import [open_session_service close_session_service] ^from "../../src/web/session_service")
(import [list_sessions create_session load_session] ^from "../../src/runtime/sessions")
(import [open_runtime close_runtime] ^from "../../src/runtime/bootstrap")
(import [baseline_profile] ^from "../../src/profiles/baseline")
(import [submit_round close_round_controller] ^from "../../src/runtime/round_controller")
(import [submit_command command_receipt] ^from "../../src/runtime/commands")

(describe "Harness CLI"
  (it "closes an open REPL when stdin ends during a continuation" []
    (isolated this_mod/.path "closes an open REPL when stdin ends during a continuation"
      (fn [workspace]
        (let root ($fs/real_path workspace))
        (let script $"${root}/responses.gene")
        ($fs/write_text script ($to_str ["(Outcome ^done true ^reply \"unused\")"]))
        (let stdin (pipe))
        (let process ($os/exec_stream_async ($os/executable_path)
          "run" (package_path "src/main.gene") "chat" "--script" script
          "--workspace" $"${root}/workspace" ^stdin_pipe stdin/0
          ^timeout_ms 30000 ^max_bytes 1048576))
        (try
          (await (write_all stdin/1 ($binary/from_str "/repl\n(var retained 42)\n(do\n")))
          stdin/1/.IoResource:close
          (let result (await process))
          ($assert (== result/status 0) result/stderr)
          ($assert ($str/contains? result/stdout "default gene> ") result/stdout)
          ($assert ($str/contains? result/stdout "... ") result/stdout)
          ($assert (! ($str/contains? result/stdout "unused")) result/stdout)
          (let reopened (open_session_service ^workspace $"${root}/workspace" ^^offline))
          (close_session_service reopened)
        ensure (if_not process/.done? process/.cancel process/.join)))))

  (it "keeps questions pending while REPL input owns the prompt and asks after exit" []
    (isolated this_mod/.path "keeps questions pending while REPL input owns the prompt and asks after exit"
      (fn [workspace]
        (let root ($fs/real_path workspace))
        (let script $"${root}/responses.gene")
        ($fs/write_text script ($to_str [
          "($sleep 500) ($fs/write_text \"question-ready\" \"yes\") (Outcome ^questions [{^id \"name\" ^prompt \"What is your name?\"}])"
          "(Outcome ^done true ^reply \"answer accepted\")"]))
        (let stdin (pipe))
        (let lines ($channel ^capacity 128))
        (let process ($os/exec_stream_async ($os/executable_path)
          "run" (package_path "src/main.gene") "chat" "--script" script
          "--workspace" $"${root}/workspace" ^stdin_pipe stdin/0
          ^stdout_chan lines ^timeout_ms 30000 ^max_bytes 1048576))
        (try
          (scope
            (let writer (spawn ^lane root
              (do
                (await (write_all stdin/1 ($binary/from_str "ask\n/repl\n")))
                (let due (+ ($os/monotonic_ms) 20000))
                (while (&& (! ($fs/exists? $"${root}/workspace/question-ready")) (< ($os/monotonic_ms) due))
                  ($sleep 1))
                ($assert ($fs/exists? $"${root}/workspace/question-ready") "question response did not start")
                (await (write_all stdin/1 ($binary/from_str
                  "(do ($sleep 500) ($println \"input still in REPL\") 42)\nexit\nGene\n")))
                stdin/1/.IoResource:close)))
            (let output [])
            (try (loop (output .push lines/.recv)) catch ChannelClosed nil)
            (let result (await process))
            (await writer)
            (let text ($str/join output "\n"))
            ($assert (== result/status 0) $"${text}\n${result/stderr}")
            ($assert (! ($str/contains? text "Questions:")) text)
            (let parts ($str/split text "What is your name?"))
            ($assert (== parts/.size 2) text)
            ($assert ($str/contains? parts/0 "input still in REPL") text)
            ($assert ($str/contains? text "answer accepted") text))
        ensure (if_not process/.done? process/.cancel process/.join)))))

  (it "cancels REPL evaluation on SIGINT and retains its bindings" []
    (isolated this_mod/.path "cancels REPL evaluation on SIGINT and retains its bindings"
      (fn [workspace]
        (let root ($fs/real_path workspace))
        (let script $"${root}/responses.gene")
        ($fs/write_text script ($to_str ["(Outcome ^done true ^reply \"chat\")"]))
        (let stdin (pipe))
        (let lines ($channel ^capacity 128))
        (let stopped ($cell false))
        (let process ($os/exec_stream_async ($os/executable_path)
          "run" (package_path "src/main.gene") "chat" "--script" script
          "--workspace" $"${root}/workspace" ^stdin_pipe stdin/0
          ^stdout_chan lines ^timeout_ms 45000 ^max_bytes 1048576))
        (try
          (scope
            (let writer (spawn ^lane root
              (do
                (await (write_all stdin/1 ($binary/from_str
                  "/repl\n(var retained 42) ($fs/write_text \"pid\" ($to_str ($os/process_id)))\n(fn spin [] ($fs/write_text \"entered\" \"yes\") (while true nil))\n(spin)\n")))
                (let ready (+ ($os/monotonic_ms) 30000))
                (while (&& (! ($fs/exists? $"${root}/workspace/entered")) (< ($os/monotonic_ms) ready))
                  ($sleep 1))
                ($assert ($fs/exists? $"${root}/workspace/entered") "CLI REPL did not enter evaluation")
                (let pid ($str/trim ($fs/read_text $"${root}/workspace/pid")))
                (let signal (await ($os/exec_async "/bin/kill" "-INT" pid)))
                ($assert (== signal/status 0))
                (let due (+ ($os/monotonic_ms) 10000))
                (while (&& (! stopped/.get) (< ($os/monotonic_ms) due)) ($sleep 1))
                ($assert stopped/.get "SIGINT did not cancel the REPL input")
                (await (write_all stdin/1 ($binary/from_str "retained\nexit\n")))
                stdin/1/.IoResource:close)))
            (let output [])
            (try
              (loop
                (let line lines/.recv)
                (output .push line)
                (if ($str/contains? line "Stopped.") (stopped .set true)))
              catch ChannelClosed nil)
            (let result (await process))
            (await writer)
            (let text ($str/join output "\n"))
            ($assert (== result/status 0) $"exit ${result/status}; timed out ${result/timed_out}\n${text}\n${result/stderr}")
            ($assert ($str/contains? text "/repl retained\n42") text))
        ensure (if_not process/.done? process/.cancel process/.join)))))

  (it "routes persistent and multiline REPL inputs and returns to chat after exit" []
    (isolated this_mod/.path "routes persistent and multiline REPL inputs and returns to chat after exit"
      (fn [workspace]
        (let root ($fs/real_path workspace))
        (let script $"${root}/responses.gene")
        ($fs/write_text script ($to_str ["(Outcome ^done true ^reply \"chat resumed\")"]))
        (let input (pipe))
        (let lines ($channel ^capacity 128))
        (let process ($os/exec_stream_async ($os/executable_path) "run" (package_path "src/main.gene")
          "chat" "--script" script "--workspace" $"${root}/workspace"
          ^stdin_pipe input/0 ^stdout_chan lines ^timeout_ms 45000 ^max_bytes 1048576))
        (try
          (await (write_all input/1 ($binary/from_str
            "/repl\n(var count 40)\n(do\n (+ count 2))\n/help\nexit\nhello\n")))
          input/1/.IoResource:close
          (let output [])
          (try (loop (output .push lines/.recv)) catch ChannelClosed nil)
          (let result (await process))
          (let text ($str/join output "\n"))
          ($assert (== result/status 0) result/stderr)
          ($assert ($str/contains? text "default gene> ") text)
          ($assert ($str/contains? text "42") text)
          ($assert ($str/contains? text "Path") text)
          ($assert ($str/contains? text "chat resumed") text)
        ensure (if_not process/.done? process/.cancel process/.join)))))

  (it "keeps stdin responsive and supports multiline run, cancel and stop commands" []
    (isolated this_mod/.path "keeps stdin responsive and supports multiline run, cancel and stop commands"
      (fn [workspace]
        (let directory ($fs/real_path workspace))
        (let gene_binary ($os/executable_path))
        (let entry (package_path "src/main.gene"))
        (let script ($path/join directory "responses.gene"))
        ($fs/write_text
          script
          ($to_str
            [
              """# slow
($println "response console visible") ($sleep 5000) (Outcome ^done true ^reply "should not finish")"""]))
        (let stdin (pipe))
        (let lines ($channel ^capacity 128))
        (let console_seen ($cell false))
        (let process
          ($os/exec_stream_async gene_binary "run" entry "scripted" "--script" script "--workspace" ($path/join directory "workspace") ^stdin_pipe stdin/0 ^stdout_chan lines ^timeout_ms 30000 ^max_bytes 1048576))
        (scope
          (let writer
            (spawn ^lane root (do
              (await (write_all stdin/1 ($binary/from_list (($str/to_utf8 "slow\n") .to_list))))
              (let deadline (+ ($os/monotonic_ms) 20000))
              (while (&& (! console_seen/.get) (< ($os/monotonic_ms) deadline)) ($sleep 5))
              (await (write_all stdin/1 ($binary/from_list (($str/to_utf8 "/run (+ 2\n  3)\n") .to_list))))
              ($sleep 150)
              (await (write_all stdin/1 ($binary/from_list (($str/to_utf8 "/cancel\n") .to_list))))
              ($sleep 150)
              (await (write_all stdin/1 ($binary/from_list (($str/to_utf8 "/stop\n") .to_list))))
              stdin/1/.IoResource:close)))
          (let output [])
          (try
            (loop
              (let line lines/.recv)
              (output .push line)
              (if ($str/contains? line "response console visible") (console_seen .set true)))
          catch ChannelClosed
            nil)
          (let result (await process))
          (let text
            ($str/join
              output
              """
"""))
          ($assert (== result/status 0) $"interactive CLI failed: ${result/stderr}")
          ($assert ($str/contains? text "5") "CLI did not run a command while the round slept")
          ($assert ($str/contains? text "response console visible") $"CLI did not print response console output: ${text}")
          ($assert ($str/contains? text "Stopped.") "CLI did not cancel the running round")
          ($assert
            (! ($str/contains? text "should not finish"))
            "round finished before cancellation could be read")
          (await writer)
          ($println "async CLI: stdin remains responsive during evaluation, run/cancel/stop work"))))))

(describe "Harness shutdown"
  (it "stops within the grace period and restores the cancelled receipt" []
    (isolated this_mod/.path "stops within the grace period and restores the cancelled receipt"
      (fn [workspace]
        ($fs/make_dir workspace)
        (let root ($fs/real_path workspace))
        (let entry (package_path "src/main.gene"))
        (let script $"${root}/responses.gene")
        ($fs/write_text script ($to_str [
          "(try (do ($fs/write_text \"entered\" \"yes\") (while true ($sleep 10))) ensure (do (var i 0) (while true (set i (+ i 1)))))"]))
        (let input (pipe))
        (let lines ($channel ^capacity 128))
        (let process ($os/exec_stream_async ($os/executable_path)
          "run" entry "scripted" "--script" script "--workspace" $"${root}/workspace"
          ^stdin_pipe input/0 ^stdout_chan lines ^timeout_ms 45000 ^max_bytes 1048576))
        (await (write_all input/1 ($binary/from_str "start\n")))
        (let due (+ ($os/monotonic_ms) 30000))
        (while (&& (! ($fs/exists? $"${root}/workspace/entered")) (< ($os/monotonic_ms) due))
          ($sleep 1))
        ($assert ($fs/exists? $"${root}/workspace/entered") "round did not enter its uncooperative cleanup fixture")
        (let before ($os/monotonic_ms))
        (await (write_all input/1 ($binary/from_str "/stop\n")))
        input/1/.IoResource:close
        (let result (await process))
        (let elapsed (- ($os/monotonic_ms) before))
        ($assert (== result/status 0) $"stop did not exit zero: ${result}")
        ($assert (< elapsed 6500) $"shutdown exceeded its five-second grace: ${elapsed} ms")
        ($assert (>= elapsed 4500) "fixture did not exercise the shutdown grace deadline")
        (let reopened (open_session_service ^workspace $"${root}/workspace" ^^offline))
        (try
          (let records (list_sessions reopened/sessions))
          ($assert (== records/0/status "cancelled") "forced shutdown replayed or interrupted a cancelled round")
          ($println $"shutdown grace: stopped after ${elapsed} ms, released lock, restored cancelled receipt")
        ensure (close_session_service reopened)))))

  (it "refuses new rounds, preserves questions and releases the lock before restart" []
    (isolated this_mod/.path "refuses new rounds, preserves questions and releases the lock before restart"
      (fn [workspace]
        (let runtime (open_runtime workspace "default" (baseline_profile)))
        (let controller
          (test_controller
            runtime
            (fn [request]
              (if (== request/session "other")
                (do
                  ($sleep 5000)
                  "(Outcome ^done true ^reply \"later\")")
                "(Outcome ^questions [{^id \"name\" ^prompt \"Name?\"}])"))))
        (let root runtime/root)
        (try
          (create_session ^id "other" runtime/sessions)
          (create_session ^id "waiting" runtime/sessions)
          (submit_round controller "waiting" "q" 1 "ask")
          (controller/watchers
            .get
            ; .get "waiting"
            ; .join)
          (submit_round controller "other" "slow" 1 "wait")
          (let stop (submit_command runtime/commands "default" "/stop"))
          (runtime/commands/watchers
            .get
            ; .get $"default:${stop/id}"
            ; .join)
          (let refused (command_receipt runtime/commands "default" stop/id))
          ($assert
            (== refused/error_code "confirmation_required")
            "stop did not require other-session confirmation")
          ($assert (! runtime/stopping/.get) "stop acted before confirmation")
          (let confirmed (submit_command runtime/commands "default" "/stop --confirm"))
          (runtime/commands/watchers
            .get
            ; .get $"default:${confirmed/id}"
            ; .join)
          ($assert runtime/stopping/.get "confirmed stop did not stop admissions")
          ($assert
            (try
              (submit_round controller "default" "late" 1 "no")
              false
            catch Any
              true)
            "stopping runtime admitted another round")
          ($println "stop: other-session confirmation, admission refusal and durable waiting questions")
        ensure
          (close_round_controller controller)
          (close_runtime runtime))
        (let reopened (open_runtime root "default" (baseline_profile)))
        (try
          (let waiting (load_session reopened/sessions "waiting"))
          (let round waiting/round/.get)
          ($assert (== round/state "waiting") "stop discarded pending questions")
          ($println "stop: workspace lock released and pending questions survive reopen")
        ensure
          (close_runtime reopened))
        (let entry (package_path "src/main.gene"))
        (let direct (await ($os/exec_async ($os/executable_path)
          "run" entry "chat" "/restart" "--workspace" $"${root}/direct" ^timeout_ms 30000)))
        ($assert (== direct/status 0) $"direct restart did not exit normally: ${direct/stderr}")
        ($assert ($str/contains? direct/stdout "Direct gene run cannot restart") "direct restart omitted its terminal instruction")
        ($println "restart: direct invocation stops normally and explains terminal restart")))))

(fn main [args] : Int (run_spec args))
