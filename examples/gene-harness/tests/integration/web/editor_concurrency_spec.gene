(import $test [describe it])
(import isolated run_spec test_service ^from "../../support")
(import close_session_service ^from "../../../src/web/session_service")
(import save_document ^from "../../../src/builtin/editor")
(import with_patch_gate ^from "../../../src/runtime/patch")

# A save and an agent patch share the workspace patch gate. The save validates
# and writes only while holding the gate, so a patch that lands between the
# draft's revision and the save must produce a conflict instead of a lost
# update.

(describe "Editor save and the patch gate"
  (it "rechecks after waiting for a patch that already changed the file" []
    (isolated this_mod/.path "rechecks after waiting for a patch that already changed the file"
      (fn [workspace]
        (let service (test_service ^workspace workspace ^provider (fn [request] "")))
        (try
          (let root service/runtime/root)
          (let name "race.gene")
          (let path ($path/join root name))
          ($fs/write_text path "old\n")
          (let base ($crypto/sha256 ($fs/read_bytes path)))
          (let entered ($channel ^capacity 1))
          (let release ($channel ^capacity 1))
          # The patch holds the gate, waits for the save to be submitted, then
          # writes and commits before the save can proceed.
          (let patch (spawn ^lane root
            (with_patch_gate root
              (fn []
                (entered .send true)
                release/.recv
                ($fs/write_text path "patched\n")))))
          entered/.recv
          (let body ($json/stringify
            {^path name ^text "mine\n" ^base_revision base
             ^line_endings "lf" ^bom false}))
          (let saving (spawn ^lane root (save_document {^body body})))
          ($sleep 25)
          (release .send true)
          (let response (await saving))
          (await patch)
          ($assert (== response/status 409)
            $"a save that waited for the patch did not conflict: ${($json/stringify response)}")
          ($assert (== ($fs/read_text path) "patched\n")
            "the editor overwrote the patch")
        ensure (close_session_service service))))))

(fn main [args] : Int (run_spec args))
