(import $test [describe it])
(import [isolated run_spec package_path] ^from "../../support")
(import [page] ^from "../../../src/web/page")
(import [plugin_page] ^from "../../../src/web/plugin_page")

(describe "Compiled feature client contracts"
  (it "checks compiled browser behavior and workspace storage boundaries" []
    (isolated this_mod/.path
      "checks compiled browser behavior and workspace storage boundaries"
      (fn [workspace]
        (let output $"${workspace}/compiled")
        (for entry in ["client/main.gene" "client/plugins/voice.gene"
                      "client/plugins/models_picker.gene" "client/plugins/models_page.gene"
                      "client/plugins/spotlight.gene" "tests/fixtures/broken_browser_client.gene"]
          (let built (await ($os/exec_async ^timeout_ms 30000 ^max_bytes 1048576
            ($os/executable_path) "build" "--target" "web" "--out-dir" output (package_path entry))))
          ($assert (== built/status 0) $"${built/stdout}${built/stderr}"))
        # Build each entry once and run fixtures in independent Node globals.
        (for pair in [["conversation" "main"] ["feature_events" "main"]
                     ["first_submission" "main"] ["media_composer" "media"]
                     ["history_start" "view"] ["host_audio" "host_audio"]
                     ["live_output" "live_output"] ["notifications" "main"]
                     ["session_menu" "session_menu"] ["sidebar_plugin" "sidebar"]
                     ["slack_users" "main"] ["ui_form_success" "main"] ["models_picker" "models_picker"]
                     ["models_page" "models_page"]]
          (let checked (await ($os/exec_async ^timeout_ms 15000 ^max_bytes 1048576
            "node" (package_path $"tests/${pair/0}.mjs") $"${output}/${pair/1}.mjs")))
          ($assert (== checked/status 0) $"${pair/0}: ${checked/stdout}${checked/stderr}"))
        (let voice (await ($os/exec_async ^timeout_ms 15000 ^max_bytes 1048576
          "node" (package_path "tests/voice_client.mjs") $"${output}/voice.mjs" $"${output}/round_client.mjs")))
        ($assert (== voice/status 0) $"voice: ${voice/stdout}${voice/stderr}")
        (let shortcuts (await ($os/exec_async ^timeout_ms 15000 ^max_bytes 1048576
          "node" (package_path "tests/settings_shortcuts.mjs") $"${output}/main.mjs")))
        ($assert (== shortcuts/status 0) $"settings shortcuts: ${shortcuts/stdout}${shortcuts/stderr}")
        (let spotlight (await ($os/exec_async ^timeout_ms 15000 ^max_bytes 1048576
          "node" (package_path "tests/spotlight_client.mjs")
          $"${output}/spotlight.mjs" $"${output}/command_client.mjs" $"${output}/browser_clients.mjs"
          $"${output}/broken_browser_client.mjs")))
        ($assert (== spotlight/status 0) $"spotlight: ${spotlight/stdout}${spotlight/stderr}")
        ($fs/write_text ($path/join output "a.html") (page ^workspace "/workspace/a"))
        ($fs/write_text ($path/join output "b.html") (page ^workspace "/workspace/b"))
        ($fs/write_text ($path/join output "plugins.html") (plugin_page ^workspace "/workspace/a"))
        (let storage (await ($os/exec_async ^timeout_ms 15000 ^max_bytes 1048576
          "node" (package_path "tests/fixtures/workspace_storage.mjs") output)))
        ($assert (== storage/status 0) $"workspace storage: ${storage/stdout}${storage/stderr}")))))

(fn main [args] : Int (run_spec args))
