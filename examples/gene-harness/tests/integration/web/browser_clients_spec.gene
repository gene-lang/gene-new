(import $test [describe it])
(import [isolated run_spec test_service] ^from "../../support")
(import [host_status close_session_service] ^from "../../../src/web/session_service")
(import [set_plugin_enabled] ^from "../../../src/storage/workspace_repair")
(import [validate_browser_client] ^from "../../../src/ui/browser_assets")
(import [spotlight_from] ^from "../../../src/builtin/spotlight")
(import [baseline_profile] ^from "../../../src/profiles/baseline")
(import [open_runtime close_runtime] ^from "../../../src/runtime/bootstrap")
(import [plugin_error row] ^from "../../../src/kernel")

(describe "Harness browser contributions"
  (it "publishes compiled Spotlight assets and withdraws them in recovery or when disabled" []
    (isolated this_mod/.path "publishes compiled Spotlight assets and withdraws them in recovery or when disabled"
      (fn [workspace]
        (let service (test_service ^workspace workspace ^provider (fn [request] "")))
        (try
          (let status (host_status service))
          ($assert (== status/browser_clients/.size 2) ($to_str service/runtime/h/plugin_errors/.get))
          (let client ($first ($filter status/browser_clients (fn [client] (== client/name "spotlight")))))
          ($assert (== client/name "spotlight"))
          ($assert ($str/starts_with? client/url "/"))
          ($assert ($str/ends_with? client/url ".mjs"))
          ($assert (!= client/stylesheet ""))
          (let recovery (host_status ^safe true service))
          ($assert (== recovery/browser_clients/.size 0))
          ($assert (try (validate_browser_client {^name "unsafe" ^url "https://example.com/code.js"}) false catch Any true))
          (set_plugin_enabled service/runtime/workspace service/runtime/h "spotlight" false)
          (let disabled (host_status service))
          ($assert (== disabled/browser_clients/.size 1))
          ($assert (== disabled/browser_clients/0/name "voice"))
          (set_plugin_enabled service/runtime/workspace service/runtime/h "spotlight" true)
          (let restored (host_status service))
          ($assert (== restored/browser_clients/.size 2))
          ($assert (!= (/revision ($first ($filter restored/browser_clients (fn [row] (== row/name "spotlight"))))) client/revision))
        ensure (close_session_service service)))))
  (it "quarantines a missing optional browser source without preventing startup" []
    (isolated this_mod/.path "quarantines a missing optional browser source without preventing startup"
      (fn [workspace]
        (let base (baseline_profile))
        (let broken (spotlight_from $"${workspace}/missing-client.gene"))
        (let plugins [])
        (for plugin in base/plugins
          (plugins .push (if (== plugin/id "spotlight") broken plugin)))
        (set base/plugins plugins)
        (let runtime (open_runtime workspace "default" base))
        (try
          ($assert (! ($absent? (plugin_error runtime/h "spotlight"))))
          ($assert ($absent? (row runtime/h "browser_clients" "spotlight")))
          ($assert (! ($absent? (row runtime/h "commands" "help"))))
        ensure (close_runtime runtime))))))

(fn main [args] : Int (run_spec args))
