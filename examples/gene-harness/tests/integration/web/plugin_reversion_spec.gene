(import $test [describe it])
(import ^from "../../support" [isolated run_spec])
(import ^from "../../web_support" [start_host stop_host cli])
(import ^from "../../../src/runtime/bootstrap" [open_runtime close_runtime])
(import ^from "../../../src/profiles/profile" [Profile])
(import ^from "../../../src/builtin/plugin_admin" [plugin_admin])
(import ^from "../../../src/agents/harness_turn" [evaluate_harness_turn])
(import ^from "../../../src/storage/state" [record_plugin_state])

(fn source [bad]
  ($to_str `(mod plugin
    (import ^from "src/plugin_api.gene" [Plugin PluginHost])
    (type FixtureFailure ^props {^message Str} ^impl [Error])
    (impl Error for FixtureFailure)
    (fn init [descriptor]
      (Plugin ^id "cli_fixture" ^provides [["functions" "cli_value"]]
        ^activate (fn [host]
          (if %bad (fail (FixtureFailure ^message "broken model replacement"))
            (host .PluginHost:contribute "functions"
              {^name "cli_value" ^doc "Read retained state."
               ^fn (fn [] (host .PluginHost:state))}))))))))

(describe "Plugin history CLI"
  (it "reverts a failed model replacement offline and preserves history and application state" []
    (isolated ^timeout_ms 180000 this_mod/.path "reverts a failed model replacement offline and preserves history and application state"
      (fn [root]
        (let runtime (open_runtime root "default" (Profile ^name "seed" ^plugins [(plugin_admin)])))
        (try
          (let first (evaluate_harness_turn ^session "model-session" runtime/h 1 root
            ($to_str "(register_plugin \"cli_fixture\" (quote " (source false) "))")))
          ($assert (== first/composition_changes/0/status "ready"))
          (record_plugin_state runtime/events "workspace" "workspace" "cli_fixture" {^workbook "unchanged"})
          (let second (evaluate_harness_turn ^session "model-session" runtime/h 2 root
            ($to_str "(register_plugin ^^replace \"cli_fixture\" (quote " (source true) "))")))
          ($assert (== second/composition_changes/0/status "error"))
        ensure (close_runtime runtime))
        (let repaired (cli root ["revert" "cli_fixture" "--revision" "1" "--offline"]))
        ($assert (== repaired/revision 3))
        ($assert (== repaired/status "unverified"))
        (let offline (cli root ["history" "cli_fixture" "--offline"]))
        ($assert (== offline/history/0/origin/kind "offline"))
        ($assert (== offline/history/1/origin/kind "model"))
        ($assert (== offline/history/2/origin/kind "model"))
        (let host (start_host root))
        (try
          (let session (cli root ["sessions" "create"]))
          (let value (cli root ["--session" session/id "run" "(cli_value)"]))
          ($assert ($str/contains? value/display "unchanged"))
          (let online (cli root ["history" "cli_fixture" "--limit" "1"]))
          ($assert (== online/history/.size 1))
          ($assert (== online/next_before 3))
          (let stale (cli ^expected 1 root ["revert" "cli_fixture" "--revision" "1" "--expected-revision" "1"]))
          ($assert (== stale/code "stale_composition"))
        ensure (stop_host host))))))

(fn main [args] : Int (run_spec args))
