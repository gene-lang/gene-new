# Tests the settings registry and src/runtime/workspace_config.gene.
(import $test [describe it])
(import [isolated run_spec test_service] ^from "../../support")
(import [close_session_service create_session command operator_receipt client_reply host_status] ^from "../../../src/web/session_service")
(import [Plugin PluginHost ServiceError] ^from "../../../src/plugin_api")
(import [put_cordis_plugin uninstall] ^from "../../../src/kernel")
(import [ui_status] ^from "../../../src/ui/state")
(import [ui_preview] ^from "../../../src/ui/views")
(import [ui_action ui_action_receipt] ^from "../../../src/ui/actions")
(import [effective_setting] ^from "../../../src/runtime/settings_resolver")
(import [shared_settings_path shared_settings_root] ^from "../../../src/runtime/shared_settings")

(fn with_workspace [root : Str, body]
  (let service (test_service ^workspace root ^provider (fn [request] "(Outcome ^^done ^reply \"ok\")")))
  (try
    (body service (/workspace service/runtime/h/objects/.get))
  ensure
    (close_session_service service)))

(fn config_on_disk [service]
  ($serde/read_data ($fs/read_text $"${service/runtime/state_root}/config.gene")))

(describe "Harness settings"
  (it "describes every setting with its value and source" []
    (isolated this_mod/.path "describes every setting with its value and source"
      (fn [root]
        (with_workspace root (fn [service, shown]
          (let listed shown/.settings)
          ($assert (> listed/settings/.size 10))
          ($assert ($present? listed/digest))
          (let limit (shown .setting "turn_limit"))
          ($assert (== limit/value 24))
          ($assert (== limit/default 24))
          ($assert (== limit/applies "next_round"))
          (for view in listed/settings
            ($assert ($present? view/label) view/key)
            ($assert (["default" "workspace" "launch"] .contains? view/source) view/key)))))))

  (it "owns config writes with validation and a revision check" []
    (isolated this_mod/.path "owns config writes with validation and a revision check"
      (fn [root]
        (with_workspace root (fn [service, shown]
          (let before shown/.settings/digest)
          (let saved (shown .set_setting "turn_limit" 7 ^expected before))
          ($assert (== saved/value 7))
          ($assert (== saved/source "workspace"))
          ($assert (== (/turn_limit (config_on_disk service)) 7) "the value reached config.gene")
          (let stale (try (shown .set_setting "turn_limit" 8 ^expected before) "saved" catch Any $err/code))
          ($assert (== stale "revision_conflict") stale)
          (let wrong (try (shown .set_setting "turn_limit" "many") "saved" catch Any $err/code))
          ($assert (== wrong "invalid_request") wrong)
          (let zero (try (shown .set_setting "turn_limit" 0) "saved" catch Any $err/code))
          ($assert (== zero "invalid_request") zero)
          (let unknown (try (shown .set_setting "no_such" 1) "saved" catch Any $err/code))
          ($assert (== unknown "not_found") unknown)
          (let reset (shown .reset_setting "turn_limit"))
          ($assert (== reset/value 24))
          ($assert (== reset/source "default"))
          ($assert ($absent? (/turn_limit (config_on_disk service)))))))))

  (it "applies a saved setting to the next round" []
    (isolated this_mod/.path "applies a saved setting to the next round"
      (fn [root]
        (with_workspace root (fn [service, shown]
          (shown .set_setting "turn_limit" 1)
          (let session (shown .create_session))
          (let admitted (session .submit "go"))
          (let watcher (/watcher (service/runtime/services/values/controller/rounds/.get .get session/id)))
          watcher/.join
          (let finished session/.round)
          ($assert (== (/id finished) admitted/id))
          ($assert (== (/state finished) "done") ($to_str finished)))))))

  (it "lets a plugin add a setting that stays read after the plugin is gone" []
    (isolated this_mod/.path "lets a plugin add a setting that stays read after the plugin is gone"
      (fn [root]
        (with_workspace root (fn [service, shown]
          (put_cordis_plugin service/runtime/h
            (Plugin ^id "setting_probe" ^activate (fn [host]
              (host .PluginHost:contribute "settings"
                {^key "setting_probe/level" ^label "Level" ^group "Probe" ^doc "A probe setting."
                 ^type "int" ^default 3 ^applies "next_round"
                 ^validate (fn [value] (if (> value 9) (fail "too high")))})))
            {})
          ($assert (== (/value (shown .setting "setting_probe/level")) 3))
          ($assert (== (/value (shown .set_setting "setting_probe/level" 5)) 5))
          (let refused (try (shown .set_setting "setting_probe/level" 10) "saved" catch Any "refused"))
          ($assert (== refused "refused"))
          (let probe_group (/settings (shown .settings ^group "Probe")))
          ($assert (== probe_group/.size 1))))))))

(fn action_named [state, id : Str]
  ($first ($filter state/actions (fn [action] (== action/id id)))))

# Stands in for connected tabs: replies as a browser would, or stays silent.
(fn fake_tab [service, answer]
  (set service/clients (fn [] [{^client_id "tab" ^session "" ^!safe}]))
  (service/publisher .set (fn [message]
    (if (== message/type "client/request")
      (answer message/data))
    nil)))

(describe "Harness keyboard actions and browser requests"
  (it "reports bindings, conflicts and sources" []
    (isolated this_mod/.path "reports bindings, conflicts and sources"
      (fn [root]
        (with_workspace root (fn [service, shown]
          (let toggle (action_named shown/.keyboard "view/toggle"))
          ($assert (== toggle/binding "Ctrl+Shift+Space"))
          ($assert (== toggle/source "default"))
          ($assert toggle/conflicts/.empty?)
          (let bound (shown .bind_key "view/toggle" "Shift+Ctrl+KeyK"))
          ($assert (== (/binding (action_named bound "view/toggle")) "Ctrl+Shift+KeyK") "chords normalize")
          ($assert (== (/source (action_named bound "view/toggle")) "override"))
          (let clash (shown .bind_key "view/harness" "Ctrl+Shift+KeyK"))
          ($assert (== (/conflicts (action_named clash "view/harness")) ["view/toggle"]) ($to_str clash))
          (let cleared (shown .clear_key "view/harness"))
          ($assert (== (/binding (action_named cleared "view/harness")) ""))
          (let remaining (/conflicts (action_named cleared "view/toggle")))
          ($assert remaining/.empty?)
          (let restored (shown .restore_key "view/harness"))
          ($assert (== (/binding (action_named restored "view/harness")) "Ctrl+Shift+Digit1"))
          ($assert (== (/source (action_named restored "view/harness")) "default"))
          (let status (host_status service))
          ($assert ($present? status/keyboard))
          (let wrong (try (shown .bind_key "no/such" "KeyK") "bound" catch Any $err/code))
          ($assert (== wrong "not_found") wrong)
          (let bad (try (shown .bind_key "view/toggle" "Hyper+KeyK") "bound" catch Any $err/code))
          ($assert (== bad "invalid_request") bad))))))

  (it "keeps a plugin action's binding while the plugin is disabled" []
    (isolated this_mod/.path "keeps a plugin action's binding while the plugin is disabled"
      (fn [root]
        (with_workspace root (fn [service, shown]
          (put_cordis_plugin service/runtime/h
            (Plugin ^id "key_probe" ^activate (fn [host]
              (host .PluginHost:contribute "keyboard_actions"
                {^id "key_probe/run" ^label "Run" ^doc "Run the probe." ^context "application" ^default "Ctrl+KeyP"})))
            {})
          (shown .bind_key "key_probe/run" "Ctrl+KeyO")
          ($assert (== (/binding (action_named shown/.keyboard "key_probe/run")) "Ctrl+KeyO"))
          (uninstall service/runtime/h "key_probe")
          ($assert ($absent? (action_named shown/.keyboard "key_probe/run")) "a removed plugin's action is gone")
          (let stored (/stored (shown .setting "keyboard_bindings")))
          ($assert (== (stored .get "key_probe/run") "Ctrl+KeyO"))
          (put_cordis_plugin service/runtime/h
            (Plugin ^id "key_probe" ^activate (fn [host]
              (host .PluginHost:contribute "keyboard_actions"
                {^id "key_probe/run" ^label "Run" ^doc "Run the probe." ^context "application" ^default "Ctrl+KeyP"})))
            {})
          ($assert (== (/binding (action_named shown/.keyboard "key_probe/run")) "Ctrl+KeyO") "the binding returns with the plugin"))))))

  (it "asks one connected tab and returns its reply" []
    (isolated this_mod/.path "asks one connected tab and returns its reply"
      (fn [root]
        (with_workspace root (fn [service, shown]
          (fake_tab service (fn [data]
            (client_reply service {^id data/id ^^ok ^result {^active data/operation}})))
          ($assert (== shown/.clients/.size 1))
          ($assert (== (/active (shown .client_view "tab")) "view/state"))
          ($assert (== (/active (shown .navigate_client "tab" "harness")) "view/navigate"))
          ($assert (== (/active (shown .invoke_client_action "tab" "view/toggle")) "action/invoke")))))))

  (it "reports an absent, silent or refusing tab" []
    (isolated this_mod/.path "reports an absent, silent or refusing tab"
      (fn [root]
        (with_workspace root (fn [service, shown]
          ($assert shown/.clients/.empty? "no tab is connected yet")
          (let absent (try (shown .client_view "tab") "answered" catch Any $err/code))
          ($assert (== absent "unavailable") absent)
          (fake_tab service (fn [data] nil))
          (let silent (try (shown .client_request "tab" "view/state" {} ^timeout_ms 50) "answered" catch Any $err/code))
          ($assert (== silent "unavailable") silent)
          ($assert (== ($size service/client_requests/.get) 0) "a timed-out request is forgotten")
          (fake_tab service (fn [data] (client_reply service {^id data/id ^!ok ^error "no"})))
          (let refused (try (shown .client_view "tab") "answered" catch Any $err/code))
          ($assert (== refused "client_error") refused)
          (let late (client_reply service {^id "gone" ^^ok}))
          ($assert late/ok "a late reply is ignored")))))))

(fn manager_of [service]
  (/manager service/runtime/h/objects/.get))

(fn keys_of [listed]
  ($map listed/settings (fn [view] view/key)))

(fn group_names [groups]
  ($map groups (fn [group] group/name)))

(describe "Settings transactions and scopes"
  (it "commits a batch of settings together or not at all" []
    (isolated this_mod/.path "commits a batch of settings together or not at all"
      (fn [root]
        (with_workspace root (fn [service, shown]
          (let before shown/.settings/digest)
          ($assert (== (config_on_disk service) {}) "a new workspace stores no defaults")
          (let bad (try (shown .set_settings {^turn_limit 5 ^trigger_turn_limit "many"} ^expected before) "saved" catch Any $err/code))
          ($assert (== bad "invalid_request") bad)
          ($assert (== (config_on_disk service) {}) "one invalid field saved nothing")
          (let saved (shown .set_settings {^provider "test" ^model "unlisted-model" ^effort "high"} ^expected before))
          ($assert (== saved/settings/.size 3))
          (let disk (config_on_disk service))
          ($assert (&& (== disk/provider "test") (== disk/model "unlisted-model") (== disk/effort "high")) ($to_str disk))
          (let stale (try (shown .set_settings {^turn_limit 3} ^expected before) "saved" catch Any $err/code))
          ($assert (== stale "revision_conflict") stale)
          ($assert ($absent? (/turn_limit (config_on_disk service))) "a stale batch saved nothing")
          (let both (try (shown .set_settings {^turn_limit 3} ^reset ["turn_limit"]) "saved" catch Any $err/code))
          ($assert (== both "invalid_request") both)
          (let orphan (try (shown .set_settings {^model "other"} ^reset ["provider"]) "saved" catch Any $err/code))
          ($assert (== orphan "invalid_request") "a workspace model needs its provider")
          (let effort (try (shown .set_setting "effort" "Extreme!") "saved" catch Any $err/code))
          ($assert (== effort "invalid_request") effort)
          (shown .set_settings {} ^reset ["provider" "model" "effort"] ^expected saved/digest)
          ($assert (== (config_on_disk service) {}) "resetting removes the overrides"))))))

  (it "keeps shared defaults in the manager root, separate from workspace overrides" []
    (isolated this_mod/.path "keeps shared defaults in the manager root, separate from workspace overrides"
      (fn [root]
        (with_workspace ($path/join root "one") (fn [service, shown]
          (let manager (manager_of service))
          (let shared manager/.settings)
          ($assert (== (keys_of shared) ["turn_limit" "trigger_turn_limit" "trigger_timeout_ms" "question_timeout_ms"])
            ($to_str (keys_of shared)))
          (let saved (manager .set_setting "turn_limit" 9 ^expected shared/digest))
          ($assert (== saved/source "shared"))
          ($assert ($fs/exists? (shared_settings_path (shared_settings_root service/runtime))))
          ($assert (== (config_on_disk service) {}) "a shared save never writes config.gene")
          (let inherited (shown .setting "turn_limit"))
          ($assert (== inherited/value 9))
          ($assert (== inherited/source "shared"))
          ($assert (== (effective_setting service/runtime "turn_limit") 9))
          (let own (shown .set_setting "turn_limit" 4))
          ($assert (== own/source "workspace"))
          ($assert (== own/inherited 9))
          ($assert (== (/value manager/.settings/settings/0) 9) "a workspace save never writes shared defaults")
          (shown .reset_setting "turn_limit")
          ($assert (== (/source (shown .setting "turn_limit")) "shared"))
          (let workspace_only (try (manager .set_setting "trigger_concurrency" 3) "saved" catch Any $err/code))
          ($assert (== workspace_only "invalid_request") workspace_only)
          (let keys (try (manager .set_setting "keyboard_bindings" {}) "saved" catch Any $err/code))
          ($assert (== keys "invalid_request") "keyboard bindings stay workspace-only")
          (let mixed (try (manager .set_settings {^turn_limit 5 ^model "other"}) "saved" catch Any $err/message))
          ($assert ($str/contains? mixed "set_default_model") mixed)
          ($assert (== (/value (manager .setting "turn_limit")) 9) "a mixed-store request changed nothing")
          # A second host under the same manager root sees the value on its next read
          # and cannot overwrite a write it has not seen.
          (let digest manager/.settings/digest)
          (with_workspace ($path/join root "two") (fn [other_service, other]
            (let other_manager (manager_of other_service))
            ($assert (== (/value (other .setting "turn_limit")) 9))
            (other_manager .set_setting "trigger_turn_limit" 3 ^expected digest)
            (let late (try (manager .set_setting "turn_limit" 10 ^expected digest) "saved" catch Any $err/code))
            ($assert (== late "revision_conflict") late)
            ($assert (== (/value (shown .setting "trigger_turn_limit")) 3))))
          (manager .reset_setting "turn_limit")
          ($assert (== (/source (shown .setting "turn_limit")) "default")))))))

  (it "keeps false, zero and empty values distinct from inheriting" []
    (isolated this_mod/.path "keeps false, zero and empty values distinct from inheriting"
      (fn [root]
        (with_workspace root (fn [service, shown]
          (put_cordis_plugin service/runtime/h
            (Plugin ^id "value_probe" ^activate (fn [host]
              (host .PluginHost:contribute "settings"
                {^key "value_probe/on" ^label "On" ^group "Probe" ^doc "A probe flag." ^type "bool"
                 ^default true ^applies "next_round" ^scopes ["workspace" "shared"]})
              (host .PluginHost:contribute "settings"
                {^key "value_probe/name" ^label "Name" ^group "Probe" ^doc "A probe name." ^type "str"
                 ^default "default" ^applies "next_round" ^scopes ["workspace" "shared"]})))
            {})
          (let manager (manager_of service))
          (manager .set_settings {^value_probe/on true ^value_probe/name "shared"})
          (shown .set_settings {^value_probe/on false ^value_probe/name ""})
          ($assert (== (/value (shown .setting "value_probe/on")) false))
          ($assert (== (/source (shown .setting "value_probe/on")) "workspace"))
          ($assert (== (/value (shown .setting "value_probe/name")) ""))
          ($assert (== (effective_setting service/runtime "value_probe/on") false))
          (shown .set_settings {} ^reset ["value_probe/on" "value_probe/name"])
          ($assert (== (/value (shown .setting "value_probe/on")) true))
          ($assert (== (/value (shown .setting "value_probe/name")) "shared"))
          ($assert (== (/source (shown .setting "value_probe/name")) "shared")))))))

  (it "reports restart-applied values against the value the running feature started with" []
    (isolated this_mod/.path "reports restart-applied values against the value the running feature started with"
      (fn [root]
        (with_workspace root (fn [service, shown]
          (let idle (shown .setting "idle_timeout_ms"))
          ($assert (== idle/active_known true) ($to_str idle))
          ($assert (== idle/active 600000))
          ($assert (== idle/pending_restart false))
          (let changed (shown .set_setting "idle_timeout_ms" 1000))
          ($assert (== changed/pending_restart true) ($to_str changed))
          ($assert (== changed/active 600000))
          (shown .reset_setting "idle_timeout_ms")
          ($assert (== (/pending_restart (shown .setting "idle_timeout_ms")) false))
          (let computer (shown .setting "computer"))
          ($assert (== computer/active_known false) "a driver that never started reports no running value")
          ($assert ($absent? computer/pending_restart))
          ($assert (== (/applies (shown .setting "keyboard_bindings")) "immediate")))))))

  (it "saves shortcuts against a revision without losing another editor's override" []
    (isolated this_mod/.path "saves shortcuts against a revision without losing another editor's override"
      (fn [root]
        (with_workspace root (fn [service, shown]
          (let start shown/.keyboard)
          ($assert (== (/owner (action_named start "view/toggle")) "core"))
          (let first (shown .bind_key "view/toggle" "Ctrl+KeyJ" ^expected start/digest))
          (let stale (try (shown .bind_key "view/harness" "Ctrl+KeyL" ^expected start/digest) "bound" catch Any $err/code))
          ($assert (== stale "revision_conflict") stale)
          (let fresh (shown .bind_key "view/harness" "Ctrl+KeyL" ^expected first/digest))
          ($assert (== (/binding (action_named fresh "view/toggle")) "Ctrl+KeyJ") "the other editor's override survived")
          ($assert (== (/binding (action_named fresh "view/harness")) "Ctrl+KeyL"))
          (let stale_clear (try (shown .clear_key "view/toggle" ^expected first/digest) "cleared" catch Any $err/code))
          ($assert (== stale_clear "revision_conflict"))
          (let restored (shown .restore_key "view/toggle" ^expected fresh/digest))
          ($assert (== (/source (action_named restored "view/toggle")) "default"))
          ($assert (== (/binding (action_named restored "view/harness")) "Ctrl+KeyL"))
          (shown .restore_key "view/harness" ^expected restored/digest)
          ($assert (== (config_on_disk service) {}) "restoring every shortcut leaves no override")
          ($assert (== (/source (shown .setting "keyboard_bindings")) "default"))))))))

(describe "Settings groups and choices"
  (it "derives groups from settings and contributions, in order" []
    (isolated this_mod/.path "derives groups from settings and contributions, in order"
      (fn [root]
        (with_workspace root (fn [service, shown]
          (let names (group_names shown/.settings_groups))
          (let ordered ($filter names (fn [name] (["General" "Models" "Providers" "Appearance" "Keyboard Shortcuts" "Voice"] .contains? name))))
          ($assert (== ordered ["General" "Models" "Providers" "Appearance" "Keyboard Shortcuts" "Voice"]) ($to_str names))
          (for name in ["Triggers" "Images" "Delegation" "Computer"]
            ($assert (names .contains? name) $"${name} appears from its settings"))
          (let providers ($first ($filter shown/.settings_groups (fn [group] (== group/name "Providers")))))
          ($assert (== providers/section "model_providers"))
          ($assert (== providers/owner "models"))
          (shown .disable_plugin "voice")
          (let voice ($first ($filter shown/.settings_groups (fn [group] (== group/name "Voice")))))
          ($assert ($present? voice) "the Voice group stays while its settings exist")
          ($assert ($absent? voice/section) "a removed plugin's section goes with it")
          (let voices (shown .setting_choices "voice"))
          ($assert ($present? voices/reason))
          (shown .enable_plugin "voice")
          ($assert (== (/section ($first ($filter shown/.settings_groups (fn [group] (== group/name "Voice"))))) "voice_engines")))))))

  (it "offers dependent effort choices and keeps unlisted model ids usable" []
    (isolated this_mod/.path "offers dependent effort choices and keeps unlisted model ids usable"
      (fn [root]
        (with_workspace root (fn [service, shown]
          (let efforts (shown .setting_choices "effort" ^values {^provider "test" ^model "unlisted"}))
          ($assert (== efforts/closed true))
          ($assert (== ($map efforts/options (fn [option] option/value)) ["auto" "none" "minimal" "low" "medium" "high" "xhigh" "max"]))
          (let models (shown .setting_choices "model"))
          ($assert (== models/closed false))
          (let saved (shown .set_settings {^provider "test" ^model "not-in-any-catalog"}))
          ($assert (== (/value (shown .setting "model")) "not-in-any-catalog") "a typed model id is kept")
          ($assert (== (/source (shown .setting "model")) "workspace"))))))))

(fn settings_descriptor [service]
  ($first ($filter (/components (ui_status service/runtime)) (fn [view] (== view/name "settings")))))

(fn tree_has? [tree, test] : Bool
  (if (!= ($head tree) Map) (return false))
  (if (test tree) (return true))
  (for child in (?? tree/children [])
    (if (tree_has? child test) (return true)))
  false)

(fn run_view_action [service, id : Str, function : Str, named]
  (let view (settings_descriptor service))
  (let admitted (ui_action service/runtime/services/values/actions
    {^input_id $"1:${id}" ^generation 1 ^instance "settings" ^component "settings"
     ^revision view/revision ^function function ^function_revision (view/functions .get function)
     ^args [] ^named named}))
  (service/runtime/services/values/actions/watchers/.get .get admitted/input_id; .join)
  (ui_action_receipt service/runtime/services/values/actions admitted/input_id))

(describe "Settings screen"
  (it "is a view even with workspace views off, and disabling it leaves the settings" []
    (isolated this_mod/.path "is a view even with workspace views off, and disabling it leaves the settings"
      (fn [root]
        (with_workspace root (fn [service, shown]
          ($assert ($present? (settings_descriptor service)) "Settings is listed with optional views disabled")
          (shown .disable_plugin "settings")
          ($assert ($absent? (settings_descriptor service)))
          ($assert (> shown/.settings/settings/.size 10) "definitions stay without the screen")
          ($assert (== (/value (shown .set_setting "turn_limit" 6)) 6))
          ($assert ($present? shown/.keyboard/actions))
          ($assert (names_include? (group_names shown/.settings_groups) "General"))
          (shown .enable_plugin "settings")
          ($assert ($present? (settings_descriptor service))))))))

  (it "renders every group in both scopes, sections and the shortcut recorder" []
    (isolated this_mod/.path "renders every group in both scopes, sections and the shortcut recorder"
      (fn [root]
        (with_workspace root (fn [service, shown]
          (for group in (group_names shown/.settings_groups)
            (for scope in ["workspace" "shared"]
              (let rendered (ui_preview service/runtime "settings" {^group group ^scope scope}))
              (let problem (?? rendered/error ""))
              ($assert ($absent? rendered/error) $"${group}/${scope}: ${problem}")))
          (let general (ui_preview service/runtime "settings" {^group "General"}))
          ($assert (tree_has? general/view (fn [node]
            (&& (== node/props/key "value/workspace/response_budget")
                ($str/starts_with? (?? node/props/value "") "{^timeout_ms"))))
            "a map setting is shown as plain Gene data")
          (let providers (ui_preview service/runtime "settings" {^group "Providers"}))
          ($assert (tree_has? providers/view (fn [node] (== node/props/href "/models"))) "Providers links to the Models page")
          (let recording (ui_preview service/runtime "settings" {^group "Keyboard Shortcuts" ^recording "view/toggle"}))
          ($assert ($absent? recording/error) (?? recording/error ""))
          ($assert (tree_has? recording/view (fn [node] ($present? node/props/data-record-chord))) "the recorder field is shown")
          ($assert (tree_has? recording/view (fn [node] (== node/props/data-chord "Ctrl+Shift+Digit1"))) "chords render for platform display")
          (let drafted (ui_preview service/runtime "settings" {^group "Models" ^model_draft "test/draft-model"}))
          ($assert ($absent? drafted/error) (?? drafted/error ""))
          ($assert (tree_has? drafted/view (fn [node] (== node/props/key "models/workspace/test/draft-model")))
            "a changed model draft opens a new editor"))))))

  (it "saves through view actions with the same validation and revisions as messages" []
    (isolated this_mod/.path "saves through view actions with the same validation and revisions as messages"
      (fn [root]
        (with_workspace root (fn [service, shown]
          (let digest shown/.settings/digest)
          (let saved (run_view_action service "save" "settings_save"
            {^scope "workspace" ^key "turn_limit" ^expected digest ^value "7"}))
          ($assert (== saved/status "done") ($to_str saved))
          ($assert (== (/turn_limit (config_on_disk service)) 7))
          (let stale (run_view_action service "stale" "settings_save"
            {^scope "workspace" ^key "turn_limit" ^expected digest ^value "8"}))
          ($assert (== stale/status "failed"))
          ($assert (== stale/error_code "revision_conflict") ($to_str stale))
          (let invalid (run_view_action service "invalid" "settings_save"
            {^scope "workspace" ^key "turn_limit" ^value "0"}))
          ($assert (== invalid/error_code "invalid_request") ($to_str invalid))
          (let budget (run_view_action service "budget" "settings_save"
            {^scope "workspace" ^key "response_budget" ^value "{^timeout_ms 1000 ^max_memory_mb 256}"}))
          ($assert (== budget/status "done") ($to_str budget))
          ($assert (== (/response_budget (config_on_disk service)) {^timeout_ms 1000 ^max_memory_mb 256}))
          (let unreadable (run_view_action service "unreadable" "settings_save"
            {^scope "workspace" ^key "response_budget" ^value "{^timeout_ms"}))
          ($assert (== unreadable/error_code "invalid_request") ($to_str unreadable))
          (let shared_manager (manager_of service))
          (let shared_listing shared_manager/.settings)
          (let shared (run_view_action service "shared" "settings_save"
            {^scope "shared" ^key "question_timeout_ms" ^expected shared_listing/digest ^value "5000"}))
          ($assert (== shared/status "done") ($to_str shared))
          ($assert (== (/value (shown .setting "question_timeout_ms")) 5000))
          (let models (run_view_action service "models" "settings_save_models"
            {^scope "workspace" ^selection "test/picked" ^expected shown/.settings/digest ^effort "low" ^custom ""}))
          ($assert (== models/status "done") ($to_str models))
          (let disk (config_on_disk service))
          ($assert (&& (== disk/provider "test") (== disk/model "picked") (== disk/effort "low")) ($to_str disk))
          (let keys shown/.keyboard)
          (let bound (run_view_action service "bind" "settings_key"
            {^operation "bind" ^id "view/toggle" ^chord "Ctrl+KeyY" ^expected keys/digest}))
          ($assert (== bound/status "done") ($to_str bound))
          ($assert (== (/binding (action_named shown/.keyboard "view/toggle")) "Ctrl+KeyY"))
          (let reset (run_view_action service "reset-models" "settings_reset_models"
            {^scope "workspace" ^expected shown/.settings/digest}))
          ($assert (== reset/status "done") ($to_str reset))
          ($assert ($absent? (/model (config_on_disk service))))))))))

(fn find_node [tree, key : Str]
  (if (!= ($head tree) Map) (return nil))
  (if (== tree/props/key key) (return tree))
  (for child in (?? tree/children [])
    (let found (find_node child key))
    (if ($present? found) (return found)))
  nil)

(fn dependent_choices_plugin []
  (Plugin ^id "zone_probe" ^activate (fn [host]
    (for key in ["zone_probe/region" "zone_probe/zone"]
      (let definition {^key key ^label key ^group "Zones" ^doc "A probe setting." ^type "str"
        ^default "west" ^applies "next_round" ^scopes ["workspace" "shared"]})
      (if (== key "zone_probe/zone") (definition .put "choices" "zone_probe/zones"))
      (host .PluginHost:contribute "settings" definition))
    (host .PluginHost:contribute "setting_choices"
      {^name "zone_probe/zones" ^^closed ^choices (fn [context]
        (let region (?? (context/values .get "zone_probe/region") "west"))
        [{^value region ^label region ^^available}])}))))

# Stands in for a cataloged provider: it keeps the model it is given, so the
# selection rules decide which model's efforts apply. It never sends a request.
(fn catalog_provider_plugin []
  (Plugin ^id "provider_test" ^provides [["providers" "test"]]
    ^activate (fn [host]
      (host .PluginHost:contribute "providers"
        {^name "test" ^doc "Cataloged test provider."
         ^configure (fn [model, effort, timeout] {^model (?? model "plain") ^timeout_ms timeout})
         ^prepare (fn [call] call)
         ^send (fn [call] (fail (ServiceError ^code "unexpected" ^message "No inference in settings specs.")))}))))

(fn use_effort_catalog [service]
  (put_cordis_plugin ^^replace service/runtime/h (catalog_provider_plugin) {})
  (let manager (manager_of service))
  (let configuration manager/.model_configuration)
  (manager .save_model_configuration
    {^version 1 ^default {^provider "test" ^model "plain" ^effort "low"} ^providers [] ^presets []
     ^models [{^provider "test" ^id "native" ^efforts ["low" "ultra"] ^default_effort "low"}
              {^provider "test" ^id "plain" ^efforts ["low"] ^default_effort "low"}]}
    configuration/digest))

(fn section_probe_plugin []
  (Plugin ^id "section_probe" ^activate (fn [host]
    (host .PluginHost:contribute "settings_groups" {^name "Probe collision" ^section "section_probe_collision"})
    (host .PluginHost:contribute "web_components"
      {^name "section_probe_collision" ^slot "settings_section"
       ^render (fn [context] (quote (section ^key "settings" (p "Section content."))))})
    (for name in ["broken_tree" "throwing" "undeclared"]
      (host .PluginHost:contribute "settings_groups" {^name $"Probe ${name}" ^section $"section_probe_${name}"}))
    (host .PluginHost:contribute "web_components"
      {^name "section_probe_broken_tree" ^slot "settings_section"
       ^render (fn [context] (quote (script "invalid component")))})
    (host .PluginHost:contribute "web_components"
      {^name "section_probe_throwing" ^slot "settings_section"
       ^render (fn [context] (fail (ServiceError ^code "broken" ^message "section exploded")))})
    (host .PluginHost:contribute "web_components"
      {^name "section_probe_undeclared" ^slot "settings_section"
       ^render (fn [context] (quote (button ^key "go" ^action "no_such_action" "Go")))}))))

(describe "Settings review regressions"
  (it "keeps a provider-only override when only the effort changes" []
    (isolated this_mod/.path "keeps a provider-only override when only the effort changes"
      (fn [root]
        (with_workspace root (fn [service, shown]
          (shown .set_setting "provider" "test")
          (let rendered (ui_preview service/runtime "settings" {^group "Models"}))
          (let form (find_node rendered/view "models/workspace/test/"))
          ($assert ($present? form) "the provider-only override is its own selection")
          (let named ($thaw ($freeze form/props/args)))
          ($assert (== named/selection "test/"))
          (named .put "effort" "high")
          (named .put "custom" "")
          (let saved (run_view_action service "effort-only" "settings_save_models" named))
          ($assert (== saved/status "done") ($to_str saved))
          ($assert (== (config_on_disk service) {^provider "test" ^effort "high"}) ($to_str (config_on_disk service)))
          (let inherit (run_view_action service "inherit" "settings_save_models"
            {^scope "workspace" ^selection "-" ^saved "test/" ^expected shown/.settings/digest ^effort "" ^custom ""}))
          ($assert (== inherit/status "done") ($to_str inherit))
          ($assert (== (config_on_disk service) {}) "inheriting is an explicit choice"))))))

  (it "checks dependent choices against the saved values they depend on" []
    (isolated this_mod/.path "checks dependent choices against the saved values they depend on"
      (fn [root]
        (with_workspace root (fn [service, shown]
          (put_cordis_plugin service/runtime/h (dependent_choices_plugin) {})
          (let manager (manager_of service))
          (manager .set_settings {^zone_probe/region "east" ^zone_probe/zone "east"})
          ($assert (== (/value (manager .set_setting "zone_probe/zone" "east")) "east") "a later single-field edit sees the saved region")
          (let wrong (try (manager .set_setting "zone_probe/zone" "west") "saved" catch Any $err/code))
          ($assert (== wrong "invalid_request") wrong)
          ($assert (== (/value (manager .setting "zone_probe/zone")) "east"))
          ($assert (== ($map (/options (shown .setting_choices "zone_probe/zone")) (fn [option] option/value)) ["east"])
            "workspace choices see the inherited region")
          ($assert (== (/value (shown .set_setting "zone_probe/zone" "east")) "east"))
          (let drafted (shown .setting_choices "zone_probe/zone" ^values {^zone_probe/region "north"}))
          ($assert (== drafted/options/0/value "north") "drafts lay over the saved values")
          (let shared_form (ui_preview service/runtime "settings" {^group "Zones" ^scope "shared"}))
          ($assert ($absent? shared_form/error) (?? shared_form/error ""))
          ($assert (! ($str/contains? ($json/stringify shared_form/view) "no longer offered"))
            "a valid saved value is offered, not flagged"))))))

  (it "accepts a native effort the selected model advertises and rejects others" []
    (isolated this_mod/.path "accepts a native effort the selected model advertises and rejects others"
      (fn [root]
        (with_workspace root (fn [service, shown]
          (use_effort_catalog service)
          (shown .set_settings {^provider "test" ^model "native" ^effort "ultra"})
          ($assert (== (/effort (config_on_disk service)) "ultra"))
          (let efforts (shown .setting_choices "effort"))
          ($assert (== efforts/complete true))
          ($assert (($map efforts/options (fn [option] option/value)) .contains? "ultra") "the native level is offered")
          (let unsupported (try (shown .set_setting "effort" "turbo") "saved" catch Any $err/code))
          ($assert (== unsupported "invalid_request") "a level the model does not advertise is refused")
          (let malformed (try (shown .set_setting "effort" "Turbo!") "saved" catch Any $err/code))
          ($assert (== malformed "invalid_request"))
          (let rendered (ui_preview service/runtime "settings" {^group "Models"}))
          ($assert ($str/contains? ($json/stringify rendered/view) "\"ultra\"") "the editor offers the saved native level"))))))

  (it "judges effort against the model a reset or provider default selects" []
    (isolated this_mod/.path "judges effort against the model a reset or provider default selects"
      (fn [root]
        (with_workspace root (fn [service, shown]
          (use_effort_catalog service)
          (shown .set_settings {^provider "test" ^model "native" ^effort "ultra"})
          (let inherited (shown .setting_choices "effort" ^values {^provider "" ^model ""}))
          ($assert (== inherited/complete true) ($to_str inherited))
          ($assert (! (($map inherited/options (fn [option] option/value)) .contains? "ultra"))
            "following the selection order offers the shared default model's efforts")
          (let switched (try (shown .set_settings {^effort "ultra"} ^reset ["provider" "model"]) "saved" catch Any $err/code))
          ($assert (== switched "invalid_request") "switching to an inherited model without ultra is refused")
          ($assert (== (/model (config_on_disk service)) "native") "the refused save changed nothing")
          (shown .set_settings {} ^reset ["provider" "model" "effort"])
          (let defaulted (try (shown .set_settings {^provider "test" ^effort "ultra"}) "saved" catch Any $err/code))
          ($assert (== defaulted "invalid_request") "a provider alone is judged by its default model")
          (shown .set_settings {^provider "test" ^effort "low"})
          ($assert (== (/effort (config_on_disk service)) "low"))
          (let selection shown/.model_selection)
          ($assert ($absent? selection/reason) (?? selection/reason ""))
          ($assert (== selection/model "plain")))))))

  (it "shows a broken section inside its group and keeps the rest of Settings" []
    (isolated this_mod/.path "shows a broken section inside its group and keeps the rest of Settings"
      (fn [root]
        (with_workspace root (fn [service, shown]
          (put_cordis_plugin service/runtime/h (section_probe_plugin) {})
          (for name in ["broken_tree" "throwing" "undeclared" "collision"]
            (let rendered (ui_preview service/runtime "settings" {^group $"Probe ${name}"}))
            (let problem (?? rendered/error ""))
            ($assert ($absent? rendered/error) $"${name}: ${problem}")
            ($assert ($present? (find_node rendered/view $"section-error/section_probe_${name}"))
              $"${name} failed inside its section")
            ($assert ($present? (find_node rendered/view "scope-shared")) $"${name}: the rest of Settings rendered"))))))))

(fn names_include? [names, name : Str] : Bool
  (names .contains? name))

(fn main [args] : Int (run_spec args))
