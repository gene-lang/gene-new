(import $test [describe it])
(import [isolated run_spec test_controller] ^from "../../support")
(import [Profile] ^from "../../../src/profiles/profile")
(import [Plugin PluginHost OperatorHost] ^from "../../../src/plugin_api")
(import [open_runtime close_runtime] ^from "../../../src/runtime/bootstrap")
(import [uninstall row] ^from "../../../src/kernel")
(import [assemble_instructions] ^from "../../../src/agents/instructions")
(import [submit_command command_receipt] ^from "../../../src/runtime/commands")
(import [submit_round round_receipt close_round_controller] ^from "../../../src/runtime/round_controller")
(import [participant_quarantine quarantine_participant] ^from "../../../src/storage/participant_health")

(describe "Profile plugin contract"
  (it "uses public activation prompt command and cleanup contexts with host policy" []
    (isolated this_mod/.path
      "uses public activation prompt command and cleanup contexts with host policy"
      (fn [root]
        (let removed ($cell false))
        (let deactivated ($cell false))
        (let plugin (Plugin ^id "profile_probe" ^activate (fn [host]
          ($assert ($absent? host/h))
          ($assert ($absent? host/effects))
          (let operator (host .PluginHost:resolve "operator/host"))
          (host .PluginHost:create_registry {^name "profile_rows" ^^unique ^key "name"
            ^on_remove (fn [receiver value]
              ($assert ($absent? receiver/h))
              ($assert (! ($absent? receiver/.PluginHost:execution_budget)))
              (removed .set true))})
          (host .PluginHost:contribute "profile_rows" {^name "owned"})
          (host .PluginHost:contribute "prompt" {^name "profile_prompt"
            ^render (fn [context session]
              ($assert ($absent? context/h))
              ($assert ($absent? context/runtime))
              ($assert (try (context .put "workspace_root" "forged") false catch Any true))
              "Public profile prompt.")})
          (host .PluginHost:contribute "commands" {^name "profile_probe" ^doc "Check public command context."
            ^run (fn [context]
              ($assert ($absent? context/manager))
              ($assert ($absent? context/runtime))
              ($assert (== ($head context/snapshot/composition_revision) Int))
              (operator .OperatorHost:command "run" context))}))
          ^deactivate (fn [host]
            ($assert ($absent? host/h))
            ($assert (! ($absent? host/.PluginHost:execution_budget)))
            (deactivated .set true))))
        (let runtime (open_runtime root "default" (Profile ^name "contract" ^plugins [plugin])))
        (try
          ($assert (== (/host (runtime/h/plugin_policies/.get .get "profile_probe")) true))
          ($assert ($str/contains? (assemble_instructions runtime {^kind "interactive"}) "Public profile prompt."))
          (let submitted (submit_command runtime/services/values/commands "default" "/profile_probe (+ 20 22)"))
          (let watcher (runtime/services/values/commands/watchers/.get .get $"default:${submitted/id}"))
          ($assert (== ($head watcher/.join) TaskOutcome/ok))
          (let receipt (command_receipt runtime/services/values/commands "default" submitted/id))
          ($assert (== receipt/item/value "42") ($to_str receipt))
          (uninstall runtime/h "profile_probe")
          ($assert removed/.get)
          ($assert deactivated/.get)
        ensure (close_runtime runtime))))))

(describe "Profile participant policy"
  (it "keeps a public profile participant mandatory despite matching stored quarantine data" []
    (isolated this_mod/.path
      "keeps a public profile participant mandatory despite matching stored quarantine data"
      (fn [root]
        (let entered ($cell 0))
        (let plugin (Plugin ^id "profile_fault" ^activate (fn [host]
          ($assert ($absent? host/h))
          (host .PluginHost:contribute "turn_participants" {^name "profile_fault/check"
            ^begin (fn [context state value]
              (entered .set (+ entered/.get 1))
              (fail "Mandatory profile participant failed."))}))))
        (let runtime (open_runtime root "default" (Profile ^name "mandatory" ^plugins [plugin])))
        (let definition (row runtime/h "turn_participants" "profile_fault/check"))
        (let quarantine {^digest definition/_source_digest ^message "Stored fault."})
        (quarantine_participant runtime/workspace "profile_fault" quarantine)
        (let controller (test_controller runtime (fn [request] "(Outcome ^^done ^reply \"Unexpected model call.\")")))
        (try
          (for sequence in [1 2]
            (let submitted (submit_round controller "default" $"mandatory-${sequence}" sequence "Run."))
            (let watcher (/watcher (controller/rounds/.get .get "default")))
            watcher/.join
            (let receipt (round_receipt controller "default" submitted/id))
            ($assert (== receipt/state "failed") ($to_str receipt)))
          ($assert (== entered/.get 2))
          ($assert (== (participant_quarantine runtime/workspace "profile_fault") quarantine))
        ensure (close_round_controller controller) (close_runtime runtime))))))

(fn main [args] : Int (run_spec args))
