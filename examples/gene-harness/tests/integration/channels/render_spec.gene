(import $test [describe it])
(import [run_spec] ^from "../../support")
(import [render_reply transcript_reference] ^from "../../../src/channels/render")

(describe "Slack output rendering"
  (it "renders Markdown and mrkdwn while keeping literal controls inert and images in the transcript" []
    (let text "# Result\n**Done** & <@U123> <!here>\n[Docs](https://example.com/a?b=1&c=2)\n![Logo](/api/v1/media/asset_1)\n![Other](https://example.com/a.png)")
    (let parts (render_reply text "session-1"))
    (let body parts/0/text)
    ($assert (body .contains? "*Result*"))
    ($assert (body .contains? "*Done* &amp; &lt;@U123&gt; &lt;!here&gt;"))
    ($assert (body .contains? "<https://example.com/a?b=1&amp;c=2|Docs>"))
    ($assert (body .contains? "Logo (image available in Harness session session-1)"))
    ($assert (! (body .contains? "/api/v1/media")))
    ($assert (body .contains? "![Other](https://example.com/a.png)"))
    ($assert parts/0/blocks/0/text/verbatim)
    (let native (render_reply text "session-1" ^surface "markdown" ^public_url "https://harness.example.com/"))
    ($assert (native/0/text .contains? "# Result"))
    ($assert (== native/0/blocks/0/type "markdown"))
    ($assert (native/0/text .contains? "https://harness.example.com/?session=session-1"))
    ($assert (== (transcript_reference "session-1" "http://localhost:8580") "Harness session session-1"))
    ($assert (== (transcript_reference "session-1" "https://harness.example.com/#token=private") "Harness session session-1")))

  (it "splits long Unicode code fences and preserves ordinary link boundaries in order" []
    (let long [])
    (repeat 250 (long .push "雪 and code"))
    (let text ($to_str "Intro\n```gene\n" ($str/join long "\n") "\n```\n[docs](https://example.com/reference) end"))
    (let parts (render_reply text "session-1" ^max_bytes 256))
    ($assert (> parts/.size 5))
    (for part in parts
      ($assert (<= part/text/.byte_size 256))
      (var open false)
      (for marker in ($into ($regex/find_all #"```" part/text) []) (set open (! open)))
      ($assert (! open))
      ($assert (== part/blocks/0/text/text part/text)))
    (let body ($str/join ($map parts /text) "\n"))
    ($assert (body .contains? "<https://example.com/reference|docs>"))
    ($assert (body .ends_with? " end"))
    ($assert (== ($size ($into ($regex/find_all #"雪 and code" body) [])) 250))))

(fn main [args] : Int (run_spec args))
