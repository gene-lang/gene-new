(import $test [describe it])
(import [isolated run_spec test_service] ^from "../../support")
(import [close_session_service] ^from "../../../src/web/session_service")
(import [configure_account configure_route] ^from "../../../src/channels/authority")
(import [bind_workspace] ^from "../../../src/channels/service")
(import [channel_request] ^from "../../../src/channels/http")
(import [open_users lookup_user profile_name thread_url] ^from "../../../src/channels/users")
(import [ChannelError] ^from "../../../src/channels/model")
(import [message_after?] ^from "../../../src/channels/model")
(import [last_thread_message] ^from "../../../src/channels/thread_links")
(import [mutate] ^from "../../../src/channels/store")

(fn response [body, ^status status = 200, ^headers headers = []]
  {^status status ^headers headers ^body ($binary/from_str ($json/stringify body))})

(fn fixture [workspace, body]
  (let service (test_service ^workspace workspace ^without_plugins ["slack"]
    ^provider (fn [request] "(Outcome ^^done ^reply \"Done.\")")))
  (try
    (let filename ($path/join workspace "fake-slack-credentials"))
    ($fs/write_text filename "Bot user oauth token: xoxb-test\nApp token: xapp-test\nChannel id: C12345678\n")
    (configure_account service/runtime/channels/owner "dobi" filename "/fake-adapter"
      {^team "T123" ^app "A123" ^bot "B123" ^bot_user "UBOT" ^operator "UOWNER"})
    (let route (configure_route service/runtime/channels/owner "dobi" "C123" workspace))
    (bind_workspace service/runtime/channels workspace route/id)
    (body service/runtime/channels)
  ensure (close_session_service service)))

(describe "Slack user names"
  (it "selects the newest stored conversation message and excludes progress and unconfirmed sends" []
    (let source {^account "dobi" ^team "T123" ^channel "C123" ^thread "1.000001" ^last_message "8.000001"})
    (let latest (last_thread_message
      {^messages {^incoming {^message (source .assoc "message" "9.000001")}}
       ^deliveries {^posted {^intent (source .assoc "mode" "post") ^parts [{^status "sent" ^ts "10.000001"}]}
                    ^working {^intent (source .assoc "mode" "progress") ^parts [{^status "sent" ^ts "99.000001"}]}
                    ^unknown {^intent (source .assoc "mode" "post") ^parts [{^status "uncertain" ^ts "88.000001"}]}
                    ^elsewhere {^intent (source .assoc "mode" "post"; .assoc "thread" "2.000001")
                                ^parts [{^status "sent" ^ts "77.000001"}]}}} source))
    ($assert (== latest "10.000001"))
    ($assert (message_after? "10.000001" "9.999999"))
    ($assert (! (message_after? "1.1" "1.100000")))
    ($assert (== (last_thread_message {} source) "8.000001")))

  (it "keeps thread links on Slack and bound to the exact channel and root message" []
    (let root "https://example.slack.com/archives/C123/p1000001")
    (let expected ($to_str root "?thread_ts=1.000001&cid=C123"))
    ($assert (== (thread_url root "C123" "1.000001") expected))
    ($assert (== (thread_url "https://example.slack.com/archives/C123/p2000001"
      "C123" "1.000001" ^message "2.000001")
      "https://example.slack.com/archives/C123/p2000001?thread_ts=1.000001&cid=C123"))
    ($assert (== (thread_url ($to_str root "?thread_ts=other") "C123" "1.000001") expected))
    (for url in ["https://example.com/archives/C123/p1000001"
      "https://example.slack.com/archives/COTHER/p1000001"
      "https://example.slack.com/archives/C123/p2000001" "javascript:alert(1)"]
      ($assert (== (thread_url url "C123" "1.000001") ""))))

  (it "resolves and caches a session thread permalink through the connection owner" []
    (isolated this_mod/.path "resolves and caches a session thread permalink through the connection owner"
      (fn [workspace]
        (fixture workspace (fn [channels]
          (let calls ($cell 0))
          (set channels/users (open_users ^requester (fn [request]
            (calls .set (+ calls/.get 1))
            ($assert (== request/method "chat.getPermalink"))
            ($assert (== request/http_method "GET"))
            ($assert (== request/params {^channel "C123" ^message_ts "1.000001"}))
            (response {^^ok ^channel "C123" ^permalink "https://example.slack.com/archives/C123/p1000001"}))))
          (let input {^account "dobi" ^team "T123" ^channel "C123" ^thread "1.000001"})
          (for index in [1 2]
            ($assert (== (/body/url (channel_request channels "POST" "/api/v8/channels/thread" input))
              "https://example.slack.com/archives/C123/p1000001?thread_ts=1.000001&cid=C123")))
          ($assert (== calls/.get 1))
          ($assert (try (channel_request channels "POST" "/api/v8/channels/thread"
            (input .assoc "channel" "COTHER")) false catch ChannelError (== $err/code "forbidden")))
          (mutate channels/owner (fn [state]
            (state/deliveries .put "new-reply"
              {^intent (input .assoc "mode" "post") ^parts [{^status "sent" ^ts "2.000001"}]})))
          (set channels/users/requester (fn [request]
            (calls .set (+ calls/.get 1))
            ($assert (== request/params/message_ts "2.000001"))
            (response {^^ok ^channel "C123" ^permalink "https://example.slack.com/archives/C123/p2000001"})))
          ($assert (== (/body/url (channel_request channels "POST" "/api/v8/channels/thread" input))
            "https://example.slack.com/archives/C123/p2000001?thread_ts=1.000001&cid=C123"))
          ($assert (== calls/.get 2)))))))

  (it "resolves and caches the configured channel name without accepting another channel" []
    (isolated this_mod/.path "resolves and caches the configured channel name without accepting another channel"
      (fn [workspace]
        (fixture workspace (fn [channels]
          (let calls ($cell 0))
          (set channels/users (open_users ^requester (fn [request]
            (calls .set (+ calls/.get 1))
            ($assert (== request/method "conversations.info"))
            ($assert (== request/http_method "GET"))
            ($assert (== request/params/channel "C123"))
            (response {^^ok ^channel {^id "C123" ^name "team-dobi"}}))))
          (let input {^account "dobi" ^team "T123" ^channel "C123"})
          (for index in [1 2]
            ($assert (== (/body/name (channel_request channels "POST" "/api/v8/channels/channel" input)) "team-dobi")))
          ($assert (== calls/.get 1))
          ($assert (try (channel_request channels "POST" "/api/v8/channels/channel"
            (input .assoc "channel" "COTHER")) false catch ChannelError (== $err/code "forbidden")))
          ($assert (== calls/.get 1)))))))

  (it "keeps channel names available when user-profile permission is missing" []
    (isolated this_mod/.path "keeps channel names available when user-profile permission is missing"
      (fn [workspace]
        (fixture workspace (fn [channels]
          (let calls ($cell []))
          (set channels/users (open_users ^requester (fn [request]
            (calls/.get .push request/method)
            (if (== request/method "users.info")
              (response {^!ok ^error "missing_scope"})
              (response {^^ok ^channel {^id "C123" ^name "team-dobi"}})))))
          ($assert (== (/body/name (channel_request channels "POST" "/api/v8/channels/user"
            {^account "dobi" ^team "T123" ^author "UOWNER"})) ""))
          ($assert (== (/body/name (channel_request channels "POST" "/api/v8/channels/channel"
            {^account "dobi" ^team "T123" ^channel "C123"})) "team-dobi"))
          ($assert (== calls/.get ["users.info" "conversations.info"])))))))

  (it "prefers full names and falls back through optional profile fields" []
    ($assert (== (profile_name {^profile {^real_name " Guoliang Cao " ^display_name "gcao"}}) "Guoliang Cao"))
    ($assert (== (profile_name {^real_name "Full name"}) "Full name"))
    ($assert (== (profile_name {^profile {^real_name " " ^display_name "Display name"}}) "Display name"))
    ($assert (== (profile_name {^name "username"}) "username"))
    ($assert (== (profile_name {^profile {^real_name 42}}) "")))

  (it "resolves old transcript identities through the workspace endpoint and caches by account and team" []
    (isolated this_mod/.path "resolves old transcript identities through the workspace endpoint and caches by account and team"
      (fn [workspace]
        (fixture workspace (fn [channels]
          (let calls ($cell 0))
          (set channels/users (open_users ^requester (fn [request]
            (calls .set (+ calls/.get 1))
            ($assert (== request/method "users.info"))
            ($assert (== request/http_method "GET"))
            ($assert (== request/params/user "UOWNER"))
            ($assert (== request/headers/authorization "Bearer xoxb-test"))
            (response {^^ok ^user {^id "UOWNER" ^profile {^real_name "Guoliang Cao"}}}))))
          (let input {^account "dobi" ^team "T123" ^author "UOWNER"})
          (for index in [1 2]
            (let result (channel_request channels "POST" "/api/v8/channels/user" input))
            ($assert (== result/body/name "Guoliang Cao")))
          ($assert (== calls/.get 1))
          ($assert (try (lookup_user channels/users channels/owner (input .assoc "team" "TOTHER")) false
            catch ChannelError (== $err/code "forbidden")))
          ($assert (try (channel_request channels "POST" "/api/v8/channels/user"
            (input .assoc "account" "other")) false catch ChannelError (== $err/code "forbidden")))
          ($assert (== calls/.get 1)))))))

  (it "keeps names optional when scopes are missing and backs off across users" []
    (isolated this_mod/.path "keeps names optional when scopes are missing and backs off across users"
      (fn [workspace]
        (fixture workspace (fn [channels]
          (let calls ($cell 0))
          (let users (open_users ^requester (fn [request]
            (calls .set (+ calls/.get 1)) (response {^!ok ^error "missing_scope"}))))
          (for author in ["UOWNER" "UOTHER" "UOWNER"]
            ($assert (== (/name (lookup_user users channels/owner
              {^account "dobi" ^team "T123" ^author author})) "")))
          ($assert (== calls/.get 1)))))))

  (it "rejects mismatched Slack identities without failing the transcript" []
    (isolated this_mod/.path "rejects mismatched Slack identities without failing the transcript"
      (fn [workspace]
        (fixture workspace (fn [channels]
          (let users (open_users ^requester (fn [request]
            (response {^^ok ^user {^id "UOTHER" ^profile {^real_name "Wrong person"}}}))))
          ($assert (== (/name (lookup_user users channels/owner
            {^account "dobi" ^team "T123" ^author "UOWNER"})) ""))))))))

(fn main [args] : Int (run_spec args))
