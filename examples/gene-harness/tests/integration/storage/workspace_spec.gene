# Tests src/storage/workspace.gene.
(import $test [describe it])
(import [isolated run_spec] ^from "../../support")
(import [open_runtime close_runtime] ^from "../../../src/runtime/bootstrap")
(import [Profile] ^from "../../../src/profiles/profile")
(import [plugin_admin] ^from "../../../src/builtin/plugin_admin")
(import [Plugin PluginHost] ^from "../../../src/plugin_api")
(import [row] ^from "../../../src/kernel")
(import [set_plugin_enabled restore_plugin register_plugin doctor enable_entry composition_entries
         composition_revision commit_composition prepare_workspace]
  ^from "../../../src/storage/workspace")
(import [evaluate_harness_turn] ^from "../../../src/agents/harness_turn")

(fn ping_source []
  ($to_str
    (quote
      (mod plugin
        (import ^from "src/plugin_api.gene" [Plugin PluginHost])
        (fn init [descriptor]
          (Plugin ^id "example" ^provides [["functions" "ping"]]
            ^activate (fn [host]
              (host .PluginHost:contribute "functions"
                {^name "ping" ^doc "Respond." ^fn (fn [] "pong")}))))))))

(describe "Built-in plugin lifecycle"
  (it "persists disable, enable and restore across restart"
    []
    (isolated this_mod/.path "persists disable, enable and restore across restart"
      (fn [workspace]
        (let root ($fs/real_path workspace))
        (let profile
          (Profile ^name "test"
            ^plugins [(Plugin ^id "built" ^provides [["functions" "marker"]]
              ^activate (fn [host]
                (host .PluginHost:contribute "functions"
                  {^name "marker" ^doc "Profile marker." ^fn (fn [] "built")})))
              (plugin_admin)]))
        (let replacement
          ($to_str
            (quote
              (mod plugin
                (import ^from "src/plugin_api.gene" [Plugin PluginHost])
                (fn init [descriptor]
                  (Plugin ^id "built" ^provides [["functions" "marker"]]
                    ^activate (fn [host]
                      (host .PluginHost:contribute "functions"
                        {^name "marker" ^doc "Stored marker." ^fn (fn [] "stored")}))))))))
        (let disabled_revision ($cell nil))
        (let first (open_runtime root "default" profile))
        (try
          ($assert (!= (row first/h "functions" "marker") void) "profile function missing")
          (let disabled (set_plugin_enabled first/workspace first/h "built" false))
          (disabled_revision .set disabled/revision)
          ($assert (== disabled/status "disabled") "disable did not report its state")
          ($assert (== (row first/h "functions" "marker") void)
            "disabled built-in remained visible")
          (let records (composition_entries first/workspace))
          ($assert (== records/0/builtin true)
            "disable did not write a built-in record")
        ensure
          (close_runtime first))
        (let restarted (open_runtime root "default" profile))
        (try
          ($assert (== (composition_revision restarted/workspace) disabled_revision/.get)
            "clean restart changed the desired composition")
          ($assert (== (row restarted/h "functions" "marker") void)
            "disabled built-in reappeared after restart")
          ($assert ($str/contains? ($to_str (doctor restarted/workspace)) "built-in disabled")
            "doctor did not name the disabled default")
        ensure
          (close_runtime restarted))
        (let recovery (open_runtime ^^activate root "default" profile))
        (try
          ($assert (== (composition_revision recovery/workspace) disabled_revision/.get)
            "recovery boot wrote a composition generation")
          ($assert (! ($str/contains? ($to_str (doctor recovery/workspace))
                        "reconciliation pending"))
            "inactive doctor reported a false reconciliation gap")
          (enable_entry recovery/workspace "built")
          ($assert ($str/contains? ($to_str (doctor recovery/workspace))
                     "reconciliation pending")
            "doctor missed a desired change awaiting activation")
        ensure
          (close_runtime recovery))
        (let enabled (open_runtime root "default" profile))
        (try
          ($assert (== (composition_revision enabled/workspace) (+ disabled_revision/.get 1))
            "enable did not make exactly one composition change")
          (let result (evaluate_harness_turn enabled/h 1 root
            "(Outcome ^done true ^reply (marker))"))
          ($assert (== result/validated/outcome/reply "built")
            "recovery enable did not restore the default")
          (let stored (register_plugin ^replace true enabled/workspace enabled/h "built" replacement))
          ($assert (== stored/status "ready") "stored replacement did not activate")
          (let restored_turn (evaluate_harness_turn enabled/h 2 root
            "(append_prompt \"restore\" (restore_plugin \"built\")) (Outcome ^prompt \"continue\")"))
          ($assert (== restored_turn/composition_changes/0/status "ready")
            "turn restore did not activate the default")
          ($assert (== (composition_entries enabled/workspace) [])
            "restore left a stored override")
          ($assert
            (try
              (restore_plugin enabled/workspace enabled/h "missing")
              false
            catch Any
              ($str/contains? $err/message "no profile default"))
            "restore silently removed an id without a profile default")
        ensure
          (close_runtime enabled))
        (let final_runtime (open_runtime root "default" profile))
        (try
          (let final_result (evaluate_harness_turn final_runtime/h 2 root
            "(Outcome ^done true ^reply (marker))"))
          ($assert (== final_result/validated/outcome/reply "built")
            "restored default did not survive restart")
        ensure
          (close_runtime final_runtime))))))

(describe "Profile and stored plugin admission"
  (it "requires explicit replacement and isolates a legacy id clash"
    []
    (isolated this_mod/.path "requires explicit replacement and isolates a legacy id clash"
      (fn [workspace]
        (let root ($fs/real_path workspace))
        (let profile
          (Profile ^name "test"
            ^plugins [(Plugin ^id "web" ^provides [["functions" "marker"]]
              ^activate (fn [host]
                (host .PluginHost:contribute "functions"
                  {^name "marker" ^doc "Profile marker." ^fn (fn [] "profile")})))]))
        (let replacement
          ($to_str
            (quote
              (mod plugin
                (import ^from "src/plugin_api.gene" [Plugin PluginHost])
                (fn init [descriptor]
                  (Plugin ^id "web" ^provides [["functions" "marker"]]
                    ^activate (fn [host]
                      (host .PluginHost:contribute "functions"
                        {^name "marker" ^doc "Stored marker." ^fn (fn [] "stored")}))))))))
        (let sibling
          ($to_str
            (quote
              (mod plugin
                (import ^from "src/plugin_api.gene" [Plugin PluginHost])
                (fn init [descriptor]
                  (Plugin ^id "other" ^provides [["functions" "sibling"]]
                    ^activate (fn [host]
                      (host .PluginHost:contribute "functions"
                        {^name "sibling" ^doc "Independent function." ^fn (fn [] "other")}))))))))
        (let first (open_runtime root "default" profile))
        (try
          ($assert
            (try
              (register_plugin first/workspace first/h "web" replacement)
              false
            catch Any
              ($str/contains? $err/message "use ^replace true"))
            "profile id was claimed without explicit replacement")
          (let replaced (register_plugin ^replace true first/workspace first/h "web" replacement))
          ($assert (== replaced/status "ready") $"explicit replacement failed: ${replaced}")
          (let added (register_plugin first/workspace first/h "other" sibling))
          ($assert (== added/status "ready") $"sibling registration failed: ${added}")
        ensure
          (close_runtime first))
        (let restarted (open_runtime root "default" profile))
        (try
          (let result (evaluate_harness_turn restarted/h 1 root
            "(Outcome ^done true ^reply ($to_str [(marker) (sibling)]))"))
          ($assert
            (&& ($str/contains? result/validated/outcome/reply "stored")
                ($str/contains? result/validated/outcome/reply "other"))
            $"stored replacement did not survive restart: ${result/validated/outcome/reply}; ${result/error}")
        ensure
          (close_runtime restarted))
        # Simulate a pre-change store whose id collides without a replacement
        # operation. The profile wins, but the independent stored entry loads.
        (let recovery (open_runtime ^^activate root "default" profile))
        (try
          (let entries (composition_entries recovery/workspace))
          (for entry in entries
            (if (== entry/id "web") (entry .delete "replaces_builtin")))
          (commit_composition recovery/workspace entries)
        ensure
          (close_runtime recovery))
        (let collided (open_runtime root "default" profile))
        (try
          (let legacy_result (evaluate_harness_turn collided/h 2 root
            "(Outcome ^done true ^reply ($to_str [(marker) (sibling)]))"))
          ($assert
            (&& ($str/contains? legacy_result/validated/outcome/reply "profile")
                ($str/contains? legacy_result/validated/outcome/reply "other"))
            $"legacy clash blocked the profile or sibling: ${legacy_result/validated/outcome/reply}; ${legacy_result/error}")
          ($assert
            ($str/contains? ($to_str (doctor collided/workspace)) "collides with a profile")
            "doctor did not name the legacy clash")
        ensure
          (close_runtime collided))))))

(describe "Harness plugins"
  (it "shares only the API while allowing direct activation, I/O and explicit session state" []
    (isolated this_mod/.path "shares only the API while allowing direct activation, I/O and explicit session state"
      (fn [workspace]
        ($fs/make_dir workspace)
        (let root ($fs/real_path workspace))
        (let runtime (open_runtime ^^activate root "default"
          (Profile ^name "test" ^plugins [(plugin_admin)])))
        (try
          (let source
            (quote
              (mod plugin
                (import ^from "src/plugin_api.gene" [Plugin PluginHost append_prompt])
                (fn init [descriptor]
                  (Plugin ^id "io_plugin" ^provides [["functions" "write_marker"]] ^activate (fn [host] (host .PluginHost:contribute "functions" {^name "write_marker" ^doc "Write a marker through the standard library." ^fn (fn [path : Str text : Str] ($fs/write_text path text) (append_prompt "written" text) (host ^session "s1" .PluginHost:update_state {^last text}))})))))))
          (let registered (register_plugin runtime/workspace runtime/h "io_plugin" ($to_str source)))
          ($assert (== registered/status "ready") $"plugin activation failed: ${registered}")
          (var entries (composition_entries runtime/workspace))
          ($assert (== entries/0/scope void) "entry retained a plugin scope")
          (let result
            (evaluate_harness_turn ^session "s1"
              runtime/h
              1
              root
              "(write_marker \"marker.txt\" \"direct I/O\") (Outcome ^prompt \"continue\")"))
          ($assert (== result/kind "continue") $"code response failed: ${result/error}")
          ($assert (== ($fs/read_text "marker.txt") "direct I/O") "plugin could not use fs directly")
          ($assert
            ($str/contains? result/request "fn write_marker")
            "append_prompt lost function correlation")
          (let policy (runtime/h/plugin_policies .get; .get "io_plugin"))
          (let host policy/context)
          ($assert (== host/.PluginHost:state nil) "explicit session state leaked into workspace state")
          ($assert
            (== (host ^session "s1" .PluginHost:state) {^last "direct I/O"})
            "session state was not immediate")
          (host .PluginHost:update_state {^^shared})
          ($assert (== host/.PluginHost:state {^^shared}) "workspace state was not the default")
          ($assert (== (host ^session "s2" .PluginHost:state) nil) "session state leaked across sessions")
          (let queued_source
            (quote
              (mod plugin
                (import ^from "src/plugin_api.gene" [Plugin PluginHost])
                (fn init [descriptor]
                  (Plugin ^id "queued" ^activate (fn [host] (host .PluginHost:contribute "functions" {^name "ping" ^doc "Queued function." ^fn (fn [] "pong")})))))))
          (let queued
            (evaluate_harness_turn
              runtime/h
              2
              root
              ($to_str
                "(append_prompt \"registration\" (register_plugin \"queued\" (quote "
                ($to_str queued_source)
                "))) (Outcome ^prompt \"registered\")")))
          ($assert (== queued/kind "continue") $"queued registration failed: ${queued/error}")
          ($assert
            ($str/contains? queued/request "queued")
            "registration published from inside response code")
          ($assert
            (== queued/composition_changes/0/status "ready")
            "root queue did not publish registration")
          (let next (evaluate_harness_turn runtime/h 3 root "(Outcome ^done true ^reply (ping))"))
          ($assert
            (== next/validated/outcome/reply "pong")
            "next turn did not receive the queued function")
          (let inspection (evaluate_harness_turn runtime/h 4 root
            "(Outcome ^done true ^reply ($to_str [(plugin_states) (inspect_plugin \"queued\") session_id]))"))
          ($assert ($str/contains? inspection/validated/outcome/reply "queued") $"plugin inspection failed: ${inspection/validated/outcome/reply}; ${inspection/error}")
          (let disabled (evaluate_harness_turn runtime/h 5 root "(disable_plugin \"queued\") (Outcome ^done true ^reply \"disabled\")"))
          (let hidden (evaluate_harness_turn runtime/h 6 root "(append_prompt \"state\" (inspect_plugin \"queued\")) (ping)"))
          ($assert (== hidden/kind "error") "disabled plugin function stayed visible")
          ($assert ($str/contains? hidden/request "disabled") "disabled plugin disappeared from inspection")
          (evaluate_harness_turn runtime/h 7 root "(enable_plugin \"queued\") (Outcome ^done true ^reply \"enabled\")")
          (let restored (evaluate_harness_turn runtime/h 8 root "(Outcome ^done true ^reply (ping))"))
          ($assert (== restored/validated/outcome/reply "pong") $"enable_plugin did not restore function: ${restored/error}")
          (set entries (composition_entries runtime/workspace))
          (let obsolete ($serde/read_data ($serde/write_data entries/0)))
          (obsolete .put "id" "obsolete")
          (obsolete .put
            "interfaces"
            {^core "gene-harness/PluginHost:1" ^plugin_api "gene-harness/Plugin:1"})
          (entries .push obsolete)
          (commit_composition runtime/workspace entries)
          (prepare_workspace runtime/workspace runtime/h)
          ($assert
            (==
              (runtime/workspace/errors
                .get
                ; .get "obsolete")
              "stored plugin predates interface 2; re-register it")
            "v1 plugin did not receive the re-register quarantine")
          ($println "plugin v2: direct activation, API-only sharing, full I/O, text registration and explicit session state")
        ensure
          (close_runtime runtime))))))

(describe "Plugin publication"
  (it "reports the durable boundary result before accepting done" []
    (isolated this_mod/.path "reports the durable boundary result before accepting done"
      (fn [workspace]
        (let root ($fs/real_path workspace))
        (let runtime (open_runtime root "default"
          (Profile ^name "test" ^plugins [(plugin_admin)])))
        (try
          (let source (ping_source))
          (let code
            ($to_str "(append_prompt \"registration\" (register_plugin \"example\" (quote "
              source
              "))) (Outcome ^done true ^reply \"installed\")"))
          (let result (evaluate_harness_turn runtime/h 1 root code))
          ($assert (== result/kind "continue") "queued installation ended the round")
          ($assert (== result/validated/rejected_done true)
            "done was not rejected while publication was pending")
          ($assert (== result/validated/outcome/reply "installed")
            "rejected reply was lost as progress")
          ($assert (== result/composition_changes/0/status "ready")
            "publication did not report the activated plugin")
          ($assert (== result/composition_changes/0/state "active")
            "publication did not name its durable state")
          ($assert (&& ($str/contains? result/request "[1.plugins]")
                       ($str/contains? result/request "plugin_notice"))
            "next request omitted the publication result or reason for continuing")
          ($assert (&& ($str/contains? result/request "example: active")
                       (! ($str/contains? result/request "^closure"))
                       (! ($str/contains? result/request "^interfaces")))
            "publication notice dumped internal composition metadata")
          (let next (evaluate_harness_turn runtime/h 2 root
            "(Outcome ^done true ^reply (ping))"))
          ($assert (== next/validated/outcome/reply "pong")
            "next turn could not use the committed plugin")
          (let broken_source
            ($to_str (quote
              (mod plugin
                (import ^from "src/plugin_api.gene" [Plugin])
                (fn init [descriptor]
                  (Plugin ^id "broken" ^activate (fn [host]
                    ($panic "activation failed"))))))))
          (let broken_code
            ($to_str "(register_plugin \"broken\" (quote " broken_source
              ")) (Outcome ^prompt \"check publication\")"))
          (let broken_result (evaluate_harness_turn runtime/h 3 root broken_code))
          ($assert (== broken_result/composition_changes/0/state "quarantined")
            "failed activation did not report quarantine")
          ($assert ($str/contains? broken_result/request "quarantined")
            "model did not see the failed boundary result")
          ($assert ($str/contains? broken_result/request "activation failed")
            $"quarantine notice omitted the activation error: ${broken_result/request}")
          (let healthy_replacement
            (register_plugin ^replace true runtime/workspace runtime/h
              "example" source))
          ($assert (== healthy_replacement/status "ready")
            "quarantined sibling blocked a healthy replacement")
        ensure
          (close_runtime runtime))
        (let restarted (open_runtime root "other"
          (Profile ^name "test" ^plugins [(plugin_admin)])))
        (try
          (let after_restart (evaluate_harness_turn ^session "other" restarted/h 3 root
            "(Outcome ^done true ^reply (ping))"))
          ($assert (== after_restart/validated/outcome/reply "pong")
            "a different session lost the plugin after restart")
          ($assert ($str/contains? ($to_str (doctor restarted/workspace))
                     "broken")
            "restart did not retain the quarantined plugin state")
        ensure
          (close_runtime restarted)))))

  (it "keeps the last active revision when a stored replacement fails" []
    (isolated this_mod/.path "keeps the last active revision when a stored replacement fails"
      (fn [workspace]
        (let root ($fs/real_path workspace))
        (let runtime (open_runtime root "default"
          (Profile ^name "test" ^plugins [(plugin_admin)])))
        (try
          (let active (register_plugin runtime/workspace runtime/h
            "example" (ping_source)))
          ($assert (== active/status "ready") "healthy plugin did not activate")
          (let broken
            ($to_str (quote
              (mod plugin
                (import ^from "src/plugin_api.gene" [Plugin])
                (fn init [descriptor]
                  (Plugin ^id "example" ^activate (fn [host]
                    (fail "replacement failed"))))))))
          (let replacement (register_plugin ^replace true
            runtime/workspace runtime/h "example" broken))
          ($assert (== replacement/state "quarantined")
            "failed replacement did not report quarantine")
          (let retained (evaluate_harness_turn runtime/h 4 root
            "(Outcome ^done true ^reply (ping))"))
          ($assert (== retained/validated/outcome/reply "pong")
            "failed replacement retired the last active callable")
        ensure
          (close_runtime runtime)))))

  (it "discards a cancelled turn's queued registration" []
    (isolated this_mod/.path "discards a cancelled turn's queued registration"
      (fn [workspace]
        (let root ($fs/real_path workspace))
        (let runtime (open_runtime root "default"
          (Profile ^name "test" ^plugins [(plugin_admin)])))
        (let entered ($cell false))
        (try
          (let source (ping_source))
          (let code
            ($to_str "(register_plugin \"example\" (quote " source
              ")) (entered .set true) (while true ($sleep 1))"))
          (let task (spawn ^lane root
            (evaluate_harness_turn ^bindings {^entered entered} runtime/h 1 root code)))
          (let deadline (+ ($os/monotonic_ms) 5000))
          (while (&& (! entered/.get) (< ($os/monotonic_ms) deadline))
            ($sleep 1))
          ($assert entered/.get "response never queued its plugin")
          task/.cancel
          task/.join
          (evaluate_harness_turn runtime/h 2 root
            "(Outcome ^done true ^reply \"next\")")
          ($assert (== (row runtime/h "functions" "ping") void)
            "another turn published the cancelled registration")
          ($assert (== (composition_entries runtime/workspace) [])
            "cancelled registration reached durable composition")
          ($assert (== runtime/h/snapshots/pending/.get [])
            "cancelled turn left a pending composition change")
        ensure
          (close_runtime runtime))))))

(fn main [args] : Int (run_spec args))
