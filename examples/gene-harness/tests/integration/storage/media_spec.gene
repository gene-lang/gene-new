(import $test [describe it])
(import ^from "../../support" [isolated run_spec])
(import ^from "../../../src/storage/media"
  [
    open_media_store
    put_media
    put_media_base64
    media_record
    media_descriptor
    media_bytes
    media_text
    media_data_url
    reserve_media
    release_media_reservation
    recover_media_reservations
    generated_media
    media_usage
    validate_media_refs
    MediaError])
(import [png] ^from "../../fixtures/png")

(fn rejected [code : Str, action]
  (let result (try (action) "accepted" catch MediaError $err/code))
  ($assert (== result code) $"Expected ${code}, received ${result}"))

(describe
  "Harness media storage"
  (it
    "stores immutable bytes and descriptors across reopen without exposing paths"
    []
    (isolated
      this_mod/.path
      "stores immutable bytes and descriptors across reopen without exposing paths"
      (fn [workspace]
        (let root ($path/join workspace ".gene-harness"))
        (let store (open_media_store root))
        (let data ($binary/from_str "A document: héllo 世界"))
        (let item (put_media store "C:\\Users\\demo\\report.txt" data))
        ($assert (== item/name "report.txt"))
        ($assert (== item/kind "text"))
        ($assert (== item/mime "text/plain"))
        ($assert ($absent? item/path))
        ($assert ($absent? item/digest))
        ($assert (== item/url $"/api/v8/media/${item/id}"))
        (let reopened (open_media_store root))
        ($assert (== (media_bytes reopened item/id) data))
        ($assert (== (media_text reopened item/id) "A document: héllo 世界"))
        ($assert (== (media_descriptor reopened item/id) item))
        ($assert (== (validate_media_refs reopened [item/id]) [item])))))
  (it
    "retains binary images and canonical base64 without text conversion"
    []
    (isolated
      this_mod/.path
      "retains binary images and canonical base64 without text conversion"
      (fn [workspace]
        (let store (open_media_store ($path/join workspace ".gene-harness")))
        (let encoded "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAEElEQVR4AQEFAPr/AFBkeP8EYAIs1SXmQwAAAABJRU5ErkJggg==")
        (let image (put_media_base64 store "pixel.PNG" encoded))
        ($assert (== image/mime "image/png"))
        ($assert (== image/kind "image"))
        ($assert (== (media_data_url store image/id) $"data:image/png;base64,${encoded}"))
        (rejected "invalid_request" (fn [] (media_text store image/id)))
        (rejected "invalid_request" (fn [] (put_media_base64 store "x.png" "!!!"))))))
  (it
    "bounds file count and distinct binary storage while deduplicating content"
    []
    (isolated
      this_mod/.path
      "bounds file count and distinct binary storage while deduplicating content"
      (fn [workspace]
        (let store
          (open_media_store ^max_file_bytes 12 ^max_total_bytes 16 ^max_records 3
            ($path/join workspace ".gene-harness")))
        (let first (put_media store "first.txt" ($binary/from_str "123456789")))
        (let second (put_media store "second.txt" ($binary/from_str "123456789")))
        ($assert (!= first/id second/id))
        ($assert (== ($size ($fs/list_dir ($path/join store/root "objects"))) 1))
        (rejected
          "too_large"
          (fn []
            (put_media store "large.txt" ($binary/from_str "1234567890123"))))
        (rejected "too_large" (fn [] (put_media store "quota.txt" ($binary/from_str "abcdefgh"))))
        (put_media store "empty.txt" ($binary/from_str ""))
        (rejected "too_large" (fn [] (put_media store "fourth.txt" ($binary/from_str "")))))))
  (it
    "rejects traversal invalid text duplicate references and corrupt objects"
    []
    (isolated
      this_mod/.path
      "rejects traversal invalid text duplicate references and corrupt objects"
      (fn [workspace]
        (let store (open_media_store ($path/join workspace ".gene-harness")))
        (rejected "not_found" (fn [] (media_bytes store "../../config.gene")))
        (rejected
          "invalid_request"
          (fn []
            (put_media
              store
              """bad
name.txt"""
              ($binary/from_str "ok"))))
        (rejected
          "invalid_request"
          (fn []
            (put_media store "fake.png" ($binary/from_str "not an image"))))
        (rejected
          "invalid_request"
          (fn []
            (put_media store "invalid.txt" ($binary/from_list [255]))))
        (rejected
          "invalid_request"
          (fn []
            (put_media store "nul.txt" ($binary/from_list [65 0 66]))))
        (let item (put_media store "ok.txt" ($binary/from_str "original")))
        (rejected "invalid_request" (fn [] (validate_media_refs store [item/id item/id])))
        (rejected "invalid_request" (fn [] (validate_media_refs store [1])))
        (let record (media_record store item/id))
        ($fs/write_bytes_atomic
          ($path/join store/root "objects" record/digest)
          ($binary/from_str "corrupt"))
        (rejected "unavailable" (fn [] (media_bytes store item/id))))))

  (it "reserves quota durably and commits generated provenance atomically" []
    (isolated this_mod/.path
      "reserves quota durably and commits generated provenance atomically"
      (fn [workspace]
        (let root ($path/join workspace ".gene-harness"))
        (let store (open_media_store root ^max_file_bytes 128 ^max_total_bytes 160 ^max_records 3))
        (let reserved (reserve_media store "run-1" 1 "session-a" "round-a"))
        ($assert (== (reserve_media store "run-1" 1 "session-a" "round-a") reserved))
        (let reopened (open_media_store root ^max_file_bytes 128 ^max_total_bytes 160 ^max_records 3))
        ($assert (== (media_usage reopened) {^bytes 128 ^records 1 ^reservations 1}))
        (put_media reopened "other.txt" ($binary/from_str "unrelated upload"))
        (rejected "too_large" (fn []
          (put_media reopened "steal.txt" ($binary/from_str "12345678901234567890"))))
        (let bytes (png))
        (let saved (put_media store "candidate.png" bytes ^source "generated"
          ^reservation reserved/id ^has_transparent_pixels false))
        ($assert (== saved/id reserved/id))
        ($assert (== saved/generation {^run "run-1" ^attempt 1 ^session "session-a" ^round "round-a"}))
        ($assert (== [saved/width saved/height saved/has_alpha saved/has_transparent_pixels]
          [1 1 true false]))
        ($assert (== (media_bytes reopened saved/id) bytes))
        ($assert (== (generated_media reopened ^session "session-a") [saved]))
        ($assert (== (generated_media reopened ^session "session-b") []))
        ($assert (== (recover_media_reservations reopened) []))
        ($assert (== (/committed (reserve_media reopened "run-1" 1 "session-a" "round-a")) true))
        ($assert (== (/reservations (media_usage reopened)) 0))
        ($assert (== (/bytes (media_usage reopened)) (+ ($binary/size bytes) 16))))))

  (it "releases interrupted reservations once and preserves committed candidates" []
    (isolated this_mod/.path
      "releases interrupted reservations once and preserves committed candidates"
      (fn [workspace]
        (let root ($path/join workspace ".gene-harness"))
        (let store (open_media_store root ^max_file_bytes 128 ^max_total_bytes 256 ^max_records 2))
        (let first (reserve_media store "run" 1 "session" "round"))
        (let second (reserve_media store "run" 2 "session" "round"))
        (rejected "too_large" (fn [] (put_media store "upload.txt" ($binary/from_str ""))))
        (let saved (put_media store "first.png" (png) ^source "generated" ^reservation first/id))
        (let orphan (png ^samples [0 10 20 30 255]))
        (let orphan_path ($path/join store/root "objects" ($crypto/sha256 orphan)))
        ($fs/write_bytes_atomic orphan_path orphan)
        # Crash boundary: the image index committed but no run checkpoint exists.
        (let restarted (open_media_store root ^max_file_bytes 128 ^max_total_bytes 256 ^max_records 2))
        ($assert (== (recover_media_reservations restarted) [second]))
        ($assert (! ($fs/exists? orphan_path)))
        ($assert (== (media_bytes restarted saved/id) (png)))
        ($assert (== (recover_media_reservations restarted) []))
        ($assert (== (release_media_reservation restarted second/id) false))
        ($assert (== (generated_media restarted ^run "run") [saved]))
        (put_media restarted "after.txt" ($binary/from_str "room is available"))
        ($assert (== (/records (media_usage restarted)) 2)))))

  (it "releases failed generation reservations idempotently" []
    (isolated this_mod/.path
      "releases failed generation reservations idempotently"
      (fn [workspace]
        (let store (open_media_store ($path/join workspace ".gene-harness")))
        (let reserved (reserve_media store "run" 1 "session" "round"))
        (let index ($serde/read_data ($fs/read_text ($path/join store/root "index.gene"))))
        ($assert (== index/format 2))
        (rejected "invalid_request" (fn []
          (put_media store "bad.png" ($binary/from_str "not PNG")
            ^source "generated" ^reservation reserved/id)))
        ($assert (== (/reservations (media_usage store)) 1))
        ($assert (release_media_reservation store reserved/id))
        ($assert (! (release_media_reservation store reserved/id)))
        (rejected "invalid_request" (fn [] (put_media store "lost.png" (png) ^source "generated")))
        ($assert (== (media_usage store) {^bytes 0 ^records 0 ^reservations 0}))))))

(fn main [args]
  (run_spec args))
