(import $test [describe it])
(import [isolated run_spec] ^from "../../support")
(import [extract_document extract_pdf_page extracted_text] ^from "./extract" ^pkg "documents")
(import [DocumentError] ^from "." ^pkg "documents")
(import [open_media_store put_media] ^from "../../../src/storage/media")
(import [expand_media_messages] ^from "../../../src/agents/media_input")

# ASCII fixtures keep offsets exact and make the scanned-page case independent
# of a PDF authoring library. The second PDF contains graphics and no text layer.
(fn pdf_fixture [^text text : Str = ""]
  (let objects [
    "<< /Type /Catalog /Pages 2 0 R >>"
    "<< /Type /Pages /Kids [3 0 R 5 0 R 7 0 R] /Count 3 >>"])
  (repeat i in 3
    (let page (+ 3 (* i 2)))
    (objects .push $"<< /Type /Page /Parent 2 0 R /MediaBox [0 0 200 200] /Resources << /Font << /F1 9 0 R >> >> /Contents ${(+ page 1)} 0 R >>")
    (let stream $"1 0 0 rg 20 20 160 160 re f\nBT /F1 12 Tf 0 0 0 rg 25 100 Td (${text}) Tj ET\n")
    (objects .push $"<< /Length ${($str/byte_size stream)} >>\nstream\n${stream}endstream"))
  (objects .push "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>")
  (var pdf "%PDF-1.4\n")
  (let offsets ["0000000000 65535 f \n"])
  (var index 1)
  (for object in objects
    (let offset ($to_str ($str/byte_size pdf)))
    (let padding [])
    (repeat i in (- 10 ($str/byte_size offset)) (padding .push "0"))
    (let zeros ($str/join padding ""))
    (offsets .push $"${zeros}${offset} 00000 n \n")
    (set pdf $"${pdf}${index} 0 obj\n${object}\nendobj\n")
    (set index (+ index 1)))
  (let xref ($str/byte_size pdf))
  (let table ($str/join offsets ""))
  (set pdf $"${pdf}xref\n0 ${index}\n${table}trailer\n<< /Size ${index} /Root 1 0 R >>\nstartxref\n${xref}\n%%EOF\n")
  ($binary/from_str pdf))

(describe "Document extraction"
  (it "keeps converter truncation on a UTF-8 boundary" []
    (let partial ($binary/to_str ($binary/from_list [65 240 159 146])))
    ($assert (== (extracted_text {^stdout partial ^^stdout_truncated}) "A"))
    ($assert (== (try (extracted_text {^stdout partial ^!stdout_truncated}) "accepted" catch DocumentError "rejected") "rejected")))
  (it "extracts PDF text, preserves scanned page images, bounds pages and cleans conversion files" []
    (isolated this_mod/.path "extracts PDF text, preserves scanned page images, bounds pages and cleans conversion files"
      (fn [workspace]
        (let root ($path/join workspace "conversion"))
        (let pdf (pdf_fixture ^text "DOCUMENT-MARKER-4172"))
        (let result (extract_document root "report.pdf" pdf))
        ($assert ($str/contains? result/text "DOCUMENT-MARKER-4172"))
        ($assert (== result/page_count 3))
        ($assert (== result/pages/.size 2))
        ($assert result/truncated)
        (let store (open_media_store workspace))
        (let uploaded (put_media store "report.pdf" pdf))
        (let messages [{^role "user" ^content "Read the report." ^media [uploaded]}])
        (let prepared (expand_media_messages {^state_root workspace} messages))
        ($assert ($str/contains? prepared/0/content "DOCUMENT-MARKER-4172"))
        ($assert ($str/contains? prepared/0/content "3 pages"))
        ($assert (== prepared/0/images/.size 2))
        (let again (expand_media_messages {^state_root workspace} messages))
        ($assert (== prepared again) "cached extraction changed page identities")
        (let scan (pdf_fixture))
        (let scanned (extract_document root "scan.pdf" scan))
        ($assert (== ($str/trim scanned/text) ""))
        ($assert (== scanned/pages/.size 2))
        ($assert (> ($binary/size scanned/pages/0/data) 100))
        (let page (extract_pdf_page root "scan.pdf" scan 3))
        ($assert (== page/page 3))
        ($assert (== page/page_count 3))
        ($assert (== (try (extract_pdf_page root "scan.pdf" scan 4) "accepted" catch DocumentError "rejected") "rejected"))
        ($assert (== (try (extract_document root "broken.pdf" ($binary/from_str "%PDF-broken")) "accepted" catch DocumentError "rejected") "rejected"))
        ($assert (== ($fs/list_dir root) [])))))
  (it "extracts real DOCX text and rejects a corrupt container" []
    (isolated this_mod/.path "extracts real DOCX text and rejects a corrupt container"
      (fn [workspace]
        (let input ($path/join workspace "original.txt"))
        (let output ($path/join workspace "original.docx"))
        ($fs/write_text input "DOCX-MARKER-8159 世界")
        (let generated (await ($os/exec_async "textutil" "-convert" "docx" "-output" output input ^timeout_ms 10000)))
        ($assert (== generated/status 0))
        (let root ($path/join workspace "conversion"))
        (let result (extract_document root "notes.docx" ($fs/read_bytes output)))
        ($assert ($str/contains? result/text "DOCX-MARKER-8159 世界"))
        ($assert (== result/pages []))
        ($assert (== (try (extract_document root "bad.docx" ($binary/from_list [80 75 3 4 0])) "accepted" catch Any "rejected") "rejected"))
        ($assert (== ($fs/list_dir root) []))))))

(fn main [args] (run_spec args))
