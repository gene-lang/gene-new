(import $test [describe it])
(import [isolated run_spec] ^from "../../support")
(import [open_runtime close_runtime] ^from "../../../src/runtime/bootstrap")
(import [scripted_profile] ^from "../../../src/profiles/scripted")
(import [models] ^from "../../../src/builtin/models")
(import [put_cordis_plugin row uninstall] ^from "../../../src/kernel")
(import [ExecutionLimits Plugin PluginHost] ^from "../../../src/plugin_api")
(import [active_model_catalog] ^from "../../../src/runtime/models_host")
(import [test_controller] ^from "../../support")
(import [Profile] ^from "../../../src/profiles/profile")
(import [provider_claude] ^from "../../../src/builtin/provider_claude")
(import [readiness_report] ^from "../../../src/agents/provider_selection")
(import [submit_round round_receipt] ^from "../../../src/runtime/round_controller")
(import [save_chatgpt_account list_chatgpt_accounts] ^from "../../../src/public/chatgpt_store")
(import [select_provider] ^from "../../../src/agents/provider_selection")

(describe "Model catalog lifetime"
  (it "keeps discovery alive after activation and closes it with the owning contribution" []
    (isolated this_mod/.path "keeps discovery alive after activation and closes it with the owning contribution"
      (fn [workspace]
        (let runtime (open_runtime workspace "default" (scripted_profile [])))
        (try
          (let installed (put_cordis_plugin ^^replace runtime/h (models ^root workspace)
            {^^host ^limits (ExecutionLimits ^timeout_ms 100 ^max_memory_mb 64)}))
          ($assert ($present? (row runtime/h "seams" "models/catalog")) ($to_str installed))
          ($sleep 100)
          (let service (/value (row runtime/h "seams" "models/catalog")))
          (let before (/revision (service/snapshot)))
          (service/refresh)
          ($sleep 150)
          ($assert (> (/revision (service/snapshot)) before) "worker inherited an expired activation deadline")
          (let owned (active_model_catalog runtime))
          (uninstall runtime/h "models")
          ($sleep 150)
          ($assert owned/closed/.get "catalog worker outlived its contribution")
          ($assert owned/worker/.get/.done?)
          ($assert ($absent? (row runtime/h "seams" "models/catalog")))
        ensure (close_runtime runtime))))))

(describe "Discovered Claude subscription"
  (it "admits a turn with only a discovered CLI login and no provider configuration" []
    (isolated this_mod/.path "admits a turn with only a discovered CLI login and no provider configuration"
      (fn [workspace]
        (let command ($os/get_env "GENE_HARNESS_CLAUDE_COMMAND"))
        ($fs/write_text command "#!/bin/sh\ncase \"$1\" in\nauth) printf '%s\\n' '{\"loggedIn\":true,\"authMethod\":\"claude.ai\",\"subscriptionType\":\"pro\"}';;\n*) printf '%s\\n' '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"(Outcome ^^done ^reply \\\"connected\\\")\"}';;\nesac\n")
        (let runtime (open_runtime workspace "default"
          (Profile ^name "test" ^plugins [(provider_claude) (models ^root workspace)])))
        (let controller (test_controller runtime nil))
        (try
          (let deadline (+ ($os/monotonic_ms) 5000))
          (while ($present? (readiness_report runtime {}))
            ($assert (< ($os/monotonic_ms) deadline) "CLI login was not discovered")
            ($sleep 10))
          (let list_models (/fn (row runtime/h "functions" "list_models")))
          (let choices (list_models ^provider "claude" ^q "sonnet"))
          ($assert (== choices/models/.size 1))
          ($assert (== choices/models/0/id "sonnet"))
          ($assert (== choices/models/0/billing "plan"))
          (let first (submit_round controller "default" "discovered" 1 "work"))
          (let watcher (/watcher (controller/rounds/.get .get "default")))
          watcher/.join
          (let result (round_receipt controller "default" first/id))
          ($assert (== result/state "done") (?? result/message "discovered CLI turn did not finish"))
          ($assert (== first/selection/provider "claude"))
          ($assert (== first/selection/billing "plan"))
          ($assert (== first/selection/requested_effort "auto"))
          ($assert (== first/selection/input ["text"]))
        ensure (close_runtime runtime))))))

(describe "Model sign-in lifetime"
  (it "keeps a pending sign-in within the Models activation and cancels it on removal" []
    (isolated this_mod/.path "keeps a pending sign-in within the Models activation and cancels it on removal"
      (fn [workspace]
        (let provider (Plugin ^id "provider_openrouter" ^provides [["providers" "openrouter"]]
          ^activate (fn [host]
            (host .PluginHost:contribute "providers" {^name "openrouter" ^doc "Local sign-in fixture."
              ^configure (fn [model effort timeout] {^model "fake" ^timeout_ms timeout})
              ^prepare (fn [call] call) ^send (fn [prepared] {^text "(Outcome ^^done)"})}))))
        (let runtime (open_runtime workspace "default"
          (Profile ^name "signin" ^plugins [provider (models ^root workspace)])))
        (try
          (set runtime/listen_port 45678)
          (let catalog (/value (row runtime/h "seams" "models/catalog")))
          (let started (catalog/connect "openrouter"))
          ($assert (== started/state "pending"))
          ($assert ($str/starts_with? started/url "https://openrouter.ai/auth?"))
          ($assert ($str/contains? started/url "127.0.0.1%3A45678"))
          (let attempt (runtime/services/values/models_host/logins .get started/id))
          ($assert (== (/state (catalog/login_status started/id)) "pending"))
          ($assert (try (catalog/connect "openrouter") false catch Any true))
          (uninstall runtime/h "models")
          ($assert (== attempt/status/.get "cancelled"))
          ($assert attempt/worker/.get/.done?)
        ensure (close_runtime runtime))))))

(describe "ChatGPT account selection"
  (it "publishes the new account before returning and stops an older round selection" []
    (isolated this_mod/.path "publishes the new account before returning and stops an older round selection"
      (fn [workspace]
        (let auth_root ($path/join workspace "provider-logins"))
        ($assert (== ($os/get_env "GENE_HARNESS_AUTH_HOME") auth_root))
        (let first {^version 1 ^issuer "https://auth.openai.com" ^client_id "oaiapp_a" ^subject "a"
          ^scopes ["resource.invoke" "chatgpt.tokens.use.direct"] ^expires_at (+ (/ ($os/wall_ms) 1000) 3600)
          ^access_token "SECRET_A"})
        (let a (save_chatgpt_account auth_root first))
        (let another ($thaw ($freeze first))) (another .put "client_id" "oaiapp_b")
        (let b (save_chatgpt_account ^activate false auth_root another))
        (let provider (Plugin ^id "provider_chatgpt" ^provides [["providers" "chatgpt"]]
          ^activate (fn [host]
            (host .PluginHost:contribute "providers" {^name "chatgpt" ^doc "Local account fixture." ^auto 1
              ^transport {^adapter "fake" ^base_url "fake://chatgpt" ^billing "plan"}
              ^connection (fn [] {^state "ready" ^billing "plan" ^account (/active (list_chatgpt_accounts auth_root))})
              ^configure (fn [model effort timeout] {^model "fake" ^timeout_ms timeout})
              ^prepare (fn [call] call) ^send (fn [prepared] {^text "(Outcome ^^done)"})}))))
        (let runtime (open_runtime workspace "default" (Profile ^name "accounts" ^plugins [provider (models ^root workspace)])))
        (try
          (let catalog (/value (row runtime/h "seams" "models/catalog")))
          (let deadline (+ ($os/monotonic_ms) 5000))
          (while (!= (/account (/connection (/chatgpt (/providers (catalog/snapshot))))) a/id)
            ($assert (< ($os/monotonic_ms) deadline)) ($sleep 1))
          (let before (select_provider runtime {^provider "chatgpt" ^model "fake"}))
          ($fs/write_text ($path/join auth_root "chatgpt" "active.json") "broken")
          ($assert ($present? (/error (list_chatgpt_accounts auth_root))))
          (catalog/account_action b/id "select")
          ($assert (== (/active (list_chatgpt_accounts auth_root)) b/id) "choosing an account did not repair corrupt active.json")
          ($assert (== (/account (/connection (/chatgpt (/providers (catalog/snapshot))))) b/id))
          ($assert (try (select_provider ^selection before/selection runtime {}) false
            catch Any (== $err/code "connection_changed")))
          ($assert (== (/account (/selection (select_provider runtime {^provider "chatgpt" ^model "fake"}))) b/id))
        ensure (close_runtime runtime))))))

(fn main [args] : Int (run_spec args))
