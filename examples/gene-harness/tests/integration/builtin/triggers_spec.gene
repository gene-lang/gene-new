(import $test [describe it])
(import [isolated run_spec test_controller] ^from "../../support")
(import [open_runtime close_runtime] ^from "../../../src/runtime/bootstrap")
(import [Profile] ^from "../../../src/profiles/profile")
(import [triggers] ^from "../../../src/builtin/triggers")
(import [provide] ^from "../../../src/kernel")
(import [admission_host_binding] ^from "../../../src/runtime/admission_host")
(import [close_round_controller round_state] ^from "../../../src/runtime/round_controller")
(import [require_record list_sessions] ^from "../../../src/runtime/sessions")
(import [register_plugin] ^from "../../../src/storage/workspace_activation")
(import [set_plugin_enabled] ^from "../../../src/storage/workspace_repair")
(import [acquire_snapshot release_snapshot current_snapshot] ^from "../../../src/runtime/composition")
(import [service_states] ^from "../../../src/runtime/activation_services")

(fn ^^private function_in [snapshot, name : Str]
  (let found (/0 ($filter (?? (snapshot/registries .get "functions") []) (fn [record] (== record/key name)))))
  (if ($absent? found) nil found/payload/fn))

(fn call [runtime, name : Str, args...]
  (let lease (acquire_snapshot runtime/h/snapshots))
  (try
    (let callable (function_in lease/snapshot name))
    ($assert ($present? callable) $"function ${name} is not published")
    (callable args...)
  ensure (release_snapshot runtime/h/snapshots lease)))

(fn open_harness [root, profile, provider]
  (let runtime (open_runtime root "default" profile))
  (let controller (test_controller runtime provider))
  (provide runtime/h "core" "admission/host" (admission_host_binding runtime))
  {^runtime runtime ^controller controller})

(fn close_harness [harness]
  (close_round_controller harness/controller)
  (close_runtime harness/runtime))

(fn wait_until [check, ^ms ms : Int = 5000]
  (var waited 0)
  (while (&& (! (check)) (< waited ms)) ($sleep 20) (set waited (+ waited 20)))
  (check))

(fn occurrences [runtime, trigger : Str]
  ((function_in (current_snapshot runtime/h/snapshots) "trigger_occurrences") ^trigger trigger))

(fn done [] "(Outcome ^^done ^reply \"Done.\")")

# A replacement under another id: it takes the "triggers" slot explicitly and
# reads the same feature records the built-in wrote.
(fn successor_source []
  (quote (mod plugin
    (import [Plugin PluginHost] ^from "src/plugin_api.gene")
    (fn init [descriptor]
      (Plugin ^id "my_triggers" ^activate (fn [host]
        (host .PluginHost:contribute "feature_slots" {^name "triggers" ^takeover true})
        (host .PluginHost:service "scheduler" ^slot "triggers"
          (fn [] (host .PluginHost:put_record "probe" "successor_running" true) (while true ($sleep 50))))
        (host .PluginHost:contribute "functions" {^name "successor_definitions" ^doc "Read definitions."
          ^fn (fn [] ($map (host .PluginHost:records "triggers/definition") /value))})
        (host .PluginHost:contribute "functions" {^name "successor_occurrences" ^doc "Read occurrences."
          ^fn (fn [] ($map (host .PluginHost:records "triggers/occurrence") /value))})))))))

(describe "Triggers plugin"
  (it "admits a due occurrence once through its own initiator and keeps definitions across restart" []
    (isolated this_mod/.path "admits a due occurrence once through its own initiator and keeps definitions across restart"
      (fn [root]
        (let profile (Profile ^name "triggers" ^plugins [(triggers)]))
        (let harness (open_harness root profile (fn [request] (done))))
        (let runtime harness/runtime)
        (try
          (call runtime "create_trigger" {^id "once" ^kind "scheduled" ^at (+ ($os/wall_ms) 200) ^request "Do the work."})
          ($assert (wait_until (fn [] (== (/state (/0 (occurrences runtime "once"))) "finished")))
            ($to_str (occurrences runtime "once")))
          (let occurrence (/0 (occurrences runtime "once")))
          (let receipts (/receipts (round_state harness/controller occurrence/session)))
          ($assert (== receipts/.size 1) "the occurrence was admitted once")
          ($assert (== receipts/0/initiator_kind "triggers/schedule") ($to_str receipts/0))
          (let session (require_record runtime/sessions occurrence/session))
          ($assert (== session/origin/owner "triggers") ($to_str session))
          ($assert (== session/origin/trigger "once"))
        ensure (close_harness harness))
        (let restarted (open_harness root profile (fn [request] (done))))
        (try
          ($assert (wait_until (fn [] ($present? (function_in (current_snapshot restarted/runtime/h/snapshots) "list_triggers")))))
          ($assert (== ($map (call restarted/runtime "list_triggers") /id) ["once"]))
          ($sleep 300)
          (let again (/receipts (round_state restarted/controller (/session (/0 (occurrences restarted/runtime "once"))))))
          ($assert (== again/.size 1) "restart does not admit the finished occurrence again")
        ensure (close_harness restarted)))))

  (it "hands the slot to a replacement under another id, which sees existing definitions and edits from old leases" []
    (isolated this_mod/.path "hands the slot to a replacement under another id, which sees existing definitions and edits from old leases"
      (fn [root]
        (let profile (Profile ^name "triggers" ^plugins [(triggers)]))
        (let harness (open_harness root profile (fn [request] (done))))
        (let runtime harness/runtime)
        (try
          (call runtime "create_trigger" {^id "later" ^kind "scheduled" ^at (+ ($os/wall_ms) 86400000) ^request "Later."})
          (call runtime "create_trigger" {^id "doomed" ^kind "scheduled" ^at (+ ($os/wall_ms) 86400000) ^request "Doomed."})
          (let lease (acquire_snapshot runtime/h/snapshots))
          (try
            (let result (register_plugin runtime/workspace runtime/h "my_triggers" (successor_source)))
            ($assert (== result/status "ready") ($to_str result))
            ($assert (wait_until (fn [] (== (runtime/services/values/plugin_services/record "probe" "successor_running") true))))
            (let states (service_states runtime/services/values/plugin_services/activation_services))
            (let builtin (/0 ($filter states (fn [item] (&& (== item/owner "triggers") (== item/state "running"))))))
            ($assert ($absent? builtin) $"the built-in scheduler stopped producing: ${states}")
            # An edit through the old lease's retained function reaches the
            # shared records, so the successor sees it.
            ((function_in lease/snapshot "delete_trigger") "doomed")
          ensure (release_snapshot runtime/h/snapshots lease))
          (let seen (call runtime "successor_definitions"))
          (let live ($filter seen (fn [definition] (!= definition/deleted true))))
          ($assert (== ($map live /id) ["later"]) ($to_str seen))
        ensure (close_harness harness)))))

  (it "skips an occurrence that would overlap a running round and admits only one" []
    (isolated this_mod/.path "skips an occurrence that would overlap a running round and admits only one"
      (fn [root]
        (let gate ($cell false))
        (let profile (Profile ^name "triggers" ^plugins [(triggers)]))
        (let harness (open_harness root profile (fn [request]
          (while (! gate/.get) ($sleep 10))
          (done))))
        (let runtime harness/runtime)
        (try
          (call runtime "create_trigger" {^id "beat" ^kind "heartbeat" ^every_ms 150 ^request "Beat."})
          (fn overlapped [] ($filter (occurrences runtime "beat") (fn [item] (== item/reason "overlap"))))
          ($assert (wait_until (fn [] (> ($size (overlapped)) 0))) ($to_str (occurrences runtime "beat")))
          (let started ($filter (occurrences runtime "beat") (fn [item] (== item/state "started"))))
          ($assert (== started/.size 1) "one round runs; overlapping occurrences are skipped")
          (gate .set true)
        ensure
          (gate .set true)
          (close_harness harness)))))

  (it "records a one-shot missed during downtime as skipped and rejects unknown providers" []
    (isolated this_mod/.path "records a one-shot missed during downtime as skipped and rejects unknown providers"
      (fn [root]
        (let profile (Profile ^name "triggers" ^plugins [(triggers)]))
        (let harness (open_harness root profile (fn [request] (done))))
        (let runtime harness/runtime)
        (try
          (let refused (try (call runtime "create_trigger" {^id "bad" ^kind "scheduled"
            ^at (+ ($os/wall_ms) 86400000) ^request "x" ^model_settings {^provider "no_such_provider"}})
            "accepted" catch Any $err/message))
          ($assert ($str/contains? refused "Unknown provider") refused)
          (call runtime "create_trigger" {^id "missed" ^kind "scheduled" ^at (+ ($os/wall_ms) 1500) ^request "Missed."})
        ensure (close_harness harness))
        ($sleep 1700)
        (let restarted (open_harness root profile (fn [request] (done))))
        (try
          ($assert (wait_until (fn [] (> ($size (occurrences restarted/runtime "missed")) 0))))
          (let occurrence (/0 (occurrences restarted/runtime "missed")))
          ($assert (== occurrence/state "skipped") ($to_str occurrence))
          ($assert (== occurrence/reason "missed"))
        ensure (close_harness restarted)))))

  (it "applies session retention when a scheduler starts" []
    (isolated this_mod/.path "applies session retention when a scheduler starts"
      (fn [root]
        (let profile (Profile ^name "triggers" ^plugins [(triggers)]))
        (fn trigger_sessions [runtime]
          ($filter (list_sessions ^^all runtime/sessions) (fn [record] (== record/origin/trigger "kept"))))
        (let harness (open_harness root profile (fn [request] (done))))
        (try
          (call harness/runtime "create_trigger" {^id "kept" ^kind "heartbeat" ^every_ms 150 ^request "Beat."
            ^retention {^keep 1}})
          ($assert (wait_until (fn [] (>= ($size (trigger_sessions harness/runtime)) 3)) ^ms 8000)
            ($to_str ($size (trigger_sessions harness/runtime))))
        ensure (close_harness harness))
        (let counted (open_runtime root "default" profile ^!activate))
        (let before (try ($size (trigger_sessions counted)) ensure (close_runtime counted)))
        (let restarted (open_harness root profile (fn [request] (done))))
        (try
          ($assert (wait_until (fn [] (< ($size (trigger_sessions restarted/runtime)) before)))
            $"retention kept ${($size (trigger_sessions restarted/runtime))} of ${before} sessions")
        ensure (close_harness restarted)))))

  (it "removes its functions, route and scheduler when disabled" []
    (isolated this_mod/.path "removes its functions, route and scheduler when disabled"
      (fn [root]
        (let profile (Profile ^name "triggers" ^plugins [(triggers)]))
        (let harness (open_harness root profile (fn [request] (done))))
        (let runtime harness/runtime)
        (try
          ($assert (wait_until (fn [] ($present? (function_in (current_snapshot runtime/h/snapshots) "create_trigger")))))
          (set_plugin_enabled runtime/workspace runtime/h "triggers" false)
          (let snapshot (current_snapshot runtime/h/snapshots))
          ($assert ($absent? (function_in snapshot "create_trigger")))
          ($assert (== ($filter (?? (snapshot/registries .get "http_routes") []) (fn [record] (== record/owner "triggers"))) []))
          (let running ($filter (service_states runtime/services/values/plugin_services/activation_services)
            (fn [item] (&& (== item/owner "triggers") (== item/state "running")))))
          ($assert (== running []) ($to_str running))
        ensure (close_harness harness))))))

(fn main [args] : Int (run_spec args))
