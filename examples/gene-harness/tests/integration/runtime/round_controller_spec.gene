# Tests src/runtime/round_controller.gene.
(import $test [describe it])
(import [isolated run_spec test_controller set_test_provider] ^from "../../support")
(import [open_runtime close_runtime] ^from "../../../src/runtime/bootstrap")
(import [baseline_profile] ^from "../../../src/profiles/baseline")
(import [create_session load_session] ^from "../../../src/runtime/sessions")
(import [new_round_controller submit_round round_receipt cancel_round close_round_controller
         save_round RoundError answer_round request_stop]
  ^from "../../../src/runtime/round_controller")
(import [events_for append_core_event flush_event_store] ^from "../../../src/storage/state")
(import [append_message] ^from "../../../src/agents/history")
(import [RoundChanged] ^from "../../../src/kernel")
(import [scripted_profile] ^from "../../../src/profiles/scripted")
(import [set_plugin_enabled] ^from "../../../src/storage/workspace")

(fn attempt [controller, id]
  (try {^^accepted ^receipt (submit_round controller "race" id 1 "ask")}
    catch RoundError {^!accepted ^code $err/code}))

(describe "Harness rounds"
  (it "refuses busy sessions while allowing independent rounds and cancellation" []
    (isolated this_mod/.path "refuses busy sessions while allowing independent rounds and cancellation"
      (fn [workspace]
        (let runtime (open_runtime workspace "default" (baseline_profile)))
        (let entered ($cell false))
        (let controller
          (test_controller
            runtime
            (fn [request]
              (if_yes (== request/session "slow")
                (entered .set true)
                ($sleep 5000))
              "(Outcome ^^done ^reply \"done\")")))
        (try
          (create_session ^id "slow" runtime/sessions)
          (create_session ^id "fast" runtime/sessions)
          (let slow (submit_round controller "slow" "slow" 1 "wait"))
          ($assert
            (try
              (submit_round controller "slow" "extra" 2 "another")
              false
            catch Any
              true)
            "busy session accepted another round")
          (while (! entered/.get)
            ($sleep 1))
          (let fast (submit_round controller "fast" "fast" 1 "finish"))
          (controller/watchers
            .get
            ; .get "fast"
            ; .join)
          (let fast_done (round_receipt controller "fast" fast/id))
          ($assert (== fast_done/state "done") "slow session blocked another session")
          (let before ($os/monotonic_ms))
          (cancel_round controller "slow" slow/id)
          (controller/watchers
            .get
            ; .get "slow"
            ; .join)
          ($assert (< (- ($os/monotonic_ms) before) 100) "cancellation exceeded 100 ms")
          (let cancelled (round_receipt controller "slow" slow/id))
          ($assert (== cancelled/state "cancelled") "cancel did not settle the receipt")
          (let ends [])
          (for event in (events_for runtime/events "session" "slow")
            (if (== event/type "turn/end") (ends .push event/payload/reason)))
          ($assert (== ends ["cancelled"]) "cancel left an open transcript turn")
          ($println "round concurrency: busy refusal, independent sessions, cancellation and turn closure")
        ensure
          (close_round_controller controller)
          (close_runtime runtime)))))

  (it "admits one load, submission and answer resumption and publishes one stop receipt" []
    (isolated this_mod/.path "admits one load, submission and answer resumption and publishes one stop receipt"
      (fn [workspace]
        (let runtime (open_runtime workspace "default" (baseline_profile)))
        (let calls ($cell 0))
        (let stopped ($cell []))
        (let subscription
          (runtime/h/bus .subscribe RoundChanged
            (fn [event]
              (if (== event/receipt/state "cancelled")
                (stopped/.get .push event/receipt)))))
        (let controller (test_controller runtime (fn [request]
          (let n (calls .swap (+ calls/.get 1)))
          (if (== n 0) "(Outcome ^questions [{^id \"q\" ^prompt \"Answer?\"}])"
            "(Outcome ^^done ^reply \"answered\")"))))
        (try
          (create_session runtime/sessions ^id "race")
          (append_message runtime "race" "user" "stored before the first load")
          (let loaded (scope
            (let a (spawn ^lane root (load_session runtime/sessions "race")))
            (let b (spawn ^lane root (load_session runtime/sessions "race")))
            [(await a) (await b)]))
          ($assert (same? loaded/0 loaded/1) "parallel first loads created different session states")
          (let admitted (scope
            (let a (spawn ^lane root (attempt controller "one")))
            (let b (spawn ^lane root (attempt controller "two")))
            [(await a) (await b)]))
          (var count 0)
          (for result in admitted (if result/accepted (set count (+ count 1))))
          ($assert (== count 1) "parallel submissions both entered the same session")
          (controller/watchers .get; .get "race"; .join)
          (let session (load_session runtime/sessions "race"))
          (let current session/round/.get)
          ($assert (== current/state "waiting") "admitted round did not wait")
          (let answered (scope
            (let a (spawn ^lane root (answer_round controller "race" current/questions/id {^q "yes"})))
            (let b (spawn ^lane root (answer_round controller "race" current/questions/id {^q "yes"})))
            [(await a) (await b)]))
          ($assert (== answered/0/id answered/1/id) "identical concurrent answers were not idempotent")
          (controller/watchers .get; .get "race"; .join)
          ($assert (== calls/.get 2) "concurrent answer resumed the provider twice")
          (var starts 0)
          (for event in (events_for runtime/events "session" "race")
            (if (== event/type "turn/start") (set starts (+ starts 1))))
          ($assert (== starts 2) "concurrent admission wrote duplicate turn starts")
          (create_session runtime/sessions ^id "stop")
          (set_test_provider runtime (fn [request] ($sleep 5000) "(Outcome ^^done ^reply \"late\")"))
          (let slow (submit_round controller "stop" "stop" 1 "wait"))
          (request_stop controller "stop" 0 true)
          (controller/watchers .get; .get "stop"; .join)
          ($assert (== ($size stopped/.get) 1) "workspace stop published cancellation twice")
          (let receipt (round_receipt controller "stop" slow/id))
          ($assert (== receipt/message "Workspace stopped.") "watcher overwrote the stop receipt")
          ($println "admission races: one loaded state, one submitted round, one answer resumption and one stop receipt")
        ensure
          subscription/.cancel
          (close_round_controller controller)
          (close_runtime runtime))))))

(describe "Harness round recovery"
  (it "interrupts current and historical receipts without replaying them" []
    (isolated this_mod/.path "interrupts current and historical receipts without replaying them"
      (fn [workspace]
        (let runtime (open_runtime workspace "default" (baseline_profile)))
        (let root runtime/root)
        (create_session runtime/sessions ^id "recover")
        (let controller (test_controller runtime (fn [request] "")))
        (save_round controller "recover" {^id "r1" ^request_id "u1" ^submission_seq 1 ^state "running"
          ^prompt "test" ^digest "test" ^last_turn 1})
        (append_core_event runtime/events "session" "recover" {^type "turn/start" ^turn 1 ^round "r1"})
        (flush_event_store runtime/events)
        # Simulate loss of a running task without altering its durable metadata.
        (let loaded (load_session runtime/sessions "recover"))
        (loaded/round/.get .put "state" "done")
        (close_runtime runtime)
        (let reopened (open_runtime root "default" (baseline_profile)))
        (try
          (let fresh (test_controller reopened (fn [request] "")))
          (let receipt (round_receipt fresh "recover" "r1"))
          ($assert (== receipt/state "interrupted") "historical receipt was not repaired")
          (let restored (load_session reopened/sessions "recover"))
          (let current restored/round/.get)
          ($assert (== current/state "interrupted") "blobbed current round was not repaired")
          (let endings [])
          (for event in (events_for reopened/events "session" "recover")
            (if (== event/type "turn/end") (endings .push event/payload/reason)))
          ($assert (== endings ["interrupted"]) "recovery did not close the open turn once")
          ($println "round recovery: current and historical blobbed receipts interrupt without replay")
          ensure (close_runtime reopened))))))

(describe "Profile readiness"
  (it "refuses a round missing instructions or its selected provider" []
    (isolated this_mod/.path "refuses a round missing instructions or its selected provider"
      (fn [workspace]
        (let runtime (open_runtime workspace "default"
          (scripted_profile ["(Outcome ^^done ^reply \"ready\")"])))
        (let controller (new_round_controller runtime))
        (try
          (set_plugin_enabled runtime/workspace runtime/h "gene_reference" false)
          ($assert
            (try
              (submit_round controller "default" "first" 1 "go")
              false
            catch RoundError
              (&& (== $err/code "not_ready")
                  ($str/contains? $err/message "prompt/gene_reference")))
            "missing reference prompt did not refuse admission")
          (set_plugin_enabled runtime/workspace runtime/h "gene_reference" true)
          (set_plugin_enabled runtime/workspace runtime/h "history_basic" false)
          ($assert
            (try
              (submit_round controller "default" "first" 1 "go")
              false
            catch RoundError
              (&& (== $err/code "not_ready")
                  ($str/contains? $err/message "hooks/history/compact/history_basic")))
            "missing compaction policy did not refuse admission")
          (set_plugin_enabled runtime/workspace runtime/h "history_basic" true)
          (set_plugin_enabled runtime/workspace runtime/h "provider_scripted" false)
          ($assert
            (try
              (submit_round controller "default" "first" 1 "go")
              false
            catch RoundError
              (&& (== $err/code "not_ready")
                  ($str/contains? $err/message "providers/scripted")))
            "missing selected provider did not refuse admission")
          (set_plugin_enabled runtime/workspace runtime/h "provider_scripted" true)
          (let accepted (submit_round controller "default" "first" 1 "go"))
          (controller/watchers .get; .get "default"; .join)
          (let receipt (round_receipt controller "default" accepted/id))
          ($assert (== receipt/state "done")
            "repaired profile could not run")
        ensure
          (close_round_controller controller)
          (close_runtime runtime)))))

  (it "fails a running round before a call after its provider disappears" []
    (isolated this_mod/.path "fails a running round before a call after its provider disappears"
      (fn [workspace]
        (let runtime (open_runtime workspace "default"
          (scripted_profile [
            "(disable_plugin \"provider_scripted\") (Outcome ^prompt \"continue\")"
            "(Outcome ^^done ^reply \"should not run\")"])))
        (let controller (new_round_controller runtime))
        (try
          (let accepted (submit_round controller "default" "first" 1 "go"))
          (controller/watchers .get; .get "default"; .join)
          (let receipt (round_receipt controller "default" accepted/id))
          ($assert (== receipt/state "failed")
            "round continued after losing its provider")
          ($assert ($str/contains? receipt/message "providers/scripted")
            "failure omitted the readiness reason")
        ensure
          (close_round_controller controller)
          (close_runtime runtime))))))

(fn main [args] : Int (run_spec args))
