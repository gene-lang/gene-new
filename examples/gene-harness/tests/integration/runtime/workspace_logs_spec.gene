# M4: the workspace object exposes the in-process ring to the REPL.
(import $test [describe it])
(import [isolated run_spec] ^from "../../support")
(import [open_session_service close_session_service] ^from "../../../src/web/session_service")
(import [log_reset log_event] ^from "../../../src/kernel/log")

(describe "Workspace logs object"
  (it "queries the ring by type and target" []
    (isolated ^timeout_ms 60000 this_mod/.path "queries the ring by type and target"
      (fn [workspace]
        (log_reset ^strict true ^quiet true)
        (let service (open_session_service ^workspace workspace ^^offline))
        (try
          (log_event "turn/start" "one" ^target {^session "s1" ^round "r" ^turn 1})
          (log_event "turn/start" "two" ^target {^session "s2" ^round "r" ^turn 1})
          (log_event "model/result" "three"
            ^target {^session "s2" ^round "r" ^turn 1 ^call "c"})
          (let objects service/runtime/h/objects/.get)
          (let workspace_object objects/workspace)
          (let selected (workspace_object/logs ^type "turn/*" ^target {^session "s2"}))
          ($assert (== (selected .size) 1) ($to_str selected))
          ($assert (== selected/0/message "two") ($to_str selected))
          (let wild (workspace_object/logs ^type "*/*" ^target {^session "s2"}))
          ($assert (== (wild .size) 2) ($to_str wild))
        ensure (close_session_service service))))))
