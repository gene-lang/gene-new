(import $test [describe it])
(import [isolated run_spec test_service] ^from "../../support")
(import [create_session submit receipt snapshot answer command close_session_service] ^from "../../../src/web/session_service")
(import [continue_round cancel_round save_round resume_continuations round_receipt RoundError] ^from "../../../src/runtime/round_controller")
(import [transcript] ^from "../../../src/agents/turn_loop")
(import [set_plugin_enabled] ^from "../../../src/storage/workspace")
(import [history_state] ^from "../../../src/agents/history")
(import [png] ^from "../../fixtures/png")

(fn one_turn_rounds [service]
  (let path $"${service/runtime/state_root}/config.gene")
  (let config ($serde/read_data ($fs/read_text path)))
  (config .put "turn_limit" 1)
  ($fs/write_text path ($serde/write_data config)))

(fn wait_task [service, session]
  (loop
    (let watcher (service/controller/watchers/.get .get session))
    (if ($absent? watcher) (return nil))
    watcher/.join
    (let next (service/controller/watchers/.get .get session))
    (if (same? watcher next) (return nil))))

(describe "Turn-limit continuation"
  (it "pauses without failure, admits one new round and replaces the trailing provider input" []
    (isolated this_mod/.path "pauses without failure, admits one new round and replaces the trailing provider input"
      (fn [workspace]
        (let calls ($cell []))
        (let service (test_service ^workspace workspace ^provider (fn [request]
          (calls/.get .push request)
          (if (== calls/.get/.size 1)
            "(Outcome ^prompt \"UNIQUE_PENDING_PAYLOAD\" ^reply \"Inspected the task.\")"
            "(Outcome ^^done ^reply \"Finished.\")"))))
        (try
          (one_turn_rounds service)
          (let session (create_session service))
          (let first (submit service session/id "first" 1 "Original user request."))
          (wait_task service session/id)
          (let paused (receipt service session/id first/id))
          ($assert (== paused/state "paused"))
          ($assert (== paused/reason "turn_limit"))
          ($assert (! ($absent? paused/finished_at)))
          ($assert (! ($absent? paused/continuation/history)))
          (let tail ($last (/messages (history_state service/runtime session/id))))
          ($assert (== tail/role "user"))
          ($fs/write_text $"${service/runtime/root}/STAGED_FOR_NEXT_USER_PROMPT.txt" "Staged file.")
          (let staged (command service session/id "/view STAGED_FOR_NEXT_USER_PROMPT.txt"))
          (service/runtime/commands/watchers/.get .get $"${session/id}:${staged/id}"; .join)
          (let second (continue_round service/controller session/id first/id "manual"))
          (let retried (continue_round service/controller session/id first/id "automatic"))
          ($assert (== second/id retried/id))
          ($assert (!= first/id second/id))
          ($assert ($absent? second/deadline_ms))
          (wait_task service session/id)
          ($assert (== (/state (receipt service session/id second/id)) "done"))
          ($assert (== calls/.get/.size 2))
          (let sent calls/.get/1/messages)
          (let user_items ($filter sent (fn [item] (== item/role "user"))))
          ($assert (== user_items/.size 2) "Continuation duplicated a model-history user message.")
          (let pending ($last user_items))
          ($assert ($str/contains? pending/content "UNIQUE_PENDING_PAYLOAD"))
          ($assert ($str/contains? pending/content "turn 1 of 1"))
          ($assert (! ($str/contains? pending/content "STAGED_FOR_NEXT_USER_PROMPT")))
          (let view (snapshot ^!console service session/id))
          ($assert (== ($size ($filter view/records (fn [item] (&& (== item/round_id second/id) (== item/role "user"))))) 0))
          ($assert (== ($size ($filter view/records (fn [item] (&& (== item/round_id second/id) (== item/phase "turn/request"))))) 1))
          (submit service session/id "fresh-user" 3 "A fresh user prompt.")
          (wait_task service session/id)
          (let fresh ($last calls/.get/2/messages))
          ($assert ($str/contains? fresh/content "STAGED_FOR_NEXT_USER_PROMPT"))
        ensure (close_session_service service)))))
  (it "continues automatically across multiple budgets with fresh guidance and cumulative turns" []
    (isolated this_mod/.path "continues automatically across multiple budgets with fresh guidance and cumulative turns"
      (fn [workspace]
        (let calls ($cell []))
        (let service (test_service ^workspace workspace ^provider (fn [request]
          (calls/.get .push request)
          (if (< calls/.get/.size 4) "(Outcome ^prompt \"Keep working.\" ^reply \"Working.\")"
            "(Outcome ^^done ^reply \"Finished automatically.\")"))))
        (try
          (one_turn_rounds service)
          (let session (create_session service))
          (let first (submit service session/id "auto" 1 "Work"))
          (wait_task service session/id)
          (let second (continue_round service/controller session/id first/id "automatic"))
          (wait_task service session/id)
          (let view (snapshot ^!console service session/id))
          ($assert (== view/round/state "done"))
          ($assert (== calls/.get/.size 4))
          ($assert (== view/round/task_turns_base 3))
          (let last_request ($last calls/.get/3/messages))
          ($assert ($str/contains? last_request/content "Continuation across round boundaries is automatic."))
          ($assert (! ($str/contains? last_request/content "0 turns remain")))
          ($assert (== (/id (continue_round service/controller session/id first/id "manual")) second/id)
            "A paused successor lost its immutable admission ancestry.")
        ensure (close_session_service service))))))

(describe "Continuation boundaries"
  (it "preserves native image input across a linked continuation round" []
    (isolated this_mod/.path "preserves native image input across a linked continuation round"
      (fn [workspace]
        (let calls ($cell []))
        (let service (test_service ^workspace workspace ^provider (fn [request]
          (calls/.get .push request)
          (if (== calls/.get/.size 1)
            "(media_import \"pixel.png\") (Outcome ^prompt \"Inspect the image.\" ^reply \"Image prepared.\")"
            "(Outcome ^^done ^reply \"Image inspected.\")"))))
        (try
          (one_turn_rounds service)
          ($fs/write_bytes $"${service/runtime/root}/pixel.png" (png))
          (let session (create_session service))
          (let first (submit service session/id "media" 1 "Inspect"))
          (wait_task service session/id)
          (let paused (receipt service session/id first/id))
          ($assert (== paused/state "paused"))
          ($assert (== paused/continuation/media/.size 1))
          (let resumed (continue_round service/controller session/id first/id "manual"))
          (wait_task service session/id)
          ($assert (== (/state (receipt service session/id resumed/id)) "done"))
          (let input ($last calls/.get/1/messages))
          ($assert (== input/media/0/id paused/continuation/media/0/id))
          ($assert (== input/images/.size 1))
        ensure (close_session_service service)))))
  (it "restores a manual pause without replaying its producing turn" []
    (isolated this_mod/.path "restores a manual pause without replaying its producing turn"
      (fn [workspace]
        (let before (test_service ^workspace workspace ^provider (fn [request]
          "(Outcome ^prompt \"RESTORED_PAYLOAD\" ^reply \"Paused work.\")")))
        (one_turn_rounds before)
        (let session (create_session before))
        (let first (submit before session/id "restore" 1 "Begin"))
        (wait_task before session/id)
        (close_session_service before)
        (let calls ($cell []))
        (let after (test_service ^workspace workspace ^provider (fn [request]
          (calls/.get .push request) "(Outcome ^^done ^reply \"Restored.\")")))
        (try
          ($assert (== calls/.get/.size 0))
          ($assert (== (/state (receipt after session/id first/id)) "paused"))
          (let resumed (continue_round after/controller session/id first/id "manual"))
          (wait_task after session/id)
          ($assert (== (/state (receipt after session/id resumed/id)) "done"))
          ($assert (== calls/.get/.size 1))
          (let input ($last calls/.get/0/messages))
          ($assert ($str/contains? input/content "RESTORED_PAYLOAD"))
        ensure (close_session_service after)))))
  (it "leaves history untouched when a new prompt supersedes a pause and can stop another pause" []
    (isolated this_mod/.path "leaves history untouched when a new prompt supersedes a pause and can stop another pause"
      (fn [workspace]
        (let service (test_service ^workspace workspace ^provider (fn [request]
          "(Outcome ^prompt \"Pending\" ^reply \"Working\")")))
        (try
          (one_turn_rounds service)
          (let session (create_session service))
          (let first (submit service session/id "old" 1 "Old task"))
          (wait_task service session/id)
          (let second (submit service session/id "new" 2 "New task"))
          (wait_task service session/id)
          (let history (history_state service/runtime session/id))
          ($assert (try (continue_round service/controller session/id first/id "manual") false
            catch RoundError (== $err/code "stale")))
          ($assert (== history (history_state service/runtime session/id)))
          (cancel_round service/controller session/id second/id)
          ($assert (== (/state (receipt service session/id second/id)) "cancelled"))
        ensure (close_session_service service)))))
  (it "retains answered questions when the answer reaches a turn-limit boundary" []
    (isolated this_mod/.path "retains answered questions when the answer reaches a turn-limit boundary"
      (fn [workspace]
        (let calls ($cell []))
        (let service (test_service ^workspace workspace ^provider (fn [request]
          (calls/.get .push request)
          (if (== calls/.get/.size 1)
            "(Outcome ^questions [{^id \"color\" ^prompt \"Color?\"}] ^reply \"Choose a color.\")"
            "(Outcome ^^done ^reply \"Choice received.\")"))))
        (try
          (one_turn_rounds service)
          (let session (create_session service))
          (let first (submit service session/id "ask" 1 "Choose"))
          (wait_task service session/id)
          (let waiting (receipt service session/id first/id))
          ($assert (== waiting/state "waiting"))
          (answer service session/id waiting/questions/id {^color "violet"})
          (wait_task service session/id)
          ($assert (== (/state (receipt service session/id first/id)) "paused"))
          (continue_round service/controller session/id first/id "manual")
          (wait_task service session/id)
          ($assert (== calls/.get/.size 2))
          (let input ($last calls/.get/1/messages))
          ($assert ($str/contains? input/content "violet"))
        ensure (close_session_service service))))))

(describe "Continuation admission recovery"
  (it "stops a failed admission durably without pretending automatic work is still active" []
    (isolated this_mod/.path "stops a failed admission durably without pretending automatic work is still active"
      (fn [workspace]
        (let service (test_service ^workspace workspace ^provider (fn [request]
          "(Outcome ^prompt \"Pending input.\" ^reply \"Working.\")")))
        (try
          (one_turn_rounds service)
          (let session (create_session service))
          (let first (submit service session/id "refuse" 1 "Start"))
          (wait_task service session/id)
          (set_plugin_enabled service/runtime/workspace service/runtime/h "history_basic" false)
          ($assert (try (continue_round service/controller session/id first/id "automatic") false
            catch RoundError (== $err/code "not_ready")))
          (let stopped (round_receipt service/controller session/id first/id))
          ($assert (== stopped/continuation_stop "failed"))
          ($assert (!= stopped/continuation_error ""))
          (resume_continuations service/controller)
          ($assert (== (/continuation_stop (round_receipt service/controller session/id first/id)) "failed"))
          (set_plugin_enabled service/runtime/workspace service/runtime/h "history_basic" true)
          (let fresh (submit service session/id "fresh-after-failure" 2 "Resume the remaining work."))
          (wait_task service session/id)
          (let superseded (round_receipt service/controller session/id first/id))
          ($assert (== superseded/continuation_stop "superseded"))
          ($assert ($absent? superseded/continuation_error))
          ($assert (!= fresh/id first/id))
        ensure (close_session_service service)))))
  (it "projects a resumable legacy limit without rewriting its failure receipt or host artifacts" []
    (isolated this_mod/.path "projects a resumable legacy limit without rewriting its failure receipt or host artifacts"
      (fn [workspace]
        (let calls ($cell 0))
        (let service (test_service ^workspace workspace ^provider (fn [request]
          (calls .set (+ calls/.get 1))
          (if (== calls/.get 1) "(Outcome ^prompt \"Legacy input.\" ^reply \"Working.\")"
            "(Outcome ^^done ^reply \"Legacy input resumed.\")"))))
        (try
          (one_turn_rounds service)
          (let session (create_session service))
          (let first (submit service session/id "legacy" 1 "Start"))
          (wait_task service session/id)
          (let old (round_receipt service/controller session/id first/id))
          (old .put "state" "failed") (old .put "reason" nil) (old .put "continuation" nil)
          (save_round service/controller session/id old)
          (transcript service/runtime session/id {^type "reply" ^round first/id ^turn 1 ^text "Host limit notice." ^^final})
          (transcript service/runtime session/id {^type "turn/end" ^round first/id ^turn 1
            ^reason "error" ^text "turn limit reached" ^!synthetic})
          (let view (snapshot ^!console service session/id))
          ($assert (== view/round/state "paused")) ($assert view/round/resumable)
          ($assert (== (/state (round_receipt service/controller session/id first/id)) "failed"))
          ($assert (== ($size ($filter view/records (fn [item] (== item/phase "turn/error")))) 0))
          ($assert (== ($size ($filter view/records (fn [item] (== item/text "Host limit notice.")))) 0))
          (let next (continue_round service/controller session/id first/id "manual"))
          (wait_task service session/id)
          ($assert (== (/state (receipt service session/id next/id)) "done"))
        ensure (close_session_service service)))))
  (it "finishes a recorded admission intent once after restart" []
    (isolated this_mod/.path "finishes a recorded admission intent once after restart"
      (fn [workspace]
        (let before (test_service ^workspace workspace ^provider (fn [request]
          "(Outcome ^prompt \"Recover the pending task.\" ^reply \"Working.\")")))
        (one_turn_rounds before)
        (let session (create_session before))
        (let first (submit before session/id "intent" 1 "Start"))
        (wait_task before session/id)
        (let paused (receipt before session/id first/id))
        (let target $"round-${($str/slice_bytes ($crypto/sha256 session/id) 0 16)}-2")
        (paused .put "continuation_mode" "automatic")
        (paused .put "continued_by" target)
        (paused .put "continuation_intent" {^sequence 2 ^mode "automatic" ^request_id $"continue/${first/id}"})
        (save_round before/controller session/id paused)
        (close_session_service before)
        (let calls ($cell 0))
        (let after (test_service ^workspace workspace ^provider (fn [request]
          (calls .set (+ calls/.get 1)) "(Outcome ^^done ^reply \"Recovered once.\")")))
        (try
          (wait_task after session/id)
          ($assert (== (/state (receipt after session/id target)) "done"))
          (resume_continuations after/controller)
          ($assert (== calls/.get 1))
          ($assert (== (/id (continue_round after/controller session/id first/id "manual")) target))
        ensure (close_session_service after)))))
  (it "stops the active automatic successor when Stop carries an earlier round id" []
    (isolated this_mod/.path "stops the active automatic successor when Stop carries an earlier round id"
      (fn [workspace]
        (let calls ($cell 0)) (let entered ($cell false))
        (let service (test_service ^workspace workspace ^provider (fn [request]
          (calls .set (+ calls/.get 1))
          (if_yes (> calls/.get 1) (entered .set true) ($sleep 1000))
          "(Outcome ^prompt \"Keep working.\" ^reply \"Working.\")")))
        (try
          (one_turn_rounds service)
          (let session (create_session service))
          (let first (submit service session/id "stop" 1 "Start"))
          (wait_task service session/id)
          (let next (continue_round service/controller session/id first/id "automatic"))
          (while (! entered/.get) ($sleep 1))
          (cancel_round service/controller session/id first/id)
          (wait_task service session/id)
          ($assert (== (/state (receipt service session/id next/id)) "cancelled"))
          ($assert (== calls/.get 2))
        ensure (close_session_service service))))))

(fn main [args] : Int (run_spec args))
