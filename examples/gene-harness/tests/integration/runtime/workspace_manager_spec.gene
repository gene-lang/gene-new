(import $test [describe it])
(import ^from "../../support" [isolated run_spec test_service source_path])
(import ^from "../../../src/web/session_service" [close_session_service])
(import ^from "../../../src/runtime/workspace_settings"
  [write_workspace_settings read_workspace_settings])
(import ^from "../../../src/runtime/workspace_manager"
  [manager_operation manager_list manager_inspect lock_held? ManagerError])
(import ^from "../../../src/kernel" [row])
(import ^from "../../../src/runtime/workspace_lock" [acquire_workspace_lock close_workspace_lock])
(import ^from "../../../src/runtime/bootstrap" [prepare_layout])
(import ^from "../../../src/ui/state" [ui_status])
(import ^from "../../../src/ui/views" [ui_preview])
(import ^from "../../../src/ui/actions" [ui_action ui_action_receipt])
(import ^from "../../../src/cli/client" [connect api discover])
(import ^from "../../web_support" [cli start_host stop_host])

(fn browser_action [service, named]
  (let state (ui_status service/runtime))
  (let view ((Path 0) ($filter state/components (fn [item] (== item/name "workspaces")))))
  (let id $"${state/actions/generation}:${($crypto/random_hex 10)}")
  (let receipt
    (ui_action
      service/runtime/services/values/actions
      {
        ^input_id id
        ^generation state/actions/generation
        ^instance "manager-test"
        ^component "workspaces"
        ^revision view/revision
        ^function "manager_workspace_action"
        ^function_revision view/functions/manager_workspace_action
        ^args []
        ^named named}))
  (service/runtime/services/values/actions/watchers/.get
    .get id
    ; .join)
  (ui_action_receipt service/runtime/services/values/actions id))

(fn stop_project [root]
  (if (&& (! (lock_held? $"${root}/.gene-harness/lock"))
          (! (lock_held? $"${root}/.gene-harness/launcher_lock"))) (return nil))
  (try
    (api (connect root) "POST" "/control" {^action "stop" ^^confirm})
  catch Any
    nil)
  # The stop response acknowledges admission. The supervisor still needs the
  # startup marker and log directory until it has reaped the child and exited.
  (let due (+ ($os/monotonic_ms) 20000))
  (while (|| (lock_held? $"${root}/.gene-harness/lock")
             (lock_held? $"${root}/.gene-harness/launcher_lock"))
    ($assert (< ($os/monotonic_ms) due) $"Fixture host did not finish stopping: ${root}")
    ($sleep 20)))

(fn manager_service [root]
  ($fs/make_dir $"${root}/.gene-harness")
  (write_workspace_settings root {^version 1 ^port 0 ^role "manager"})
  (test_service ^workspace root ^provider (fn [request] "(Outcome ^^done)")))

(describe
  "Workspace manager"
  (it
    "lists the workspaces directory and creates, renames, archives and restores by name"
    []
    (isolated
      this_mod/.path
      "lists the workspaces directory and creates, renames, archives and restores by name"
      (fn [root]
        (let service (manager_service root))
        (try
          (let h service/runtime/h)
          (let manager service/runtime/services/values/manager)
          (let base $"${service/runtime/root}/workspaces")
          (fn manager_fn [name : Str] (/fn (row h "functions" name)))
          ($assert (== service/runtime/profile/name "manager"))
          ($assert ($fs/exists? base))
          ($assert (== (/workspaces ((manager_fn "workspace_list"))) []))
          ($assert ($absent? (row h "functions" "manager_workspace_action")))
          (for name in ["workspace_delete" "workspace_open" "workspace_add" "workspace_remove"
                        "workspace_set_alias" "workspace_update_directory"]
            ($assert ($absent? (row h "functions" name)) name))
          ($assert (== ((Path "settings" "default_view") (ui_status service/runtime)) "workspaces"))
          (let preview (ui_preview service/runtime "workspaces"))
          ($assert ($absent? preview/error) ($to_str preview))
          (let project ((manager_fn "workspace_create") ^port 8123 "todo-app"))
          ($assert (== project/status "stopped") ($to_str project))
          ($assert (== project/id "todo-app"))
          ($assert (== project/name "todo-app"))
          ($assert (== project/dir $"${base}/todo-app"))
          ($assert (== ((Path "port") (read_workspace_settings project/dir)) 8123))
          ((manager_fn "workspace_set_port") project/id 0)
          ($assert (== ((Path "port") (read_workspace_settings project/dir)) 0))
          (for bad in ["todo-app" "../outside" ".hidden" "a/b" "" "has space"]
            (var refused false)
            (try
              ((manager_fn "workspace_create") bad)
            catch ManagerError
              (set refused true))
            ($assert refused bad))
          # Names that equal a static key, or that would join with another
          # row's key prefix, still render every selection with unique keys.
          (for name in ["create" "x" "select-x" "name-y" "y"]
            ((manager_fn "workspace_create") name))
          (for id in [project/id "create" "x" "select-x" "name-y" "y"]
            (for selection in ["" "create" $"edit/${id}" $"rename/${id}" $"archive/${id}" $"delete/${id}"]
              (let rendered (ui_preview service/runtime "workspaces" {^selected selection}))
              ($assert ($absent? rendered/error) ($to_str selection " " rendered))))
          (let edit_create (ui_preview service/runtime "workspaces" {^selected "edit/create"}))
          ($assert ($str/contains? ($to_str edit_create) "Edit create") "Edit opened another panel.")
          (for name in ["create" "x" "select-x" "name-y" "y"]
            ($fs/remove $"${base}/${name}/.gene-harness/workspace.gene")
            ($fs/remove_dir $"${base}/${name}/.gene-harness")
            ($fs/remove_dir $"${base}/${name}"))
          (let renamed ((manager_fn "workspace_rename") project/id "todo"))
          ($assert (== renamed/id "todo"))
          ($assert (! ($fs/exists? project/dir)))
          ($assert ($fs/exists? $"${base}/todo/.gene-harness/workspace.gene"))
          # The directory is the registry: anything placed there is listed,
          # but files, hidden directories and symbolic links are not.
          ($fs/make_dir $"${base}/manual")
          ($fs/make_dir $"${base}/.hidden")
          ($fs/write_text $"${base}/notes.txt" "not a workspace")
          ($fs/make_dir $"${root}/outside")
          ($fs/create_symlink $"${root}/outside" $"${base}/linked")
          ($assert (== ($map (/workspaces ((manager_fn "workspace_list"))) /id) ["manual" "todo"]))
          (let archived ((manager_fn "workspace_archive") "todo"))
          ($assert (== archived/archived "todo"))
          ($assert ($fs/exists? $"${service/runtime/root}/archive/todo/.gene-harness/workspace.gene"))
          ((manager_fn "workspace_create") "todo")
          ($assert (== ((Path "archived") ((manager_fn "workspace_archive") "todo")) "todo-2"))
          (let listed ((manager_fn "workspace_list")))
          ($assert (== ($map listed/workspaces /id) ["manual"]))
          ($assert (== listed/archived ["todo" "todo-2"]))
          (let with_archive (ui_preview service/runtime "workspaces"))
          ($assert ($absent? with_archive/error) ($to_str with_archive))
          ((manager_fn "workspace_create") "todo")
          (var conflicted false)
          (try
            ((manager_fn "workspace_restore") "todo")
          catch ManagerError
            (set conflicted true))
          ($assert conflicted)
          (let restored ((manager_fn "workspace_restore") "todo-2"))
          ($assert (== restored/id "todo-2"))
          ($assert (== ($map (/workspaces (manager_list manager)) /id) ["manual" "todo" "todo-2"]))
          ($assert (! ($fs/exists? $"${service/runtime/root}/registry.gene")))
        ensure
          (close_session_service service)))))
  (it
    "addresses workspaces by exact name, moves only unlocked directories and keeps archive names restorable"
    []
    (isolated
      this_mod/.path
      "addresses workspaces by exact name, moves only unlocked directories and keeps archive names restorable"
      (fn [root]
        (let service (manager_service root))
        (try
          (let manager service/runtime/services/values/manager)
          (let base $"${service/runtime/root}/workspaces")
          (let archive $"${service/runtime/root}/archive")
          (fn refused? [operation, values]
            (try
              (manager_operation manager operation values)
              false
            catch ManagerError
              true))
          # A hand-placed "project " is its own workspace, never "project".
          (manager_operation manager "create" {^name "project"})
          ($fs/make_dir $"${base}/project ")
          ($assert (== ($map (/workspaces (manager_list manager)) /id) ["project" "project "]))
          (manager_operation manager "archive" {^id "project "})
          ($assert ($fs/exists? $"${archive}/project "))
          ($assert ($fs/exists? $"${base}/project"))
          # Each lock blocks every move for as long as it is held.
          (let held (acquire_workspace_lock $"${base}/project" "test owner"))
          (try
            ($assert (refused? "archive" {^id "project"}))
            ($assert (refused? "rename" {^id "project" ^name "moved"}))
          ensure
            (close_workspace_lock held))
          (let launcher ($fs/try_lock $"${base}/project/.gene-harness/launcher_lock"))
          (try
            ($assert (refused? "archive" {^id "project"}))
          ensure
            launcher/.close)
          ($assert ($fs/exists? $"${base}/project"))
          (let archived_owner (acquire_workspace_lock $"${archive}/project " "test owner"))
          (try
            ($assert (refused? "restore" {^name "project "}))
          ensure
            (close_workspace_lock archived_owner))
          ($assert ($fs/exists? $"${archive}/project "))
          ($assert (== ((Path "id") (manager_operation manager "restore" {^name "project "})) "project "))
          # A repeated 64-byte name is shortened, not lengthened, by its suffix.
          (let long "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
          (manager_operation manager "create" {^name long})
          (manager_operation manager "archive" {^id long})
          (manager_operation manager "create" {^name long})
          (let second (manager_operation manager "archive" {^id long}))
          ($assert (== ($str/byte_size second/archived) 64) second/archived)
          ($assert ($str/ends_with? second/archived "-2"))
          ($assert (== ((Path "id") (manager_operation manager "restore" {^name second/archived})) second/archived))
        ensure
          (close_session_service service)))))
  (it
    "controls detached hosts and requires browser confirmation before interrupting commands"
    []
    (isolated ^timeout_ms 180000
      this_mod/.path
      "controls detached hosts and requires browser confirmation before interrupting commands"
      (fn [root]
        (let service (manager_service root))
        (let manager service/runtime/services/values/manager)
        (var first nil)
        (var second nil)
        (try
          (set first (manager_operation manager "create" {^name "first"}))
          (set second (manager_operation manager "create" {^name "second"}))
          (let one (manager_operation manager "start" {^id first/id}))
          ($assert (== one/status "running") ($to_str (manager_inspect manager first/id)))
          (let two (manager_operation manager "start" {^id second/id}))
          ($assert (== two/status "running") ($to_str (manager_inspect manager second/id)))
          ($assert (!= one/actual_port two/actual_port))
          (manager_operation manager "port" {^id second/id ^port one/actual_port})
          (let conflict
            ((Path 0)
              ($filter
                ((Path "workspaces") (manager_list manager))
                (fn [item]
                  (== item/id second/id)))))
          ($assert
            (conflict/port_conflicts .contains? "first")
            "A fixed port conflict with an automatically assigned live port was hidden.")
          (manager_operation manager "port" {^id second/id ^port 0})
          ($assert
            (== ((Path "epoch") (manager_operation manager "start" {^id first/id})) one/epoch))
          (let session (cli first/dir ["sessions" "create" "--title" "Busy command"]))
          (cli first/dir ["--session" session/id "--no-wait" "run" "($sleep 30000)"])
          (let refused (manager_operation manager "stop" {^id first/id}))
          ($assert (== refused/status "confirmation_required") ($to_str refused))
          ($assert (== ((Path "epoch") (discover first/dir)) one/epoch))
          (let confirmation
            (browser_action service {^operation "stop" ^id first/id ^^confirm_busy}))
          ($assert (== confirmation/status "done") confirmation/display)
          ($assert (== ((Path "status") (manager_inspect manager first/id)) "stopped"))
          (let changed (manager_operation manager "port" {^id second/id ^port one/actual_port}))
          ($assert changed/pending_port)
          ($assert (== changed/actual_port two/actual_port))
          (let restarted (manager_operation manager "restart" {^id second/id}))
          ($assert (== restarted/status "running"))
          ($assert (== restarted/actual_port one/actual_port))
          ($assert (!= restarted/epoch two/epoch))
          (for operation in ["archive" "rename"]
            (var refused false)
            (try
              (manager_operation manager operation {^id second/id ^name "moved"})
            catch ManagerError
              (set refused true))
            ($assert refused operation))
          ($assert (== ((Path "epoch") (discover second/dir)) restarted/epoch))
          (let removed
            (browser_action service {^operation "delete" ^id first/id ^confirm_dir first/dir}))
          ($assert (== removed/status "done") removed/display)
          ($assert (! ($fs/exists? first/dir)))
        ensure
          (if_not ($absent? first) (stop_project first/dir))
          (if_not ($absent? second) (stop_project second/dir))
          (close_session_service service)))))
  (it
    "rejects stale edits and unsafe names, and deletes workspaces without following links"
    []
    (isolated
      this_mod/.path
      "rejects stale edits and unsafe names, and deletes workspaces without following links"
      (fn [root]
        (let service (manager_service root))
        (try
          (let manager service/runtime/services/values/manager)
          (let project (manager_operation manager "create" {^name "project"}))
          (manager_operation manager "port" {^id project/id ^port 9123})
          (let stale
            (browser_action
              service
              {
                ^operation "settings"
                ^id project/id
                ^port 9124
                ^expected project/metadata_revision}))
          ($assert (== stale/status "failed") ($to_str stale))
          ($assert (== ((Path "port") (read_workspace_settings project/dir)) 9123))
          (for id in ["../project" "." "" "project/.gene-harness"]
            (var refused false)
            (try
              (manager_operation manager "start" {^id id})
            catch ManagerError
              (set refused true))
            ($assert refused id))
          (let mismatched
            (browser_action service {^operation "delete" ^id project/id ^confirm_dir root}))
          ($assert (== mismatched/status "failed"))
          ($assert ($fs/exists? project/dir))
          # A hand-placed project without Harness state is deletable too.
          (let plain $"${service/runtime/root}/workspaces/plain")
          ($fs/make_dir plain)
          ($fs/write_text $"${plain}/notes.txt" "notes")
          (let removed_plain
            (browser_action service {^operation "delete" ^id "plain" ^confirm_dir plain}))
          ($assert (== removed_plain/status "done") removed_plain/display)
          ($assert (! ($fs/exists? plain)))
          (let outside $"${root}/outside")
          ($fs/make_dir outside)
          ($fs/write_text $"${outside}/keep" "keep")
          ($fs/write_text $"${project/dir}/project.txt" "project")
          ($fs/create_symlink outside $"${project/dir}/external")
          (let deleted
            (browser_action service {^operation "delete" ^id project/id ^confirm_dir project/dir}))
          ($assert (== deleted/status "done") deleted/display)
          ($assert (! ($fs/exists? project/dir)))
          ($assert (== ($fs/read_text $"${outside}/keep") "keep"))
        ensure
          (close_session_service service)))))
  (it
    "bounds unavailable-host control without signalling or automatically continuing"
    []
    (isolated ^timeout_ms 180000
      this_mod/.path
      "bounds unavailable-host control without signalling or automatically continuing"
      (fn [root]
        (let service (manager_service root))
        (let manager service/runtime/services/values/manager)
        (let project (manager_operation manager "create" {^name "unavailable"}))
        (let process
          ($os/exec_async ^timeout_ms 120000
            ($os/executable_path)
            "run"
            "--snapshot"
            (source_path "tests/fixtures/manager_unresponsive.gene")
            project/dir))
        (try
          (let due (+ ($os/monotonic_ms) 15000))
          (while (! ($fs/exists? $"${project/dir}/.gene-harness/connection"))
            ($assert (! process/.done?) ($to_str (if process/.done? (await process) "")))
            ($assert (< ($os/monotonic_ms) due))
            ($sleep 25))
          (for operation in ["stop" "restart"]
            (let started ($os/monotonic_ms))
            (var failed false)
            (try
              (manager_operation manager operation {^id project/id})
            catch ManagerError
              (set failed true))
            ($assert failed)
            ($assert (< (- ($os/monotonic_ms) started) 13000))
            ($assert (! process/.done?) "Manager signalled a host it did not own.")
            ($assert (== ((Path "status") (manager_inspect manager project/id)) "unavailable")))
          (let refused
            (browser_action service {^operation "delete" ^id project/id ^confirm_dir project/dir}))
          ($assert (== refused/status "failed"))
          ($assert ($fs/exists? project/dir))
          ($assert (! process/.done?))
          process/.cancel
          process/.join
          ($assert (== ((Path "status") (manager_inspect manager project/id)) "stopped"))
          ($sleep 100)
          ($assert
            (! ($fs/exists? $"${project/dir}/.gene-harness/launcher_lock"))
            "A timed-out operation started a replacement later.")
          (let started (manager_operation manager "start" {^id project/id}))
          ($assert (== started/status "running") ($to_str started))
        ensure
          (if_not process/.done?
            process/.cancel
            process/.join)
          (stop_project project/dir)
          (close_session_service service))))))
(describe "Manager filesystem failures"
  (it "keeps a workspace listed after a partial deletion error and permits a later retry" []
    (isolated this_mod/.path "keeps a workspace listed after a partial deletion error and permits a later retry"
      (fn [root]
        (let service (manager_service root))
        (let manager service/runtime/services/values/manager)
        (let project (manager_operation manager "create" {^name "partial"}))
        (let directories [])
        (var path project/dir)
        (try
          # Exceed the bounded walk's default depth. Reverse removal deletes
          # the final root file, then rmdir encounters a non-empty deep child.
          # This exercises a real partial filesystem error even under root.
          (repeat i in 70
            (set path ($to_str path "/a"))
            ($fs/make_dir path)
            (directories .push path))
          ($fs/write_text $"${project/dir}/z-removed-first" "temporary")
          (let failed (browser_action service
            {^operation "delete" ^id project/id ^confirm_dir project/dir}))
          ($assert (== failed/status "failed") failed/display)
          ($assert (! ($fs/exists? $"${project/dir}/z-removed-first")))
          ($assert ($fs/exists? project/dir))
          ($assert (== (/workspaces/0/id (manager_list manager)) project/id))
          (var at directories/.size)
          (while (> at 0)
            (set at (- at 1))
            ($fs/remove_dir directories/%at))
          (let retried (browser_action service
            {^operation "delete" ^id project/id ^confirm_dir project/dir}))
          ($assert (== retried/status "done") retried/display)
          ($assert (! ($fs/exists? project/dir)))
          ($assert (== (/workspaces (manager_list manager)) []))
        ensure
          (var cleanup_index directories/.size)
          (while (> cleanup_index 0)
            (set cleanup_index (- cleanup_index 1))
            (if ($fs/exists? directories/%cleanup_index) ($fs/remove_dir directories/%cleanup_index)))
          (close_session_service service))))))

(describe "Long-lived manager callbacks"
  (it "starts fresh callback budgets after the activation deadline has passed" []
    (isolated this_mod/.path "starts fresh callback budgets after the activation deadline has passed"
      (fn [root]
        (let state_root (prepare_layout root))
        (let config ($serde/read_data ($fs/read_text $"${state_root}/config.gene")))
        (config .put "response_budget" {^timeout_ms 500 ^max_memory_mb 1024})
        ($fs/write_text_atomic $"${state_root}/config.gene" ($serde/write_data config))
        (let service (manager_service root))
        (try
          (let early (browser_action service {^operation "refresh"}))
          ($assert (== early/status "done") early/display)
          ($sleep 750)
          (let list (/fn (row service/runtime/h "functions" "workspace_list")))
          ($assert (== (/workspaces (list)) []))
          (repeat i in 16
            (let later (browser_action service {^operation "refresh"}))
            ($assert (== later/status "done") later/display))
        ensure (close_session_service service))))))

(describe "Independently started workspaces"
  (it "adopts a host started directly in its workspaces directory and replaces it on explicit Restart" []
    (isolated this_mod/.path "adopts a host started directly in its workspaces directory and replaces it on explicit Restart"
      (fn [root]
        (let service (manager_service root))
        (let manager service/runtime/services/values/manager)
        (let project $"${service/runtime/root}/workspaces/external&co")
        (var original nil)
        (try
          (set original (start_host project))
          ($fs/write_text $"${project}/keep.txt" "project data")
          (let session (cli project ["sessions" "create" "--title" "Existing conversation"]))
          (let secret ($fs/read_text $"${project}/.gene-harness/web_secret"))
          (let listed (/workspaces/0 (manager_list manager)))
          ($assert (== listed/id "external&co"))
          ($assert (== listed/status "running") ($to_str listed))
          ($assert (== listed/epoch original/connection/epoch))
          # Open carries the name as an encoded query component.
          (let rendered ($to_str (ui_preview service/runtime "workspaces")))
          ($assert ($str/contains? rendered "id=external%26co") rendered)
          ($assert (! ($str/contains? rendered "id=external&co")) rendered)
          (let reused (manager_operation manager "start" {^id "external&co"}))
          ($assert (== reused/epoch original/connection/epoch))
          ($assert (! ($fs/exists? $"${project}/.gene-harness/launcher_lock")))
          (let restarted (manager_operation manager "restart" {^id "external&co"}))
          ($assert (== restarted/status "running") ($to_str restarted))
          ($assert (!= restarted/epoch original/connection/epoch))
          (let original_exit (await original/process))
          (set original nil)
          ($assert (== original_exit/status 0))
          ($assert (== ($fs/read_text $"${project}/keep.txt") "project data"))
          ($assert (== ($fs/read_text $"${project}/.gene-harness/web_secret") secret))
          (let sessions (/sessions (api (connect project) "GET" "/sessions")))
          ($assert (== ($size ($filter sessions (fn [item] (== item/id session/id)))) 1))
        ensure
          (stop_project project)
          (if_not ($absent? original) (stop_host original))
          (close_session_service service))))))

(fn main [args] : Int
  (run_spec args))
