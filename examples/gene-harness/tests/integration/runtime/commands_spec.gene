# Tests src/runtime/commands.gene.
(import $test [describe it])
(import [isolated run_spec test_controller] ^from "../../support")
(import [open_runtime close_runtime] ^from "../../../src/runtime/bootstrap")
(import [baseline_profile] ^from "../../../src/profiles/baseline")
(import [submit_command command_receipt parse_submission take_command_attachments cancel_command]
  ^from "../../../src/runtime/commands")
(import [submit_round round_receipt close_round_controller] ^from "../../../src/runtime/round_controller")
(import [Plugin PluginHost] ^from "../../../src/kernel")
(import [recall_body] ^from "../../../src/agents/history")
(import [register_plugin] ^from "../../../src/storage/workspace")

(fn wait_command [manager, id]
  (manager/watchers .get; .get $"default:${id}"; .join)
  (command_receipt manager "default" id))

(fn command [runtime, text]
  (let receipt (submit_command runtime/commands "default" text))
  (runtime/commands/watchers .get; .get $"default:${receipt/id}"; .join)
  (command_receipt runtime/commands "default" receipt/id))

(describe "Harness commands"
  (it
    "parses raw commands and preserves run isolation, streamed shell output and attachments"
    []
    (isolated
      this_mod/.path
      "parses raw commands and preserves run isolation, streamed shell output and attachments"
      (fn [workspace]
        (let runtime (open_runtime workspace "default" (baseline_profile)))
        (let manager runtime/commands)
        (let seen ($cell nil))
        (let controller
          (test_controller
            runtime
            (fn [request]
              (seen .set request/messages)
              "(Outcome ^done true ^reply \"done\")")))
        (try
          (let parsed
            (parse_submission
              runtime/h
              """/run  (+ 1 2)
"""))
          ($assert
            (==
              parsed/raw
              """ (+ 1 2)
""")
            "raw command arguments changed")
          (let literal (parse_submission runtime/h "//path"))
          ($assert (== literal/text "/path") "literal slash was not escaped")
          ($assert
            (try
              (parse_submission runtime/h "/rnu 1")
              false
            catch Any
              true)
            "unknown slash command was sent to the model")
          (let run (submit_command manager "default" "/run (+ 1 2)"))
          (let joined (manager/watchers .get; .get $"default:${run/id}"; .join))
          ($assert (== ($head joined) TaskOutcome/ok) "command watcher failed")
          (let ran (command_receipt manager "default" run/id))
          ($assert (== ran/status "done") $"run failed: ${ran}")
          ($assert ($str/contains? ran/display "3") "run did not display its value")
          (let hidden (submit_command manager "default" "/run Outcome"))
          (manager/watchers
            .get
            ; .get $"default:${hidden/id}"
            ; .join)
          (let failure (command_receipt manager "default" hidden/id))
          ($assert (== failure/status "failed") "run exposed Outcome")
          (let shell (submit_command manager "default" "/sh printf 'hello\\n'"))
          (manager/watchers
            .get
            ; .get $"default:${shell/id}"
            ; .join)
          (let exited (command_receipt manager "default" shell/id))
          ($assert (== exited/exit 0) $"shell failed: ${exited}")
          ($assert ($str/contains? exited/display "hello") "shell output was lost")
          ($fs/write_text
            "sample.txt"
            """one
two
three
""")
          (let view (submit_command manager "default" "/view sample.txt:2-3"))
          (manager/watchers
            .get
            ; .get $"default:${view/id}"
            ; .join)
          (let viewed (command_receipt manager "default" view/id))
          ($assert
            (==
              viewed/display
              """two
three""")
            $"view failed: ${viewed}")
          (let round (submit_round controller "default" "u1" 1 "prompt"))
          (controller/watchers
            .get
            ; .get "default"
            ; .join)
          (let messages seen/.get)
          (let round_status (round_receipt controller "default" round/id))
          ($assert (! ($absent? messages))
            $"provider callback was not called: ${round_status}")
          (let last (- messages/.size 1))
          ($assert
            ($str/contains? messages/%last/content "[c1.run]")
            "run did not attach to the next user request")
          ($assert
            ($str/contains? messages/%last/content "user viewed sample.txt:2-3")
            "view did not attach as a pointer")
          ($assert
            (== ($size (take_command_attachments runtime "default")) 0)
            "attachments were reused")
          (let idle_cancel (submit_command manager "default" "/cancel"))
          (manager/watchers
            .get
            ; .get $"default:${idle_cancel/id}"
            ; .join)
          (let cancelled (command_receipt manager "default" idle_cancel/id))
          ($assert
            ($str/ends_with? cancelled/display "No round is running.")
            "idle cancel claimed to stop a round")
          ($println "commands: raw parsing, slash escape, run isolation, streamed shell, view and next-user attachments")
        ensure
          (close_round_controller controller)
          (close_runtime runtime)))))

  (it "caps output, retains recall and cancels process groups while viewing directories and binaries" []
    (isolated this_mod/.path "caps output, retains recall and cancels process groups while viewing directories and binaries"
      (fn [workspace]
        (let runtime (open_runtime workspace "default" (baseline_profile)))
        (let manager runtime/commands)
        (try
          (let large (submit_command manager "default" "/sh head -c 2097152 /dev/zero | tr '\\0' x"))
          (let capped (wait_command manager large/id))
          ($assert (== capped/exit 0) $"large shell command failed: ${capped}")
          (let body (recall_body runtime "default" $"${large/id}.sh"))
          ($assert (== ($str/byte_size body) 1048576) "stored shell output was not capped at 1 MiB")
          ($assert (< ($str/byte_size capped/display) 20000) "display was not elided")
          (let slow (submit_command manager "default" "/sh echo $$ > parent.pid; sleep 60 & echo $! > child.pid; wait"))
          (let deadline (+ ($os/monotonic_ms) 3000))
          (while (&& (! ($fs/exists? "child.pid")) (< ($os/monotonic_ms) deadline)) ($sleep 1))
          ($assert ($fs/exists? "child.pid") "shell child never started")
          (let parent ($str/trim ($fs/read_text "parent.pid")))
          (let child ($str/trim ($fs/read_text "child.pid")))
          (cancel_command manager "default" slow/id)
          (let cancelled (wait_command manager slow/id))
          ($assert (== cancelled/status "cancelled") "command ignored cancellation")
          (for pid in [parent child]
            (var alive ($os/exec "/bin/kill" "-0" pid))
            (let reap_deadline (+ ($os/monotonic_ms) 2000))
            (while (&& (== alive/status 0) (< ($os/monotonic_ms) reap_deadline))
              ($sleep 10)
              (set alive ($os/exec "/bin/kill" "-0" pid)))
            ($assert (!= alive/status 0) $"cancel retained process ${pid}"))
          ($fs/make_dir "folder")
          ($fs/write_bytes "binary" ($binary/from_list [0 1 255]))
          (let directory (wait_command manager (/id (submit_command manager "default" "/view folder"))))
          (let binary (wait_command manager (/id (submit_command manager "default" "/view binary"))))
          ($assert (== directory/view/kind "directory") "directory view was not classified")
          ($assert (== binary/view/kind "binary") "binary view tried to display text")
          ($assert (== binary/view/bytes 3) "binary view omitted size")
          ($println "command edges: 1 MiB cap, recall, process-group cancellation, directory and binary views")
        ensure (close_runtime runtime))))))

(describe "Harness command I/O"
  (it "closes omitted stdin and supports shell-neutral stderr merging and colon paths" []
    (isolated this_mod/.path "closes omitted stdin and supports shell-neutral stderr merging and colon paths"
      (fn [workspace]
        (let runtime (open_runtime workspace "default" (baseline_profile)))
        (try
          (let config ($serde/read_data ($fs/read_text $"${runtime/state_root}/config.gene")))
          (config .put "response_budget" {^timeout_ms 2000 ^max_memory_mb 1024})
          ($fs/write_text $"${runtime/state_root}/config.gene" ($serde/write_data config))
          (let cat (command runtime "/sh cat"))
          ($assert (== cat/exit 0) "omitted shell stdin did not reach EOF")
          (let shell (command runtime "/sh echo hello"))
          ($assert (== shell/exit 0) $"shell-specific redirection failed: ${shell/display}")
          ($fs/write_text "colon:name.txt" "one\ntwo\nthree\n")
          (let range (command runtime "/view colon:name.txt:2-3"))
          ($assert (== range/display "two\nthree") "view lost a colon path or line range")
          ($fs/write_text "file:123" "literal\n")
          ($assert (== (/display (command runtime "/view file:123")) "literal") "existing numeric-colon filename was parsed as a range")
          (let channel ($channel ^capacity 4))
          (let process ($os/exec_stream_async "/bin/sh" "-c" "printf 'out\\n'; printf 'err\\n' >&2" ^stdout_chan channel ^merge_stderr true))
          (let lines [])
          (try (loop (lines .push channel/.recv)) catch ChannelClosed nil)
          (let result (await process))
          ($assert (== lines ["out" "err"]) "merged stderr did not stream in order")
          ($assert (== result/stderr "") "merged stderr was duplicated")
          ($println "command I/O: empty stdin, shell-neutral execution, colon paths and merged stderr")
        ensure (close_runtime runtime))))))

(describe "Harness plugin commands"
  (it "shares context and result identity and delivers raw input, output and attachments" []
    (isolated this_mod/.path "shares context and result identity and delivers raw input, output and attachments"
      (fn [workspace]
        (let runtime (open_runtime workspace "default" (baseline_profile)))
        (try
          (let source (quote (mod plugin
            (import ^from "src/plugin_api.gene" [Plugin PluginHost CommandContext CommandResult])
            (fn init [descriptor]
              (Plugin ^id "echo" ^activate (fn [host]
                (host .PluginHost:contribute "commands"
                  {^name "echo" ^usage "/echo text" ^doc "Echo raw input." ^^raw_input
                   ^run (fn [ctx : CommandContext]
                     (ctx/output "plugin console\n")
                     (CommandResult ^display ctx/raw ^status "done" ^^attached))})))))))
          (register_plugin runtime/workspace runtime/h "echo" ($to_str source))
          (let command (submit_command runtime/commands "default" "/echo  a\nb"))
          (runtime/commands/watchers .get; .get $"default:${command/id}"; .join)
          (let result (command_receipt runtime/commands "default" command/id))
          ($assert (== result/status "done") $"generated command failed: ${result}")
          ($assert result/attached "shared CommandResult lost attachment behavior")
          ($assert ($str/contains? result/display " a\nb") "raw arguments changed")
          ($assert ($str/contains? result/output "plugin console") "plugin command output sink was lost")
          ($println "plugin command: shared context/result identity, raw input, output sink and attachment")
        ensure (close_runtime runtime))))))

(fn main [args] : Int (run_spec args))
