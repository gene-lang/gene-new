(import $test [describe it])
(import $store/fs [Store])
(import [isolated run_spec] ^from "../../support")
(import [open_runtime close_runtime] ^from "../../../src/runtime/bootstrap")
(import [Profile] ^from "../../../src/profiles/profile")
(import [provider_offline] ^from "../../../src/builtin/provider_offline")
(import [PluginHost] ^from "../../../src/plugin_api")
(import [row provide registry_names] ^from "../../../src/kernel")
(import [register_plugin composition_entries composition_revision commit_composition
  load_entry_descriptor revert_plugin plugin_history verify_stored_entry stage_plugin_entry]
  ^from "../../../src/storage/workspace")
(import [validate_plan apply_plan] ^from "../../../src/runtime/plugin_plans")
(import [acquire_snapshot release_snapshot] ^from "../../../src/runtime/composition")
(import [submit_command command_receipt] ^from "../../../src/runtime/commands")
(import [mode_state submit_mode_input close_mode] ^from "../../../src/runtime/input_modes")
(import [assemble_instructions] ^from "../../../src/agents/instructions")
(import [archived_record] ^from "../../../src/storage/plugin_history")
(import [host_build] ^from "../../../src/runtime/host_identity")

(fn command [runtime, input]
  (let receipt (submit_command runtime/commands "default" input))
  (let outcome (runtime/commands/watchers/.get .get $"default:${receipt/id}"; .join))
  ($assert (== ($head outcome) TaskOutcome/ok) ($to_str outcome))
  (command_receipt runtime/commands "default" receipt/id))

(fn invoke [runtime, name]
  (let callback (/fn (row runtime/h "functions" name)))
  (callback))

(fn simple_source [id : Str]
  `(mod plugin
    (import [Plugin PluginHost] ^from "src/plugin_api.gene")
    (fn init [descriptor]
      ($assert (== descriptor/core_interface "gene-harness/PluginHost:3"))
      (Plugin ^id %id ^activate (fn [host]
        ($assert ($absent? host/h))
        (host .PluginHost:contribute "functions"
          {^name ($to_str %id "_version") ^doc "Public source contract." ^fn (fn [] 3)}))))))

(fn public_source [n, marker]
  `(mod plugin @interfaces {^core "gene-harness/PluginHost:3"}
    (import [Plugin PluginHost CommandContext CommandResult OperatorHost DurableRecord] ^from "src/plugin_api.gene")
    (fn init [descriptor]
      ($assert (== descriptor/core_interface "gene-harness/PluginHost:3"))
      (Plugin ^id "compat" ^activate (fn [host]
        ($assert ($absent? host/h))
        ($assert ($absent? host/effects))
        ($assert (! ((host .PluginHost:registry_names) .contains? "views")))
        (for seam in ["loop" "voice/runtime"]
          ($assert (try (host .PluginHost:resolve seam) false
            catch Any (== $err/code "unsupported_interface")))
          ($assert ($absent? (host .PluginHost:row "seams" seam)))
          ($assert (! ((host .PluginHost:row_keys "seams") .contains? seam))))
        (let service (host .PluginHost:resolve "operator/host"))
        (let retained ($cell nil))
        (host .PluginHost:defer (fn []
          ($assert ($absent? host/h))
          ($assert (! ($absent? host/.PluginHost:execution_budget)))
          ($fs/write_text %marker ($to_str %n))))
        (let subscription (host .PluginHost:subscribe DurableRecord (fn [event] nil)))
        ($assert ($absent? subscription/bus))
        subscription/.cancel
        (let observed ($cell 0))
        (host .PluginHost:subscribe DurableRecord (fn [event]
          ($assert (try (event/envelope .put "type" "changed") false catch Any true))
          (observed .set (+ observed/.get 1))))
        (host .PluginHost:contribute "functions" {^name "compat_events" ^doc "Observed inert durable envelopes."
          ^fn (fn [] observed/.get)})
        (host .PluginHost:contribute "functions" {^name "compat_version" ^doc "Public receiver."
          ^fn (fn [] ($assert ($absent? host/h)) host/.PluginHost:execution_budget %n)})
        (host .PluginHost:contribute "functions" {^name "compat_handle" ^doc "Public activation identity."
          ^fn (fn [] host)})
        (host .PluginHost:create_registry {^name "compat_rows" ^^unique ^key "name"
          ^on_remove (fn [receiver, candidate]
            ($assert ($absent? receiver/h))
            receiver/.PluginHost:execution_budget
            ($fs/write_text ($to_str %marker ".removed") ($to_str %n)))})
        (host .PluginHost:contribute "compat_rows" {^name "entry"})
        (host .PluginHost:contribute "functions" {^name "compat_retained" ^doc "Check stale command scope."
          ^fn (fn [] (service .OperatorHost:command "help" retained/.get))})
        (host .PluginHost:contribute "commands" {^name "compat" ^doc "Public typed command."
          ^run (fn [ctx : CommandContext]
            ($assert ($absent? ctx/runtime))
            ($assert ($absent? ctx/manager))
            ($assert ($absent? ctx/snapshot/registries))
            ($assert (== ($head ctx/snapshot/composition_revision) Int))
            (retained .set ctx)
            (let forged (CommandContext ^runtime nil ^manager nil ^session ctx/session
              ^raw ctx/raw ^id ctx/id ^output ctx/output ^snapshot ctx/snapshot))
            ($assert (try (service .OperatorHost:command "help" forged) false
              catch Any (== $err/code "command_required")))
            (service .OperatorHost:command "run" ctx))})
        (host .PluginHost:contribute "commands" {^name "compat_mode" ^doc "Open the public input mode."
          ^run (fn [ctx : CommandContext] (CommandResult ^display "Mode open." ^mode "compat_mode"))})
        (host .PluginHost:contribute "commands" {^name "compat_nested" ^doc "Delegate through a leased public command row."
          ^run (fn [ctx : CommandContext]
            (let nested (host .PluginHost:row "commands" "compat"))
            (nested/run ctx))})
        (host .PluginHost:contribute "input_modes"
          {^name "compat_mode" ^label "Public mode" ^hint "Enter Gene" ^submit_label "Run" ^prompt ">"
           ^classify (fn [text] "input")
           ^run (fn [ctx : CommandContext]
             ($assert ($absent? ctx/runtime))
             ($assert ($absent? ctx/manager))
             (service .OperatorHost:command "run" ctx))
           ^close (fn [session, reason] nil)})
        (host .PluginHost:contribute "prompt" {^name "compat_prompt"
          ^render (fn [context, session]
            ($assert ($absent? context/h))
            ($assert ($absent? context/runtime))
            ($assert (try (context .put "workspace_root" "changed") false catch Any true))
            $"public:${context/workspace_root}:${session/kind}")}))
        ^deactivate (fn [host]
          ($assert ($absent? host/h))
          ($assert (! ($absent? host/.PluginHost:execution_budget))))))))

(describe "Stored interface compatibility"
  (it "rejects stored version-two entries without blocking peers and repairs them only with current source" []
    (isolated this_mod/.path
      "rejects stored version-two entries without blocking peers and repairs them only with current source"
      (fn [root]
        (let profile (Profile ^name "retirement" ^plugins [(provider_offline)] ^provider "offline"))
        (let first (open_runtime root "default" profile))
        (let old_revision ($cell nil))
        (try
          (let retired (stage_plugin_entry first/workspace "retired" (simple_source "retired")))
          (set retired/interfaces {^core "gene-harness/PluginHost:2" ^plugin_api "gene-harness/Plugin:2"})
          (let peer (stage_plugin_entry first/workspace "peer" (simple_source "peer")))
          (old_revision .set (commit_composition first/workspace [retired peer]))
        ensure (close_runtime first))
        (let runtime (open_runtime root "default" profile))
        (try
          ($assert (== (/interfaces (host_build))
            {^core ["gene-harness/PluginHost:3"] ^plugin_api ["gene-harness/Plugin:2"]}))
          ($assert ($str/contains? (runtime/workspace/errors/.get .get "retired")
            "core: requires gene-harness/PluginHost:2"))
          ($assert ($absent? (row runtime/h "functions" "retired_version")))
          ($assert (== (invoke runtime "peer_version") 3))
          (let fixed (register_plugin ^^replace runtime/workspace runtime/h "retired" (simple_source "retired")))
          ($assert (== fixed/status "ready") ($to_str fixed))
          ($assert (== (invoke runtime "retired_version") 3))
          (let before (composition_revision runtime/workspace))
          (let plan (validate_plan runtime {^base_revision before ^restore_revision old_revision/.get ^changes []}))
          ($assert (! plan/valid) ($to_str plan))
          ($assert ($str/contains? ($str/join plan/errors "\n") "gene-harness/PluginHost:2"))
          ($assert (try (revert_plugin runtime/workspace runtime/h "retired" old_revision/.get) false
            catch Any ($str/contains? $err/message "gene-harness/PluginHost:2")))
          ($assert (== (composition_revision runtime/workspace) before))
        ensure (close_runtime runtime)))))

  (it "re-registers retired version-one entries directly and through plans using unannotated source" []
    (isolated this_mod/.path
      "re-registers retired version-one entries directly and through plans using unannotated source"
      (fn [root]
        (let profile (Profile ^name "compatibility" ^plugins [(provider_offline)] ^provider "offline"))
        (for mode in ["direct" "plan"]
          (let workspace ($path/join root mode))
          (let first (open_runtime workspace "default" profile))
          (try
            (let entry (stage_plugin_entry first/workspace "compat" (simple_source "compat")))
            (set entry/interfaces {^core "gene-harness/PluginHost:1" ^plugin_api "gene-harness/Plugin:1"})
            (commit_composition first/workspace [entry])
          ensure (close_runtime first))
          (let restarted (open_runtime workspace "default" profile))
          (try
            ($assert ($absent? (row restarted/h "functions" "compat_version")))
            (if (== mode "direct")
              (then
                (let registered (register_plugin ^^replace restarted/workspace restarted/h "compat" (simple_source "compat")))
                ($assert (== registered/status "ready") ($to_str registered)))
              (else
                (let plan (validate_plan restarted {^base_revision (composition_revision restarted/workspace)
                  ^changes [{^id "compat" ^kind "replace" ^source (simple_source "compat")}]}))
                ($assert plan/valid ($to_str plan/errors))
                (let applied (apply_plan restarted plan/id))
                ($assert (== applied/state "applied") ($to_str applied))))
            ($assert (! ($absent? (row restarted/h "functions" "compat_version"))) mode)
            ($assert (== (invoke restarted "compat_version") 3))
            ($assert (== (/interfaces ($first (composition_entries restarted/workspace)))
              {^core "gene-harness/PluginHost:3" ^plugin_api "gene-harness/Plugin:2"}))
          ensure (close_runtime restarted))
          (let final_runtime (open_runtime workspace "default" profile))
          (try
            ($assert (! ($absent? (row final_runtime/h "functions" "compat_version"))) ($to_str mode ": after restart"))
            ($assert (== (invoke final_runtime "compat_version") 3))
          ensure (close_runtime final_runtime))))))

)

(describe "Versioned activation lifetimes"
  (it "keeps a stored public receiver alive through leased callbacks removal and cleanup then revokes it" []
    (isolated this_mod/.path
      "keeps a stored public receiver alive through leased callbacks removal and cleanup then revokes it"
      (fn [root]
        (let profile (Profile ^name "compatibility" ^plugins []))
        (let marker $"${root}/retired-public")
        (let runtime (open_runtime root "default" profile))
        (try
          (let installed (register_plugin runtime/workspace runtime/h "compat" (public_source 3 marker)))
          ($assert (== installed/status "ready") ($to_str installed))
          (let old_host (invoke runtime "compat_handle"))
          (let lease (acquire_snapshot runtime/h/snapshots))
          (let old_callback (/fn (row runtime/h "functions" "compat_version")))
          (try
            (let replaced (register_plugin ^^replace runtime/workspace runtime/h "compat" (public_source 4 marker)))
            ($assert (== replaced/status "ready") ($to_str replaced))
            ($assert (! ($fs/exists? marker)) "Cleanup ran before the old reader released.")
            ($assert (== (invoke runtime "compat_version") 4))
            ($runtime/with_context {^composition runtime/h/snapshots ^snapshot lease/snapshot}
              (fn [] ($assert (== (old_callback) 3))))
          ensure (release_snapshot runtime/h/snapshots lease))
          ($assert (== ($fs/read_text marker) "3"))
          ($assert (== ($fs/read_text $"${marker}.removed") "3"))
          (let retired_error (try old_host/.PluginHost:execution_budget {^message "unexpected success"}
            catch Any {^code $err/code ^message $err/message}))
          ($assert (== retired_error/code "unavailable") ($to_str retired_error))
          ($assert (try (old_callback) false catch Any true))
        ensure (close_runtime runtime))
        (let restarted (open_runtime root "default" profile))
        (try
          ($assert (== (invoke restarted "compat_version") 4))
          (let receipt (command restarted "/compat (+ 1 2)"))
          ($assert (== receipt/item/value "3") ($to_str receipt))
          ($assert (> (invoke restarted "compat_events") 0))
          (command restarted "/compat_mode")
          (let mode (mode_state restarted/modes "default"))
          (let admitted (submit_mode_input restarted/modes "default" mode/instance "public-input" "(+ 7 8)"))
          (restarted/commands/watchers/.get .get $"default:${admitted/id}"; .join)
          (let mode_receipt (command_receipt restarted/commands "default" admitted/id))
          ($assert (== mode_receipt/item/value "15") ($to_str mode_receipt))
          (close_mode restarted/modes "default" "test-finished")
        ensure (close_runtime restarted))))))

(describe "Shared compatibility admission"
  (it "uses the same precise requirement check for load plan and historical revert without copying host-only support" []
    (isolated this_mod/.path
      "uses the same precise requirement check for load plan and historical revert without copying host-only support"
      (fn [root]
        (let runtime (open_runtime root "default" (Profile ^name "compatibility" ^plugins [])))
        (try
          (set runtime/workspace/interfaces (runtime/workspace/interfaces .assoc "host_only" ["host/Extra:1"]))
          (register_plugin runtime/workspace runtime/h "compat" (simple_source "compat"))
          (let good (composition_entries runtime/workspace))
          ($assert (! (good/0/interfaces .has_key? "host_only")))
          ($assert (== ($head good/0/interfaces/core) Str))
          (for extra in [{^core "gene-harness/PluginHost:99"}
                        {^unknown "unknown/Contract:1"}
                        {^harness_render "gene-harness/HarnessRender:99"}]
            (let bad ($thaw ($freeze good/0)))
            (for [key value] in extra (bad/interfaces .put key value))
            (let direct (try (verify_stored_entry runtime/workspace bad) ""
              catch Any $err/message))
            ($assert ($str/contains? direct "unsupported interface") direct)
            (let loaded (try (load_entry_descriptor runtime/workspace runtime/h bad) ""
              catch Any $err/message))
            ($assert (== direct loaded))
            (let revision (commit_composition runtime/workspace [bad]))
            (let plan (validate_plan runtime {^base_revision revision ^changes []}))
            ($assert (! plan/valid))
            ($assert ((plan/errors .join "\n") .contains? direct))
            (commit_composition runtime/workspace good)
            (let reverted (try (revert_plugin runtime/workspace runtime/h "compat" revision) ""
              catch Any $err/message))
            ($assert (== direct reverted)))
        ensure (close_runtime runtime))))))

(describe "Retired descriptor contracts"
  (it "rejects views and version-3 raw seams before activation and marks their plans invalid" []
    (isolated this_mod/.path
      "rejects views and version-3 raw seams before activation and marks their plans invalid"
      (fn [root]
        (let runtime (open_runtime root "default" (Profile ^name "compatibility" ^plugins [])))
        (try
          (for requirement in ["loop" "voice/runtime" ["seams" "loop"]
                               {^registry "views"} ["views" "entry"] ["$registries" "views"]]
            (let source `(mod plugin @interfaces {^core "gene-harness/PluginHost:3"}
              (import [Plugin] ^from "src/plugin_api.gene")
              (fn init [descriptor]
                (Plugin ^id "retired" ^requires [%requirement]
                  ^activate (fn [host] ($fs/write_text "retired-activated" "bad"))))))
            (let entry (stage_plugin_entry runtime/workspace "retired" source))
            (let failure (try (load_entry_descriptor runtime/workspace runtime/h entry) ""
              catch Any $err/message))
            ($assert ($str/contains? failure "unsupported interface") failure)
            (commit_composition runtime/workspace [entry])
            (let plan (validate_plan runtime {^base_revision (composition_revision runtime/workspace) ^changes []}))
            ($assert (! plan/valid) ($to_str plan))
            ($assert (! ($fs/exists? $"${root}/retired-activated"))))
        ensure (close_runtime runtime))))))

(describe "Failed public activation cleanup"
  (it "keeps the public receiver usable while unwinding a partially activated stored plugin" []
    (isolated this_mod/.path
      "keeps the public receiver usable while unwinding a partially activated stored plugin"
      (fn [root]
        (let runtime (open_runtime root "default" (Profile ^name "compatibility" ^plugins [])))
        (let marker $"${root}/failed-cleanup")
        (try
          (let source `(mod plugin @interfaces {^core "gene-harness/PluginHost:3"}
            (import [Plugin PluginHost ServiceError] ^from "src/plugin_api.gene")
            (fn init [descriptor]
              (Plugin ^id "partial" ^activate (fn [host]
                (host .PluginHost:defer (fn []
                  host/.PluginHost:execution_budget
                  ($fs/write_text %marker "cleanup")))
                (host .PluginHost:create_registry {^name "partial_rows" ^^unique ^key "name"
                  ^on_remove (fn [receiver, candidate]
                    ($assert ($absent? receiver/h))
                    receiver/.PluginHost:execution_budget
                    ($fs/write_text ($to_str %marker ".removed") "removed"))})
                (host .PluginHost:contribute "partial_rows" {^name "entry"})
                (fail (ServiceError ^code "fixture" ^message "planned activation failure")))))))
          (let result (register_plugin runtime/workspace runtime/h "partial" source))
          ($assert (== result/status "error") ($to_str result))
          ($assert ($str/contains? result/message "planned activation failure") ($to_str result))
          ($assert (== ($fs/read_text marker) "cleanup"))
          ($assert (== ($fs/read_text $"${marker}.removed") "removed"))
          ($assert (! ((registry_names runtime/h) .contains? "partial_rows")))
        ensure (close_runtime runtime))))))

(describe "Default source contracts"
  (it "uses the public contract for new ids replacements and plans" []
    (isolated this_mod/.path
      "uses the public contract for new ids replacements and plans"
      (fn [root]
        (let runtime (open_runtime root "default" (Profile ^name "source-contracts" ^plugins [])))
        (let source (quote (mod plugin
          (import [Plugin PluginHost] ^from "src/plugin_api.gene")
          (fn init [descriptor]
            (Plugin ^id "versioned" ^activate (fn [host]
              (host .PluginHost:contribute "functions" {^name "versioned" ^doc "Selected interface."
                ^fn (fn [] {^core descriptor/core_interface ^opaque ($absent? host/h)})})))))))
        (try
          (register_plugin runtime/workspace runtime/h "versioned" source)
          ($assert (== (invoke runtime "versioned") {^core "gene-harness/PluginHost:3" ^opaque true}))
          (register_plugin ^^replace runtime/workspace runtime/h "versioned" source)
          ($assert (== (invoke runtime "versioned") {^core "gene-harness/PluginHost:3" ^opaque true}))
          (let plan (validate_plan runtime {^base_revision (composition_revision runtime/workspace)
            ^changes [{^id "versioned" ^kind "replace" ^source ($to_str source)}]}))
          ($assert plan/valid ($to_str plan/errors))
          ($assert (== plan/entries/0/interfaces/core "gene-harness/PluginHost:3"))
        ensure (close_runtime runtime))))))

(fn main [args] : Int (run_spec args))
