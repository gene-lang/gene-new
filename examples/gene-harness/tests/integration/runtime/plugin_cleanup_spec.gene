(import $test [describe it])
(import [isolated run_spec] ^from "../../support")
(import [Plugin PluginHost ServiceError] ^from "../../../src/plugin_api")
(import [new_harness install put_cordis_plugin shutdown_harness status_of row uninstall]
  ^from "../../../src/kernel")
(import [acquire_snapshot release_snapshot] ^from "../../../src/runtime/composition")
(import [retain_callback expire_scope_callbacks] ^from "../../../src/runtime/retained_callbacks")

(describe "Public plugin cleanup"
  (it "defers cleanup through the final reader and unwinds failed activation once" []
    (isolated this_mod/.path "defers cleanup through the final reader and unwinds failed activation once"
      (fn [root]
        (let h (new_harness))
        (let closed ($cell []))
        (fn plugin [version]
          (Plugin ^id "resource" ^activate (fn [host]
            (let disposed ($cell false))
            (host .PluginHost:defer (fn []
              ($assert (! disposed/.get) "resource closed twice")
              (disposed .set true)
              (closed/.get .push version)))
            (host .PluginHost:contribute "functions"
              {^name "resource_value" ^doc "Read the leased resource."
               ^fn (fn [] ($assert (! disposed/.get)) version)}))))
        (try
          (install h (plugin 1))
          (let lease (acquire_snapshot h/snapshots))
          (try
            (put_cordis_plugin ^^replace h (plugin 2) {^!host})
            ($assert (== closed/.get []))
            ($runtime/with_context {^composition h/snapshots ^snapshot lease/snapshot}
              (fn []
                (let old (/fn (row h "functions" "resource_value")))
                ($assert (== (old) 1))))
          ensure (release_snapshot h/snapshots lease))
          ($assert (== closed/.get [1]))
          (let current (/fn (row h "functions" "resource_value")))
          ($assert (== (current) 2))
          (uninstall h "resource")
          ($assert (== closed/.get [1 2]))
          (install h (Plugin ^id "broken" ^activate (fn [host]
            (host .PluginHost:defer (fn [] (closed/.get .push "failed")))
            (fail "activation failed"))))
          ($assert (== (status_of h "broken") "error"))
          ($assert (== closed/.get [1 2 "failed"]))
          (uninstall h "broken")
          ($assert (== closed/.get [1 2 "failed"]))
        ensure (shutdown_harness h))))))

(describe "Plugin shutdown cleanup"
  (it "attempts every cleanup and reports a deferred failure after closing admission" []
    (isolated this_mod/.path "attempts every cleanup and reports a deferred failure after closing admission"
      (fn [root]
        (let h (new_harness))
        (let calls ($cell []))
        (install h (Plugin ^id "cleanup" ^activate (fn [host]
          (host .PluginHost:defer (fn [] (calls/.get .push "healthy")))
          (host .PluginHost:defer (fn []
            (calls/.get .push "failed")
            (fail (ServiceError ^code "cleanup" ^message "intentional cleanup failure")))))))
        (let result (shutdown_harness h))
        ($assert (== result/status "recovery_required") ($to_str result))
        ($assert ($str/contains? ($to_str result/errors) "intentional cleanup failure"))
        ($assert (== calls/.get/.size 2))
        ($assert (calls/.get .contains? "healthy"))
        ($assert (calls/.get .contains? "failed"))
        ($assert (try (acquire_snapshot h/snapshots) false catch Any true))))))

(describe "Concurrent callback ownership"
  (it "keeps callbacks added by a live activation while another scope's table is being retired" []
    (isolated this_mod/.path
      "keeps callbacks added by a live activation while another scope's table is being retired"
      (fn [root]
        (let h (new_harness))
        (let owner ($cell nil))
        (try
          (install h (Plugin ^id "live" ^activate (fn [host] nil)))
          (owner .set (/effects (h/plugin_policies/.get .get "live")))
          (fn marker [value] (fn [] value))
          (for batch in ($range 0 8)
            (let retired ($cell nil))
            (for at in ($range 0 2000) (retain_callback retired "retiring" (marker at)))
            (let ready ($cell false))
            (let selected ($cell []))
            (let writer (spawn ^lane root (do
              (while (! ready/.get) ($sleep 1))
              (for at in ($range 0 64)
                (selected/.get .push (retain_callback owner/.get "live" (marker at)))
                ($sleep 1)))))
            (let cleaner (spawn ^lane root (do
              (ready .set true)
              (for at in ($range 0 8)
                (expire_scope_callbacks retired)
                ($sleep 1)))))
            ($assert (== ($head writer/.join) TaskOutcome/ok))
            ($assert (== ($head cleaner/.join) TaskOutcome/ok))
            (var at 0)
            (for callback in selected/.get
              ($assert (== (callback) at) $"Live callback lost during retirement in batch ${batch}.")
              (set at (+ at 1)))
            ($assert (== at 64)))
        ensure (shutdown_harness h))))))

(fn main [args] : Int (run_spec args))
