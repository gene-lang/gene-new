# Tests src/runtime/call_supervision.gene.
(import $test [describe it])
(import [isolated run_spec test_service] ^from "../../support")
(import [close_session_service list_sessions] ^from "../../../src/web/session_service")
(import [create_session] ^from "../../../src/runtime/sessions")
(import [submit_round cancel_round round_receipt] ^from "../../../src/runtime/round_controller")
(import [create_trigger list_occurrences delete_trigger] ^from "../../../src/runtime/triggers")
(import [require_trigger_manager] ^from "../../../src/runtime/trigger_host")
(import [contribute] ^from "../../../src/kernel")
(import $net/http [listen serve stop json])
(import $net/http_client [request])

(describe "Harness responsiveness"
  (it "serves HTTP and cancels CPU, native callback and process work within the latency bounds" []
    (isolated this_mod/.path "serves HTTP and cancels CPU, native callback and process work within the latency bounds"
      (fn [workspace]
        # The production contract is measured with its 512-instruction slice.
        # Stress binaries may deliberately run longer slices; permit the same
        # proportional latency there while keeping all progress/cleanup checks.
        # Ordinary binaries have no test query and retain the 100 ms bound.
        (let quantum (try ($runtime/test_scheduler_quantum) catch Any 512))
        (let latency_bound ($math/max 100 (/ (* 100 quantum) 512)))
        ($println $"responsiveness quantum=${quantum}, latency bound=${latency_bound} ms")
        (let entered ($cell false))
        (let code ($cell ""))
        (let ticks ($cell 0))
        (let service (test_service ^workspace workspace ^provider (fn [context]
          (if (== context/session "busy") code/.get "(Outcome ^^done ^reply \"done\")"))))
        (contribute service/runtime/h "core" "functions"
          {^name "entered" ^doc "Mark response entry." ^fn (fn [] (entered .set true))})
        (contribute service/runtime/h "core" "functions"
          {^name "work_tick" ^doc "Count response work."
           ^fn (fn [] (ticks .set (+ ticks/.get 1)))})
        (create_session service/runtime/sessions ^id "busy")
        (create_session service/runtime/sessions ^id "other")
        (let server (listen ^host "127.0.0.1" ^port 0))
        # Serve owns the root event loop, as it does in the browser host. Drive the
        # scenarios from a sibling task so the host can dispatch their requests.
        (let tester (spawn ^lane root (try
          (let port server/port)
          (let url $"http://127.0.0.1:${port}/api/v8/sessions")
          # Initialize the native client before timing the server's response path.
          (await (request ^url url ^timeout_ms 1000))
          (var sequence 0)
          (for scenario in [
            "(entered) (while true (work_tick))"
            "(entered) ($map [1] (fn [n] (while true (work_tick))))"
            "(entered) ($os/exec \"sleep\" \"30\") (Outcome ^^done ^reply \"done\")"]
            (set sequence (+ sequence 1))
            (entered .set false)
            (code .set scenario)
            (let slow (submit_round service/runtime/services/values/controller "busy" ($to_str sequence) sequence "work"))
            (while (! entered/.get) ($sleep 1))
            (let trigger $"responsive-${sequence}")
            (create_trigger (require_trigger_manager service/runtime) {^id trigger ^kind "heartbeat" ^every_ms 20 ^request "tick"})
            (let fast (submit_round service/runtime/services/values/controller "other" ($to_str sequence) sequence "finish"))
            ((/watcher (service/runtime/services/values/controller/rounds/.get .get "other")) .join)
            ($assert (== (/state (round_receipt service/runtime/services/values/controller "other" fast/id)) "done") "busy response blocked another session")
            (var fired false)
            (let until (+ ($os/monotonic_ms) 2000))
            (while (&& (! fired) (< ($os/monotonic_ms) until))
              (for occurrence in (list_occurrences (require_trigger_manager service/runtime) ^trigger trigger)
                (if (== occurrence/state "finished") (set fired true)))
              (if_not fired ($sleep 1)))
            ($assert fired "busy response blocked a heartbeat")
            (delete_trigger (require_trigger_manager service/runtime) trigger)
            (let before ($os/monotonic_ms))
            (let response (await (request ^url url ^timeout_ms 1000)))
            (let latency (- ($os/monotonic_ms) before))
            ($assert (== response/status 200) "HTTP listing failed during busy response")
            ($assert (< latency latency_bound) $"HTTP listing took ${latency} ms (bound ${latency_bound}, quantum ${quantum})")
            (let cancellation ($os/monotonic_ms))
            (let active service/runtime/services/values/controller/rounds/.get/busy/task)
            ($assert (! active/.done?) "responsiveness fixture completed before the cancel request")
            (cancel_round service/runtime/services/values/controller "busy" slow/id)
            active/.join
            (let stopped_after (- ($os/monotonic_ms) cancellation))
            (let stopped_ticks ticks/.get)
            ($sleep 30)
            ($assert (== ticks/.get stopped_ticks) "response work outlived its cancelled round")
            ((/watcher (service/runtime/services/values/controller/rounds/.get .get "busy")) .join)
            (let delay (- ($os/monotonic_ms) cancellation))
            ($println $"cancellation work: ${stopped_after} ms; receipt: ${delay} ms")
            ($assert (< stopped_after latency_bound) $"response work took ${stopped_after} ms to cancel (bound ${latency_bound}, quantum ${quantum})")
            ($assert (== (/state (round_receipt service/runtime/services/values/controller "busy" slow/id)) "cancelled") "busy response ignored cancellation")
            ($println $"responsive scenario ${sequence}: HTTP ${latency} ms, cancellation ${stopped_after} ms"))
        ensure
          (stop server)
          (close_session_service service))))
        (serve server ^tick_ms 1 ^on_tick (fn [] nil) ^handler (fn [request]
          (json 200 ($json/stringify (list_sessions service)))))
        (let outcome tester/.join)
        (match outcome
          (when (TaskOutcome/ok value) value)
          (when (TaskOutcome/error error) (fail error))
          (else ($assert false $"responsiveness task did not finish: ${outcome}")))))))

(fn main [args] : Int (run_spec args))
