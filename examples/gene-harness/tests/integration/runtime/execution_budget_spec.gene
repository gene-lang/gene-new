(import $test [describe it])
(import [isolated run_spec] ^from "../../support")
(import [open_runtime close_runtime prepare_layout] ^from "../../../src/runtime/bootstrap")
(import [Profile] ^from "../../../src/profiles/profile")
(import [ExecutionLimits] ^from "../../../src/plugin_api")
(import [plugin_admin] ^from "../../../src/builtin/plugin_admin")
(import [row] ^from "../../../src/kernel")
(import [current_snapshot] ^from "../../../src/runtime/composition")
(import [evaluate_harness_turn] ^from "../../../src/agents/harness_turn")

(fn helper_source []
  (quote (mod budget_helper
    (import [PluginHost] ^from "src/plugin_api.gene")
    (fn read_budget [host] host/.PluginHost:execution_budget)
    (fn wait_budget [host, milliseconds : Int]
      ($sleep milliseconds)
      host/.PluginHost:execution_budget))))

(fn source [path : Str]
  `(mod plugin
    (import [Plugin PluginHost] ^from "src/plugin_api.gene")
    (import [read_budget wait_budget] ^from %path)
    (fn init [descriptor]
      (Plugin ^id "budget_probe"
        ^provides [["functions" "budget_probe"] ["functions" "budget_wait"]]
        ^activate (fn [host]
          (host .PluginHost:contribute "functions"
            {^name "budget_probe" ^doc "Inspect effective host execution budgets."
             ^fn (fn [] (read_budget host))})
          (host .PluginHost:contribute "functions"
            {^name "budget_wait" ^doc "Wait inside this stored callback."
             ^fn (fn [milliseconds : Int]
               (wait_budget host milliseconds))}))))))

(fn open_probe [workspace : Str, timeout : Int]
  (let state_root (prepare_layout workspace))
  (let config ($serde/read_data ($fs/read_text $"${state_root}/config.gene")))
  (config .put "response_budget" {^timeout_ms timeout ^max_memory_mb 96})
  ($fs/write_text_atomic $"${state_root}/config.gene" ($serde/write_data config))
  (let runtime (open_runtime workspace "default"
    (Profile ^name "budget-test" ^plugins [(plugin_admin)]
      ^limits (ExecutionLimits
        ^max_memory_mb 96 ^timeout_ms timeout))))
  (try
    (let helper (helper_source))
    (let path $"./${($crypto/sha256 ($to_str helper))}.gene")
    (let published (evaluate_harness_turn runtime/h 1 workspace
      ($to_str "(register_plugin \"budget_probe\" (quote " ($to_str (source path))
        ") ^dependencies [(quote " ($to_str helper)
        ")]) (Outcome ^prompt \"Use the published plugin.\")")
      ^round "publication" ^timeout_ms timeout))
    (if_not ($absent? published/error) (fail published/error))
    ($assert (! ($absent? (row runtime/h "functions" "budget_probe")))
      "The stored budget probe did not activate.")
    runtime
  catch Any
    (close_runtime runtime)
    (fail $err)))

(describe "Harness execution budgets"
  (it "raises stored callback and module ceilings while keeping descriptor limits separate" []
    (isolated ^timeout_ms 20000 this_mod/.path
      "raises stored callback and module ceilings while keeping descriptor limits separate"
      (fn [workspace]
        (let runtime (open_probe workspace 900000))
        (try
          (let probe (row runtime/h "functions" "budget_probe"))
          (let budget (probe/fn))
          ($assert (> budget/remaining_ms 600000) "Stored module retained its old 600-second limit.")
          ($assert (== budget/callback_limits/timeout_ms 900000))
          ($assert (== budget/memory_limit_bytes (* 96 1048576)))
          (let snapshot (current_snapshot runtime/h/snapshots))
          (let stored ($first ($filter snapshot/plugins (fn [item] (== item/id "budget_probe")))))
          (let builtin ($first ($filter snapshot/plugins (fn [item] (== item/id "plugin_admin")))))
          ($assert (== stored/callback_limits builtin/callback_limits))
          ($assert (== stored/descriptor_limits/timeout_ms 2000))
          ($assert (== stored/descriptor_limits/max_memory_mb 64))
          ($assert ($absent? builtin/descriptor_limits))
        ensure (close_runtime runtime)))))

  (it "allows stored callbacks beyond two seconds and enforces a lowered callback ceiling" []
    (isolated ^timeout_ms 20000 this_mod/.path
      "allows stored callbacks beyond two seconds and enforces a lowered callback ceiling"
      (fn [workspace]
        (let runtime (open_probe workspace 3000))
        (try
          (let wait (row runtime/h "functions" "budget_wait"))
          (let budget (wait/fn 2100))
          ($assert (> budget/remaining_ms 0))
          ($assert (< budget/remaining_ms 1000))
          (let started ($os/monotonic_ms))
          ($assert (try (wait/fn 5000) false catch Any true))
          ($assert (< (- ($os/monotonic_ms) started) 4000)
            "Sleeping callback outlived its configured ceiling.")
        ensure (close_runtime runtime)))))

  (it "publishes response deadlines and ignores forged deadline fields in task context" []
    (isolated ^timeout_ms 20000 this_mod/.path
      "publishes response deadlines and ignores forged deadline fields in task context"
      (fn [workspace]
        (let runtime (open_probe workspace 5000))
        (try
          (let result (evaluate_harness_turn runtime/h 1 workspace
            "(let first (budget_probe)) ($assert (> first/remaining_ms 0)) ($assert (<= first/remaining_ms 500)) ($assert (! ($absent? first/response_deadline_ms))) (let context ($runtime/context)) (context .put \"response_deadline_ms\" 9223372036854775807) (context .put \"callback_deadline_ms\" 9223372036854775807) ($sleep 10) (let second (budget_probe)) ($assert (<= second/effective_deadline_ms first/effective_deadline_ms)) ($assert (< second/remaining_ms first/remaining_ms)) (Outcome ^^done ^reply \"bounded\")"
            ^round "round-one" ^timeout_ms 500))
          ($assert (== result/kind "done") $"Budget query failed: ${result/error}")
        ensure (close_runtime runtime))))))

(fn main [args] (run_spec args))
