(import $test [describe it])
(import [isolated run_spec] ^from "../../support")
(import [open_runtime close_runtime] ^from "../../../src/runtime/bootstrap")
(import [Profile] ^from "../../../src/profiles/profile")
(import [plugin_admin] ^from "../../../src/builtin/plugin_admin")
(import [Plugin PluginHost] ^from "../../../src/plugin_api")
(import [put_cordis_plugin] ^from "../../../src/kernel")
(import [evaluate_harness_turn] ^from "../../../src/agents/harness_turn")
(import [plugin_history] ^from "../../../src/storage/workspace_repair")

(fn register_observed [runtime, id]
  (let source `(mod plugin
    (import [Plugin] ^from "src/plugin_api.gene")
    (fn init [descriptor] (Plugin ^id %id ^activate (fn [host] nil)))))
  (let response ($to_str "(register_plugin \"" id "\" (quote " ($to_str source)
    ")) (Outcome ^prompt \"Inspect the publication\")"))
  (let result (evaluate_harness_turn runtime/h 1 runtime/root response))
  ($assert (== result/composition_changes/0/status "ready") ($to_str result))
  (let history (plugin_history runtime/workspace id))
  (let observations ($filter history/0/outcomes (fn [item] (== item/result/status "ready"))))
  ($assert (== observations/.size 1) ($to_str history))
  observations/0/result)

(describe "Runtime-owned plugin services"
  (it "keeps live provider readiness in queued composition observations" []
    (isolated this_mod/.path "keeps live provider readiness in queued composition observations"
      (fn [root]
        (let runtime (open_runtime root "default"
          (Profile ^name "observations" ^provider "test" ^plugins [(plugin_admin)])))
        (try
          (let missing (register_observed runtime "before_provider"))
          ($assert (== missing/readiness "degraded"))
          ($assert ($str/contains? missing/readiness_reason "providers/test is missing"))
          (put_cordis_plugin runtime/h
            (Plugin ^id "provider_test" ^provides [["providers" "test"]]
              ^activate (fn [host]
                (host .PluginHost:contribute "providers"
                  {^name "test" ^doc "Readiness fixture."
                   ^configure (fn [model effort timeout] {})
                   ^prepare (fn [call] call) ^send (fn [call] {^text "unused"})}))) {})
          (let ready (register_observed runtime "after_provider"))
          ($assert (== ready/readiness "ready") ($to_str ready))
          ($assert ($absent? ready/readiness_reason))
        ensure (close_runtime runtime))))))

(fn main [args] : Int (run_spec args))
