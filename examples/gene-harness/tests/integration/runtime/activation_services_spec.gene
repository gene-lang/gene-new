(import $test [describe it])
(import [isolated run_spec] ^from "../../support")
(import [open_runtime close_runtime] ^from "../../../src/runtime/bootstrap")
(import [Profile] ^from "../../../src/profiles/profile")
(import [Plugin PluginHost] ^from "../../../src/plugin_api")
(import [register_plugin] ^from "../../../src/storage/workspace_activation")
(import [set_plugin_enabled] ^from "../../../src/storage/workspace_repair")
(import [acquire_snapshot release_snapshot current_snapshot] ^from "../../../src/runtime/composition")
(import [quiesce_services service_states] ^from "../../../src/runtime/activation_services")

# A producer that records its own lifecycle in the shared feature records:
# `<label>/started` while it runs and `<label>/quiesced` once it stops.
(fn producer_source [id : Str, label : Str, ^slot slot = nil, ^takeover takeover : Bool = false, ^fails fails : Bool = false]
  `(mod plugin
    (import [Plugin PluginHost] ^from "src/plugin_api.gene")
    (fn init [descriptor]
      (Plugin ^id %id ^activate (fn [host]
        %(if ($present? slot)
          (if takeover
            `(host .PluginHost:contribute "feature_slots" {^name %slot ^takeover true})
            `(host .PluginHost:contribute "feature_slots" {^name %slot}))
          nil)
        (host .PluginHost:service "producer"
          ^slot %slot
          ^quiesce (fn [] (host .PluginHost:put_record "probe" %($to_str label "/quiesced") true))
          (fn []
            (host .PluginHost:put_record "probe" %($to_str label "/started") true)
            (while true ($sleep 20))))
        %(if fails `(fail "candidate failed") nil))))))

(fn record_of [runtime, key : Str]
  (let found (/0 ($filter (runtime/services/values/plugin_services/records "probe")
    (fn [item] (== item/key key)))))
  (if ($absent? found) nil found/value))

(fn wait_for [runtime, key : Str]
  (var waited 0)
  (while (&& ($absent? (record_of runtime key)) (< waited 3000))
    ($sleep 10)
    (set waited (+ waited 10)))
  (record_of runtime key))

(fn settle [] ($sleep 100))

(fn state_of [runtime, owner : Str]
  (let found (/0 ($filter (service_states runtime/services/values/plugin_services/activation_services)
    (fn [item] (&& (== item/owner owner) (!= item/state "stopped"))))))
  (if ($absent? found) "none" found/state))

# Every stored-plugin reconciliation restarts stored activations, so a
# producer may be quiesced and restarted; the contract is that exactly one
# selected producer runs at a time.
(fn running_count [runtime, owner : Str]
  ($size ($filter (service_states runtime/services/values/plugin_services/activation_services)
    (fn [item] (&& (== item/owner owner) (== item/state "running"))))))

(fn records_plugin []
  (Plugin ^id "writer" ^activate (fn [host]
    (host .PluginHost:contribute "functions" {^name "write_record" ^doc "Write a record."
      ^fn (fn [key : Str, value] (host .PluginHost:put_record "notes" key value))})
    (host .PluginHost:contribute "functions" {^name "drop_record" ^doc "Delete a record."
      ^fn (fn [key : Str] (host .PluginHost:delete_record "notes" key))}))))

(fn reader_source []
  (quote (mod plugin
    (import [Plugin PluginHost] ^from "src/plugin_api.gene")
    (fn init [descriptor]
      (Plugin ^id "reader" ^activate (fn [host]
        (host .PluginHost:contribute "functions" {^name "read_notes" ^doc "Read all notes."
          ^fn (fn [] (host .PluginHost:records "notes"))})
        (host .PluginHost:contribute "functions" {^name "read_note" ^doc "Read one note."
          ^fn (fn [key : Str] (host .PluginHost:record "notes" key))})))))))

(fn call [runtime, name : Str, args...]
  (let lease (acquire_snapshot runtime/h/snapshots))
  (try
    (let found (/0 ($filter (?? (lease/snapshot/registries .get "functions") [])
      (fn [record] (== record/key name)))))
    ((/payload/fn found) args...)
  ensure (release_snapshot runtime/h/snapshots lease)))

(describe "Activation services, feature slots and records"
  (it "shares keyed records across plugin ids and restarts" []
    (isolated this_mod/.path "shares keyed records across plugin ids and restarts"
      (fn [root]
        (let profile (Profile ^name "records" ^plugins [(records_plugin)]))
        (let runtime (open_runtime root "default" profile))
        (try
          ($assert (== (/status (register_plugin runtime/workspace runtime/h "reader" (reader_source))) "ready"))
          (call runtime "write_record" "b" {^text "second"})
          (call runtime "write_record" "a" {^text "first"})
          ($assert (== (call runtime "read_note" "a") {^text "first"}))
          ($assert (== ($map (call runtime "read_notes") /key) ["a" "b"]))
          ($assert (call runtime "drop_record" "a"))
          ($assert (! (call runtime "drop_record" "a")) "deleting an absent record reports false")
          ($assert ($absent? (call runtime "read_note" "a")))
          (let listed (call runtime "read_notes"))
          ($assert (try (listed .push {}) false catch Any true) "record views are immutable")
        ensure (close_runtime runtime))
        (let restarted (open_runtime root "default" profile))
        (try
          ($assert (== ($map (call restarted "read_notes") /key) ["b"]))
          ($assert (== (call restarted "read_note" "b") {^text "second"}))
        ensure (close_runtime restarted)))))

  (it "starts a service only after publication and keeps it through a failed replacement" []
    (isolated this_mod/.path "starts a service only after publication and keeps it through a failed replacement"
      (fn [root]
        (let runtime (open_runtime root "default" (Profile ^name "services" ^plugins [])))
        (try
          (let failed (register_plugin runtime/workspace runtime/h "solo" (producer_source "solo" "never" ^^fails)))
          ($assert (!= failed/status "ready"))
          (settle)
          ($assert ($absent? (record_of runtime "never/started")) "a failed candidate never starts its service")
          ($assert (== (/status (register_plugin ^^replace runtime/workspace runtime/h "solo" (producer_source "solo" "first"))) "ready"))
          ($assert (wait_for runtime "first/started"))
          (let lease (acquire_snapshot runtime/h/snapshots))
          (try
            (let broken (register_plugin ^^replace runtime/workspace runtime/h "solo" (producer_source "solo" "broken" ^^fails)))
            ($assert (!= broken/status "ready"))
            (settle)
            ($assert ($absent? (record_of runtime "broken/started")) "a failed candidate never produces")
            ($assert (== (running_count runtime "solo") 1) "the previous revision stays the producer")
            (let working (register_plugin ^^replace runtime/workspace runtime/h "solo" (producer_source "solo" "second")))
            ($assert (== working/status "ready") ($to_str working))
            ($assert (wait_for runtime "first/quiesced") "the old producer quiesces at publication, before its lease drains")
            ($assert (wait_for runtime "second/started"))
            ($assert (== (running_count runtime "solo") 1) "one producer at a time")
          ensure (release_snapshot runtime/h/snapshots lease))
          (set_plugin_enabled runtime/workspace runtime/h "solo" false)
          ($assert (wait_for runtime "second/quiesced") "disabling stops the producer")
        ensure (close_runtime runtime)))))

  (it "moves a slot between plugin ids only by explicit takeover" []
    (isolated this_mod/.path "moves a slot between plugin ids only by explicit takeover"
      (fn [root]
        (let profile (Profile ^name "slots" ^plugins []))
        (let runtime (open_runtime root "default" profile))
        (try
          ($assert (== (/status (register_plugin runtime/workspace runtime/h "alpha"
            (producer_source "alpha" "alpha" ^slot "probe/feature"))) "ready"))
          ($assert (wait_for runtime "alpha/started"))
          ($assert (== (/status (register_plugin runtime/workspace runtime/h "beta"
            (producer_source "beta" "beta" ^slot "probe/feature"))) "ready"))
          (settle)
          ($assert ($absent? (record_of runtime "beta/started")) "a plain claim does not move a held slot")
          ($assert (== (running_count runtime "alpha") 1))
          ($assert (== (running_count runtime "beta") 0))
          ($assert (== (/status (register_plugin ^^replace runtime/workspace runtime/h "beta"
            (producer_source "beta" "taken" ^slot "probe/feature" ^^takeover))) "ready"))
          ($assert (wait_for runtime "alpha/quiesced") "the previous holder stops producing")
          ($assert (wait_for runtime "taken/started"))
          ($assert (== (running_count runtime "alpha") 0))
          ($assert (== (running_count runtime "beta") 1))
        ensure (close_runtime runtime))
        # The takeover is part of the stored source, so it survives restart.
        (let restarted (open_runtime root "default" profile))
        (try
          (settle)
          ($assert (== (running_count restarted "beta") 1))
          ($assert (== (running_count restarted "alpha") 0))
        ensure (close_runtime restarted)))))

  (it "reports two plain claimants at startup as a conflict and runs neither" []
    (isolated this_mod/.path "reports two plain claimants at startup as a conflict and runs neither"
      (fn [root]
        (let profile (Profile ^name "conflict" ^plugins []))
        (let runtime (open_runtime root "default" profile))
        (try
          (register_plugin runtime/workspace runtime/h "alpha" (producer_source "alpha" "alpha" ^slot "probe/feature"))
          (register_plugin runtime/workspace runtime/h "beta" (producer_source "beta" "beta" ^slot "probe/feature"))
          ($assert (wait_for runtime "alpha/started"))
        ensure (close_runtime runtime))
        (let restarted (open_runtime root "default" profile))
        (try
          (settle)
          ($assert (== (state_of restarted "alpha") "waiting"))
          ($assert (== (state_of restarted "beta") "waiting"))
          (let states (service_states restarted/services/values/plugin_services/activation_services))
          ($assert (/0/conflict states) ($to_str states))
        ensure (close_runtime restarted)))))

  (it "quiesces every producer when the host stops admitting work" []
    (isolated this_mod/.path "quiesces every producer when the host stops admitting work"
      (fn [root]
        (let runtime (open_runtime root "default" (Profile ^name "stop" ^plugins [])))
        (try
          ($assert (== (/status (register_plugin runtime/workspace runtime/h "solo" (producer_source "solo" "run"))) "ready"))
          ($assert (wait_for runtime "run/started"))
          (quiesce_services runtime/services/values/plugin_services/activation_services)
          ($assert (wait_for runtime "run/quiesced"))
          (let late (register_plugin runtime/workspace runtime/h "late" (producer_source "late" "late")))
          ($assert (!= late/status "ready") "no service starts after the host stops")
        ensure (close_runtime runtime))))))

(fn main [args] : Int (run_spec args))
