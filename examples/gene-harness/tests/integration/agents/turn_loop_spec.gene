# Tests src/agents/turn_loop.gene.
(import $test [describe it])
(import [isolated run_spec test_controller] ^from "../../support")
(import [open_runtime close_runtime] ^from "../../../src/runtime/bootstrap")
(import [Profile] ^from "../../../src/profiles/profile")
(import [gene_reference] ^from "../../../src/builtin/gene_reference")
(import [budget_advisory] ^from "../../../src/builtin/budget_advisory")
(import [create_session load_session unload_session require_record] ^from "../../../src/runtime/sessions")
(import [new_round_controller submit_round round_receipt answer_round close_round_controller]
  ^from "../../../src/runtime/round_controller")
(import [events_for] ^from "../../../src/storage/state")
(import [scripted_profile] ^from "../../../src/profiles/scripted")

(describe "Harness turn loop"
  (it
    "retains task and recent failed patch context and exposes per-round budgets"
    []
    (isolated
      this_mod/.path
      "retains task and recent failed patch context and exposes per-round budgets"
      (fn [workspace]
        (let runtime (open_runtime workspace "default"
          (Profile ^name "scripted"
            ^plugins [(gene_reference) (budget_advisory)])))
        (let config_path $"${runtime/state_root}/config.gene")
        (let config ($serde/read_data ($fs/read_text config_path)))
        (config .put "turn_limit" 3)
        ($fs/write_text_atomic config_path ($serde/write_data config))
        (let pieces [])
        (repeat 3000
          (pieces .push "x"))
        (let body ($str/join pieces ""))
        (let prompt $"Build the app. ${body}")
        (let calls ($cell 0))
        (let provider
          (fn [request]
            (calls .set (+ calls/.get 1))
            (let number calls/.get)
            (let latest ($last request/messages))
            ($assert
              ($str/contains? latest/content "[harness_budget]")
              "model cannot see its turn budget")
            ($assert (== request/budget/limit 3) "budget omitted the configured limit")
            (if (== number 1)
              (return
                ($to_str
                  """(Outcome ^prompt "inspect")
<<<asset END
"""
                  body
                  """
END
*** Begin Patch
*** Add File: /invalid.txt
+bad
*** End Patch
""")))
            (if_yes (== number 2)
              ($assert
                ($str/contains? request/messages/1/content prompt)
                "initiating task was elided")
              ($assert
                ($str/contains? request/messages/2/content body)
                "latest attachment was elided before the following turn")
              ($assert
                ($str/contains? request/messages/2/content "*** Add File: /invalid.txt")
                "failed patch body was lost")
              ($assert (== request/budget/remaining 1) "remaining budget was incorrect")
              (return "(append_prompt \"docs\" (doc \"gene/stdlib\")) (Outcome ^prompt \"implement\")"))
            (if_yes (== number 3)
              ($assert
                ($str/contains? request/messages/1/content prompt)
                "task did not survive another turn")
              ($assert
                ($str/contains? latest/content "Standard library inventory")
                "documentation was immediately elided")
              ($assert
                (== request/budget/remaining 0)
                "last response did not know the budget was exhausted")
              (return "(Outcome ^prompt \"RAW_PENDING_REQUEST\")"))
            ($assert (== request/budget/used 1) "continuation did not reset the round budget")
            (let active_metadata (require_record runtime/sessions "default"))
            ($assert
              (! active_metadata/attention)
              "continuation did not acknowledge the prior failure")
            "(Outcome ^^done ^reply \"finished\" ^^attention)"))
        (let controller (test_controller runtime provider))
        (try
          (let receipt (submit_round controller "default" "first" 1 prompt))
          (controller/watchers
            .get
            ; .get "default"
            ; .join)
          (let finished (round_receipt controller "default" receipt/id))
          ($assert (== finished/message "turn limit reached") $"unexpected failure: ${finished}")
          (let replies
            ((events_for runtime/events "session" "default") .filter
              (fn [event]
                (== event/type "reply"))))
          ($assert
            ($str/contains? replies/0/payload/text "continuation")
            "limit reply lacked recovery instructions")
          ($assert
            (! ($str/contains? replies/0/payload/text "RAW_PENDING_REQUEST"))
            "limit reply dumped a pending request")
          (let metadata (require_record runtime/sessions "default"))
          ($assert
            (== metadata/title "Build the app")
            "default conversation title did not use the task's first sentence")
          (submit_round controller "default" "first" 1 prompt)
          (let retried_metadata (require_record runtime/sessions "default"))
          ($assert retried_metadata/attention "idempotent retry acknowledged failure")
          (let continued (submit_round controller "default" "second" 2 "Finish."))
          (controller/watchers
            .get
            ; .get "default"
            ; .join)
          (let completed (round_receipt controller "default" continued/id))
          ($assert (== completed/state "done") "continuation failed")
          (let completed_metadata (require_record runtime/sessions "default"))
          ($assert completed_metadata/attention "new explicit Outcome attention was cleared")
        ensure
          (close_round_controller controller)
          (close_runtime runtime)))))

  (it
    "executes full attachment bytes while recording elided history"
    []
    (isolated
      this_mod/.path
      "executes full attachment bytes while recording elided history"
      (fn [workspace]
        ($fs/make_dir workspace)
        (let root ($fs/real_path workspace))
        (let runtime (open_runtime root "default" (Profile ^name "scripted" ^plugins [])))
        (let lines [])
        (repeat index in 200
          (lines .push $"asset line ${index}"))
        (let body
          ($to_str
            ($str/join
              lines
              """
""")
            """
"""))
        (let path $"${root}/asset.txt")
        (let provider
          (fn [request]
            ($to_str
              "($fs/write_text "
              ($json/stringify path)
              """ (attachment "asset"))
"""
              """(Outcome ^^done ^reply "written")
<<<asset END
"""
              body
              """END
""")))
        (let controller (test_controller runtime provider))
        (try
          (let receipt (submit_round controller "default" "attachment" 1 "write attachment"))
          (controller/watchers
            .get
            ; .get "default"
            ; .join)
          (let finished (round_receipt controller "default" receipt/id))
          ($assert (== finished/state "done") $"attachment round failed: ${finished}")
          ($assert (== ($fs/read_text path) body) "attachment execution wrote an elided stub")
          (let responses
            ((events_for runtime/events "session" "default") .filter
              (fn [event]
                (== event/type "turn/response"))))
          ($assert
            ($str/contains? responses/0/payload/text "elided")
            "history retained the full attachment")
        ensure
          (close_round_controller controller)
          (close_runtime runtime)))))

  (it
    "handles concurrent code responses, receipts and waiting question resumption"
    []
    (isolated
      this_mod/.path
      "handles concurrent code responses, receipts and waiting question resumption"
      (fn [workspace]
        ($fs/make_dir workspace)
        (let root ($fs/real_path workspace))
        (let runtime (open_runtime root "default" (Profile ^name "scripted" ^plugins [])))
        (let calls ($cell {}))
        (let provider
          (fn [request]
            (let count (+ (?? (calls .get; .get request/session) 0) 1))
            (calls
              .get
              ; .put request/session count)
            (if (== request/session "a")
              (if (== count 1)
                """# Inspect
(append_prompt "value" (+ 2 3)) (Outcome ^prompt "continue")"""
                """# Finish
(Outcome ^^done ^reply "a done")""")
              (if (== count 1)
                """# Ask
(Outcome ^questions [{^id "name" ^prompt "Name?"}])"""
                """# Finish
(Outcome ^^done ^reply "b done")"""))))
        (let controller (test_controller runtime provider))
        (try
          (create_session ^id "a" runtime/sessions)
          (create_session ^id "b" runtime/sessions)
          (let a (submit_round controller "a" "request-a" 1 "calculate"))
          (let b (submit_round controller "b" "request-b" 1 "ask"))
          (let duplicate (submit_round controller "a" "request-a" 1 "calculate"))
          ($assert (== duplicate/id a/id) "submission retry changed its round")
          (for [session watcher] in controller/watchers/.get
            watcher/.join)
          (let a_done (round_receipt controller "a" a/id))
          (let b_waiting (round_receipt controller "b" b/id))
          ($assert (== a_done/state "done") $"a failed: ${a_done}")
          ($assert (== b_waiting/state "waiting") $"b failed: ${b_waiting}")
          ($assert (unload_session runtime/sessions "b") "waiting session could not unload")
          (load_session runtime/sessions "b")
          (answer_round controller "b" b_waiting/questions/id {^name "Ada"})
          (controller/watchers
            .get
            ; .get "b"
            ; .join)
          (let b_done (round_receipt controller "b" b/id))
          ($assert (== b_done/state "done") $"question answer did not resume the round: ${b_done}")
          (let transcript (events_for runtime/events "session" "a"))
          (let kinds [])
          (for event in transcript
            (kinds .push event/type))
          ($assert (kinds .contains? "turn/response") "response transcript is missing")
          ($assert (kinds .contains? "turn/request") "request transcript is missing")
          ($assert (kinds .contains? "reply") "reply transcript is missing")
          ($println "turn loop: code responses, concurrent sessions, receipts, waiting unload and question resumption")
        ensure
          (close_round_controller controller)
          (close_runtime runtime))))))

(describe "Provider rows in the turn loop"
  (it "runs a scripted round through prepare and send" []
    (isolated this_mod/.path "runs a scripted round through prepare and send"
      (fn [workspace]
        (let runtime (open_runtime workspace "default"
          (scripted_profile ["(Outcome ^^done ^reply \"from row\")"])))
        (let controller (new_round_controller runtime))
        (try
          (let accepted (submit_round controller "default" "scripted" 1 "go"))
          (controller/watchers .get; .get "default"; .join)
          (let receipt (round_receipt controller "default" accepted/id))
          ($assert (== receipt/state "done")
            $"provider row did not complete the round: ${receipt/message}")
          ($assert (== receipt/reply "from row")
            "scripted row's response was not evaluated")
          (var initial nil)
          (for event in (events_for runtime/events "session" "default")
            (if (&& (== event/type "turn/request")
                    (== event/payload/initial true))
              (set initial event/payload)))
          ($assert ($str/contains? initial/full "[harness_budget]")
            "request/prepare did not add the budget item")
          ($assert (! ($str/contains? initial/settled "[harness_budget]"))
            "budget item contaminated settled history")
        ensure
          (close_round_controller controller)
          (close_runtime runtime))))))

(fn main [args] : Int (run_spec args))
