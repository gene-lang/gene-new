# Tests src/agents/provider_selection.gene.
(import $test [describe it])
(import [isolated run_spec] ^from "../../support")
(import [new_harness shutdown_harness contribute provide] ^from "../../../src/kernel")
(import [Profile] ^from "../../../src/profiles/profile")
(import [scripted_profile] ^from "../../../src/profiles/scripted")
(import [offline_profile] ^from "../../../src/profiles/offline")
(import [open_runtime close_runtime] ^from "../../../src/runtime/bootstrap")
(import [provider_choice select_provider resolve_selection readiness_report session_settings]
  ^from "../../../src/agents/provider_selection")

(fn provider_row [name : Str, rank : Int, reason]
  {^name name ^doc "Synthetic provider." ^auto rank
   ^configure (fn [model, effort, timeout]
     {^model (?? model "default-model") ^effort (?? effort "medium")
      ^timeout_ms timeout})
   ^prepare (fn [call] call)
   ^send (fn [prepared] {^text "done"})})

(describe "Provider selection"
  (it "uses profile, environment, configuration and ranked availability" []
    (isolated this_mod/.path "uses profile, environment, configuration and ranked availability"
      (fn [workspace]
        (let h (new_harness))
        (try
          (contribute h "core" "providers" (provider_row "alpha" 0 "missing credential"))
          (contribute h "core" "providers" (provider_row "beta" 1 nil))
          (contribute h "core" "providers" (provider_row "gamma" 2 nil))
          (provide h "core" "models/catalog" {^snapshot (fn []
            {^providers {^alpha {^connection {^state "sign_in_required" ^reason "missing credential"}}
                         ^beta {^connection {^state "ready"}}
                         ^gamma {^connection {^state "ready"}}}})})
          (let runtime {^h h ^profile (Profile ^name "test" ^plugins [])})
          (let auto (provider_choice ^environment {} runtime {^provider ""}))
          ($assert (== auto/name "beta")
            "automatic selection ignored availability and rank")
          (let unavailable
            (provider_choice ^environment {} runtime {^provider "alpha"}))
          ($assert (== unavailable/reason "missing credential")
            "an explicit unavailable provider silently fell back")
          (let from_env
            (provider_choice ^environment {^GENE_HARNESS_PROVIDER "gamma"}
              runtime {^provider "beta"}))
          ($assert (== from_env/name "beta")
            "environment overrode the saved provider")
          (let pinned
            {^h h ^profile (Profile ^name "scripted" ^plugins []
              ^provider "beta")})
          (let chosen
            (select_provider ^environment
              {^GENE_HARNESS_PROVIDER "gamma"
               ^GENE_HARNESS_MODEL "env-model"
               ^GENE_HARNESS_THINKING_EFFORT "high"}
              pinned {^provider "alpha" ^model "config-model"}))
          ($assert (== chosen/name "beta") "profile pin was ignored")
          ($assert (== chosen/settings/model "default-model")
            "a model from a different provider leaked into the profile pin")
          ($assert ($absent? chosen/settings/effort)
            "effort from a different environment provider leaked into the profile pin")
        ensure
          (shutdown_harness h)))))

  (it "pins scripted and offline provider plugins in their profiles" []
    (isolated this_mod/.path "pins scripted and offline provider plugins in their profiles"
      (fn [workspace]
        (let scripted (open_runtime workspace "default"
          (scripted_profile ["first" "second"])))
        (try
          (let selected (select_provider ^environment
            {^GENE_HARNESS_PROVIDER "other"}
            scripted {^provider "other"}))
          ($assert (== selected/name "scripted")
            "scripted profile did not pin its provider")
          (let prepared (selected/row/prepare {^purpose "turn" ^messages []
            ^settings selected/settings}))
          (let first (selected/row/send prepared))
          ($assert (== first/text "first")
            "scripted provider did not return its first response")
          (let second (selected/row/send prepared))
          ($assert (== second/text "second")
            "scripted provider lost its response position")
          (let exhausted (try (selected/row/send prepared) "accepted"
            catch Any $err/message))
          ($assert (== exhausted "scripted provider exhausted")
            $"scripted exhaustion lost its diagnostic: ${exhausted}")
        ensure
          (close_runtime scripted))
        (let offline (open_runtime workspace "default" (offline_profile)))
        (try
          (let offline_selected (select_provider ^environment {} offline {}))
          ($assert (== offline_selected/name "offline")
            "offline profile did not pin its provider")
          (let offline_prepared (offline_selected/row/prepare
            {^purpose "turn" ^messages [] ^settings offline_selected/settings}))
          (let offline_result (offline_selected/row/send offline_prepared))
          ($assert ($str/contains? offline_result/text "Outcome")
            "offline provider did not return Gene code")
        ensure
          (close_runtime offline))))))

(fn main [args] : Int (run_spec args))
