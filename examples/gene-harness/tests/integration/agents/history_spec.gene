# Tests src/agents/history.gene.
(import $test [describe it])
(import [isolated run_spec] ^from "../../support")
(import [open_runtime close_runtime] ^from "../../../src/runtime/bootstrap")
(import [baseline_profile] ^from "../../../src/profiles/baseline")
(import [bounded_request recall_body append_message provider_context elide_response history_state
         compact_history context_bytes store_body collect_unreferenced_bodies acquire_body_use
         release_body_use]
  ^from "../../../src/agents/history")
(import [create_session delete_session] ^from "../../../src/runtime/sessions")
(import [basic_history_policy] ^from "../../../src/builtin/history_basic")
(import [events_for flush_event_store record_core_state] ^from "../../../src/storage/state")

(describe "Harness history"
  (it
    "enforces UTF-8 byte bounds and retains recall and stable prefixes across restart"
    []
    (isolated
      this_mod/.path
      "enforces UTF-8 byte bounds and retains recall and stable prefixes across restart"
      (fn [workspace]
        (let runtime (open_runtime workspace "default" (baseline_profile)))
        (let workspace_root runtime/root)
        (try
          (let parts ["A"])
          (repeat i in 5000
            (parts .push "🙂"))
          (parts .push "Z")
          (let original ($str/join parts ""))
          (let requests
            (bounded_request
              runtime
              "default"
              [{^id "1.large" ^header "[1.large] line 2: output" ^value original}]))
          ($assert (< ($str/byte_size requests/full) 16384) "large item was not shortened")
          ($assert ($str/starts_with? requests/full "[1.large]") "item header was lost")
          ($assert ($str/contains? requests/full "recall \"1.large\"") "elision omitted recall")
          ($assert
            (== (recall_body runtime "default" "1.large") original)
            "recall changed Unicode bytes")
          ($assert
            (! ($str/contains? requests/settled "🙂"))
            "settled request retained a body over 16 KiB")
          (let items [])
          (let ascii [])
          (repeat position in 12000
            (ascii .push "x"))
          (let large ($str/join ascii ""))
          (let readable
            (bounded_request runtime "default" [{^id "2.docs" ^header "[2.docs]" ^value large}]))
          ($assert (== readable/full readable/settled) "ordinary documentation settled to a stub")
          (repeat item_index in 8
            (items .push
              {^id $"2.output${item_index}" ^header $"[2.output${item_index}]" ^value large}))
          (let capped (bounded_request runtime "default" items))
          ($assert (<= ($str/byte_size capped/full) 65536) "whole request exceeded 64 KiB")
          ($assert
            ($str/contains? capped/full "recall \"2.output7\"")
            "overflow item lacked a stub")
          ($assert (== (recall_body runtime "default" "2.output7") large) "overflow body was lost")
          (append_message ^round "r1" runtime "default" "user" "initial")
          (append_message ^round "r1" ^turn 1 runtime "default" "assistant" "response1")
          (append_message ^settled requests/settled ^round "r1" ^turn 1
            runtime
            "default"
            "user"
            requests/full)
          (let context1 (provider_context runtime "default" "instructions"))
          (append_message ^round "r1" ^turn 2 runtime "default" "assistant" "response2")
          (append_message ^round "r1" ^turn 2 runtime "default" "user" "request2")
          (let context2 (provider_context runtime "default" "instructions"))
          (let prefix1 [context1/0 context1/1 context1/2])
          (let prefix2 [context2/0 context2/1 context2/2])
          ($assert
            (== ($json/stringify prefix1) ($json/stringify prefix2))
            "serialized prefix changed before the previous assistant boundary")
          ($assert (!= context1/3/content context2/3/content) "last full request did not settle")
          ($assert (== context2/3/content requests/settled) "older request settled more than once")
          (let saved (history_state runtime "default"))
          ($assert
            (== saved/messages/1/content "response1")
            "assistant history changed during settlement")
          (let response
            (elide_response
              runtime
              "default"
              3
              ($to_str
                """(Outcome ^prompt "next")
<<<asset END
"""
                large
                """
END
""")))
          ($assert (! ($str/contains? response/text large)) "assistant attachment was not elided")
          ($assert
            (==
              (recall_body runtime "default" "3.attachment.asset")
              ($to_str
                large
                """
"""))
            "attachment recall lost its newline")
          ($println "history: UTF-8 bounds, 16/64 KiB caps, recall, assistant elision and stable prefix")
        ensure
          (close_runtime runtime))
        (let reopened (open_runtime workspace_root "default" (baseline_profile)))
        (try
          ($assert
            (== ($str/byte_size (recall_body reopened "default" "2.output7")) 12000)
            "recall did not survive restart")
          ($println "history: recall survived restart")
        ensure
          (close_runtime reopened)))))

  (it "compacts whole rounds while retaining the newest request and durable summary" []
    (isolated this_mod/.path "compacts whole rounds while retaining the newest request and durable summary"
      (fn [workspace]
        (let runtime (open_runtime workspace "default" (baseline_profile)))
        (try
          (let parts [])
          (repeat position in 5000
            (parts .push "payload "))
          (let large ($str/join parts ""))
          (append_message ^round "old" runtime "default" "user" large)
          (append_message ^round "old" ^turn 1
            runtime
            "default"
            "assistant"
            ($to_str
              """# old goal
(var large """"
              large
              """")
(append_prompt "report" 1)
(Outcome ^prompt "next")"""))
          (append_message ^round "new" runtime "default" "user" "new prompt")
        (let calls ($cell 0))
        (let policy (basic_history_policy {^window_tokens 1000}))
        (let changed
          (compact_history ^policy policy
              runtime
              "default"
              "instructions"
              1000
              (fn [request]
                (calls .set (+ calls/.get 1))
                ($assert (== request/purpose "history/summary") "summary call lacked a purpose")
                "Old round calculated report 1.")))
          ($assert changed "oversized history did not compact")
          ($assert (== calls/.get 1) "compaction did not make one summary call")
          (let state (history_state runtime "default"))
          ($assert (== state/messages/.size 2) "compaction did not replace the oldest whole round")
          ($assert (== state/messages/1/content "new prompt") "compaction changed the newest request")
          ($assert (< (context_bytes state "instructions") 1925) "compaction missed its 55% target")
          (let events (events_for runtime/events "session" "default"))
          (let summaries [])
          (for event in events
            (if (== event/type "history/summary") (summaries .push event)))
          ($assert (== summaries/.size 1) "summary was not durable")
          # Exact boundary and an oversized summary exercise the provider contract,
          # rather than merely checking that some history was replaced.
          (let boundary "threshold")
          (create_session runtime/sessions ^id boundary)
          (let bytes [])
          (repeat i in 2625 (bytes .push "x"))
          (append_message ^round "old" runtime boundary "user" ($str/join bytes ""))
          (let boundary_calls ($cell 0))
          (let summary (fn [request] (boundary_calls .set (+ boundary_calls/.get 1)) large))
          ($assert (! (compact_history ^policy policy runtime boundary "" 1000 summary)) "compaction triggered at or below 75%")
          ($assert (== boundary_calls/.get 0) "threshold check called the provider")
          (append_message ^round "new" runtime boundary "user" "y")
          (compact_history ^policy policy runtime boundary "" 1000 summary)
          ($assert (== boundary_calls/.get 1) "compaction did not use one summary call")
          ($assert (< (context_bytes (history_state runtime boundary) "") 1925)
            "oversized summary exceeded the target")
          (create_session runtime/sessions ^id "active")
          (append_message ^round "active-round" runtime "active" "user" "Keep the initiating task intact.")
          (append_message ^round "active-round" ^turn 1 runtime "active" "assistant" "# inspect")
          (append_message ^round "active-round" ^turn 1 runtime "active" "user" large)
          (append_message ^round "active-round" ^turn 2 runtime "active" "assistant" "# finish")
          (append_message ^round "active-round" ^turn 2 runtime "active" "user" "continue")
          (compact_history ^policy policy runtime "active" "" 1000 (fn [request] "Earlier inspection."))
          (let active (provider_context runtime "active" ""))
          ($assert (== active/2/content "Keep the initiating task intact.") "active-round compaction summarized away the task")
          (append_message ^round "active-round" ^turn 3 runtime "active" "assistant" "# inspect again")
          (append_message ^round "active-round" ^turn 3 runtime "active" "user" large)
          (append_message ^round "active-round" ^turn 4 runtime "active" "assistant" "# finish again")
          (append_message ^round "active-round" ^turn 4 runtime "active" "user" "continue")
          (compact_history ^policy policy runtime "active" "" 1000 (fn [request] "More inspection."))
          (let recompacted (provider_context runtime "active" ""))
          ($assert (== recompacted/2/content "Keep the initiating task intact.") "repeated compaction lost the active task")
          ($println "compaction: threshold, whole-round summary, newest request and durable summary event")
        ensure
          (close_runtime runtime))))))

(describe "Harness retention"
  (it "removes sessions and streams while preserving shared recall and checkpoint fallbacks" []
    (isolated this_mod/.path "removes sessions and streams while preserving shared recall and checkpoint fallbacks"
      (fn [workspace]
        (let runtime (open_runtime workspace "default" (baseline_profile)))
        (let root runtime/root)
        (create_session runtime/sessions ^id "remove")
        (create_session runtime/sessions ^id "keep")
        (let unique (store_body runtime "remove" "1.unique" "unique retained output"))
        (let shared (store_body runtime "remove" "1.shared" "shared output"))
        (store_body runtime "keep" "1.shared" "shared output")
        (flush_event_store runtime/events)
        ($assert (delete_session runtime/sessions "remove") "idle session could not be collected")
        (acquire_body_use runtime)
        ($assert (! (collect_unreferenced_bodies runtime)) "collection raced a live body writer")
        (release_body_use runtime)
        ($assert (collect_unreferenced_bodies runtime) "collection did not run after writers finished")
        # Keep bodies needed by the retained fallback generations, then reclaim
        # them once those generations have aged out.
        ($assert ($fs/exists? $"${runtime/state_root}/blobs/${unique}") "collection broke a retained fallback generation")
        (repeat epoch in 3
          (record_core_state runtime/events "workspace" "workspace" "session/state" "gc-epoch" epoch)
          (flush_event_store runtime/events))
        (collect_unreferenced_bodies runtime)
        ($assert (! ($fs/exists? $"${runtime/state_root}/blobs/${unique}")) "unreferenced output leaked")
        ($assert (== (recall_body runtime "keep" "1.shared") "shared output") "collection removed a shared body")
        (let manifest runtime/events/last_manifest/.get)
        ($assert ($absent? (manifest/streams .get "session:remove")) "collected stream stayed published")
        (close_runtime runtime)
        (let reopened (open_runtime root "default" (baseline_profile)))
        (try
          ($assert ($absent? (reopened/sessions/index/.get .get "remove")) "deleted session reappeared at restart")
          ($assert (== (recall_body reopened "keep" "1.shared") "shared output") "shared recall failed after restart")
          ($println "retention: durable session removal, stream deletion, idle body collection and shared recall after restart")
        ensure (close_runtime reopened))))))

(fn main [args] : Int (run_spec args))
