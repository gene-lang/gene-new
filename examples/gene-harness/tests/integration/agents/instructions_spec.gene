# Tests src/agents/instructions.gene.
(import $test [describe it])
(import [isolated run_spec] ^from "../../support")
(import [open_runtime close_runtime] ^from "../../../src/runtime/bootstrap")
(import [baseline_profile] ^from "../../../src/profiles/baseline")
(import [assemble_instructions response_format render_context] ^from "../../../src/agents/instructions")
(import [workspace_bindings] ^from "../../../src/agents/harness_turn")
(import [acquire_snapshot release_snapshot] ^from "../../../src/runtime/composition")
(import [contribute doc] ^from "../../../src/kernel")
(import [register_plugin] ^from "../../../src/storage/workspace_activation")
(import [set_plugin_enabled restore_plugin] ^from "../../../src/storage/workspace_repair")

(describe "Registry-backed instructions"
  (it "renders concise orientation and dynamic context while loading manuals on demand" []
    (isolated this_mod/.path "renders concise orientation and dynamic context while loading manuals on demand"
      (fn [workspace]
        (let runtime (open_runtime workspace "default" (baseline_profile)))
        (try
          (let session {^kind "interactive"})
          (let initial (assemble_instructions runtime session))
          ($assert ($str/starts_with? initial response_format))
          ($assert ($str/contains? initial $"Workspace: ${runtime/root}\nSession kind: interactive"))
          ($assert ($str/contains? initial "(discover \"topic\")"))
          ($assert ($str/contains? initial "All query words must match"))
          ($assert (! ($str/contains? initial "The rules that catch most errors")))
          ($assert ($str/contains? initial "harness/ui/quickstart"))
          (let overview (doc runtime/h "gene/overview"))
          ($assert ($str/contains? overview "focused tests"))
          ($assert (! ($str/contains? overview "Every construct you are not certain of")))
          (let starter (doc runtime/h "harness/ui/quickstart"))
          ($assert (< ($str/byte_size starter) 16384) "quickstart must fit without output elision")
          ($assert ($str/contains? starter "(mod plugin"))
          ($assert (! ($str/contains? initial "(mod plugin")) "starter source belongs in pull-only docs")
          (contribute runtime/h "core" "prompt"
            {^name "dynamic_probe" ^render (fn [current record]
              $"probe:${record/kind}")})
          (let rendered (assemble_instructions runtime session))
          ($assert ($str/contains? rendered "probe:interactive")
            "dynamic prompt row did not render")
          ($assert ($str/ends_with? rendered (render_context runtime session))
            "dynamic context section did not stay last")
          (contribute runtime/h "core" "docs" {^name "probe" ^text "hello"})
          ($assert (== (doc runtime/h "probe") "hello")
            "docs text row was not readable")
          ($assert ($str/contains? (doc runtime/h "gene/stdlib") "stdlib")
            "Gene reference chapter was not registered")
          ($assert ($str/contains? (doc runtime/h "harness/plugins")
                     "Register from a session")
            "plugin administration chapter was not registered")
          ($assert
            (try
              (doc runtime/h "missing")
              false
            catch Any
              ($str/contains? $err/message "gene/stdlib"))
            "unknown doc did not list registered chapters")
          (let lease (acquire_snapshot runtime/h/snapshots))
          (try
            (let bindings (workspace_bindings runtime/h lease/snapshot "default" runtime/root))
            (for name in ["doc" "discover" "register_plugin" "enable_plugin" "disable_plugin"
                          "restore_plugin" "plugin_states" "inspect_plugin" "session_id"]
              ($assert ($present? (bindings .get name))
                $"shared workspace binding ${name} is absent"))
          ensure
            (release_snapshot runtime/h/snapshots lease))
        ensure
          (close_runtime runtime))))))

(describe "Working instruction plugin"
  (it "replaces preferences on new snapshots and restores the profile default" []
    (isolated this_mod/.path "replaces preferences on new snapshots and restores the profile default"
      (fn [workspace]
        (let runtime (open_runtime workspace "default" (baseline_profile)))
        (try
          (let session {^kind "interactive"})
          (let lease (acquire_snapshot runtime/h/snapshots))
          (try
            (register_plugin ^^replace runtime/workspace runtime/h "working_instructions"
              (quote (mod plugin
                (import ^from "src/plugin_api.gene" [Plugin PluginHost])
                (fn init [descriptor]
                  (Plugin ^id "working_instructions"
                    ^activate (fn [host]
                      (host .PluginHost:contribute "prompt"
                        {^name "working_instructions" ^text "Prefer short investigation notes."})))))))
            (let current (assemble_instructions runtime session))
            ($assert ($str/contains? current "Prefer short investigation notes."))
            ($assert (! ($str/contains? current "Start with a # goal comment")))
            ($assert (! ($str/contains? current "Include ^reply in every intermediate")))
            ($assert (! ($str/contains? current "Discover before guessing an API")))
            ($assert ($str/starts_with? current response_format))
            ($assert ($str/contains? current "(discover \"topic\")"))
            (let previous
              ($runtime/with_context {^composition runtime/h/snapshots ^snapshot lease/snapshot}
                (fn [] (assemble_instructions runtime session))))
            ($assert ($str/contains? previous "Start with a # goal comment"))
            ($assert (! ($str/contains? previous "Prefer short investigation notes.")))
          ensure
            (release_snapshot runtime/h/snapshots lease))
          (set_plugin_enabled runtime/workspace runtime/h "working_instructions" false)
          (let disabled (assemble_instructions runtime session))
          ($assert (! ($str/contains? disabled "Prefer short investigation notes.")))
          ($assert ($str/starts_with? disabled response_format))
          ($assert ($str/contains? disabled "session_id and workspace_root"))
          (restore_plugin runtime/workspace runtime/h "working_instructions")
          ($assert ($str/contains? (assemble_instructions runtime session)
            "Start with a # goal comment"))
        ensure (close_runtime runtime))))))

(fn main [args] : Int (run_spec args))
