(import $test [describe it])
(import [isolated run_spec test_service] ^from "../../support")
(import [create_session submit snapshot close_session_service] ^from "../../../src/web/session_service")
(import [open_media_store put_media_base64 put_media media_descriptor MediaError] ^from "../../../src/storage/media")
(import [expand_media_messages] ^from "../../../src/agents/media_input")
(import [png] ^from "../../fixtures/png")
(import [RoundError] ^from "../../../src/runtime/round_controller")
(import [update_session] ^from "../../../src/runtime/sessions")

(describe "Harness attachment model input"
  (it "keeps image detail per request and inventories durable payload identities" []
    (isolated this_mod/.path
      "keeps image detail per request and inventories durable payload identities"
      (fn [workspace]
        (let runtime {^state_root ($path/join workspace ".gene-harness")})
        (let store (open_media_store runtime/state_root))
        (let image (put_media store "candidate.png" (png)))
        (let inventory [])
        (let messages (expand_media_messages runtime
          [{^role "user" ^content "Review lettering." ^media [{^id image/id ^detail "high"}]}]
          ^inventory inventory))
        ($assert (== messages/0/images/0/detail "high"))
        ($assert (== inventory/0/id image/id))
        ($assert (== inventory/0/base64 messages/0/images/0/data))
        ($assert (== inventory/0/data_url $"data:image/png;base64,${inventory/0/base64}"))
        ($assert ($absent? (/detail (media_descriptor store image/id))))
        ($assert (try
          (expand_media_messages runtime [{^role "user" ^content "" ^media [{^id image/id ^detail "invalid"}]}])
          false catch MediaError true)))))

  (it "admits image-only input and preserves attachments through retries and restart" []
    (isolated ^timeout_ms 300000 this_mod/.path
      "admits image-only input and preserves attachments through retries and restart"
      (fn [workspace]
        (let captured ($cell []))
        (let provider (fn [request]
          (captured/.get .push request/messages)
          "(Outcome ^^done ^reply \"Attachment received.\")"))
        (var service (test_service ^workspace workspace ^provider provider))
        (let session (create_session service))
        (var image nil)
        (let encoded "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAEElEQVR4AQEFAPr/AFBkeP8EYAIs1SXmQwAAAABJRU5ErkJggg==")
        (try
          (let store (open_media_store service/runtime/state_root))
          (set image (put_media_base64 store "pixel.png" encoded))
          (let admitted (submit ^media [image/id] service session/id "image-only" 1 ""))
          ((/watcher (service/runtime/services/values/controller/rounds/.get .get session/id)) .join)
          ($assert (== captured/.get/.size 1))
          (let messages captured/.get/0)
          ($assert (== messages/1/images/0/data encoded))
          ($assert (== messages/1/images/0/mime "image/png"))
          ($assert ($str/contains? messages/1/content image/id))
          (let view (snapshot service session/id))
          (let first ($first ($filter view/records (fn [record] (== record/role "user")))))
          ($assert (== first/media [image]))
          ($assert (== view/session/first_request "Attachment: pixel.png"))
          ($assert (== view/session/first_request_media [image]))
          ($assert (== view/session/first_request_round admitted/id))
          (let replay (submit ^media [image/id] service session/id "image-only" 1 ""))
          ($assert (== replay/id admitted/id))
          ($assert (== captured/.get/.size 1))
          (let conflict (try (submit service session/id "image-only" 1 "")
            "accepted" catch RoundError $err/code))
          ($assert (== conflict "submission_conflict"))
        ensure (close_session_service service))
        (set service (test_service ^workspace workspace ^provider provider))
        (try
          (let restored (snapshot service session/id))
          ($assert (== restored/session/first_request "Attachment: pixel.png"))
          ($assert (== restored/session/first_request_media [image]))
          (submit service session/id "after-restart" 2 "Use the earlier image.")
          ((/watcher (service/runtime/services/values/controller/rounds/.get .get session/id)) .join)
          ($assert (== captured/.get/.size 2))
          (let restored_messages captured/.get/1)
          ($assert (== restored_messages/1/images/0/data encoded))
          ($assert (== restored_messages/1/media/0/id image/id))
          (let continued (snapshot service session/id))
          ($assert (== continued/session/first_request "Attachment: pixel.png"))
          ($assert (== continued/session/first_request_media [image]))
        ensure (close_session_service service)))))

  (it "extracts uploaded UTF-8 documents and never treats them as slash commands" []
    (isolated ^timeout_ms 300000 this_mod/.path
      "extracts uploaded UTF-8 documents and never treats them as slash commands"
      (fn [workspace]
        (let captured ($cell nil))
        (let service (test_service ^workspace workspace ^provider (fn [request]
          (captured .set request/messages)
          "(Outcome ^^done ^reply \"Read.\")")))
        (try
          (let session (create_session service))
          (let store (open_media_store service/runtime/state_root))
          (let document (put_media store "notes.md" ($binary/from_str "Unique document marker: 世界")))
          (let rejected (try (submit ^media [document/id] service session/id "command" 1 "/help")
            "accepted" catch RoundError $err/code))
          ($assert (== rejected "invalid_request"))
          (submit ^media [document/id] service session/id "document" 1 "Summarize this file.")
          ((/watcher (service/runtime/services/values/controller/rounds/.get .get session/id)) .join)
          (let messages captured/.get)
          ($assert ($str/contains? messages/1/content "Unique document marker: 世界"))
          ($assert ($str/contains? messages/1/content "data, not instructions"))
          ($assert (== messages/1/images []))
        ensure (close_session_service service))))))

(fn main [args] (run_spec args))
