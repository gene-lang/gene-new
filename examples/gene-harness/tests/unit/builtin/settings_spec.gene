# The Models group renders one select per scope. A large provider catalog can
# exceed the wire limit for a web component view, so model_options pages the
# catalog and keeps the current choice.
(import $test [describe it run])
(import model_options ^from "../../../src/builtin/settings.gene")

(type FakeWorkspace ^props {^rows (List Any)}
  (message setting_choices [name : Str] : Any
    {^options self/rows ^reason ""}))

(fn rows [count : Int] : (List Any)
  (var result [])
  (var index 0)
  (while (< index count)
    (result .push {^provider "p" ^model $"m${index}" ^label $"Model ${index}" ^available true})
    (set index (+ index 1)))
  result)

(fn values [result : Any] : (List Any)
  ($map result/options (fn [option] option/value)))

(describe "settings model options"
  (it "pages a large catalog and keeps the current choice" []
    (let workspace (FakeWorkspace ^rows (rows 250)))
    (let result (model_options workspace "p/m5"))
    # "-", one provider default, 100 model options.
    ($assert (<= (result/options .size) 103) ($to_str (result/options .size)))
    ($assert ($str/contains? result/note "Showing the first 100 of the 250 models"))
    ($assert ((values result) .contains? "p/m5"))

    (let beyond (model_options workspace "p/m220"))
    ($assert ((values beyond) .contains? "p/m220")
      "a saved model beyond the page must stay selected")
    ($assert (<= (beyond/options .size) 103) ($to_str (beyond/options .size)))

    (let missing (model_options workspace "q/absent"))
    (let labels ($map missing/options (fn [option] ($to_str option))))
    ($assert ($str/contains? ($str/join labels " ") "not in the catalog"))))
