# A ratchet for the migration: new built-ins use the public contract and shared
# helpers. Existing private dependencies are explicit, and stale exceptions fail.
(import $test [describe it])
(import [sdk_modules] ^from "../../../src/runtime/plugin_sdk")

(fn private_imports [] {})

(describe "Built-in import boundary"
  (it "admits public dependencies and only the remaining named private exceptions" []
    (let exceptions (private_imports))
    (let shared (sdk_modules))
    (let observed {})
    (let root ($path/join this_pkg/root "src" "builtin"))
    (for name in ($fs/list_dir root)
      (if_not ($str/ends_with? name ".gene") (continue))
      (for form in ($parse/read_all ($fs/read_text ($path/join root name)))
        (if_not (["import" "import_impl"] .contains? ($to_str ($head form))) (continue))
        # Native libraries and explicitly named Gene/genex packages are public.
        (if (|| (!= ($head form/from) Str) (! ($absent? form/pkg))) (continue))
        (let path form/from)
        (let file_path ($path/join root name))
        (let resolved ($path/normalize ($path/join ($path/parent file_path)
          (if ($str/ends_with? path ".gene") path ($to_str path ".gene")))))
        (if (shared .contains? ($path/relative resolved this_pkg/root)) (continue))
        ($assert ((?? (exceptions .get name) []) .contains? path)
          $"${name} imports host internals: ${path}; use a narrow public protocol")
        (observed .put ($to_str name ":" path) true)))
    (for [name paths] in exceptions
      (for path in paths
        ($assert (== (observed .get ($to_str name ":" path)) true)
          $"Remove the retired import exception ${name}: ${path}"))))

  (it "keeps public helpers independent of private host implementation modules" []
    (let shared (sdk_modules))
    (for path in shared
      (let file ($path/join this_pkg/root path))
      ($assert ($fs/exists? file) $"Missing declared public module ${path}")
      (for form in ($parse/read_all ($fs/read_text file))
        (if_not (["import" "import_impl"] .contains? ($to_str ($head form))) (continue))
        (if (|| (!= ($head form/from) Str) (! ($absent? form/pkg))) (continue))
        (let from form/from)
        (let resolved ($path/normalize ($path/join ($path/parent file)
          (if ($str/ends_with? from ".gene") from ($to_str from ".gene")))))
        ($assert (shared .contains? ($path/relative resolved this_pkg/root))
          $"Public module ${path} imports private host code: ${from}")))))
