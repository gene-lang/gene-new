# Tests src/builtin/provider_claude.gene.
(import $test [describe it run])
(import [claude_text] ^from "../../../src/builtin/provider_claude")
(import [raw_blocks] ^from "./support")

(describe "Harness provider response bytes"
  (it
    "preserves Claude CLI output text and EOF blocks"
    []
    (raw_blocks
      (fn [text]
        (claude_text
          {
            ^status 0
            ^stdout ($json/stringify
                      {^type "result" ^subtype "success" ^is_error false ^result text})})))))

(fn main [args] : Int
  (let result (run ^name (?? args/0 "")))
  result/exit_code)
