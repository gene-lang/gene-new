# Tests src/builtin/provider_claude.gene.
(import $test [describe it run])
(import [claude_text claude_request] ^from "../../../src/builtin/provider_claude")
(import [raw_blocks] ^from "./support")

(describe "Harness provider response bytes"
  (it
    "preserves Claude CLI output text and EOF blocks"
    []
    (raw_blocks
      (fn [text]
        (claude_text
          {
            ^status 0
            ^stdout ($json/stringify
                      {^type "result" ^subtype "success" ^!is_error ^result text})})))))

(describe "Claude effort arguments"
  (it "omits auto effort and sends a complete flag-value pair for explicit levels" []
    (for effort in [nil "none" "low" "max"]
      (let request (claude_request {^model "sonnet" ^effort effort ^claude_command "claude"} "rules" "go"))
      (if (== effort "none")
        ($assert ($str/contains? ($str/join request/args " ") "\"alwaysThinkingEnabled\":false")
          "thinking off must use the CLI settings even though --effort is omitted"))
      (for arg in request/args ($assert (== ($head arg) Str)))
      (if (["low" "max"] .contains? effort)
        (then
          ($assert (request/args .contains? "--effort"))
          ($assert ($str/contains? ($str/join request/args " ") $"--effort ${effort}")))
        (else ($assert (! (request/args .contains? "--effort"))))))))

(fn main [args] : Int
  (let result (run ^name (?? args/0 "")))
  result/exit_code)
