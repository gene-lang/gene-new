# Tests src/builtin/provider_anthropic.gene.
(import $test [describe it before_each assert_equal run])
(import [prepare_anthropic anthropic_text] ^from "../../../src/builtin/provider_anthropic")
(import [raw_blocks] ^from "./support")
(import [configure_model] ^from "../../../src/public/provider")
(import [anthropic_models] ^from "../../../src/public/model_defaults")

(describe "Harness provider requests"
  (before_each [t]
    (let messages [
      {^role "system" ^content "instructions"}
      {^role "user" ^content "prompt"}
      {^role "assistant" ^content "response1"}
      {^role "user" ^content "request1"}
      {^role "assistant" ^content "response2"}
      {^role "user" ^content "request2"}])
    (set t/spec
      (prepare_anthropic
        {^purpose "turn" ^messages messages
         ^settings (configure_model "test" "auto" 600000 "unused")
         ^max_tokens 100})))

  (it "retains the conversation history" [t]
    (assert_equal t/spec/body/messages/.size 5))

  (it "marks the previous assistant cache checkpoint" [t]
    (assert_equal t/spec/body/messages/1/content/0/cache_control/type "ephemeral"))

  (it "marks the latest assistant cache checkpoint" [t]
    (assert_equal t/spec/body/messages/3/content/0/cache_control/type "ephemeral")))

(describe "Harness provider response bytes"
  (it
    "preserves Anthropic output text and EOF blocks"
    []
    (raw_blocks
      (fn [text]
        (anthropic_text
          {
            ^status 200
            ^body ($json/stringify
                    {
                      ^type "message"
                      ^role "assistant"
                      ^stop_reason "end_turn"
                      ^content [{^type "text" ^text text}]})})))))

(describe "Anthropic model effort"
  (it "uses per-model defaults and supported forms for thinking off" []
    (let opus (configure_model ^catalog (anthropic_models) "claude-opus-5-5" "none" 600000 "unused"))
    (let sonnet (configure_model ^catalog (anthropic_models) "claude-sonnet-5-5" "none" 600000 "unused"))
    ($assert (== opus/effort "low"))
    ($assert (== sonnet/effort "none"))
    (let messages [{^role "system" ^content "instructions"} {^role "user" ^content "go"}])
    (let adaptive (prepare_anthropic {^settings opus ^messages messages}))
    ($assert (== adaptive/body/thinking/type "adaptive"))
    ($assert (== adaptive/body/output_config/effort "low"))
    (let off (prepare_anthropic {^settings sonnet ^messages messages}))
    ($assert (== off/body/thinking/type "between_tools"))
    ($assert ($absent? off/body/output_config))
    ($assert (== (/effort (configure_model ^catalog (anthropic_models)
      "claude-sonnet-5-5" "auto" 600000 "unused")) "high"))
    (let unknown (configure_model "custom" "auto" 600000 "unused"))
    (let omitted (prepare_anthropic {^settings unknown ^messages messages}))
    ($assert ($absent? omitted/body/output_config))
    ($assert ($absent? omitted/body/thinking))))

(fn main [args] : Int
  (let result (run ^name (?? args/0 "")))
  result/exit_code)
