(import $test [describe it run])
(import [new_harness contribute shutdown_harness row] ^from "../../../src/kernel")
(import [new_voice_state claim_voice voice_snapshot] ^from "../../../src/runtime/voice_state")
(import [open_event_store close_event_store append_core_event events_for] ^from "../../../src/storage/state")
(import [new_voice_hub add_voice_peer voice_message tick_voice close_voice_hub] ^from "../../../src/web/voice")
(import [encode_audio_frame decode_audio_frame] ^from "../../../src/public/voice_frames")

(fn until [condition, detail]
  (let due (+ ($os/monotonic_ms) 3000))
  (while (! (condition))
    ($assert (< ($os/monotonic_ms) due) ($to_str "Voice job did not settle: " (detail)))
    ($sleep 5)))

(describe "Ephemeral voice socket"
  (it "requires hello, segments PCM, bounds unplayed speech and fences cancellation and claims" []
    (let root $"/private/tmp/gene-voice-socket-${($crypto/random_hex 8)}")
    ($fs/make_dir root)
    ($fs/write_text $"${root}/config.gene" ($serde/write_data {}))
    (let events (open_event_store $"${root}/events"))
    (let h (new_harness ^event_store events))
    (let runtime {^h h ^events events ^services {^values {}} ^state_root root ^profile {^voice {^recognizer "fixed" ^synthesizer "fixed"}}})
    (set runtime/services/values/voice (new_voice_state runtime))
    (let spoken ($cell 0))
    (let samples [255 127])
    (while (< samples/.size 320) (samples .push 0))
    (let pcm ($binary/from_list samples))
    (contribute h "core" "speech_recognizers"
      {^name "fixed" ^auto 1 ^mode "segments" ^available (fn [] nil)
       ^open (fn [settings] {}) ^close (fn [resource] nil)
       ^transcribe (fn [resource pcm settings] "fixture speech")})
    (contribute h "core" "speech_synthesizers"
      {^name "fixed" ^auto 1 ^^streaming ^format {^rate 24000 ^channels 1 ^encoding "s16le"}
       ^available (fn [] nil) ^open (fn [settings] {}) ^close (fn [resource] nil)
       ^synthesize (fn [resource text settings emit]
         (var i 0)
         (while (< i 400)
           (emit pcm)
           (set i (+ i 1))))})
    (let messages [])
    (let hub (new_voice_hub {^runtime runtime}
      ^send (fn [connection value]
        (match value
          (when (text : Str) (messages .push ($json/parse text)))
          (when (bytes : Bytes) (spoken .set (+ spoken/.get (- ($binary/size bytes) 9))))
          (else (fail "Unexpected socket payload.")))
        1)))
    (let connection {^server_id -1 ^fd 1})
    (try
      (add_voice_peer hub connection "csrf" (fn [] true))
      (voice_message hub connection "{\"type\":\"hello\",\"csrf\":\"csrf\",\"client_id\":\"page\",\"formats\":[\"s16le\"]}")
      ($assert (== messages/0/type "ready") ($to_str messages))
      (let claim (claim_voice runtime/services/values/voice "session" "page" true))
      (let peer (hub/peers/.get .get "-1/1"))
      (let detail (fn [] ($to_str messages " spoken=" spoken/.get " captures=" peer/captures " speaks=" peer/speaks)))
      (peer .put "session" "session") (peer .put "token" claim/token)
      (voice_message hub connection ($json/stringify
        {^type "capture/start" ^id "utterance" ^stream 1 ^rate 16000 ^channels 1 ^encoding "s16le"}))
      (voice_message hub connection ($json/stringify {^type "speak" ^id "missing" ^reply "session/missing" ^stream 10}))
      ($assert (! peer/closed))
      ($assert (== messages/.last/type "speak/error"))
      ($assert (== messages/.last/code "not_found"))
      ($assert (== ($size peer/captures) 1) "A rejected speech request cancelled dictation.")
      (voice_message hub connection (encode_audio_frame 1 1 0 ($binary/put_u16 32767)))
      (voice_message hub connection "{\"type\":\"capture/end\",\"id\":\"utterance\"}")
      (until (fn [] (== ($size peer/captures) 0)) detail)
      ($assert (== messages/.last/type "transcript/final") ($to_str messages))
      ($assert (== messages/.last/text "fixture speech"))
      (let event (append_core_event events "session" "session"
        {^type "reply" ^text "Fixture reply." ^^final ^round "round" ^turn 1}))
      (let reply $"session/${event/seq}")
      (voice_message hub connection ($json/stringify {^type "speak" ^id "s1" ^reply reply ^stream 2}))
      (until (fn [] (>= spoken/.get 96000)) detail)
      ($sleep 30)
      ($assert (== spoken/.get 96000) "Network delivery must not restore playback credit.")
      (voice_message hub connection "{\"type\":\"player\",\"id\":\"s1\",\"played_bytes\":96000}")
      (until (fn [] (== ($size peer/speaks) 0)) detail)
      ($assert (== spoken/.get 128000))
      ($assert (== messages/.last/type "speak/end"))
      ($assert (== ($size ($filter (events_for events "session" "session")
        (fn [event] (!= event/type "trace")))) 1) "Only replies and numeric timing traces may be durable.")
      (voice_message hub connection ($json/stringify {^type "speak" ^id "s2" ^reply reply ^stream 3}))
      (until (fn [] (>= spoken/.get 224000)) detail)
      (voice_message hub connection "{\"type\":\"speak/cancel\",\"id\":\"s2\"}")
      (until (fn [] (== ($size peer/speaks) 0)) detail)
      (let stopped spoken/.get) ($sleep 30)
      ($assert (== spoken/.get stopped))
      (contribute ^^replace h "core" "speech_synthesizers" (row h "speech_synthesizers" "fixed"))
      (tick_voice hub)
      (until (fn [] (! hub/maintenance/.get)) detail)
      ($assert (== messages/.last/type "engines/changed"))
      ($assert (== (/token (voice_snapshot runtime/services/values/voice)) claim/token) "Retiring an engine must not release a fresh page claim.")
      (claim_voice runtime/services/values/voice "other" "other-page" true)
      (tick_voice hub)
      (until (fn [] (! hub/maintenance/.get)) detail)
      ($assert (== messages/.last/type "released"))
    ensure
      (close_voice_hub hub) (shutdown_harness h) (close_event_store events)))
  (it "keeps overlapping streaming utterances independent and discards cancelled finals" []
    (let root $"/private/tmp/gene-streaming-speech-${($crypto/random_hex 8)}")
    ($fs/make_dir root) ($fs/write_text $"${root}/config.gene" ($serde/write_data {}))
    (let h (new_harness))
    (let runtime {^h h ^events nil ^services {^values {}} ^state_root root ^profile {^voice {^recognizer "streaming"}}})
    (set runtime/services/values/voice (new_voice_state runtime))
    (let callbacks ($cell {})) (let next ($cell 0)) (let ends ($cell 0)) (let closed ($cell []))
    (contribute h "core" "speech_recognizers"
      {^name "streaming" ^auto 1 ^mode "stream" ^available (fn [] ($sleep 10) true)
       ^open (fn [settings] {}) ^close (fn [resource] nil)
       ^stream (fn [resource settings partial final error]
         (let id (+ next/.get 1)) (next .set id) (let key ($to_str id))
         (callbacks/.get .put key {^final final ^partial partial ^bytes ($cell 0)})
         {^push (fn [pcm : Bytes]
            (let record (callbacks/.get .get key))
            (record/bytes .set (+ record/bytes/.get ($binary/size pcm))))
          ^finish (fn [] (ends .set (+ ends/.get 1)))
          ^close (fn [] (closed/.get .push key))})})
    (let messages [])
    (let hub (new_voice_hub {^runtime runtime}
      ^send (fn [connection value] (messages .push ($json/parse value)) 1)))
    (let connection {^server_id -2 ^fd 1})
    (try
      (add_voice_peer hub connection "csrf" (fn [] true))
      (voice_message hub connection "{\"type\":\"hello\",\"csrf\":\"csrf\",\"client_id\":\"page\",\"formats\":[\"s16le\"]}")
      (let claim (claim_voice runtime/services/values/voice "session" "page" true))
      (let peer (hub/peers/.get .get "-2/1"))
      (peer .put "session" "session") (peer .put "token" claim/token)
      (let detail (fn [] ($to_str messages)))
      (voice_message hub connection "{\"type\":\"latency\",\"kind\":\"output\",\"id\":\"bad\",\"elapsed_ms\":\"bad\"}")
      ($assert (! peer/closed) "Malformed optional telemetry must not cancel voice.")
      (for [id stream] in [["a" 1] ["b" 2]]
        (let start_data ($json/stringify
          {^type "capture/start" ^id id ^stream stream ^rate 16000 ^channels 1 ^encoding "s16le"}))
        (let starting (spawn ^lane root (voice_message hub connection start_data)))
        ($sleep 1)
        (let arriving (spawn ^lane root
          (do (voice_message hub connection (encode_audio_frame 1 stream 0 ($binary/put_u16 32767)))
              (voice_message hub connection ($json/stringify {^type "capture/end" ^id id})))))
        starting/.join arriving/.join)
      (until (fn [] (== ends/.get 2)) detail)
      (let second (callbacks/.get .get "2")) (second/final "second final")
      (until (fn [] (== ($size peer/captures) 1)) detail)
      ($assert (== messages/.last/id "b")) ($assert (== second/bytes/.get 2))
      (let first (callbacks/.get .get "1")) (first/final "first final")
      (until (fn [] (== ($size peer/captures) 0)) detail)
      ($assert (== messages/.last/id "a")) ($assert (== first/bytes/.get 2))
      (voice_message hub connection "{\"type\":\"capture/start\",\"id\":\"c\",\"stream\":3,\"rate\":16000,\"channels\":1,\"encoding\":\"s16le\"}")
      (voice_message hub connection (encode_audio_frame 1 3 0 ($binary/put_u16 32767)))
      (voice_message hub connection "{\"type\":\"capture/end\",\"id\":\"c\"}")
      (until (fn [] (== ends/.get 3)) detail)
      (voice_message hub connection "{\"type\":\"capture/cancel\",\"id\":\"c\"}")
      (until (fn [] (== ($size peer/captures) 0)) detail)
      (let count messages/.size)
      (let cancelled (callbacks/.get .get "3")) (cancelled/final "late cancelled final")
      ($sleep 20)
      ($assert (== messages/.size count)) ($assert (== closed/.get/.size 3))
      (for stream in [4 5 6 7]
        (voice_message hub connection ($json/stringify
          {^type "capture/start" ^id ($to_str "pending-" stream) ^stream stream ^rate 16000 ^channels 1 ^encoding "s16le"})))
      (until (fn [] (== next/.get 7)) detail)
      (voice_message hub connection ($json/stringify
        {^type "capture/start" ^id "fifth" ^stream 8 ^rate 16000 ^channels 1 ^encoding "s16le"}))
      ($assert (! peer/closed)) ($assert (== messages/.last/type "capture/error"))
      (voice_message hub connection (encode_audio_frame 1 8 0 ($binary/put_u16 1)))
      ($assert (! peer/closed)) ($assert (== ($size peer/captures) 4))
      (let slow (peer/captures .get "pending-4"))
      (let callback (callbacks/.get .get "4")) (callback/partial "keep these words")
      (slow .put "state" "finalizing") (slow .put "bytes" 320000)
      (slow .put "released" (- ($os/monotonic_ms) 10000))
      (tick_voice hub) (until (fn [] (! hub/maintenance/.get)) detail)
      ($assert (== ($size peer/captures) 4) "The deadline ignored a ten-second recognition backlog.")
      (slow .put "released" (- ($os/monotonic_ms) 30000))
      (tick_voice hub) (until (fn [] (! hub/maintenance/.get)) detail)
      ($assert (== messages/.last/type "capture/error"))
      ($assert (== messages/.last/text "keep these words"))
      (until (fn [] (== ($size peer/captures) 3)) detail)
    ensure (close_voice_hub hub) (shutdown_harness h))))

(fn main [args] : Int (/exit_code (run)))
