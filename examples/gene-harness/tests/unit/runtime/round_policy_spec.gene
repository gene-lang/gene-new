(import $test [describe it])
(import [operator_round? collection_turns] ^from "../../../src/runtime/round_policy")

(describe "Persisted round policy"
  (it "requires explicit operator admission independently of initiator spelling" []
    (for initiator in ["user" "trigger:heartbeat" "parent:session/task"
                       "channel:slack/demo" "continue:round" "custom:work"]
      ($assert (! (operator_round? {^initiator initiator})) initiator)))
  (it "uses an admitted explicit policy independently of the current route configuration" []
    ($assert (operator_round? {^initiator "custom:work" ^^operator}))
    ($assert (! (operator_round? {^initiator "user" ^!operator})))
    ($assert (== (collection_turns {^collection_turns 1}) 1))
    ($assert (== (collection_turns {}) 0))))
