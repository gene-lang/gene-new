(import $test [describe it run])
(import [speech_text] ^from "../../../src/runtime/speech_text")
(import [announcement_text] ^from "../../../src/web/voice")

(describe "Spoken reply normalization"
  (it "uses an explicit pause announcement instead of failed or completed speech" []
    ($assert (== (announcement_text {^announcement "paused"})
      "Paused at the turn limit. Continue controls are on screen.")))
  (it "omits image references without leaving punctuation or reading their URLs" []
    (for [source expected] in [
      ["![Generated logo](/api/v7/media/image_id)\nThe logo is ready." "The logo is ready."]
      ["Done. ![logo](/api/v8/media/image_id)" "Done."]
      ["![](/api/v8/media/image_id)" ""]
      ["![external](https://example.com/logo.png)" ""]]
      ($assert (== (speech_text source) expected))))
  (it "keeps prose and replaces code and tables without reading their contents" []
    ($assert (== (speech_text "Finished.\n```gene\n(secret code)\n```\nNext.") "Finished. Code on screen. Next."))
    ($assert (== (speech_text "| file | rows |\n| --- | --- |\n| a | 12 |") "Table on screen.")))
  (it "speaks labels and identifiers while shortening paths, URLs and hashes" []
    ($assert (== (speech_text "Read [the guide](https://example.com/docs).") "Read the guide."))
    ($assert (== (speech_text "Visit https://example.com/docs") "Visit example.com"))
    ($assert (== (speech_text "Changed src/report.gene at abcdef0123456789") "Changed report.gene at a hash"))
    ($assert (== (speech_text "Use `parse_csv` and `some call with arguments`.") "Use parse_csv and code.")))
  (it "turns headings and lists into sentences and removes visual markup" []
    ($assert (== (speech_text "# Done\n- **One**\n- <b>Two</b> 😀") "Done. One. Two."))
    ($assert (== (speech_text "") "")))
  (it "preserves slash alternatives while shortening actual paths" []
    ($assert (== (speech_text "Answer yes/no. Tests pass/fail. Use read/write mode.")
      "Answer yes/no. Tests pass/fail. Use read/write mode."))
    ($assert (== (speech_text "Open ./notes ../guide /tmp/data src/report.gene a/b/c.")
      "Open notes guide data report.gene a/b/c.")))
  (it "preserves three-way choices, decimal ratings and version alternatives" []
    ($assert (== (speech_text "Pick red/green/blue or GET/POST/PUT; true/false/nil.")
      "Pick red/green/blue or GET/POST/PUT; true/false/nil."))
    ($assert (== (speech_text "Rated 4.5/5, scored 0.98/1.00, upgrade v1.2/v1.3.")
      "Rated 4.5/5, scored 0.98/1.00, upgrade v1.2/v1.3."))))

(fn main [args] : Int
  (/exit_code (run)))
