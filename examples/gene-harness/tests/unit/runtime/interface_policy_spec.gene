(import $test [describe it])
(import [current_interfaces latest_interfaces registration_interfaces
  source_interfaces interface_diagnostic InterfacePolicyError]
  ^from "../../../src/runtime/interface_policy")

(describe "Plugin interface compatibility"
  (it "checks exact requirements against supported sets without claiming host-only interfaces" []
    (let current (current_interfaces))
    (let required (registration_interfaces))
    ($assert (== (interface_diagnostic required current) ""))
    ($assert (== (interface_diagnostic (latest_interfaces) current) ""))
    ($assert (== (interface_diagnostic required (current .assoc "host_only" ["host/Extra:1"])) ""))
    ($assert (! (required .has_key? "host_only")))
    (let obsolete (required .assoc "core" "gene-harness/PluginHost:1"))
    ($assert ($str/contains? (interface_diagnostic obsolete current) "core: requires gene-harness/PluginHost:1"))
    (let future (required .assoc "plugin_api" "gene-harness/Plugin:99"))
    ($assert ($str/contains? (interface_diagnostic future current) "plugin_api: requires gene-harness/Plugin:99"))
    (let unknown (required .assoc "unknown" "test:1"))
    ($assert ($str/contains? (interface_diagnostic unknown current) "unsupported interface unknown"))
    ($assert ($str/contains? (interface_diagnostic {} current) "omit"))
    ($assert ($str/contains? (interface_diagnostic [] current) "must be a map"))
    ($assert ($str/contains? (interface_diagnostic current current) "exact version")))
  (it "defaults source to the public contract and rejects explicit retired or malformed requirements" []
    ($assert (== (/core (current_interfaces)) ["gene-harness/PluginHost:3"]))
    ($assert (== (source_interfaces (quote (mod plugin))) (latest_interfaces)))
    (for core in ["gene-harness/PluginHost:1" "gene-harness/PluginHost:2"]
      (let required (source_interfaces `(mod plugin @interfaces {^core %core})))
      ($assert ($str/contains? (interface_diagnostic required (current_interfaces)) core)))
    ($assert (try
      (source_interfaces (quote (mod plugin @interfaces {^core ["gene-harness/PluginHost:3"]})))
      false catch InterfacePolicyError true))))
