(import $test [describe it run])
(import ^from "../../../src/kernel" [new_harness])
(import ^from "../../../src/runtime/appearance" [open_appearance set_appearance AppearanceChanged AppearanceRequest AppearanceError appearance_tabs report_appearance])
(import ^from "../../../src/web/appearance" [read_saved encode_saved appearance_answer appearance_request])

(describe "Browser appearance"
  (it "keeps saved choices when a host falls back" []
    (let saved (read_saved "other=x; gene_harness_appearance=theme=paper&mode=dark&density=invalid&text_size=larger"))
    ($assert (== saved {^theme "paper" ^mode "dark" ^text_size "larger"}))
    (let answer (appearance_answer saved))
    ($assert (== answer/saved/theme "paper"))
    ($assert (== answer/rendered/theme "default"))
    ($assert (== answer/rendered/mode "dark"))
    ($assert (== answer/rendered/density "comfortable"))
    ($assert (== (read_saved $"gene_harness_appearance=${(encode_saved saved)}") saved)))
  (it "merges saved fields and suppresses cookie and event on no-op" []
    (let h (new_harness))
    (let seen [])
    (h/bus .subscribe AppearanceChanged (fn [event] (seen .push event/saved)))
    (let runtime {^h h})
    (let request {^method "POST" ^headers {^cookie "gene_harness_appearance=theme=paper&mode=dark"} ^body "{\"density\":\"compact\"}"})
    (let changed (appearance_request request runtime true))
    (let data ($json/parse (/0 ($node/body changed))))
    ($assert (== data/saved {^theme "paper" ^mode "dark" ^density "compact"}))
    ($assert (== data/rendered/theme "default"))
    ($assert ($str/contains? changed/headers/set-cookie "theme=paper&mode=dark&density=compact"))
    ($assert (== seen [data/saved]))
    (request/headers .put "cookie" "gene_harness_appearance=theme=paper&mode=dark&density=compact")
    (let unchanged (appearance_request request runtime true))
    ($assert ($absent? unchanged/headers/set-cookie))
    ($assert (== seen/.size 1)))
  (it "rejects invalid writes and GET never writes" []
    (let runtime {^h (new_harness)})
    (let request {^method "GET" ^headers {} ^body ""})
    ($assert ($absent? (/set-cookie (/headers (appearance_request request runtime true)))))
    (request .put "method" "POST")
    (for body in ["{\"mode\":\"sepia\"}" "{\"density\":false}" "{\"unknown\":\"x\"}" "[]"]
      (request .put "body" body)
      ($assert (try (appearance_request request runtime true) false catch AppearanceError true))))
  (it "server commands request browser changes" []
    (let h (new_harness))
    (let seen [])
    (h/bus .subscribe AppearanceRequest (fn [event] (seen .push event/fields)))
    ($assert (== (set_appearance {^h h} {^mode "dark"}) {^mode "dark"}))
    ($assert (== seen [{^mode "dark"}]))
    ($assert (try (set_appearance {^h h} "dark") false catch AppearanceError true)))
  (it "stores each connected tab's report" []
    (let runtime {^services {^values {^appearance (open_appearance "unused")}}})
    (report_appearance runtime "tab-a" {^saved {^theme "paper"} ^rendered {^theme "default"}})
    ($assert (== (appearance_tabs runtime) [{^tab "tab-a" ^saved {^theme "paper"} ^rendered {^theme "default"}}]))
    (report_appearance runtime "tab-a" nil)
    ($assert (== (appearance_tabs runtime) []))))
(fn main [args] : Int (/exit_code (run ^name (?? args/0 ""))))
