# The process-global facade: identity, targets, levels, scoping, bounding,
# redaction and the strict mode used by every spec.
(import $test [describe it])
(import [log_start log_reset log_configure log_set_levels log_refresh_redactions log_event log_scope log_recent log_run log_subscribe log_unsubscribe log_subscription log_gap_record]
  ^from "../../../src/kernel/log")
(import [serialize_line log_line_budget parse_record render_text]
  ^from "../../../src/public/log_record")

(fn reset [] : Nil
  (log_reset ^quiet true ^strict true)
  (log_configure ^mode "silent" ^workspace "w_test" ^level "info" ^levels {}))

(describe "harness log facade"
  (it "records identity, target and sequence" []
    (reset)
    (log_event "turn/start" "turn 3 started"
      ^target {^session "s_7" ^round "r_3" ^turn 3}
      ^data {^model "provider/x"})
    (log_event "turn/end" "turn 3 ended" ^target {^session "s_7" ^round "r_3" ^turn 3})
    (let records (log_recent))
    ($assert (== (records .size) 2) ($to_str (records .size)))
    (let first records/0)
    ($assert (== first/schema "harness.log.v1"))
    ($assert (== first/run (log_run)))
    ($assert (== first/seq 1))
    ($assert (== first/type "turn/start"))
    ($assert (== first/level "info"))
    ($assert (== first/target/session "s_7"))
    ($assert (== first/target/workspace "w_test"))
    ($assert (== first/data/model "provider/x"))
    ($assert (== records/1/seq 2)))

  (it "raises on a missing required target in strict mode" []
    (reset)
    (var message "")
    (let failed
      (try
        (do
          (log_event "turn/start" "missing session" ^target {^round "r_3" ^turn 3})
          false)
        catch Error (do (set message $err/.message) true)))
    ($assert failed "strict mode accepted a missing target")
    ($assert ($str/contains? message "session") message))

  (it "records an invalid call outside strict mode" []
    (log_reset ^quiet true ^strict false)
    (log_configure ^mode "silent" ^workspace "w_test" ^level "info")
    (log_event "turn/start" "missing session" ^target {^round "r_3" ^turn 3})
    (let records (log_recent))
    ($assert (== (records .size) 1))
    ($assert (== records/0/type "log/invalid"))
    ($assert ($str/contains? records/0/message "session")))

  (it "filters by level and honours a family override" []
    (reset)
    (log_event "model/call" "hidden debug"
      ^target {^session "s" ^round "r" ^turn 1 ^call "c"} ^level "debug")
    (log_event "turn/start" "visible" ^target {^session "s" ^round "r" ^turn 1})
    ($assert (== ((log_recent) .size) 1))
    (log_configure ^mode "silent" ^workspace "w_test" ^level "info" ^levels {^model "debug"})
    (log_event "model/call" "visible debug"
      ^target {^session "s" ^round "r" ^turn 1 ^call "c"} ^level "debug")
    ($assert (== ((log_recent) .size) 2)))

  (it "applies a new level table immediately" []
    (reset)
    (log_set_levels "warn" {^model "debug"})
    (log_event "turn/start" "hidden info" ^target {^session "s" ^round "r" ^turn 1})
    (log_event "model/call" "visible debug"
      ^target {^session "s" ^round "r" ^turn 1 ^call "c"} ^level "debug")
    (log_event "model/error" "visible warn"
      ^target {^session "s" ^round "r" ^turn 1 ^call "c"})
    (let types ($map (log_recent) (fn [record] record/type)))
    ($assert (== ($order/sort types) ["model/call" "model/error"]) ($to_str types)))

  (it "adds an ambient target from log_scope" []
    (reset)
    (log_scope {^session "s_9"}
      (fn [] (log_event "command/start" "command" ^target {^command "cmd_1"})))
    (let records (log_recent))
    (let record records/0)
    ($assert (== record/target/session "s_9"))
    ($assert (== record/target/command "cmd_1"))
    ($assert (== record/target/workspace "w_test")))

  (it "delivers bounded subscriptions with drop gaps" []
    (reset)
    (let subscription (log_subscribe ^type "turn/*" ^target {^session "s1"} ^capacity 2))
    (let channel subscription/channel)
    (let target {^session "s1" ^round "r" ^turn 1})
    (log_event "turn/start" "one" ^target target)
    (log_event "turn/start" "two" ^target target)
    (log_event "turn/start" "three" ^target target)
    (log_event "turn/start" "other" ^target {^session "s2" ^round "r" ^turn 1})
    (let first channel/.recv)
    (let second channel/.recv)
    ($assert (== first/record/message "one") ($to_str first))
    ($assert (== second/record/message "two") ($to_str second))
    ($assert ($absent? first/gap) ($to_str first))
    (let stats (log_subscription subscription/id))
    ($assert (== stats/dropped 1) ($to_str stats))
    (log_event "turn/start" "four" ^target target)
    (let third channel/.recv)
    ($assert (== third/record/message "four") ($to_str third))
    ($assert (== third/gap/count 1) ($to_str third))
    (let gap (log_gap_record third))
    ($assert (== gap/type "log/dropped") ($to_str gap))
    ($assert (== gap/data/count 1) ($to_str gap))
    (log_unsubscribe subscription/id)
    (let closed (try (channel/.recv) false catch ChannelClosed true))
    ($assert closed "unsubscribe did not close the queue"))

  (it "filters recent records by target keys" []
    (reset)
    (log_event "turn/start" "first" ^target {^session "s1" ^round "r" ^turn 1})
    (log_event "turn/start" "second" ^target {^session "s2" ^round "r" ^turn 1})
    (let selected (log_recent ^type "turn/*" ^target {^session "s2"}))
    ($assert (== (selected .size) 1) ($to_str selected))
    ($assert (== selected/0/message "second") ($to_str selected))
    (let wild (log_recent ^type "turn/*" ^target {^round "r"}))
    ($assert (== (wild .size) 2) ($to_str wild)))

  (it "calls a data function only when the record is emitted" []
    (reset)
    (let calls ($cell 0))
    (log_event "model/call" "filtered"
      ^target {^session "s" ^round "r" ^turn 1 ^call "c"}
      ^level "debug"
      ^data (fn [] (calls .set (+ (calls .get) 1)) {^n (calls .get)}))
    ($assert (== (calls .get) 0))
    (log_event "model/call" "emitted"
      ^target {^session "s" ^round "r" ^turn 1 ^call "c"}
      ^level "info"
      ^data (fn [] (calls .set (+ (calls .get) 1)) {^n (calls .get)}))
    ($assert (== (calls .get) 1))
    (let records (log_recent))
    ($assert (== (records/0/data .get "n") 1)))

  (it "bounds a large record and keeps it parseable" []
    (reset)
    (let data {^body "x"})
    (var index 0)
    (while (< index 600)
      (data .put $"key${index}" "yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy")
      (set index (+ index 1)))
    (log_event "turn/start" "large" ^target {^session "s" ^round "r" ^turn 1} ^data data)
    (let records (log_recent))
    (let record records/0)
    ($assert (== record/data/truncated true))
    ($assert (<= ($str/byte_size (serialize_line record)) log_line_budget))
    ($assert ($present? (parse_record (serialize_line record))))
    ($assert ($str/contains? (render_text record) "turn/start")))

  (it "redacts known secrets before the ring and the console" []
    (let root ($path/join this_pkg/root $"tmp/log-spec-${($crypto/random_hex 4)}"))
    ($fs/make_dir $"${root}/.gene-harness")
    ($fs/write_text $"${root}/.gene-harness/web_secret" "web-secret-value")
    ($fs/write_text $"${root}/.gene-harness/cli_cookie"
      ($serde/write_data {^cookie "cookie-secret" ^csrf "csrf-secret"}))
    (log_reset ^quiet true ^strict true)
    (log_configure ^mode "silent" ^root root ^workspace "w_test" ^level "info")
    (log_event "host/start" "token web-secret-value cookie-secret csrf-secret"
      ^target {^workspace "w_test"})
    (let records (log_recent))
    (let record records/0)
    ($assert (! ($str/contains? record/message "web-secret-value")))
    ($assert (! ($str/contains? record/message "cookie-secret")))
    ($assert ($str/contains? record/message "[redacted]"))))
