# Tests src/runtime/schedule/cron.gene.
(import $test [describe it before_each assert_equal run])
(import [at_ms] ^from "../../../../src/runtime/triggers")
(import * : cron ^from "../../../../src/runtime/schedule/cron")
(import * : timezone ^from "../../../../src/runtime/schedule/timezone")

(describe "Harness trigger calendar"
  (before_each [t]
    (set t/rules (timezone/system_rules "America/New_York" 2100)))

  (it "skips nonexistent spring minutes" [t]
    (let daily (cron/compile "30 2 * * *"))
    (assert_equal (cron/next daily t/rules (at_ms "2026-03-08T00:00:00Z"))
      (at_ms "2026-03-09T06:30:00Z")))

  (it "chooses the earlier fall minute and avoids a duplicate execution" [t]
    (let repeated (cron/compile "30 1 * * *"))
    (assert_equal (cron/next repeated t/rules (at_ms "2026-11-01T00:00:00Z"))
      (at_ms "2026-11-01T05:30:00Z"))
    (assert_equal (cron/next repeated t/rules (at_ms "2026-11-01T05:30:00Z"))
      (at_ms "2026-11-02T06:30:00Z")))

  (it "supports named month and weekday fields" []
    (let utc (timezone/system_rules "UTC" 2100))
    (let named (cron/compile "0 3 * jan mon"))
    (assert_equal (cron/next named utc (at_ms "2026-01-01T00:00:00Z"))
      (at_ms "2026-01-05T03:00:00Z"))))

(fn main [args] : Int
  (let result (run ^name (?? args/0 "")))
  result/exit_code)
