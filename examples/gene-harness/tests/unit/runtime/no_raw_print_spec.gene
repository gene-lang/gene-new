# Rule 1 of the logging design: all Harness output is a log record. The only
# raw prints are the console writer, the CLI result presenter, the browser-link
# presenter, the launcher's terminal/CLI presenters, and the standalone audio
# build tool.
(import $test/[describe it])

(const allowed
  ["src/kernel/log.gene"
   "src/main.gene"
   "src/cli/main.gene"
   "src/cli/notification_presenter.gene"
   "src/website/export.gene"
   "src/web/startup.gene"
   "src/runtime/supervisor.gene"
   "src/audio/build_mac.gene"])

(let tokens [(quote $println) (quote $print) (quote $eprintln)])

(fn source_files [] : Any
  (let stream ($fs/walk ($path/join this_pkg/root "src") ^max_depth 20))
  (var files [])
  (try
    (for entry in stream
      (if (&& (== entry/kind "file") ($str/ends_with? entry/relative_path ".gene"))
        (files .push {^path entry/path ^relative $"src/${entry/relative_path}"})))
    ensure stream/.close)
  files)

# Read as code, so a print named inside a string, such as the model's
# instructions, is text and not a print.
(fn find_prints [form, relative : Str, line : Int, found]
  (if (tokens .contains? form)
    (found .push $"${relative}:${line}: a raw print")
    (return nil))
  (if (== ($head form) List) (for item in form (find_prints item relative line found)))
  (if (== ($head form) Map) (map_for [key value] in form (find_prints value relative line found)))
  (match form
    when (node : Node)
      (let meta ($meta node))
      (let at (?? meta/line line))
      (find_prints ($head node) relative at found)
      (map_for [key value] in ($node/props node) (find_prints value relative at found))
      (for item in ($node/body node) (find_prints item relative at found))
    else nil))

(fn violations [] : Any
  (let found [])
  (for file in (source_files)
    (let relative file/relative)
    (if (allowed .contains? relative) (continue))
    (for form in (($parse/read_all ($fs/read_text file/path) ^locs true) .into [])
      (find_prints form relative 0 found)))
  found)

(describe "raw Harness prints"
  (it "are confined to the log writer and the presenters" []
    (let found (violations))
    ($assert found/.empty? ($str/join found ", "))))
