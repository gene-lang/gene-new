(import $test [describe it run])
(import [prepare_chat prepare_responses prepare_messages output_budget chat_result responses_result
  messages_result responses_stream_result messages_stream_result] ^from "../../../src/public/provider_payloads")
(import [openai_chat openrouter_chat openai_responses anthropic_messages file_endpoint] ^from "../../../src/public/provider")
(import [ProviderError] ^from "../../../src/plugin_api")
(import [raw_blocks] ^from "../builtin/support")

(fn call [effort]
  {^settings {^model "test" ^effort effort ^timeout_ms 600000 ^max_output 50000}
   ^messages [{^role "system" ^content "instructions"} {^role "user" ^content "work"}
              {^role "assistant" ^content "previous"} {^role "user" ^content "continue"}]})

(fn event_stream [events]
  ($str/join ($map events (fn [event] $"data: ${($json/stringify event)}\n\n")) ""))

(describe "Provider adapter payloads"
  (it "refuses unverified Anthropic thinking-off modes before a request is sent" []
    ($assert (try (prepare_messages (call "none")) false
      catch ProviderError ($str/contains? $err/message "Thinking off is not verified")))
    (let known (call "none"))
    (known/settings .put "model" "claude-sonnet-5-5")
    ($assert (== (/type (/thinking (/body (prepare_messages known)))) "between_tools")))
  (it "reports Messages credit rejection without exposing provider diagnostics" []
    (let error (try (messages_stream_result {^status 400 ^headers {^request-id "req_fixture"}
      ^body ($json/stringify {^type "error" ^error {^type "invalid_request_error"
        ^message "Your credit balance is too low. SECRET_BILLING_CONTEXT"}})} "anthropic") nil
      catch ProviderError $err))
    ($assert (== error/status 400))
    ($assert (== error/code "invalid_request_error"))
    ($assert ($str/contains? error/message "API credits are insufficient"))
    ($assert ($str/contains? error/message "req_fixture"))
    ($assert (! ($str/contains? error/message "SECRET")))
    (let unrelated (try (messages_stream_result {^status 400 ^body ($json/stringify
      {^error {^type "invalid_request_error" ^message "The credit balance parameter is unsupported."}})} "anthropic") nil
      catch ProviderError $err))
    ($assert (! ($str/contains? unrelated/message "credits are insufficient")))
    (let auth (try (messages_stream_result {^status 401 ^body ($json/stringify
      {^error {^type "authentication_error" ^message "SECRET_CREDENTIAL_DETAIL"}})} "anthropic") nil
      catch ProviderError $err))
    ($assert (== auth/status 401))
    ($assert (== auth/code "authentication_error"))
    ($assert (! ($str/contains? auth/message "SECRET"))))

  (it "fits recorded summaries at the minimum default while retaining explicit and model caps" []
    (let observations ($json/parse ($fs/read_text ($path/join this_pkg/root "docs" "verification"
      "recorded-coding-token-observations-20261031.json"))))
    (var peak 0)
    (for group in observations/groups (set peak ($math/max peak group/max_output_tokens)))
    ($assert (> peak 4096) "the regression must exercise the former minimum")
    (for effort in ["none" "minimal" "low"]
      (let request (call effort))
      ($assert (>= (output_budget request) peak))
      (request/settings .put "max_output" 2048)
      ($assert (== (output_budget request) 2048) "the default exceeded the model cap")
      (request .put "max_tokens" 128)
      ($assert (== (output_budget request) 128) "the default replaced an explicit call budget")))

  (it "preserves exact Responses bytes and EOF attachment or patch terminators" []
    (raw_blocks (fn [text]
      (let result (responses_result {^status "completed" ^output
        [{^type "message" ^role "assistant" ^status "completed"
          ^content [{^type "output_text" ^text text}]}]}))
      result/text)))

  (it "leaves source configuration inert and unchanged while applying adapter defaults" []
    (let entry {^name "local" ^adapter "openai_chat" ^base_url "http://127.0.0.1:1/v1" ^models [{^id "typed"}]})
    (let before ($pkg/canonical_digest entry))
    (let provider (file_endpoint entry))
    ($assert (== ($pkg/canonical_digest entry) before))
    ($assert (== provider/config_digest before))
    ($assert (== provider/builtin_models/0/efforts [])))

  (it "keeps protocol effort and budget fields distinct without credentials" []
    (for [constructor effort_key budget_key] in [[openai_chat "reasoning_effort" "max_completion_tokens"]
      [openrouter_chat "reasoning" "max_tokens"] [openai_responses "reasoning" "max_output_tokens"]
      [anthropic_messages "output_config" "max_tokens"]]
      (let provider (constructor {^name "custom" ^base_url "http://127.0.0.1:8888/v1/"
        ^credential {^env "NOT_READ_DURING_PREPARE"} ^models [{^id "test" ^efforts ["low" "high"]}]}))
      (let prepared (provider/prepare (call "high")))
      ($assert ($present? (prepared/body .get effort_key)))
      ($assert (== (prepared/body .get budget_key) 32768))
      ($assert (! ($str/contains? ($serde/write_data prepared) "NOT_READ_DURING_PREPARE")))
      (let automatic (provider/prepare (call nil)))
      ($assert ($absent? (automatic/body .get effort_key)))
      ($assert (== automatic/timeout_ms 600000)))
    (let plain (prepare_chat (call "high") "openai_chat"))
    ($assert (== plain/body/reasoning_effort "high"))
    ($assert ($absent? plain/body/reasoning))
    (let router (prepare_chat (call "high") "openrouter_chat"))
    ($assert (== router/body/reasoning/effort "high"))
    ($assert ($absent? router/body/reasoning_effort))
    (let limited (call "max"))
    ($assert (== (output_budget limited) 50000))
    (limited .put "max_tokens" 1024)
    ($assert (== (output_budget limited) 1024))
    (let plan (prepare_responses ^omit_budget true (call "high")))
    ($assert ($absent? plan/body/max_output_tokens))
    ($assert (== plan/body/store false))
    ($assert (== plan/body/stream true))
    ($assert (== plan/body/input/1/phase "final_answer"))
    ($assert ($absent? plan/body/input/0/phase)))

  (it "executes only the final answer when Responses output includes commentary" []
    (let code "(Outcome ^^done ^reply \"ready\")")
    (let output {^status "completed" ^output
      [{^type "message" ^role "assistant" ^status "completed" ^phase "commentary"
        ^content [{^type "output_text" ^text code}]}
       {^type "message" ^role "assistant" ^status "completed" ^content [{^type "output_text" ^text "Unphased commentary"}]}
       {^type "message" ^role "assistant" ^status "completed" ^phase "final_answer"
        ^content [{^type "output_text" ^text code}]}]})
    ($assert (== (/text (responses_result output)) code))
    (output .put "output" [output/output/0])
    ($assert (try (responses_result output) false catch ProviderError true)))

  (it "buffers only completed Responses events and refuses partial output" []
    (let output {^status "completed" ^output [{^type "message" ^role "assistant" ^status "completed"
      ^content [{^type "output_text" ^text "(Outcome ^^done)"}]}] ^usage {^output_tokens 10}})
    (let response {^status 200 ^body (event_stream [{^type "response.output_text.delta" ^delta "partial"}
      {^type "response.completed" ^response output}])})
    ($assert (== (/text (responses_stream_result response)) "(Outcome ^^done)"))
    (for status in ["incomplete" "failed" "in_progress"]
      (let partial ($thaw ($freeze output))) (partial .put "status" status)
      ($assert (try (responses_result partial) false catch ProviderError true)))
    (for events in [[{^type "response.output_text.delta" ^delta "(partial)"}]
      [{^type "response.completed" ^response output} {^type "error" ^message "do not execute"}]]
      ($assert (try (responses_stream_result {^status 200 ^body (event_stream events)}) false catch ProviderError true))))

  (it "makes ChatGPT plan-limit recovery actionable without evaluating a partial stream" []
    (let response {^status 200 ^body (event_stream
      [{^type "response.output_text.delta" ^delta "(partial)"}
       {^type "response.failed" ^response {^error {^code "subscription_sharing_usage_limit_exceeded" ^message "SECRET_PROVIDER_DETAIL"}}}])})
    (let error (try (responses_stream_result response "chatgpt") nil catch ProviderError $err))
    ($assert (== error/code "subscription_sharing_usage_limit_exceeded"))
    ($assert (== error/status 429))
    ($assert ($str/contains? error/message "Settings → Usage"))
    ($assert (! ($str/contains? error/message "SECRET"))))

  (it "requires message_stop, end_turn and complete text blocks from Messages streams" []
    (let events [{^type "message_start" ^message {^type "message" ^role "assistant" ^content [] ^usage {^input_tokens 5}}}
      {^type "content_block_start" ^index 0 ^content_block {^type "text" ^text ""}}
      {^type "content_block_delta" ^index 0 ^delta {^type "text_delta" ^text "(Outcome ^^done)"}}
      {^type "content_block_stop" ^index 0}
      {^type "message_delta" ^delta {^stop_reason "end_turn"} ^usage {^output_tokens 10}}
      {^type "message_stop"}])
    (let result (messages_stream_result {^status 200 ^body (event_stream events)}))
    ($assert (== result/text "(Outcome ^^done)"))
    ($assert (== result/usage/input_tokens 5)) ($assert (== result/usage/output_tokens 10))
    (let truncated ($into ($take events 5) []))
    ($assert (try (messages_stream_result {^status 200 ^body (event_stream truncated)}) false catch ProviderError true))
    (for reason in ["max_tokens" "refusal" "tool_use"]
      (let incomplete ($thaw ($freeze events)))
      (set incomplete/4/delta/stop_reason reason)
      ($assert (try (messages_stream_result {^status 200 ^body (event_stream incomplete)}) false catch ProviderError true))))

  (it "refuses incomplete, refused, errored and empty chat responses" []
    (for choice in [{^finish_reason "length" ^message {^content "partial"}}
      {^finish_reason "error" ^message {^content "partial"}}
      {^finish_reason "stop" ^error {^message "provider error"} ^message {^content "partial"}}
      {^finish_reason "stop" ^message {^content ""}}
      {^finish_reason "stop" ^message {^content "text" ^refusal "refused"}}]
      ($assert (try (chat_result {^status 200 ^body ($json/stringify {^choices [choice]})}) false catch ProviderError true)))
    ($assert (== (/text (chat_result {^status 200 ^body ($json/stringify
      {^choices [{^finish_reason "stop" ^message {^role "assistant" ^content "complete"}}]})})) "complete"))))

(fn main [args] : Int (/exit_code (run ^name (?? args/0 ""))))
