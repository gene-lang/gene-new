# Tests src/ui/components.gene.
(import $test [describe it run])
(import [validate_web_component bounded_component_view] ^from "../../../src/ui/components")

(describe "Harness web components"
  (it "unifies full and docked views and validates explicit navigation" []
    (let render (fn [ctx] (quote (p "content"))))
    (let legacy (validate_web_component {^name "board" ^slot "panel" ^view_state {} ^render render}))
    ($assert (== legacy/slot "view"))
    ($assert (== legacy/title "board"))
    ($assert (== legacy/default_presentation "docked"))
    (let full (validate_web_component {^name "desk" ^slot "view" ^title "Desk" ^view_state {} ^render render}))
    ($assert (== full/default_presentation "full"))
    ($assert (try (validate_web_component {^name "desk" ^slot "view" ^view_state {} ^render render}) false catch Any true))
    ($assert (try (validate_web_component {^name "harness" ^slot "view" ^title "Imposter" ^view_state {} ^render render}) false catch Any true))
    (let navigation (bounded_component_view
      (quote (button ^switch_view "desk" ^presentation "docked" "Develop"))))
    ($assert (== navigation/props/switch-view "desk"))
    ($assert (== navigation/props/presentation "docked"))
    (for source in [
      (quote (button ^switch_view "" "Missing"))
      (quote (button ^switch_view "harness" ^presentation "full" "Wrong"))
      (quote (button ^switch_view "desk" ^presentation "overlay" "Wrong"))
      (quote (button ^presentation "docked" "Missing view"))
      (quote (a ^switch_view "desk" "Wrong element"))
      (quote (button ^switch_view "desk" ^prompt "hello" "Ambiguous"))
      (quote (button ^key "bad" ^switch_view "desk" ^action "save" "Ambiguous"))]
      ($assert (try (bounded_component_view ^^experimental source) false catch Any true))))

  (it "preserves textarea text defaults for keyed fields and honors explicit values" []
    (let view (bounded_component_view ^^experimental
      (quote (form ^key "job" ^action "save"
        (textarea ^key "concern" ^field "concern" "Saved " "repair request")
        (textarea ^key "notes" ^field "notes" ^value "Explicit notes" "Ignored fallback")))))
    ($assert (== view/children/0/props/value "Saved repair request"))
    ($assert (== view/children/1/props/value "Explicit notes"))
    ($assert (try
      (bounded_component_view ^^experimental
        (quote (textarea ^key "bad" (strong "Not plain text"))))
      false
      catch Any ($str/contains? $err/message "must be text"))))

  (it "admits keyed forms and structured arguments only for the experiment" []
    (let source (quote (form ^key "edit" ^action "save" ^args {^revision "1"} ^positional ["task"]
      (label "Title" (input ^key "title" ^field "title" ^value "Draft"))
      (button ^type "submit" "Save"))))
    ($assert (try (bounded_component_view source) false catch Any true))
    (let view (bounded_component_view ^^experimental source))
    ($assert (== view/props/args/revision "1"))
    ($assert (== view/props/positional ["task"])))

  (it "rejects ambiguous keys, unowned fields and nested forms before display" []
    (for source in [
      (quote (input ^field "title"))
      (quote (input ^key "title" ^field "title"))
      (quote (section (p ^key "same") (p ^key "same")))
      (quote (form ^key "outer" (form ^key "inner")))
      (quote (form ^key "edit" (input ^key "a" ^field "title") (input ^key "b" ^field "title")))
      (quote (input ^key "filter" ^state "filter" ^type "file"))]
      ($assert (try (bounded_component_view ^^experimental source) false catch Any true))))

  (it
    "normalizes quoted views and rejects invalid elements, actions and replacement names"
    []
    (let component
      (validate_web_component
        {
          ^name "counter"
          ^slot "sidebar"
          ^view (quote
                  (section ^class_name "web_card" (h3 "Counter") (button ^command "/counter" "Add")))}))
    ($assert (== component/view/tag "section") "quoted element was not normalized")
    ($assert (== component/view/props/class "web_card") "class_name did not normalize")
    (for invalid in [{^name "counter" ^slot "sidebar" ^view (quote (script "bad"))} {^name "counter" ^slot "sidebar" ^view (quote (button ^on_click "bad" "Bad"))} {^name "counter" ^slot "welcome" ^view (quote (p "Bad name"))} {^name "counter" ^slot "missing" ^view (quote (p "Bad slot"))}]
      ($assert
        (try
          (validate_web_component invalid)
          false
        catch Any
          true)
        "invalid component was admitted"))))

(fn main [args] : Int
  (let result (run ^name (?? args/0 "")))
  result/exit_code)
