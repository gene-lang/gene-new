# Tests src/ui/components.gene.
(import $test [describe it run])
(import ^from "../../../src/ui/components" [validate_web_component bounded_component_view bounded_card_view tree_has_commands?])
(import ^from "../../../src/ui/views" [validate_view_actions])

(describe
  "Harness web components"
  (it
    "unifies full and docked views and validates explicit navigation"
    []
    (let render (fn [ctx] (quote (p "content"))))
    (let legacy
      (validate_web_component {^name "board" ^slot "panel" ^view_state {} ^render render}))
    ($assert (== legacy/slot "view"))
    ($assert (== legacy/title "board"))
    ($assert (== legacy/default_presentation "docked"))
    (let full
      (validate_web_component
        {^name "desk" ^slot "view" ^title "Desk" ^view_state {} ^render render}))
    ($assert (== full/default_presentation "full"))
    ($assert
      (try
        (validate_web_component {^name "desk" ^slot "view" ^view_state {} ^render render})
        false
      catch Any
        true))
    ($assert
      (try
        (validate_web_component
          {^name "harness" ^slot "view" ^title "Imposter" ^view_state {} ^render render})
        false
      catch Any
        true))
    (let navigation
      (bounded_component_view (quote (button ^switch_view "desk" ^presentation "docked" "Develop"))))
    ($assert (== navigation/props/switch-view "desk"))
    ($assert (== navigation/props/presentation "docked"))
    (for source in [(quote (button ^switch_view "" "Missing")) (quote (button ^switch_view "harness" ^presentation "full" "Wrong")) (quote (button ^switch_view "desk" ^presentation "overlay" "Wrong")) (quote (button ^presentation "docked" "Missing view")) (quote (a ^switch_view "desk" "Wrong element")) (quote (button ^switch_view "desk" ^prompt "hello" "Ambiguous")) (quote (button ^key "bad" ^switch_view "desk" ^action "save" "Ambiguous"))]
      ($assert (try (bounded_component_view ^^experimental source) false catch Any true))))
  (it
    "admits new-tab links without an opener and rejects other target contexts"
    []
    (let link
      (bounded_component_view (quote (a ^href "/api/v8/ui/open?name=workspace_open&id=project" ^target "_blank" "Open"))))
    ($assert (== link/props/target "_blank"))
    ($assert (== link/props/rel "noopener"))
    (let ordinary (bounded_component_view (quote (a ^href "/" "Home"))))
    ($assert ($absent? ordinary/props/target))
    ($assert ($absent? ordinary/props/rel))
    (for source in [(quote (a ^href "/" ^target "named-frame" "Wrong target"))
                   (quote (button ^target "_blank" "Wrong element"))]
      ($assert (try (bounded_component_view source) false catch Any true))))
  (it
    "preserves textarea text defaults for keyed fields and honors explicit values"
    []
    (let view
      (bounded_component_view ^^experimental
        (quote
          (form ^key "job" ^action "save"
            (textarea ^key "concern" ^field "concern" "Saved " "repair request")
            (textarea ^key "notes" ^field "notes" ^value "Explicit notes" "Ignored fallback")))))
    ($assert (== view/children/0/props/value "Saved repair request"))
    ($assert (== view/children/1/props/value "Explicit notes"))
    ($assert
      (try
        (bounded_component_view ^^experimental
          (quote (textarea ^key "bad" (strong "Not plain text"))))
        false
      catch Any
        ($str/contains? $err/message "must be text"))))
  (it
    "admits keyed forms and structured arguments only for the experiment"
    []
    (let source
      (quote
        (form ^key "edit" ^action "save" ^args {^revision "1"} ^positional ["task"]
          (label "Title" (input ^key "title" ^field "title" ^value "Draft"))
          (button ^type "submit" "Save"))))
    ($assert (try (bounded_component_view source) false catch Any true))
    (let view (bounded_component_view ^^experimental source))
    ($assert (== view/props/args/revision "1"))
    ($assert (== view/props/positional ["task"])))
  (it
    "validates success patches on action forms against declared view state"
    []
    (let tree (bounded_component_view ^^experimental
      (quote (form ^key "create" ^action "save" ^success_state {^selected ""}))))
    ($assert (== tree/props/success-state {^selected ""}))
    (let candidate {^actions ["save"] ^view_state {^selected "create"}})
    (let snapshot {^registries {^ui_actions [{^key "save"}]}})
    (validate_view_actions tree candidate snapshot)
    (for patch in [{^unknown ""} {^selected true}]
      (let invalid (bounded_component_view ^^experimental
        `(form ^key "create" ^action "save" ^success_state %patch)))
      ($assert (try (validate_view_actions invalid candidate snapshot) false catch Any true)))
    (for source in [(quote (form ^key "create" ^action "save" ^success_state ""))
                   (quote (form ^key "create" ^action "save" ^success_state {^selected []}))
                   (quote (form ^key "create" ^success_state {^selected ""}))
                   (quote (button ^key "create" ^action "save" ^success_state {^selected ""}))]
      ($assert (try (bounded_component_view ^^experimental source) false catch Any true))))
  (it
    "rejects ambiguous keys, unowned fields and nested forms before display"
    []
    (for source in [(quote (input ^field "title")) (quote (input ^key "title" ^field "title")) (quote (section (p ^key "same") (p ^key "same"))) (quote (form ^key "outer" (form ^key "inner"))) (quote (form ^key "edit" (input ^key "a" ^field "title") (input ^key "b" ^field "title"))) (quote (input ^key "filter" ^state "filter" ^type "file"))]
      ($assert (try (bounded_component_view ^^experimental source) false catch Any true))))
  (it
    "normalizes quoted views and rejects invalid elements, actions and replacement names"
    []
    (let component
      (validate_web_component
        {
          ^name "counter"
          ^slot "sidebar"
          ^view (quote
                  (section ^class_name "web_card" (h3 "Counter") (button ^command "/counter" "Add")))}))
    ($assert (== component/view/tag "section") "quoted element was not normalized")
    ($assert (== component/view/props/class "web_card") "class_name did not normalize")
    (for invalid in [{^name "counter" ^slot "sidebar" ^view (quote (script "bad"))} {^name "counter" ^slot "sidebar" ^view (quote (button ^on_click "bad" "Bad"))} {^name "counter" ^slot "welcome" ^view (quote (p "Bad name"))} {^name "counter" ^slot "missing" ^view (quote (p "Bad slot"))}]
      ($assert
        (try
          (validate_web_component invalid)
          false
        catch Any
          true)
        "invalid component was admitted"))))

(describe
  "Harness image component contract"
  (it
    "normalizes workspace images and bounded image grids"
    []
    (let tree
      (bounded_component_view ^^experimental
        (quote
          (div ^class_name "web_image_surface"
            (img ^src "assets/board.svg" ^alt "Board" ^width 1000 ^height 1000)
            (div ^class_name "web_image_grid" ^columns 9 ^inset 5
              (button ^key "p" ^class_name "web_image_point" ^action "play" ^args {^point "0"} ^aria_label "Play A9"
                (img ^src "assets/stone.svg" ^alt "Black stone at A9" ^width 100 ^height 100)))))))
    ($assert (== tree/children/0/props/src "/api/v8/ui/image?path=assets%2Fboard.svg"))
    ($assert (== tree/children/1/props/data-columns "9"))
    ($assert (== tree/children/1/props/data-inset "5"))
    ($assert (== tree/children/1/children/0/children/0/props/alt "Black stone at A9"))
    (let decorative (bounded_component_view (quote (img ^src "board.svg" ^alt ""))))
    ($assert (== decorative/props/alt "")))
  (it
    "rejects unsafe sources, unbounded geometry, scripts and custom CSS"
    []
    (for source in [(quote (img ^src "https://example.com/x.svg" ^alt "bad")) (quote (img ^src "../x.svg" ^alt "bad")) (quote (img ^src "x.html" ^alt "bad")) (quote (img ^src "x.svg")) (quote (img ^src "x.svg" ^alt "bad" "child")) (quote (img ^src "x.svg" ^alt "bad" ^width 2049)) (quote (img ^src "x.svg" ^alt "bad" ^height 0)) (quote (img ^src "x.svg" ^alt "bad" ^width "100%")) (quote (img ^src "x.svg" ^alt "bad" ^onerror "alert(1)")) (quote (img ^src "x.svg" ^alt "bad" ^style "position:fixed")) (quote (div ^src "x.svg")) (quote (div ^class_name "web_image_grid" ^columns 26)) (quote (div ^class_name "web_image_grid" ^columns 0)) (quote (div ^class_name "web_image_grid" ^inset -1)) (quote (div ^class_name "web_image_grid" ^inset 26)) (quote (div ^class_name "web_image_grid" ^columns "9")) (quote (div ^columns 9)) (quote (button ^class_name "web_image_grid" ^columns 9))]
      ($assert (try (bounded_component_view ^^experimental source) false catch Any true)))))

(describe "Conversation sidebar component contract"
  (it "admits named host controls only in the sidebar replacement" []
    (let component
      (validate_web_component
        {^name "conversation_sidebar" ^slot "conversation_sidebar"
         ^view (quote (div ^class_name "sidebar_content"
           (h3 "Project") (host_widget ^name "filters")
           (host_widget ^name "conversations")))}))
    ($assert (== component/view/children/1/tag "host_widget"))
    ($assert (== component/view/children/2/props/name "conversations"))
    ($assert (try
      (bounded_component_view (quote (host_widget ^name "conversations")))
      false
    catch Any ($str/contains? $err/message "only available"))))

  (it "rejects duplicate, unknown and decorated host controls" []
    (for invalid in [
        (quote (host_widget ^name "unknown"))
        (quote (host_widget ^name "filters" ^id "sessions"))
        (quote (host_widget ^name "filters" "extra child"))
        (quote (div (host_widget ^name "filters")
          (section (host_widget ^name "filters"))))]
      ($assert (try (bounded_component_view ^sidebar true invalid) false catch Any true)))
    ($assert (try
      (validate_web_component {^name "another_sidebar" ^slot "conversation_sidebar"
        ^view (quote (p "wrong key"))})
      false
    catch Any ($str/contains? $err/message "name must equal")))))

(import $css [css rule decl])

(describe "Web component style contributions"
  (fn board [style ^scoped scoped = nil]
    (let candidate {^name "board" ^slot "view" ^title "Board" ^view_state {}
      ^render (fn [ctx] (quote (div ^class_name "board_grid"))) ^style style})
    (if_not ($absent? scoped) (candidate .put "style_scoped" scoped))
    (validate_web_component candidate))

  (it "scopes a contribution to its component by default" []
    (let component (board (css (rule ".board_grid" (decl display "grid")))))
    ($assert ($str/starts_with? component/style_class "plugin_board__"))
    ($assert ($str/contains? component/style_css $".${component/style_class} .board_grid {"))
    ($assert ($str/contains? component/style_css "display: grid;")))

  (it "renders page-wide rules when scoping is turned off" []
    (let component (board ^scoped false (css (rule ".board_grid" (decl display "grid")))))
    ($assert (== component/style_class ""))
    ($assert ($str/starts_with? component/style_css ".board_grid {")))

  (it "leaves components without a contribution unstyled" []
    (let component (validate_web_component {^name "plain" ^slot "toolbar" ^view (quote (p "x"))}))
    ($assert ($absent? component/style_css))
    ($assert ($absent? component/style_class)))

  (it "reports malformed and oversized contributions" []
    ($assert (try (board 42) false catch Any ($str/contains? $err/message "style could not be rendered")))
    (let pieces [])
    (while (< pieces/.size 7000) (pieces .push "0123456789"))
    (let big ($str/join pieces ""))
    ($assert (try (board (css (rule ".board_grid" (decl content big)))) false
      catch Any ($str/contains? $err/message "exceeds 64 KiB")))))

(describe "Harness card views"
  (it "validates card actions per mode and keeps answer values typed" []
    (let refused (fn [tree mode needle]
      (try (bounded_card_view tree mode) false
        catch Any ($str/contains? $err/message needle))))
    (let live (bounded_card_view
      (quote (section
        (form ^key "f" ^update "save" (input ^key "n" ^field "name") (button ^type "submit" "Save"))
        (button ^key "t" ^update "toggle" ^args {^id 1} "Toggle")
        (button ^key "s" ^send "Apply." "Send")
        (button ^command "/help" "Help")))
      "live"))
    ($assert (== live/children/1/props/args {^id 1}) "update args were not kept as data")
    ($assert (tree_has_commands? live) "command buttons were not detected")
    ($assert (! (tree_has_commands? (bounded_card_view (quote (button ^prompt "Go." "Go")) "static"))))
    ($assert (refused (quote (button ^key "u" ^update "x" "U")) "static" "requires a live card"))
    ($assert (refused (quote (button ^key "a" ^answer "x" "A")) "live" "belong to question views"))
    ($assert (refused (quote (button ^update "x" "U")) "live" "require stable keys"))
    ($assert (refused (quote (button ^key "b" ^update "x" ^send "y" "B")) "live" "exactly one action"))
    ($assert (refused (quote (input ^key "i" ^field "x")) "live" "belong to a form"))
    ($assert (refused (quote (form ^key "f" (input ^key "i" ^field "x"))) "live" "needs an update action"))
    ($assert (refused (quote (button ^key "c" ^command "/run 1" "Run")) "question" "cannot run commands"))
    ($assert (refused (quote (button ^key "v" ^switch_view "board" "Go")) "static" "unsupported card attribute"))
    (let question (bounded_card_view (quote (div (button ^key "n" ^answer 3 "Three") (button ^key "y" ^answer true "Yes"))) "question"))
    ($assert (== question/children/0/props/answer 3) "an Int answer became text")
    ($assert (== question/children/1/props/answer true) "a Bool answer became text")))

(fn main [args] : Int
  (let result (run ^name (?? args/0 "")))
  result/exit_code)
