(import $test [describe it run])
(import ^from "../../../src/storage/plugin_source"
  [capture_source_origin source_attribution assign_creation preserve_creation_on_revert])

(describe "Plugin source attribution"
  (it "captures only the actual calling session and optional model turn" []
    ($assert (== (capture_source_origin nil) {^kind "direct"}))
    ($assert (== (capture_source_origin {^session ""}) {^kind "direct"}))
    ($assert (== (capture_source_origin {^session "a" ^command "c1"})
      {^kind "command" ^session "a"}))
    ($assert (== (capture_source_origin {^session "a" ^command "c1" ^turn {^turn 9}})
      {^kind "command" ^session "a"}))
    ($assert (== (capture_source_origin {^session "b" ^turn {^turn 7}})
      {^kind "model" ^session "b" ^turn "7"})))

  (it "preserves creation while keeping unknown attribution explicit" []
    (let first {^id "probe" ^module_digest "one"
      ^source_origin {^kind "model" ^session "a" ^turn "1"}})
    (assign_creation first nil)
    ($assert (== first/created_in {^session "a" ^turn "1"}))
    (let next {^id "probe" ^module_digest "two" ^source_origin {^kind "operator"}})
    (assign_creation next first)
    ($assert (== next/created_in first/created_in))
    ($assert ($absent? (/session (/source_origin (source_attribution next)))))
    (for created in [nil void]
      (let unknown {^id "probe" ^module_digest "old" ^source_origin {^kind "direct"}
        ^session "default" ^created_in created})
      ($assert ($absent? (/created_in (source_attribution unknown))))
      (let replacement {^id "probe" ^module_digest "new" ^source_origin {^kind "command" ^session "b"}})
      (assign_creation replacement unknown)
      ($assert ($absent? replacement/created_in))
      (let restored ($thaw ($freeze first)))
      (preserve_creation_on_revert restored unknown)
      ($assert ($absent? (/created_in (source_attribution restored))))
      ($assert (== restored/source_origin first/source_origin))))

  (it "keeps source attribution distinct from the reverting actor and override lifetime" []
    (let first {^id "probe" ^module_digest "same-code"
      ^source_origin {^kind "model" ^session "a"} ^created_in {^session "a"}})
    (let next {^id "probe" ^module_digest "same-code"
      ^source_origin {^kind "command" ^session "b"}})
    (assign_creation next first)
    (let reverted ($thaw ($freeze next)))
    (reverted .put "origin" {^kind "operator" ^operation "revert" ^session "c"})
    (preserve_creation_on_revert reverted first)
    ($assert (== (source_attribution reverted)
      {^created_in {^session "a"} ^source_origin {^kind "command" ^session "b"}}))
    (let fresh {^id "probe" ^module_digest "same-code"
      ^source_origin {^kind "model" ^session "new-session"}})
    (assign_creation fresh nil)
    ($assert (== fresh/created_in {^session "new-session"}))
    ($assert (== (source_attribution {^id "probe" ^module_digest "same-code"
      ^session "do-not-infer" ^origin {^kind "model" ^session "do-not-infer"}})
      {^created_in nil ^source_origin nil}))))

(fn main [args] : Int (/exit_code (run ^name (?? args/0 ""))))
