# Tests src/agents/outcome.gene.
(import $test [describe it before_each assert_equal assert_raises run])
(import [Outcome OutcomeError TurnClosed new_turn_items append_prompt_at append_plugin_prompt
         validate_outcome render_request rewrite_prompt_calls checked_outcome_extensions]
  ^from "../../../src/agents/outcome")
(import [split_response] ^from "../../../src/agents/response")
(import [evaluate_response] ^from "../../../src/agents/eval_site")

(describe "Harness outcomes"
  (before_each
    [t]
    (set t/console ($cell []))
    (set t/turn (new_turn_items ^console (fn [text] (t/console/.get .push text)) 1)))

  (it
    "correlates output labels with source lines and disambiguates duplicate labels"
    [t]
    (let environment
      (env ^bindings {^Outcome Outcome ^append_prompt_at (fn [label line form value] (append_prompt_at t/turn label line form value))}))
    (let response
      (split_response """# goal
# step

(append_prompt "x" (+ 1 2))
(append_prompt "x" "again")
(Outcome ^prompt "next")"""))
    (let forms (rewrite_prompt_calls response/forms))
    (let value (evaluate_response `(do %forms...) environment))
    (let request (render_request ^result_line 6 t/turn (validate_outcome t/turn value)))
    ($assert
      ($str/contains?
        request
        """[1.x] line 4: (append_prompt "x" (+ 1 2))
3"""))
    ($assert ($str/contains? request "[1.x#2] line 5:"))
    ($assert
      ($str/contains?
        request
        """[1.result] line 6: Outcome ^prompt
next"""))
    ($assert (! ($str/contains? request "@line"))))

  (it
    "keeps implicit result IDs stable when a labeled output uses result"
    []
    (let turn (new_turn_items 8))
    (append_prompt_at turn "result" 1 (quote 1) 1)
    (let value (validate_outcome turn (Outcome ^prompt "next")))
    (let request (render_request turn value))
    ($assert ($str/contains? request "[8.result#2]"))
    (assert_equal request (render_request turn value)))

  (it
    "omits reader metadata from path heads in output headers"
    [t]
    (let response (split_response "($str/trim \" ok \")"))
    (append_prompt_at t/turn "path" 1 response/forms/0 "ok")
    (let request (render_request t/turn nil))
    ($assert ($str/contains? request "[1.path] line 1:"))
    ($assert ($str/contains? request "($str/trim \" ok \")"))
    ($assert (! ($str/contains? request "@source")))
    ($assert (! ($str/contains? request "@line")))
    ($assert (! ($str/contains? request "@col"))))

  (it
    "continues with a plain result as its prompt"
    []
    (let value (validate_outcome (new_turn_items 2) 42))
    (assert_equal value/outcome/prompt 42))

  (it
    "rejects completion without a reply"
    []
    (assert_raises (fn [] (validate_outcome (new_turn_items 3) (Outcome ^^done))) OutcomeError))

  (it
    "rejects empty continuations"
    []
    (assert_raises (fn [] (validate_outcome (new_turn_items 3) (Outcome))) OutcomeError))

  (it "keeps valid final replies when optional audio data is invalid" [t]
    (let parts [])
    (repeat i in 2049 (parts .push "x"))
    (for raw in [5 "" "   " {^wrong true} ($str/join parts "") ($binary/to_str ($binary/from_list [255]))]
      (let environment (env ^bindings {^Outcome Outcome ^raw raw}))
      (let value (evaluate_response (quote (Outcome ^^done ^reply "Finished." ^audio_reply raw)) environment))
      (let validated (validate_outcome t/turn value))
      ($assert (== validated/kind "done"))
      ($assert (== validated/outcome/reply "Finished."))
      ($assert ($absent? validated/outcome/audio_reply)))
    ($assert (== t/console/.get/.size 6))
    (for reply in [nil ""]
      (let value (validate_outcome t/turn (Outcome ^prompt "Continue." ^reply reply ^audio_reply "No textual reply.")))
      ($assert ($absent? value/outcome/audio_reply)))
    ($assert (== t/console/.get/.size 8)))

  (it "preserves validated spoken text through every deferred completion" []
    (for reason in ["composition" "delegation" "media"]
      (let turn (new_turn_items 1))
      (if (== reason "composition") (turn/composition_queued .set true))
      (if (== reason "delegation") (turn/delegation_staged/.get .push {}))
      (if (== reason "media") (turn/media/.get .push {}))
      (let value (validate_outcome turn (Outcome ^^done ^reply "Details." ^audio_reply "  Spoken details.  ")))
      ($assert (== value/kind "continue"))
      ($assert (== value/outcome/audio_reply "Spoken details."))))

  (it
    "finishes and reports discarded appended items"
    [t]
    (append_prompt_at t/turn "pending" 1 (quote 1) 1)
    (let done (validate_outcome t/turn (Outcome ^^done ^reply "finished")))
    (assert_equal done/kind "done")
    (assert_equal ($size t/turn/items/.get) 0)
    (assert_equal ($size t/console/.get) 1))

  (it
    "attributes plugin output to its function"
    [t]
    ($runtime/with_context
      {^turn t/turn ^function "plugin_fn"}
      (fn []
        (append_plugin_prompt "plugin" "body")))
    ($assert ($str/contains? (render_request t/turn nil) "fn plugin_fn")))

  (it
    "rejects output after turn closure"
    [t]
    (t/turn/state .set "closed")
    (assert_raises (fn [] (append_prompt_at t/turn "late" 1 (quote 1) 1)) TurnClosed))

  (it
    "rejects dynamic output labels"
    []
    (assert_raises (fn [] (rewrite_prompt_calls [(quote (append_prompt label 1))])) OutcomeError)))

(describe "Harness card call sites"
  (it "quotes literal card functions and rejects computed ones" []
    (let forms ($into ($parse/read_all ^source "response" ^^locs
      "(card \"c\" ^title \"T\" ^state {^n 1} ^view (fn [state] (quote (p \"x\"))) ^update (fn [state action] state))") []))
    (let calls (rewrite_prompt_calls forms))
    (let rewritten calls/0)
    ($assert (== ($head rewritten) (quote card_at)) "card was not rewritten to card_at")
    (let body ($node/body rewritten))
    ($assert (== body/0 1) "the call line was not recorded")
    (let view (($node/props rewritten) .get "view"))
    ($assert (== ($head view) (quote quote)) "the view function was not quoted")
    (let computed ($into ($parse/read_all ^source "response" ^^locs
      "(let v (fn [state] state))\n(card \"c\" ^title \"T\" ^view v)") []))
    ($assert (try (rewrite_prompt_calls computed) false
      catch OutcomeError (&& ($str/contains? $err/message "literal (fn ...)") (== $err/response_line 2)))
      "a computed view function was accepted")))

(describe "Outcome extension admission"
  (it "rejects unchecked data bags and malformed extension containers" []
    (for value in [{^unknown/key "unchecked"} [] true]
      (assert_raises (fn []
        (validate_outcome (new_turn_items 1) (Outcome ^^done ^reply "Candidate." ^extensions value)))
        OutcomeError)))
  (it "keeps an empty optional extension map compatible with a plain final reply" []
    ($assert (== (/kind (validate_outcome (new_turn_items 1)
      (Outcome ^^done ^reply "Done." ^extensions {}))) "done")))
  (it "keeps checked fields through publication, work and media completion deferral" []
    (for reason in ["publication" "work" "media"]
      (let turn (new_turn_items 1))
      (if (== reason "publication") (turn/composition_queued .set true))
      (if (== reason "work") (turn/delegation_staged/.get .push {}))
      (if (== reason "media") (turn/media/.get .push {^id "image"}))
      (let fields {^notes/facts ["checked"]})
      (let value (checked_outcome_extensions (Outcome ^^done ^reply "Candidate." ^extensions fields)))
      (let result (validate_outcome turn value))
      ($assert (== result/kind "continue"))
      ($assert (== result/outcome/extensions fields))))
)

(fn main [args] : Int
  (let result (run ^name (?? args/0 "")))
  result/exit_code)
