(import $test [describe it run])
(import [theme_overrides theme_tokens] ^from "../../../client/ui/theme")

(describe "Plugin theme overrides in the browser"
  (it "selects the active mode's map and nothing for a missing mode" []
    (let theme {^light {^accent "#335577"} ^dark {^accent "#9db4d6"}})
    ($assert (== (theme_overrides theme "light") {^accent "#335577"}))
    ($assert (== (theme_overrides theme "dark") {^accent "#9db4d6"}))
    ($assert (== (theme_overrides {^light {^accent "#335577"}} "dark") {}))
    ($assert (== (theme_overrides nil "dark") {}))
    ($assert (== theme_tokens/.size 7))))

(fn main [args] : Int (/exit_code (run ^name (?? args/0 ""))))
