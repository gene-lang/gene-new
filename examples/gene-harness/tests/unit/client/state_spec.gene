# Tests the pure state helpers shared by the compiled conversation/panel clients.
(import $test [describe it run])
(import [revision_before status_is_current first_prompt_block merge_delegation delegation_snapshot] ^from "../../../client/state")

(describe "Browser delegation freshness"
  (it "keeps a newer admission update when a delayed push arrives" []
    (let current {^id "parent/delegation/a@1" ^order 10 ^delegation {^revision 4 ^state "done"}})
    (let stale {^id current/id ^order 10 ^delegation {^revision 3 ^state "running"}})
    ($assert (== (merge_delegation [current] stale) [current]))
    ($assert (== (delegation_snapshot [stale] [current]) [current]))
    ($assert (== (delegation_snapshot [] [current]) []))
    (let fresh {^id current/id ^order 10 ^delegation {^revision 5 ^state "done"}})
    ($assert (== (merge_delegation [current] fresh) [fresh]))))

(fn status [session, epoch, revision, sequence]
  {^status_session session ^epoch epoch ^status_revision revision ^status_sequence sequence})

(describe "Browser status freshness"
  (it "rejects stale cached tabs, former processes and out-of-order renders" []
    (let previous (status "a" "process" "10:5" "20"))
    ($assert (revision_before "9:100" "10:1"))
    ($assert (revision_before "10:5" "10:6"))
    ($assert (! (revision_before "10:6" "10:6")))
    ($assert (! (status_is_current (status "a" "process" "10:5" "22") previous "a" "process" "process" "10:6")))
    ($assert (status_is_current (status "a" "process" "10:6" "22") previous "a" "process" "process" "10:6"))
    ($assert (! (status_is_current (status "b" "process" "10:6" "22") previous "a" "process" "process" "10:6")))
    ($assert (! (status_is_current (status "a" "old-process" "99:99" "999") previous "a" "process" "process" "10:6")))
    ($assert (! (status_is_current (status "a" "process" "10:5" "19") previous "a" "process" "process" "10:5")))
    ($assert (status_is_current (status "b" "process" "10:6" "18") previous "b" "process" "process" "10:6"))
    ($assert (status_is_current (status "" "process" "0:0" "0") nil "" "" "" ""))))

(describe "Browser initial prompt"
  (it "keeps the saved full prompt independent of title and later identical prompts" []
    (let prompt "First line.

Full second paragraph: 世界 <script>not HTML</script>")
    (let session {^title "Renamed title" ^first_request prompt ^first_request_round "round-a-1"})
    (let later {^role "user" ^phase "turn/request" ^round_id "round-a-2" ^text prompt})
    (let fallback (first_prompt_block session [later] []))
    ($assert (== fallback/text prompt))
    ($assert (== fallback/role "user"))
    ($assert fallback/durable)
    ($assert (== fallback/media []))
    ($assert ($absent? (first_prompt_block {^title "Never use this"} [] [])))
    ($assert ($absent? (first_prompt_block {^first_request ""} [] []))))

  (it "replaces the fallback only when the real first request is loaded or previewed" []
    (let session {^first_request "initial" ^first_request_round "round-a-1"})
    (let first {^role "user" ^phase "turn/request" ^round_id "round-a-1" ^text "settled request"})
    (let command {^role "user" ^phase "command/input" ^round_id "" ^text "initial"})
    ($assert ($present? (first_prompt_block session [command] [])))
    ($assert ($absent? (first_prompt_block session [first] [])))
    ($assert ($absent? (first_prompt_block session [] [first])))
    ($assert ($present? (first_prompt_block session [] []))))

  (it "retains attachment-only descriptors and uses a trigger's saved request" []
    (let media [{^id "image" ^name "pixel.png" ^url "/api/v8/media/image"}])
    (let session {^first_request "Attachment: pixel.png" ^first_request_round "round-a-1"
      ^first_request_media media})
    (let first (first_prompt_block session [] []))
    ($assert (== first/media media))
    ($assert (== first/text "Attachment: pixel.png"))
    ($assert (== (/text (first_prompt_block
      {^title "beat · timestamp" ^first_request "Full trigger request
next line"
       ^first_request_round "round-trigger-1"} [] [])) "Full trigger request
next line"))))

(fn main [args] : Int (/exit_code (run ^name (?? args/0 ""))))
