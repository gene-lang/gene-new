# Seeded episode generation and arm execution for the exact repair lab.
# Evaluation data stays as exact Gene nodes. This module owns experimental
# accounting; exact_belief.gene owns belief updates and exhaustive planning.

(mod active_inference_experiment
  @doc "seeded evaluator for the exact-belief active-inference experiment")

(import [plan] from "./exact_belief.gene")

(fn next_random_state [state : Int] : Int
  (// (* 48271 state) 2147483647))

(fn random_unit [state : Int] : Float
  (/ ($to_float state) 2147483647.0))

(fn sample_fault [prior : (List Float), draw : Float] : Int
  (var cumulative 0.0)
  (var fault 0)
  (while (< fault (prior ~ size))
    (set cumulative (+ cumulative prior/%fault))
    (if (< draw cumulative) (return fault))
    (set fault (+ fault 1)))
  (- (prior ~ size) 1))

(fn generate_batch [subject : Node, prior : (List Float), episode_seed : Int,
                    random_seed : Int, episode_count : Int] : Node
  (var episode_state episode_seed)
  (var random_state random_seed)
  (var episodes : (List Node) [])
  (repeat episode_index in episode_count
    (set episode_state (next_random_state episode_state))
    (var fault_draw (random_unit episode_state))
    (set episode_state (next_random_state episode_state))
    (var voltage_draw (random_unit episode_state))
    (set episode_state (next_random_state episode_state))
    (var continuity_draw (random_unit episode_state))
    (var fault (sample_fault prior fault_draw))
    (var voltage_positive
      (< voltage_draw subject/tests/0/positive_likelihoods/%fault))
    (var continuity_positive
      (< continuity_draw subject/tests/1/positive_likelihoods/%fault))
    (var observations [voltage_positive continuity_positive])
    (var random_draws : (List Float) [])
    (repeat _ in 3
      (set random_state (next_random_state random_state))
      (random_draws ~ push! (random_unit random_state)))
    (episodes ~ push!
      `(episode
         ^index %episode_index
         ^fault %fault
         ^observations %observations
         ^random_draws %random_draws)))
  `(episode_batch
     ^episode_seed %episode_seed
     ^random_seed %random_seed
     ^episodes %episodes
     ^final_episode_state %episode_state
     ^final_random_state %random_state))

(fn terminal_result [subject : Node, episode : Node, repaired_fault,
                     inspections : Int] : Node
  (var inspection_utility
    (- 0.0 (* ($to_float inspections) subject/inspection_cost)))
  (if (== repaired_fault nil)
    (then
      `(episode_result
         ^completed false
         ^incorrect false
         ^inspections %inspections
         ^utility %(+ subject/defer_utility inspection_utility)))
    (else
      (var incorrect (!= repaired_fault episode/fault))
      (var repair_utility
        (if incorrect
          subject/incorrect_repair_utility
          subject/correct_repair_utility))
      `(episode_result
         ^completed true
         ^incorrect %incorrect
         ^inspections %inspections
         ^utility %(+ repair_utility inspection_utility)))))

(fn execute_policy_from [subject : Node, policy : Node, episode : Node,
                         inspections : Int] : Node
  (match policy
    (when (repair ^fault repaired_fault)
      (terminal_result subject episode repaired_fault inspections))
    (when (defer)
      (terminal_result subject episode nil inspections))
    (when (inspect ^test test ^negative negative_policy ^positive positive_policy)
      (var next_policy
        (if episode/observations/%test positive_policy negative_policy))
      (execute_policy_from subject next_policy episode (+ inspections 1)))
    (else ($panic "unknown policy node"))))

(fn execute_policy [subject : Node, policy : Node, episode : Node] : Node
  (execute_policy_from subject policy episode 0))

(fn without_test [tests : (List Int), removed : Int] : (List Int)
  (var result : (List Int) [])
  (for test in tests
    (if_not (== test removed) (result ~ push! test)))
  result)

(fn execute_random_from [subject : Node, episode : Node,
                         remaining_tests : (List Int), draw_index : Int,
                         inspections : Int] : Node
  (var choice_count (+ 4 (remaining_tests ~ size)))
  (var draw episode/random_draws/%draw_index)
  (var choice
    ($to_int ($math/floor (* draw ($to_float choice_count)))))
  (if (< choice 3)
    (then
      (terminal_result subject episode choice inspections))
    (elif (== choice 3)
      (terminal_result subject episode nil inspections))
    (else
      (var position (- choice 4))
      (var test remaining_tests/%position)
      (execute_random_from
        subject episode (without_test remaining_tests test) (+ draw_index 1)
        (+ inspections 1)))))

(fn execute_random [subject : Node, episode : Node] : Node
  (execute_random_from subject episode [0 1] 0 0))

(fn greedy_policy [subject : Node, prior : (List Float)] : Node
  (var best_policy (quote (defer)))
  (var best_utility subject/defer_utility)
  (var fault 0)
  (while (< fault (prior ~ size))
    (var probability prior/%fault)
    (var utility
      (+ (* probability subject/correct_repair_utility)
         (* (- 1.0 probability) subject/incorrect_repair_utility)))
    (if_yes (> utility best_utility)
      (set best_policy `(repair ^fault %fault))
      (set best_utility utility))
    (set fault (+ fault 1)))
  best_policy)

(fn new_metrics [] : List [0 0 0 0.0])

(fn record_result [metrics : List, result : Node] : Nil
  (if_yes result/incorrect (set! metrics/0 (+ metrics/0 1)))
  (if_yes result/completed (set! metrics/1 (+ metrics/1 1)))
  (set! metrics/2 (+ metrics/2 result/inspections))
  (set! metrics/3 (+ metrics/3 result/utility)))

(fn metrics_node [metrics : List] : Node
  `(arm_metrics
     ^incorrect %metrics/0
     ^completed %metrics/1
     ^inspections %metrics/2
     ^utility %metrics/3))

(fn evaluate_batch [subject : Node, prior : (List Float), episode_seed : Int,
                    random_seed : Int, episode_count : Int] : Node
  (var batch
    (generate_batch subject prior episode_seed random_seed episode_count))
  (var greedy (greedy_policy subject prior))
  (var reward (plan subject prior 0.0))
  (var active (plan subject prior subject/beta))
  (var greedy_metrics (new_metrics))
  (var reward_metrics (new_metrics))
  (var random_metrics (new_metrics))
  (var active_metrics (new_metrics))
  (for episode in batch/episodes
    (record_result greedy_metrics
      (execute_policy subject greedy episode))
    (record_result reward_metrics
      (execute_policy subject reward/policy episode))
    (record_result random_metrics
      (execute_random subject episode))
    (record_result active_metrics
      (execute_policy subject active/policy episode)))
  `(batch_result
     ^episode_seed %episode_seed
     ^random_seed %random_seed
     ^episode_count %episode_count
     ^greedy_policy %greedy
     ^reward_policy %reward/policy
     ^active_policy %active/policy
     ^greedy %(metrics_node greedy_metrics)
     ^reward %(metrics_node reward_metrics)
     ^random %(metrics_node random_metrics)
     ^active %(metrics_node active_metrics)
     ^final_episode_state %batch/final_episode_state
     ^final_random_state %batch/final_random_state))

(fn evaluate_batches [subject : Node, prior : (List Float),
                      episode_seed_base : Int, random_seed_base : Int,
                      batch_count : Int, episode_count : Int] : (List Node)
  (var results : (List Node) [])
  (repeat batch_index in batch_count
    (var episode_seed (+ episode_seed_base (* 7919 batch_index)))
    (var random_seed (+ random_seed_base (* 7919 batch_index)))
    (results ~ push!
      (evaluate_batch subject prior episode_seed random_seed episode_count)))
  results)

(fn compute_pilot [subject : Node] : Node
  (var started ($os/monotonic_ms))
  # Pilot seeds are disjoint from every declared evaluation seed.
  (var batches
    (evaluate_batches subject subject/base_prior 3000001 4000001 1 100))
  (var elapsed_ms (- ($os/monotonic_ms) started))
  `(compute_pilot
     ^valid %(&&
               (== (batches ~ size) 1)
               (== batches/0/episode_count 100)
               (== batches/0/final_episode_state 264756247)
               (== batches/0/final_random_state 2017023388))
     ^episodes %batches/0/episode_count
     ^elapsed_ms %elapsed_ms
     ^final_episode_state %batches/0/final_episode_state
     ^final_random_state %batches/0/final_random_state))
