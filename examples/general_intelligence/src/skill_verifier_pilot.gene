# Standalone verifier mechanism pilot for experiment 4. The caller supplies
# only a candidate artifact and the previous receipt digest. Test cases remain
# inside this verifier process. This is deliberately not an evaluation suite
# and does not establish OS/container secrecy for the later experiment.

(mod skill_verifier_pilot)

(import $crypto [sha256])
(import $serde [write_data])
(import $str [byte_size])
(import gene/stream [into])
(import gene/parse [read_all])
(import [candidate_digest candidate_shape execute_candidate seal_receipt]
        from "./verified_skills.gene")

(var verifier_id "gene_verified_skill_pilot_v1")
(var hidden_tests
  [{^id "case_1" ^input " Hello World " ^expected "hello_world"}
   {^id "case_2" ^input "MIXED Case" ^expected "mixed_case"}
   {^id "case_3" ^input "already_clean" ^expected "already_clean"}
   {^id "case_4" ^input " Two  Spaces " ^expected "two__spaces"}])
(var suite_digest (sha256 (write_data hidden_tests)))

(fn make_receipt [candidate : Node, previous_digest : Str]
  (var failures [])
  (var passed_count 0)
  (var shape (candidate_shape candidate))
  (if shape/valid
    (then
      (for test in hidden_tests
        (if (== (execute_candidate candidate test/input) test/expected)
          (set passed_count (+ passed_count 1))
          (failures ~ push test/id))))
    (else
      (for test in hidden_tests (failures ~ push test/id))))
  (var total (hidden_tests ~ size))
  (var passed (== passed_count total))
  (var candidate_id (candidate_digest candidate))
  (var payload
    `(verification_receipt
       ^schema 1 ^verifier_id %verifier_id
       ^suite_digest %suite_digest ^candidate_digest %candidate_id
       ^passed %passed ^tests_passed %passed_count ^tests_total %total
       ^failure_codes %failures
       ^previous_receipt_digest %previous_digest))
  (seal_receipt payload))

(fn verify [candidate : Node, previous_digest : Str]
  (var receipt (make_receipt candidate previous_digest))
  (var shape (candidate_shape candidate))
  (if receipt/passed
    (then
      # The wire record remains pure Gene data. A trusted consumer may
      # construct the typed Skill value only after receiving this outcome over
      # its verifier-owned channel.
      (var skill
        `(skill
           ^id %shape/id ^name %shape/name ^version %shape/version
           ^program %shape/program ^preconditions %shape/preconditions
           ^effects %shape/effects ^provenance %shape/provenance
           ^candidate_digest %receipt/candidate_digest
           ^verification_receipt %receipt))
      `(verification_outcome
         ^status "promoted" ^receipt %receipt ^skill %skill))
    (else
      `(verification_outcome ^status "rejected" ^receipt %receipt))))

(fn main [args] : Nil
  (var argv ($body args))
  (if_not (== (argv ~ size) 2)
    ($panic "usage: skill_verifier_pilot <candidate-gene> <previous-receipt-digest>"))
  (if (> (byte_size argv/0) 16384)
    ($panic "candidate source exceeds 16384 bytes"))
  (var forms ((read_all argv/0) ~ into []))
  (if_not (== (forms ~ size) 1)
    ($panic "candidate argument must contain exactly one Gene form"))
  (var candidate forms/0)
  ($println (write_data (verify candidate argv/1))))
