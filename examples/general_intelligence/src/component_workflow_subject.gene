# Version-3 experiment-4 subject. Workflows stay demonstration-defined, exactly
# as in the retained version-2 generator, but the public interaction advances
# one ordered component at a time. The generator additionally proves, for every
# exported component, that no candidate consistent with the component's three
# public demonstrations can diverge from the family's canonical behavior on the
# value that component is applied to. That property is what lets the public
# checker read only public data while still advancing the task faithfully.
#
# Catalog, family order, replay suites, training variants, and retention probes
# are the unchanged version-2 constructions. Only the held-out compositions are
# redrawn, under the added soundness rejection, and projected component-wise.

(mod component_workflow_subject
  @doc "component-wise demonstration-defined lifelong workflows")

(import $str [join])
(import [try_run_program programs_of_length corpus_draw]
        from "./library_induction.gene")
(import [latent_interpreter_subject public_teaching_inputs teaching_signature
         behavior_catalog teachable_behavior_catalog all_teaching_packs
         primitive_covered? compose_programs public_component family_by_id
         verify_task generate_family_catalog generate_family_order
         generate_replay_suites generate_training_tasks
         generate_retention_probes generate_composition_input]
        from "./latent_workflow_subject.gene")

# The pack whose demonstrations are public for probes and compositions. Packs
# zero through four are consumed by the five training variants.
(fn public_pack_index [] : Int 5)

# Every program of length zero through three, bucketed by its behavior on the
# public pack. Pack uniqueness makes each bucket exactly the set of candidates
# a public checker would accept for the family that projects onto that bucket.
(fn admissible_candidate_index [subject : Node] : Map
  (var packs (public_teaching_inputs))
  (var pack_index (public_pack_index))
  (var inputs packs/%pack_index)
  (var index : Map {})
  (var depth 0)
  (while (<= depth 3)
    (for program in (programs_of_length subject/primitive_tokens depth)
      (var projection (teaching_signature subject program inputs))
      (var bucket (index ~ get projection))
      (if (== bucket void) (set bucket []))
      (bucket ~ push! program)
      (index ~ put! projection bucket))
    (set depth (+ depth 1)))
  index)

(fn family_admissible_candidates [index : Map, family : Node] : (List Node)
  (var pack_index (public_pack_index))
  (var bucket (index ~ get family/teaching_signatures/%pack_index))
  (if (== bucket void)
    ($panic "family has no admissible candidate bucket"))
  bucket)

# The soundness rule: every publicly admissible candidate must agree with the
# canonical component output on this exact chain value.
(fn candidates_agree? [subject : Node, candidates : (List Node),
                       value : (List Int), expected : (List Int)] : Bool
  (for candidate in candidates
    (var trial (try_run_program subject candidate [] value))
    (if_not (&& trial/valid (== trial/output expected))
      (return false)))
  true)

(fn draw_component_composition_case [subject : Node, programs : (List Node),
                                     candidate_sets : List,
                                     initial_state : Int] : Node
  (var state initial_state)
  (var attempts 0)
  (var unsound_draws 0)
  (while (< attempts 1000)
    (set attempts (+ attempts 1))
    (var draw (generate_composition_input state))
    (set state draw/state)
    (var current draw/input)
    (var chain : List [draw/input])
    (var valid true)
    (var sound true)
    (var position 0)
    (for program in programs
      (var execution (try_run_program subject program [] current))
      (if_not execution/valid
        (set valid false)
        (break))
      (if (== execution/output current) (set valid false))
      (if_not (candidates_agree?
                subject candidate_sets/%position current execution/output)
        (set sound false))
      (set current execution/output)
      (chain ~ push! current)
      (set position (+ position 1)))
    (if (&& valid (! sound)) (set unsound_draws (+ unsound_draws 1)))
    (if (&& valid sound (!= current draw/input) (! (current ~ empty?)))
      (return
        `(case_draw
           ^valid true ^state %state ^input %draw/input ^expected %current
           ^chain %chain ^attempts %attempts ^unsound_draws %unsound_draws))))
  `(case_draw
     ^valid false ^state %state ^attempts %attempts
     ^unsound_draws %unsound_draws))

(fn component_task_record [id : Str, kind, input : (List Int),
                           expected : (List Int), chain : List,
                           components : List, target_program : Node,
                           component_programs : (List Node),
                           signatures : List, candidate_sets : List,
                           attempts_per_component : Int] : Node
  (var candidate_counts : (List Int) [])
  (for candidates in candidate_sets
    (candidate_counts ~ push! (candidates ~ size)))
  `(component_workflow_task
     ^public
       (task
         ^id %id ^kind %kind
         ^instruction "Identify each listed workflow from its three demonstrations, then send exactly three catalog operations for it to apply_workflow_candidate. Complete the components in the order given, then call submit_result once."
         ^components %components
         ^input %input
         ^attempts_per_component %attempts_per_component
         ^tool_contract "apply_workflow_candidate_then_submit")
     ^verifier
       (task_verifier
         ^expected %expected
         ^canonical_target_program %target_program
         ^component_programs %component_programs
         ^chain_values %chain
         ^required_semantic_signatures %signatures
         ^admissible_candidate_counts %candidate_counts)))

(fn generate_component_compositions [subject : Node, families : (List Node),
                                     candidate_index : Map,
                                     initial_state : Int, count : Int,
                                     composition_arity : Int,
                                     attempts_per_component : Int] : Node
  (var state initial_state)
  (var pack_index (public_pack_index))
  (var tasks : (List Node) [])
  (var used_tuples : Map {})
  (var attempts 0)
  (var unsound_draws 0)
  (while (< (tasks ~ size) count)
    (if (>= attempts 100000)
      ($panic "component workflow composition generation exhausted its bound"))
    (set attempts (+ attempts 1))
    (var selected : Map {})
    (var programs : (List Node) [])
    (var signatures : List [])
    (var components : List [])
    (var candidate_sets : List [])
    (var tuple_parts : (List Str) [])
    (while (< (programs ~ size) composition_arity)
      (var family_draw (corpus_draw state (families ~ size)))
      (set state family_draw/state)
      (var key $"${family_draw/value}")
      (if_yes (== (selected ~ get key) void)
        (selected ~ put! key true)
        (var family_index family_draw/value)
        (var family families/%family_index)
        (var position (programs ~ size))
        (programs ~ push! family/canonical_program)
        (signatures ~ push! family/semantic_signature)
        (components ~ push! (public_component family pack_index position))
        (candidate_sets ~ push!
          (family_admissible_candidates candidate_index family))
        (tuple_parts ~ push! key)))
    (var tuple_key (join tuple_parts "_"))
    (if_yes (== (used_tuples ~ get tuple_key) void)
      (var draw
        (draw_component_composition_case subject programs candidate_sets state))
      (set state draw/state)
      (set unsound_draws (+ unsound_draws draw/unsound_draws))
      (if_yes draw/valid
        (used_tuples ~ put! tuple_key true)
        (var task_index (tasks ~ size))
        (tasks ~ push!
          (component_task_record
            $"component_composition_${task_index}"
            (quote heldout_composition) draw/input draw/expected draw/chain
            components (compose_programs programs) programs signatures
            candidate_sets attempts_per_component)))))
  `(task_generation
     ^state %state ^tasks %tasks ^attempts %attempts
     ^unsound_draws %unsound_draws))

(fn admissible_candidate_stats [index : Map,
                                families : (List Node)] : Node
  (var total 0)
  (var minimum 0)
  (var maximum 0)
  (var first true)
  (for family in families
    (var size ((family_admissible_candidates index family) ~ size))
    (set total (+ total size))
    (if_yes first
      (set minimum size)
      (set maximum size)
      (set first false))
    (if (< size minimum) (set minimum size))
    (if (> size maximum) (set maximum size)))
  `(admissible_candidate_stats
     ^total %total ^minimum %minimum ^maximum %maximum))

(fn generate_component_workflow_subject [catalog_seed : Int, order_seed : Int,
                                         family_count : Int,
                                         variants_per_family : Int,
                                         heldout_count : Int,
                                         composition_arity : Int,
                                         attempts_per_component : Int] : Node
  (if (|| (<= catalog_seed 0) (>= catalog_seed 2147483647))
    ($panic "component workflow catalog seed must be in 1..2147483646"))
  (if (|| (<= order_seed 0) (>= order_seed 2147483647))
    ($panic "component workflow order seed must be in 1..2147483646"))
  (if (|| (!= family_count 30) (!= variants_per_family 5))
    ($panic "primary component subject requires 30 families and five variants"))
  (if (!= heldout_count 60)
    ($panic "primary component subject requires 60 heldout compositions"))
  (if (|| (< composition_arity 2) (> composition_arity 4))
    ($panic "component workflow composition arity must be in 2..4"))
  (if (|| (< attempts_per_component 1) (> attempts_per_component 4))
    ($panic "component workflow attempts per component must be in 1..4"))
  (var subject (latent_interpreter_subject composition_arity))
  (var catalog (generate_family_catalog subject catalog_seed family_count))
  (var order (generate_family_order order_seed family_count))
  (var replay (generate_replay_suites subject catalog/families order/state))
  (var training
    (generate_training_tasks
      subject catalog/families order/order replay/state variants_per_family))
  (var probes
    (generate_retention_probes
      subject catalog/families order/order training/state))
  (var candidate_index (admissible_candidate_index subject))
  (var stats (admissible_candidate_stats candidate_index catalog/families))
  (var compositions
    (generate_component_compositions
      subject catalog/families candidate_index probes/state heldout_count
      composition_arity attempts_per_component))
  `(component_workflow_subject
     ^version 3
     ^base_version 2
     ^generator "park_miller_48271_mod_2147483647"
     ^catalog_seed %catalog_seed
     ^order_seed %order_seed
     ^family_count %family_count
     ^variants_per_family %variants_per_family
     ^replay_cases_per_family 24
     ^retention_block_size 5
     ^heldout_composition_count %heldout_count
     ^composition_arity %composition_arity
     ^attempts_per_component %attempts_per_component
     ^public_pack_index %(public_pack_index)
     ^candidate_program_count %catalog/candidate_program_count
     ^distinct_behavior_count %catalog/distinct_behavior_count
     ^teachable_behavior_count %catalog/teachable_behavior_count
     ^admissible_candidate_total %stats/total
     ^minimum_admissible_candidates %stats/minimum
     ^maximum_admissible_candidates %stats/maximum
     ^catalog %catalog/families
     ^family_order %order/order
     ^replay_suites %replay/suites
     ^training %training/tasks
     ^retention_probes %probes/tasks
     ^heldout_compositions %compositions/tasks
     ^generation
       (generation_stats
         ^catalog_attempts %catalog/attempts
         ^composition_attempts %compositions/attempts
         ^soundness_rejections %compositions/unsound_draws
         ^final_random_state %compositions/state)))

(fn verify_component_composition [subject : Node, families : (List Node),
                                  candidate_index : Map, task : Node,
                                  composition_arity : Int,
                                  attempts_per_component : Int] : Bool
  (if_not (&&
            (== task/public/kind (quote heldout_composition))
            (== task/public/attempts_per_component attempts_per_component)
            (== task/public/tool_contract
                "apply_workflow_candidate_then_submit")
            (== (task/public/components ~ size) composition_arity)
            (== (task/verifier/component_programs ~ size) composition_arity)
            (== (task/verifier/required_semantic_signatures ~ size)
                composition_arity)
            (== (task/verifier/admissible_candidate_counts ~ size)
                composition_arity)
            (== (task/verifier/chain_values ~ size) (+ composition_arity 1)))
    (return false))
  (if_not (== task/verifier/chain_values/0 task/public/input)
    (return false))
  (var pack_index (public_pack_index))
  (var programs : (List Node) [])
  (var component_index 0)
  (for component in task/public/components
    (var family (family_by_id families component/workflow_id))
    (if (== family nil) (return false))
    (var candidates (family_admissible_candidates candidate_index family))
    (var next_index (+ component_index 1))
    (var value task/verifier/chain_values/%component_index)
    (var next task/verifier/chain_values/%next_index)
    (var execution
      (try_run_program subject family/canonical_program [] value))
    (if_not (&&
              (== component/position component_index)
              (== component/examples
                  family/teaching_packs/%pack_index/cases)
              (== task/verifier/required_semantic_signatures/%component_index
                  family/semantic_signature)
              (== task/verifier/component_programs/%component_index
                  family/canonical_program)
              (== task/verifier/admissible_candidate_counts/%component_index
                  (candidates ~ size))
              execution/valid
              (== execution/output next)
              (!= next value)
              (candidates_agree? subject candidates value next))
      (return false))
    (programs ~ push! family/canonical_program)
    (set component_index (+ component_index 1)))
  (var last task/verifier/chain_values/%composition_arity)
  (&&
    (== task/verifier/canonical_target_program (compose_programs programs))
    (== task/verifier/expected last)
    (!= last task/public/input)
    (! (last ~ empty?))))

(fn verify_component_workflow_subject [candidate : Node] : Node
  (var subject (latent_interpreter_subject candidate/composition_arity))
  (var pack_index (public_pack_index))
  (var complete (behavior_catalog subject))
  (var teachable (teachable_behavior_catalog subject complete))
  (var teachable_by_signature : Map {})
  (for behavior in teachable/teachable_behaviors
    (teachable_by_signature ~ put! behavior/signature behavior))
  (var candidate_index (admissible_candidate_index subject))

  (var catalog_valid (== (candidate/catalog ~ size) candidate/family_count))
  (var operation_coverage_valid true)
  (var family_ids : Map {})
  (var family_signatures : Map {})
  (var family_index 0)
  (for family in candidate/catalog
    (var behavior (teachable_by_signature ~ get family/semantic_signature))
    (if_not (&&
              (!= behavior void)
              (== family/index family_index)
              (== family/id $"latent_workflow_${family_index}")
              (== family/canonical_program behavior/canonical_program)
              (== family/teaching_signatures behavior/teaching_signatures)
              (== family/teaching_packs
                  (all_teaching_packs subject family/canonical_program))
              (== (family_ids ~ get family/id) void)
              (== (family_signatures ~ get family/semantic_signature) void))
      (set catalog_valid false))
    (family_ids ~ put! family/id true)
    (family_signatures ~ put! family/semantic_signature true)
    (set family_index (+ family_index 1)))
  (for primitive in subject/primitive_tokens
    (if_not (primitive_covered? candidate/catalog primitive)
      (set operation_coverage_valid false)))

  (var order_valid (== (candidate/family_order ~ size) candidate/family_count))
  (var order_seen : Map {})
  (for index in candidate/family_order
    (var key $"${index}")
    (if_not (&&
              (>= index 0) (< index candidate/family_count)
              (== (order_seen ~ get key) void))
      (set order_valid false))
    (order_seen ~ put! key true))

  (var replay_valid
    (== (candidate/replay_suites ~ size) candidate/family_count))
  (var replay_case_count 0)
  (var replay_ids : Map {})
  (for suite in candidate/replay_suites
    (var family (family_by_id candidate/catalog suite/family_id))
    (if_not (&&
              (!= family nil)
              (== suite/semantic_signature family/semantic_signature)
              (== (suite/cases ~ size) candidate/replay_cases_per_family)
              (== (replay_ids ~ get suite/family_id) void))
      (set replay_valid false))
    (replay_ids ~ put! suite/family_id true)
    (for test_case in suite/cases
      (set replay_case_count (+ replay_case_count 1))
      (if (== family nil)
        (then (set replay_valid false))
        (else
          (var execution
            (try_run_program
              subject family/canonical_program [] test_case/input))
          (if_not (&& execution/valid
                      (== execution/output test_case/expected))
            (set replay_valid false))))))

  (var training_valid
    (== (candidate/training ~ size)
        (* candidate/family_count candidate/variants_per_family)))
  (var training_ids : Map {})
  (var training_index 0)
  (for task in candidate/training
    (var variant (// training_index candidate/variants_per_family))
    (if_not (verify_task
              subject candidate/catalog task (quote training) variant 1)
      (set training_valid false))
    (if (!= (training_ids ~ get task/public/id) void)
      (set training_valid false))
    (training_ids ~ put! task/public/id true)
    (set training_index (+ training_index 1)))

  (var expected_probe_count 0)
  (var checkpoint candidate/retention_block_size)
  (while (<= checkpoint candidate/family_count)
    (set expected_probe_count (+ expected_probe_count checkpoint))
    (set checkpoint (+ checkpoint candidate/retention_block_size)))
  (var probes_valid
    (== (candidate/retention_probes ~ size) expected_probe_count))
  (var probe_ids : Map {})
  (for task in candidate/retention_probes
    (if_not (verify_task
              subject candidate/catalog task (quote retention_probe)
              pack_index 1)
      (set probes_valid false))
    (if (!= (probe_ids ~ get task/public/id) void)
      (set probes_valid false))
    (probe_ids ~ put! task/public/id true))

  (var compositions_valid
    (== (candidate/heldout_compositions ~ size)
        candidate/heldout_composition_count))
  (var composition_ids : Map {})
  (var composition_tuples : Map {})
  (var sound_component_count 0)
  (for task in candidate/heldout_compositions
    (if_not (verify_component_composition
              subject candidate/catalog candidate_index task
              candidate/composition_arity candidate/attempts_per_component)
      (set compositions_valid false))
    (set sound_component_count
      (+ sound_component_count candidate/composition_arity))
    (var tuple_parts : (List Str) [])
    (for component in task/public/components
      (tuple_parts ~ push! component/workflow_id))
    (var tuple_key (join tuple_parts "|"))
    (if (!= (composition_tuples ~ get tuple_key) void)
      (set compositions_valid false))
    (composition_tuples ~ put! tuple_key true)
    (if (!= (composition_ids ~ get task/public/id) void)
      (set compositions_valid false))
    (composition_ids ~ put! task/public/id true))

  (var recomputed_stats
    (admissible_candidate_stats candidate_index candidate/catalog))
  (var counts_valid
    (&&
      (== candidate/version 3)
      (== candidate/base_version 2)
      (== candidate/family_count 30)
      (== candidate/variants_per_family 5)
      (== candidate/replay_cases_per_family 24)
      (== candidate/retention_block_size 5)
      (== candidate/heldout_composition_count 60)
      (>= candidate/composition_arity 2)
      (<= candidate/composition_arity 4)
      (>= candidate/attempts_per_component 1)
      (<= candidate/attempts_per_component 4)
      (== candidate/public_pack_index pack_index)
      (== candidate/candidate_program_count 1885)
      (== candidate/distinct_behavior_count (complete/behaviors ~ size))
      (== candidate/teachable_behavior_count
          (teachable/teachable_behaviors ~ size))
      (== candidate/admissible_candidate_total recomputed_stats/total)
      (== candidate/minimum_admissible_candidates recomputed_stats/minimum)
      (== candidate/maximum_admissible_candidates recomputed_stats/maximum)
      (== replay_case_count 720)
      (== expected_probe_count 105)))
  (var valid
    (&& counts_valid catalog_valid operation_coverage_valid order_valid
        replay_valid training_valid probes_valid compositions_valid))
  `(component_workflow_subject_verification
     ^valid %valid
     ^family_count %(candidate/catalog ~ size)
     ^candidate_program_count %candidate/candidate_program_count
     ^distinct_behavior_count %candidate/distinct_behavior_count
     ^teachable_behavior_count %candidate/teachable_behavior_count
     ^admissible_candidate_total %candidate/admissible_candidate_total
     ^minimum_admissible_candidates %candidate/minimum_admissible_candidates
     ^maximum_admissible_candidates %candidate/maximum_admissible_candidates
     ^catalog_valid %catalog_valid
     ^operation_coverage_valid %operation_coverage_valid
     ^order_valid %order_valid
     ^replay_valid %replay_valid
     ^replay_case_count %replay_case_count
     ^training_valid %training_valid
     ^training_task_count %(candidate/training ~ size)
     ^probes_valid %probes_valid
     ^retention_probe_count %(candidate/retention_probes ~ size)
     ^compositions_valid %compositions_valid
     ^heldout_composition_count %(candidate/heldout_compositions ~ size)
     ^sound_component_count %sound_component_count
     ^counts_valid %counts_valid))
