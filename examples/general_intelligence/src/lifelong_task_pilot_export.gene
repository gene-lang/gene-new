# Trusted exporter for the experiment-4 excluded difficulty pilot. The Python
# harness projects only id/goal/input to the model; expected output and exact
# operations stay on its verifier side.

(mod lifelong_task_pilot_export)

(import $json [stringify])
(import gene/parse [parse_int])
(import [generate_lifelong_subject verify_lifelong_subject program_steps]
        from "./lifelong_task_subject.gene")

(fn operation_name [step : Node] : Str
  (match step
    (when (tail) "tail")
    (when (init) "init")
    (when (reverse) "reverse")
    (when (rotate_left) "rotate_left")
    (when (rotate_right) "rotate_right")
    (when (map_add_one) "map_add_one")
    (when (map_sub_one) "map_sub_one")
    (when (map_double) "map_double")
    (when (map_negate) "map_negate")
    (when (keep_even) "keep_even")
    (when (keep_odd) "keep_odd")
    (when (duplicate_each) "duplicate_each")
    (else ($panic "unknown lifelong pilot operation"))))

(fn main [args] : Nil
  (var argv ($body args))
  (if_not (== (argv ~ size) 4)
    ($panic
      "usage: lifelong_task_pilot_export <catalog-seed> <order-seed> <count> <composition-arity>"))
  (var catalog_seed (parse_int argv/0))
  (var order_seed (parse_int argv/1))
  (var count (parse_int argv/2))
  (var composition_arity (parse_int argv/3))
  (if (|| (<= count 0) (> count 60))
    ($panic "lifelong pilot count must be in 1..60"))
  (var subject
    (generate_lifelong_subject
      catalog_seed order_seed 30 5 60 composition_arity))
  (var evidence (verify_lifelong_subject subject))
  (if_not evidence/valid
    ($panic $"lifelong pilot subject invalid: ${evidence}"))
  (repeat index in count
    (var task subject/heldout_compositions/%index)
    (var operations : (List Str) [])
    (for step in (program_steps task/verifier/target_program)
      (operations ~ push! (operation_name step)))
    ($println
      (stringify
        {^schema 1
         ^id task/public/id
         ^goal task/public/goal
         ^input task/public/input
         ^expected task/verifier/expected
         ^operations operations}))))
