# Trusted evaluator entry point for one hash-verified frozen episode batch.
# The caller supplies only read authority and an exact file selected from the
# freeze manifest. This process never regenerates the episode stream.

(import $fs [read_text])
(import $json [stringify])
(import $serde [read_data write_data])
(import [default_subject verify_subject] from "./exact_belief.gene")
(import [evaluate_episode_batch evaluate_paired_episode_batch
         subject_with_preference_multiplier]
        from "./active_inference_experiment.gene")

(fn metrics_map [metrics : Node] : Map
  {^incorrect metrics/incorrect
   ^completed metrics/completed
   ^inspections metrics/inspections
   ^utility metrics/utility})

(fn paired_map [result : Node] : Map
  {^greedy (metrics_map result/greedy)
   ^reward (metrics_map result/reward)
   ^random (metrics_map result/random)
   ^active (metrics_map result/active)
   ^planner_elapsed_ms result/planner_elapsed_ms})

(fn paired_projection [result : Node] : Node
  `(paired_batch_result
     ^episode_seed %result/episode_seed
     ^random_seed %result/random_seed
     ^episode_count %result/episode_count
     ^active_beta %result/active_beta
     ^planner_elapsed_ms %result/planner_elapsed_ms
     ^reward_policy %result/reward_policy
     ^active_policy %result/active_policy
     ^reward %result/reward
     ^active %result/active
     ^final_episode_state %result/final_episode_state
     ^final_random_state %result/final_random_state))

(fn append_beta_result [details : List, summaries : List, name : Str,
                        beta : Float, result : Node] : Nil
  (details ~ push
    `(beta_sensitivity ^name %name ^beta %beta ^result %result))
  (summaries ~ push
    {^name name
     ^beta beta
     ^reward (metrics_map result/reward)
     ^active (metrics_map result/active)
     ^planner_elapsed_ms result/planner_elapsed_ms}))

(fn append_preference_result [details : List, summaries : List,
                              subject : Node, prior : (List Float),
                              batch : Node, name : Str, field : Str,
                              multiplier : Float] : Nil
  (var varied
    (subject_with_preference_multiplier subject field multiplier))
  (var result
    (evaluate_paired_episode_batch varied prior batch varied/beta))
  (details ~ push
    `(preference_sensitivity
       ^name %name ^field %field ^multiplier %multiplier ^result %result))
  (summaries ~ push
    {^name name
     ^field field
     ^multiplier multiplier
     ^reward (metrics_map result/reward)
     ^active (metrics_map result/active)
     ^planner_elapsed_ms result/planner_elapsed_ms}))

(fn main [args] : Nil
  (var argv ($body args))
  (if_not (== (argv ~ size) 2)
    ($panic
      "usage: active_inference_frozen_batch <base|shifted> <episode-file>"))
  (var subject (default_subject))
  (var subject_evidence (verify_subject subject))
  (if_not subject_evidence/valid
    ($panic "frozen-batch evaluator subject is invalid"))
  (var prior_name argv/0)
  (var prior
    (if (== prior_name "base")
      (then subject/base_prior)
      (else
        (if_not (== prior_name "shifted")
          ($panic "prior must be base or shifted"))
        subject/shifted_prior)))
  (var batch (read_data (read_text argv/1)))
  (var primary (evaluate_episode_batch subject prior batch))
  (var beta_details [])
  (var beta_summaries [])
  (var preference_details [])
  (var preference_summaries [])
  (if_yes (== prior_name "base")
    (append_beta_result beta_details beta_summaries
      "beta_0_10" 0.10
      (evaluate_paired_episode_batch subject prior batch 0.10))
    (append_beta_result beta_details beta_summaries
      "beta_0_25" 0.25 (paired_projection primary))
    (append_beta_result beta_details beta_summaries
      "beta_0_50" 0.50
      (evaluate_paired_episode_batch subject prior batch 0.50))
    (append_preference_result
      preference_details preference_summaries subject prior batch
      "correct_repair_utility_minus_10_percent"
      "correct_repair_utility" 0.90)
    (append_preference_result
      preference_details preference_summaries subject prior batch
      "correct_repair_utility_plus_10_percent"
      "correct_repair_utility" 1.10)
    (append_preference_result
      preference_details preference_summaries subject prior batch
      "incorrect_repair_utility_minus_10_percent"
      "incorrect_repair_utility" 0.90)
    (append_preference_result
      preference_details preference_summaries subject prior batch
      "incorrect_repair_utility_plus_10_percent"
      "incorrect_repair_utility" 1.10)
    (append_preference_result
      preference_details preference_summaries subject prior batch
      "defer_utility_minus_10_percent" "defer_utility" 0.90)
    (append_preference_result
      preference_details preference_summaries subject prior batch
      "defer_utility_plus_10_percent" "defer_utility" 1.10)
    (append_preference_result
      preference_details preference_summaries subject prior batch
      "inspection_cost_minus_10_percent" "inspection_cost" 0.90)
    (append_preference_result
      preference_details preference_summaries subject prior batch
      "inspection_cost_plus_10_percent" "inspection_cost" 1.10))
  ($println
    (write_data
      `(active_inference_frozen_result
         ^version 1
         ^prior %prior_name
         ^primary %primary
         ^beta_sensitivities %beta_details
         ^preference_sensitivities %preference_details)))
  # The second line is a redundant machine-readable projection. The canonical
  # Gene result above remains the authoritative detailed record.
  ($println
    (stringify
      {^schema 1
       ^experiment "active_inference_v1"
       ^prior prior_name
       ^episode_seed batch/episode_seed
       ^random_seed batch/random_seed
       ^episode_count (batch/episodes ~ size)
       ^final_episode_state batch/final_episode_state
       ^final_random_state batch/final_random_state
       ^primary (paired_map primary)
       ^beta_sensitivities beta_summaries
       ^preference_sensitivities preference_summaries})))
