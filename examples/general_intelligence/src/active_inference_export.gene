# Canonical episode-batch exporter used only by the protocol freeze tool. It
# generates potential observations and random-arm draws but executes no arm and
# emits no treatment metric.

(import $serde [write_data])
(import gene/parse [parse_int])
(import [default_subject] from "./exact_belief.gene")
(import [generate_batch] from "./active_inference_experiment.gene")

(fn main [args] : Nil
  (var argv ($body args))
  (if_not (== (argv .size) 4)
    ($panic
      "usage: active_inference_export <base|shifted> <episode_seed> <random_seed> <episode_count>"))
  (var subject (default_subject))
  (var prior
    (if (== argv/0 "base")
      (then subject/base_prior)
      (else
        (if_not (== argv/0 "shifted")
          ($panic "prior must be base or shifted"))
        subject/shifted_prior)))
  (var batch
    (generate_batch subject prior
      (parse_int argv/1) (parse_int argv/2) (parse_int argv/3)))
  ($println (write_data batch)))
