# Trusted exact-execution kernel for the experiment-4 service-boundary pilot.
# The Python service grants this process read access to one verifier-owned suite
# file. Candidate source is parsed as data and executed only through the closed
# verified-skills pipeline; it is never passed to eval.

(mod skill_verifier_service_kernel)

(import $fs [read_text])
(import $json [parse stringify])
(import $serde [write_data])
(import $str [byte_size])
(import gene/stream [into])
(import gene/parse [read_all])
(import [candidate_digest candidate_shape execute_candidate]
        from "./verified_skills.gene")

(fn valid_suite_case? [test] : Bool
  (match test
    (when {^id (id : Str) ^input (input : Str) ^expected (expected : Str)}
      (&&
        (!= id "")
        (<= (byte_size id) 128)
        (<= (byte_size input) 4096)
        (<= (byte_size expected) 4096)))
    (else false)))

(fn main [args, ^suites : Capability] : Nil
  (var argv ($body args))
  (if_not (== (argv ~ size) 2)
    ($panic
      "usage: skill_verifier_service_kernel <candidate-gene> <suite-json>"))
  (if (> (byte_size argv/0) 16384)
    ($panic "candidate source exceeds 16384 bytes"))
  (var forms ((read_all argv/0) ~ into []))
  (if_not (== (forms ~ size) 1)
    ($panic "candidate argument must contain exactly one Gene form"))
  (var candidate forms/0)
  (var suite (parse (read_text suites argv/1)))
  (var suite_id "")
  (var cases [])
  (var suite_valid
    (match suite
      (when {^schema 1 ^suite_id (id : Str) ^cases (items : List)}
        (set suite_id id)
        (set cases items)
        (&& (!= id "")
            (! (items ~ empty?))
            (<= (items ~ size) 64)))
      (else false)))
  (if_yes suite_valid
    (for test in cases
      (if_not (valid_suite_case? test)
        (set suite_valid false))))
  (if_not suite_valid
    ($panic "verifier suite has an invalid closed schema"))

  (var shape (candidate_shape candidate))
  (var failures : (List Str) [])
  (var passed_count 0)
  (if shape/valid
    (then
      (for test in cases
        (if (== (execute_candidate candidate test/input) test/expected)
          (set passed_count (+ passed_count 1))
          (failures ~ push test/id))))
    (else
      (for test in cases
        (failures ~ push test/id))))
  (var total (cases ~ size))
  (var passed (== passed_count total))
  (var candidate_id (candidate_digest candidate))
  (var evidence
    (if passed
      (then
        (var skill
          `(skill
             ^id %shape/id ^name %shape/name ^version %shape/version
             ^program %shape/program ^preconditions %shape/preconditions
             ^effects %shape/effects ^provenance %shape/provenance
             ^candidate_digest %candidate_id))
        `(verifier_kernel_evidence
           ^schema 1 ^verifier_id "gene_skill_verifier_service_v1"
           ^suite_id %suite_id ^candidate_digest %candidate_id
           ^passed true ^tests_passed %passed_count ^tests_total %total
           ^failure_codes %failures ^skill %skill))
      (else
        `(verifier_kernel_evidence
           ^schema 1 ^verifier_id "gene_skill_verifier_service_v1"
           ^suite_id %suite_id ^candidate_digest %candidate_id
           ^passed false ^tests_passed %passed_count ^tests_total %total
           ^failure_codes %failures))))
  ($println (write_data evidence))
  ($println
    (stringify
      {^schema 1
       ^verifier_id "gene_skill_verifier_service_v1"
       ^suite_id suite_id
       ^candidate_digest candidate_id
       ^passed passed
       ^tests_passed passed_count
       ^tests_total total
       ^failure_codes failures})))
