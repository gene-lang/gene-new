# Deterministic, exactly checkable task subject for experiment 4. Public task
# projections contain a natural-language workflow and input. Target programs,
# expected outputs, required family identities, and replay cases stay in the
# verifier projection. Programs are data and execute only through experiment
# 1's closed twelve-primitive list interpreter.

(mod lifelong_task_subject
  @doc "deterministic lifelong-task families and verifier-owned projections")

(import $str [join])
(import $serde [write_data])
(import [default_induction_subject run_program try_run_program structural_screen_inputs
         program_signature shorter_signature_index corpus_draw random_program
         generate_input]
        from "./library_induction.gene")

(fn lifelong_interpreter_subject [composition_arity : Int] : Node
  (var subject (default_induction_subject))
  (subject ~ set_prop! `max_expanded_steps (* composition_arity 3))
  (subject ~ set_prop! `max_input_items 256)
  (subject ~ set_prop! `max_output_items 256)
  subject)

(fn operation_phrase [step : Node] : Str
  (match step
    (when (tail) "drop the first item (tail)")
    (when (init) "drop the last item (init)")
    (when (reverse) "reverse the item order (reverse)")
    (when (rotate_left)
      "rotate the first item to the end (rotate_left)")
    (when (rotate_right)
      "rotate the last item to the front (rotate_right)")
    (when (map_add_one) "add one to every item (map_add_one)")
    (when (map_sub_one) "subtract one from every item (map_sub_one)")
    (when (map_double) "double every item (map_double)")
    (when (map_negate) "negate every item (map_negate)")
    (when (keep_even) "keep only even items (keep_even)")
    (when (keep_odd) "keep only odd items (keep_odd)")
    (when (duplicate_each)
      "duplicate every item in place (duplicate_each)")
    (else ($panic "unknown lifelong-task operation"))))

(fn operation_capability [step : Node]
  (match step
    (when (tail) (quote shrink_sequence))
    (when (init) (quote shrink_sequence))
    (when (reverse) (quote reorder_sequence))
    (when (rotate_left) (quote reorder_sequence))
    (when (rotate_right) (quote reorder_sequence))
    (when (map_add_one) (quote numeric_map))
    (when (map_sub_one) (quote numeric_map))
    (when (map_double) (quote numeric_map))
    (when (map_negate) (quote numeric_map))
    (when (keep_even) (quote predicate_filter))
    (when (keep_odd) (quote predicate_filter))
    (when (duplicate_each) (quote expand_sequence))
    (else ($panic "unknown lifelong-task operation"))))

(fn program_steps [program : Node] : (List Node)
  (match program
    (when (program steps...) steps)
    (else ($panic "lifelong target must be a program node"))))

(fn program_instruction [program : Node] : Str
  (var phrases : (List Str) [])
  (for step in (program_steps program)
    (phrases ~ push! (operation_phrase step)))
  (var joined (join phrases "; then "))
  $"Apply these operations in order: ${joined}. Return the exact resulting integer list.")

(fn program_capabilities [program : Node] : List
  (var result : List [])
  (for step in (program_steps program)
    (var capability (operation_capability step))
    (if_not (result ~ contains? capability)
      (result ~ push! capability)))
  result)

(fn compose_program_list [programs : (List Node)] : Node
  (var steps : (List Node) [])
  (for program in programs
    (for step in (program_steps program)
      (steps ~ push! step)))
  `(program %steps...))

(fn generate_family_catalog [subject : Node, initial_state : Int,
                             count : Int] : Node
  (if (|| (<= count 0) (> count 30))
    ($panic "lifelong family count must be in 1..30"))
  (var state initial_state)
  (var shorter_index (shorter_signature_index subject 2))
  (var screen_inputs shorter_index/screen_inputs)
  (var used_signatures : Map {})
  (var families : (List Node) [])
  (var attempts 0)
  (var shorter_rejections 0)
  (var duplicate_rejections 0)
  (while (< (families ~ size) count)
    (if (>= attempts 100000)
      ($panic "lifelong family generation exhausted its attempt bound"))
    (set attempts (+ attempts 1))
    (var draw (random_program subject state 3))
    (set state draw/state)
    (var signature (program_signature subject draw/program screen_inputs))
    (if (!= (shorter_index/signatures ~ get signature) void)
      (then (set shorter_rejections (+ shorter_rejections 1)))
      (elif (!= (used_signatures ~ get signature) void)
        (set duplicate_rejections (+ duplicate_rejections 1)))
      (else
        (used_signatures ~ put! signature true)
        (var index (families ~ size))
        (var family_id $"workflow_family_${index}")
        (families ~ push!
          `(task_family
             ^index %index
             ^id %family_id
             ^program %draw/program
             ^program_signature %signature
             ^capabilities %(program_capabilities draw/program)
             ^instruction %(program_instruction draw/program))))))
  `(family_catalog_generation
     ^state %state
     ^families %families
     ^attempts %attempts
     ^shorter_rejections %shorter_rejections
     ^duplicate_rejections %duplicate_rejections))

(fn generate_family_order [initial_state : Int, count : Int] : Node
  (var state initial_state)
  (var order : (List Int) [])
  (var selected : Map {})
  (while (< (order ~ size) count)
    (var draw (corpus_draw state count))
    (set state draw/state)
    (var key $"${draw/value}")
    (if_yes (== (selected ~ get key) void)
      (selected ~ put! key true)
      (order ~ push! draw/value)))
  `(family_order_generation ^state %state ^order %order))

(fn draw_effective_case [subject : Node, program : Node,
                         initial_state : Int] : Node
  (var state initial_state)
  (var attempts 0)
  (while (< attempts 1000)
    (set attempts (+ attempts 1))
    (var draw (generate_input state))
    (set state draw/state)
    (var output (run_program subject program [] draw/input))
    (if (&& (!= output draw/input) (! (output ~ empty?)))
      (return
        `(case_draw
           ^state %state ^input %draw/input ^expected %output
           ^attempts %attempts))))
  ($panic "could not draw an effective lifelong task case"))

(fn generate_composition_input [initial_state : Int] : Node
  (var length_draw (corpus_draw initial_state 9))
  (var state length_draw/state)
  (var input : (List Int) [])
  (repeat _ in (+ length_draw/value 12)
    (var value_draw (corpus_draw state 11))
    (set state value_draw/state)
    (input ~ push! (- value_draw/value 5)))
  `(input_draw ^state %state ^input %input))

(fn draw_composition_case [subject : Node, programs : (List Node),
                           initial_state : Int] : Node
  (var state initial_state)
  (var attempts 0)
  (while (< attempts 1000)
    (set attempts (+ attempts 1))
    (var draw (generate_composition_input state))
    (set state draw/state)
    (var current draw/input)
    (var all_components_effective true)
    (for program in programs
      (var execution (try_run_program subject program [] current))
      (if_not execution/valid
        (set all_components_effective false)
        (break))
      (if (== execution/output current)
        (set all_components_effective false))
      (set current execution/output))
    (if (&& all_components_effective (! (current ~ empty?)))
      (return
        `(case_draw
           ^valid true ^state %state ^input %draw/input
           ^expected %current ^attempts %attempts))))
  `(case_draw ^valid false ^state %state ^attempts %attempts))

(fn task_record [id : Str, kind, instruction : Str, input : (List Int),
                 expected : (List Int), target_program : Node,
                 required_family_ids : List] : Node
  `(lifelong_task
     ^public
       (task
         ^id %id ^kind %kind ^goal %instruction ^input %input
         ^tool_contract "apply_operation_or_verified_skill_then_submit")
     ^verifier
       (task_verifier
         ^expected %expected ^target_program %target_program
         ^required_family_ids %required_family_ids
         ^require_exact_expanded_trace true)))

(fn generate_training_tasks [subject : Node, families : (List Node),
                             order : (List Int), initial_state : Int,
                             variants_per_family : Int] : Node
  (var state initial_state)
  (var tasks : (List Node) [])
  (var order_position 0)
  (while (< order_position (order ~ size))
    (var family_index order/%order_position)
    (var family families/%family_index)
    (repeat variant in variants_per_family
      (var draw (draw_effective_case subject family/program state))
      (set state draw/state)
      (tasks ~ push!
        (task_record
          $"train_${order_position}_${variant}" (quote training)
          family/instruction draw/input draw/expected family/program
          [family/id])))
    (set order_position (+ order_position 1)))
  `(task_generation ^state %state ^tasks %tasks))

(fn generate_replay_suites [subject : Node, families : (List Node),
                            initial_state : Int,
                            random_case_count : Int] : Node
  (var state initial_state)
  (var suites : (List Node) [])
  (var screen_inputs (structural_screen_inputs))
  (for family in families
    (var cases : (List Node) [])
    (var case_index 0)
    (for input in screen_inputs
      (var case_id $"${family/id}_structural_${case_index}")
      (cases ~ push!
        `(skill_case
           ^id %case_id
           ^input %input
           ^expected %(run_program subject family/program [] input)))
      (set case_index (+ case_index 1)))
    (repeat random_index in random_case_count
      (var draw (generate_input state))
      (set state draw/state)
      (var case_id $"${family/id}_random_${random_index}")
      (cases ~ push!
        `(skill_case
           ^id %case_id
           ^input %draw/input
           ^expected %(run_program
                        subject family/program [] draw/input))))
    (suites ~ push!
      `(skill_replay_suite
         ^family_id %family/id ^target_program %family/program
         ^cases %cases)))
  `(replay_suite_generation ^state %state ^suites %suites))

(fn generate_retention_probes [subject : Node, families : (List Node),
                               order : (List Int), initial_state : Int,
                               block_size : Int] : Node
  (var state initial_state)
  (var tasks : (List Node) [])
  (var checkpoint block_size)
  (while (<= checkpoint (order ~ size))
    (var introduced_position 0)
    (while (< introduced_position checkpoint)
      (var family_index order/%introduced_position)
      (var family families/%family_index)
      (var draw (draw_effective_case subject family/program state))
      (set state draw/state)
      (tasks ~ push!
        (task_record
          $"probe_${checkpoint}_${introduced_position}" (quote retention_probe)
          family/instruction draw/input draw/expected family/program
          [family/id]))
      (set introduced_position (+ introduced_position 1)))
    (set checkpoint (+ checkpoint block_size)))
  `(task_generation ^state %state ^tasks %tasks))

(fn generate_composition_tasks [subject : Node, families : (List Node),
                                initial_state : Int, count : Int,
                                composition_arity : Int] : Node
  (var state initial_state)
  (var tasks : (List Node) [])
  (var used_tuples : Map {})
  (var attempts 0)
  (while (< (tasks ~ size) count)
    (if (>= attempts 100000)
      ($panic "lifelong composition generation exhausted its attempt bound"))
    (set attempts (+ attempts 1))
    (var selected : Map {})
    (var family_ids : (List Str) [])
    (var programs : (List Node) [])
    (var tuple_parts : (List Str) [])
    (while (< (programs ~ size) composition_arity)
      (var family_draw (corpus_draw state (families ~ size)))
      (set state family_draw/state)
      (var index_key $"${family_draw/value}")
      (if_yes (== (selected ~ get index_key) void)
        (selected ~ put! index_key true)
        (var family_index family_draw/value)
        (var family families/%family_index)
        (family_ids ~ push! family/id)
        (programs ~ push! family/program)
        (tuple_parts ~ push! index_key)))
    (var tuple_key (join tuple_parts "_"))
    (if_yes (== (used_tuples ~ get tuple_key) void)
      (var draw (draw_composition_case subject programs state))
      (set state draw/state)
      (if_yes draw/valid
        (used_tuples ~ put! tuple_key true)
        (var program (compose_program_list programs))
        (var task_index (tasks ~ size))
        (tasks ~ push!
          (task_record
            $"composition_${task_index}" (quote heldout_composition)
            (program_instruction program)
            draw/input draw/expected program family_ids)))))
  `(task_generation
     ^state %state ^tasks %tasks ^attempts %attempts))

(fn generate_lifelong_subject [catalog_seed : Int, order_seed : Int,
                               family_count : Int,
                               variants_per_family : Int,
                               heldout_count : Int,
                               composition_arity : Int] : Node
  (if (|| (<= catalog_seed 0) (>= catalog_seed 2147483647))
    ($panic "lifelong catalog seed must be in 1..2147483646"))
  (if (|| (<= order_seed 0) (>= order_seed 2147483647))
    ($panic "lifelong order seed must be in 1..2147483646"))
  (if (|| (!= family_count 30) (!= variants_per_family 5))
    ($panic "primary lifelong subject requires 30 families and five variants"))
  (if (!= heldout_count 60)
    ($panic "primary lifelong subject requires 60 heldout compositions"))
  (if (|| (< composition_arity 2) (> composition_arity 8))
    ($panic "lifelong composition arity must be in 2..8"))
  (var subject (lifelong_interpreter_subject composition_arity))
  (var catalog
    (generate_family_catalog subject catalog_seed family_count))
  (var order (generate_family_order order_seed family_count))
  (var replay
    (generate_replay_suites subject catalog/families order/state 8))
  (var training
    (generate_training_tasks
      subject catalog/families order/order replay/state variants_per_family))
  (var probes
    (generate_retention_probes
      subject catalog/families order/order training/state 5))
  (var compositions
    (generate_composition_tasks
      subject catalog/families probes/state heldout_count composition_arity))
  `(lifelong_subject
     ^version 1
     ^generator "park_miller_48271_mod_2147483647"
     ^catalog_seed %catalog_seed ^order_seed %order_seed
     ^family_count %family_count
     ^variants_per_family %variants_per_family
     ^replay_cases_per_family 24
     ^retention_block_size 5
     ^heldout_composition_count %heldout_count
     ^composition_arity %composition_arity
     ^catalog %catalog/families
     ^family_order %order/order
     ^replay_suites %replay/suites
     ^training %training/tasks
     ^retention_probes %probes/tasks
     ^heldout_compositions %compositions/tasks
     ^generation
       (generation_stats
         ^catalog_attempts %catalog/attempts
         ^catalog_shorter_rejections %catalog/shorter_rejections
         ^catalog_duplicate_rejections %catalog/duplicate_rejections
         ^composition_attempts %compositions/attempts
         ^final_random_state %compositions/state)))

(fn family_by_id [families : (List Node), family_id : Str] : Node?
  (for family in families
    (if (== family/id family_id) (return family)))
  nil)

(fn task_result_valid? [subject : Node, task : Node] : Bool
  (==
    (run_program
      subject task/verifier/target_program [] task/public/input)
    task/verifier/expected))

(fn verify_lifelong_subject [candidate : Node] : Node
  (var subject (lifelong_interpreter_subject candidate/composition_arity))
  (var families candidate/catalog)
  (var shorter_index (shorter_signature_index subject 2))
  (var screen_inputs shorter_index/screen_inputs)
  (var family_signatures : Map {})
  (var family_ids : Map {})
  (var catalog_valid (== (families ~ size) candidate/family_count))
  (var operation_coverage_valid true)
  (var family_index 0)
  (for family in families
    (var steps (program_steps family/program))
    (var signature
      (program_signature subject family/program screen_inputs))
    (if_not (&&
              (== family/index family_index)
              (== family/id $"workflow_family_${family_index}")
              (== (steps ~ size) 3)
              (== signature family/program_signature)
              (== (shorter_index/signatures ~ get signature) void)
              (== (family_signatures ~ get signature) void)
              (== (family_ids ~ get family/id) void)
              (== family/instruction (program_instruction family/program))
              (== family/capabilities
                  (program_capabilities family/program)))
      (set catalog_valid false))
    (family_signatures ~ put! signature true)
    (family_ids ~ put! family/id true)
    (set family_index (+ family_index 1)))
  (for primitive in subject/primitive_tokens
    (var present false)
    (for family in families
      (if_yes ((program_steps family/program) ~ contains? primitive)
        (set present true)))
    (if_not present (set operation_coverage_valid false)))

  (var order_valid (== (candidate/family_order ~ size) candidate/family_count))
  (var ordered : Map {})
  (for index in candidate/family_order
    (var key $"${index}")
    (if_not (&& (>= index 0) (< index candidate/family_count)
                (== (ordered ~ get key) void))
      (set order_valid false))
    (ordered ~ put! key true))

  (var replay_valid
    (== (candidate/replay_suites ~ size) candidate/family_count))
  (var replay_case_count 0)
  (var suite_ids : Map {})
  (for suite in candidate/replay_suites
    (var family (family_by_id families suite/family_id))
    (if (== family nil)
      (then (set replay_valid false))
      (else
        (if_not (== suite/target_program family/program)
          (set replay_valid false))))
    (if_not (== (suite/cases ~ size) candidate/replay_cases_per_family)
      (set replay_valid false))
    (var local_case_index 0)
    (var case_ids : Map {})
    (for test_case in suite/cases
      (set replay_case_count (+ replay_case_count 1))
      (if (!= (case_ids ~ get test_case/id) void)
        (set replay_valid false))
      (case_ids ~ put! test_case/id true)
      (if (== family nil)
        (then (set replay_valid false))
        (else
          (if_not (== test_case/expected
                      (run_program
                        subject family/program [] test_case/input))
            (set replay_valid false))))
      (if (< local_case_index (screen_inputs ~ size))
        (if_not (== test_case/input screen_inputs/%local_case_index)
          (set replay_valid false)))
      (set local_case_index (+ local_case_index 1)))
    (if (!= (suite_ids ~ get suite/family_id) void)
      (set replay_valid false))
    (suite_ids ~ put! suite/family_id true))

  (var training_valid
    (== (candidate/training ~ size)
        (* candidate/family_count candidate/variants_per_family)))
  (var training_counts : Map {})
  (var training_ids : Map {})
  (for task in candidate/training
    (var required task/verifier/required_family_ids)
    (if_not (&& (== task/public/kind (quote training))
                (== (required ~ size) 1)
                task/verifier/require_exact_expanded_trace
                (task_result_valid? subject task))
      (set training_valid false))
    (var family
      (if (== (required ~ size) 1)
        (family_by_id families required/0)
        nil))
    (if (== family nil)
      (then (set training_valid false))
      (else
        (if_not (&&
                  (== task/verifier/target_program family/program)
                  (== task/public/goal family/instruction)
                  (!= task/public/input task/verifier/expected)
                  (! (task/verifier/expected ~ empty?)))
          (set training_valid false))
        (var previous (training_counts ~ get family/id))
        (if (== previous void)
          (training_counts ~ put! family/id 1)
          (training_counts ~ put! family/id (+ previous 1)))))
    (if (!= (training_ids ~ get task/public/id) void)
      (set training_valid false))
    (training_ids ~ put! task/public/id true))
  (for family in families
    (if_not (== (training_counts ~ get family/id)
                candidate/variants_per_family)
      (set training_valid false)))

  (var expected_probe_count 0)
  (var checkpoint candidate/retention_block_size)
  (while (<= checkpoint candidate/family_count)
    (set expected_probe_count (+ expected_probe_count checkpoint))
    (set checkpoint (+ checkpoint candidate/retention_block_size)))
  (var probes_valid
    (== (candidate/retention_probes ~ size) expected_probe_count))
  (var probe_ids : Map {})
  (for task in candidate/retention_probes
    (var required task/verifier/required_family_ids)
    (var family
      (if (== (required ~ size) 1)
        (family_by_id families required/0)
        nil))
    (if_not (&&
              (== task/public/kind (quote retention_probe))
              (!= family nil)
              task/verifier/require_exact_expanded_trace
              (task_result_valid? subject task))
      (set probes_valid false))
    (if (!= family nil)
      (if_not (&&
                (== task/verifier/target_program family/program)
                (== task/public/goal family/instruction)
                (!= task/public/input task/verifier/expected)
                (! (task/verifier/expected ~ empty?)))
        (set probes_valid false)))
    (if (!= (probe_ids ~ get task/public/id) void)
      (set probes_valid false))
    (probe_ids ~ put! task/public/id true))

  (var compositions_valid
    (== (candidate/heldout_compositions ~ size)
        candidate/heldout_composition_count))
  (var composition_tuples : Map {})
  (var composition_ids : Map {})
  (for task in candidate/heldout_compositions
    (var required task/verifier/required_family_ids)
    (var programs : (List Node) [])
    (var tuple_parts : (List Str) [])
    (var family_seen : Map {})
    (var components_valid
      (== (required ~ size) candidate/composition_arity))
    (for family_id in required
      (var family (family_by_id families family_id))
      (if (|| (== family nil) (!= (family_seen ~ get family_id) void))
        (then (set components_valid false))
        (else
          (family_seen ~ put! family_id true)
          (programs ~ push! family/program)
          (tuple_parts ~ push! family_id))))
    (if_not (&& components_valid
              (== task/public/kind (quote heldout_composition))
              task/verifier/require_exact_expanded_trace
              (task_result_valid? subject task))
      (set compositions_valid false))
    (if components_valid
      (then
        (var expected_program (compose_program_list programs))
        (var current task/public/input)
        (var every_component_effective true)
        (for program in programs
          (var next (run_program subject program [] current))
          (if (== next current) (set every_component_effective false))
          (set current next))
        (if_not (&&
                  (== task/verifier/target_program expected_program)
                  (== task/public/goal
                      (program_instruction expected_program))
                  every_component_effective
                  (== task/verifier/expected current)
                  (! (task/verifier/expected ~ empty?)))
          (set compositions_valid false))
        (var tuple_key (join tuple_parts "|"))
        (if (!= (composition_tuples ~ get tuple_key) void)
          (set compositions_valid false))
        (composition_tuples ~ put! tuple_key true)))
    (if (!= (composition_ids ~ get task/public/id) void)
      (set compositions_valid false))
    (composition_ids ~ put! task/public/id true))

  (var counts_valid
    (&&
      (== candidate/family_count 30)
      (== candidate/variants_per_family 5)
      (== candidate/replay_cases_per_family 24)
      (== candidate/retention_block_size 5)
      (== candidate/heldout_composition_count 60)
      (>= candidate/composition_arity 2)
      (<= candidate/composition_arity 8)
      (== replay_case_count 720)
      (== expected_probe_count 105)))
  (var valid
    (&&
      (== candidate/version 1)
      (== candidate/generator "park_miller_48271_mod_2147483647")
      counts_valid catalog_valid operation_coverage_valid order_valid
      replay_valid training_valid probes_valid compositions_valid))
  `(lifelong_subject_verification
     ^valid %valid
     ^family_count %(families ~ size)
     ^operation_coverage_valid %operation_coverage_valid
     ^catalog_valid %catalog_valid
     ^order_valid %order_valid
     ^replay_valid %replay_valid
     ^replay_case_count %replay_case_count
     ^training_valid %training_valid
     ^training_task_count %(candidate/training ~ size)
     ^probes_valid %probes_valid
     ^retention_probe_count %(candidate/retention_probes ~ size)
     ^compositions_valid %compositions_valid
     ^heldout_composition_count %(candidate/heldout_compositions ~ size)
     ^counts_valid %counts_valid))
