# Permanently excluded version-2 subject-generation smoke for experiment 4.

(mod latent_workflow_subject_smoke)

(import [generate_latent_workflow_subject verify_latent_workflow_subject]
        from "../src/latent_workflow_subject.gene")

(var subject
  (generate_latent_workflow_subject 910101 910102 30 5 60 2))
(var evidence (verify_latent_workflow_subject subject))
(if_not evidence/valid
  ($panic $"latent workflow subject invalid: ${evidence}"))

($println
  $"latent workflow subject smoke: families=${evidence/family_count} training=${evidence/training_task_count} probes=${evidence/retention_probe_count} heldout=${evidence/heldout_composition_count}")
($println
  $"candidate_programs=${evidence/candidate_program_count} distinct_behaviors=${evidence/distinct_behavior_count} teachable_behaviors=${evidence/teachable_behavior_count}")
($println
  $"catalog_valid=${evidence/catalog_valid} operation_coverage=${evidence/operation_coverage_valid} order_valid=${evidence/order_valid}")
($println
  $"replay_valid=${evidence/replay_valid} replay_cases=${evidence/replay_case_count} training_valid=${evidence/training_valid} probes_valid=${evidence/probes_valid} compositions_valid=${evidence/compositions_valid}")
($println
  $"composition_arity=${subject/composition_arity} catalog_attempts=${subject/generation/catalog_attempts} composition_attempts=${subject/generation/composition_attempts} final_random_state=${subject/generation/final_random_state}")
