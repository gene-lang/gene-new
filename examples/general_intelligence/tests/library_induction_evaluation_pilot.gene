(import [build_unrelated_library_control corpus_solution_programs
         default_induction_subject evaluate_exact_enumerator generate_corpus
         induce_library_iterative verify_generated_corpus
         verify_iterative_induction]
        from "../src/library_induction.gene")

(fn main [args] : Nil
  (var subject (default_induction_subject))
  (var corpus (generate_corpus subject 900301 100 25 50))
  (var corpus_evidence (verify_generated_corpus subject corpus))
  (var programs (corpus_solution_programs corpus))
  (var induction (induce_library_iterative subject programs))
  (var induction_evidence
    (verify_iterative_induction subject programs induction))
  (var control
    (build_unrelated_library_control
      subject corpus/seed induction/library [900401 900402 900403]))
  (if_not (&& corpus_evidence/valid
              (&& induction_evidence/valid control/accepted))
    ($panic
      $"library-induction evaluation pilot setup invalid: corpus=${corpus_evidence} induction=${induction_evidence} control=${control}"))
  (var evaluation
    (evaluate_exact_enumerator
      subject corpus induction/library control/library))
  ($println
    $"library-induction evaluation pilot: corpus_seed=${corpus/seed} donor_seed=${control/seed} donor_attempts=${control/attempts} tasks=${(corpus/heldout .size)} candidate_budget=${evaluation/candidate_budget} base_solved=${evaluation/base/solved} base_candidates=${evaluation/base/candidate_executions} base_verifier_rejections=${evaluation/base/verifier_rejections} induced_solved=${evaluation/induced/solved} induced_candidates=${evaluation/induced/candidate_executions} induced_verifier_rejections=${evaluation/induced/verifier_rejections} induced_library_solutions=${evaluation/induced/library_solutions} unrelated_solved=${evaluation/unrelated/solved} unrelated_candidates=${evaluation/unrelated/candidate_executions} unrelated_verifier_rejections=${evaluation/unrelated/verifier_rejections} unrelated_library_solutions=${evaluation/unrelated/library_solutions} induced_advantage=${evaluation/induced_advantage}"))
