# Same-process structural smoke for exact candidate execution and receipt
# validation. Process separation is exercised by tests/test_cli.nim.

(mod verified_skill_records_smoke)

(import [candidate_digest candidate_shape execute_candidate
         receipt_well_formed? seal_receipt]
        from "../src/verified_skills.gene")

(fn main [args] : Nil
  (var candidate
    (quote
      (skill_candidate
        ^id "normalize_words_v1" ^name "normalize_words" ^version 1
        ^preconditions ["string input"] ^effects ["normalized string"]
        ^provenance ["mechanism_pilot"]
        (pipeline (trim) (lowercase) (replace ^from " " ^to "_")))))
  (var shape (candidate_shape candidate))
  (if_not shape/valid ($panic "valid candidate rejected"))
  (if_not (== (execute_candidate candidate " Gene Nodes ") "gene_nodes")
    ($panic "candidate execution mismatch"))
  (var too_many_steps
    (quote
      (skill_candidate
        ^id "too_many" ^name "too_many" ^version 1
        ^preconditions [] ^effects [] ^provenance []
        (pipeline (trim) (trim) (trim) (trim) (trim)
                  (trim) (trim) (trim) (trim)))))
  (if (candidate_shape too_many_steps)/valid
    ($panic "unbounded candidate accepted"))
  (var empty_replace
    (quote
      (skill_candidate
        ^id "empty_replace" ^name "empty_replace" ^version 1
        ^preconditions [] ^effects [] ^provenance []
        (pipeline (replace ^from "" ^to "x")))))
  (if (candidate_shape empty_replace)/valid
    ($panic "empty replacement source accepted"))
  (var payload
    `(verification_receipt
       ^schema 1 ^verifier_id "smoke"
       ^suite_digest "suite" ^candidate_digest %(candidate_digest candidate)
       ^passed true ^tests_passed 1 ^tests_total 1 ^failure_codes []
       ^previous_receipt_digest "genesis"))
  (var receipt (seal_receipt payload))
  (if_not (receipt_well_formed? receipt)
    ($panic "well-formed receipt rejected"))
  (receipt ~ set_prop `tests_passed 0)
  (if (receipt_well_formed? receipt)
    ($panic "mutated receipt accepted"))
  ($println
    $"verified-skill record smoke: candidate=${(candidate_digest candidate)} bounds_rejected=true mutation_rejected=true"))
