# Permanently excluded subject-generation smoke for experiment 4.

(mod lifelong_task_subject_smoke)

(import [generate_lifelong_subject verify_lifelong_subject]
        from "../src/lifelong_task_subject.gene")

(var subject (generate_lifelong_subject 900505 900506 30 5 60 2))
(var evidence (verify_lifelong_subject subject))
(if_not evidence/valid
  ($panic $"lifelong task subject invalid: ${evidence}"))

($println
  $"lifelong task subject smoke: families=${evidence/family_count} training=${evidence/training_task_count} probes=${evidence/retention_probe_count} heldout=${evidence/heldout_composition_count}")
($println
  $"catalog_valid=${evidence/catalog_valid} operation_coverage=${evidence/operation_coverage_valid} order_valid=${evidence/order_valid}")
($println
  $"replay_valid=${evidence/replay_valid} replay_cases=${evidence/replay_case_count} training_valid=${evidence/training_valid} probes_valid=${evidence/probes_valid} compositions_valid=${evidence/compositions_valid}")
($println
  $"composition_arity=${subject/composition_arity} composition_attempts=${subject/generation/composition_attempts} final_random_state=${subject/generation/final_random_state}")
