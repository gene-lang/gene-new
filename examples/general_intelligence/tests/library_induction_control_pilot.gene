(import [build_unrelated_library_control corpus_solution_programs
         default_induction_subject generate_corpus induce_library_iterative
         libraries_content_disjoint? library_search_shape
         library_shapes_match? verify_generated_corpus
         verify_iterative_induction]
        from "../src/library_induction.gene")

(fn main [args] : Nil
  (var subject (default_induction_subject))
  (var target_corpus (generate_corpus subject 900101 100 0 0))
  (var corpus_evidence (verify_generated_corpus subject target_corpus))
  (var target_programs (corpus_solution_programs target_corpus))
  (var target_induction
    (induce_library_iterative subject target_programs))
  (var target_evidence
    (verify_iterative_induction
      subject target_programs target_induction))
  (var control
    (build_unrelated_library_control
      subject target_corpus/seed target_induction/library
      [900201 900202 900203]))
  (var shapes_match
    (&& control/accepted
        (library_shapes_match?
          (library_search_shape subject target_induction/library)
          (library_search_shape subject control/library))))
  (var content_disjoint
    (&& control/accepted
        (libraries_content_disjoint?
          target_induction/library control/library)))
  (var valid
    (&& corpus_evidence/valid
        target_evidence/valid
        control/accepted
        shapes_match
        content_disjoint))
  (if_not valid
    ($panic
      $"library-induction control pilot invalid: target_evidence=${target_evidence} control=${control}"))
  ($println
    $"library-induction control pilot: target_seed=${target_corpus/seed} donor_seed=${control/seed} attempts=${control/attempts} items=${control/target_shape/item_count} body_lengths=${control/target_shape/body_lengths} definition_mdl=${control/target_shape/definition_mdl} token_count=${control/target_shape/token_count} candidate_space=${control/target_shape/candidate_space} candidate_ceiling=${control/target_shape/candidate_ceiling} shapes_match=${shapes_match} content_disjoint=${content_disjoint} rejections=${control/rejections}"))
