# Disjoint-seed compute pilot. Deliberately prints no arm outcomes: pilot data
# may tune resource ceilings and implementation efficiency only.

(mod active_inference_pilot)

(import [default_subject] from "../src/exact_belief.gene")
(import [compute_pilot] from "../src/active_inference_experiment.gene")

(fn main [args] : Nil
  (var report (compute_pilot (default_subject)))
  (if_not report/valid
    ($panic $"active-inference compute pilot failed: ${report}"))
  ($println
    $"active-inference compute pilot: episodes=${report/episodes} elapsed_ms=${report/elapsed_ms} final_episode_state=${report/final_episode_state} final_random_state=${report/final_random_state}"))
