(import [default_induction_subject generate_corpus verify_generated_corpus]
        from "../src/library_induction.gene")

(fn main [args] : Nil
  (var subject (default_induction_subject))
  (var first (generate_corpus subject 900001 8 3 4))
  (var repeated (generate_corpus subject 900001 8 3 4))
  (var disjoint (generate_corpus subject 900002 1 1 1))
  (var evidence (verify_generated_corpus subject first))
  (var deterministic (== first repeated))
  (var seed_sensitive
    (!= first/generation/final_random_state
        disjoint/generation/final_random_state))
  (var valid
    (&& evidence/valid
        deterministic
        seed_sensitive
        (== evidence/task_count 15)
        (== evidence/motif_task_count 12)))
  (if_not valid
    ($panic
      $"library-induction corpus invalid: evidence=${evidence} deterministic=${deterministic} seed_sensitive=${seed_sensitive}"))
  ($println
    $"library-induction corpus smoke: tasks=${evidence/task_count} motifs=${(first/motifs ~ size)} motif_tasks=${evidence/motif_task_count} shorter_candidates=${first/structural_screen/candidate_count} shorter_rejected=${evidence/shorter_programs_rejected} unique=${evidence/unique_targets} deterministic=${deterministic} seed_sensitive=${seed_sensitive} attempts=${first/generation/learning_attempts},${first/generation/model_selection_attempts},${first/generation/heldout_attempts}"))
