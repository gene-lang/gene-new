(import [default_induction_subject verify_induction]
        from "../src/library_induction.gene")

(fn main [args] : Nil
  (var evidence (verify_induction (default_induction_subject)))
  (if_not evidence/valid
    ($panic $"library-induction mechanism invalid: ${evidence}"))
  ($println
    $"library-induction mechanism smoke: primitives=${evidence/primitive_count} training_valid=${evidence/training_valid} pattern=${evidence/induction/pattern} support=${evidence/induction/support} occurrences=${evidence/induction/occurrences} mdl=${evidence/induction/baseline_mdl}->${evidence/induction/induced_mdl} iterative_items=${(evidence/iterative_induction/library ~ size)} iterative_stop=${evidence/iterative_induction/stop_reason} unrelated_shape_matches=${evidence/unrelated_shape_matches} unrelated_content_disjoint=${evidence/unrelated_content_disjoint} mismatched_shape_rejected=${evidence/mismatched_shape_rejected} no_gain_rejected=${evidence/no_gain_rejected} bounds_rejected=${evidence/bounds_rejected} candidate_bounds_rejected=${evidence/candidate_bounds_rejected} hidden_verifier_rejected_public_false_positive=${evidence/hidden_verifier_rejects_public_false_positive} base_solved=${evidence/base_search/solved} induced_solved=${evidence/induced_search/solved} induced_candidates=${evidence/induced_search/candidate_executions}"))
