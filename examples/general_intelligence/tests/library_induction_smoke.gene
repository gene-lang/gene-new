(import [default_induction_subject verify_induction]
        from "../src/library_induction.gene")

(fn main [args] : Nil
  (var evidence (verify_induction (default_induction_subject)))
  (if_not evidence/valid
    ($panic $"library-induction mechanism invalid: ${evidence}"))
  ($println
    $"library-induction mechanism smoke: primitives=${evidence/primitive_count} training_valid=${evidence/training_valid} pattern=${evidence/induction/pattern} support=${evidence/induction/support} occurrences=${evidence/induction/occurrences} mdl=${evidence/induction/baseline_mdl}->${evidence/induction/induced_mdl} no_gain_rejected=${evidence/no_gain_rejected} bounds_rejected=${evidence/bounds_rejected} base_solved=${evidence/base_search/solved} induced_solved=${evidence/induced_search/solved} induced_candidates=${evidence/induced_search/candidate_executions}"))
