# What the protocol costs on the VM — design.md §10.1 and §D6.3.
#
#   gene run wire_bench
#
# `tools/world_build.mjs` measures the same codec in V8 and reports 32 µs to
# encode a block. This measures it on the VM, which is where the *server* runs
# it — and the two numbers are not close, for the reason §D6.3 records: a
# message send is ~500 ns on the VM, and `(buf ~ get i)` is a message send.
#
# A block encode reads 4,096 nodes twice (once to count runs, once to write
# them) for both content and light, so it is ~16,000 sends before any
# arithmetic. That is the whole difference, and it is not a defect in the codec
# — it is §D6.3's finding arriving in a new place.

(mod wire_bench)

(import [new_cursor] from "../core/wire.gene")
(import [block_size encode_block] from "../core/protocol.gene")

(fn build_layered [content : (Buffer F32) light : (Buffer F32)] : Nil
  # Layered, like real terrain: runs span rows, which is the case the encoder
  # is written for. A uniform block would be one run and measure nothing.
  (var i 0.0)
  (while (< i 4096.0)
    (var y ($math/floor (/ (- i (* 256.0 ($math/floor (/ i 256.0)))) 16.0)))
    (content ~ set! i (if (< y 8.0) 1.0 0.0))
    (light ~ set! i (if (< y 8.0) 0.0 15.0))
    (set i (+ i 1.0))))

(fn main [args] : Nil
  (var content ($buffer F32 4096.0))
  (var light ($buffer F32 4096.0))
  (build_layered content light)
  (var reps 20.0)

  (var t0 ($os/monotonic_ms))
  (var r 0.0)
  (while (< r reps)
    (block_size content light 0.0 16.0 256.0)
    (set r (+ r 1.0)))
  (var t_size ($to_float (- ($os/monotonic_ms) t0)))

  (var c (new_cursor))
  (var b ($buffer U8 (block_size content light 0.0 16.0 256.0)))
  (set t0 ($os/monotonic_ms))
  (set r 0.0)
  (while (< r reps)
    (encode_block b c -90.0 2.0 198.0 content light 0.0 16.0 256.0)
    (set r (+ r 1.0)))
  (var t_enc ($to_float (- ($os/monotonic_ms) t0)))

  (set t0 ($os/monotonic_ms))
  (set r 0.0)
  (while (< r reps)
    (b ~ to_bytes)
    (set r (+ r 1.0)))
  (var t_bytes ($to_float (- ($os/monotonic_ms) t0)))

  ($println "")
  ($println "design.md §10.1 — one block message, encoded on the VM")
  ($println "")
  ($println $"  block_size   $(/ t_size reps) ms   two counting passes")
  ($println $"  encode_block $(/ t_enc reps) ms   two writing passes")
  ($println $"  to_bytes     $(/ t_bytes reps) ms   the socket boundary")
  ($println $"  total        $(/ (+ t_size (+ t_enc t_bytes)) reps) ms")
  ($println "")
  ($println "  V8 does the same work in 0.032 ms (tools/world_build.mjs).")
  ($println "  §D6.3: a message send is ~500 ns and `(buf ~ get i)` is one;")
  ($println "  a block encode is ~16,000 of them before any arithmetic."))
