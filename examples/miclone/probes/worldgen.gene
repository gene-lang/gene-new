# design.md §D6.3 — the worldgen throughput probe.
#
# §D4's inversion, measured. The client's hot loop runs on V8, which JITs it;
# the server's runs on the interpreter, which does not, and mapgen is the
# server's largest single workload.
#
# **Passes when a chunk generates in under 300 ms on one worker lane** (§D6.3).
#
# It measures each stage at a **reduced sample count and extrapolates**, rather
# than generating a whole chunk and timing it. That is not a shortcut — the
# first version of this probe did generate a whole chunk, and it ran for over
# forty minutes without reaching its first `println`, which is a measurement
# that tells you almost nothing and costs a great deal to take. Per-call costs
# multiplied by known call counts give the same answer in under a second, and
# they give it *per stage*, which is what §D6.3's mitigation ladder needs in
# order to pick a rung.
#
# The call counts are exact, not estimated:
#
#   surface_height   6,400 per chunk   (one per column: 80 x 80)
#   cave?          512,000 per chunk   (one per node, when underground)
#   buffer writes  512,000 per chunk

(mod worldgen ^profile web)

(import [chunk_size chunk_nodes generate_chunk surface_height cave? material]
        from "../core/mapgen.gene")

(let columns_per_chunk 6400.0)

# One chunk's worth of storage. Timed separately from generation because it
# says nothing about noise cost — and because it is the number §D7.2 moves:
# 512,000 `U16` elements are 1 MB packed and 4 MB boxed at 8 bytes each.
(fn allocate_chunk [] : (Buffer U16)
  ($buffer U16 chunk_nodes))

# --- per-stage sampling ------------------------------------------------------
#
# Each of these runs `samples` iterations and returns an accumulator, so the
# caller can time it. The accumulator is returned rather than discarded to stop
# a future optimiser from deleting the loop it is supposed to be measuring.

(fn sample_surface [samples : F64 seed : F64] : F64
  (var acc 0.0)
  (var i 0.0)
  (while (< i samples)
    (set acc (+ acc (surface_height i (* i 1.7) seed)))
    (set i (+ i 1.0)))
  acc)

(fn sample_caves [samples : F64 seed : F64] : F64
  (var hits 0.0)
  (var i 0.0)
  (while (< i samples)
    (if_yes (cave? i (* i 0.5) (* i 1.3) seed)
      (set hits (+ hits 1.0)))
    (set i (+ i 1.0)))
  hits)

(fn sample_material [samples : F64] : F64
  (var acc 0.0)
  (var i 0.0)
  (while (< i samples)
    (set acc (+ acc ($to_float (material i 40.0))))
    (set i (+ i 1.0)))
  acc)

(fn sample_writes [chunk : (Buffer U16) samples : F64] : F64
  (var i 0.0)
  (while (< i samples)
    (chunk ~ set! i 1)
    (set i (+ i 1.0)))
  ($to_float (chunk ~ get 0.0)))

# --- verification ------------------------------------------------------------
#
# A fast generator that emits 512,000 copies of one id is not a passing probe,
# so the timing is reported next to evidence that the pipeline produces terrain.
# Both walk a single column, which is 80 nodes rather than 512,000.

(fn column_profile [seed : F64 wx : F64 wz : F64] : Str
  (var surface (surface_height wx wz seed))
  (var air 0.0)
  (var solid 0.0)
  (var y 0.0)
  (while (< y chunk_size)
    (if (== (material y surface) 0)
      (then (set air (+ air 1.0)))
      (else (set solid (+ solid 1.0))))
    (set y (+ y 1.0)))
  $"surface=${surface} air=${air} solid=${solid}")

(fn cave_fraction [seed : F64 samples : F64] : F64
  (/ (sample_caves samples seed) samples))
