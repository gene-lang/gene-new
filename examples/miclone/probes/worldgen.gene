# design.md §D6.3 — the worldgen throughput probe, re-pointed at M2's unit.
#
# ## What changed, and why this is not the goalposts moving
#
# §D6.3 timed an 80³ mapgen chunk and failed by ~1000x, and its conclusion was
# that the *unit* was wrong: "On the VM, a mapgen chunk cannot exceed roughly
# 300,000 node-visits within a 300 ms budget, and every visit buys about one
# message send." M2 acts on that — `core/mapgen.gene` generates a block, not a
# chunk — so the probe has to measure the thing that is now generated.
#
# Shrinking the unit by 125x and keeping the same 300 ms would weaken the
# requirement by 125x while appearing to pass, so this reports **three**
# readings and says which is which:
#
#   A. §D6.3's criterion as written — 300 ms per generation unit, one lane.
#   B. The node throughput that criterion implied at the old unit: 512,000
#      nodes in 300 ms, or 1,706,667 nodes/s. This is the strict reading and
#      the one the granularity change makes easier; it is reported so the
#      change is visible rather than hidden.
#   C. What a walking player actually needs, derived rather than asserted:
#      one lane staying ahead of the leading face of the loaded region.
#
# C is the reading §D6.3's own sentence appeals to — "which with parallel lanes
# keeps generation ahead of a player moving at normal speed" — and it is the
# only one of the three that is a statement about the game rather than about an
# arbitrary volume.
#
# ## Why it generates rather than extrapolates
#
# §D6.3 sampled each stage and multiplied by exact call counts, because the
# generator it was measuring took forty minutes to produce one chunk. This one
# generates whole blocks and times them, which is both more honest and now
# affordable: a block is tens of milliseconds. The per-stage breakdown is kept,
# because that is what tells a future reader which stage moved.

(mod worldgen ^profile web)

(import [Registry new_registry id_of name_of registered_count]
        from "../core/registry.gene")
(import [Game] from "../core/api.gene")
(import [load_mods] from "../core/mods.gene")
(import [BiomeRegistry biome_at biome_name biome_count] from "../core/biome.gene")
(import [DecorRegistry] from "../core/decor.gene")
(import [OreRegistry] from "../core/ore.gene")
(import [block_dim block_nodes pad_dim pad_nodes sea_level
         surface_height heat_at humidity_at fill_region]
        from "../core/mapgen.gene")
(import [light_region queue_overhead] from "../core/light.gene")

# --- the budgets -------------------------------------------------------------

(let budget_unit_ms 300.0)

# 512,000 nodes in 300 ms, the rate §D6.3's criterion implied at the 80³ unit.
(let budget_nodes_per_s 1706666.6666666667)

# Upstream's default walk speed. A player crossing a 16-node block every
# `block_dim / walk_speed` seconds pulls in one new slab of the loaded region
# each time: `(2R + 1) * H` blocks for a view R blocks across and H tall.
(let walk_speed 4.0)

# §D6.1's spike view — 12 x 4 x 12 chunks — so R is 6 and H is 4.
(let view_radius 6.0)
(let view_height 4.0)

(fn blocks_per_second [] : F64
  (/ (* (+ (* 2.0 view_radius) 1.0) view_height)
     (/ block_dim walk_speed)))

# The slowest a block may generate while one lane stays ahead of that player.
(fn player_budget_ms [] : F64
  (/ 1000.0 (blocks_per_second)))

# --- allocation --------------------------------------------------------------

(fn allocate_block [] : (Buffer F32)
  ($buffer F32 block_nodes))

(fn allocate_padded [] : (Buffer F32)
  ($buffer F32 pad_nodes))

# §4's scratch: `param1`, the per-column sky boundary, and the flood queue.
# `core/light.gene` takes the queue from its caller rather than allocating one,
# so a loader pays for it once instead of per block.
(fn allocate_light [n : F64] : (Buffer F32)
  ($buffer F32 n))

(fn allocate_sky [dim : F64] : (Buffer F32)
  ($buffer F32 (* dim dim)))

(fn allocate_queue [n : F64] : (Buffer F32)
  ($buffer F32 (+ n queue_overhead)))

(fn zero_buffer [b : (Buffer F32) n : F64] : Nil
  (var i 0.0)
  (while (< i n) (b .set i 0.0) (set i (+ i 1.0))))

# Stage 6 alone, over `reps` blocks.
#
# **The content buffer must be freshly generated.** The obvious thing is to time
# this against the same buffer `carve` and `place_all` were just timed against —
# but those loops ran 16 times at 16 different origins, so by the end the block
# is carved to shreds and mostly air, and lighting a mostly-air block reported
# **164 ms** against the 15 ms a real one costs. Lighting only writes `param1`,
# so re-lighting one pristine block `reps` times is both correct and the only
# version that measures the right world.
(fn light_blocks [param1 : (Buffer F32) content : (Buffer F32) reps : F64
                  reg : Registry sky : (Buffer F32) q : (Buffer F32)
                  registered : F64] : F64
  (var i 0.0)
  (while (< i reps)
    (zero_buffer param1 block_nodes)
    (light_region param1 content block_dim block_dim block_dim reg sky q
                  registered)
    (set i (+ i 1.0)))
  (param1 .get 0.0))

# --- the timed workloads -----------------------------------------------------
#
# Each returns something derived from the buffer, so a future optimiser cannot
# delete the work it is supposed to be measuring.

(fn generate_blocks [out : (Buffer F32) sky : (Buffer F32) reps : F64 oy : F64
                     biomes : BiomeRegistry ores : OreRegistry
                     decors : DecorRegistry
                     seed : F64 air : F64 water : F64] : F64
  (var acc 0.0)
  (var i 0.0)
  (while (< i reps)
    (fill_region out sky block_dim (* i block_dim) oy 0.0 biomes ores decors seed air water)
    (set acc (+ acc (out .get 0.0)))
    (set i (+ i 1.0)))
  acc)

(fn generate_padded [out : (Buffer F32) sky : (Buffer F32) reps : F64 oy : F64
                     biomes : BiomeRegistry ores : OreRegistry
                     decors : DecorRegistry
                     seed : F64 air : F64 water : F64] : F64
  (var acc 0.0)
  (var i 0.0)
  (while (< i reps)
    (fill_region out sky pad_dim (- (* i block_dim) 1.0) oy -1.0
                 biomes ores decors seed air water)
    (set acc (+ acc (out .get 0.0)))
    (set i (+ i 1.0)))
  acc)

# --- evidence ----------------------------------------------------------------
#
# A generator that is fast because it emits 4,096 copies of one id is not a
# passing probe, so the timings are reported next to what the pipeline actually
# produced. §D6.3 carried a column profile and a cave fraction for the same
# reason, and its cave fraction of **0.0** is what caught that stage being
# mistuned as well as unaffordable.

(fn column_profile [seed : F64 wx : F64 wz : F64 biomes : BiomeRegistry] : Str
  (var s (surface_height wx wz seed))
  (var h (heat_at wx wz seed))
  (var m (humidity_at wx wz seed))
  (var b (biome_at biomes h m s))
  $"surface=$($to_int s) biome=$(biome_name biomes b)")

# **Measured below every surface in the world**, which is the only place the
# number means anything: taken across the surface band instead, the air above a
# low column swamps the caves and the figure reads ~1.4% at any worm count.
(fn cave_fraction [out : (Buffer F32) sky : (Buffer F32)
                   biomes : BiomeRegistry ores : OreRegistry
                   decors : DecorRegistry
                   seed : F64 air : F64 water : F64 span : F64] : F64
  (var holes 0.0)
  (var nodes 0.0)
  (var bz 0.0)
  (while (< bz span)
    (var bx 0.0)
    (while (< bx span)
      (fill_region out sky block_dim (* bx block_dim) -64.0 (* bz block_dim)
                   biomes ores decors seed air water)
      (var i 0.0)
      (while (< i block_nodes)
        (if_yes (== (out .get i) air) (set holes (+ holes 1.0)))
        (set i (+ i 1.0)))
      (set nodes (+ nodes block_nodes))
      (set bx (+ bx 1.0)))
    (set bz (+ bz 1.0)))
  (/ holes nodes))

(fn biome_share [biomes : BiomeRegistry seed : F64 n : F64 step : F64] : Str
  (var counts ($buffer U32 64.0))
  (var j 0.0)
  (while (< j n)
    (var i 0.0)
    (while (< i n)
      (var wx (* (- i (/ n 2.0)) step))
      (var wz (* (- j (/ n 2.0)) step))
      (var b (biome_at biomes (heat_at wx wz seed)
                              (humidity_at wx wz seed)
                              (surface_height wx wz seed)))
      (counts .set b (+ (counts .get b) 1))
      (set i (+ i 1.0)))
    (set j (+ j 1.0)))
  (var total (* n n))
  (var parts : (List Str) [])
  (var k 0.0)
  (while (< k (biome_count biomes))
    (var pct (/ ($math/round (* 1000.0 (/ ($to_float (counts .get k)) total)))
                10.0))
    (parts .push $"$(biome_name biomes k)=${pct}%")
    (set k (+ k 1.0)))
  ($str/join parts " "))

(fn underwater_share [seed : F64 n : F64 step : F64] : F64
  (var under 0.0)
  (var j 0.0)
  (while (< j n)
    (var i 0.0)
    (while (< i n)
      (if_yes (< (surface_height (* (- i (/ n 2.0)) step)
                                 (* (- j (/ n 2.0)) step) seed) sea_level)
        (set under (+ under 1.0)))
      (set i (+ i 1.0)))
    (set j (+ j 1.0)))
  (/ under (* n n)))

# Every node type present in a generated volume, so an ore that never places
# and a biome node that never appears are both visible.
(fn node_share [out : (Buffer F32) sky : (Buffer F32) r : Registry
                ores : OreRegistry biomes : BiomeRegistry
                decors : DecorRegistry
                seed : F64 air : F64 water : F64 span : F64 y0 : F64] : Str
  (var tally ($buffer U32 64.0))
  (var nodes 0.0)
  (var bz 0.0)
  (while (< bz span)
    (var by 0.0)
    (while (< by span)
      (var bx 0.0)
      (while (< bx span)
        (fill_region out sky block_dim (* bx block_dim) (+ y0 (* by block_dim))
                     (* bz block_dim) biomes ores decors seed air water)
        (var i 0.0)
        (while (< i block_nodes)
          (var id (out .get i))
          (tally .set id (+ (tally .get id) 1))
          (set i (+ i 1.0)))
        (set nodes (+ nodes block_nodes))
        (set bx (+ bx 1.0)))
      (set by (+ by 1.0)))
    (set bz (+ bz 1.0)))
  (var parts : (List Str) [])
  (var k 0.0)
  (while (< k (registered_count r))
    (var c ($to_float (tally .get k)))
    (if_yes (> c 0.0)
      (var pct (/ ($math/round (* 1000.0 (* 100.0 (/ c nodes)))) 1000.0))
      (parts .push $"$(name_of r k)=${pct}%"))
    (set k (+ k 1.0)))
  ($str/join parts " "))
