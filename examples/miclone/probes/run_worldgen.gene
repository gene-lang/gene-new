# The VM shell for design.md §D6.3's worldgen throughput probe.
#
#   gene run worldgen
#
# The VM is the backend under test: this is the server's workload, and §D4 is
# precisely the observation that it cannot move to the faster runtime.

(mod run_worldgen)

(import [new_registry id_of registered_count] from "../core/registry.gene")
(import [setup_nodes setup_biomes setup_ores] from "../core/content.gene")
(import [block_dim block_nodes pad_dim pad_nodes] from "../core/mapgen.gene")
(import [carve] from "../core/cave.gene")
(import [place_all] from "../core/ore.gene")
(import [budget_unit_ms budget_nodes_per_s walk_speed view_radius view_height
         blocks_per_second player_budget_ms
         allocate_block allocate_padded allocate_light allocate_sky
         allocate_queue light_blocks generate_blocks generate_padded
         column_profile cave_fraction biome_share underwater_share node_share]
        from "./worldgen.gene")

(let seed 1337.0)
(let reps 16.0)

(fn ms_since [t0 : Int] : Float
  ($to_float (- ($os/monotonic_ms) t0)))

(fn per_block [ms : Float] : Float
  (/ ms reps))

(fn pct [v : Float] : Float
  (/ ($math/round (* 10000.0 v)) 100.0))

# Lower is better: a time against a deadline.
(fn verdict [label : Str got : Float budget : Float units : Str] : Bool
  (var ok (<= got budget))
  (if ok
    (then ($println $"  PASS  ${label}: ${got} ${units} within ${budget}"))
    (else
      ($println $"  FAIL  ${label}: ${got} ${units} exceeds ${budget} by $(/ got budget)x")))
  ok)

# Higher is better: a rate against a floor.
(fn verdict_rate [label : Str got : Float floor : Float units : Str] : Bool
  (var ok (>= got floor))
  (if ok
    (then ($println $"  PASS  ${label}: ${got} ${units} above ${floor}"))
    (else
      ($println $"  FAIL  ${label}: ${got} ${units} is $(/ floor got)x under ${floor}")))
  ok)

(fn main [args] : Nil
  (var r (new_registry))
  (setup_nodes r)
  (var biomes (setup_biomes r))
  (var ores (setup_ores r))
  (var air (id_of r "air"))
  (var water (id_of r "miclone:water"))

  ($println "")
  ($println $"design.md §D6.3 — worldgen throughput, one $($to_int block_dim)^3 block ($($to_int block_nodes) nodes)")
  ($println "measured on the VM by generating whole blocks, not by extrapolating")
  ($println "")

  (var blk (allocate_block))
  (var pad (allocate_padded))
  # §4's sky boundary, filled by generation as it goes (see core/mapgen.gene).
  (var sky (allocate_sky block_dim))
  (var pad_sky (allocate_sky pad_dim))

  # Warm, so the first block's lazy work is not charged to the measurement.
  (generate_blocks blk sky 1.0 16.0 biomes ores seed air water)

  (var t ($os/monotonic_ms))
  (generate_blocks blk sky reps 16.0 biomes ores seed air water)
  (var block_ms (per_block (ms_since t)))

  (set t ($os/monotonic_ms))
  (generate_padded pad pad_sky reps 16.0 biomes ores seed air water)
  (var pad_ms (per_block (ms_since t)))

  # Stage attribution. `carve` and `place_all` run against an already-filled
  # buffer, which is exactly how the pipeline calls them, so timing them
  # directly and subtracting gives stages 1 and 2 without a second code path.
  (set t ($os/monotonic_ms))
  (var i 0.0)
  (while (< i reps)
    (carve blk block_dim (* i block_dim) 16.0 0.0 seed air water)
    (set i (+ i 1.0)))
  (var cave_ms (per_block (ms_since t)))

  (set t ($os/monotonic_ms))
  (set i 0.0)
  (while (< i reps)
    (place_all blk block_dim (* i block_dim) 16.0 0.0 ores seed)
    (set i (+ i 1.0)))
  (var ore_ms (per_block (ms_since t)))

  # Stage 6, §4's lighting. The buffer is regenerated first: `carve` and
  # `place_all` above ran 16 times at 16 origins over the same block, so what
  # they left is not terrain, and lighting it measured 5x the real cost.
  (generate_blocks blk sky 1.0 16.0 biomes ores seed air water)
  (var param1 (allocate_light block_nodes))
  (var lq (allocate_queue block_nodes))
  (set t ($os/monotonic_ms))
  (light_blocks param1 blk reps r sky lq (registered_count r))
  (var light_ms (per_block (ms_since t)))

  ($println $"  stages 1+2  terrain, biomes, run fill   $(- block_ms (+ cave_ms ore_ms)) ms")
  ($println $"  stage 3     caves, carved               ${cave_ms} ms")
  ($println $"  stage 4     ore, placed                 ${ore_ms} ms")
  ($println $"  stage 6     light, flooded              ${light_ms} ms")
  ($println $"  ------------------------------------------------")
  ($println $"  nodes only, one $($to_int block_dim)^3 block          ${block_ms} ms")
  ($println $"  nodes + light                         $(+ block_ms light_ms) ms")
  ($println $"  one $($to_int pad_dim)^3 padded neighbourhood   ${pad_ms} ms")
  ($println "")

  # --- what the pipeline produced -------------------------------------------
  ($println "  terrain:")
  ($println $"    column at (12,34)   $(column_profile seed 12.0 34.0 biomes)")
  ($println $"    under water         $(pct (underwater_share seed 48.0 47.0)) % of columns")
  # 6x6 blocks rather than 3x3: one worm carves ~1,400 nodes, so at nine blocks
  # a single tunnel moves the figure by four points and the number reported is
  # mostly which worms happened to pass through.
  ($println $"    cave, below y -64   $(pct (cave_fraction blk sky biomes ores seed air water 6.0)) % of deep rock")
  ($println $"    biomes              $(biome_share biomes seed 48.0 47.0)")
  ($println $"    nodes, y 0..47      $(node_share blk sky r ores biomes seed air water 3.0 0.0)")
  ($println "")

  # --- the three readings ---------------------------------------------------
  (var full_ms (+ block_ms light_ms))
  (var nodes_per_s (/ block_nodes (/ full_ms 1000.0)))
  (var player_ms (player_budget_ms))

  ($println "  §D6.3's budget, read three ways:")
  (var a (verdict "A  300 ms per generation unit, as written" full_ms
                  budget_unit_ms "ms"))
  (var b (verdict_rate "B  the node rate the 80^3 unit implied"
                       ($math/round nodes_per_s) ($math/round budget_nodes_per_s)
                       "nodes/s"))
  (var c (verdict $"C  one lane ahead of a $($to_int walk_speed) node/s player at $($to_int (* 2.0 view_radius))x$($to_int view_height) blocks"
                  full_ms player_ms "ms"))
  ($println $"        (the leading face needs $(blocks_per_second) blocks/s)")
  ($println "")

  (if (&& a c)
    (then
      ($println $"PASS — a block generates and lights in ${full_ms} ms, and one lane stays ahead")
      (if_not b
        ($println "  note: reading B fails, and is expected to. Shrinking the unit from")
        ($println "  80^3 to 16^3 divides the volume per generation call by 125, so the")
        ($println "  node rate that a 300 ms chunk implied is no longer the requirement.")
        ($println "  What replaces it is C, which is derived from the game rather than")
        ($println "  from a volume. §D7.11's AOT path is what would close B.")))
    (else
      ($println "FAIL — see the readings above")))
  ($println ""))
