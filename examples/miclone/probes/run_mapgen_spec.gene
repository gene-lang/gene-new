# The VM shell for the mapgen cross-backend spec.
#
#   gene run mapgen_spec
#
# Pair with `node tools/mapgen_spec.mjs` and diff: the two must agree exactly,
# which is what design.md §14 layer 2 asks of every `core/` module and what
# §D3.1's exact half makes non-negotiable for this one.

(mod run_mapgen_spec)

(import [report failures] from "./mapgen_spec.gene")

(fn main [args] : Nil
  ($println (report))
  (var bad (failures))
  ($println "")
  (if (== bad 0.0)
    (then ($println "PASS — every check agrees"))
    (else ($println $"FAIL — ${bad} check(s) failed"))))
