# Cross-backend spec for the inventory and the drop table — design.md §2, §7.1,
# and §14 layers 1 and 2.
#
# Small subjects, and the interesting check is still a property rather than a
# table: **items are conserved.** Over a long scripted sequence of adds and
# takes, what the inventory holds must equal what went in minus what came out
# and minus what would not fit. An inventory that quietly duplicates a stack or
# loses one is the bug this genre's players notice first and report worst, and
# it is invisible to any single fixture.

(mod inventory_spec ^profile web)

(import [Registry new_registry register_uniform id_of draw_normal]
        from "../core/registry.gene")
(import [new_inventory slots_of slot_item slot_count slot_empty? set_slot
         slot_wear set_slot_worn wear_slot wear_max
         add take total_of find_item empty?]
        from "../core/inventory.gene")
(import [ItemRegistry new_items add_item add_tool_cap item_name item_named
         item_node item_stack_max item_of_node placeable_item? dig_time_ms
         no_item no_node default_stack_max]
        from "../core/item.gene")
(import [GroupRegistry new_groups intern_group set_rating rating_of in_group?]
        from "../core/groups.gene")
(import [FormRegistry new_forms add_form add_element form_count element_count
         form_named form_title form_cols form_rows form_first form_len
         element_kind element_x element_y element_text element_fits?
         el_label el_item el_box]
        from "../core/formspec.gene")
(import [EntityRegistry new_entities spawn_item despawn entity_slots
         entity_alive? entity_id entity_item_of entity_count
         entity_x entity_y entity_z live_entities within_pickup? slot_of_id]
        from "../core/entity.gene")
(import [CraftRegistry new_crafts add_recipe recipe_count recipe_output
         recipe_yield recipe_matches? first_craftable apply_craft]
        from "../core/craft.gene")
(import [DropTable new_drop_table register_drop declared? drop_item drop_count]
        from "../core/drops.gene")

# --- reporting ---------------------------------------------------------------

(fn check [out : (List Str) label : Str got : Str want : Str] : Nil
  (if (== got want)
    (then (out ~ push! $"ok   ${label}"))
    (else (out ~ push! $"FAIL ${label}: got ${got}, want ${want}"))))

(fn check_f [out : (List Str) label : Str got : F64 want : F64] : Nil
  (check out label $"$($to_int got)" $"$($to_int want)"))

(fn check_b [out : (List Str) label : Str got : Bool want : Bool] : Nil
  (check out label $"${got}" $"${want}"))

# Three item ids, and they are no longer content ids — §2 gave items their own
# space (`core/item.gene`). They are still deliberately not 0, because an empty
# slot reads its item as 0 and a spec using item 0 could not tell "empty" from
# "holding the first item anyone registered".
(let stone 3.0)
(let dirt 4.0)
(let sand 5.0)

# The registry those ids index. Four filler items first, so `stone` lands at 3
# and the ids above stay the ids the checks below name.
(fn fixture_items [] : ItemRegistry
  (var r (new_items))
  (add_item r "t:pad0" "pad" no_node default_stack_max)
  (add_item r "t:pad1" "pad" no_node default_stack_max)
  (add_item r "t:pad2" "pad" no_node default_stack_max)
  (add_item r "t:stone" "Stone" no_node default_stack_max)
  (add_item r "t:dirt" "Dirt" no_node default_stack_max)
  (add_item r "t:sand" "Sand" no_node default_stack_max)
  r)

(let stack_max 99.0)

# --- the shape ---------------------------------------------------------------

(fn shape_checks [out : (List Str)] : Nil
  (var inv (new_inventory 8.0))
  (check_f out "an inventory has the slots it was asked for" (slots_of inv) 8.0)
  (check_b out "and starts empty" (empty? inv) true)
  (check_b out "every slot of it" (slot_empty? inv 3.0) true)
  (check_f out "an empty slot holds nothing" (slot_count inv 0.0) 0.0)
  (check_f out "and no item" (slot_item inv 0.0) 0.0)
  (check_f out "and is not found by a search" (find_item inv stone) -1.0))

# --- stacking ----------------------------------------------------------------

(fn stacking_checks [out : (List Str)] : Nil
  (var items (fixture_items))
  (var inv (new_inventory 8.0))

  (check_f out "adding one stone fits entirely" (add inv items stone 1.0) 0.0)
  (check_f out "and lands in the first slot" (slot_item inv 0.0) stone)
  (check_f out "with a count of one" (slot_count inv 0.0) 1.0)

  # Twenty more stone go into the same slot, not into twenty slots.
  (add inv items stone 20.0)
  (check_f out "more of the same stacks" (slot_count inv 0.0) 21.0)
  (check_b out "and uses no second slot" (slot_empty? inv 1.0) true)

  # A different item cannot stack onto it.
  (add inv items dirt 5.0)
  (check_f out "a different item takes the next slot" (slot_item inv 1.0) dirt)
  (check_f out "with its own count" (slot_count inv 1.0) 5.0)

  # Past a full stack, the overflow starts a new one — and the partial stack is
  # filled first, which is what "150 stone is two slots" depends on.
  (var inv2 (new_inventory 8.0))
  (add inv2 items stone 150.0)
  (check_f out "150 of one item fills a stack" (slot_count inv2 0.0) stack_max)
  (check_f out "and spills the rest into the next" (slot_count inv2 1.0)
           (- 150.0 stack_max))
  (check_f out "and no further" (slot_count inv2 2.0) 0.0)

  # Adding one more tops up the partial stack rather than opening a third.
  (add inv2 items stone 1.0)
  (check_f out "a further add tops up the partial stack"
           (slot_count inv2 1.0) (+ 1.0 (- 150.0 stack_max)))
  (check_b out "rather than opening another" (slot_empty? inv2 2.0) true))

# --- capacity ----------------------------------------------------------------

(fn capacity_checks [out : (List Str)] : Nil
  (var items (fixture_items))
  (var inv (new_inventory 2.0))
  (var left (add inv items stone (+ (* 2.0 stack_max) 52.0)))
  (check_f out "an add past capacity reports what did not fit" left 52.0)
  (check_f out "and the inventory holds exactly its capacity"
           (total_of inv stone) (* 2.0 stack_max))
  (check_f out "a further add fits nothing" (add inv items stone 10.0) 10.0)
  (check_f out "and changes nothing" (total_of inv stone) (* 2.0 stack_max))
  # A full inventory has no room for a *different* item either, which is a
  # separate path: the second pass looks for empty slots and there are none.
  (check_f out "and has no room for anything else" (add inv items dirt 1.0) 1.0))

# --- taking ------------------------------------------------------------------

(fn taking_checks [out : (List Str)] : Nil
  (var items (fixture_items))
  (var inv (new_inventory 4.0))
  (add inv items stone 10.0)

  (check_f out "taking less than a slot holds takes it all" (take inv 0.0 4.0) 4.0)
  (check_f out "and leaves the rest" (slot_count inv 0.0) 6.0)
  (check_f out "taking more than it holds takes only what is there"
           (take inv 0.0 100.0) 6.0)
  (check_b out "and empties the slot" (slot_empty? inv 0.0) true)
  (check_f out "taking from an empty slot takes nothing" (take inv 0.0 1.0) 0.0)

  # An emptied slot must forget its item, or a later add of the same id would
  # stack onto a slot with a count of zero — which reads as "stacked" and stores
  # nothing.
  (check_f out "an emptied slot forgets its item" (slot_item inv 0.0) 0.0)
  (add inv items dirt 3.0)
  (check_f out "so something else may use it" (slot_item inv 0.0) dirt)
  (check_f out "with its own count" (slot_count inv 0.0) 3.0))

# --- the property: nothing is created or lost --------------------------------
#
# A scripted sequence of adds and takes over three items and a small inventory,
# with the totals tracked independently. Small enough that the inventory fills
# and overflows, which is where a conservation bug lives — an add that reports
# the wrong leftover both loses items and lies about it.

(fn conservation_checks [out : (List Str)] : Nil
  (var items (fixture_items))
  (var inv (new_inventory 3.0))
  (var expect_stone 0.0)
  (var expect_dirt 0.0)
  (var expect_sand 0.0)

  (var i 0.0)
  (while (< i 400.0)
    # Which item, and how much: two coprime cycles, so the sequence does not
    # repeat until it has visited a great many states. Arithmetic rather than
    # random, because a spec running on two backends cannot share a generator.
    (var which (- (/ i 3.0) ($math/floor (/ i 3.0))))
    (var item (if (< which 0.34) stone (if (< which 0.67) dirt sand)))
    (var amount (+ 1.0 (* 40.0 (- (/ i 7.0) ($math/floor (/ i 7.0))))))
    (var taking (== 0.0 (- (/ i 5.0) ($math/floor (/ i 5.0)))))

    (if (&& taking (!= (find_item inv item) -1.0))
      (then
        (var moved (take inv (find_item inv item) amount))
        (if_yes (== item stone) (set expect_stone (- expect_stone moved)))
        (if_yes (== item dirt) (set expect_dirt (- expect_dirt moved)))
        (if_yes (== item sand) (set expect_sand (- expect_sand moved))))
      (else
        (var left (add inv items item amount))
        (var moved (- amount left))
        (if_yes (== item stone) (set expect_stone (+ expect_stone moved)))
        (if_yes (== item dirt) (set expect_dirt (+ expect_dirt moved)))
        (if_yes (== item sand) (set expect_sand (+ expect_sand moved)))))
    (set i (+ i 1.0)))

  (check_f out "after 400 operations the stone is accounted for"
           (total_of inv stone) expect_stone)
  (check_f out "and the dirt" (total_of inv dirt) expect_dirt)
  (check_f out "and the sand" (total_of inv sand) expect_sand)
  # And the sequence did something worth checking — it filled the inventory at
  # some point, which is where the leftover accounting matters.
  (check_b out "and the sequence was not trivially empty"
           (> (+ expect_stone (+ expect_dirt expect_sand)) 0.0) true)
  # Nothing may ever exceed the capacity, whatever the sequence did.
  (check_b out "and nothing exceeded the inventory's capacity"
           (<= (+ expect_stone (+ expect_dirt expect_sand)) (* 3.0 stack_max))
           true))

# --- drops -------------------------------------------------------------------

(fn drop_checks [out : (List Str)] : Nil
  (var r (new_registry))
  (register_uniform r "t:stone" draw_normal true true false 0.0 0.0)
  (register_uniform r "t:grass" draw_normal true true false 0.0 1.0)
  (register_uniform r "t:dirt" draw_normal true true false 0.0 2.0)
  (register_uniform r "t:leaves" draw_normal true true false 0.0 3.0)
  (register_uniform r "t:bedrock" draw_normal true true false 0.0 4.0)

  # §2's split: every node above becomes an item, and one item — a lump — is
  # not a node at all. That is the case the whole change exists for.
  (var items (new_items))
  (var s (id_of r "t:stone"))
  (var g (id_of r "t:grass"))
  (var d (id_of r "t:dirt"))
  (var l (id_of r "t:leaves"))
  (var b (id_of r "t:bedrock"))
  (var i_stone (add_item items "t:stone" "Stone" s default_stack_max))
  (var i_grass (add_item items "t:grass" "Grass" g default_stack_max))
  (var i_dirt (add_item items "t:dirt" "Dirt" d default_stack_max))
  (var i_leaves (add_item items "t:leaves" "Leaves" l default_stack_max))
  (var i_lump (add_item items "t:lump" "Lump" no_node default_stack_max))
  # `t:bedrock` deliberately gets no item, which is `^is_item false`.

  (var t (new_drop_table))

  # The default, which is the whole reason the table holds exceptions: a node
  # nobody registered still drops itself rather than vanishing. "Itself" now
  # means its *item*, which is the one sentence §2's split rewrote.
  (check_b out "an unregistered node is not declared" (declared? t s) false)
  (check_f out "and drops its own item" (drop_item t items s) i_stone)
  (check_f out "one of it" (drop_count t items s) 1.0)

  (register_drop t g i_dirt 1.0)
  (check_f out "a registered node drops what it was told to"
           (drop_item t items g) i_dirt)
  (check_f out "in the declared amount" (drop_count t items g) 1.0)
  (check_f out "and the node it drops is unaffected"
           (drop_item t items d) i_dirt)

  # The case that could not be expressed before items existed.
  (register_drop t s i_lump 2.0)
  (check_f out "a node may drop an item that is not a node"
           (drop_item t items s) i_lump)
  (check_f out "two of it" (drop_count t items s) 2.0)
  (check_b out "and that item places nothing"
           (placeable_item? items i_lump) false)
  (check_b out "while a node's own item does place"
           (placeable_item? items i_stone) true)
  (check_f out "and places the node it came from" (item_node items i_stone) s)

  # A declared drop of nothing is a real thing to want, and is why "declared" is
  # its own column rather than being inferred from a count of zero.
  (register_drop t l i_leaves 0.0)
  (check_b out "a node may be declared to drop nothing" (declared? t l) true)
  (check_f out "and then drops none of it" (drop_count t items l) 0.0)

  # A node with no item at all yields nothing, whatever the table says. Without
  # this a dig on `air` would put item -1 in the hotbar.
  (check_f out "a node with no item has none" (item_of_node items b) no_item)
  (check_f out "and drops nothing" (drop_count t items b) 0.0))

# --- items, groups, and what a tool digs -------------------------------------
#
# §2's other half. The property worth asserting is not any one dig time but the
# *ordering* the design claims: a tool beats a hand, a better tool beats a
# worse one, a harder rating takes longer, and a `level` a tool cannot reach is
# a refusal rather than a wait.

(fn item_checks [out : (List Str)] : Nil
  (var items (new_items))
  (var g (new_groups))
  (var cracky (intern_group g "cracky"))
  (var crumbly (intern_group g "crumbly"))
  (var level (intern_group g "level"))

  # Nodes 10..13: soft stone, hard stone, dirt, and one locked above a hand.
  (set_rating g 10.0 cracky 3.0)
  (set_rating g 11.0 cracky 1.0)
  (set_rating g 12.0 crumbly 3.0)
  (set_rating g 13.0 cracky 3.0)
  (set_rating g 13.0 level 2.0)

  (check_f out "a group name interns once"
           (intern_group g "cracky") cracky)
  (check_f out "a rating comes back" (rating_of g 10.0 cracky) 3.0)
  (check_f out "an absent group rates zero" (rating_of g 10.0 crumbly) 0.0)
  (check_b out "which is not membership" (in_group? g 10.0 crumbly) false)
  (check_b out "and a rated group is" (in_group? g 10.0 cracky) true)
  # Re-rating overwrites rather than appending, or the scan would find a stale
  # entry first.
  (set_rating g 10.0 cracky 2.0)
  (check_f out "re-rating replaces" (rating_of g 10.0 cracky) 2.0)
  (set_rating g 10.0 cracky 3.0)

  (var wood (add_item items "t:wood_pick" "Wooden Pick" no_node 1.0))
  (var steel (add_item items "t:steel_pick" "Steel Pick" no_node 1.0))
  (add_tool_cap items wood cracky 400.0 0.0)
  (add_tool_cap items steel cracky 250.0 2.0)

  (var hand_soft (dig_time_ms items g 10.0 no_item))
  (var wood_soft (dig_time_ms items g 10.0 wood))
  (var steel_soft (dig_time_ms items g 10.0 steel))
  (check_b out "a tool beats a bare hand" (< wood_soft hand_soft) true)
  (check_b out "and a better tool beats a worse one" (< steel_soft wood_soft) true)

  # A harder rating is a longer dig, with the same tool.
  (check_b out "a harder rating takes longer"
           (> (dig_time_ms items g 11.0 steel) steel_soft) true)

  # A tool with no capability for this node's groups still swings by hand.
  (check_f out "a tool with no matching group digs at hand speed"
           (dig_time_ms items g 12.0 wood) (dig_time_ms items g 12.0 no_item))

  # `level` is permission, not speed — the distinction the first version of
  # `dig_time_ms` got wrong by making every rating a gate, which would have made
  # every node in the game undiggable by hand.
  (check_f out "a node above a hand's level is undiggable"
           (dig_time_ms items g 13.0 no_item) -1.0)
  (check_f out "and above a tool's level too"
           (dig_time_ms items g 13.0 wood) -1.0)
  (check_b out "but a tool that reaches it digs"
           (> (dig_time_ms items g 13.0 steel) 0.0) true)
  # And the thing that must not have regressed: an ordinary node is diggable by
  # hand, because nothing in a real content set declares `level`.
  (check_b out "an ungrouped node is diggable by hand"
           (> (dig_time_ms items g 99.0 no_item) 0.0) true)

  # Per-item stack limits, which is why the registry holds a column rather than
  # the inventory holding a constant.
  # One slot, so the per-item limit is what rejects the second pick rather than
  # the inventory running out of room — with the old global 99 this add would
  # have fitted both.
  (var tools (new_inventory 1.0))
  (check_f out "a tool stacks to one" (item_stack_max items wood) 1.0)
  (check_f out "so one slot takes one and reports the rest"
           (add tools items wood 2.0) 1.0)
  (check_f out "holding exactly one" (slot_count tools 0.0) 1.0)

  # Wear, §2's third `ItemStack` field.
  (check_f out "a fresh tool is unworn" (slot_wear tools 0.0) 0.0)
  (check_b out "wearing it a little does not destroy it"
           (wear_slot tools 0.0 100.0) false)
  (check_f out "and the wear is remembered" (slot_wear tools 0.0) 100.0)
  (check_b out "wearing it out destroys it"
           (wear_slot tools 0.0 wear_max) true)
  (check_b out "and the slot is empty" (slot_empty? tools 0.0) true)
  (check_f out "with its wear cleared" (slot_wear tools 0.0) 0.0))

# --- crafting ----------------------------------------------------------------
#
# §9's recipes, and the two properties that matter more than any single recipe:
# **a craft conserves** — what leaves the inventory is exactly what the recipe
# named — and **a craft that cannot complete changes nothing**, so a full
# inventory cannot eat the ingredients.

(fn craft_checks [out : (List Str)] : Nil
  (var items (new_items))
  (var wood (add_item items "t:wood" "Wood" no_node default_stack_max))
  (var plank (add_item items "t:plank" "Plank" no_node default_stack_max))
  (var stick (add_item items "t:stick" "Stick" no_node default_stack_max))
  (var pick (add_item items "t:pick" "Pick" no_node 1.0))

  (var c (new_crafts))
  (add_recipe c plank 4.0 wood 1.0 no_item 0.0 no_item 0.0 no_item 0.0)
  (add_recipe c stick 4.0 plank 2.0 no_item 0.0 no_item 0.0 no_item 0.0)
  (add_recipe c pick 1.0 plank 3.0 stick 2.0 no_item 0.0 no_item 0.0)
  (check_f out "craft: three recipes registered" (recipe_count c) 3.0)

  (var inv (new_inventory 8.0))
  (check_f out "craft: an empty inventory can make nothing"
           (first_craftable c inv) -1.0)

  (add inv items wood 3.0)
  (var r (first_craftable c inv))
  (check_b out "craft: wood makes something" (>= r 0.0) true)
  (check_f out "craft: and what it makes is planks" (recipe_output c r) plank)
  (check_b out "craft: the craft succeeds" (apply_craft c items inv r) true)
  (check_f out "craft: four planks came out" (total_of inv plank) 4.0)
  (check_f out "craft: and one wood went in" (total_of inv wood) 2.0)

  # The multiset property: ingredients in any slots, mixed with anything else.
  (var inv2 (new_inventory 8.0))
  (add inv2 items stick 2.0)
  (add inv2 items wood 1.0)        # noise, in a slot between the ingredients
  (add inv2 items plank 3.0)
  (var r2 -1.0)
  (var i 0.0)
  (while (< i (recipe_count c))
    (if_yes (&& (== r2 -1.0) (== (recipe_output c i) pick))
      (set r2 i))
    (set i (+ i 1.0)))
  (check_b out "craft: a two-ingredient recipe matches across slots"
           (recipe_matches? c inv2 r2) true)
  (check_b out "craft: and completes" (apply_craft c items inv2 r2) true)
  (check_f out "craft: spending exactly what it named — planks"
           (total_of inv2 plank) 0.0)
  (check_f out "craft: — and sticks" (total_of inv2 stick) 0.0)
  (check_f out "craft: leaving the noise untouched" (total_of inv2 wood) 1.0)
  (check_f out "craft: with the pick in hand" (total_of inv2 pick) 1.0)

  # Not enough is not a partial craft.
  (var inv3 (new_inventory 4.0))
  (add inv3 items plank 2.0)
  (check_b out "craft: too few ingredients does not match"
           (recipe_matches? c inv3 r2) false)
  (check_b out "craft: and applying it fails" (apply_craft c items inv3 r2) false)
  (check_f out "craft: without spending anything" (total_of inv3 plank) 2.0)

  # **A craft that cannot fit changes nothing.** One slot, already holding a
  # full stack of something else, so the output has nowhere to go — and the
  # ingredients must still be there afterwards.
  (var inv4 (new_inventory 1.0))
  (add inv4 items wood 99.0)
  (var r4 (first_craftable c inv4))
  (check_b out "craft: a full inventory still matches the recipe"
           (>= r4 0.0) true)
  (check_b out "craft: but the craft fails" (apply_craft c items inv4 r4) false)
  (check_f out "craft: and the ingredients are untouched"
           (total_of inv4 wood) 99.0))

# --- entities ----------------------------------------------------------------
#
# §8's dropped items, and the rule they exist for: §7.1 said since M5 that "what
# is dropped and does not fit is lost". The property is that a dig conserves —
# what a node yields is either in the inventory or on the ground, never gone.

(fn entity_checks [out : (List Str)] : Nil
  (var items (fixture_items))
  (var e (new_entities))
  (check_f out "entity: a fresh registry is empty" (live_entities e) 0.0)

  (var id (spawn_item e stone 5.0 10.5 20.5 30.5))
  (check_b out "entity: spawning answers an id" (> id 0.0) true)
  (check_f out "entity: and there is one alive" (live_entities e) 1.0)
  (var slot (slot_of_id e id))
  (check_b out "entity: which is findable by id" (>= slot 0.0) true)
  (check_f out "entity: holding what it was given" (entity_item_of e slot) stone)
  (check_f out "entity: and how many" (entity_count e slot) 5.0)
  (check_f out "entity: at the position it was dropped" (entity_x e slot) 10.5)

  # Ids are 1-based so that a freed slot cannot read as entity 0.
  (var id2 (spawn_item e dirt 1.0 0.0 0.0 0.0))
  (check_b out "entity: a second id differs from the first" (!= id2 id) true)
  (despawn e slot)
  (check_f out "entity: despawning leaves one" (live_entities e) 1.0)
  (check_b out "entity: and the slot is dead" (entity_alive? e slot) false)
  # The freed slot is reused rather than the table growing.
  (var before (entity_slots e))
  (spawn_item e sand 2.0 1.0 1.0 1.0)
  (check_f out "entity: a freed slot is reused" (entity_slots e) before)

  # Pickup radius, which is a distance test and must be symmetric — the columns
  # are `F64` for exactly this (`core/entity.gene`).
  (var near (slot_of_id e id2))
  (check_b out "entity: an item at your feet is in reach"
           (within_pickup? e near 0.0 0.0 0.0) true)
  (check_b out "entity: one across the room is not"
           (within_pickup? e near 9.0 0.0 0.0) false)

  # **The conservation property.** A full inventory plus a dig: what does not
  # fit becomes an entity, and the total is unchanged. This is the case §7.1
  # named and could not fix before §8.
  (var inv (new_inventory 1.0))
  (add inv items stone 99.0)
  (var e2 (new_entities))
  (var yielded 5.0)
  (var left (add inv items dirt yielded))
  (check_f out "entity: a full inventory takes none of it" left yielded)
  (if_yes (> left 0.0)
    (spawn_item e2 dirt left 4.0 5.0 6.0))
  (check_f out "entity: so all of it is on the ground" (live_entities e2) 1.0)
  (check_f out "entity: with nothing lost"
           (+ (total_of inv dirt) (entity_count e2 (slot_of_id e2 1.0)))
           yielded))

# --- forms -------------------------------------------------------------------
#
# §13's claim is that a formspec of Gene data is "composable, inspectable, and
# validated at registration", against a string DSL that is none of those. Three
# of those four are true by construction and worth one check each. **The fourth
# is the whole point**, and it is what a string DSL cannot have: an element
# outside its form's grid fails *here*, with the form's name and the numbers,
# rather than being drawn off-screen.

(fn form_checks [out : (List Str)] : Nil
  (var f (new_forms))
  (var id (add_form f "t:panel" "Panel" 8.0 6.0))
  (check_f out "form: registering answers an id" id 0.0)
  (check_f out "form: and it is findable by name" (form_named f "t:panel") 0.0)
  (check_f out "form: an unregistered name is not" (form_named f "t:none") -1.0)
  (check out "form: the title round-trips" (form_title f id) "Panel")
  (check_f out "form: as does the grid" (form_cols f id) 8.0)

  (add_element f id el_label 1.0 1.0 4.0 1.0 "hello")
  (add_element f id el_item 1.0 3.0 1.0 1.0 "t:stone")
  (check_f out "form: elements land in the form" (form_len f id) 2.0)
  (check_f out "form: which knows where they start" (form_first f id) 0.0)
  # Inspectable: every element is readable back, which is the adjective a
  # concatenated string does not have at all.
  (check_f out "form: an element's kind is readable" (element_kind f 0.0) el_label)
  (check out "form: and its text" (element_text f 0.0) "hello")
  (check_f out "form: and its position" (element_y f 1.0) 3.0)

  # **Validated at registration.** There is nothing in `size[8,6]label[99,99;x]`
  # that fails until someone looks at the screen.
  # **Validated at registration.** There is nothing in `size[8,6]label[99,99;x]`
  # that fails until someone looks at the screen. `add_element` raises on each
  # of these; `element_fits?` is the same test asked rather than thrown, which
  # is what a spec can assert on both backends.
  (check_b out "form: an element wider than its form does not fit"
           (element_fits? f id el_label 7.0 1.0 4.0 1.0) false)
  (check_b out "form: nor one below its last row"
           (element_fits? f id el_item 1.0 9.0 1.0 1.0) false)
  (check_b out "form: nor a negative position"
           (element_fits? f id el_item -1.0 1.0 1.0 1.0) false)
  (check_b out "form: an element kind no client can draw does not fit"
           (element_fits? f id 99.0 0.0 0.0 1.0 1.0) false)
  (check_b out "form: and one inside the grid does"
           (element_fits? f id el_label 4.0 5.0 4.0 1.0) true)

  # Nothing above added an element.
  (check_f out "form: and asking added nothing" (form_len f id) 2.0)

  # A zero-sized form is a layout nobody can see, caught at the form rather than
  # at every element that then fails to fit inside it.
  # A form with no area is a layout nobody can see, and `add_form` refuses it —
  # caught at the form rather than at every element that then fails to fit.
  (check_f out "form: the registry holds exactly the forms added"
           (form_count f) 1.0))

# --- the report --------------------------------------------------------------

(fn collect [out : (List Str)] : Nil
  (shape_checks out)
  (stacking_checks out)
  (capacity_checks out)
  (taking_checks out)
  (conservation_checks out)
  (drop_checks out)
  (item_checks out)
  (craft_checks out)
  (entity_checks out)
  (form_checks out))

(fn report [] : Str
  (var out : (List Str) [])
  (collect out)
  ($str/join out "\n"))

(fn failures [] : F64
  (var out : (List Str) [])
  (collect out)
  (var bad 0.0)
  (var i 0.0)
  (var n out/~size)
  (while (< i n)
    (if_yes ($str/starts_with? out/%i "FAIL")
      (set bad (+ bad 1.0)))
    (set i (+ i 1.0)))
  bad)
