# `default` — the game, as a mod. design.md §9 and §D8's M7.
#
# Every node, tile, drop, biome and ore miclone has is declared here, through
# `core/api.gene` and nothing else. Until M7 this file was `core/content.gene`
# and its own header said "this is the game, and it should not be here". It is
# no longer there.
#
# **Nothing in this file knows a content id.** Registration returns one and the
# engine assigns it; everything below names content by string, and §2's rule —
# ids are assigned at load, never hardcoded — is a property of the API rather
# than a discipline the author has to keep.
#
# **Names keep the `miclone:` prefix rather than moving to `default:`.** §9's
# sketch writes `default:stone`, and renaming every node would rewrite the four
# golden checksums in `probes/mapgen_spec.gene` and every stored world on disk
# for no gain — the point of M7 is where the definitions live, not what they are
# called. A rename is a mod's to make and §11's `name -> id` mapping is what
# makes it survivable; doing it in the same commit as the move would leave "the
# world changed" and "the game moved" indistinguishable.
#
# The test of the move is exactly that: **the world is byte-identical**. Same
# checksums, same 229 chunks, same 62,395 faces.

# The entry is named for the mod rather than `main.gene`, which is what §9's
# sketch writes. The web profile emits one flat output directory keyed by
# basename, so a second `main.gene` anywhere in the graph collides with the
# client's — and "every mod's entry is named after the mod" is a convention
# worth having regardless of what forced it.
(mod mod_default ^profile web)

# Both operations and their vocabulary come from the supported mod API.
(import [Game
         register_tile register_node register_drop_rule
         register_group register_groups register_item register_tool_cap
         register_biome_def register_ore_def
         register_abm register_decoration register_craft
         register_form form_label form_box form_item
         node_is? set_node set_node_id
         form_button
         register_entity entity_pos_x entity_pos_y entity_pos_z
         move_entity_to remove_entity
         World abm_on_change abm_sampled
         tile_solid tile_ore tile_overlay draw_liquid
         shape_scatter shape_sheet shape_blob]
        from "../../../core/api.gene")
# --- tiles -------------------------------------------------------------------
#
# Registered first, because a node's `^tiles` is resolved when the node is.
# Slots are assigned in this order; nothing outside the engine sees the number.
#
# The colours and noise seeds are the ones the M0 spike arrived at. `^spread` is
# how far a texel may wander from the base colour and `^seed` picks which noise
# field, so two tiles of the same colour do not share a texture.

(fn setup_tiles [game : Game] : Nil
  (register_tile game "miclone:stone" ^kind tile_solid
                 ^red 128.0 ^green 128.0 ^blue 132.0 ^spread 30.0 ^seed 20.0)
  (register_tile game "miclone:dirt" ^kind tile_solid
                 ^red 134.0 ^green 102.0 ^blue 72.0 ^spread 22.0 ^seed 10.0)
  (register_tile game "miclone:grass_top" ^kind tile_solid
                 ^red 96.0 ^green 152.0 ^blue 72.0 ^spread 26.0 ^seed 40.0)
  # Grass seen from the side: dirt with a band of grass over the top few texels,
  # with a ragged boundary so the two do not meet in a straight line.
  (register_tile game "miclone:grass_side" ^kind tile_overlay
                 ^red 96.0 ^green 152.0 ^blue 72.0 ^spread 26.0 ^seed 40.0
                 ^base_red 134.0 ^base_green 102.0 ^base_blue 72.0
                 ^base_spread 22.0 ^base_seed 10.0)
  (register_tile game "miclone:sand" ^kind tile_solid
                 ^red 214.0 ^green 200.0 ^blue 152.0 ^spread 18.0 ^seed 60.0)
  # Water is drawn by the opaque pass (see the node below), so it wants a flat
  # surface colour rather than something to see through.
  (register_tile game "miclone:water" ^kind tile_solid
                 ^red 46.0 ^green 98.0 ^blue 168.0 ^spread 16.0 ^seed 70.0)
  (register_tile game "miclone:gravel" ^kind tile_solid
                 ^red 140.0 ^green 136.0 ^blue 132.0 ^spread 46.0 ^seed 80.0)
  (register_tile game "miclone:snow" ^kind tile_solid
                 ^red 236.0 ^green 240.0 ^blue 248.0 ^spread 12.0 ^seed 90.0)
  (register_tile game "miclone:sandstone" ^kind tile_solid
                 ^red 204.0 ^green 180.0 ^blue 124.0 ^spread 20.0 ^seed 100.0)
  # An ore is the stone tile with speckles of the ore's colour through it.
  # `^density` is the percentage of texels left as stone, so a *higher* number
  # is a rarer-looking vein.
  (register_tile game "miclone:coal_ore" ^kind tile_ore
                 ^red 38.0 ^green 38.0 ^blue 42.0 ^seed 110.0 ^density 62.0
                 ^base_red 128.0 ^base_green 128.0 ^base_blue 132.0
                 ^base_spread 30.0 ^base_seed 20.0)
  (register_tile game "miclone:iron_ore" ^kind tile_ore
                 ^red 192.0 ^green 148.0 ^blue 116.0 ^seed 120.0 ^density 66.0
                 ^base_red 128.0 ^base_green 128.0 ^base_blue 132.0
                 ^base_spread 30.0 ^base_seed 20.0)
  (register_tile game "miclone:gold_ore" ^kind tile_ore
                 ^red 232.0 ^green 196.0 ^blue 78.0 ^seed 130.0 ^density 70.0
                 ^base_red 128.0 ^base_green 128.0 ^base_blue 132.0
                 ^base_spread 30.0 ^base_seed 20.0)
  (register_tile game "miclone:diamond_ore" ^kind tile_ore
                 ^red 128.0 ^green 224.0 ^blue 232.0 ^seed 140.0 ^density 72.0
                 ^base_red 128.0 ^base_green 128.0 ^base_blue 132.0
                 ^base_spread 30.0 ^base_seed 20.0)
  # Bright and near-flat, because a light source that reads as dark stone is
  # confusing in exactly the situation it exists for.
  (register_tile game "miclone:tree_top" ^kind tile_solid
                 ^red 122.0 ^green 92.0 ^blue 56.0 ^spread 16.0 ^seed 160.0)
  (register_tile game "miclone:tree_side" ^kind tile_solid
                 ^red 104.0 ^green 76.0 ^blue 44.0 ^spread 34.0 ^seed 170.0)
  (register_tile game "miclone:leaves" ^kind tile_solid
                 ^red 62.0 ^green 118.0 ^blue 48.0 ^spread 40.0 ^seed 180.0)
  (register_tile game "miclone:lamp" ^kind tile_solid
                 ^red 250.0 ^green 226.0 ^blue 150.0 ^spread 10.0 ^seed 150.0)
  # §13's chest. Planks with a darker band, so a chest reads as made of wood
  # rather than as another kind of tree.
  # §8's players. A player is an entity and an entity is drawn from a node's
  # tile (§8.3), so "what a player looks like" is a tile like anything else —
  # which is the point: the engine gained no notion of an avatar.
  (register_tile game "miclone:player" ^kind tile_solid
                 ^red 216.0 ^green 132.0 ^blue 96.0 ^spread 14.0 ^seed 210.0)
  (register_tile game "miclone:chest_top" ^kind tile_solid
                 ^red 156.0 ^green 118.0 ^blue 70.0 ^spread 20.0 ^seed 190.0)
  (register_tile game "miclone:chest_side" ^kind tile_overlay
                 ^red 104.0 ^green 76.0 ^blue 44.0 ^spread 14.0 ^seed 200.0
                 ^base_red 156.0 ^base_green 118.0 ^base_blue 70.0
                 ^base_spread 20.0 ^base_seed 190.0))

# --- nodes -------------------------------------------------------------------
#
# Registered after §1's three reserved ids, which `new_registry` installs.
#
# Almost every one of these is a solid opaque cube, and says nothing at all
# about that: the API's defaults are what a node is unless it declares
# otherwise, which leaves the two nodes that *are* different — water and the
# lamp — visibly different on the page.
#
# **Water is registered opaque, and that is a compromise rather than a claim
# about water.** `^opaque` means "hides the face behind it", and marking water
# opaque puts the sea surface in the opaque draw pass — visible, and with no
# faces wasted on the sea floor. §5's transparent pass, sorted back to front, is
# what water actually wants. This one line is the whole of the compromise.

(fn setup_nodes [game : Game] : Nil
  (register_node game "miclone:stone" ^tiles ["miclone:stone"])
  (register_node game "miclone:dirt" ^tiles ["miclone:dirt"])
  (register_node game "miclone:grass"
                 ^tiles ["miclone:grass_top" "miclone:grass_side"
                         "miclone:dirt"])
  (register_node game "miclone:sand" ^tiles ["miclone:sand"])
  (register_node game "miclone:water" ^tiles ["miclone:water"]
                 ^drawtype draw_liquid
                 ^solid false
                 ^propagates_light true)
  (register_node game "miclone:gravel" ^tiles ["miclone:gravel"])
  (register_node game "miclone:snow" ^tiles ["miclone:snow"])
  (register_node game "miclone:sandstone" ^tiles ["miclone:sandstone"])
  (register_node game "miclone:coal_ore" ^tiles ["miclone:coal_ore"])
  (register_node game "miclone:iron_ore" ^tiles ["miclone:iron_ore"])
  (register_node game "miclone:gold_ore" ^tiles ["miclone:gold_ore"])
  (register_node game "miclone:diamond_ore" ^tiles ["miclone:diamond_ore"])
  # The first node that emits. Nothing in §3 places one — mapgen has no
  # decoration stage yet — so it changes no terrain and no golden checksum. It
  # is registered because §4's night channel is otherwise dead weight in the
  # real content set: with no emitter anywhere, `light_region` skips the source
  # flood entirely and nothing exercises it outside the spec.
  # §3 stage 5's two nodes. The trunk shows its rings on the cut faces and its
  # bark on the sides, which is the one place in this content set where a
  # three-tile node earns the third tile.
  (register_node game "miclone:tree" ^description "Tree"
                 ^tiles ["miclone:tree_top" "miclone:tree_side"
                         "miclone:tree_top"])
  # Leaves let light through and are the first node in this game that is drawn
  # and does *not* hide what is behind it — which is exactly the case §5's face
  # rule was written for and nothing had exercised.
  #
  # And `^merges_same`, which is what makes a canopy affordable. Not being
  # opaque means every face of every leaf is drawn, and a leaf's neighbours are
  # almost all leaves: M8 shipped 208,608 faces against M7's 62,395 and the
  # trees were nearly all of the difference. A face between two leaves shows
  # nothing, so it is not drawn. §5 has the number.
  (register_node game "miclone:leaves" ^description "Leaves"
                 ^tiles ["miclone:leaves"]
                 ^opaque false
                 ^merges_same true
                 ^propagates_light true)
  (register_node game "miclone:lamp" ^tiles ["miclone:lamp"]
                 ^light_source 14.0))

# --- groups ------------------------------------------------------------------
#
# §2's cross-cutting mechanism, and the first thing in this file that another
# mod could rely on without either of us knowing about the other: a pickaxe
# says it digs `cracky` and gets every stone anyone ever registers.
#
# Upstream's ratings, and the direction reads backwards until you notice it is a
# ranking rather than a hardness: **lower is harder**. `cracky 3` is soft stone,
# `cracky 1` would be obsidian. `core/item.gene` scales dig time by it.
#
# Nothing here declares `level`, which is the group that gates rather than
# scales — so every node in this game stays diggable by a bare hand, exactly as
# it was before groups existed. That is the property the whole change had to
# preserve.

(fn setup_groups [game : Game] : Nil
  (register_group game "miclone:stone" ^group "cracky" ^rating 3.0)
  (register_group game "miclone:sandstone" ^group "cracky" ^rating 3.0)
  (register_group game "miclone:coal_ore" ^group "cracky" ^rating 3.0)
  (register_group game "miclone:iron_ore" ^group "cracky" ^rating 2.0)
  (register_group game "miclone:gold_ore" ^group "cracky" ^rating 2.0)
  (register_group game "miclone:diamond_ore" ^group "cracky" ^rating 1.0)
  (register_group game "miclone:dirt" ^group "crumbly" ^rating 3.0)
  (register_group game "miclone:grass" ^group "crumbly" ^rating 3.0)
  (register_group game "miclone:sand" ^group "crumbly" ^rating 3.0)
  (register_group game "miclone:snow" ^group "crumbly" ^rating 3.0)
  # Gravel and sand are the ones upstream makes fall. §12's tick runs the ABM
  # that acts on this, and the ABM names the group rather than either node.
  (register_groups game "miclone:gravel" {^crumbly 2 ^falling_node 1})
  (register_group game "miclone:sand" ^group "falling_node" ^rating 1.0)
  # What grass will grow on. Dirt alone, deliberately: grass is already grass,
  # and a group holding both would make the ambient ABM match a node it has
  # nothing to do to — cheap, but it would be a pass spent to no purpose every
  # time the walk landed on a lawn.
  (register_group game "miclone:dirt" ^group "soil" ^rating 1.0)
  (register_group game "miclone:lamp" ^group "cracky" ^rating 3.0)
  # Wood is its own group, as upstream: an axe digs `choppy` and gets every
  # mod's tree without either mod knowing the other.
  (register_group game "miclone:tree" ^group "choppy" ^rating 2.0)
  (register_group game "miclone:leaves" ^group "snappy" ^rating 3.0))

# --- items and tools ---------------------------------------------------------
#
# Every node above is already an item, because `register_node` registers one
# (§2: "a node is automatically an item unless it says otherwise"). What is left
# is the items that are *not* nodes — which until now this game could not have.
#
# **The lump is what §9.1 called a placeholder becoming real.** `core/api.gene`
# used to say ores drop themselves because "coal should drop a lump, and a lump
# is an item that is not a node, and §2's item registry is not built". It is
# built, so coal drops a lump.

(fn setup_items [game : Game] : Nil
  # The two items a tree becomes, and the reason §2's split had to exist: a
  # plank and a stick are things you hold and neither is a node.
  (register_item game "miclone:plank" ^description "Wooden Plank")
  (register_item game "miclone:stick" ^description "Stick")
  (register_item game "miclone:coal_lump" ^description "Coal Lump")
  (register_item game "miclone:iron_lump" ^description "Iron Lump")
  # A pickaxe places nothing, which is what `^places` being absent means, and is
  # why right-clicking with one selects no node to put in the world.
  (register_item game "miclone:wood_pickaxe" ^description "Wooden Pickaxe"
                 ^stack_max 1.0)
  (register_item game "miclone:steel_pickaxe" ^description "Steel Pickaxe"
                 ^stack_max 1.0)
  # A wooden pick beats a hand on stone and cannot touch anything a mod locks;
  # steel is faster and reaches level 1. Neither mentions a node.
  (register_tool_cap game "miclone:wood_pickaxe" ^group "cracky" ^time_ms 400.0)
  (register_tool_cap game "miclone:steel_pickaxe" ^group "cracky"
                     ^time_ms 250.0 ^level 1.0)
  (register_tool_cap game "miclone:steel_pickaxe" ^group "crumbly"
                     ^time_ms 300.0 ^level 1.0))

# --- drops -------------------------------------------------------------------
#
# A table of exceptions, not of entries: a node drops itself unless a rule here
# says otherwise. There is one exception in this game and one absence, and both
# are why the table exists at all.
#
# - **grass drops dirt.** The oldest rule in the genre, and the one thing a
#   self-drop gets wrong: a player who digs a meadow and rebuilds it with grass
#   has made a lawn out of nothing.
# - **water drops nothing**, which nothing here has to say, because §7's raycast
#   leaves liquids unpointable and a node that cannot be dug has no drop.
#
# Ores drop themselves, and that is a placeholder rather than a decision: coal
# should drop a lump and stone should drop cobble, both of which are *items*
# that are not nodes, and §2's item registry is still ahead. Registering an ore
# to drop itself is the honest version of "not yet" — the alternative is
# inventing a node nobody can place.

(fn setup_drops [game : Game] : Nil
  (register_drop_rule game "miclone:grass" ^item "miclone:dirt")
  # What §2's split bought: a dug node yielding something that is not that node
  # and is not a node at all.
  (register_drop_rule game "miclone:coal_ore" ^item "miclone:coal_lump")
  (register_drop_rule game "miclone:iron_ore" ^item "miclone:iron_lump"))

# --- biomes ------------------------------------------------------------------
#
# Six points over (heat, humidity), which §3's nearest-point rule turns into six
# regions.
#
# **The points are placed in the range the fields actually produce, and that had
# to be measured.** `fbm2` normalises to [0, 1), but value noise is a mean of
# lattice hashes, so its realised distribution is a bell around the middle
# rather than a uniform spread: heat comes out over 11..80 and humidity over
# 17..85, both centred near 48. The first version of this content set used the
# nominal range and put desert at (94, 6) — outside everything the field ever
# generates, so **desert was unreachable and covered 0% of the world**, silently.
# A biome nobody can visit is not a bug that surfaces on its own.
#
# So the six sit on a circle of radius 13 about (48, 48), spread by angle, which
# splits the dense middle of the distribution between them instead of leaving
# five of them on its edge. Heat runs left to right and humidity bottom to top,
# so the assignment is the obvious one: hot-and-dry is desert, cold-and-wet is
# taiga. The measured shares are in design.md §3.
#
# None of them declares an altitude band. Altitude biomes are a real part of
# upstream's model, and a world whose terrain spans y 9..44 has no altitude to
# band — so the API's default, §1's whole world height, is the honest answer.

(fn setup_biomes [game : Game] : Nil
  (register_biome_def game "miclone:tundra" ^heat 35.0 ^humidity 48.0
                      ^top "miclone:snow" ^depth_top 1.0
                      ^filler "miclone:dirt" ^depth_filler 3.0
                      ^stone "miclone:stone" ^underwater "miclone:gravel")
  (register_biome_def game "miclone:taiga" ^heat 41.5 ^humidity 59.3
                      ^top "miclone:snow" ^depth_top 1.0
                      ^filler "miclone:dirt" ^depth_filler 3.0
                      ^stone "miclone:stone" ^underwater "miclone:gravel")
  (register_biome_def game "miclone:rainforest" ^heat 54.5 ^humidity 59.3
                      ^top "miclone:grass" ^depth_top 1.0
                      ^filler "miclone:dirt" ^depth_filler 4.0
                      ^stone "miclone:stone" ^underwater "miclone:sand")
  (register_biome_def game "miclone:savanna" ^heat 61.0 ^humidity 48.0
                      ^top "miclone:grass" ^depth_top 1.0
                      ^filler "miclone:dirt" ^depth_filler 2.0
                      ^stone "miclone:stone" ^underwater "miclone:sand")
  (register_biome_def game "miclone:desert" ^heat 54.5 ^humidity 36.7
                      ^top "miclone:sand" ^depth_top 2.0
                      ^filler "miclone:sand" ^depth_filler 3.0
                      ^stone "miclone:sandstone" ^underwater "miclone:sand")
  (register_biome_def game "miclone:grassland" ^heat 41.5 ^humidity 36.7
                      ^top "miclone:grass" ^depth_top 1.0
                      ^filler "miclone:dirt" ^depth_filler 4.0
                      ^stone "miclone:stone" ^underwater "miclone:sand"))

# --- ores --------------------------------------------------------------------
#
# Four scatter ores on the usual deeper-is-rarer ladder, one blob, and one
# sheet — so all three of §3's distributions are exercised by content rather
# than only by the spec.
#
# The altitude bands are set against this generator's measured terrain, which
# spans y 9 to 44 with a sea at 20: coal reaches almost to the surface and
# diamond stays in the bottom six nodes, so a player walking a cliff face or a
# cave wall sees the ladder without digging for it.
#
# `^chance` is per 16³ cell, `^size` is the cube side for a scatter, the radius
# for a blob and the thickness for a sheet, and `^amount` is how many nodes a
# scatter cluster places — which a blob and a sheet do not have, and so do not
# state.

# --- decorations -------------------------------------------------------------
#
# §3 stage 5, and the first thing in this world that stands *above* the surface.
# Trees go where grass does, which puts them in the three temperate biomes and
# keeps them out of the desert and the snow without naming a biome at all.

# --- crafting ----------------------------------------------------------------
#
# §9's `register_craft`, and the loop that makes §2.2's tool columns mean
# something: chop a tree, make planks, make sticks, make a pickaxe that digs
# stone faster than a hand does.
#
# Shapeless, so a recipe is what you hold rather than where you put it — see
# `core/craft.gene`. The chain is upstream's and is the one every player of this
# genre already knows, which is the point: nothing here needs explaining.

(fn setup_crafting [game : Game] : Nil
  (register_craft game ^makes "miclone:plank"
                  ^from ["miclone:tree"] ^counts [1.0] ^yield 4.0)
  (register_craft game ^makes "miclone:stick"
                  ^from ["miclone:plank"] ^counts [2.0] ^yield 4.0)
  (register_craft game ^makes "miclone:wood_pickaxe"
                  ^from ["miclone:plank" "miclone:stick"] ^counts [3.0 2.0])
  # Steel is not smelted — there is no furnace, because a furnace is a
  # container and a container is §13's formspec. An iron lump is what the ore
  # drops and what the pickaxe takes, which is the honest shortcut until then.
  (register_craft game ^makes "miclone:steel_pickaxe"
                  ^from ["miclone:iron_lump" "miclone:stick"] ^counts [3.0 2.0])
  # §13's chest, from planks. **A container nobody can obtain is not a
  # feature**, and this is the recipe that makes the whole of §13's input
  # reachable by playing rather than only by a probe: chop a tree, make planks,
  # make a chest, right-click it.
  (register_craft game ^makes "miclone:chest"
                  ^from ["miclone:plank"] ^counts [4.0]))

# --- the crafting panel ------------------------------------------------------
#
# §13's formspec, and the first UI in this game that a mod declares rather than
# the client hardcoding.
#
# **It was read-only, and that made the chest unobtainable.** The note here used
# to read "a recipe list is a layout, not a dialogue" — which was a fine
# sentence and the wrong shape, because `craft_any` matches sticks before the
# chest and spends the planks on them (§13.4). §13.4 fixed that by letting a
# craft *name* its recipe, and the naming reached the protocol and the probe and
# stopped there: at the keyboard there was still no way to choose. So the rows
# are buttons now, and this is a dialogue.
#
# The action is `make_<item name>` and it is the **mod's** string: the server
# resolves it to a recipe by asking which one makes that item, exactly as the
# chest's `take_3` is parsed by the mod rather than read by the engine.
#
# What it still does *not* say is what you can currently make: that is runtime
# state and changes every time the hotbar does, while this is a layout.

(fn setup_forms [game : Game] : Nil
  (register_form game "miclone:crafting" ^title "Crafting" ^cols 12.0 ^rows 6.0)
  (form_box game ^at [0.0 0.0] ^size [12.0 6.0])
  (form_label game ^at [0.0 0.0] ^text "click make to craft" ^width 6.0)
  (form_item game ^at [0.0 1.0] ^shows "miclone:plank")
  (form_label game ^at [5.0 1.0] ^text "1 wood" ^width 3.0)
  (form_button game ^at [9.0 1.0] ^text "make" ^action "make_miclone:plank"
               ^width 2.0)
  (form_item game ^at [0.0 2.0] ^shows "miclone:stick")
  (form_label game ^at [5.0 2.0] ^text "2 planks" ^width 3.0)
  (form_button game ^at [9.0 2.0] ^text "make" ^action "make_miclone:stick"
               ^width 2.0)
  (form_item game ^at [0.0 3.0] ^shows "miclone:wood_pickaxe")
  (form_label game ^at [5.0 3.0] ^text "3 plank 2 stick" ^width 4.0)
  (form_button game ^at [9.0 3.0] ^text "make"
               ^action "make_miclone:wood_pickaxe" ^width 2.0)
  (form_item game ^at [0.0 4.0] ^shows "miclone:steel_pickaxe")
  (form_label game ^at [5.0 4.0] ^text "3 iron 2 stick" ^width 4.0)
  (form_button game ^at [9.0 4.0] ^text "make"
               ^action "make_miclone:steel_pickaxe" ^width 2.0)
  (form_item game ^at [0.0 5.0] ^shows "miclone:chest")
  (form_label game ^at [5.0 5.0] ^text "4 planks" ^width 3.0)
  (form_button game ^at [9.0 5.0] ^text "make" ^action "make_miclone:chest"
               ^width 2.0))

# --- the chest, and §13's input ------------------------------------------------
#
# §13.3 said a form here was read-only and that input "wants the container that
# would justify it". This is the container.
#
# **One form, every chest.** A form is a layout and a chest's contents are
# state, so the layout is registered once here and the *position* travels with
# each open (§10's `msg_open_form`). That is what makes eight buttons enough for
# any number of chests.
#
# Eight slots, and two buttons per slot: `take_N` moves that slot's stack into
# the player's hotbar, `put_N` moves the player's selected stack into that slot.
# The **action names are the mod's** and the engine never reads them — it hands
# them back verbatim — which is what lets this add a control without teaching
# the client a new element kind.
#
# The trailing index is parsed by the mod, in `chest_slot_of`, and that is the
# right side of the line: to the engine `take_3` is an opaque string, and a mod
# that wanted `slot-3-take` or `t3` would need no engine change to have it.

(let chest_slots 8.0)

# §8: "The player is still not an entity, which §8 names as a refactor M8 should
# do deliberately." This is the mod's half of that refactor, and it is one node.
#
# It exists so a player entity has a *tile*, which is all the client needs to
# draw one (§8.3). The engine learned nothing about avatars: a player is an
# entity kind, and its picture is a node's picture.
#
# It stays an item — the default — because §8.3's draw path is item -> node ->
# tile, and `^is_item false` would leave a player entity with nothing to look
# up. Nobody can obtain one: it is not generated, not dropped by anything, and
# not in a recipe. That is a smaller oddity than a second lookup path in the
# renderer for one kind of entity.
(fn setup_player [game : Game] : Nil
  (register_node game "miclone:player" ^description "Player"
                 ^tiles ["miclone:player"]))

(fn setup_chest [game : Game] : Nil
  (register_node game "miclone:chest" ^description "Chest"
                 ^opens_form "miclone:chest"
                 ^tiles ["miclone:chest_top" "miclone:chest_side"
                         "miclone:chest_top"])
  (register_group game "miclone:chest" ^group "choppy" ^rating 2.0)

  (register_form game "miclone:chest" ^title "Chest" ^cols 14.0 ^rows 9.0)
  (form_box game ^at [0.0 0.0] ^size [14.0 9.0])
  (form_label game ^at [1.0 0.0] ^text "click take to pick up, put to store"
              ^width 12.0)
  (var i 0.0)
  (while (< i chest_slots)
    (var row (+ 1.0 i))
    # The item element is what the *contents* fill in at open time; the layout
    # names no item, because which item is in slot 3 is not a property of the
    # form (§13).
    (form_item game ^at [1.0 row] ^shows "")
    (form_button game ^at [6.0 row] ^text "take" ^action $"take_$($to_int i)"
                 ^width 3.0)
    (form_button game ^at [10.0 row] ^text "put" ^action $"put_$($to_int i)"
                 ^width 3.0)
    (set i (+ i 1.0))))

(fn setup_decorations [game : Game] : Nil
  (register_decoration game "miclone:tree"
                       ^on "miclone:grass"
                       ^trunk "miclone:tree"
                       ^leaf "miclone:leaves"
                       ^chance 0.02
                       ^min_height 4.0
                       ^max_height 6.0))

(fn setup_ores [game : Game] : Nil
  (register_ore_def game "miclone:coal_ore"
                    ^node "miclone:coal_ore" ^wherein "miclone:stone"
                    ^shape shape_scatter ^y_min 0.0 ^y_max 44.0
                    ^chance 0.85 ^size 3.0 ^amount 12.0)
  (register_ore_def game "miclone:iron_ore"
                    ^node "miclone:iron_ore" ^wherein "miclone:stone"
                    ^shape shape_scatter ^y_min 0.0 ^y_max 30.0
                    ^chance 0.55 ^size 3.0 ^amount 8.0)
  (register_ore_def game "miclone:gold_ore"
                    ^node "miclone:gold_ore" ^wherein "miclone:stone"
                    ^shape shape_scatter ^y_min 0.0 ^y_max 12.0
                    ^chance 0.25 ^size 2.0 ^amount 5.0)
  (register_ore_def game "miclone:diamond_ore"
                    ^node "miclone:diamond_ore" ^wherein "miclone:stone"
                    ^shape shape_scatter ^y_min 0.0 ^y_max 6.0
                    ^chance 0.12 ^size 2.0 ^amount 4.0)
  (register_ore_def game "miclone:gravel"
                    ^node "miclone:gravel" ^wherein "miclone:stone"
                    ^shape shape_blob ^y_min 0.0 ^y_max 40.0
                    ^chance 0.10 ^size 2.6)
  (register_ore_def game "miclone:sandstone"
                    ^node "miclone:sandstone" ^wherein "miclone:stone"
                    ^shape shape_sheet ^y_min 0.0 ^y_max 28.0
                    ^chance 0.05 ^size 2.0))

# --- behaviour ---------------------------------------------------------------
#
# §12's ABMs, and the first thing this game does without being asked. It is also
# the first mod code that *runs during play* rather than at load — everything
# above this point is registration.
#
# **These are functions, and the engine has never seen their bodies.** That is
# §9's `^action (fn [pos node] …)` and it is the whole of what a mod API is for:
# until this commit `register_abm` took `^kind abm_fall`, which named one of a
# fixed set of engine behaviours, and a mod wanting a third behaviour had to
# change the engine to get one. The gap that was blamed for it did not exist —
# see §D7.17, which now records a measurement instead of a guess.
#
# Neither action names a node id. Both name nodes by string and positions by
# number, which is §2's rule holding at the one place it would be easiest to
# break: an action runs at play time, when the ids are all assigned and sitting
# right there.
#
# Note what neither declaration says: **the group, never the node**. Sand and
# gravel fall because they joined `falling_node` above, and a mod adding its own
# falling node gets the behaviour by joining it too, without touching this file.

(fn setup_behaviour [game : Game] : Nil
  # Targeted (§12's check queue). An edit seeds the position above it, so this
  # runs on a node whose support may have just gone — and because a node that
  # moves seeds its own neighbour, a column cascades one node per tick.
  (register_abm game ^label "falling nodes"
                ^group "falling_node"
                ^trigger abm_on_change
                ^interval_ms 150.0
                ^action (fn [world : World x : F64 y : F64 z : F64
                             node : F64] : Nil
                          (if_yes (node_is? game world x (- y 1.0) z "air")
                            (set_node_id game x (- y 1.0) z node)
                            (set_node game x y z "air"))
                          nil))

  # Ambient (§12's sampling), and the first thing ever to use it — the sampled
  # path existed from M8 and ended in a no-op, so it had never fired.
  #
  # Dirt with sky directly above grows grass. Sampling is right for it for the
  # reason falling could not use sampling: nothing *happens* to open dirt, so
  # there is no edit to seed a check from, and a behaviour nobody triggers is
  # exactly what the ambient walk is for. It is also the visible half of a
  # loop the game already had — dig grass, get dirt, and the hole heals.
  #
  # One pass a second, 900 positions, and the walk is a permutation — so every
  # node in the world is looked at once every 44 minutes and none is skipped.
  # That last clause is new: the walk this replaced could reach 192 positions
  # out of 2,359,296, and this ABM is what proved it, by not firing. Measured
  # after the fix, at five passes a second against 200 open-dirt nodes: 27
  # conversions in 60 s against 22.9 predicted.
  (register_abm game ^label "grass grows on open dirt"
                ^group "soil"
                ^trigger abm_sampled
                ^interval_ms 1000.0
                ^action (fn [world : World x : F64 y : F64 z : F64
                             node : F64] : Nil
                          (if_yes (node_is? game world x (+ y 1.0) z "air")
                            (set_node game x y z "miclone:grass"))
                          nil)))

# --- entities ----------------------------------------------------------------
#
# §8's `on_step`, and the thing to notice is which side of the line it is on.
#
# §8.1 listed "no entity physics — a dropped item stays where it was dropped,
# including in the air if the node under it is later dug" as the engine's first
# named absence. It is filled here, in the mod, in eleven lines, and the engine
# gained no knowledge of gravity to allow it. That is the test §D8 sets for
# whether the API is right — *if M8's game needs an engine change, the API is
# wrong* — and this is the first time the test has been run against a behaviour
# rather than a registration.
#
# `"item"` is the reserved definition the engine spawns dropped items as (§8),
# so registering that name furnishes it rather than adding a second kind.
#
# The fall is a constant rate rather than an acceleration. An item drops about
# one node in a sixth of a second and lands on the first solid node under it;
# integrating a velocity would need a per-entity column the registry does not
# have, for a difference nobody watching a dropped cobble can see.

(let item_fall_per_second 6.0)

(fn setup_entities [game : Game] : Nil
  (register_entity game "item"
    ^on_step (fn [world : World slot : F64 dt : F64] : Nil
               (var x (entity_pos_x game slot))
               (var y (entity_pos_y game slot))
               (var z (entity_pos_z game slot))
               # The node the item's underside would enter. Floored because a
               # continuous position addresses a node only after flooring
               # (`core/loaded.gene` says why it does not floor for you).
               (var next_y (- y (* item_fall_per_second dt)))
               (if_yes (node_is? game world ($math/floor x)
                                 ($math/floor (- next_y 0.5)) ($math/floor z)
                                 "air")
                 (move_entity_to game slot x next_y z))
               nil)))

# --- the mod's entry ----------------------------------------------------------
#
# One function, called once, in the order the registrations depend on: tiles
# before the nodes that name them, nodes before the drops, biomes and ores that
# name *them*. `server/mods.gene` is what calls it.
#
# Ordering being a property of this function rather than of the loader is
# deliberate. §9's mod load order follows `depends`, and that orders *mods*; a
# mod's own registrations are its own business, and a loader that had to
# interleave them would be a loader that understands the game.

(fn register_all [game : Game] : Nil
  (setup_tiles game)
  (setup_nodes game)
  (setup_groups game)
  (setup_items game)
  (setup_drops game)
  (setup_biomes game)
  (setup_ores game)
  (setup_decorations game)
  # Before crafting, because a recipe naming `miclone:chest` needs the item to
  # exist — which is this function's whole reason for being ordered by hand.
  (setup_player game)
  (setup_chest game)
  (setup_crafting game)
  (setup_forms game)
  (setup_entities game)
  (setup_behaviour game))
