# The networked client — design.md §D8's M6, browser half.
#
# `client/main.gene` generates the world in the tab. This one is handed the
# world by `server/main.gene` over a WebSocket, and is otherwise the same game:
# same physics, same mesher, same raycast, same hotbar, because all of them are
# `core/` and neither side has its own copy.
#
# ## Why this is a second file rather than a flag
#
# §10 says singleplayer should run a server in-process over "an in-memory
# channel that presents the same interface as the socket", so that there is one
# code path. That channel does not exist yet: the profile's `ws/*` bindings talk
# to a real socket and nothing else, and inventing an in-memory transport that
# fakes them is the kind of scaffolding that outlives its purpose.
#
# So there are two entry points and they share everything below the transport.
# What is duplicated is `main`'s setup — GL, atlas, camera, input, frame loop —
# about 120 lines. **The fix is the in-memory channel, not a flag**, and when it
# lands this file becomes the only client and `main.gene` becomes the
# in-process server's caller.
#
# ## The extent is checked, not received
#
# The world's size arrives in `hello`, and this client creates its world array
# *before* connecting — because `core/loaded.gene`'s `World` is sized at
# construction and the profile has no way to hold a not-yet-built one (no
# nullable it can narrow, see `dom/element`). So the client declares the extent
# it can render, the server states what it has, and a disagreement is an error
# rather than a resize.
#
# That is a real limitation and it is the client's, not the protocol's: `hello`
# carries the extent precisely so a client that *can* resize should.

(mod net_main ^profile web)

(import [count_faces build_mesh put_cube faces_per_cube item_cube_half]
        from "../core/mesh.gene")
(import [SeenEntities new_seen apply_entity seen_rows seen_alive?
         seen_x seen_y seen_z seen_item seen_item_total seen_live seen_kind]
        from "../core/seen.gene")
(import [entity_player] from "../core/entity.gene")
(import [Registry new_registry id_of registered_count name_of solid?
         tile_top_of opens_form_of]
        from "../core/registry.gene")
(import [World new_world store_block block_base node_at light_at
         world_dx world_dy world_dz world_stride_z world_nodes]
        from "../core/loaded.gene")
(import [relight_node queue_overhead] from "../core/light.gene")
(import [build_program init_state upload_atlas new_vertex_array new_buffer
         upload_chunk begin_frame set_view_projection draw_chunk]
        from "./render.gene")
(import [paint] from "./atlas.gene")
(import [new_sound play_dig play_place play_craft] from "./sound.gene")
(import [TileRegistry new_tiles] from "../core/tiles.gene")
(import [forward_x forward_y forward_z] from "../core/vec.gene")
(import [new_player step player_x player_y player_z player_eye_y
         on_ground? in_liquid? set_player_position box_overlaps_node?]
        from "../core/physics.gene")
(import [new_hit cast hit? hit_x hit_y hit_z before_x before_y before_z]
        from "../core/raycast.gene")
(import [diggable? placeable?] from "../core/edit.gene")
(import [new_inventory slot_item slot_count slot_empty?]
        from "../core/inventory.gene")
(import [ItemRegistry new_items item_name placeable_item? item_node]
        from "../core/item.gene")
(import [new_cursor] from "../core/wire.gene")
(import [message_kind msg_hello msg_registry msg_block msg_node_delta
         msg_inventory msg_tiles msg_items
         new_hello decode_hello hello_version hello_span_x hello_span_y
         hello_span_z hello_bx hello_by hello_bz
         hello_spawn_x hello_spawn_y hello_spawn_z
         decode_registry decode_tiles decode_items
         new_block_header decode_block block_bx block_by block_bz
         new_node_delta decode_node_delta delta_x delta_y delta_z delta_id
         delta_param1
         decode_inventory
         size_request_blocks encode_request_blocks
         size_dig encode_dig size_place encode_place
         size_craft encode_craft craft_any
         size_input encode_input msg_entity
         new_entity_msg decode_entity ent_id ent_x ent_y ent_z ent_item ent_count
         ent_kind
         msg_forms decode_forms
         msg_open_form new_open_form decode_open_form open_x open_y open_z
         size_form_action_for encode_form_action
         protocol_version]
        from "../core/protocol.gene")

# §13's forms. The layout arrives once at join and the contents arrive per open,
# which is the split §13 already made: a form is a declaration and a chest's
# contents are state.
(import [FormRegistry new_forms form_named form_title form_cols form_rows
         form_first form_len element_kind element_x element_y element_w
         element_text element_action kind_label kind_item kind_box kind_button]
        from "../core/formspec.gene")

(let block_dim 16.0)
(let block_nodes 4096.0)

# §13's forms, from the client's side. `form_slots` matches `open_form_slots` in
# `core/protocol.gene` — the container size a single open carries. The element
# pool is fixed because the page has no way to remove a node: the client toggles
# classes on elements it made once, which is also why the grid coordinates are
# CSS classes rather than inline positions.
(let form_slots 8.0)
(let max_form_elements 48.0)
# The panel a key opens rather than a node. It is the one form with no place in
# the world, so it is the one the client opens for itself.
(let crafting_form "miclone:crafting")

# What this client can render. The server states the same numbers in `hello`
# and a disagreement stops the join — see the header.
(let span_x 12.0)
(let span_y 4.0)
(let span_z 12.0)
(let origin_bx -90.0)
(let origin_by 0.0)
(let origin_bz 198.0)

# How many blocks to ask for at once. Under the server's 256-frame outbound
# queue with room to spare — a request cannot outrun its own answers, which is
# what keeps that queue from dropping the oldest frame (§10.1).
(let request_window 64.0)

(let look_speed 0.0022)
(let pitch_limit 1.5533)
(let fog_far 260.0)
(let time_of_day 1.0)
(let max_dt 0.05)
(let reach 5.0)
(let click_slop 4.0)
(let hotbar_slots 8.0)
(let floats_per_vertex 7.0)
(let indices_per_face 6.0)

(fn abs_pixels [v : F64] : F64
  (if (< v 0.0) (- 0.0 v) v))

(fn main [] : Nil
  (var stage ($dom/element "stage"))
  (var gl ($gl/context stage))
  (var prog (build_program gl))
  (init_state gl)

  # The atlas is *not* painted here. §9 makes a mod define what its nodes look
  # like, so the recipes arrive in `msg_tiles` and the canvas is painted and
  # uploaded when they do — which is before any block message, because the
  # server sends tiles in the handshake.
  (var sfx (new_sound))
  (var atlas_canvas ($dom/create_element "canvas"))
  ($canvas/set_size atlas_canvas 128.0 128.0)

  # --- state the network fills ------------------------------------------------
  #
  # The registry starts **bare**, not `new_registry`: §2's three reserved ids
  # are the first three the server sends, and installing them locally would
  # shift every id by three. Nothing here may assume an id means anything until
  # the registry message lands.
  (var reg (new Registry))
  # Bare, like the node registry beside it: §9's slots are positional and the
  # wire carries all of them.
  (var tiles (new_tiles))
  # §2's item vocabulary, bare for the same reason: item ids are positional and
  # the wire carries all of them. Before it lands the hotbar can name nothing.
  (var items (new_items))
  (var world (new_world origin_bx origin_by origin_bz span_x span_y span_z))
  (var wdx (world_dx world))
  (var wdy (world_dy world))
  (var wdz (world_dz world))
  (var wsz (world_stride_z world))

  (var player (new_player 0.0 40.0 0.0))
  (var inv (new_inventory hotbar_slots))

  (var chunks (* span_x (* span_y span_z)))
  (var vaos : (List Gl/VertexArray) [])
  (var vbos : (List Gl/Buffer) [])
  (var ebos : (List Gl/Buffer) [])
  (var counts ($buffer F32 chunks))
  (var faces_total 0.0)
  # One VAO for every entity on screen, not one each: they move every tick, so
  # a buffer per item would be an upload per item per fall. See `ent_dirty`.
  (var ent_vao (new_vertex_array gl))
  (var ent_vbo (new_buffer gl))
  (var ent_ebo (new_buffer gl))

  (var cz 0.0)
  (while (< cz span_z)
    (var cy 0.0)
    (while (< cy span_y)
      (var cx 0.0)
      (while (< cx span_x)
        (vaos ~ push! (new_vertex_array gl))
        (vbos ~ push! (new_buffer gl))
        (ebos ~ push! (new_buffer gl))
        (set cx (+ cx 1.0)))
      (set cy (+ cy 1.0)))
    (set cz (+ cz 1.0)))

  # §4's scratch, for the relight an incoming node delta drives.
  (var sky ($buffer F32 (* wdx wdz)))
  (var lq ($buffer F32 (+ (world_nodes world) queue_overhead)))
  (var lq_seed ($buffer F32 (+ (world_nodes world) queue_overhead)))

  # Decode targets, allocated once: a message arrives on every frame's worth of
  # socket traffic and a per-message allocation is the one thing a receive path
  # must not do.
  (var wc (new_cursor))
  (var hello (new_hello))
  (var header (new_block_header))
  (var delta (new_node_delta))
  (var ent (new_entity_msg))
  # §8's entities, as the client sees them (`core/seen.gene`): id, position,
  # item and count — everything `msg_entity` carries, which is everything it
  # takes to draw one. This replaced a count per item id, which was enough for
  # the HUD to say what was lying about and not enough to put it on screen.
  (var seen (new_seen))
  # §13's forms, as the client sees them. `forms` is the layout registry the
  # server sends at join; `open_form` is which one is on screen and `open_at` is
  # the node it belongs to, because one form serves every chest and the position
  # is the only thing that says *which*. `open_inv` is that container's contents,
  # which arrive with each open rather than living in the layout.
  #
  # An empty `open_form` is "nothing open" — a name, not a coordinate. §13.4's
  # first bug was a position sentinel (`-1` in the x cell) against a world that
  # sits at x = -1437, and the rule it left is the one used here.
  (var forms (new_forms))
  (var open_msg (new_open_form))
  (var open_form "")
  (var open_at ($buffer F64 3.0))
  (var open_inv ($buffer F64 (* form_slots 3.0)))
  (var form_dirty false)
  # Rebuilt when an entity message changes something, not per frame. §5 says
  # nothing here that it does not say about a chunk: geometry that has not
  # changed should not be re-uploaded, and the whole reason a chunk mesh is
  # cached is that uploading is the expensive half.
  (var ent_faces 0.0)
  (var ent_dirty false)
  (var block_c ($buffer F32 block_nodes))
  (var block_l ($buffer F32 block_nodes))

  (var joined false)
  (var blocks_in 0.0)
  (var requested 0.0)
  (var meshed false)
  (var status "connecting…")

  # --- meshing ----------------------------------------------------------------

  (var mesh_chunk : (Fn [F64 F64 F64] Void)
       (fn [a : F64 b : F64 c : F64] : Void void))
  (set mesh_chunk (fn [cx : F64 cy : F64 cz : F64] : Void
    (var slot (+ cx (+ (* cy span_x) (* cz (* span_x span_y)))))
    (var k slot)
    (var bx (+ origin_bx cx))
    (var by (+ origin_by cy))
    (var bz (+ origin_bz cz))
    (var base (block_base world bx by bz))
    (var faces (count_faces reg world/content base wdx wsz))
    (set faces_total (+ (- faces_total (/ (counts ~ get k) indices_per_face))
                        faces))
    (counts ~ set! k (* faces indices_per_face))
    (if_yes (> faces 0.0)
      (var verts ($buffer F32 (* faces (* 4.0 floats_per_vertex))))
      (var idx ($buffer U32 (* faces indices_per_face)))
      (build_mesh reg world/content world/light verts idx base wdx wsz
                  (* bx block_dim) (* by block_dim) (* bz block_dim))
      (upload_chunk gl vaos/%k vbos/%k ebos/%k verts idx))))

  # §8's entities, as geometry. One cube per live item, all in one buffer.
  #
  # The tile is the item's *node's* top tile — §2 keeps items and nodes in
  # separate spaces (§2.2) and `item_node` is the bridge, so a dropped cobble is
  # drawn in the texture of the block it came from. An item with no node behind
  # it (a stick, a pickaxe) has nothing to draw and is skipped rather than given
  # a placeholder: a wrong picture is worse than no picture, and §6's atlas has
  # no icon for a tool.
  #
  # The light is read at the node the item is standing in, so an item in a cave
  # is as dark as the cave. `node_at` needs whole numbers (`core/loaded.gene`
  # says why it does not floor for the caller), and an entity position is
  # continuous by construction — that is what §8 says makes entities a separate
  # system from nodes.
  (var rebuild_entities : (Fn [] Void) (fn [] : Void void))
  (set rebuild_entities (fn [] : Void
    (var rows (seen_rows seen))
    # Count first, for the same reason `count_faces` exists: the buffers are
    # sized exactly rather than kept at a worst case.
    (var n 0.0)
    (var r 0.0)
    (while (< r rows)
      (if_yes (&& (seen_alive? seen r)
                  (>= (item_node items (seen_item seen r)) 0.0))
        (set n (+ n 1.0)))
      (set r (+ r 1.0)))
    (set ent_faces (* n (faces_per_cube)))
    (if_yes (> n 0.0)
      (var verts ($buffer F32 (* ent_faces (* 4.0 floats_per_vertex))))
      (var idx ($buffer U32 (* ent_faces indices_per_face)))
      (var face 0.0)
      (var half (item_cube_half))
      (var j 0.0)
      (while (< j rows)
        (if_yes (seen_alive? seen j)
          (var node (item_node items (seen_item seen j)))
          (if_yes (>= node 0.0)
            (var ex (seen_x seen j))
            (var ey (seen_y seen j))
            (var ez (seen_z seen j))
            (var light (light_at world ($math/floor ex)
                                 ($math/floor ey) ($math/floor ez)))
            # §8's players are the same cube at a different size, and lifted to
            # standing height. A dropped stack is a quarter of a node; a player
            # is most of one, so the two are never confused at a glance.
            (var is_player (== (seen_kind seen j) entity_player))
            (set face (put_cube verts idx face (tile_top_of reg node)
                                light (if is_player 0.4 half)
                                ex (if is_player (+ ey 0.4) ey) ez))))
        (set j (+ j 1.0)))
      (upload_chunk gl ent_vao ent_vbo ent_ebo verts idx))))

  (var mesh_all : (Fn [] Void) (fn [] : Void void))
  (set mesh_all (fn [] : Void
    (var mz 0.0)
    (while (< mz span_z)
      (var my 0.0)
      (while (< my span_y)
        (var mx 0.0)
        (while (< mx span_x)
          (mesh_chunk mx my mz)
          (set mx (+ mx 1.0)))
        (set my (+ my 1.0)))
      (set mz (+ mz 1.0)))))

  # Remesh the chunk holding a node and its six neighbours' chunks, which is
  # what a delta needs: the server already relit, and a node on a chunk edge
  # changes the faces of the chunk beside it.
  (var remesh_around : (Fn [F64 F64 F64] Void)
       (fn [a : F64 b : F64 c : F64] : Void void))
  (set remesh_around (fn [nx : F64 ny : F64 nz : F64] : Void
    (var lo_x ($math/max 0.0 (- ($math/floor (/ (- nx (* origin_bx block_dim))
                                                block_dim)) 1.0)))
    (var hi_x ($math/min (- span_x 1.0)
                         (+ ($math/floor (/ (- nx (* origin_bx block_dim))
                                            block_dim)) 1.0)))
    (var lo_y ($math/max 0.0 (- ($math/floor (/ (- ny (* origin_by block_dim))
                                                block_dim)) 1.0)))
    (var hi_y ($math/min (- span_y 1.0)
                         (+ ($math/floor (/ (- ny (* origin_by block_dim))
                                            block_dim)) 1.0)))
    (var lo_z ($math/max 0.0 (- ($math/floor (/ (- nz (* origin_bz block_dim))
                                                block_dim)) 1.0)))
    (var hi_z ($math/min (- span_z 1.0)
                         (+ ($math/floor (/ (- nz (* origin_bz block_dim))
                                            block_dim)) 1.0)))
    (var rz lo_z)
    (while (<= rz hi_z)
      (var ry lo_y)
      (while (<= ry hi_y)
        (var rx lo_x)
        (while (<= rx hi_x)
          (mesh_chunk rx ry rz)
          (set rx (+ rx 1.0)))
        (set ry (+ ry 1.0)))
      (set rz (+ rz 1.0)))))

  # --- the socket -------------------------------------------------------------

  (var sock ($ws/connect "ws://127.0.0.1:8790/"))

  (var request_more : (Fn [] Void) (fn [] : Void void))
  (set request_more (fn [] : Void
    (var left (- chunks requested))
    (if_yes (> left 0.0)
      (var count ($math/min request_window left))
      (var msg ($buffer U8 (size_request_blocks)))
      (encode_request_blocks msg wc requested count)
      ($ws/send_bytes sock msg)
      (set requested (+ requested count)))))

  ($ws/on_open sock (fn [] : Void
    (set status "joining…")))

  ($ws/on_close sock (fn [] : Void
    (set status "disconnected")))

  ($ws/on_bytes sock (fn [b : (Buffer U8)] : Void
    (var kind (message_kind b))

    (if_yes (== kind msg_hello)
      (decode_hello b wc hello)
      # The version check §14 asks for, before anything else is read.
      (if (!= (hello ~ get hello_version) protocol_version)
        (then (set status $"version mismatch: server v$(hello ~ get hello_version)"))
        (else
          (if (|| (!= (hello ~ get hello_span_x) span_x)
                  (|| (!= (hello ~ get hello_span_y) span_y)
                      (!= (hello ~ get hello_span_z) span_z)))
            (then (set status "world extent mismatch"))
            (else
              (set_player_position player
                                   (hello ~ get hello_spawn_x)
                                   (hello ~ get hello_spawn_y)
                                   (hello ~ get hello_spawn_z))
              (set joined true))))))

    (if_yes (== kind msg_tiles)
      (decode_tiles b wc tiles)
      (paint ($canvas/context atlas_canvas) tiles)
      (upload_atlas gl atlas_canvas))

    (if_yes (== kind msg_items)
      (decode_items b wc items))

    (if_yes (== kind msg_registry)
      (decode_registry b wc reg)
      (set status "receiving world…")
      (request_more))

    (if_yes (== kind msg_block)
      (decode_block b wc header block_c block_l)
      (store_block_and_light world (header ~ get block_bx)
                             (header ~ get block_by) (header ~ get block_bz)
                             block_c block_l)
      (set blocks_in (+ blocks_in 1.0))
      (if_yes (== blocks_in requested) (request_more))
      (if_yes (&& (== blocks_in chunks) (! meshed))
        (mesh_all)
        (set meshed true)
        (set status "")))

    (if_yes (== kind msg_node_delta)
      (decode_node_delta b wc delta)
      # **The sound plays when the server confirms, not when the click
      # happens.** §7.1 keeps drops and edits off the prediction path, and a
      # thud on a dig the server refused would be the audible version of the
      # flickering hotbar that rule exists to prevent.
      (if (== (delta ~ get delta_id) 0.0) (then (play_dig sfx))
        (else (play_place sfx)))
      # The server is authoritative and has already relit around this node; the
      # client's optimistic apply either agreed — in which case this is a
      # no-op — or did not, and this wins (§7.1 step 4).
      (apply_delta world reg delta sky lq lq_seed)
      # **The remesh waits for the world; the apply does not.** A delta can
      # arrive before the blocks have finished landing — §12's ambient ABM
      # changes nodes nobody touched, so it is not tied to anything this client
      # did — and remeshing then builds chunks out of a world that is still
      # half here. The data is applied either way, so `mesh_all` below picks the
      # change up when it runs; what is skipped is a partial mesh that would be
      # thrown away, plus the HUD reporting a chunk count for a world that has
      # not arrived.
      (if_yes meshed
        (remesh_around (delta ~ get delta_x) (delta ~ get delta_y)
                       (delta ~ get delta_z))))

    (if_yes (== kind msg_entity)
      (decode_entity b wc ent)
      # Add, move and remove are one call, because they are one message: a count
      # of 0 *is* the removal (§10). `apply_entity` answers whether anything
      # actually changed, so a re-announcement of a position the client already
      # has does not cost a rebuild.
      (if_yes (apply_entity seen (ent ~ get ent_id)
                            (ent ~ get ent_x) (ent ~ get ent_y)
                            (ent ~ get ent_z) (ent ~ get ent_item)
                            (ent ~ get ent_count) (ent ~ get ent_kind))
        (set ent_dirty true)))

    (if_yes (== kind msg_inventory)
      (decode_inventory b wc inv))

    # §13's layouts, once, at join. The client rebuilds the registry through the
    # registry's own `add_form`/`add_element`, so a form that survives the wire
    # is one that would have registered — a mangled form is refused by the
    # form's rules rather than drawn as something strange.
    (if_yes (== kind msg_forms)
      (decode_forms b wc forms))

    # And the contents, per open. The server decides when a form opens; this is
    # the client being told, which is why a chest cannot be opened by a client
    # that merely wants one to be.
    (if_yes (== kind msg_open_form)
      (set open_form (decode_open_form b wc open_msg open_inv))
      (open_at ~ set! 0.0 (open_msg ~ get open_x))
      (open_at ~ set! 1.0 (open_msg ~ get open_y))
      (open_at ~ set! 2.0 (open_msg ~ get open_z))
      (set form_dirty true))))

  # --- §13's forms, drawn ------------------------------------------------------
  #
  # The page cannot remove a node, so the pool is made once and every open
  # toggles classes on it: `off` hides, `cN`/`rN` place. That is why the previous
  # cell is remembered per pool slot — a toggle needs to know what to turn off.
  #
  # **The client draws what it was sent and nothing it knows.** A label's text, a
  # button's caption and a button's action are all the mod's strings; this file
  # contains no name of any form, control or recipe. The one exception is the key
  # that opens the crafting panel, and it is an exception because that panel is
  # the only form with no node to right-click.

  (var form_root ($dom/element "form"))
  (var form_title_el ($dom/element "form-title"))
  (var form_els : (List Any) [])
  (var pool_elem ($buffer F64 max_form_elements))
  (var pool_col ($buffer F64 max_form_elements))
  (var pool_row ($buffer F64 max_form_elements))
  (var fi 0.0)
  (while (< fi max_form_elements)
    (pool_elem ~ set! fi -1.0)
    (pool_col ~ set! fi -1.0)
    (pool_row ~ set! fi -1.0)
    (var el ($dom/create_element "div"))
    ($dom/set_class el "fe" true)
    ($dom/set_class el "off" true)
    ($dom/append form_root el)
    (form_els ~ push! el)
    (set fi (+ fi 1.0)))

  # The panel's own size, remembered for the same reason a cell is: a class that
  # is on has to be named to be turned off.
  (var form_w -1.0)
  (var form_h -1.0)

  (var draw_form : (Fn [] Void) (fn [] : Void
    (var id (if (== open_form "") -1.0 (form_named forms open_form)))
    ($dom/set_class form_root "open" (>= id 0.0))
    (var used 0.0)
    (if_yes (>= id 0.0)
      ($dom/set_text form_title_el (form_title forms id))
      (if_yes (>= form_w 0.0)
        ($dom/set_class form_root $"w$($to_int form_w)" false))
      (if_yes (>= form_h 0.0)
        ($dom/set_class form_root $"h$($to_int form_h)" false))
      (set form_w (form_cols forms id))
      (set form_h (form_rows forms id))
      ($dom/set_class form_root $"w$($to_int form_w)" true)
      ($dom/set_class form_root $"h$($to_int form_h)" true)
      (var e (form_first forms id))
      (var last (+ e (form_len forms id)))
      (var slot 0.0)
      (while (< e last)
        # A box is the panel's own background, which the page already draws.
        (if_yes (&& (!= (element_kind forms e) (kind_box))
                    (< used max_form_elements))
          (var el form_els/%used)
          (var kind (element_kind forms e))
          (var is_item (== kind (kind_item)))
          (var is_button (== kind (kind_button)))
          # An item element with a name shows that name — the crafting panel
          # naming what a recipe makes. An item element with none is a container
          # slot, and its contents came with the open (§13's split).
          (var text (element_text forms e))
          (if_yes is_item
            (if_yes (== text "")
              (var held (open_inv ~ get (* slot 3.0)))
              (var n (open_inv ~ get (+ (* slot 3.0) 1.0)))
              (set text (if (> n 0.0)
                          $"$(item_name items held) x$($to_int n)"
                          "—"))
              (set slot (+ slot 1.0))))
          ($dom/set_text el text)
          ($dom/set_class el "btn" is_button)
          ($dom/set_class el "slot" is_item)
          ($dom/set_class el "off" false)
          # Move it: turn the old cell off before the new one on.
          (var was_c (pool_col ~ get used))
          (var was_r (pool_row ~ get used))
          (if_yes (>= was_c 0.0)
            ($dom/set_class el $"c$($to_int was_c)" false))
          (if_yes (>= was_r 0.0)
            ($dom/set_class el $"r$($to_int was_r)" false))
          (var col (element_x forms e))
          (var row (element_y forms e))
          ($dom/set_class el $"c$($to_int col)" true)
          ($dom/set_class el $"r$($to_int row)" true)
          (pool_col ~ set! used col)
          (pool_row ~ set! used row)
          (pool_elem ~ set! used e)
          (set used (+ used 1.0)))
        (set e (+ e 1.0))))
    # Everything the open form did not need goes away, and stops being clickable
    # with it — a control left behind is a control that still answers.
    (var k used)
    (while (< k max_form_elements)
      ($dom/set_class form_els/%k "off" true)
      (pool_elem ~ set! k -1.0)
      (set k (+ k 1.0)))))

  # A press. There is no `target` on an event in this profile, so the pool is
  # hit-tested by rectangle — which is also the only reading that agrees with
  # what the player actually sees.
  ($dom/add_event_listener form_root "click" (fn [ev : Any] : Void
    (var cx ($event/client_x ev))
    (var cy ($event/client_y ev))
    (var id (if (== open_form "") -1.0 (form_named forms open_form)))
    (if_yes (>= id 0.0)
      (var k 0.0)
      (while (< k max_form_elements)
        (var e (pool_elem ~ get k))
        (if_yes (&& (>= e 0.0) (== (element_kind forms e) (kind_button)))
          (var el form_els/%k)
          (var l ($dom/rect_left el))
          (var t ($dom/rect_top el))
          (var w ($dom/rect_width el))
          (var h ($dom/rect_height el))
          (if_yes (&& (&& (>= cx l) (< cx (+ l w)))
                      (&& (>= cy t) (< cy (+ t h))))
            # §7.1 reaching UI: the client reports which control was pressed and
            # the server decides what it meant. The action is the mod's string,
            # handed back verbatim.
            (var action (element_action forms e))
            (var msg ($buffer U8 (size_form_action_for open_form action)))
            (encode_form_action msg wc
                                (open_at ~ get 0.0) (open_at ~ get 1.0)
                                (open_at ~ get 2.0) 0.0 open_form action)
            ($ws/send_bytes sock msg)
            (set k max_form_elements)))
        (set k (+ k 1.0))))))

  # --- camera and input -------------------------------------------------------

  (var yaw 0.6)
  (var pitch -0.25)
  (var fwd 0.0)
  (var strafe 0.0)
  (var jump false)
  (var sneak false)
  (var flying false)
  (var dragging false)
  (var drag_from_x 0.0)
  (var drag_from_y 0.0)
  (var selected 0.0)
  (var hit (new_hit))

  (var send_dig : (Fn [] Void) (fn [] : Void void))
  (set send_dig (fn [] : Void
    (cast world reg hit (player_x player) (player_eye_y player)
          (player_z player)
          (forward_x yaw pitch) (forward_y yaw pitch) (forward_z yaw pitch)
          reach)
    (if_yes (hit? hit)
      # §7.1 step 1: the client rejects what it can answer alone, so most
      # misses never reach the network.
      (if_yes (diggable? world reg (hit_x hit) (hit_y hit) (hit_z hit))
        (var msg ($buffer U8 (size_dig)))
        (encode_dig msg wc (hit_x hit) (hit_y hit) (hit_z hit))
        ($ws/send_bytes sock msg)))))

  (var send_place : (Fn [] Void) (fn [] : Void void))
  (set send_place (fn [] : Void
    (cast world reg hit (player_x player) (player_eye_y player)
          (player_z player)
          (forward_x yaw pitch) (forward_y yaw pitch) (forward_z yaw pitch)
          reach)
    (if_yes (hit? hit)
      (var nx (before_x hit))
      (var ny (before_y hit))
      (var nz (before_z hit))
      # The node the ray actually hit, which is not where a block would go.
      # §13's chest is *pointed at* and the position above is the empty node
      # beside it, so a right-click carries both and the server decides which
      # one it meant (§10's `place_size`).
      (var ax (hit_x hit))
      (var ay (hit_y hit))
      (var az (hit_z hit))
      (var opens (!= (opens_form_of reg (node_at world ax ay az)) ""))
      # §7.1 step 1 gained a case with §2's items: a pickaxe passes every
      # position test and still places nothing, so the client answers that
      # alone rather than sending a place the server would refuse.
      #
      # **A node that opens a form is sent regardless of what is held.** Opening
      # a chest with empty hands is the ordinary way to open a chest, and every
      # test below is about placing a block.
      (var held_item (slot_item inv selected))
      (if_yes (|| opens
                  (&& (! (slot_empty? inv selected))
                      (&& (placeable_item? items held_item)
                          (&& (placeable? world reg nx ny nz)
                              (! (box_overlaps_node? player nx ny nz))))))
        (var msg ($buffer U8 (size_place)))
        (encode_place msg wc nx ny nz held_item ax ay az)
        ($ws/send_bytes sock msg)))))

  ($dom/add_event_listener ($dom/window) "keydown" (fn [ev : Any] : Void
    (var k ($event/key ev))
    (if_yes (== k "w") (set fwd 1.0))
    (if_yes (== k "s") (set fwd -1.0))
    (if_yes (== k "a") (set strafe -1.0))
    (if_yes (== k "d") (set strafe 1.0))
    (if_yes (== k " ") (set jump true))
    (if_yes (== k "Shift") (set sneak true))
    (if_yes (== k "f") (set flying (! flying)))
    (var picked -1.0)
    (if_yes (== k "1") (set picked 0.0))
    (if_yes (== k "2") (set picked 1.0))
    (if_yes (== k "3") (set picked 2.0))
    (if_yes (== k "4") (set picked 3.0))
    (if_yes (== k "5") (set picked 4.0))
    (if_yes (== k "6") (set picked 5.0))
    (if_yes (== k "7") (set picked 6.0))
    (if_yes (== k "8") (set picked 7.0))
    (if_yes (>= picked 0.0) (set selected picked))
    # §9's crafting, and §7.1's shape: the client asks and says nothing about
    # what — the server holds the only inventory that counts.
    #
    # This still means "make whatever I can", and §13.4 recorded what that costs:
    # sticks match before the chest and spend the planks, so `c` alone can never
    # reach a chest. `e` opens the panel where a recipe can be *chosen*, which is
    # the half of §13.4's fix that reached the protocol and not the player.
    (if_yes (== k "c")
      (var msg ($buffer U8 (size_craft)))
      (encode_craft msg wc (craft_any))
      ($ws/send_bytes sock msg))
    # The crafting panel is the one form with no node, so it is the one the
    # client opens for itself. A chest is opened by the server, because a chest
    # is somewhere and the server is what says you are standing there.
    (if_yes (== k "e")
      (set open_form (if (== open_form crafting_form) "" crafting_form))
      (open_at ~ set! 0.0 0.0)
      (open_at ~ set! 1.0 0.0)
      (open_at ~ set! 2.0 0.0)
      (set form_dirty true))
    (if_yes (== k "Escape")
      (set open_form "")
      (set form_dirty true))))

  ($dom/add_event_listener ($dom/window) "keyup" (fn [ev : Any] : Void
    (var k ($event/key ev))
    (if_yes (|| (== k "w") (== k "s")) (set fwd 0.0))
    (if_yes (|| (== k "a") (== k "d")) (set strafe 0.0))
    (if_yes (== k " ") (set jump false))
    (if_yes (== k "Shift") (set sneak false))))

  ($dom/add_event_listener stage "mousedown" (fn [ev : Any] : Void
    (set dragging true)
    (set drag_from_x ($event/client_x ev))
    (set drag_from_y ($event/client_y ev))))
  ($dom/add_event_listener ($dom/window) "mouseup" (fn [ev : Any] : Void
    (if_yes dragging
      (var moved (+ (abs_pixels (- ($event/client_x ev) drag_from_x))
                    (abs_pixels (- ($event/client_y ev) drag_from_y))))
      (if_yes (&& (< moved click_slop) meshed)
        (if (== ($event/button ev) 2.0) (then (send_place)) (else (send_dig)))))
    (set dragging false)))
  ($dom/add_event_listener stage "contextmenu" (fn [ev : Any] : Void
    ($dom/prevent_default ev)))
  ($dom/add_event_listener ($dom/window) "mousemove" (fn [ev : Any] : Void
    (if_yes dragging
      (set yaw (+ yaw (* ($event/movement_x ev) look_speed)))
      (set pitch ($math/clamp (- pitch (* ($event/movement_y ev) look_speed))
                              (- 0.0 pitch_limit) pitch_limit)))))
  ($dom/add_event_listener stage "wheel" (fn [ev : Any] : Void
    ($dom/prevent_default ev)
    (var next (+ selected (if (> ($event/delta_y ev) 0.0) 1.0 -1.0)))
    (set selected (if (< next 0.0) (- hotbar_slots 1.0)
                    (if (>= next hotbar_slots) 0.0 next)))))

  # --- frame ------------------------------------------------------------------

  (var proj ($buffer F32 16.0))
  (var view ($buffer F32 16.0))
  (var vp ($buffer F32 16.0))
  (var last_ms 0.0)
  (var frames 0.0)
  (var fps_since 0.0)
  (var input_sent 0.0)

  (var frame : (Fn [F64] Void) (fn [now : F64] : Void void))
  (set frame (fn [now : F64] : Void
    (var dt (if (> last_ms 0.0) ($math/min max_dt (/ (- now last_ms) 1000.0)) 0.0))
    (set last_ms now)

    (var dx (forward_x yaw pitch))
    (var dy (forward_y yaw pitch))
    (var dz (forward_z yaw pitch))
    (var fx (forward_x yaw 0.0))
    (var fz (forward_z yaw 0.0))
    (var rx (forward_x (+ yaw 1.5708) 0.0))
    (var rz (forward_z (+ yaw 1.5708) 0.0))
    (var wish_x (+ (* fx fwd) (* rx strafe)))
    (var wish_z (+ (* fz fwd) (* rz strafe)))
    (var wish_len ($math/sqrt (+ (* wish_x wish_x) (* wish_z wish_z))))
    (if_yes (> wish_len 0.0)
      (set wish_x (/ wish_x wish_len))
      (set wish_z (/ wish_z wish_len)))

    # **Physics runs only once the world is here.** Stepping against an empty
    # array would drop the player through a world of air to the shell and leave
    # them standing under the terrain when it arrives.
    (if_yes (&& meshed (> dt 0.0))
      (step player world reg wish_x wish_z jump sneak flying dt))

    (var eye_x (player_x player))
    (var eye_y (player_eye_y player))
    (var eye_z (player_z player))

    (var w ($canvas/width stage))
    (var h ($canvas/height stage))
    (begin_frame gl prog w h)
    (set_view_projection gl prog proj view vp w h
                         eye_x eye_y eye_z dx dy dz fog_far time_of_day)

    (var drawn 0.0)
    (var i 0.0)
    (while (< i chunks)
      (var n (counts ~ get i))
      (if_yes (> n 0.0)
        (var k i)
        (draw_chunk gl vaos/%k n)
        (set drawn (+ drawn 1.0)))
      (set i (+ i 1.0)))

    # §8's entities, after the world. Same shader, same vertex format, same
    # draw call — a scaled cube is exactly what the chunk pass already draws,
    # which is why this needed no §6 work at all (§8.2).
    (if_yes ent_dirty
      (rebuild_entities)
      (set ent_dirty false))
    # §13's panel, on the same rule as the entity mesh: rebuilt when something
    # said it changed, not once a frame. A form is DOM rather than geometry, so
    # redrawing it every frame would be 166 layouts a second for a panel that
    # changes when a chest does.
    (if_yes form_dirty
      (draw_form)
      (set form_dirty false))
    (if_yes (> ent_faces 0.0)
      (draw_chunk gl ent_vao (* ent_faces indices_per_face)))

    (set frames (+ frames 1.0))
    (if_yes (> (- now fps_since) 1000.0)
      (var mode
        (if (! meshed) $"${status} $($math/round blocks_in)/$($math/round chunks) blocks"
          (if flying "flying"
            (if (in_liquid? player) "swimming"
              (if (on_ground? player) "walking" "falling")))))
      ($dom/set_text ($dom/element "hud")
        # "entities", not "items": since §8.4 a player is an entity in the same
        # table as a dropped stack, so this counts both and the old label was a
        # lie whenever anyone else was online.
        $"$($math/round frames) fps · $($math/round drawn) chunks · $($math/round faces_total) faces · $($math/round (seen_live seen)) entities · ${mode} at $($math/round (player_x player)), $($math/round (player_y player)), $($math/round (player_z player))")
      ($dom/set_text ($dom/element "hotbar") (hotbar_text items inv selected))
      (set frames 0.0)
      (set fps_since now))
    # §10's input, once a second rather than per frame: it carries the position
    # §8's pickup needs, and a player cannot walk out of a 1.6-node pickup
    # radius in less than that at 4 nodes a second. Per frame would be 166
    # messages a second to say the same thing.
    (if_yes (&& joined (> (- now input_sent) 1000.0))
      (set input_sent now)
      (var msg ($buffer U8 (size_input)))
      (encode_input msg wc wish_x wish_z jump sneak flying yaw
                    (player_x player) (player_y player) (player_z player))
      ($ws/send_bytes sock msg))
    ($frame/request frame)))

  ($canvas/set_size stage ($dom/inner_width) ($dom/inner_height))
  ($frame/request frame))

# A decoded block carries its own 16³ content and light; `store_block` takes
# content only, so the light goes in beside it the same way.
(fn store_block_and_light [w : World bx : F64 by : F64 bz : F64
                           content : (Buffer F32) light : (Buffer F32)] : Nil
  (store_block w bx by bz content)
  (var base (block_base w bx by bz))
  (var dx (world_dx w))
  (var sz (world_stride_z w))
  (var z 0.0)
  (while (< z block_dim)
    (var y 0.0)
    (while (< y block_dim)
      (var dst (+ base (+ (* y dx) (* z sz))))
      (var from (+ (* y block_dim) (* z (* block_dim block_dim))))
      (var x 0.0)
      (while (< x block_dim)
        (w/light ~ set! (+ dst x) (light ~ get (+ from x)))
        (set x (+ x 1.0)))
      (set y (+ y 1.0)))
    (set z (+ z 1.0))))

# The server's delta wins. Its own light byte comes with it, and the *area*
# around it is relit locally with the same `relight_node` the server ran — §4
# forbids deriving a received block's light from scratch, and this is not that:
# it is the incremental update whose inputs the server just supplied.
(fn apply_delta [w : World reg : Registry d : (Buffer F64)
                 sky : (Buffer F32) q : (Buffer F32)
                 q_seed : (Buffer F32)] : Nil
  (var nx (d ~ get delta_x))
  (var ny (d ~ get delta_y))
  (var nz (d ~ get delta_z))
  (set_node_at w nx ny nz (d ~ get delta_id))
  (relight_node w/light w/content (world_dx w) (world_dy w) (world_dz w) reg
                (array_x_of nx) (array_y_of ny) (array_z_of nz)
                sky q q_seed))

# World node coordinate to array coordinate. `core/loaded.gene` exports these
# as `array_x`/`array_y`/`array_z` taking the world; these take the module's
# origin constants instead, because this client's extent is a constant rather
# than something it reads back off the world it built.
(fn array_x_of [nx : F64] : F64 (+ (- nx (* origin_bx block_dim)) 1.0))
(fn array_y_of [ny : F64] : F64 (+ (- ny (* origin_by block_dim)) 1.0))
(fn array_z_of [nz : F64] : F64 (+ (- nz (* origin_bz block_dim)) 1.0))

(fn set_node_at [w : World nx : F64 ny : F64 nz : F64 id : F64] : Nil
  (w/content ~ set!
    (+ (array_x_of nx)
       (+ (* (array_y_of ny) (world_dx w))
          (* (array_z_of nz) (world_stride_z w))))
    id))

(fn hotbar_text [items : ItemRegistry inv : (Buffer F64) selected : F64] : Str
  (var parts : (List Str) [])
  (var i 0.0)
  (while (< i hotbar_slots)
    (var label
      (if (slot_empty? inv i) "—"
        $"$(item_name items (slot_item inv i)) x$($to_int (slot_count inv i))"))
    (parts ~ push! (if (== i selected) $"[${label}]" $" ${label} "))
    (set i (+ i 1.0)))
  ($str/join parts " "))
