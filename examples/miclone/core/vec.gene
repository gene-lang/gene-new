# Vector and matrix math — design.md §D7.6.
#
# Matrices are `(Buffer F32)` of 16, **column-major**, because that is what
# `uniformMatrix4fv` reads with `transpose = false`. Writing them row-major and
# transposing on upload would cost a copy per frame for no benefit.
#
# This is §D3.1's *corrected* half, not its exact half: `mat4_perspective` uses
# `$math/tan`, which carries no cross-runtime accuracy guarantee. That is fine
# here and would not be fine in mapgen — a camera one ULP off is invisible,
# while terrain one ULP off is a different world. The distinction is the whole
# point of §D3.1, so it is worth naming at the one place in `core/` that
# deliberately sits on the other side of it.

(mod vec ^profile web)

(fn mat4_identity [m : (Buffer F32)] : Nil
  (var i 0.0)
  (while (< i 16.0)
    (m ~ set! i 0.0)
    (set i (+ i 1.0)))
  (m ~ set! 0.0 1.0)
  (m ~ set! 5.0 1.0)
  (m ~ set! 10.0 1.0)
  (m ~ set! 15.0 1.0))

# Right-handed perspective with a [-1, 1] depth range, matching WebGL's default
# clip space.
(fn mat4_perspective [m : (Buffer F32) fovy : F64 aspect : F64
                      near : F64 far : F64] : Nil
  (var f (/ 1.0 ($math/tan (/ fovy 2.0))))
  (var range_inv (/ 1.0 (- near far)))
  (var i 0.0)
  (while (< i 16.0)
    (m ~ set! i 0.0)
    (set i (+ i 1.0)))
  (m ~ set! 0.0 (/ f aspect))
  (m ~ set! 5.0 f)
  (m ~ set! 10.0 (* (+ far near) range_inv))
  (m ~ set! 11.0 -1.0)
  (m ~ set! 14.0 (* (* 2.0 (* far near)) range_inv)))

(fn vec3_length [x : F64 y : F64 z : F64] : F64
  ($math/sqrt (+ (* x x) (+ (* y y) (* z z)))))

# A view matrix from an eye position and a forward direction, rather than from a
# target point. A first-person camera already has yaw and pitch, so it produces
# a direction; making it invent a target to look at only to have `look_at`
# subtract the eye back out is a round trip through information it started with.
(fn mat4_view [m : (Buffer F32)
               eye_x : F64 eye_y : F64 eye_z : F64
               dir_x : F64 dir_y : F64 dir_z : F64] : Nil
  # f = normalized forward
  (var fl (vec3_length dir_x dir_y dir_z))
  (var fx (/ dir_x fl))
  (var fy (/ dir_y fl))
  (var fz (/ dir_z fl))
  # s = normalize(cross(f, world_up)); world up is +Y
  (var sx (- (* fy 0.0) (* fz 1.0)))
  (var sy (- (* fz 0.0) (* fx 0.0)))
  (var sz (- (* fx 1.0) (* fy 0.0)))
  (var sl (vec3_length sx sy sz))
  (set sx (/ sx sl))
  (set sy (/ sy sl))
  (set sz (/ sz sl))
  # u = cross(s, f), already unit because s and f are orthonormal
  (var ux (- (* sy fz) (* sz fy)))
  (var uy (- (* sz fx) (* sx fz)))
  (var uz (- (* sx fy) (* sy fx)))
  (m ~ set! 0.0 sx)
  (m ~ set! 1.0 ux)
  (m ~ set! 2.0 (- 0.0 fx))
  (m ~ set! 3.0 0.0)
  (m ~ set! 4.0 sy)
  (m ~ set! 5.0 uy)
  (m ~ set! 6.0 (- 0.0 fy))
  (m ~ set! 7.0 0.0)
  (m ~ set! 8.0 sz)
  (m ~ set! 9.0 uz)
  (m ~ set! 10.0 (- 0.0 fz))
  (m ~ set! 11.0 0.0)
  (m ~ set! 12.0 (- 0.0 (+ (* sx eye_x) (+ (* sy eye_y) (* sz eye_z)))))
  (m ~ set! 13.0 (- 0.0 (+ (* ux eye_x) (+ (* uy eye_y) (* uz eye_z)))))
  (m ~ set! 14.0 (+ (* fx eye_x) (+ (* fy eye_y) (* fz eye_z))))
  (m ~ set! 15.0 1.0))

# out = a * b, column-major. `out` must not alias `a` or `b`: the result is
# written as it is computed, so an aliased destination would read values it has
# already overwritten.
(fn mat4_multiply [out : (Buffer F32) a : (Buffer F32) b : (Buffer F32)] : Nil
  (var col 0.0)
  (while (< col 4.0)
    (var row 0.0)
    (while (< row 4.0)
      (var sum 0.0)
      (var k 0.0)
      (while (< k 4.0)
        (set sum (+ sum (* (a ~ get (+ row (* k 4.0)))
                           (b ~ get (+ k (* col 4.0))))))
        (set k (+ k 1.0)))
      (out ~ set! (+ row (* col 4.0)) sum)
      (set row (+ row 1.0)))
    (set col (+ col 1.0))))

# Yaw/pitch to a forward vector. Yaw turns around +Y, pitch is clamped by the
# caller — a camera that can look past vertical flips its own up vector and
# spins, which is the classic first-person bug.
(fn forward_x [yaw : F64 pitch : F64] : F64
  (* ($math/cos pitch) ($math/sin yaw)))

(fn forward_y [yaw : F64 pitch : F64] : F64
  ($math/sin pitch))

(fn forward_z [yaw : F64 pitch : F64] : F64
  (* ($math/cos pitch) (- 0.0 ($math/cos yaw))))
