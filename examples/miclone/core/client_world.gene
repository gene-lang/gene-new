# The received world's updates and hotbar presentation, shared by both shells.
(mod client_world ^profile web)
(import [World store_block store_light world_index array_x array_y array_z
         world_dx world_dy world_dz] from "./loaded.gene")
(import [Registry] from "./registry.gene")
(import [relight_node] from "./light.gene")
(import [delta_x delta_y delta_z delta_id] from "./protocol.gene")
(import [ItemRegistry item_name] from "./item.gene")
(import [slot_empty? slot_item slot_count] from "./inventory.gene")

(fn store_block_and_light [w : World bx : F64 by : F64 bz : F64
                           content : (Buffer F32) light : (Buffer F32)] : Nil
  (store_block w bx by bz content)
  (store_light w bx by bz light))

(fn apply_delta [w : World reg : Registry d : (Buffer F64)
                 sky : (Buffer F32) q : (Buffer F32) q_seed : (Buffer F32)] : Nil
  (var x (d .get delta_x))
  (var y (d .get delta_y))
  (var z (d .get delta_z))
  (w/content .set (world_index w x y z) (d .get delta_id))
  (relight_node w/light w/content (world_dx w) (world_dy w) (world_dz w)
                reg (array_x w x) (array_y w y) (array_z w z) sky q q_seed))

(fn hotbar_text [items : ItemRegistry inv : (Buffer F64) selected : F64] : Str
  (var parts : (List Str) [])
  (var i 0.0)
  (while (< i 8.0)
    (var label
      (if (slot_empty? inv i) "—"
        $"$(item_name items (slot_item inv i)) x$($to_int (slot_count inv i))"))
    (parts .push (if (== i selected) $"[${label}]" $" ${label} "))
    (set i (+ i 1.0)))
  ($str/join parts " "))
