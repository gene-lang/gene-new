# The node registry — design.md §2, client half.
#
# §2 splits a node definition in two, because the halves have different
# audiences and lifetimes: the *client half* (drawtype, tiles, transparency,
# light behaviour, collision) is serialized to every client on join and is pure
# data, while the *server half* (`on_dig`, `on_timer`, drops, ABMs) never
# leaves the server. This file is the client half, and it is portable for the
# reason that split exists — it is what lets a client mesh and predict without
# executing mod code (§D5).
#
# **Content ids are assigned at load, never hardcoded.** A world stores its own
# `name -> id` mapping so that a saved block still means what it meant after a
# mod is added, removed, or reordered (§1, §11). Nothing outside this file
# should compare a content id against a literal; ask the registry.
#
# Storage is parallel arrays indexed by content id rather than a map or a list
# of records, because every lookup here is on the meshing hot path — `solid?`
# and `light_propagates?` run per neighbour per node — and an indexed read into
# a typed array is the cheapest thing available in both backends.

(mod registry ^profile web)

(import [content_air content_unknown content_ignore first_dynamic_content]
        from "./world.gene")

(let max_content 4096.0)

# --- drawtypes ---------------------------------------------------------------
#
# §2's M0–M5 set. Luanti has 18 (`src/nodedef.h`); `nodebox` and `mesh` are the
# expensive ones and wait for M8. Numbered rather than named because they index
# the same arrays as everything else here.
#
# `F64`, like every other column value below — see the note on the type.

(let draw_normal 0.0)
(let draw_airlike 1.0)
(let draw_glasslike 2.0)
(let draw_allfaces 3.0)
(let draw_plantlike 4.0)
(let draw_liquid 5.0)

# --- the registry ------------------------------------------------------------
#
# `names` is deliberately a `(List Str)` while every other column is a typed
# buffer: it is read once at join to build the wire mapping and never on a hot
# path, and there is no typed-array representation of a string anyway.
#
# **The columns are `F32`, not `U8`, and so is the id that indexes them.** Every
# value here is a small integer a byte would hold, so `U8` is the natural
# declaration — and it is the wrong one. §D7.1 types integer-buffer elements as
# `Int`, `Int` lowers to `bigint` in the web profile, and the meshing loop reads
# these columns seven times per node. Measured over 5,832 elements: reading an
# `Int`-typed buffer costs **60.4 µs** against an `F32`-typed one at **6.8 µs**,
# and using the value as an index costs **93.0 µs** against **6.9 µs** — because
# the first form allocates a `BigInt` per read and then converts it back with
# `Number`. See `core/world.gene` for the rule this is one instance of.
#
# `count` is `F32` for the same reason and one more: as an `Int` it would need a
# conversion at every comparison against `max_content` and at every use as a
# slot index, for a value that is only ever a small whole number.

(type Registry
  ^props {^names        (List Str)
          # §13: the form right-clicking this node opens, or "" for a node that
          # does not open one. A string rather than an id because forms are a
          # separate registry with its own numbering, and a node that named a
          # form *number* would be a mod hardcoding an id — which is the one
          # thing §2 forbids.
          #
          # It goes on the wire with everything else here even though only the
          # server reads it today. A column that exists on one side and not the
          # other is §D3.1's divergence in miniature: the moment a client wants
          # to say "open" instead of "place" in its HUD, it would find an empty
          # string and no reason why.
          ^opens_form  (List Str)
          ^drawtype     (Buffer F32)
          ^solid        (Buffer F32)    # blocks movement
          ^opaque       (Buffer F32)    # hides the face behind it
          ^propagates   (Buffer F32)    # light passes through
          # Does not draw a face against another node of its own kind. §5's
          # cheapest cull and the only one that needs both sides of a face:
          # a see-through node is not opaque, so every internal face of a
          # cluster of them is drawn, and a tree's canopy is almost entirely
          # internal faces. See `core/mesh.gene` for the number.
          ^merges_same  (Buffer F32)
          ^light_source (Buffer F32)    # light emitted, 0..15
          ^tile_top     (Buffer F32)    # atlas index, +Y face
          ^tile_side    (Buffer F32)    # atlas index, the four side faces
          ^tile_bottom  (Buffer F32)    # atlas index, -Y face
          ^count        (Buffer F32)    # one cell; see `registered_count`

  }

  (ctor []
    (set self/names [])
    (set self/opens_form [])
    (set self/drawtype ($buffer F32 max_content))
    (set self/solid ($buffer F32 max_content))
    (set self/opaque ($buffer F32 max_content))
    (set self/propagates ($buffer F32 max_content))
    (set self/merges_same ($buffer F32 max_content))
    (set self/light_source ($buffer F32 max_content))
    (set self/tile_top ($buffer F32 max_content))
    (set self/tile_side ($buffer F32 max_content))
    (set self/tile_bottom ($buffer F32 max_content))
    (set self/count ($buffer F32 1.0))))

# The registry's own size lives in a one-cell buffer rather than an `Int` prop.
# A web-profile type's fields are checked on construction and the count changes
# on every registration; keeping it in the same storage as the columns means
# one mutation path instead of two, and `Buffer/set` is already the mutator
# every other column uses.
(fn registered_count [r : Registry] : F64
  (r/count .get 0.0))

(fn set_registered_count [r : Registry n : F64] : Nil
  (r/count .set 0.0 n))

(fn bool_byte [v : Bool] : F64
  (if v 1.0 0.0))

# --- registration ------------------------------------------------------------

# Overflow is a programming error rather than a condition to recover from —
# 4,096 node types is far past any real game — but it is raised rather than
# ignored, because the alternative is writing past the columns and mis-typing
# every node registered afterwards.
(type RegistryFull
  ^props {^message Str}
  (ctor [message : Str] (set self/message message)))

(impl Error for RegistryFull)

# Ten positional parameters is a lot, and the alternative — registering the
# physical half and the tiles in two calls — is worse: it makes "registered but
# untextured" a reachable state, and the mesher reads tiles per face with no way
# to tell that from a legitimate tile 0. One call that cannot half-succeed is
# the cheaper shape, and §9's mod-facing `register_node` is where the named-
# argument ergonomics belong.
(fn register [r : Registry name : Str drawtype : F64
              solid : Bool opaque : Bool propagates : Bool
              merges_same : Bool
              light_source : F64
              tile_top : F64 tile_side : F64 tile_bottom : F64
              opens_form : Str] : F64
  (var id (registered_count r))
  (if_yes (>= id max_content)
    (fail (new RegistryFull $"node registry is full at ${max_content} entries")))
  (var slot id)
  (r/names .push name)
  (r/opens_form .push opens_form)
  (r/drawtype .set slot drawtype)
  (r/solid .set slot (bool_byte solid))
  (r/opaque .set slot (bool_byte opaque))
  (r/propagates .set slot (bool_byte propagates))
  (r/merges_same .set slot (bool_byte merges_same))
  (r/light_source .set slot light_source)
  (r/tile_top .set slot tile_top)
  (r/tile_side .set slot tile_side)
  (r/tile_bottom .set slot tile_bottom)
  (set_registered_count r (+ id 1.0))
  id)

# The common case: one tile on every face.
(fn register_uniform [r : Registry name : Str drawtype : F64
                      solid : Bool opaque : Bool propagates : Bool
                      light_source : F64 tile : F64] : F64
  (register r name drawtype solid opaque propagates false light_source
            tile tile tile ""))

# The three reserved ids of §1, registered first so their numbering is a
# consequence of the order rather than a claim made in two places. A registry
# that has not had these installed is not usable, so this is the constructor
# every caller should reach for.
(fn new_registry [] : Registry
  (var r (new Registry))
  (register_uniform r "air" draw_airlike false false true 0.0 0.0)
  (register_uniform r "unknown" draw_normal true true false 0.0 0.0)
  (register_uniform r "ignore" draw_airlike false true false 0.0 0.0)
  r)

# The registry a **client** builds from the wire: empty, with not even §1's
# reserved ids installed, because those are the first three entries the message
# carries and installing them here would shift every id by three.
#
# It exists so that a harness does not have to know that. Every `.mjs` peer used
# to write `reg = new_registry(); reg.names = []; reg.count[0] = 0`, reaching
# into two internals — and adding a third column (§5's `merges_same`, §13's
# `opens_form`) silently broke exactly the ones that had not been updated. A
# named constructor is one place to change instead of four.
(fn new_wire_registry [] : Registry
  (new Registry))

# --- lookup ------------------------------------------------------------------
#
# Hot-path readers. Each is an indexed load, which is what the parallel-array
# layout is for.

(fn name_of [r : Registry id : F64] : Str
  (var names r/names)
  (var i id)
  names/%i)

(fn drawtype_of [r : Registry id : F64] : F64
  (r/drawtype .get id))

(fn solid? [r : Registry id : F64] : Bool
  (== (r/solid .get id) 1.0))

(fn opaque? [r : Registry id : F64] : Bool
  (== (r/opaque .get id) 1.0))

(fn propagates_light? [r : Registry id : F64] : Bool
  (== (r/propagates .get id) 1.0))

(fn merges_same? [r : Registry id : F64] : Bool
  (== (r/merges_same .get id) 1.0))

(fn opens_form_of [r : Registry id : F64] : Str
  (var f r/opens_form)
  (var i id)
  f/%i)

(fn light_source_of [r : Registry id : F64] : F64
  (r/light_source .get id))

# A node is *drawn* when it has geometry at all, which is a different question
# from whether it is opaque: glass is drawn and hides nothing, air is neither.
# §5 needs both — a face exists when its owner is drawn and its neighbour is not
# opaque — and collapsing them into one predicate is what makes glass either
# invisible or solid-looking.
(fn drawn? [r : Registry id : F64] : Bool
  (!= (r/drawtype .get id) draw_airlike))

(fn tile_top_of [r : Registry id : F64] : F64
  (r/tile_top .get id))

(fn tile_side_of [r : Registry id : F64] : F64
  (r/tile_side .get id))

(fn tile_bottom_of [r : Registry id : F64] : F64
  (r/tile_bottom .get id))

# Linear, and deliberately so: this runs once per name at world load to build
# the `name -> id` mapping, never per node. A hashed index would be a second
# structure to keep in step with the columns for no measurable gain.
(fn id_of [r : Registry name : Str] : F64
  (var names r/names)
  (var found content_unknown)
  (var i 0.0)
  (var n (registered_count r))
  (while (< i n)
    (if_yes (== names/%i name)
      (set found i)
      (set i n))
    (set i (+ i 1.0)))
  found)

(fn registered? [r : Registry name : Str] : Bool
  (!= (id_of r name) content_unknown))
