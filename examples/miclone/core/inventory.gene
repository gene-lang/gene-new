# Inventory — design.md §7.1 and §13.
#
# A list of stacks, held in a caller-owned buffer of `(item, count)` pairs. An
# empty slot is a count of zero and its item is meaningless.
#
# ## Why a buffer of pairs rather than a list of stack objects
#
# The same reason as everywhere else here (§1, §4, §5): the web profile's
# nominal types are reference objects, so a list of stacks is an allocation per
# stack and a property load per field. An inventory is not a hot path — it
# changes when a player digs — but it *is* serialized (§10) and persisted (§11),
# and a flat numeric buffer is already the shape both of those want.
#
# The slot count is the buffer's own length rather than a header cell, because
# unlike §4's queue there is no other state to keep beside it.
#
# ## An id here is an *item* id
#
# It used to be a content id, and this header used to promise that "the day
# items get their own registry, this file changes in one place: what an id
# means". That day came with §2's item registry (`core/item.gene`), and the
# promise held — the change is this paragraph and the `stack_max` lookup below.
# Everything else in this file was already about "an id and a count".
#
# A slot is three cells rather than two, because §2's `ItemStack` is
# `{^name ^count ^wear ^meta}` and a tool that cannot wear out is not a tool.
# **`^meta` is still not here**: it is a Map per stack, it has no representation
# in a numeric buffer, and nothing before M8's containers reads one.
#
# **Nothing here is predicted.** §7.1 step 3: "Drops, wear, and stack changes
# are never predicted — they are exactly what mod code varies, and a hotbar that
# flickers the wrong item is worse than one that updates 80 ms late." In M5's
# in-process singleplayer there is nothing to predict, because the edit and its
# drop happen in the same call. M6 is where that sentence starts costing
# something.

(mod inventory ^profile web)

(import [ItemRegistry item_stack_max] from "./item.gene")

# Per item now, out of §2's registry, which is what the registry is for. The
# functions that need it take the registry; the ones that only move counts
# around do not, which keeps `take` and `slot_count` free of it.
(let cells_per_slot 3.0)
(let cell_item 0.0)
(let cell_count 1.0)
(let cell_wear 2.0)

(fn new_inventory [slots : F64] : (Buffer F64)
  ($buffer F64 (* slots cells_per_slot)))

(fn slots_of [inv : (Buffer F64)] : F64
  (/ inv/~len cells_per_slot))

(fn slot_item [inv : (Buffer F64) slot : F64] : F64
  (inv ~ get (* slot cells_per_slot)))

(fn slot_count [inv : (Buffer F64) slot : F64] : F64
  (inv ~ get (+ (* slot cells_per_slot) cell_count)))

(fn slot_empty? [inv : (Buffer F64) slot : F64] : Bool
  (== (slot_count inv slot) 0.0))

# 0 is a fresh tool and `wear_max` is a spent one. Upstream's range, because the
# number is serialized (§10, §11) and a wider one buys nothing a player sees.
(let wear_max 65535.0)

(fn slot_wear [inv : (Buffer F64) slot : F64] : F64
  (inv ~ get (+ (* slot cells_per_slot) cell_wear)))

# Writing a count of zero clears the item as well, so an empty slot never keeps
# a stale id that `add` could then stack onto.
(fn set_slot_worn [inv : (Buffer F64) slot : F64 item : F64 count : F64
                   wear : F64] : Nil
  (var at (* slot cells_per_slot))
  (if (<= count 0.0)
    (then
      (inv ~ set! at 0.0)
      (inv ~ set! (+ at cell_count) 0.0)
      (inv ~ set! (+ at cell_wear) 0.0))
    (else
      (inv ~ set! at item)
      (inv ~ set! (+ at cell_count) count)
      (inv ~ set! (+ at cell_wear) wear))))

(fn set_slot [inv : (Buffer F64) slot : F64 item : F64 count : F64] : Nil
  (set_slot_worn inv slot item count 0.0))

# Wear a tool by `amount`, and destroy it when it is spent — which is why this
# is here rather than a `set_slot_worn` at the call site: "a tool that reaches
# `wear_max` disappears" is a rule about stacks, not about digging.
(fn wear_slot [inv : (Buffer F64) slot : F64 amount : F64] : Bool
  (var worn (+ (slot_wear inv slot) amount))
  (if (>= worn wear_max)
    (then
      (set_slot inv slot 0.0 0.0)
      true)
    (else
      (set_slot_worn inv slot (slot_item inv slot) (slot_count inv slot) worn)
      false)))

# --- adding ------------------------------------------------------------------

# Put `count` of `item` in, and return however many did not fit.
#
# Partial stacks first, then empty slots — which is what makes digging twenty
# stone fill one slot rather than twenty, and is the order every game in this
# genre uses.
(fn add [inv : (Buffer F64) items : ItemRegistry item : F64
         count : F64] : F64
  (var stack_max (item_stack_max items item))
  (var left count)
  (var n (slots_of inv))

  (var i 0.0)
  (while (&& (> left 0.0) (< i n))
    (if_yes (&& (== (slot_item inv i) item) (> (slot_count inv i) 0.0))
      (var room (- stack_max (slot_count inv i)))
      (if_yes (> room 0.0)
        (var moved ($math/min room left))
        (set_slot inv i item (+ (slot_count inv i) moved))
        (set left (- left moved))))
    (set i (+ i 1.0)))

  (set i 0.0)
  (while (&& (> left 0.0) (< i n))
    (if_yes (slot_empty? inv i)
      (var moved ($math/min stack_max left))
      (set_slot inv i item moved)
      (set left (- left moved)))
    (set i (+ i 1.0)))

  left)

# --- taking ------------------------------------------------------------------

# Remove up to `count` from one slot and return how many were actually removed,
# which is 0 for an empty slot and is what a caller checks before spending the
# item on something.
(fn take [inv : (Buffer F64) slot : F64 count : F64] : F64
  (var have (slot_count inv slot))
  (var moved ($math/min have count))
  (if_yes (> moved 0.0)
    (set_slot inv slot (slot_item inv slot) (- have moved)))
  moved)

# --- asking ------------------------------------------------------------------

(fn total_of [inv : (Buffer F64) item : F64] : F64
  (var sum 0.0)
  (var i 0.0)
  (var n (slots_of inv))
  (while (< i n)
    (if_yes (== (slot_item inv i) item)
      (set sum (+ sum (slot_count inv i))))
    (set i (+ i 1.0)))
  sum)

# The first slot holding `item`, or -1. Negative rather than the slot count,
# because a caller that forgets to check would then index a slot that exists.
(fn find_item [inv : (Buffer F64) item : F64] : F64
  (var found -1.0)
  (var i 0.0)
  (var n (slots_of inv))
  (while (< i n)
    (if_yes (&& (== found -1.0)
                (&& (== (slot_item inv i) item) (> (slot_count inv i) 0.0)))
      (set found i))
    (set i (+ i 1.0)))
  found)

(fn empty? [inv : (Buffer F64) ] : Bool
  (var used false)
  (var i 0.0)
  (var n (slots_of inv))
  (while (< i n)
    (if_yes (> (slot_count inv i) 0.0) (set used true))
    (set i (+ i 1.0)))
  (! used))
