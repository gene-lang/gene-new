# The server — design.md §10, §12, and §7.1's authoritative half.
#
# Owns the world, accepts WebSocket connections, and answers them. VM-only:
# it holds §11's SQLite store and §2's server half (drops), neither of which
# the browser has or should have.
#
# ## What M6 is, and what it is not
#
# §D8's M6 is "the same game, client and server as separate processes". The
# world, the physics, the lighting, and the protocol are all already portable —
# M1 through M5 built them in `core/` for exactly this — so what this file adds
# is not gameplay. It is the part §D3 says should be small: a socket, a
# dispatch on a message kind, and the authority to say no.
#
# **What it is not is a tick loop.** §12 specifies a fixed-step server tick, and
# there is nothing yet that needs one: no entities (§8), no ABMs (§9), no
# liquids that flow. Every message this handles is a response to a client
# action, so the server is reactive and says so rather than running an empty
# loop at 20 Hz to look like a game server. §12's loop arrives with the first
# thing that changes without being asked.
#
# ## One world, many clients, no player state
#
# The world is shared and every client sees every edit. What is *not* shared is
# the player — and the reason is stronger than "not sent yet": this server keeps
# exactly one thing per connection, an inventory, and **no position and no
# physics state at all**. The client runs the same step against the same world
# (§7) and `msg_input` is decoded and dropped, so there is nothing to send even
# if there were somewhere to send it. §8's entities are what make a player
# visible to another player, and they are the first thing that requires a server
# to know where anyone is standing.
#
# So two clients on this server dig the same world and cannot see each other.
# That is the honest M6 scope: the split is real and the game through it is the
# same singleplayer game, which is exactly what §D8 asks M6 to demonstrate.

(mod server_main)

(import $net/http [Server serve listen ws_accept ws_send ws_close])
(import $os [get_env Env])
(import [Registry registered_count id_of] from "../core/registry.gene")
(import [Game] from "../core/api.gene")
(import [TileRegistry] from "../core/tiles.gene")
(import [load_mods] from "../core/mods.gene")
(import [generate_block] from "../core/mapgen.gene")
(import [World new_world store_block store_light extract_block block_base
         open_sky node_at
         world_dx world_dy world_dz world_stride_z world_nodes
         world_min_x world_min_y world_min_z]
        from "../core/loaded.gene")
(import [WorldStore open_world close_world world_exists? write_meta
         put_block get_block block_count stored_bytes
         begin_batch commit_batch]
        from "./storage.gene")
(import [light_region queue_overhead] from "../core/light.gene")
(import [new_bounds apply_node diggable? placeable?] from "../core/edit.gene")
(import [find_spawn] from "../core/physics.gene")
(import [AbmRegistry abm_count abm_kind abm_group abm_interval abm_chance abm_due
         set_abm_due queued_count queued_x queued_y queued_z queued_id
         clear_queue sample_x sample_y sample_z chance_passes?
         queue_node abm_fall
         queue_check check_count check_x_at check_y_at check_z_at
         clear_checks]
        from "../core/abm.gene")
(import [GroupRegistry rating_of] from "../core/groups.gene")

(import [new_inventory add take slot_item slot_count slot_empty?]
        from "../core/inventory.gene")
(import [drop_item drop_count] from "../core/drops.gene")
(import [ItemRegistry item_node placeable_item?] from "../core/item.gene")
(import [new_cursor] from "../core/wire.gene")
(import [message_kind msg_input msg_dig msg_place msg_request_blocks
         hello_size encode_hello
         registry_size encode_registry
         tiles_size encode_tiles
         items_size encode_items
         block_size encode_block
         node_delta_size encode_node_delta
         inventory_size encode_inventory
         new_edit decode_edit edit_x edit_y edit_z edit_id
         new_request decode_request_blocks req_from req_count]
        from "../core/protocol.gene")

(let seed 1337.0)
(let block_dim 16)
(let block_nodes 4096)

# §D6.1's extent and site, which the client no longer chooses — the server
# tells it in `hello`, because the server is the one that generated it.
(let origin_bx -90)
(let origin_by 0)
(let origin_bz 198)
(let span_x 12)
(let span_y 4)
(let span_z 12)

(let hotbar_slots 8)

(let port 8790)

# §11's world, on disk. `GENE_MICLONE_WORLD` overrides it, which is what makes a
# throwaway world easy to ask for — and M7 will want that constantly, since a
# mod that changes worldgen wants a world it can discard.
(let default_world_root "/tmp/miclone_server_world")

# --- the world ---------------------------------------------------------------

# Load what the store has and generate the rest.
#
# **The distinction that matters is "stored" versus "never generated", not
# "stored" versus "all air".** `get_block` answers `false` only for a block the
# world has never had, which is exactly why §11 made that a separate state: a
# mined-out cave is legitimately mostly air, and a loader that treated air as
# absent would regenerate the stone the player dug out.
#
# Lighting runs over the whole world afterwards either way (§4.2). A stored
# block carries its own light and re-flooding it produces the same values, so
# this costs one pass and removes a class of bug — a world half-lit from disk
# and half-lit from a flood, with a seam where they meet.
(fn build_world [game : Game store : WorldStore fresh : Bool] : World
  (var reg game/nodes)
  (var biomes game/biomes)
  (var ores game/ores)
  (var air (id_of reg "air"))
  (var water (id_of reg "miclone:water"))
  (var w (new_world ($to_float origin_bx) ($to_float origin_by)
                    ($to_float origin_bz)
                    ($to_float span_x) ($to_float span_y) ($to_float span_z)))

  (var block ($buffer F32 ($to_float block_nodes)))
  (var light ($buffer F32 ($to_float block_nodes)))
  (var param2 ($buffer F32 ($to_float block_nodes)))
  (var block_sky ($buffer F32 ($to_float (* block_dim block_dim))))
  (var loaded 0)
  (var generated 0)
  (begin_batch store)
  (var cz 0)
  (while (< cz span_z)
    (var cy 0)
    (while (< cy span_y)
      (var cx 0)
      (while (< cx span_x)
        (var ibx (+ origin_bx cx))
        (var iby (+ origin_by cy))
        (var ibz (+ origin_bz cz))
        (var bx ($to_float ibx))
        (var by ($to_float iby))
        (var bz ($to_float ibz))
        (if (&& (! fresh)
                (get_block store reg block_dim ibx iby ibz
                           block light param2))
          (then
            (store_block w bx by bz block)
            (store_light w bx by bz light)
            (set loaded (+ loaded 1)))
          (else
            (generate_block block block_sky
                            (* bx 16.0) (* by 16.0) (* bz 16.0)
                            biomes ores seed air water)
            (store_block w bx by bz block)
            (set generated (+ generated 1))))
        (set cx (+ cx 1)))
      (set cy (+ cy 1)))
    (set cz (+ cz 1)))
  (commit_batch store)
  ($println $"  ${loaded} block(s) from disk, ${generated} generated")

  # One flood over the whole loaded world (§4.2), which is what makes light
  # cross block boundaries — and is why the server sends light rather than
  # letting the client derive it (§4).
  (var sky ($buffer F32 (* (world_dx w) (world_dz w))))
  (open_sky w sky)
  (var q ($buffer F32 (+ (world_nodes w) queue_overhead)))
  (light_region w/light w/content (world_dx w) (world_dy w) (world_dz w)
                reg sky q (registered_count reg))
  w)

# --- sending -----------------------------------------------------------------
#
# Every send is `buf/~to_bytes` then `ws_send`. That conversion is the whole
# of the VM's I/O boundary: the codec works over a `(Buffer U8)` because the
# client must run the same code, and `Bytes` is what the socket takes.

(fn send_hello [conn w : World spawn_at : (Buffer F64)] : Nil
  (var c (new_cursor))
  (var b ($buffer U8 hello_size))
  (encode_hello b c seed
                ($to_float origin_bx) ($to_float origin_by)
                ($to_float origin_bz)
                ($to_float span_x) ($to_float span_y) ($to_float span_z)
                (spawn_at ~ get 0.0) (spawn_at ~ get 1.0) (spawn_at ~ get 2.0))
  (ws_send conn b/~to_bytes))

(fn send_registry [conn reg : Registry] : Nil
  (var c (new_cursor))
  (var b ($buffer U8 (registry_size reg)))
  (encode_registry b c reg)
  (ws_send conn b/~to_bytes))

# §9's appearance table. Sent before the registry, because a node's tile columns
# are slots into this and a client that read them first would hold indices into
# an atlas it has not been told how to paint.
(fn send_tiles [conn t : TileRegistry] : Nil
  (var c (new_cursor))
  (var b ($buffer U8 (tiles_size t)))
  (encode_tiles b c t)
  (ws_send conn b/~to_bytes))

# §2's item registry. Sent with the rest of the join, because an inventory
# message is meaningless before it — an item id names nothing until this lands.
(fn send_items [conn r : ItemRegistry] : Nil
  (var c (new_cursor))
  (var b ($buffer U8 (items_size r)))
  (encode_items b c r)
  (ws_send conn b/~to_bytes))

# Returns `ws_send`'s drop count — see `answer_blocks` for why anything reads it.
(fn send_block [conn w : World bx : F64 by : F64 bz : F64] : F64
  (var c (new_cursor))
  (var base (block_base w bx by bz))
  (var dx (world_dx w))
  (var sz (world_stride_z w))
  (var b ($buffer U8 (block_size w/content w/light base dx sz)))
  (encode_block b c bx by bz w/content w/light base dx sz)
  ($to_float (ws_send conn b/~to_bytes)))

(fn send_node_delta [conn nx : F64 ny : F64 nz : F64
                     id : F64 param1 : F64] : Nil
  (var c (new_cursor))
  (var b ($buffer U8 node_delta_size))
  (encode_node_delta b c nx ny nz id param1)
  (ws_send conn b/~to_bytes))

(fn send_inventory [conn inv : (Buffer F64)] : Nil
  (var c (new_cursor))
  (var b ($buffer U8 (inventory_size ($to_float hotbar_slots))))
  (encode_inventory b c inv ($to_float hotbar_slots))
  (ws_send conn b/~to_bytes))

# Answer a client's request for blocks `[from, from + count)` in the linear
# index the client computes from `hello`'s extent.
#
# **The client asks and the server answers; the server does not push.** That is
# not politeness, it is flow control, and skipping it cost a debugging session:
# the WebSocket outbound queue holds 256 frames per connection and `ws_send`
# *drops the oldest* when it overflows. The first version of this file pushed
# all 576 blocks in a loop from `on_open` — 422 of them arrived, `ws_send`
# reported the drops, nothing read the report, and the client got a world with
# holes in it and no error.
#
# So this also **checks what `ws_send` returns**. A drop here means the client
# asked for more than the socket could absorb, which is a bug in the client's
# window rather than a condition to recover from — but it is said rather than
# swallowed, which is the whole lesson of the previous commit.
(fn answer_blocks [conn w : World from : F64 count : F64] : F64
  (var total ($to_float (* span_x (* span_y span_z))))
  (var at from)
  (var last ($math/min total (+ from count)))
  (var dropped 0.0)
  (while (< at last)
    (var cx (- at (* span_x ($math/floor (/ at ($to_float span_x))))))
    (var rest ($math/floor (/ at ($to_float span_x))))
    (var cy (- rest (* span_y ($math/floor (/ rest ($to_float span_y))))))
    (var cz ($math/floor (/ rest ($to_float span_y))))
    (var drops (send_block conn w
                           (+ ($to_float origin_bx) cx)
                           (+ ($to_float origin_by) cy)
                           (+ ($to_float origin_bz) cz)))
    (set dropped (+ dropped drops))
    (set at (+ at 1.0)))
  (if_yes (> dropped 0.0)
    ($println $"  WARN dropped $($to_int dropped) frame(s): the client's request window is larger than the socket can absorb"))
  (- last from))

# Write one block of the loaded world back to the store.
#
# The three scratch buffers are the caller's, for §4's reason: this runs once
# per edit and allocating 48 KB inside a click handler is the thing a hot path
# must not do.
#
# `param2` is written as zeros because `core/loaded.gene` does not carry one —
# §1 gives a node three fields and the loaded world keeps two, since nothing in
# M0–M6 uses `param2` (it is facedir, liquid level, colour index; all of them
# arrive with M8's drawtypes). The column exists on disk so that adding it later
# is a format that already has room rather than a version bump.
(fn persist_block [store : WorldStore reg : Registry w : World
                   bx : Int by : Int bz : Int
                   content : (Buffer F32) light : (Buffer F32)
                   param2 : (Buffer F32)] : Nil
  (extract_block w ($to_float bx) ($to_float by) ($to_float bz)
                 content w/content)
  (extract_block w ($to_float bx) ($to_float by) ($to_float bz)
                 light w/light)
  (put_block store reg block_dim bx by bz content light param2))

# Which block a node belongs to. `$math/floor` rather than a shift, for the
# reason `core/world.gene` gives: the coordinates are `F64` and negative
# division truncates toward zero, which would fold blocks -1 and 0 together.
(fn block_of [n : F64] : Int
  ($to_int ($math/floor (/ n 16.0))))

# --- the tick ----------------------------------------------------------------
#
# §12's fixed-step server loop, and §12.1 said what would bring it: "the first
# thing that changes without being asked". That is M8's falling sand, and the
# loop arrived with it rather than ahead of it.
#
# It runs on `serve`'s `^on_tick`, which the event loop already had a place for
# — it sleeps only as long as nothing needs it, so a tick is one more deadline
# to clamp against rather than a thread. §D7.16 records the hook.
#
# **Sampled, not exhaustive** (§12). Each pass looks at `samples_per_pass`
# positions out of 2.4M; an ABM fires where its group matches and its chance
# passes. A player watching sand fall cannot tell that the engine did not check
# every grain, and an exhaustive pass at this extent would be 12M node reads a
# second before any ABM did anything.

(let tick_ms 100)
(let samples_per_pass 900)

# Every connection, so a change nobody asked for can reach everybody. §12.1
# named this as the one shape the tick would have to change: per-connection
# state was a closure, and a closure cannot be iterated.
(var connections : (List Any) [])

# Seed the check queue around a position that just changed. The node above is
# what matters for falling and is why this is not the six neighbours: a node
# below a change cannot start falling because of it, and the four sides only
# matter for behaviours that do not exist yet.
(fn note_change [game : Game x : F64 y : F64 z : F64] : Nil
  (queue_check game/abms x (+ y 1.0) z))

(fn run_abms [game : Game world : World now : F64 step : F64
              sky : (Buffer F32) lq : (Buffer F32) lq_seed : (Buffer F32)
              bounds : (Buffer F64)] : F64
  (var abms game/abms)
  (var groups game/groups)
  (var air (id_of game/nodes "air"))
  (var n (abm_count abms))
  (var applied 0.0)

  # --- the check queue: where something just happened ------------------------
  #
  # Drained every tick, and a node that moves seeds the position above it, so a
  # column falls one node per tick from the bottom up rather than settling one
  # node per minute (see `core/abm.gene` for the measurement that forced this).
  (var checks (check_count abms))
  (var i 0.0)
  (while (< i checks)
    (var cx (check_x_at abms i))
    (var cy (check_y_at abms i))
    (var cz (check_z_at abms i))
    (var here (node_at world cx cy cz))
    (var a 0.0)
    (while (< a n)
      (if_yes (&& (== (abm_kind abms a) abm_fall)
                  (> (rating_of groups here (abm_group abms a)) 0.0))
        (if_yes (== (node_at world cx (- cy 1.0) cz) air)
          (queue_node abms cx (- cy 1.0) cz here)
          (queue_node abms cx cy cz air)))
      (set a (+ a 1.0)))
    (set i (+ i 1.0)))
  (clear_checks abms)

  # --- sampling: where nothing did -------------------------------------------
  #
  # §12's ambient half. Nothing registered uses it yet — falling is targeted —
  # and it runs because the second ABM will be a grass spread, which is exactly
  # what sampling is for.
  (var dx (world_dx world))
  (var dy (world_dy world))
  (var dz (world_dz world))
  (var a2 0.0)
  (while (< a2 n)
    (if_yes (&& (!= (abm_kind abms a2) abm_fall) (>= now (abm_due abms a2)))
      (set_abm_due abms a2 (+ now (abm_interval abms a2)))
      (var s 0.0)
      (while (< s ($to_float samples_per_pass))
        (var t (+ step s))
        (if_yes (chance_passes? t (abm_chance abms a2))
          (var px (+ (world_min_x world) (sample_x t (- dx 2.0))))
          (var py (+ (world_min_y world) (sample_y t (- dy 2.0))))
          (var pz (+ (world_min_z world) (sample_z t (- dz 2.0))))
          (if_yes (> (rating_of groups (node_at world px py pz)
                                (abm_group abms a2)) 0.0)
            void))
        (set s (+ s 1.0))))
    (set a2 (+ a2 1.0)))

  # --- drain -----------------------------------------------------------------
  #
  # Through §7.1's own edit path, so the light is recomputed exactly as a
  # player's dig would leave it and the delta reaches every client by the route
  # that already works.
  (var q (queued_count abms))
  (var j 0.0)
  (while (< j q)
    (var qx (queued_x abms j))
    (var qy (queued_y abms j))
    (var qz (queued_z abms j))
    (var qid (queued_id abms j))
    (if_yes (!= (node_at world qx qy qz) qid)
      (apply_node world game/nodes qx qy qz qid sky lq lq_seed bounds)
      (var light (world/light ~ get (block_index_of world qx qy qz)))
      (var c 0.0)
      (var cn connections/~size)
      (while (< c cn)
        (var conn connections/%c)
        (send_node_delta conn qx qy qz qid light)
        (set c (+ c 1.0)))
      # What just moved may free the node above it. This is the cascade.
      (queue_check abms qx (+ qy 1.0) qz)
      (set applied (+ applied 1.0)))
    (set j (+ j 1.0)))
  (clear_queue abms)
  applied)

# --- serving -----------------------------------------------------------------

(fn main [args] : Nil
  # §9's game. Every id below is one a mod caused to exist.
  (var game (load_mods))
  (var reg game/nodes)
  (var drops game/drops)
  (var items game/items)
  (var air (id_of reg "air"))

  (var root (get_env Env "GENE_MICLONE_WORLD" default_world_root))
  (var fresh (! (world_exists? root)))
  (var store (open_world root))
  (if fresh
    (then
      (write_meta store seed "miclone")
      ($println $"miclone server: new world at ${root}"))
    (else ($println $"miclone server: opening ${root}")))

  (var t0 ($os/monotonic_ms))
  (var world (build_world game store fresh))
  (var spawn_at ($buffer F64 3.0))
    # The scan lives in `core/physics.gene` — it has been got wrong twice, and
  # one definition is the fix. The server owns the *result*: it goes out in
  # `hello`, because the server is the process that generated the world.
  (find_spawn world reg
              (* ($to_float (+ origin_bx (/ span_x 2))) 16.0)
              (* ($to_float (+ origin_bz (/ span_z 2))) 16.0)
              (* ($to_float (+ origin_by span_y)) 16.0)
              96.0 spawn_at)
  # A world generated for the first time is written whole, so the next start
  # loads it. An existing one is already on disk and only its edits are written.
  (if_yes fresh
    (var scratch ($buffer F32 ($to_float block_nodes)))
    (var scratch_l ($buffer F32 ($to_float block_nodes)))
    (var scratch_p2 ($buffer F32 ($to_float block_nodes)))
    (begin_batch store)
    (var sz 0)
    (while (< sz span_z)
      (var sy 0)
      (while (< sy span_y)
        (var sx 0)
        (while (< sx span_x)
          (persist_block store reg world (+ origin_bx sx) (+ origin_by sy)
                         (+ origin_bz sz) scratch scratch_l scratch_p2)
          (set sx (+ sx 1)))
        (set sy (+ sy 1)))
      (set sz (+ sz 1)))
    (commit_batch store)
    ($println $"  saved $(block_count store) blocks, $(stored_bytes store) bytes"))

  ($println $"  ready in $(- ($os/monotonic_ms) t0) ms; spawn at $(spawn_at ~ get 0.0), $(spawn_at ~ get 1.0), $(spawn_at ~ get 2.0)")

  # §4's scratch, allocated once for the process rather than per edit: the
  # queues are 10 MB at this extent and an edit happens inside a click.
  (var sky ($buffer F32 (* (world_dx world) (world_dz world))))
  (open_sky world sky)
  (var lq ($buffer F32 (+ (world_nodes world) queue_overhead)))
  (var lq_seed ($buffer F32 (+ (world_nodes world) queue_overhead)))
  (var bounds (new_bounds))
  (var edit (new_edit))
  # Scratch for writing an edited block back to disk — allocated here for the
  # same reason the light queues are: an edit happens inside a click.
  (var save_c ($buffer F32 ($to_float block_nodes)))
  (var save_l ($buffer F32 ($to_float block_nodes)))
  (var save_p2 ($buffer F32 ($to_float block_nodes)))

  ($println $"miclone server: listening on ${port}")
  # §12's loop. `step` advances every tick and is what the ABM sampler walks,
  # so the positions looked at differ from one tick to the next.
  (var step ($cell 0.0))
  (serve (listen ^host "127.0.0.1" ^port port)
    ^tick_ms tick_ms
    ^on_tick (fn []
      (step ~ set (+ (step ~ get) ($to_float samples_per_pass)))
      (run_abms game world ($to_float ($os/monotonic_ms)) (step ~ get)
                sky lq lq_seed bounds))
    (fn [req]
      # Per-connection state. A closure over these is what makes each client
      # its own player without a table keyed by connection — and §12's tick is
      # what forced a second, enumerable list beside it: a change nobody asked
      # for has to reach everybody, and a closure cannot be iterated (§12.1).
      (var inv (new_inventory ($to_float hotbar_slots)))
      (ws_accept req
        ^on_open (fn [conn]
          # Handshake only. The terrain follows when the client asks for it,
          # which is what keeps the 256-frame queue from overflowing.
          (send_hello conn world spawn_at)
          (send_tiles conn game/tiles)
          (send_items conn game/items)
          (send_registry conn reg)
          (send_inventory conn inv)
          (connections ~ push! conn)
          ($println "  client joined"))

        ^on_message (fn [conn payload]
          # `payload` is `Bytes` for a binary frame (the previous commit's
          # work); back into a `(Buffer U8)` so the portable codec can read it.
          (var b ($binary/to_buffer payload))
          (var c (new_cursor))
          # **A message shorter than its kind byte is dropped, not decoded.**
          # A server takes bytes from the network and a peer is entitled to send
          # anything; without this an empty frame reads `undefined` for the kind
          # and every comparison below is against Void. That is not theoretical
          # — a probe with a miscomputed buffer size sent exactly this, and the
          # handler threw once per message.
          (if_yes (>= ($binary/size payload) 1)
          (var kind (message_kind b))

          (if_yes (== kind msg_request_blocks)
            (var req (new_request))
            (decode_request_blocks b c req)
            (answer_blocks conn world (req ~ get req_from)
                           (req ~ get req_count)))

          # §7.1's authority. The client has already applied the edit
          # optimistically and predicted nothing about the drop; what goes back
          # is the node delta that either agrees — and is retired silently — or
          # does not, and wins.
          (if (== kind msg_dig)
            (then
              (decode_edit b c edit)
              (var nx (edit ~ get edit_x))
              (var ny (edit ~ get edit_y))
              (var nz (edit ~ get edit_z))
              (if_yes (diggable? world reg nx ny nz)
                (var was (node_at world nx ny nz))
                (apply_node world reg nx ny nz air sky lq lq_seed bounds)
                # The drop is the server's alone (§2, §7.1 step 3).
                (var yield_n (drop_count drops items was))
                (if_yes (> yield_n 0.0)
                  (add inv items (drop_item drops items was) yield_n)
                  (send_inventory conn inv))
                (send_node_delta conn nx ny nz air
                                 (world/light ~ get
                                   (block_index_of world nx ny nz)))
                # §12: whatever was resting on it may now fall.
                (note_change game nx ny nz)
                # §11's promise — "quit and come back to the same world" — is
                # only true if an edit reaches the disk. One block per edit:
                # the *lighting* an edit changes can reach far (§7.1), but the
                # node itself is in one block, and a neighbour whose light
                # changed will be re-flooded from its own nodes on the next
                # load (§4.2 lights the whole world in one pass).
                (persist_block store reg world
                               (block_of nx) (block_of ny) (block_of nz)
                               save_c save_l save_p2)))

            (else
              (if (== kind msg_place)
                (then
                  (decode_edit b c edit)
                  (var nx (edit ~ get edit_x))
                  (var ny (edit ~ get edit_y))
                  (var nz (edit ~ get edit_z))
                  # An *item* id now (§2). The server resolves it to a node,
                  # which is also the check that a client cannot place a
                  # pickaxe: an item with no node is refused here rather than
                  # trusted.
                  (var held (edit ~ get edit_id))
                  # The client says what it is holding and the server checks it
                  # actually holds it — a client that lies about its inventory
                  # is the one thing a client must not be believed about.
                  (var slot (find_slot inv held))
                  (var as_node (if (placeable_item? items held)
                                 (item_node items held) -1.0))
                  (if_yes (&& (>= slot 0.0)
                              (&& (>= as_node 0.0)
                                  (placeable? world reg nx ny nz)))
                    (take inv slot 1.0)
                    (apply_node world reg nx ny nz as_node sky lq lq_seed bounds)
                    (send_inventory conn inv)
                    (send_node_delta conn nx ny nz as_node
                                     (world/light ~ get
                                       (block_index_of world nx ny nz)))
                    (persist_block store reg world
                                   (block_of nx) (block_of ny) (block_of nz)
                                   save_c save_l save_p2)))

                # §10's input message. Nothing is done with it yet: the client
                # runs the same physics against the same world (§7), so its
                # position is already right and there is no second player to
                # tell about it. It is decoded and dropped rather than not
                # sent, because the message that proves the client can talk is
                # worth having before the entity that needs it (§8, M8).
                (else void)))))))))
  ($println "miclone server: stopped"))

# The world array index of a node, so a delta can carry the light the relight
# just wrote. `core/loaded.gene` exports the pieces; this is the one place the
# server needs the composed index.
(fn block_index_of [w : World nx : F64 ny : F64 nz : F64] : F64
  (+ (+ (- nx (* ($to_float origin_bx) 16.0)) 1.0)
     (+ (* (+ (- ny (* ($to_float origin_by) 16.0)) 1.0) (world_dx w))
        (* (+ (- nz (* ($to_float origin_bz) 16.0)) 1.0)
           (world_stride_z w)))))

(fn find_slot [inv : (Buffer F64) item : F64] : F64
  (var found -1.0)
  (var i 0.0)
  (while (< i ($to_float hotbar_slots))
    (if_yes (&& (== found -1.0)
                (&& (== (slot_item inv i) item) (> (slot_count inv i) 0.0)))
      (set found i))
    (set i (+ i 1.0)))
  found)
