# The server — design.md §10, §12, and §7.1's authoritative half.
#
# Owns the world, accepts WebSocket connections, and answers them. VM-only:
# it holds §11's SQLite store and §2's server half (drops), neither of which
# the browser has or should have.
#
# ## What M6 is, and what it is not
#
# §D8's M6 is "the same game, client and server as separate processes". The
# world, the physics, the lighting, and the protocol are all already portable —
# M1 through M5 built them in `core/` for exactly this — so what this file adds
# is not gameplay. It is the part §D3 says should be small: a socket, a
# dispatch on a message kind, and the authority to say no.
#
# **What it is not is a tick loop.** §12 specifies a fixed-step server tick, and
# there is nothing yet that needs one: no entities (§8), no ABMs (§9), no
# liquids that flow. Every message this handles is a response to a client
# action, so the server is reactive and says so rather than running an empty
# loop at 20 Hz to look like a game server. §12's loop arrives with the first
# thing that changes without being asked.
#
# ## One world, many clients, no player state
#
# The world is shared and every client sees every edit. What is *not* shared is
# the player — and the reason is stronger than "not sent yet": this server keeps
# exactly one thing per connection, an inventory, and **no position and no
# physics state at all**. The client runs the same step against the same world
# (§7) and `msg_input` is decoded and dropped, so there is nothing to send even
# if there were somewhere to send it. §8's entities are what make a player
# visible to another player, and they are the first thing that requires a server
# to know where anyone is standing.
#
# So two clients on this server dig the same world and cannot see each other.
# That is the honest M6 scope: the split is real and the game through it is the
# same singleplayer game, which is exactly what §D8 asks M6 to demonstrate.

(mod server_main)

(import $net/http [Server serve listen ws_accept ws_send ws_close])
(import $os [get_env Env])
(import [Registry registered_count id_of opens_form_of]
        from "../core/registry.gene")
(import [Game] from "../core/api.gene")
(import [TileRegistry] from "../core/tiles.gene")
(import [load_mods_from_disk] from "./mods_runtime.gene")
(import [generate_block] from "../core/mapgen.gene")
(import [World new_world store_block store_light extract_block block_base
         open_sky node_at
         world_dx world_dy world_dz world_stride_z world_nodes
         world_min_x world_min_y world_min_z]
        from "../core/loaded.gene")
(import [WorldStore open_world close_world world_exists? write_meta
         put_block get_block block_count stored_bytes
         begin_batch commit_batch]
        from "./storage.gene")
(import [light_region queue_overhead] from "../core/light.gene")
(import [new_bounds apply_node diggable? placeable?] from "../core/edit.gene")
(import [find_spawn] from "../core/physics.gene")
(import [AbmRegistry abm_count abm_trigger abm_action abm_group abm_interval
         abm_chance abm_due
         set_abm_due queued_count queued_x queued_y queued_z queued_id
         clear_queue sample_index sample_x sample_y sample_z walk_stride
         chance_passes?
         queue_node abm_on_change abm_sampled
         queue_check check_count check_x_at check_y_at check_z_at
         clear_checks]
        from "../core/abm.gene")
(import [GroupRegistry rating_of] from "../core/groups.gene")
(import [ContainerStore new_containers container_at container_row
         container_inventory container_slot_count container_live]
        from "../core/container.gene")
(import [FormRegistry form_named action_element form_count]
        from "../core/formspec.gene")
(import [CraftRegistry first_craftable apply_craft recipe_count recipe_output]
        from "../core/craft.gene")
(import [EntityRegistry entity_slots entity_alive? entity_id entity_item_of
         entity_count entity_x entity_y entity_z spawn_item despawn
         within_pickup? live_entities slot_of_id
         spawn_player entity_is_player? entity_kind entity_player move_entity
         entity_def_step entity_def_of entity_def_activate entity_def_named]
        from "../core/entity.gene")

(import [new_inventory add add_at take slot_item slot_count slot_empty?
         slots_of]
        from "../core/inventory.gene")
(import [drop_item drop_count] from "../core/drops.gene")
(import [ItemRegistry item_node placeable_item? item_of_node item_name]
        from "../core/item.gene")
(import [new_cursor] from "../core/wire.gene")
(import [message_kind msg_input msg_dig msg_place msg_request_blocks msg_craft
         hello_size encode_hello
         registry_size encode_registry
         tiles_size encode_tiles
         items_size encode_items
         size_entity encode_entity
         block_size encode_block
         node_delta_size encode_node_delta
         inventory_size encode_inventory
         forms_size encode_forms
         size_open_form_for encode_open_form
         new_form_action decode_form_action action_of
         act_x act_y act_z act_slot msg_form_action
         decode_craft craft_any
         new_edit decode_edit edit_x edit_y edit_z edit_id
         edit_at_x edit_at_y edit_at_z
         new_input decode_input in_x in_y in_z
         new_request decode_request_blocks req_from req_count]
        from "../core/protocol.gene")

(let seed 1337.0)
(let block_dim 16)
(let block_nodes 4096)

# §D6.1's extent and site, which the client no longer chooses — the server
# tells it in `hello`, because the server is the one that generated it.
(let origin_bx -90)
(let origin_by 0)
(let origin_bz 198)
(let span_x 12)
(let span_y 4)
(let span_z 12)

(let hotbar_slots 8)

(let port 8790)

# §11's world, on disk. `GENE_MICLONE_WORLD` overrides it, which is what makes a
# throwaway world easy to ask for — and M7 will want that constantly, since a
# mod that changes worldgen wants a world it can discard.
(let default_world_root "/tmp/miclone_server_world")

# --- the world ---------------------------------------------------------------

# Load what the store has and generate the rest.
#
# **The distinction that matters is "stored" versus "never generated", not
# "stored" versus "all air".** `get_block` answers `false` only for a block the
# world has never had, which is exactly why §11 made that a separate state: a
# mined-out cave is legitimately mostly air, and a loader that treated air as
# absent would regenerate the stone the player dug out.
#
# Lighting runs over the whole world afterwards either way (§4.2). A stored
# block carries its own light and re-flooding it produces the same values, so
# this costs one pass and removes a class of bug — a world half-lit from disk
# and half-lit from a flood, with a seam where they meet.
(fn build_world [game : Game store : WorldStore fresh : Bool] : World
  (var reg game/nodes)
  (var biomes game/biomes)
  (var ores game/ores)
  (var decors game/decors)
  (var air (id_of reg "air"))
  (var water (id_of reg "miclone:water"))
  (var w (new_world ($to_float origin_bx) ($to_float origin_by)
                    ($to_float origin_bz)
                    ($to_float span_x) ($to_float span_y) ($to_float span_z)))

  (var block ($buffer F32 ($to_float block_nodes)))
  (var light ($buffer F32 ($to_float block_nodes)))
  (var param2 ($buffer F32 ($to_float block_nodes)))
  (var block_sky ($buffer F32 ($to_float (* block_dim block_dim))))
  (var loaded 0)
  (var generated 0)
  (begin_batch store)
  (var cz 0)
  (while (< cz span_z)
    (var cy 0)
    (while (< cy span_y)
      (var cx 0)
      (while (< cx span_x)
        (var ibx (+ origin_bx cx))
        (var iby (+ origin_by cy))
        (var ibz (+ origin_bz cz))
        (var bx ($to_float ibx))
        (var by ($to_float iby))
        (var bz ($to_float ibz))
        (if (&& (! fresh)
                (get_block store reg block_dim ibx iby ibz
                           block light param2))
          (then
            (store_block w bx by bz block)
            (store_light w bx by bz light)
            (set loaded (+ loaded 1)))
          (else
            (generate_block block block_sky
                            (* bx 16.0) (* by 16.0) (* bz 16.0)
                            biomes ores decors seed air water)
            (store_block w bx by bz block)
            (set generated (+ generated 1))))
        (set cx (+ cx 1)))
      (set cy (+ cy 1)))
    (set cz (+ cz 1)))
  (commit_batch store)
  ($println $"  ${loaded} block(s) from disk, ${generated} generated")

  # One flood over the whole loaded world (§4.2), which is what makes light
  # cross block boundaries — and is why the server sends light rather than
  # letting the client derive it (§4).
  (var sky ($buffer F32 (* (world_dx w) (world_dz w))))
  (open_sky w sky)
  (var q ($buffer F32 (+ (world_nodes w) queue_overhead)))
  (light_region w/light w/content (world_dx w) (world_dy w) (world_dz w)
                reg sky q (registered_count reg))
  w)

# --- sending -----------------------------------------------------------------
#
# Every send is `buf/~to_bytes` then `ws_send`. That conversion is the whole
# of the VM's I/O boundary: the codec works over a `(Buffer U8)` because the
# client must run the same code, and `Bytes` is what the socket takes.

(fn send_hello [conn w : World spawn_at : (Buffer F64)] : Nil
  (var c (new_cursor))
  (var b ($buffer U8 hello_size))
  (encode_hello b c seed
                ($to_float origin_bx) ($to_float origin_by)
                ($to_float origin_bz)
                ($to_float span_x) ($to_float span_y) ($to_float span_z)
                (spawn_at ~ get 0.0) (spawn_at ~ get 1.0) (spawn_at ~ get 2.0))
  (ws_send conn b/~to_bytes))

(fn send_registry [conn reg : Registry] : Nil
  (var c (new_cursor))
  (var b ($buffer U8 (registry_size reg)))
  (encode_registry b c reg)
  (ws_send conn b/~to_bytes))

# §9's appearance table. Sent before the registry, because a node's tile columns
# are slots into this and a client that read them first would hold indices into
# an atlas it has not been told how to paint.
(fn send_tiles [conn t : TileRegistry] : Nil
  (var c (new_cursor))
  (var b ($buffer U8 (tiles_size t)))
  (encode_tiles b c t)
  (ws_send conn b/~to_bytes))

# §2's item registry. Sent with the rest of the join, because an inventory
# message is meaningless before it — an item id names nothing until this lands.
(fn send_items [conn r : ItemRegistry] : Nil
  (var c (new_cursor))
  (var b ($buffer U8 (items_size r)))
  (encode_items b c r)
  (ws_send conn b/~to_bytes))

# Returns `ws_send`'s drop count — see `answer_blocks` for why anything reads it.
(fn send_block [conn w : World bx : F64 by : F64 bz : F64] : F64
  (var c (new_cursor))
  (var base (block_base w bx by bz))
  (var dx (world_dx w))
  (var sz (world_stride_z w))
  (var b ($buffer U8 (block_size w/content w/light base dx sz)))
  (encode_block b c bx by bz w/content w/light base dx sz)
  ($to_float (ws_send conn b/~to_bytes)))

(fn send_node_delta [conn nx : F64 ny : F64 nz : F64
                     id : F64 param1 : F64] : Nil
  (var c (new_cursor))
  (var b ($buffer U8 node_delta_size))
  (encode_node_delta b c nx ny nz id param1)
  (ws_send conn b/~to_bytes))

(fn send_inventory [conn inv : (Buffer F64)] : Nil
  (var c (new_cursor))
  (var b ($buffer U8 (inventory_size ($to_float hotbar_slots))))
  (encode_inventory b c inv ($to_float hotbar_slots))
  (ws_send conn b/~to_bytes))

# §13's forms, once on join. The networked client had no form registry at all
# until this — a form was declared by a mod on the server, and `client/main.gene`
# could render it only because in-tab the mod and the client are one process.
(fn send_forms [conn forms : FormRegistry] : Nil
  (var c (new_cursor))
  (var b ($buffer U8 (forms_size forms)))
  (encode_forms b c forms)
  (ws_send conn b/~to_bytes))

# §13's open. The form is a layout the client already has; what travels here is
# *which* form, *which* node, and what is in it.
(fn send_open_form [conn name : Str x : F64 y : F64 z : F64
                    inv : (Buffer F64)] : Nil
  (var c (new_cursor))
  (var b ($buffer U8 (size_open_form_for name)))
  (encode_open_form b c name x y z inv (container_slot_count))
  (ws_send conn b/~to_bytes))

# Answer a client's request for blocks `[from, from + count)` in the linear
# index the client computes from `hello`'s extent.
#
# **The client asks and the server answers; the server does not push.** That is
# not politeness, it is flow control, and skipping it cost a debugging session:
# the WebSocket outbound queue holds 256 frames per connection and `ws_send`
# *drops the oldest* when it overflows. The first version of this file pushed
# all 576 blocks in a loop from `on_open` — 422 of them arrived, `ws_send`
# reported the drops, nothing read the report, and the client got a world with
# holes in it and no error.
#
# So this also **checks what `ws_send` returns**. A drop here means the client
# asked for more than the socket could absorb, which is a bug in the client's
# window rather than a condition to recover from — but it is said rather than
# swallowed, which is the whole lesson of the previous commit.
(fn answer_blocks [conn w : World from : F64 count : F64] : F64
  (var total ($to_float (* span_x (* span_y span_z))))
  (var at from)
  (var last ($math/min total (+ from count)))
  (var dropped 0.0)
  (while (< at last)
    (var cx (- at (* span_x ($math/floor (/ at ($to_float span_x))))))
    (var rest ($math/floor (/ at ($to_float span_x))))
    (var cy (- rest (* span_y ($math/floor (/ rest ($to_float span_y))))))
    (var cz ($math/floor (/ rest ($to_float span_y))))
    (var drops (send_block conn w
                           (+ ($to_float origin_bx) cx)
                           (+ ($to_float origin_by) cy)
                           (+ ($to_float origin_bz) cz)))
    (set dropped (+ dropped drops))
    (set at (+ at 1.0)))
  (if_yes (> dropped 0.0)
    ($println $"  WARN dropped $($to_int dropped) frame(s): the client's request window is larger than the socket can absorb"))
  (- last from))

# Write one block of the loaded world back to the store.
#
# The three scratch buffers are the caller's, for §4's reason: this runs once
# per edit and allocating 48 KB inside a click handler is the thing a hot path
# must not do.
#
# `param2` is written as zeros because `core/loaded.gene` does not carry one —
# §1 gives a node three fields and the loaded world keeps two, since nothing in
# M0–M6 uses `param2` (it is facedir, liquid level, colour index; all of them
# arrive with M8's drawtypes). The column exists on disk so that adding it later
# is a format that already has room rather than a version bump.
(fn persist_block [store : WorldStore reg : Registry w : World
                   bx : Int by : Int bz : Int
                   content : (Buffer F32) light : (Buffer F32)
                   param2 : (Buffer F32)] : Nil
  (extract_block w ($to_float bx) ($to_float by) ($to_float bz)
                 content w/content)
  (extract_block w ($to_float bx) ($to_float by) ($to_float bz)
                 light w/light)
  (put_block store reg block_dim bx by bz content light param2))

# Which block a node belongs to. `$math/floor` rather than a shift, for the
# reason `core/world.gene` gives: the coordinates are `F64` and negative
# division truncates toward zero, which would fold blocks -1 and 0 together.
(fn block_of [n : F64] : Int
  ($to_int ($math/floor (/ n 16.0))))

# §8's entities on the wire. One message covers add, move and remove — a count
# of 0 is the removal, which is why "gone" cannot be missed by dropping a
# second message kind.
(fn send_entity [conn e : EntityRegistry slot : F64 gone : Bool] : Nil
  (var c (new_cursor))
  (var b ($buffer U8 (size_entity)))
  (encode_entity b c (entity_id e slot)
                 (entity_x e slot) (entity_y e slot) (entity_z e slot)
                 (entity_item_of e slot)
                 (if gone 0.0 (entity_count e slot))
                 (entity_kind e slot))
  (ws_send conn b/~to_bytes))

# Everyone except the player this entity **is**.
#
# A dropped stack has no owner, so `connection_slots` holds its slot nowhere and
# nothing is skipped — which is what the old unconditional version got right and
# is why it looked correct. A *player* entity has exactly one owner, and sending
# it back is the thing the note above `broadcast_entity_except` forbids: "a
# player already knows where they are standing, and sending them their own
# avatar would put a cube in front of their own camera."
#
# The input path had that rule and the **tick** did not, so the bug needed the
# server to move you rather than you moving yourself — gravity, after a flight
# or a fall down a shaft. Then the avatar arrived, and it followed the camera
# forever because it was the camera. Skipping by *slot* rather than by
# connection id is what lets one function serve both kinds of entity.
(fn broadcast_entity [e : EntityRegistry slot : F64 gone : Bool] : Nil
  (var c 0.0)
  (var n connections/~size)
  (while (< c n)
    (if_yes (!= connection_slots/%c slot)
      (var conn connections/%c)
      (send_entity conn e slot gone))
    (set c (+ c 1.0))))

# --- the tick ----------------------------------------------------------------
#
# §12's fixed-step server loop, and §12.1 said what would bring it: "the first
# thing that changes without being asked". That is M8's falling sand, and the
# loop arrived with it rather than ahead of it.
#
# It runs on `serve`'s `^on_tick`, which the event loop already had a place for
# — it sleeps only as long as nothing needs it, so a tick is one more deadline
# to clamp against rather than a thread. §D7.16 records the hook.
#
# **Sampled, not exhaustive** (§12). Each pass looks at `samples_per_pass`
# positions out of 2.4M; an ABM fires where its group matches and its chance
# passes. A player watching sand fall cannot tell that the engine did not check
# every grain, and an exhaustive pass at this extent would be 12M node reads a
# second before any ABM did anything.

(let tick_ms 100)
(let samples_per_pass 900)

# Every *live* connection, so a change nobody asked for can reach everybody.
# §12.1 named this as the one shape the tick would have to change: per-connection
# state was a closure, and a closure cannot be iterated.
#
# **The list has to shrink, and until now it only grew.** M8.1 pushed on
# `^on_open` and had no `^on_close` at all, which looked harmless — a dead entry
# should just be a send that goes nowhere. It is not harmless, because the HTTP
# server **recycles connection handles**: a stale entry comes back aliasing the
# next client's live socket, so a server that has served N clients sends every
# world change N times to whoever is connected. Measured on a fresh server:
# first client 2 conversions/2 deltas, second client 3 conversions/6 deltas,
# identical timestamps within each group. It went a milestone unseen because a
# broadcast only ever happened during a falling cascade, moments after the dig
# that caused it, in the same session that dug — one connection, one copy.
#
# The identity is a number this file assigns rather than the handle itself:
# handles are opaque and recycled, which is the very property that caused the
# bug, so comparing them is the one thing that cannot be the fix.
(var connections : (List Any) [])
(var connection_ids : (List F64) [])
# The player entity slot each connection *is*, parallel to the two lists above
# and `-1` until the handshake spawns it. Without it `broadcast_entity` cannot
# tell "this entity moved" from "you moved", and a client that the tick moved —
# anyone who fell — was sent its own avatar and drew a cube on its own camera.
(var connection_slots : (List F64) [])
(var next_connection_id ($cell 0.0))

(fn add_connection [conn id : F64] : Nil
  (connections ~ push conn)
  (connection_ids ~ push id)
  (connection_slots ~ push -1.0))

# Record which player entity a connection owns. Rebuilds rather than assigns in
# place, for the same reason `drop_connection` does.
(fn own_slot [id : F64 slot : F64] : Nil
  (var keep : (List F64) [])
  (var i 0.0)
  (var n connection_ids/~size)
  (while (< i n)
    (keep ~ push (if (== connection_ids/%i id) slot connection_slots/%i))
    (set i (+ i 1.0)))
  (set connection_slots keep))

(fn drop_connection [id : F64] : Nil
  (var keep_conns : (List Any) [])
  (var keep_ids : (List F64) [])
  (var keep_slots : (List F64) [])
  (var i 0.0)
  (var n connection_ids/~size)
  (while (< i n)
    (if_yes (!= connection_ids/%i id)
      (keep_conns ~ push connections/%i)
      (keep_ids ~ push connection_ids/%i)
      (keep_slots ~ push connection_slots/%i))
    (set i (+ i 1.0)))
  (set connections keep_conns)
  (set connection_ids keep_ids)
  (set connection_slots keep_slots))

# Everyone but one connection. §8's players need it and dropped items do not: a
# player already knows where they are standing, and sending them their own
# avatar would put a cube in front of their own camera.
(fn broadcast_entity_except [e : EntityRegistry slot : F64 gone : Bool
                             skip : F64] : Nil
  (var c 0.0)
  (var n connections/~size)
  (while (< c n)
    (if_yes (!= connection_ids/%c skip)
      (var conn connections/%c)
      (send_entity conn e slot gone))
    (set c (+ c 1.0))))

# Every player entity that already exists, sent to a client that just joined.
# Without this a second player sees the first only once the first *moves* —
# which looks like an empty world for as long as nobody walks.
(fn send_existing_players [conn e : EntityRegistry skip : F64] : Nil
  (var i 0.0)
  (var slots (entity_slots e))
  (while (< i slots)
    (if_yes (&& (entity_alive? e i) (entity_is_player? e i))
      (if_yes (!= (entity_id e i) skip)
        (send_entity conn e i false)))
    (set i (+ i 1.0))))


# Seed the check queue around a position that just changed. The node above is
# what matters for falling and is why this is not the six neighbours: a node
# below a change cannot start falling because of it, and the four sides only
# matter for behaviours that do not exist yet.
(fn note_change [game : Game x : F64 y : F64 z : F64] : Nil
  (queue_check game/abms x (+ y 1.0) z))

(fn run_abms [game : Game world : World now : F64 step : F64
              sky : (Buffer F32) lq : (Buffer F32) lq_seed : (Buffer F32)
              bounds : (Buffer F64)] : F64
  (var abms game/abms)
  (var groups game/groups)
  (var n (abm_count abms))
  (var applied 0.0)

  # --- the check queue: where something just happened ------------------------
  #
  # Drained every tick, and a node that moves seeds the position above it, so a
  # column falls one node per tick from the bottom up rather than settling one
  # node per minute (see `core/abm.gene` for the measurement that forced this).
  #
  # What fires here is the mod's `^action`. The engine's share is the match —
  # this position, this group — and everything past that is the mod's, which is
  # §9's shape and what `^kind` stood in for until §D7.17 was measured.
  (var checks (check_count abms))
  (var i 0.0)
  (while (< i checks)
    (var cx (check_x_at abms i))
    (var cy (check_y_at abms i))
    (var cz (check_z_at abms i))
    (var here (node_at world cx cy cz))
    (var a 0.0)
    (while (< a n)
      (if_yes (&& (== (abm_trigger abms a) abm_on_change)
                  (> (rating_of groups here (abm_group abms a)) 0.0))
        (var act (abm_action abms a))
        (act world cx cy cz here))
      (set a (+ a 1.0)))
    (set i (+ i 1.0)))
  (clear_checks abms)

  # --- sampling: where nothing did -------------------------------------------
  #
  # §12's ambient half, and it runs a mod's action now rather than stopping at
  # the match. Until the actions landed this loop ended in a literal `void` —
  # the arithmetic ran, the group was tested, and nothing could happen at the
  # end of it, so the path had never once fired. `mods/default` registers a
  # grass ABM here, which is what makes this tested rather than merely present.
  # `- 2.0` on each axis drops the one-node shell `core/loaded.gene` keeps
  # outside the world; what is left is the node extent the walk permutes.
  (var nx (- (world_dx world) 2.0))
  (var ny (- (world_dy world) 2.0))
  (var nz (- (world_dz world) 2.0))
  (var total (* nx (* ny nz)))
  (var stride (walk_stride total))
  (var a2 0.0)
  (while (< a2 n)
    (if_yes (&& (== (abm_trigger abms a2) abm_sampled) (>= now (abm_due abms a2)))
      (set_abm_due abms a2 (+ now (abm_interval abms a2)))
      (var act2 (abm_action abms a2))
      (var s 0.0)
      (while (< s ($to_float samples_per_pass))
        (var t (+ step s))
        (if_yes (chance_passes? t (abm_chance abms a2))
          (var idx (sample_index t total stride))
          (var px (+ (world_min_x world) (sample_x idx nx)))
          (var py (+ (world_min_y world) (sample_y idx nx ny)))
          (var pz (+ (world_min_z world) (sample_z idx nx ny)))
          (var at (node_at world px py pz))
          (if_yes (> (rating_of groups at (abm_group abms a2)) 0.0)
            (act2 world px py pz at)))
        (set s (+ s 1.0))))
    (set a2 (+ a2 1.0)))

  # --- drain -----------------------------------------------------------------
  #
  # Through §7.1's own edit path, so the light is recomputed exactly as a
  # player's dig would leave it and the delta reaches every client by the route
  # that already works.
  (var q (queued_count abms))
  (var j 0.0)
  (while (< j q)
    (var qx (queued_x abms j))
    (var qy (queued_y abms j))
    (var qz (queued_z abms j))
    (var qid (queued_id abms j))
    (if_yes (!= (node_at world qx qy qz) qid)
      (apply_node world game/nodes qx qy qz qid sky lq lq_seed bounds)
      (var light (world/light ~ get (block_index_of world qx qy qz)))
      (var c 0.0)
      (var cn connections/~size)
      (while (< c cn)
        (var conn connections/%c)
        (send_node_delta conn qx qy qz qid light)
        (set c (+ c 1.0)))
      # What just moved may free the node above it. This is the cascade.
      (queue_check abms qx (+ qy 1.0) qz)
      (set applied (+ applied 1.0)))
    (set j (+ j 1.0)))
  (clear_queue abms)
  applied)

# §8's `on_step`, once a tick per live entity, and the mod's function is what
# runs. The engine's share is three things the mod cannot do for itself: find
# the live slots, notice that a step moved or ended one, and tell the clients.
#
# **The position is read before and compared after** rather than the step being
# asked to report what it did. A callback that has to remember to announce its
# own changes is a callback that will forget, and the comparison costs three
# `F64` reads against a step that already touched the world.
#
# A step that despawns its own entity gets one last `gone` broadcast, because
# the client is tracking it and nothing else would ever say otherwise.
(fn step_entities [game : Game world : World dt : F64] : F64
  (var e game/entities)
  (var slots (entity_slots e))
  (var stepped 0.0)
  (var i 0.0)
  (while (< i slots)
    (if_yes (entity_alive? e i)
      (var bx (entity_x e i))
      (var by (entity_y e i))
      (var bz (entity_z e i))
      (var f (entity_def_step e (entity_def_of e i)))
      (f world i dt)
      (if (! (entity_alive? e i))
        (then (broadcast_entity e i true))
        (else
          (if_yes (|| (!= (entity_x e i) bx)
                      (|| (!= (entity_y e i) by) (!= (entity_z e i) bz)))
            (broadcast_entity e i false)
            (set stepped (+ stepped 1.0))))))
    (set i (+ i 1.0)))
  stepped)

# What a chest's buttons mean. **The engine does not read an action string; this
# does** — `take_3` is opaque to everything above, and a mod that wanted
# `slot-3-take` would need no engine change to have it (§13).
#
# Answers whether anything moved, so the caller sends a refreshed inventory only
# when there is something new to say.
# **Matched by construction rather than parsed.** The action names are built the
# same way the mod built them — `take_0`, `take_1`, … — and compared. Eight
# string equalities per press is nothing beside the message that carried it, and
# it avoids a parse: the stdlib has `split` and `starts_with?` and no
# string-to-number, so parsing here would be hand-rolled digit arithmetic for a
# value the loop already has.
(fn chest_slot_of [action : Str prefix : Str] : F64
  (var found -1.0)
  (var i 0.0)
  (while (< i (container_slot_count))
    (if_yes (== action $"${prefix}$($to_int i)")
      (set found i))
    (set i (+ i 1.0)))
  found)

# What a crafting button means. **The engine does not read an action string;
# this does** — the same line `chest_action` sits on, for the same reason.
#
# `make_<item name>` is resolved by *building* the expected string for every
# recipe and comparing, exactly as `chest_slot_of` does. That avoids a parse the
# stdlib cannot do cleanly — an item name may itself contain `_`, so splitting
# on it turns `make_miclone:wood_pickaxe` into three pieces — and it means a
# recipe is found by what it *makes* rather than by an index the client sent.
(fn recipe_making [crafts : CraftRegistry items : ItemRegistry
                   action : Str] : F64
  (var found -1.0)
  (var i 0.0)
  (var n (recipe_count crafts))
  (while (< i n)
    (if_yes (== action $"make_$(item_name items (recipe_output crafts i))")
      (set found i))
    (set i (+ i 1.0)))
  found)

(fn chest_action [items : ItemRegistry inv : (Buffer F64) box : (Buffer F64)
                  action : Str] : Bool
  # **`take_slot`, not `take`** — `take` is `core/inventory.gene`'s function and
  # a local of that name shadows it, so the call below became "call this number"
  # and the whole handler threw. It threw into the log rather than the client,
  # which is why it read as a chest that quietly refused rather than as a bug.
  (var take_slot (chest_slot_of action "take_"))
  (if_yes (>= take_slot 0.0)
    (var item (slot_item box take_slot))
    (var count (slot_count box take_slot))
    (if (<= count 0.0) (return false)
      (do
        # `add` answers what did *not* fit, so what moved is the difference —
        # and a chest slot that would overflow the hotbar keeps its remainder
        # rather than the stack vanishing (§7.1's conservation rule).
        (var left (add inv items item count))
        (take box take_slot (- count left))
        (return (< left count)))))
  (var put_slot (chest_slot_of action "put_"))
  (if_yes (>= put_slot 0.0)
    # The player's *first* non-empty slot, which is what "put" means without a
    # selected-slot field on the message. A selection is client state and §7.1
    # keeps client state off the server; sending it would be a fourth thing to
    # not trust.
    (var from (first_filled inv))
    (if (< from 0.0) (return false)
      (do
        (var item (slot_item inv from))
        (var count (slot_count inv from))
        (var left (add_at box items put_slot item count))
        (take inv from (- count left))
        (return (< left count)))))
  false)

(fn first_filled [inv : (Buffer F64)] : F64
  (var found -1.0)
  (var i 0.0)
  (var n (slots_of inv))
  (while (< i n)
    (if_yes (&& (== found -1.0) (! (slot_empty? inv i)))
      (set found i))
    (set i (+ i 1.0)))
  found)

# --- serving -----------------------------------------------------------------

(fn main [args] : Nil
  # §9's game. Every id below is one a mod caused to exist.
  #
  # **Read off disk and sandboxed**, not compiled in — `load_mods_from_disk`
  # rather than `core/mods.gene`'s `load_mods`. The two produce the identical
  # game and `probes/run_loader.gene` is what checks that, node for node and id
  # for id. The difference is the one §D5 exists for: this way `mods/default`
  # gets exactly the authorities its manifest declares, and today that is none.
  # A boundary nothing loads through protects nothing.
  #
  # The in-tab client keeps `load_mods`, and must: the web profile has no runtime
  # module loading, which is the whole reason §9.3 puts mods on the server and
  # hands a client data.
  #
  # One new failure mode, stated rather than discovered: the server now needs
  # `mods/` present under its package root at startup and stops if it is missing.
  (var game (load_mods_from_disk))
  (var reg game/nodes)
  (var drops game/drops)
  (var items game/items)
  (var air (id_of reg "air"))

  # What a player is drawn as. §8.3's path is item -> node -> tile, so this is
  # the item for the mod's player node — and it is a lookup rather than a
  # constant because §2's rule holds here too: a mod names content and the
  # engine numbers it.
  (var player_visual (item_of_node items (id_of reg "miclone:player")))

  (var root (get_env Env "GENE_MICLONE_WORLD" default_world_root))
  (var fresh (! (world_exists? root)))
  (var store (open_world root))
  (if fresh
    (then
      (write_meta store seed "miclone")
      ($println $"miclone server: new world at ${root}"))
    (else ($println $"miclone server: opening ${root}")))

  (var t0 ($os/monotonic_ms))
  (var world (build_world game store fresh))
  (var spawn_at ($buffer F64 3.0))
    # The scan lives in `core/physics.gene` — it has been got wrong twice, and
  # one definition is the fix. The server owns the *result*: it goes out in
  # `hello`, because the server is the process that generated the world.
  (find_spawn world reg
              (* ($to_float (+ origin_bx (/ span_x 2))) 16.0)
              (* ($to_float (+ origin_bz (/ span_z 2))) 16.0)
              (* ($to_float (+ origin_by span_y)) 16.0)
              96.0 spawn_at)
  # A world generated for the first time is written whole, so the next start
  # loads it. An existing one is already on disk and only its edits are written.
  (if_yes fresh
    (var scratch ($buffer F32 ($to_float block_nodes)))
    (var scratch_l ($buffer F32 ($to_float block_nodes)))
    (var scratch_p2 ($buffer F32 ($to_float block_nodes)))
    (begin_batch store)
    (var sz 0)
    (while (< sz span_z)
      (var sy 0)
      (while (< sy span_y)
        (var sx 0)
        (while (< sx span_x)
          (persist_block store reg world (+ origin_bx sx) (+ origin_by sy)
                         (+ origin_bz sz) scratch scratch_l scratch_p2)
          (set sx (+ sx 1)))
        (set sy (+ sy 1)))
      (set sz (+ sz 1)))
    (commit_batch store)
    ($println $"  saved $(block_count store) blocks, $(stored_bytes store) bytes"))

  ($println $"  ready in $(- ($os/monotonic_ms) t0) ms; spawn at $(spawn_at ~ get 0.0), $(spawn_at ~ get 1.0), $(spawn_at ~ get 2.0)")

  # §4's scratch, allocated once for the process rather than per edit: the
  # queues are 10 MB at this extent and an edit happens inside a click.
  (var sky ($buffer F32 (* (world_dx world) (world_dz world))))
  (open_sky world sky)
  (var lq ($buffer F32 (+ (world_nodes world) queue_overhead)))
  (var lq_seed ($buffer F32 (+ (world_nodes world) queue_overhead)))
  (var bounds (new_bounds))
  (var edit (new_edit))
  (var input (new_input))
  # Scratch for writing an edited block back to disk — allocated here for the
  # same reason the light queues are: an edit happens inside a click.
  (var save_c ($buffer F32 ($to_float block_nodes)))
  (var save_l ($buffer F32 ($to_float block_nodes)))
  (var save_p2 ($buffer F32 ($to_float block_nodes)))

  ($println $"miclone server: listening on ${port}")
  # §12's loop. `step` advances every tick and is what the ABM sampler walks,
  # so the positions looked at differ from one tick to the next.
  (var step ($cell 0.0))
  (serve (listen ^host "127.0.0.1" ^port port)
    ^tick_ms tick_ms
    ^on_tick (fn []
      (step ~ set (+ (step ~ get) ($to_float samples_per_pass)))
      (run_abms game world ($to_float ($os/monotonic_ms)) (step ~ get)
                sky lq lq_seed bounds)
      # §8's entities, after the nodes. The order matters and it is one line of
      # reasoning: an ABM may have dug the node an item was resting on, and an
      # item that falls in the same tick looks like gravity rather than like a
      # frame of delay.
      (step_entities game world (/ ($to_float tick_ms) 1000.0)))
    (fn [req]
      # Per-connection state. A closure over these is what makes each client
      # its own player without a table keyed by connection — and §12's tick is
      # what forced a second, enumerable list beside it: a change nobody asked
      # for has to reach everybody, and a closure cannot be iterated (§12.1).
      (var inv (new_inventory ($to_float hotbar_slots)))
      # §13's "a server that can attribute a press to a form it opened". This
      # is that, and it is per connection because a form is open for a *player*:
      # two clients may have the same chest open and each press is the presser's.
      # `open_form_at` is the node, and -1 in the first cell means nothing open —
      # so a press that names a form this player never opened is refused, which
      # is §7.1's rule reaching UI.
      (var open_at ($buffer F64 3.0))
      # **Nothing open is the empty *name*, not a sentinel coordinate.** The
      # first version used -1 in `open_at`'s x cell, which reads as "closed" for
      # every chest west of the origin — and §D6.1's world sits at x = -1437, so
      # it read as closed for every chest that exists. A position has no value
      # outside its own range to spare; a name does.
      (var open_name ($cell ""))
      # §8's refactor: this connection's player, as an entity in the same table
      # as a dropped cobble. `-1` until the handshake spawns it — a *slot*, not
      # an id, because every accessor here takes a slot and a player's slot is
      # stable for as long as the connection is.
      (var my_slot ($cell -1.0))
      # This connection's name for itself, taken before the handshake so that
      # `^on_open` and `^on_close` close over the same one. It is what
      # `drop_connection` matches on — see the note beside `connections` for why
      # it cannot be the handle.
      (var my_id (next_connection_id ~ get))
      (next_connection_id ~ set (+ my_id 1.0))
      (ws_accept req
        ^on_open (fn [conn]
          # Handshake only. The terrain follows when the client asks for it,
          # which is what keeps the 256-frame queue from overflowing.
          (send_hello conn world spawn_at)
          (send_tiles conn game/tiles)
          (send_items conn game/items)
          (send_registry conn reg)
          (send_forms conn game/forms)
          (send_inventory conn inv)
          (add_connection conn my_id)
          # The player, as an entity. Spawned *after* `add_connection` so the
          # broadcast below reaches the others and not a list this client is
          # missing from — and the new client is told about everyone already
          # here, because otherwise a second player sees the first only once the
          # first happens to move.
          (var pid (spawn_player game/entities player_visual
                                 (spawn_at ~ get 0.0) (spawn_at ~ get 1.0)
                                 (spawn_at ~ get 2.0)))
          (if_yes (>= pid 0.0)
            (var slot (slot_of_id game/entities pid))
            (my_slot ~ set slot)
            # Before any broadcast: from here on the tick may move this player,
            # and `broadcast_entity` needs to know whose avatar it is.
            (own_slot my_id slot)
            (send_existing_players conn game/entities pid)
            (broadcast_entity_except game/entities slot false my_id))
          ($println "  client joined"))

        ^on_close (fn [conn]
          # The avatar goes with the connection. A count of 0 is the removal
          # (§10), and without it a disconnected player stands in the world
          # forever — the thing §8 said entities were for, failing in the other
          # direction.
          (var slot (my_slot ~ get))
          (if_yes (>= slot 0.0)
            (broadcast_entity_except game/entities slot true my_id)
            (despawn game/entities slot)
            (my_slot ~ set -1.0))
          (drop_connection my_id)
          ($println "  client left"))

        ^on_message (fn [conn payload]
          # `payload` is `Bytes` for a binary frame (the previous commit's
          # work); back into a `(Buffer U8)` so the portable codec can read it.
          (var b ($binary/to_buffer payload))
          (var c (new_cursor))
          # **A message shorter than its kind byte is dropped, not decoded.**
          # A server takes bytes from the network and a peer is entitled to send
          # anything; without this an empty frame reads `undefined` for the kind
          # and every comparison below is against Void. That is not theoretical
          # — a probe with a miscomputed buffer size sent exactly this, and the
          # handler threw once per message.
          (if_yes (>= ($binary/size payload) 1)
          (var kind (message_kind b))

          # §9's crafting, and §7.1's authority: the client asks, the server
          # decides what it can make and whether it fits.
          (if_yes (== kind msg_craft)
            (var asked (decode_craft b c))
            # `craft_any` keeps the old behaviour — the crafting key still means
            # "make whatever I can" — and a named recipe is checked rather than
            # searched. Either way `apply_craft` is what decides: a client that
            # names a recipe it cannot afford gets no inventory message, which
            # is the same answer it got for naming nothing it could afford.
            (var recipe (if (== asked (craft_any))
                          (first_craftable game/crafts inv)
                          (if (< asked (recipe_count game/crafts)) asked -1.0)))
            (if_yes (>= recipe 0.0)
              (if_yes (apply_craft game/crafts items inv recipe)
                (send_inventory conn inv))))

          # §13's input, and the sentence §13.3 said it needed: "a server that
          # can attribute a press to a form it opened".
          #
          # **Four things are checked and none of them is trusted from the
          # message.** §7.1's rule is that a client reports and a server
          # decides, and a button is a client saying "I pressed this" — which is
          # exactly the shape of a client saying "I dug this".
          #
          #   1. This player has a form open at all.
          #   2. It is the form the message names, at the node it names.
          #   3. That form *declares* this action (`action_element`), so an
          #      action nobody wrote resolves to nothing rather than to whatever
          #      the mod's string parsing makes of it.
          #   4. The slot is inside the container.
          #
          # What the action *means* is still the mod's: the engine hands the
          # string to `chest_action` and reads none of it.
          (if_yes (== kind msg_form_action)
            (var act (new_form_action))
            (var form_name (decode_form_action b c act))
            (var action (action_of b c))
            (var ax (act ~ get act_x))
            (var ay (act ~ get act_y))
            (var az (act ~ get act_z))
            (var same_form (&& (!= (open_name ~ get) "")
                               (== (open_name ~ get) form_name)))
            (var open_here (&& (== (open_at ~ get 0.0) ax)
                               (&& (== (open_at ~ get 1.0) ay)
                                   (== (open_at ~ get 2.0) az))))
            (var form_id (form_named game/forms form_name))
            # **A form that declares this action.** That check is shared; what
            # differs below is whether the form is somewhere.
            (if_yes (&& (>= form_id 0.0)
                        (>= (action_element game/forms form_id action) 0.0))
              # **`container_row`, not `container_at`.** `container_at` is an
              # *ensure* — it allocates a row when there is none — so asking it
              # "is this a container?" both answers yes always and mints a chest
              # at whatever coordinate was asked about. The crafting panel sends
              # (0,0,0), so this branch silently created a container at the
              # origin and then refused the craft. A question and a command
              # spelled the same way.
              (var row (container_row game/containers ax ay az))
              (if (>= row 0.0)
                (then
                  # A container is a *place*, so all four of §13's checks apply:
                  # this player has something open, it is this form, at this
                  # node, and the form declares the action.
                  (if_yes (&& open_here same_form)
                    (var box (container_inventory game/containers row))
                    (if_yes (chest_action items inv box action)
                      (send_inventory conn inv)
                      (send_open_form conn form_name ax ay az box))))
                (else
                  # A form with no container is a *panel*, and a panel is not
                  # anywhere — the crafting list is opened by a key, not by
                  # standing at a node, so "you have this open at this place" is
                  # not a question that has an answer. What is left is the whole
                  # of the authority that matters: the form declares the action,
                  # and `apply_craft` refuses a recipe the inventory cannot pay
                  # for. That is exactly what `msg_craft` already enforced, so
                  # nothing is trusted here that was not trusted before.
                  (var recipe (recipe_making game/crafts items action))
                  (if_yes (>= recipe 0.0)
                    (if_yes (apply_craft game/crafts items inv recipe)
                      (send_inventory conn inv)))))))

          (if_yes (== kind msg_request_blocks)
            (var req (new_request))
            (decode_request_blocks b c req)
            (answer_blocks conn world (req ~ get req_from)
                           (req ~ get req_count)))

          # §7.1's authority. The client has already applied the edit
          # optimistically and predicted nothing about the drop; what goes back
          # is the node delta that either agrees — and is retired silently — or
          # does not, and wins.
          (if (== kind msg_dig)
            (then
              (decode_edit b c edit)
              (var nx (edit ~ get edit_x))
              (var ny (edit ~ get edit_y))
              (var nz (edit ~ get edit_z))
              (if_yes (diggable? world reg nx ny nz)
                (var was (node_at world nx ny nz))
                (apply_node world reg nx ny nz air sky lq lq_seed bounds)
                # The drop is the server's alone (§2, §7.1 step 3).
                (var yield_n (drop_count drops items was))
                (if_yes (> yield_n 0.0)
                  (var yielded (drop_item drops items was))
                  # §8's first payoff. §7.1 has said since M5 that "what is
                  # dropped and does not fit is lost"; it is not lost now — the
                  # remainder becomes an entity at the node that was dug, which
                  # is where a player would look for it.
                  (var left (add inv items yielded yield_n))
                  (if_yes (> left 0.0)
                    (var spawned (spawn_item game/entities yielded left
                                             (+ nx 0.5) (+ ny 0.5) (+ nz 0.5)))
                    (if_yes (>= spawned 0.0)
                      (var slot (slot_of_id game/entities spawned))
                      # §8's `on_activate`, before anyone is told the entity
                      # exists — so a definition that repositions its own spawn
                      # does it once rather than as a visible correction.
                      (var born (entity_def_activate game/entities
                                  (entity_def_of game/entities slot)))
                      (born world slot)
                      (broadcast_entity game/entities slot false)))
                  (send_inventory conn inv))
                (send_node_delta conn nx ny nz air
                                 (world/light ~ get
                                   (block_index_of world nx ny nz)))
                # §12: whatever was resting on it may now fall.
                (note_change game nx ny nz)
                # §11's promise — "quit and come back to the same world" — is
                # only true if an edit reaches the disk. One block per edit:
                # the *lighting* an edit changes can reach far (§7.1), but the
                # node itself is in one block, and a neighbour whose light
                # changed will be re-flooded from its own nodes on the next
                # load (§4.2 lights the whole world in one pass).
                (persist_block store reg world
                               (block_of nx) (block_of ny) (block_of nz)
                               save_c save_l save_p2)))

            (else
              (if (== kind msg_place)
                (then
                  (decode_edit b c edit)
                  (var nx (edit ~ get edit_x))
                  (var ny (edit ~ get edit_y))
                  (var nz (edit ~ get edit_z))
                  # An *item* id now (§2). The server resolves it to a node,
                  # which is also the check that a client cannot place a
                  # pickaxe: an item with no node is refused here rather than
                  # trusted.
                  (var held (edit ~ get edit_id))
                  # §13's chest, and the first time a right-click means
                  # something other than "place". The node the ray hit travels
                  # beside the placement position (§10's `place_size` says why),
                  # so the server can ask what was *aimed at* rather than where
                  # a block would go — for a chest those are different nodes and
                  # only the pointed one identifies the container.
                  #
                  # **Opening wins over placing.** Right-clicking a chest with a
                  # block in hand opens the chest, which is upstream's rule and
                  # the one a player expects; placing against a chest means
                  # aiming at something else.
                  (var ax (edit ~ get edit_at_x))
                  (var ay (edit ~ get edit_at_y))
                  (var az (edit ~ get edit_at_z))
                  (var aimed (node_at world ax ay az))
                  (var opens (opens_form_of reg aimed))
                  (if_yes (!= opens "")
                    (var row (container_at game/containers ax ay az))
                    (if_yes (>= row 0.0)
                      (open_at ~ set 0.0 ax)
                      (open_at ~ set 1.0 ay)
                      (open_at ~ set 2.0 az)
                      (open_name ~ set opens)
                      (send_open_form conn opens ax ay az
                                      (container_inventory game/containers row))))
                  # The client says what it is holding and the server checks it
                  # actually holds it — a client that lies about its inventory
                  # is the one thing a client must not be believed about.
                  (var slot (if (!= opens "") -1.0 (find_slot inv held)))
                  (var as_node (if (placeable_item? items held)
                                 (item_node items held) -1.0))
                  (if_yes (&& (>= slot 0.0)
                              (&& (>= as_node 0.0)
                                  (placeable? world reg nx ny nz)))
                    (take inv slot 1.0)
                    (apply_node world reg nx ny nz as_node sky lq lq_seed bounds)
                    (send_inventory conn inv)
                    (send_node_delta conn nx ny nz as_node
                                     (world/light ~ get
                                       (block_index_of world nx ny nz)))
                    (persist_block store reg world
                                   (block_of nx) (block_of ny) (block_of nz)
                                   save_c save_l save_p2)))

                # §10's input message, and M8 is where it stops being decoded
                # and dropped. §8's pickup needs to know where a player is
                # standing, and this server holds no position of its own —
                # so the position in this message is the one it uses, and a
                # client that lies about it can only reach items it could have
                # walked to anyway.
                (else
                  (if_yes (== kind msg_input)
                    (decode_input b c input)
                    (var px (input ~ get in_x))
                    (var py (input ~ get in_y))
                    (var pz (input ~ get in_z))
                    # §8's player, moved. The position already travelled in this
                    # message for §8's pickup (§8.1) — it is the same trust
                    # decision and now it has a second use, which is what makes
                    # a player visible to another player at all.
                    (var mine (my_slot ~ get))
                    (if_yes (>= mine 0.0)
                      (var was_x (entity_x game/entities mine))
                      (var was_y (entity_y game/entities mine))
                      (var was_z (entity_z game/entities mine))
                      (move_entity game/entities mine px py pz)
                      # Only when it actually moved. At one input a second a
                      # still player would otherwise be a message a second per
                      # player per player.
                      #
                      # **All three axes.** This compared x and z only, so a
                      # player flying or jumping straight up did not move as far
                      # as anyone else was told; their altitude reached other
                      # clients only as a side effect of the tick's gravity
                      # broadcasts. Rising is moving.
                      (if_yes (|| (!= was_x px)
                                  (|| (!= was_y py) (!= was_z pz)))
                        (broadcast_entity_except game/entities mine false my_id)))
                    (var slots (entity_slots game/entities))
                    (var i 0.0)
                    (while (< i slots)
                      (if_yes (&& (! (entity_is_player? game/entities i))
                                  (&& (entity_alive? game/entities i)
                                      (within_pickup? game/entities i px py pz)))
                        (var it (entity_item_of game/entities i))
                        (var n (entity_count game/entities i))
                        (var left (add inv items it n))
                        (if_yes (< left n)
                          # Some of it fit. What did not stays on the ground as
                          # a smaller stack rather than vanishing — the same
                          # rule the dig above follows.
                          (if (== left 0.0)
                            (then
                              (broadcast_entity game/entities i true)
                              (despawn game/entities i))
                            (else
                              (game/entities/count ~ set i left)
                              (broadcast_entity game/entities i false)))
                          (send_inventory conn inv)))
                      (set i (+ i 1.0)))))))))))))
  ($println "miclone server: stopped"))

# The world array index of a node, so a delta can carry the light the relight
# just wrote. `core/loaded.gene` exports the pieces; this is the one place the
# server needs the composed index.
(fn block_index_of [w : World nx : F64 ny : F64 nz : F64] : F64
  (+ (+ (- nx (* ($to_float origin_bx) 16.0)) 1.0)
     (+ (* (+ (- ny (* ($to_float origin_by) 16.0)) 1.0) (world_dx w))
        (* (+ (- nz (* ($to_float origin_bz) 16.0)) 1.0)
           (world_stride_z w)))))

(fn find_slot [inv : (Buffer F64) item : F64] : F64
  (var found -1.0)
  (var i 0.0)
  (while (< i ($to_float hotbar_slots))
    (if_yes (&& (== found -1.0)
                (&& (== (slot_item inv i) item) (> (slot_count inv i) 0.0)))
      (set found i))
    (set i (+ i 1.0)))
  found)
