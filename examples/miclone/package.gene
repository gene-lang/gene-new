{
  ^format 1
  ^name "gene/miclone"
  ^description "A voxel game engine with Luanti's architecture, written in Gene"
  ^version "0.1.0"
  ^library {^entry "core/world.gene"}
  ^applications [
    # design.md §D6 — the three M0 probes. Each one is allowed to kill or
    # reshape the design, so each is its own runnable target.
    (application "divergence" ^entry "probes/run_divergence.gene")
    (application "worldgen" ^entry "probes/run_worldgen.gene")
    (application "world_spec" ^entry "probes/run_world_spec.gene")
    # design.md §14 layers 2 and 3 for M2's mapgen pipeline.
    (application "mapgen_spec" ^entry "probes/run_mapgen_spec.gene")
    # design.md §4 — lighting, with the hand-derived fixture worlds §4 asks for.
    (application "light_spec" ^entry "probes/run_light_spec.gene")
    # design.md §1 and §5 — M5's loaded world: addressing, the shell, and
    # daylight crossing a block boundary.
    (application "loaded_spec" ^entry "probes/run_loaded_spec.gene")
    # design.md §D8's M4 deliverable, run twice: `create` then `verify`.
    (application "persistence" ^entry "probes/run_persistence.gene")
  ]
}
