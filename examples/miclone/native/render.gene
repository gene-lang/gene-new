(mod native_render)
(import [vertex_source fragment_source] from "shaders" ^pkg "engine")
(import [paint] from "texture" ^pkg "engine")
(import [TileRegistry] from "tiles" ^pkg "engine")
(import [mat4_perspective mat4_view mat4_multiply] from "vec" ^pkg "engine")
(import [f32_bytes u32_bytes u8_bytes] from "buffers" ^pkg "sdl2")

(fn check [sdl value] : Nil
  ($assert (>= value 0) (sdl/error)))

(fn new_program [sdl device]
  (var p (sdl/program device (vertex_source "#version 330 core")
                            (fragment_source "#version 330 core")))
  ($assert (> p 0) (sdl/error))
  p)

(fn new_mesh [sdl device]
  (var m (sdl/mesh_new device))
  (check sdl m)
  (check sdl (sdl/mesh_attribute device m 0 3 28 0))
  (check sdl (sdl/mesh_attribute device m 1 2 28 12))
  (check sdl (sdl/mesh_attribute device m 2 1 28 20))
  (check sdl (sdl/mesh_attribute device m 3 1 28 24))
  m)

(fn upload_mesh [sdl device mesh vertices : (Buffer F32) indices : (Buffer U32)] : Nil
  (check sdl (sdl/mesh_upload device mesh (f32_bytes vertices) (u32_bytes indices))))

(fn atlas [sdl device tiles : TileRegistry]
  (var pixels ($buffer U8 65536))
  (paint (fn [x : F64 y : F64 r : F64 g : F64 b : F64] : Nil
    (var i (* (+ x (* y 128.0)) 4.0))
    (pixels .set i ($to_int r))
    (pixels .set (+ i 1.0) ($to_int g))
    (pixels .set (+ i 2.0) ($to_int b))
    (pixels .set (+ i 3.0) 255)) tiles)
  (var t (sdl/texture device 128 128 (u8_bytes pixels)))
  ($assert (> t 0) (sdl/error))
  t)

(fn view_projection [sdl device program proj : (Buffer F32) view : (Buffer F32)
                     vp : (Buffer F32) width : F64 height : F64
                     x : F64 y : F64 z : F64 dx : F64 dy : F64 dz : F64
                     fog : F64 daylight : F64] : Nil
  (mat4_perspective proj 1.15 (/ width height) 0.1 fog)
  (mat4_view view x y z dx dy dz)
  (mat4_multiply vp proj view)
  (check sdl (sdl/uniform_matrix device program "u_view_projection" (f32_bytes vp)))
  (check sdl (sdl/uniform_3f device program "u_fog" 0.62 0.76 0.94))
  (check sdl (sdl/uniform_f device program "u_fog_far" fog))
  (check sdl (sdl/uniform_f device program "u_time_of_day" daylight))
  (check sdl (sdl/uniform_i device program "u_atlas" 0)))

(fn capture [sdl device path : Str] : Nil
  (var width (sdl/width device))
  (var height (sdl/height device))
  (var zero ($buffer U8 (* width (* height 4))))
  (var pixels ($buffer C/UInt8 zero/.to_list))
  (check sdl (sdl/read_pixels device pixels))
  ($fs/write_bytes path ($binary/from_list pixels/.to_list))
  ($fs/write_text $"${path}.json" ($json/stringify {^width width ^height height})))
