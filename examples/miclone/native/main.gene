(mod miclone_native)

(import [store_block_and_light apply_delta hotbar_text] from "client_world" ^pkg "engine")
(import [count_faces build_mesh put_cube faces_per_cube item_cube_half]
        from "mesh" ^pkg "engine")
(import [SeenEntities new_seen apply_entity seen_rows seen_alive?
         seen_x seen_y seen_z seen_item seen_item_total seen_live seen_kind]
        from "seen" ^pkg "engine")
(import [entity_player] from "entity" ^pkg "engine")
(import [Registry new_registry id_of registered_count name_of solid?
         tile_top_of opens_form_of]
        from "registry" ^pkg "engine")
(import [World new_world store_block block_base node_at light_at
         world_dx world_dy world_dz world_stride_z world_nodes]
        from "loaded" ^pkg "engine")
(import [relight_node queue_overhead] from "light" ^pkg "engine")
(import [TileRegistry new_tiles] from "tiles" ^pkg "engine")
(import [forward_x forward_y forward_z] from "vec" ^pkg "engine")
(import [new_player step player_x player_y player_z player_eye_y
         on_ground? in_liquid? set_player_position box_overlaps_node?]
        from "physics" ^pkg "engine")
(import [new_hit cast hit? hit_x hit_y hit_z before_x before_y before_z]
        from "raycast" ^pkg "engine")
(import [diggable? placeable?] from "edit" ^pkg "engine")
(import [new_inventory slot_item slot_count slot_empty?]
        from "inventory" ^pkg "engine")
(import [ItemRegistry new_items item_name item_named placeable_item? item_node]
        from "item" ^pkg "engine")
(import [new_cursor] from "wire" ^pkg "engine")
(import [message_kind msg_hello msg_registry msg_block msg_node_delta
         msg_inventory msg_tiles msg_items
         new_hello decode_hello hello_version hello_span_x hello_span_y
         hello_span_z hello_bx hello_by hello_bz
         hello_spawn_x hello_spawn_y hello_spawn_z
         decode_registry decode_tiles decode_items
         new_block_header decode_block block_bx block_by block_bz
         new_node_delta decode_node_delta delta_x delta_y delta_z delta_id
         delta_param1
         decode_inventory
         size_request_blocks encode_request_blocks
         size_dig encode_dig size_place encode_place
         size_craft encode_craft craft_any
         size_input encode_input msg_entity
         new_entity_msg decode_entity ent_id ent_x ent_y ent_z ent_item ent_count
         ent_kind
         msg_forms decode_forms
         msg_open_form new_open_form decode_open_form open_x open_y open_z
         size_form_action_for encode_form_action
         protocol_version]
        from "protocol" ^pkg "engine")
(import [FormRegistry new_forms form_named form_title form_cols form_rows
         form_first form_len element_kind element_x element_y element_w
         element_text element_action kind_label kind_item kind_box kind_button]
        from "formspec" ^pkg "engine")
(import [load : load_sdl init_video window_opengl window_hidden window_resizable
         window_highdpi window_centered gl_major_version gl_minor_version
         gl_context_flags gl_profile_mask gl_profile_core gl_forward_compatible
         event_quit event_keydown event_keyup event_motion event_buttondown
         event_buttonup event_wheel] from "." ^pkg "sdl2")
(import [load : load_ws connect : ws_connect send : ws_send receive : ws_receive
         WebSocketError] from "." ^pkg "websocket")
(import [check new_program new_mesh upload_mesh atlas view_projection capture]
        from "./render.gene")

(let block_dim 16.0)
(let block_nodes 4096.0)

# §13's forms arrive as data; their grid coordinates place SDL text and buttons.
# `form_slots` matches the container size in `core/protocol.gene`.
(let form_slots 8.0)
# The panel a key opens rather than a node. It is the one form with no place in
# the world, so it is the one the client opens for itself.
(let crafting_form "miclone:crafting")

# What this client can render. The server states the same numbers in `hello`
# and a disagreement stops the join.
(let span_x 12.0)
(let span_y 4.0)
(let span_z 12.0)
(let origin_bx -90.0)
(let origin_by 0.0)
(let origin_bz 198.0)

# How many blocks to ask for at once. Under the server's 256-frame outbound
# queue with room to spare — a request cannot outrun its own answers, which is
# what keeps that queue from dropping the oldest frame (§10.1).
(let request_window 64.0)

(let look_speed 0.0022)
(let pitch_limit 1.5533)
(let fog_far 260.0)
(let time_of_day 1.0)
(let max_dt 0.05)
(let reach 5.0)
(let click_slop 4.0)
(let hotbar_slots 8.0)
(let floats_per_vertex 7.0)
(let indices_per_face 6.0)

(fn run_client [sdl net socket device font program smoke : Bool capture_path : Str server_url : Str] : Nil
  (var reg (new Registry))
  (var tiles (new_tiles))
  (var items (new_items))
  (var world (new_world origin_bx origin_by origin_bz span_x span_y span_z))
  (var wdx (world_dx world))
  (var wdy (world_dy world))
  (var wdz (world_dz world))
  (var wsz (world_stride_z world))
  (var player (new_player 0.0 40.0 0.0))
  (var inv (new_inventory hotbar_slots))
  (var chunks (* span_x (* span_y span_z)))
  (var meshes [])
  (var counts ($buffer F32 chunks))
  (var faces_total 0.0)
  (var ent_mesh (new_mesh sdl device))
  (var ent_faces 0.0)
  (var ent_dirty false)
  (var seen (new_seen))
  (var forms (new_forms))
  (var open_msg (new_open_form))
  (var open_form "")
  (var open_at ($buffer F64 3.0))
  (var open_inv ($buffer F64 (* form_slots 3.0)))
  (var texture 0)
  (var sky ($buffer F32 (* wdx wdz)))
  (var lq ($buffer F32 (+ (world_nodes world) queue_overhead)))
  (var lq_seed ($buffer F32 (+ (world_nodes world) queue_overhead)))
  (var wc (new_cursor))
  (var hello (new_hello))
  (var header (new_block_header))
  (var delta (new_node_delta))
  (var ent (new_entity_msg))
  (var block_c ($buffer F32 block_nodes))
  (var block_l ($buffer F32 block_nodes))
  (var joined false)
  (var connected true)
  (var running true)
  (var meshed false)
  (var blocks_in 0.0)
  (var requested 0.0)
  (var mesh_done 0.0)
  (var status "joining")
  (var yaw 0.6)
  (var pitch -0.25)
  (var fwd 0.0)
  (var strafe 0.0)
  (var jump false)
  (var sneak false)
  (var flying false)
  (var dragging false)
  (var drag_x 0.0)
  (var drag_y 0.0)
  (var selected 0.0)
  (var hit (new_hit))
  (var deltas 0)
  (var inventory_updates 0)
  (var actions_sent 0)
  (var buttons_drawn 0)
  (var event (sdl/event_new))
  (var pump_loading (fn [] nil))
  (var k 0.0)
  (while (< k chunks)
    (meshes .push (new_mesh sdl device))
    (set k (+ k 1.0)))

  (var mesh_chunk (fn [cx : F64 cy : F64 cz : F64]
    (var slot (+ cx (+ (* cy span_x) (* cz (* span_x span_y)))))
    (var bx (+ origin_bx cx))
    (var by (+ origin_by cy))
    (var bz (+ origin_bz cz))
    (var base (block_base world bx by bz))
    (var faces (count_faces reg world/content base wdx wsz))
    (set faces_total (+ (- faces_total (/ (counts .get slot) indices_per_face)) faces))
    (counts .set slot (* faces indices_per_face))
    (if_yes (> faces 0.0)
      (var verts ($buffer F32 (* faces 28.0)))
      (var idx ($buffer U32 (* faces indices_per_face)))
      (build_mesh reg world/content world/light verts idx base wdx wsz
                  (* bx block_dim) (* by block_dim) (* bz block_dim))
      (upload_mesh sdl device meshes/%slot verts idx))))

  (var mesh_all (fn []
    (set status "meshing")
    (var z 0.0)
    (while (&& running (< z span_z))
      (var y 0.0)
      (while (&& running (< y span_y))
        (var x 0.0)
        (while (&& running (< x span_x))
          (mesh_chunk x y z)
          (set mesh_done (+ mesh_done 1.0))
          (if_yes (== ($bit/and ($to_int mesh_done) 3) 0) (pump_loading))
          (set x (+ x 1.0)))
        (set y (+ y 1.0)))
      (set z (+ z 1.0)))))

  (var remesh (fn [nx : F64 ny : F64 nz : F64]
    (var bx ($math/floor (/ (- nx (* origin_bx block_dim)) block_dim)))
    (var by ($math/floor (/ (- ny (* origin_by block_dim)) block_dim)))
    (var bz ($math/floor (/ (- nz (* origin_bz block_dim)) block_dim)))
    (var z ($math/max 0.0 (- bz 1.0)))
    (while (<= z ($math/min (- span_z 1.0) (+ bz 1.0)))
      (var y ($math/max 0.0 (- by 1.0)))
      (while (<= y ($math/min (- span_y 1.0) (+ by 1.0)))
        (var x ($math/max 0.0 (- bx 1.0)))
        (while (<= x ($math/min (- span_x 1.0) (+ bx 1.0)))
          (mesh_chunk x y z)
          (set x (+ x 1.0)))
        (set y (+ y 1.0)))
      (set z (+ z 1.0)))))

  (var rebuild_entities (fn []
    (var n 0.0)
    (var i 0.0)
    (while (< i (seen_rows seen))
      (if_yes (&& (seen_alive? seen i) (>= (item_node items (seen_item seen i)) 0.0))
        (set n (+ n 1.0)))
      (set i (+ i 1.0)))
    (set ent_faces (* n (faces_per_cube)))
    (if_yes (> n 0.0)
      (var verts ($buffer F32 (* ent_faces 28.0)))
      (var idx ($buffer U32 (* ent_faces indices_per_face)))
      (var face 0.0)
      (set i 0.0)
      (while (< i (seen_rows seen))
        (if_yes (seen_alive? seen i)
          (var node (item_node items (seen_item seen i)))
          (if_yes (>= node 0.0)
            (var x (seen_x seen i)) (var y (seen_y seen i)) (var z (seen_z seen i))
            (var light (light_at world ($math/floor x) ($math/floor y) ($math/floor z)))
            (var is_player (== (seen_kind seen i) entity_player))
            (set face (put_cube verts idx face (tile_top_of reg node) light
              (if is_player 0.4 (item_cube_half)) x (if is_player (+ y 0.4) y) z))))
        (set i (+ i 1.0)))
      (upload_mesh sdl device ent_mesh verts idx))))

  (var request_more (fn []
    (if_yes (> (- chunks requested) 0.0)
      (var count ($math/min request_window (- chunks requested)))
      (var message ($buffer U8 (size_request_blocks)))
      (encode_request_blocks message wc requested count)
      (ws_send net socket message)
      (set requested (+ requested count)))))

  (var process_message (fn [b : (Buffer U8)]
    (var kind (message_kind b))
    (if_yes (== kind msg_hello)
      (decode_hello b wc hello)
      ($assert (== (hello .get hello_version) protocol_version) "server protocol version mismatch")
      ($assert (&& (&& (== (hello .get hello_span_x) span_x) (== (hello .get hello_span_y) span_y))
                   (== (hello .get hello_span_z) span_z)) "server world extent mismatch")
      ($assert (&& (&& (== (hello .get hello_bx) origin_bx) (== (hello .get hello_by) origin_by))
                   (== (hello .get hello_bz) origin_bz)) "server world origin mismatch")
      (set_player_position player (hello .get hello_spawn_x) (hello .get hello_spawn_y) (hello .get hello_spawn_z))
      (set joined true))
    (if_yes (== kind msg_tiles)
      (decode_tiles b wc tiles)
      (set texture (atlas sdl device tiles)))
    (if_yes (== kind msg_items) (decode_items b wc items))
    (if_yes (== kind msg_registry)
      (decode_registry b wc reg)
      (set status "receiving world")
      (request_more))
    (if_yes (== kind msg_block)
      (decode_block b wc header block_c block_l)
      (store_block_and_light world (header .get block_bx) (header .get block_by) (header .get block_bz) block_c block_l)
      (set blocks_in (+ blocks_in 1.0))
      (if_yes (== blocks_in requested) (request_more))
      (if_yes (&& (== blocks_in chunks) (! meshed))
        (mesh_all)
        (set meshed true)
        (set status "")
        ($println $"native: received $( $to_int blocks_in) blocks; $($to_int faces_total) faces")))
    (if_yes (== kind msg_node_delta)
      (decode_node_delta b wc delta)
      (if_not smoke
        (if (== (delta .get delta_id) 0.0)
          (sdl/sound device 0.0 0.09 0.28 1)
          (sdl/sound device 523.25 0.06 0.16 0)))
      (apply_delta world reg delta sky lq lq_seed)
      (if_yes meshed (remesh (delta .get delta_x) (delta .get delta_y) (delta .get delta_z)))
      (set deltas (+ deltas 1)))
    (if_yes (== kind msg_entity)
      (decode_entity b wc ent)
      (if_yes (apply_entity seen (ent .get ent_id) (ent .get ent_x) (ent .get ent_y) (ent .get ent_z)
                           (ent .get ent_item) (ent .get ent_count) (ent .get ent_kind))
        (set ent_dirty true)))
    (if_yes (== kind msg_inventory)
      (decode_inventory b wc inv)
      (set inventory_updates (+ inventory_updates 1)))
    (if_yes (== kind msg_forms) (decode_forms b wc forms))
    (if_yes (== kind msg_open_form)
      (set open_form (decode_open_form b wc open_msg open_inv))
      (open_at .set 0.0 (open_msg .get open_x))
      (open_at .set 1.0 (open_msg .get open_y))
      (open_at .set 2.0 (open_msg .get open_z)))))

  (var cast_hit (fn []
    (cast world reg hit (player_x player) (player_eye_y player) (player_z player)
          (forward_x yaw pitch) (forward_y yaw pitch) (forward_z yaw pitch) reach)))
  (var dig (fn []
    (cast_hit)
    (if_yes (&& (hit? hit) (diggable? world reg (hit_x hit) (hit_y hit) (hit_z hit)))
      (var message ($buffer U8 (size_dig)))
      (encode_dig message wc (hit_x hit) (hit_y hit) (hit_z hit))
      (ws_send net socket message))))
  (var place (fn []
    (cast_hit)
    (if_yes (hit? hit)
      (var x (before_x hit)) (var y (before_y hit)) (var z (before_z hit))
      (var ax (hit_x hit)) (var ay (hit_y hit)) (var az (hit_z hit))
      (var opens (!= (opens_form_of reg (node_at world ax ay az)) ""))
      (var item (slot_item inv selected))
      (if_yes (|| opens (&& (! (slot_empty? inv selected))
        (&& (placeable_item? items item) (&& (placeable? world reg x y z) (! (box_overlaps_node? player x y z))))))
        (var message ($buffer U8 (size_place)))
        (encode_place message wc x y z item ax ay az)
        (ws_send net socket message)))))
  (var form_click (fn [x : F64 y : F64]
    (var id (form_named forms open_form))
    (if_yes (>= id 0.0)
      (var e (form_first forms id))
      (var last (+ e (form_len forms id)))
      (while (< e last)
        (if_yes (== (element_kind forms e) (kind_button))
          (var left (+ 14.0 (* (element_x forms e) 56.0)))
          (var top (+ 44.0 (* (element_y forms e) 26.0)))
          (var width (- (* (element_w forms e) 56.0) 8.0))
          (if_yes (&& (&& (>= x left) (< x (+ left width))) (&& (>= y top) (< y (+ top 22.0))))
            (var action (element_action forms e))
            (var message ($buffer U8 (size_form_action_for open_form action)))
            (encode_form_action message wc (open_at .get 0.0) (open_at .get 1.0) (open_at .get 2.0)
                                0.0 open_form action)
            (ws_send net socket message)
            (set actions_sent (+ actions_sent 1))
            (set e last)))
        (set e (+ e 1.0))))))

  (var process_event (fn []
    (var kind (sdl/event_type event))
    (if_yes (== kind event_quit) (set running false))
    (if_yes (|| (== kind event_keydown) (== kind event_keyup))
      (var key (sdl/event_key event))
      (var down (== kind event_keydown))
      (if_yes (== key 119) (set fwd (if down 1.0 0.0)))
      (if_yes (== key 115) (set fwd (if down -1.0 0.0)))
      (if_yes (== key 97) (set strafe (if down -1.0 0.0)))
      (if_yes (== key 100) (set strafe (if down 1.0 0.0)))
      (if_yes (== key 32) (set jump down))
      (if_yes (|| (== key 1073742049) (== key 1073742053)) (set sneak down))
      (if_yes (&& down (== (sdl/event_repeat event) 0))
        (if_yes (== key 102) (set flying (! flying)))
        (if_yes (&& (>= key 49) (<= key 56)) (set selected ($to_float (- key 49))))
        (if_yes (&& (== key 99) joined)
          (var message ($buffer U8 (size_craft)))
          (encode_craft message wc (craft_any))
          (ws_send net socket message))
        (if_yes (== key 101)
          (set open_form (if (== open_form crafting_form) "" crafting_form))
          (open_at .fill 0.0))
        (if_yes (== key 27) (set open_form ""))))
    (if_yes (== kind event_buttondown)
      (set dragging true)
      (set drag_x ($to_float (sdl/event_x event)))
      (set drag_y ($to_float (sdl/event_y event))))
    (if_yes (== kind event_motion)
      (if_yes (&& dragging (== open_form ""))
        (set yaw (+ yaw (* ($to_float (sdl/event_dx event)) look_speed)))
        (set pitch ($math/clamp (- pitch (* ($to_float (sdl/event_dy event)) look_speed)) (- 0.0 pitch_limit) pitch_limit))))
    (if_yes (== kind event_buttonup)
      (var x ($to_float (sdl/event_x event))) (var y ($to_float (sdl/event_y event)))
      (if_yes (&& dragging (< (+ ($math/abs (- x drag_x)) ($math/abs (- y drag_y))) click_slop))
        (if (== open_form "")
          (then (if_yes (&& meshed connected)
            (if (== (sdl/event_button event) 3) (place) (dig))))
          (else (if_yes connected (form_click x y)))))
      (set dragging false))
    (if_yes (== kind event_wheel)
      (var next (+ selected (if (< (sdl/event_wheel event) 0.0) 1.0 -1.0)))
      (set selected (if (< next 0.0) 7.0 (if (> next 7.0) 0.0 next))))))

  (set pump_loading (fn []
    (while (== (sdl/poll_event event) 1) (process_event))
    (check sdl (sdl/begin_frame device program 0.62 0.76 0.94))
    (check sdl (sdl/rect device 8.0 8.0 480.0 32.0 204))
    (check sdl (sdl/text device font $"${status} $($to_int mesh_done)/$($to_int chunks) chunks" 14.0 14.0 4294967295))
    (sdl/present device)))

  (var draw_form (fn []
    (set buttons_drawn 0)
    (var id (if (== open_form "") -1.0 (form_named forms open_form)))
    (if_yes (>= id 0.0)
      (check sdl (sdl/rect device 8.0 8.0 (+ 12.0 (* (form_cols forms id) 56.0))
                                      (+ 40.0 (* (form_rows forms id) 26.0)) 238))
      (check sdl (sdl/text device font (form_title forms id) 14.0 14.0 4294967295))
      (var e (form_first forms id))
      (var slot 0.0)
      (while (< e (+ (form_first forms id) (form_len forms id)))
        (var kind (element_kind forms e))
        (if_yes (!= kind (kind_box))
          (var x (+ 14.0 (* (element_x forms e) 56.0)))
          (var y (+ 44.0 (* (element_y forms e) 26.0)))
          (var label (element_text forms e))
          (if_yes (== kind (kind_item))
            (if_yes (== label "")
              (var held (open_inv .get (* slot 3.0)))
              (var count (open_inv .get (+ (* slot 3.0) 1.0)))
              (set label (if (> count 0.0) $"$(item_name items held) x$($to_int count)" "—"))
              (set slot (+ slot 1.0))))
          (if_yes (== kind (kind_button))
            (set buttons_drawn (+ buttons_drawn 1))
            (check sdl (sdl/rect device x y (- (* (element_w forms e) 56.0) 8.0) 22.0 825505535)))
          (check sdl (sdl/text device font label (+ x 3.0) (+ y 3.0) 4294967295)))
        (set e (+ e 1.0))))))

  (var proj ($buffer F32 16.0)) (var view ($buffer F32 16.0)) (var vp ($buffer F32 16.0))
  (var last_ms 0.0) (var fps_since 0.0) (var frames 0.0) (var input_sent 0.0)
  (var hud "Connecting to server…")
  (var stage 0) (var stage_at 0.0) (var baseline_faces 0.0) (var walk_x 0.0) (var walk_z 0.0)
  (var chest_x 0.0) (var chest_y 0.0) (var chest_z 0.0)
  (var held (fn [name : Str]
    (var id (item_named items name))
    (var total 0.0) (var at 0.0)
    (while (< at hotbar_slots)
      (if_yes (== (slot_item inv at) id) (set total (+ total (slot_count inv at))))
      (set at (+ at 1.0)))
    total))
  (var press_named (fn [action : Str]
    (var id (form_named forms open_form))
    ($assert (>= id 0.0))
    (var e (form_first forms id))
    (var end (+ e (form_len forms id)))
    (while (&& (< e end) (!= (element_action forms e) action)) (set e (+ e 1.0)))
    ($assert (< e end) $"missing form action ${action}")
    (var x ($to_int (+ 20.0 (* (element_x forms e) 56.0))))
    (var y ($to_int (+ 50.0 (* (element_y forms e) 26.0))))
    (sdl/push_button 1 1 x y) (sdl/push_button 1 0 x y)))
  # Test fixture setup still asks the authoritative server to dig a real tree.
  # Crafting and container actions below go through SDL clicks on the real UI.
  (var gather_tree (fn []
    (var tree (id_of reg "miclone:tree"))
    (var at 0.0)
    (while (&& (< at (world_nodes world)) (!= (world/content .get at) tree)) (set at (+ at 1.0)))
    ($assert (< at (world_nodes world)) "world needs a tree for the crafting smoke")
    (var z ($math/floor (/ at wsz)))
    (var rest (- at (* z wsz)))
    (var y ($math/floor (/ rest wdx)))
    (var x (- rest (* y wdx)))
    (var request ($buffer U8 (size_dig)))
    (encode_dig request wc (+ (* origin_bx block_dim) (- x 1.0))
                          (+ (* origin_by block_dim) (- y 1.0))
                          (+ (* origin_bz block_dim) (- z 1.0)))
    (ws_send net socket request)))
  (var peer nil)
  (var other_players (fn []
    (var total 0) (var i 0.0)
    (while (< i (seen_rows seen))
      (if_yes (&& (seen_alive? seen i) (== (seen_kind seen i) entity_player)) (set total (+ total 1)))
      (set i (+ i 1.0)))
    total))
  (var steady_frames 0.0)
  (var deadline (+ ($os/monotonic_ms) 600000))
  (var work 0)
  (var message nil)
  (try
    (while running
      (while (== (sdl/poll_event event) 1) (process_event))
      (if_yes connected
        (try
          (set work 0)
          (set message (ws_receive net socket))
          (while (&& (!= message nil) (< work 64))
            ($assert (== (net/kind socket) 2) "server sent a non-binary message")
            (process_message message)
            (set work (+ work 1))
            (set message (if (< work 64) (ws_receive net socket) nil)))
          catch WebSocketError
          (set connected false)
          (set status "disconnected")
          ($println $err/message)))
      (var now ($to_float ($os/monotonic_ms)))
      (var dt (if (> last_ms 0.0) ($math/min max_dt (/ (- now last_ms) 1000.0)) 0.0))
      (set last_ms now)
      (var dx (forward_x yaw pitch)) (var dy (forward_y yaw pitch)) (var dz (forward_z yaw pitch))
      (var wish_x (+ (* (forward_x yaw 0.0) fwd) (* (forward_x (+ yaw 1.5708) 0.0) strafe)))
      (var wish_z (+ (* (forward_z yaw 0.0) fwd) (* (forward_z (+ yaw 1.5708) 0.0) strafe)))
      (var length ($math/sqrt (+ (* wish_x wish_x) (* wish_z wish_z))))
      (if_yes (> length 0.0) (set wish_x (/ wish_x length)) (set wish_z (/ wish_z length)))
      (if_yes (&& meshed (> dt 0.0)) (step player world reg wish_x wish_z jump sneak flying dt))
      (var width ($to_float (sdl/width device))) (var height ($to_float (sdl/height device)))
      (var ui_width ($to_float (sdl/logical_width device)))
      (var ui_height ($to_float (sdl/logical_height device)))
      (if_yes (&& (> width 0.0) (> height 0.0))
        (check sdl (sdl/begin_frame device program 0.62 0.76 0.94))
        (view_projection sdl device program proj view vp width height
          (player_x player) (player_eye_y player) (player_z player) dx dy dz fog_far time_of_day)
        (if_yes (> texture 0) (check sdl (sdl/texture_bind device texture)))
        (var drawn 0.0)
        (var i 0.0)
        (while (< i chunks)
          (if_yes (> (counts .get i) 0.0)
            (check sdl (sdl/mesh_draw device meshes/%i))
            (set drawn (+ drawn 1.0)))
          (set i (+ i 1.0)))
        (if_yes ent_dirty (rebuild_entities) (set ent_dirty false))
        (if_yes (> ent_faces 0.0) (check sdl (sdl/mesh_draw device ent_mesh)))
        (set frames (+ frames 1.0))
        (if_yes (> (- now fps_since) 1000.0)
          (set hud (if (! meshed) $"${status}: $($to_int blocks_in)/$($to_int chunks) blocks"
            $"$($to_int frames) fps · $($to_int drawn) chunks · $($to_int faces_total) faces · $($to_int (seen_live seen)) entities · ${status} at $($math/round (player_x player)), $($math/round (player_y player)), $($math/round (player_z player))"))
          (set frames 0.0) (set fps_since now))
        (check sdl (sdl/rect device 8.0 8.0 1240.0 24.0 180))
        (check sdl (sdl/text device font hud 14.0 12.0 4294967295))
        (check sdl (sdl/rect device 8.0 (- ui_height 35.0) 1240.0 27.0 210))
        (check sdl (sdl/text device font (hotbar_text items inv selected) 14.0 (- ui_height 31.0) 4294967295))
        (check sdl (sdl/rect device (- (/ ui_width 2.0) 6.0) (/ ui_height 2.0) 13.0 1.0 4294967295))
        (check sdl (sdl/rect device (/ ui_width 2.0) (- (/ ui_height 2.0) 6.0) 1.0 13.0 4294967295))
        (draw_form)
        ($assert (== (sdl/gl_error device) 0) "native renderer reported an OpenGL error")
        (if_yes smoke
          ($assert (< ($os/monotonic_ms) deadline) $"native smoke timed out at stage ${stage}")
          (if_yes (&& (== stage 0) meshed)
            ($assert (> faces_total 1000.0))
            (set baseline_faces faces_total)
            (set peer (ws_connect net server_url))
            (var peer_input ($buffer U8 (size_input)))
            (encode_input peer_input wc 0.0 0.0 false false false 0.0
              (+ (player_x player) 2.0) (player_y player) (player_z player))
            (ws_send net peer peer_input)
            (ws_receive net peer)
            (sdl/push_button 1 1 400 300) (sdl/push_motion 400 450 0 150) (sdl/push_button 1 0 400 450)
            (set stage 1) (set stage_at now))
          (if_yes (&& (&& (== stage 1) (> (- now stage_at) 100.0)) (> (other_players) 0))
            ($assert (== (slot_count inv 0.0) 0.0))
            ($assert (>= ent_faces 6.0) "the other player must have rendered geometry")
            ($println "native smoke: another connected player has visible geometry")
            (sdl/push_button 1 1 400 300) (sdl/push_button 1 0 400 300)
            (set stage 2))
          (if_yes (&& (== stage 2) (== (slot_count inv 0.0) 1.0))
            ($assert (> deltas 0))
            ($println "native smoke: dug a node and received its drop")
            (sdl/push_button 3 1 400 300) (sdl/push_button 3 0 400 300)
            (set stage 3))
          (if_yes (&& (&& (== stage 3) (>= deltas 2)) (== (slot_count inv 0.0) 0.0))
            ($assert (== faces_total baseline_faces) "dig/place must restore the world mesh")
            (gather_tree)
            (sdl/push_key 101 1) (sdl/push_key 101 0)
            (set stage 4) (set stage_at now))
          (if_yes (&& (== stage 4) (>= (held "miclone:tree") 1.0))
            ($assert (== open_form crafting_form))
            ($assert (> buttons_drawn 0) "wire-defined crafting buttons must render")
            (press_named "make_miclone:plank")
            (set stage 5))
          (if_yes (&& (== stage 5) (>= (held "miclone:plank") 4.0))
            (press_named "make_miclone:chest")
            (set stage 9))
          (if_yes (&& (== stage 9) (>= (held "miclone:chest") 1.0))
            ($println "native smoke: SDL crafting controls made planks and a chest")
            (var slot 0.0)
            (while (!= (slot_item inv slot) (item_named items "miclone:chest")) (set slot (+ slot 1.0)))
            (set selected slot)
            (cast_hit)
            (set chest_x (before_x hit)) (set chest_y (before_y hit)) (set chest_z (before_z hit))
            (sdl/push_key 27 1) (sdl/push_key 27 0)
            (sdl/push_button 3 1 400 300) (sdl/push_button 3 0 400 300)
            (set stage 10))
          (if_yes (&& (== stage 10) (== (node_at world chest_x chest_y chest_z) (id_of reg "miclone:chest")))
            ($assert (== (held "miclone:chest") 0.0))
            (sdl/push_button 3 1 400 300) (sdl/push_button 3 0 400 300)
            (set stage 11))
          (if_yes (&& (== stage 11) (== open_form "miclone:chest"))
            (gather_tree)
            (set stage 12))
          (if_yes (&& (== stage 12) (>= (held "miclone:tree") 1.0))
            (press_named "put_0")
            (set stage 13))
          (if_yes (&& (== stage 13) (> (open_inv .get 1.0) 0.0))
            ($assert (== (held "miclone:tree") 0.0))
            (press_named "take_0")
            (set stage 14))
          (if_yes (&& (&& (== stage 14) (== (open_inv .get 1.0) 0.0)) (>= (held "miclone:tree") 1.0))
            ($println "native smoke: placed/opened a chest and used its put/take controls")
            (sdl/push_key 27 1) (sdl/push_key 27 0)
            (sdl/push_button 1 1 400 300) (sdl/push_motion 400 150 0 -150) (sdl/push_button 1 0 400 150)
            (set walk_x (player_x player)) (set walk_z (player_z player))
            (sdl/push_key 119 1)
            (set stage 6) (set stage_at now))
          (if_yes (&& (== stage 6) (> (- now stage_at) 700.0))
            (sdl/push_key 119 0)
            ($assert (> (+ ($math/abs (- (player_x player) walk_x)) ($math/abs (- (player_z player) walk_z))) 0.2) "W must move the player")
            ($C/close peer) (set peer nil)
            (set stage 15))
          (if_yes (&& (== stage 15) (== (other_players) 0))
            ($println "native smoke: disconnected player removed")
            (set stage 7) (set stage_at now))
          (if_yes (== stage 7)
            (set steady_frames (+ steady_frames 1.0))
            (if_yes (> (- now stage_at) 5000.0)
              (var measured_fps (/ (* steady_frames 1000.0) (- now stage_at)))
              ($println $"native steady frame rate: ${measured_fps} fps")
              ($assert (>= measured_fps 60.0) "native steady rendering must reach 60 fps")
              # Large framebuffer copies belong after the performance sample.
              (capture sdl device capture_path)
              (set open_form crafting_form)
              (draw_form)
              (capture sdl device $"${capture_path}.form")
              ($println "PASS — native world, input, dig/place, inventory and wire-defined UI")
              (set stage 8)
              (set running false))))
        (sdl/present device))
      (if_yes (&& (&& joined connected) (> (- now input_sent) 1000.0))
        (set input_sent now)
        (var message ($buffer U8 (size_input)))
        (encode_input message wc wish_x wish_z jump sneak flying yaw
          (player_x player) (player_y player) (player_z player))
        (ws_send net socket message))
      ($sleep 1))
    (if_yes smoke ($assert (== stage 8) "native smoke exited before completing its checks"))
    ensure
    (if (!= peer nil) ($C/close peer))
    ($C/close event)))

(fn main [args] : Nil
  (var argv args/.body)
  ($assert (>= argv/.size 3) "main.gene <SDL library> <WebSocket library> <font> [URL] [--smoke] [capture path]")
  (var sdl (load_sdl argv/0))
  (var net (load_ws argv/1))
  (var url (if (> argv/.size 3) argv/3 "ws://127.0.0.1:8790/"))
  (var smoke (&& (> argv/.size 4) (== argv/4 "--smoke")))
  (var capture_path (if (> argv/.size 5) argv/5 ".gene/native-smoke.rgba"))
  (if_yes smoke (if_not ($fs/exists? ".gene") ($fs/make_dir ".gene")))
  (sdl/set_main_ready)
  (check sdl (sdl/init init_video))
  (try
    (check sdl (sdl/gl_set_attribute gl_major_version 3))
    (check sdl (sdl/gl_set_attribute gl_minor_version 3))
    (check sdl (sdl/gl_set_attribute gl_profile_mask gl_profile_core))
    (check sdl (sdl/gl_set_attribute gl_context_flags gl_forward_compatible))
    (var flags (+ window_opengl (+ window_resizable window_highdpi)))
    (if_yes smoke (set flags (+ flags window_hidden)))
    (var window (sdl/create_window "Miclone" window_centered window_centered 1280 720 flags))
    (try
      (var device (sdl/device_new window))
      (try
        (sdl/gl_set_swap_interval (if smoke 0 1))
        (var font (sdl/font_open device argv/2 14))
        (check sdl font)
        (var program (new_program sdl device))
        (var socket (ws_connect net url))
        (try (run_client sdl net socket device font program smoke capture_path url)
          ensure ($C/close socket))
        ensure ($C/close device))
      ensure ($C/close window))
    ensure (sdl/quit)))
