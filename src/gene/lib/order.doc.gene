(mod order)

(fn compare [a, b] : Int
  ^errors []
  @doc "Returns `-1`, `0`, or `1` as the first value sorts before, with, or after the second."
  @see ["book/collections/ordering"]
  @for "gene/order/compare"
  nil)

(fn sort [items : List ^compare = nil] : List
  ^errors []
  @doc "Returns a new sorted List, ordered by `^compare` when given; the input is unchanged."
  @see ["book/collections/ordering"]
  @for "gene/order/sort"
  nil)

(fn sort_by [items : List, key_fn : Callable ^compare = nil] : List
  ^errors []
  @doc "Returns a new List sorted by the key the function computes for each item."
  @see ["book/collections/ordering"]
  @for "gene/order/sort_by"
  nil)
