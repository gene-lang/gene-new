(mod audio)
(type AudioError ^props {^message Str} ^impl [Error])
(impl Error for AudioError)

(fn audio_error [message : Str] (fail (AudioError ^message message)))

(fn pcm_format [rate : Int, channels : Int = 1]
  (if (|| (< rate 8000) (> rate 192000) (< channels 1) (> channels 2))
    (audio_error "PCM requires 8000–192000 Hz and one or two channels."))
  {^rate rate ^channels channels ^encoding "s16le"})

(fn pcm_duration_ms [pcm : Bytes, rate : Int, channels : Int = 1] : Int
  (pcm_format rate channels)
  (if (!= (// ($binary/size pcm) (* channels 2)) 0)
    (audio_error "PCM ends inside a sample frame."))
  ($to_int (/ (* ($binary/size pcm) 1000) (* rate channels 2))))

(fn wav_encode [pcm : Bytes, rate : Int, channels : Int = 1] : Bytes
  (pcm_duration_ms pcm rate channels)
  (let size ($binary/size pcm))
  (if (> size 67108864) (audio_error "WAV exceeds the 64 MiB codec limit."))
  ($binary/concat [($binary/from_str "RIFF") ($binary/put_u32 (+ size 36))
    ($binary/from_str "WAVEfmt ") ($binary/put_u32 16) ($binary/put_u16 1)
    ($binary/put_u16 channels) ($binary/put_u32 rate) ($binary/put_u32 (* rate channels 2))
    ($binary/put_u16 (* channels 2)) ($binary/put_u16 16)
    ($binary/from_str "data") ($binary/put_u32 size) pcm]))

(fn wav_decode [bytes : Bytes]
  (let size ($binary/size bytes))
  (if (|| (< size 44) (> size 67108908)) (audio_error "Invalid WAV size."))
  (if (|| (!= ($binary/to_str ($binary/slice bytes 0 4)) "RIFF")
          (!= ($binary/to_str ($binary/slice bytes 8 4)) "WAVE")
          (!= (+ ($binary/get_u32 bytes 4) 8) size))
    (audio_error "Expected a complete RIFF/WAVE container."))
  (var format nil)
  (var pcm nil)
  (var cursor 12)
  (while (< cursor size)
    (if (> (+ cursor 8) size) (audio_error "Truncated WAV chunk header."))
    (let kind ($binary/to_str ($binary/slice bytes cursor 4)))
    (let count ($binary/get_u32 bytes (+ cursor 4)))
    (set cursor (+ cursor 8))
    (if (> count (- size cursor)) (audio_error "Truncated WAV chunk payload."))
    (if_yes (== kind "fmt ")
      (if (|| (! ($absent? format)) (< count 16)
              (!= ($binary/get_u16 bytes cursor) 1)
              (!= ($binary/get_u16 bytes (+ cursor 14)) 16))
        (audio_error "Only uncompressed 16-bit PCM WAV is supported."))
      (let rate ($binary/get_u32 bytes (+ cursor 4)))
      (let channels ($binary/get_u16 bytes (+ cursor 2)))
      (set format (pcm_format rate channels))
      (if (|| (!= ($binary/get_u16 bytes (+ cursor 12)) (* channels 2))
              (!= ($binary/get_u32 bytes (+ cursor 8)) (* rate channels 2)))
        (audio_error "Inconsistent WAV sample format.")))
    (if_yes (== kind "data")
      (if_not ($absent? pcm) (audio_error "Duplicate WAV data chunk."))
      (set pcm ($binary/slice bytes cursor count)))
    (set cursor (+ cursor count (// count 2))))
  (if (|| (!= cursor size) ($absent? format) ($absent? pcm))
    (audio_error "WAV needs one format and data chunk, including chunk padding."))
  (pcm_duration_ms pcm format/rate format/channels)
  {^format format ^pcm pcm})
