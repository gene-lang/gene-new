{^format 1
 ^name "genex/libuv_timer"
 ^version "0.1.0"
 ^description "Owned libuv timer notifications through Gene native ingress"
 ^library {^entry "src/timer.gene" ^uses ["native"]}
 ^files {^include ["package.gene" "README.md" "src/**" "native/**"]}
 ^system_dependencies {
   ^uv (system_library ^name "libuv" ^version ">=1.52.1 <1.53"
     ^providers [pkg_config] ^linkage dynamic)}
 ^build [(c_library "native" ^sources ["native/timer.c"]
           ^include_dirs ["native"] ^system ["uv"]
           ^linkage shared ^targets ["arm64-macosx" "amd64-linux"])]}
