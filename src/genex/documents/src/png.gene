(mod png)

(type PngError ^props {^message Str} ^impl [Error])
(impl Error for PngError)

(fn invalid [message : Str]
  (fail (PngError ^message message)))

(fn u32 [bytes : Bytes, offset : Int]
  (+ (* ($binary/get bytes offset) 16777216)
     (* ($binary/get bytes (+ offset 1)) 65536)
     (* ($binary/get bytes (+ offset 2)) 256)
     ($binary/get bytes (+ offset 3))))

(fn u16 [bytes : Bytes, offset : Int]
  (+ (* ($binary/get bytes offset) 256) ($binary/get bytes (+ offset 1))))

# This validates the PNG container, including CRCs, without decompressing
# IDAT. Pixel/alpha inspection is a separate, bounded decoder operation.
(fn inspect_png [bytes : Bytes, ^max_bytes max_bytes : Int = 10485760]
  (let size ($binary/size bytes))
  (if (|| (< size 8) (> size max_bytes)
          (!= ($binary/slice bytes 0 8)
              ($binary/from_list [137 80 78 71 13 10 26 10])))
    (invalid "Expected a PNG within the image byte limit."))
  (var offset 8)
  (var count 0)
  (var metadata nil)
  (var palette 0)
  (var transparency false)
  (var image_data false)
  (var data_closed false)
  (var data_size 0)
  (var animated false)
  (while (< offset size)
    (set count (+ count 1))
    (if (|| (> count 65536) (< (- size offset) 12))
      (invalid "PNG chunk count or bounds are invalid."))
    (let length (u32 bytes offset))
    (if (|| (> length 2147483647) (> length (- size offset 12)))
      (invalid "PNG chunk extends beyond the image."))
    (let kind ($binary/to_str ($binary/slice bytes (+ offset 4) 4)))
    (repeat index in 4
      (let letter ($binary/get bytes (+ offset 4 index)))
      (if_not (|| (&& (>= letter 65) (<= letter 90))
                  (&& (>= letter 97) (<= letter 122)))
        (invalid "PNG chunk type must contain four ASCII letters.")))
    (if (> ($binary/get bytes (+ offset 6)) 90)
      (invalid "PNG chunk uses the reserved type bit."))
    (if (!= ($binary/crc32 ($binary/slice bytes (+ offset 4) (+ length 4)))
            (u32 bytes (+ offset length 8)))
      (invalid $"PNG ${kind} checksum is invalid."))
    (let payload (+ offset 8))
    (let next (+ offset length 12))
    (if (&& ($absent? metadata) (!= kind "IHDR"))
      (invalid "PNG must start with IHDR."))
    (if (&& image_data (!= kind "IDAT")) (set data_closed true))
    (if (== kind "IHDR")
      (then
        (if (|| (!= offset 8) (!= length 13))
          (invalid "PNG must have exactly one 13-byte IHDR."))
        (let width (u32 bytes payload))
        (let height (u32 bytes (+ payload 4)))
        (let depth ($binary/get bytes (+ payload 8)))
        (let color ($binary/get bytes (+ payload 9)))
        (let allowed (if (== color 0) [1 2 4 8 16]
          (if (== color 3) [1 2 4 8]
            (if ([2 4 6] .contains? color) [8 16] []))))
        (if (|| (< width 1) (< height 1) (> width 2147483647)
                (> height 2147483647) (! (allowed .contains? depth))
                (!= ($binary/get bytes (+ payload 10)) 0)
                (!= ($binary/get bytes (+ payload 11)) 0)
                (> ($binary/get bytes (+ payload 12)) 1))
          (invalid "PNG dimensions or IHDR fields are invalid."))
        (set metadata {^width width ^height height ^bit_depth depth
          ^color_type color ^has_alpha ([4 6] .contains? color)
          ^has_transparent_pixels nil}))
      (elif (== kind "PLTE")
        (if (|| (> palette 0) image_data transparency (== length 0)
                (> length 768) (!= (// length 3) 0)
                ([0 4] .contains? metadata/color_type))
          (invalid "PNG palette is invalid or misplaced."))
        (set palette (/ length 3))
        (if_yes (== metadata/color_type 3)
          (var colors 1)
          (repeat bit in metadata/bit_depth (set colors (* colors 2)))
          (if (> palette colors) (invalid "PNG palette exceeds its bit depth."))))
      (elif (== kind "tRNS")
        (if (|| transparency image_data metadata/has_alpha)
          (invalid "PNG transparency chunk is invalid or misplaced."))
        (if (== metadata/color_type 3)
          (then
            (if (|| (== palette 0) (== length 0) (> length palette))
              (invalid "PNG palette transparency is invalid.")))
          (else
            (let samples (if (== metadata/color_type 0) 1 3))
            (if (!= length (* samples 2)) (invalid "PNG transparency size is invalid."))
            (var limit 1)
            (repeat bit in metadata/bit_depth (set limit (* limit 2)))
            (repeat sample in samples
              (if (>= (u16 bytes (+ payload (* sample 2))) limit)
                (invalid "PNG transparent color exceeds its bit depth.")))))
        (set transparency true)
        (metadata .put "has_alpha" true))
      (elif (== kind "IDAT")
        (if (|| data_closed (&& (== metadata/color_type 3) (== palette 0)))
          (invalid "PNG image data is misplaced or lacks its palette."))
        (set image_data true)
        (set data_size (+ data_size length)))
      (elif (== kind "IEND")
        (if (|| (!= length 0) (! image_data) (== data_size 0) (!= next size))
          (invalid "PNG end chunk or image data is invalid."))
        (metadata .put "animated" animated)
        (return metadata))
      (elif (== kind "acTL")
        (if (|| animated image_data (!= length 8))
          (invalid "PNG animation control is invalid."))
        (set animated true))
      (elif (<= ($binary/get bytes (+ offset 4)) 90)
        (invalid $"Unsupported critical PNG chunk ${kind}.")))
    (set offset next))
  (invalid "PNG is missing IEND."))
