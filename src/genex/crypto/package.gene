{^format 1
 ^name "genex/crypto"
 ^version "0.1.0"
 ^description "Bounded public-key signature verification backed by OpenSSL"
 ^library {^entry "src/crypto.gene" ^uses ["native"]}
 ^files {^include ["package.gene" "README.md" "src/**" "native/**" "tests/**"]
         ^exclude ["**/.gene/**"]}
 ^system_dependencies {
   ^openssl (system_library ^name "openssl" ^version ">=3.0.0 <4"
     ^providers [pkg_config] ^linkage dynamic)}
 ^build [(c_library "native" ^sources ["native/crypto.c"]
           ^system ["openssl"] ^linkage shared
           ^targets ["arm64-macosx" "amd64-linux" "arm64-linux"])]}
