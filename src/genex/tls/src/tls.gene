(mod tls)

# ABI probe for the declared PKG-2 OpenSSL adapter. The net/http listener will
# own context and connection handles when direct TLS is wired into its loop.
(fn adapter_abi []
  (let lease ($pkg/native_binary this_pkg "native"))
  (let library ($ffi/open lease/.path))
  (try
    (let abi ($ffi/bind library "gene_tls_abi" [] C/Int))
    (abi)
    ensure
      ($ffi/Library/close library)
      lease/.close))
