# Generate or verify the Harness persistence catalog with Gene.
(type CatalogError ^props {^message Str} ^impl [Error])
(impl Error for CatalogError)
(fn problem [text : Str] (fail (CatalogError ^message text)))
(fn quoted [text : Str] ($json/stringify text))
(fn render_catalog [source : Str]
  (let schemas
    {^text ["type" "text"] ^core_state ["type" "key" "state"]
     ^turn_start ["type" "turn"] ^turn_end ["type" "turn" "reason" "synthetic"]
     ^turn_response ["type" "turn" "round" "text" "blobs"]
     ^turn_patch ["type" "turn" "round" "text" "result"]
     ^turn_request ["type" "turn" "round" "full" "settled"]
     ^reply ["type" "text" "final" "round" "turn"]
     ^console ["type" "text" "late" "turn"]
     ^composition_changed ["type" "entry" "operation" "previous_digest" "new_digest" "revision" "session" "turn"]
     ^plugin_state ["type" "plugin" "state_version" "state"]})
  (let rows [])
  (let seen {})
  (var number 0)
  (for raw in ($str/split source "\n")
    (set number (+ number 1))
    (let line ($str/trim raw))
    (if (|| (== line "") ($str/starts_with? line "#")) (continue))
    (let parts [])
    (for part in ($str/split ($str/join ($str/split line "\t") " ") " ")
      (if (!= part "") (parts .push part)))
    (if (|| (!= parts/.size 4) (! (["required" "ignorable"] .contains? parts/2))
            ($absent? (schemas .get parts/3)))
      (problem $"events.catalog:${number}: expected NAME VERSION required|ignorable SCHEMA"))
    (if ($absent? (#"^[a-z0-9/_-]+$" .match parts/0)) (problem "invalid event name"))
    (let version (try ($parse/parse_int parts/1) catch Any (problem "version must be an integer")))
    (if (<= version 0) (problem "version must be positive"))
    (if_not ($absent? (seen .get parts/0)) (problem $"duplicate event: ${parts/0}"))
    (seen .put parts/0 true)
    (rows .push {^name parts/0 ^version version ^ignorable (== parts/2 "ignorable") ^schema parts/3}))
  (let lines [
    "# Generated by tools/generate_harness_event_catalog.gene; do not edit by hand."
    "" "(mod generated_event_catalog)" ""
    """(fn require_event_fields [payload, names, event_name]
  (for name in names
    (if (== (payload .get name) void)
      ($panic $"${event_name} requires ${name}")))
  payload)""" ""])
  (let names [])
  (for [name fields] in schemas (names .push ($to_str name)))
  (for name in ($order/sort names)
    (let fields ($map (schemas .get name) quoted))
    (let joined ($str/join fields " "))
    (let label (quoted name))
    (lines .push $"(fn validate_${name}_event [payload]\n  (require_event_fields payload [${joined}] ${label}))")
    (lines .push ""))
  (lines .push "(var core_event_types")
  (var index 0)
  (for row in rows
    (let prefix (if (== index 0) "  #[" "    "))
    (let suffix (if (== index (- rows/.size 1)) "])" ""))
    (let name (quoted row/name))
    (lines .push $"${prefix}#{^name ${name} ^version ${row/version} ^ignorable ${row/ignorable} ^origin \"core\" ^owner \"core\" ^schema validate_${row/schema}_event}${suffix}")
    (set index (+ index 1)))
  ($ ($str/join lines "\n") "\n"))
(fn main [argv]
  (let args [])
  (for arg in argv (args .push ($to_str arg)))
  (if (|| (> args/.size 1) (&& (== args/.size 1) (!= args/0 "--check")))
    (problem "usage: gene run tools/generate_harness_event_catalog.gene [--check]"))
  (let root ($path/parent ($path/parent this_mod/.path)))
  (let source $"${root}/examples/gene-harness/events.catalog")
  (let target $"${root}/examples/gene-harness/src/storage/generated_event_catalog.gene")
  (let expected (render_catalog ($fs/read_text source)))
  (if (== args/.size 1)
    (then
      (if (|| (! ($fs/exists? target)) (!= ($fs/read_text target) expected))
        (problem "generated Harness event catalog is stale"))
      ($println "harness event catalog: current"))
    (else
      ($fs/write_text_atomic target expected)
      ($println target))))
