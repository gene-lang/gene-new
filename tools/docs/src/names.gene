# The name table: every Gene spelling the reference or the book can address,
# and the index of names computed from the book's Gene fences.

(import $str/[join split trim lower starts_with? ends_with? contains? byte_size
              slice_bytes])
(import $order/[sort_by])
(import fail_pipeline in? ^from "./util")

# Macro call shapes that bind a params vector; filled from build/docs/macros.gene.
(var macro_param_index {})

(fn set_macro_params [mapping]
  (set macro_param_index mapping))

(fn copy_list [items]
  (var out [])
  (for item in items (out .push item))
  out)

(fn full_path [path name]
  (if (> ($size path) 0)
    ($str/join [($str/join path "/") name] "/")
    else
    name))

(fn gene_tail [module_path]
  # `gene/str` addresses as `$str/...`; a package module keeps its path.
  (if ($str/starts_with? module_path "gene/")
    ($str/slice_bytes module_path 5 (- ($str/byte_size module_path) 5))
    else
    module_path))

(fn entry_local [module_path entry_id]
  # The entry's path below its module: `join`, `T/a`, `P:msg`.
  (let prefix ($str/join ["lib/" module_path "/"] ""))
  (if (starts_with? entry_id prefix)
    ($str/slice_bytes entry_id ($str/byte_size prefix)
      (- ($str/byte_size entry_id) ($str/byte_size prefix)))
    else
    entry_id))

(fn target_id [full]
  ($str/join ["lib/gene/" full] ""))

(fn dollar [full]
  ($str/join ["$" full] ""))

(fn spelling_forms [full]
  (let short (if ($str/starts_with? full "gene/")
    ($str/slice_bytes full 5 (- ($str/byte_size full) 5))
    else
    full))
  (var out [])
  (out .push (dollar short))
  (out .push short)
  (if ($str/starts_with? full "gene/")
    (out .push full)
    else
    (out .push ($str/join ["gene/" full] "")))
  out)

(fn collect_reflections [ns path out]
  (for d in ($declarations ns)
    (let kind d/kind)
    (if (== kind "Namespace")
      (do
        (let child (copy_list path))
        (child .push ($to_str d/name))
        (collect_reflections d/value child out))
      elif (in? kind ["Fn" "NativeFn" "Macro" "Type" "Protocol"])
        (do
          (let value d/value)
          (let name ($to_str d/name))
          (let sig (try ($runtime/signature value) catch Error nil))
          (if (not (contains? name "/"))
            (out .push {^path path ^name name ^kind kind ^value value
                         ^reported (if ($present? sig) sig/name else nil)})))))
  out)

(fn groups_of [decls]
  (var groups [])
  (for decl in decls
    (var found false)
    (for group in groups
      (let member ($first group))
      (if (&& (not found) ($same? decl/value member/value))
        (do
          (group .push decl)
          (set found true))))
    (if (not found) (groups .push [decl])))
  groups)

(fn add_row [rows by_key spelling id kind canonical reported]
  (if (not ($has_key? by_key spelling))
    (do
      (let row {^spelling spelling ^id id ^kind kind ^canonical canonical
                ^reported reported ^introduced_in "" ^used_in []})
      (rows .push row)
      (by_key .put spelling row))))

(fn build_name_table [modules heads entry_ids]
  (var rows [])
  (var by_key {})
  (var undocumented [])
  # Entries first: every documented entry has a spelling even before reflection
  # runs.
  (for module in modules
    (let module_path module/module)
    (let tail (gene_tail module_path))
    (for spelling in (spelling_forms tail)
      (add_row rows by_key spelling ($str/join ["lib/" module_path] "") "namespace"
        (== ($str/starts_with? spelling "$")) tail))
    (for entry in module/entries
      (let local $"${tail}/${(entry_local module_path entry/id)}")
      (for spelling in (spelling_forms local)
        (add_row rows by_key spelling entry/id entry/kind
          (== ($str/starts_with? spelling "$")) entry/name))
      (if (== ($to_str entry/kind) "message")
        (do
          (let full ($to_str entry/for))
          (let base (if ($str/starts_with? full "gene/")
            ($str/slice_bytes full 5 (- ($str/byte_size full) 5))
            else
            full))
          (for spelling in (spelling_forms base)
            (add_row rows by_key spelling entry/id entry/kind false entry/name))
          (if (contains? base "/")
            (let parts ($str/split base "/"))
            (let dot ($str/join [($str/join ($take parts (- ($size parts) 1)) "/") ($last parts)] "."))
            (add_row rows by_key dot entry/id entry/kind true entry/name))))))
  (for module in modules
    (for entry in module/entries
      (if (&& (== ($to_str entry/kind) "message")
              ($present? entry/alias_of) (not (== entry/alias_of "")))
        (for row in rows
          (if (== row/id entry/id) (row .put "canonical" false))))))
  (let decls (collect_reflections gene [] []))
  (for group in (groups_of decls)
    (var chosen nil)
    (for decl in group
      (if (&& (== chosen nil) (in? (target_id (full_path decl/path decl/name)) entry_ids))
        (set chosen decl)))
    (if ($present? chosen)
      (do
        (let chosen_full (full_path chosen/path chosen/name))
        (let id (target_id chosen_full))
        (for decl in group
          (for spelling in (spelling_forms (full_path decl/path decl/name))
            (add_row rows by_key spelling id decl/kind false decl/reported)))
        (let reported (if chosen/reported chosen/reported else chosen_full))
        (for spelling in (spelling_forms reported)
          (if ($has_key? by_key spelling)
            (do
              (let row (by_key .get spelling))
              (row .put "canonical" true)
              (row .put "id" id)))))
      else
      (do
        (for decl in group
          (for spelling in (spelling_forms (full_path decl/path decl/name))
            (if (not (in? spelling undocumented))
              (undocumented .push spelling)))))))
  (for head in heads
    (add_row rows by_key head "" "head" true head))
  {^rows (sort_by rows (fn [row] row/spelling)) ^undocumented undocumented})

(fn valid_symbol? [text]
  (if (== ($str/byte_size text) 0) false
    elif (starts_with? text "'") false
    elif (starts_with? text "\"") false
    elif (starts_with? text ":") false
    elif (== text "true") false
    elif (== text "false") false
    elif (== text "nil") false
    else
      (let first ($str/slice_bytes text 0 1))
      (if (contains? "0123456789-" first) false else true)))

(fn string_leaf? [value]
  (try (do ($chars value) true) catch Fault false))

(fn add_binder [value locals]
  # A parameter, `let`/`var` target, or pattern binder. Types after `:` and
  # message names are not binders.
  (if ($leaf? value)
    (if (not (string_leaf? value))
      (do
        (let text ($to_str value))
        (if (&& (> ($str/byte_size text) 0) (not (== text ":")))
          (do
            (var name text)
            (if (starts_with? name "^")
              (set name ($str/slice_bytes name 1 (- ($str/byte_size name) 1))))
            (if (ends_with? name "...")
              (set name ($str/slice_bytes name 0 (- ($str/byte_size name) 3))))
            (if (&& (> ($str/byte_size name) 0) (valid_symbol? name))
              (locals .put name true))))))
    else
    (do
      (let head ($head value))
      (if (&& ($leaf? head) (== ($to_str head) "import"))
        nil
        elif (&& ($leaf? head) (== ($to_str head) "path"))
        nil
        else
        (do
          (var skip false)
          (for item in ($body value)
            (if (&& ($leaf? item) (== ($to_str item) ":"))
              (set skip true)
              else
              (do
                (if (not skip) (add_binder item locals))
                (set skip false))))
          (map_for [k v] in ($props value) (add_binder v locals))
          (map_for [k v] in ($meta value) (add_binder v locals)))))))

(fn bind_import [item locals]
  # An import binds its selected names (the list items) and the alias after a
  # colon, never a path segment of the target.
  (let text ($to_str item))
  (if (contains? text ":")
    (do
      (let pieces ($str/split text ":"))
      (let name (pieces .get (- ($size pieces) 1)))
      (if (> ($str/byte_size name) 0) (locals .put name true)))
    elif (&& (> ($str/byte_size text) 0)
             (not ($str/starts_with? text "\""))
             (not ($str/starts_with? text "$"))
             (not (contains? text "/")))
      (do
        (locals .put text true))))

(fn collect_locals [value locals]
  (if ($leaf? value)
    nil
    else
    (do
      (let head ($head value))
      (if ($leaf? head)
        (do
          (let h ($to_str head))
          (if ($has_key? macro_param_index h)
            (do
              (let idx (macro_param_index .get h))
              (let args ($body value))
              (if (< idx ($size args))
                (add_binder (args .get idx) locals))))
          (if (|| (== h "fn") (== h "macro"))
            (let body ($body value))
            (if (> ($size body) 0)
              (if (not ($leaf? (body .get 0)))
                (add_binder (body .get 0) locals)
                else
                (do
                  (add_binder (body .get 0) locals)
                  (if (> ($size body) 1) (add_binder (body .get 1) locals))))))
          (if (|| (== h "let") (== h "var"))
            (let body ($body value))
            (if (> ($size body) 0) (add_binder (body .get 0) locals)))
          (if (in? h ["type" "enum" "protocol" "alias" "mod" "ns" "const"])
            (let body ($body value))
            (if (> ($size body) 0) (add_binder (body .get 0) locals)))
          (if (== h "message")
            (let body ($body value))
            (if (> ($size body) 0)
              (do
                (add_binder (body .get 0) locals)
                (if (> ($size body) 1) (add_binder (body .get 1) locals)))))
          (if (== h "import")
            (let body ($body value))
            (for item in body
              (if (not ($leaf? item))
                (do
                  (let ih ($head item))
                  (if (&& ($leaf? ih) (== ($to_str ih) "path"))
                    (do
                      (let parts ($body item))
                      (if (> ($size parts) 0)
                        (let last (parts .get (- ($size parts) 1)))
                        (if (&& ($leaf? last) (contains? ($to_str last) ":"))
                          (bind_import last locals))))
                    else
                    (for part in ($body item)
                      (if ($leaf? part) (bind_import part locals)))))
                else
                (bind_import item locals)))))
          (if (|| (== h "for") (== h "map_for"))
            (let body ($body value))
            (var i 0)
            (while (< i ($size body))
              (if (&& ($leaf? (body .get i))
                      (== ($to_str (body .get i)) "in"))
                (set i ($size body))
                else
                (do
                  (add_binder (body .get i) locals)
                  (set i (+ i 1))))))
          (if (== h "match")
            (let body ($body value))
            (var i 0)
            (while (< i (- ($size body) 1))
              (if (&& ($leaf? (body .get i))
                      (== ($to_str (body .get i)) "when"))
                (add_binder (body .get (+ i 1)) locals))
              (set i (+ i 1))))
          ))
      (for item in ($body value) (collect_locals item locals))
      (map_for [k v] in ($props value) (collect_locals v locals))
      (map_for [k v] in ($meta value) (collect_locals v locals))))

(fn written? [full source]
  # The reader turns `$"a${b}"` into `($to_str "a" b)`, a path the fence never
  # wrote. A path counts only when its spelling appears in the fence's source.
  (if ($str/starts_with? full "gene/")
    (|| (contains? source
          (dollar ($str/slice_bytes full 5 (- ($str/byte_size full) 5))))
        (contains? source full))
    else
    (contains? source full)))

(fn walk_value [value out locals source]
  (if ($leaf? value)
    (do
      (let is_string (string_leaf? value))
      (if (not is_string)
        (do
          (var text ($to_str value))
          (if (ends_with? text "...")
            (set text ($str/slice_bytes text 0 (- ($str/byte_size text) 3))))
          (if (&& (valid_symbol? text) (not (== text "$"))
                  (not (in? text ["^" "~"]))
                  (|| (not ($str/starts_with? text "$"))
                      (contains? source text))
                  (|| (not (contains? text "gene/"))
                      (contains? source text)))
            (if (contains? text "/")
              (do
                (let segments ($str/split text "/"))
                (let first (if (> ($size segments) 0) (segments .get 0) else ""))
                (let second (if (> ($size segments) 1) (segments .get 1) else ""))
                (let base (if (&& (== first "gene") (not (== second ""))) second else first))
                (let root (if (&& (starts_with? base "$") (> ($str/byte_size base) 1))
                  ($str/slice_bytes base 1 (- ($str/byte_size base) 1))
                  else
                  base))
                (if (&& (not ($has_key? locals root))
                        (not (in? root ["self" "err" "args"])))
                  (for spelling in (spelling_forms text) (out .push spelling))))
              else
              (if (not ($has_key? locals text))
                (out .push text)))))))
    else
    (do
      (let head ($head value))
      (if (&& ($leaf? head) (== ($to_str head) "path"))
        (do
          (var segments [])
          (for part in ($body value)
            (segments .push ($to_str part)))
          (let full ($str/join segments "/"))
          (let first (if (> ($size segments) 0) (segments .get 0) else ""))
          (let second (if (> ($size segments) 1) (segments .get 1) else ""))
          (if (== first "gene")
            (if (&& (written? full source)
                    (not (in? second ["self" "err" "args"])))
              (for spelling in (spelling_forms full) (out .push spelling)))
            else
            (if (&& (not (== full "")) (written? full source)
                    (not ($has_key? locals first))
                    (not (in? first ["self" "err" "args"])))
              (for spelling in (spelling_forms full) (out .push spelling)))))
        else
        (do
          (if (&& ($present? head)
                  (not (== ($to_str head) ($to_str value))))
            (walk_value head out locals source))
          (let body ($body value))
          (var i 0)
          (while (< i ($size body))
            (let item (body .get i))
            (if (&& ($leaf? item) (== ($to_str item) "~"))
              (set i (+ i 2))
              else
              (do
                (walk_value item out locals source)
                (set i (+ i 1)))))
          (map_for [k v] in ($props value) (walk_value v out locals source))
          (map_for [k v] in ($meta value) (walk_value v out locals source)))))))

(fn import_form? [value]
  (&& (not ($leaf? value))
      ($leaf? ($head value))
      (== ($to_str ($head value)) "import")))

(fn fence_names [body]
  (var names [])
  (var fence false)
  (var collect false)
  (var lines [])
  (for line in ($str/split body "\n")
    (if ($str/starts_with? line "```")
      (if fence
        (do
          (if collect
            (do
              (let source ($str/join lines "\n"))
              (let forms (try ($parse/read_all source) catch Error nil))
              (if ($present? forms)
                (do
                  (var parsed [])
                  (for form in forms (parsed .push form))
                  (var locals {})
                  (for form in parsed (collect_locals form locals))
                  (for form in parsed (walk_value form names locals source))))))
          (set lines [])
          (set fence false)
          (set collect false))
        else
        (do
          (let label ($str/trim ($str/slice_bytes line 3
                             (- ($str/byte_size line) 3))))
          (set collect (|| (== label "gene") ($str/starts_with? label "gene ")))
          (set fence true)
          (set lines [])))
      else
      (if (&& fence collect) (lines .push line))))
  names)

(fn fence_sources [body]
  # The raw source of every `gene` fence, for forms the reader lowers away.
  (var out [])
  (var fence false)
  (var collect false)
  (var lines [])
  (for line in ($str/split body "\n")
    (if ($str/starts_with? line "```")
      (if fence
        (do
          (if collect (out .push ($str/join lines "\n")))
          (set lines [])
          (set fence false)
          (set collect false))
        else
        (do
          (let label ($str/trim ($str/slice_bytes line 3
                             (- ($str/byte_size line) 3))))
          (set collect (|| (== label "gene") ($str/starts_with? label "gene ")))
          (set fence true)
          (set lines [])))
      else
      (if (&& fence collect) (lines .push line))))
  out)

(fn head_written? [source head]
  # `(Path ...)` is read as a Path literal whose head is a type value, so the
  # walker cannot see the `Path` spelling in the AST. The source still wrote it.
  (|| (contains? source ($str/join ["(" head " "]))
      (contains? source ($str/join ["(" head ")"]))
      (contains? source ($str/join ["(" head "\n"]))))

(fn section_names [body]
  # Names in one section's Gene fences, with binders shared across the
  # section's fences (a later fence may use an earlier fence's binding).
  (let sources (fence_sources body))
  (var locals {})
  (for source in sources
    (let forms ($parse/read_all source))
    (var parsed [])
    (for form in forms (parsed .push form))
    (for form in parsed (collect_locals form locals)))
  (var names [])
  (for source in sources
    (let forms ($parse/read_all source))
    (var parsed [])
    (for form in forms (parsed .push form))
    (for form in parsed
      (if (not (import_form? form))
        (walk_value form names locals source))))
  names)

(fn index_heads [chapters heads]
  # Check 4: a head is introduced where a gene fence writes it. The reader
  # lowers `(Path …)` and `(path …)` to values, so those two use the source;
  # every other head comes from the fence's names (heads like `quasiquote`
  # are written as `), not as a call.
  (let wanted {})
  (for head in heads (wanted .put head true))
  (let lowered ["Path" "path"])
  (let intro {})
  (for chapter in chapters
    (if (not (== chapter/chapter "overview"))
      (for section in chapter/sections
        (for name in (fence_names section/body)
          (if (&& ($has_key? wanted name) (not (in? name lowered))
                  (not ($has_key? intro name)))
            (intro .put name section/id)))
        (for source in (fence_sources section/body)
          (for head in lowered
            (if (&& ($has_key? wanted head) (not ($has_key? intro head))
                    (head_written? source head))
              (intro .put head section/id)))))))
  intro)

(fn index_book [chapters rows]
  (let by_key {})
  (for row in rows (by_key .put row/spelling row))
  (for chapter in chapters
    (for section in chapter/sections
      (for spelling in (fence_names section/body)
        (if ($has_key? by_key spelling)
          (do
            (let row (by_key .get spelling))
            (if (not (== chapter/chapter "overview"))
              (if (== row/id "")
                (do
                  (row .put "id" section/id)
                  (row .put "introduced_in" section/id))
                else
                (if (== row/introduced_in "")
                  (row .put "introduced_in" section/id))))
            (let used (row .get "used_in"))
            (if (not (in? section/id used)) (used .push section/id)))))))
  rows)
