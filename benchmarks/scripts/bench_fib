#!/usr/bin/env bash
set -euo pipefail

# Usage:
#   benchmarks/scripts/bench_fib [n]
#
# Defaults to fib(28). Pass 24 for the shorter historical sample.
#
# Environment:
#   GENE_BENCH_MODE=vm     (default: vm)
#   NIM=/path/to/nim       (default: nim, or ~/.nimble/bin/nim)

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"

echo "=== Gene Benchmark ==="
echo "Date: $(date '+%Y-%m-%d %H:%M:%S %A')"
echo "Git commit: $(git rev-parse HEAD)"

NIM_BIN="${NIM:-nim}"
if ! command -v "$NIM_BIN" >/dev/null 2>&1; then
  if [ -x "$HOME/.nimble/bin/nim" ]; then
    NIM_BIN="$HOME/.nimble/bin/nim"
  else
    echo "Error: nim not found. Set NIM=/path/to/nim or add nim to PATH." >&2
    exit 1
  fi
fi

MODE="${GENE_BENCH_MODE:-vm}"
case "$MODE" in
  vm)
    SOURCE="benchmarks/computation/fibonacci_vm.nim"
    LABEL="bytecode VM Fibonacci benchmark"
    ;;
  *)
    echo "Error: GENE_BENCH_MODE must be 'vm' in this implementation." >&2
    exit 1
    ;;
esac

echo "Nim version: $("$NIM_BIN" --version 2>&1 | head -1)"
echo "Mode: $MODE"
echo ""

CACHE_DIR="build/nimcache/fibonacci-$MODE"
# Keep the build log outside the nimcache: an incremental build whose config
# changed resets that directory, which used to delete the log before it could
# report the failure.
BUILD_LOG="build/logs/fibonacci-$MODE-build.log"
mkdir -p bin "$CACHE_DIR" "$(dirname "$BUILD_LOG")"

echo "Compiling $LABEL..."
CMD=("$NIM_BIN" c --ic:on --hints:off --mm:orc -d:release -d:danger --path:"$ROOT/src" --nimcache:"$CACHE_DIR" --out:"$ROOT/bin/fibonacci" "$SOURCE")
if ! "${CMD[@]}" >"$BUILD_LOG" 2>&1; then
  grep -v "Warning:" "$BUILD_LOG" | grep -v "ignoring duplicate libraries" || true
  exit 1
fi
grep -v "Warning:" "$BUILD_LOG" | grep -v "ignoring duplicate libraries" || true

if [ ! -x "$ROOT/bin/fibonacci" ]; then
  echo "Error: bin/fibonacci was not produced" >&2
  exit 1
fi

echo ""
echo "Running benchmark..."
"$ROOT/bin/fibonacci" "$@"
