# Alternate fresh processes for the matched VM operations in ops.gene.
(import ^from "./run" [capture distribution])

(fn validate_payload [payload iterations]
  ($assert
    (&& (== payload/format 1) (== payload/iterations iterations))
    "unexpected operation benchmark metadata")
  (let results {})
  (for row in payload/rows
    ($assert (== row/iterations iterations) "operation iteration count changed")
    ($assert (! ($has_key? results row/name)) "duplicate operation benchmark row")
    ($assert (&& (>= row/elapsed_ms 0) (>= row/gross_ns 0)) "negative elapsed time")
    (results .put row/name row/result))
  ($assert ($has_key? results "empty_while") "missing operation loop control")
  results)

(fn main [args] : Int
  ($assert
    (>= args/body/.size 3)
    "usage: run_ops.gene OUTPUT_DIR ITERATIONS GENE_EXE [GENE_EXE...]")
  (let output args/body/0)
  (let iterations ($parse/parse_int args/body/1))
  ($assert (> iterations 0) "iterations must be positive")
  ($assert (! ($fs/exists? output)) "output directory must be new")
  (let samples ($parse/parse_int (?? ($os/env? "GENE_BENCH_SAMPLES") "5")))
  ($assert (&& (>= samples 3) (<= samples 100)) "samples must be in 3..100")
  (let source ($path/join ($path/parent this_mod/.path) "ops.gene"))
  (let source_text ($fs/read_text source))
  (let source_hash ($crypto/sha256 source_text))
  (let variants [])
  (for argument in ($drop args/body 2)
    (let executable ($fs/real_path argument))
    (let version (capture executable ["--version"]))
    ($assert (== version/status 0) "could not read executable version")
    (variants .push
      {
        ^executable executable
        ^version version/stdout
        ^sha256 ($crypto/sha256 ($fs/read_bytes executable))
        ^rows {}
        ^wall_ms []}))
  ($fs/make_dir output)
  ($fs/write_text $"${output}/ops.gene" source_text)
  ($fs/write_text
    $"${output}/metadata.json"
    ($json/stringify
      {
        ^format 1
        ^iterations iterations
        ^samples samples
        ^warmup_rounds 1
        ^ordering "rotating executable order per round; fresh processes"
        ^source_sha256 source_hash
        ^variants variants
        ^git (capture "git" ["rev-parse" "HEAD"])
        ^worktree (capture "git" ["status" "--porcelain"])
        ^diff (capture "git" ["diff" "--no-ext-diff"])
        ^system (capture "uname" ["-srm"])}))
  (var reference nil)
  (repeat round in (+ samples 1)
    (repeat slot in variants/.size
      (let index (// (+ slot round) variants/.size))
      (let variant variants/%index)
      (let started ($os/monotonic_ms))
      (let process (capture variant/executable ["run" source ($to_str iterations) "json"]))
      (let wall (- ($os/monotonic_ms) started))
      ($fs/write_text $"${output}/${index}-${round}.stdout.json" process/stdout)
      ($fs/write_text $"${output}/${index}-${round}.stderr.txt" process/stderr)
      ($assert
        (&& (== process/status 0) (! process/timed_out) (! process/truncated))
        $"operation benchmark ${index}, round ${round} failed; inspect raw logs")
      (let payload ($json/parse process/stdout))
      (let results (validate_payload payload iterations))
      (if ($absent? reference)
        (set reference results)
        ($assert (== results reference) "operation benchmark results or row set changed"))
      (for row in payload/rows
        (if (== round 0)
          (then
            (variant/rows .put row/name {^result row/result ^gross_ns [] ^net_ns []}))
          (else
            (let group (variant/rows .get row/name))
            (group/gross_ns .push row/gross_ns)
            (group/net_ns .push row/net_ns))))
      (if (> round 0) (variant/wall_ms .push wall))
      ($println $"completed executable ${index}, round ${round}, wall ${wall} ms")))
  ($assert
    (== source_hash ($crypto/sha256 ($fs/read_text source)))
    "operation benchmark source changed during measurement")
  (let summary [])
  (for variant in variants
    ($assert
      (== variant/sha256 ($crypto/sha256 ($fs/read_bytes variant/executable)))
      "operation benchmark executable changed during measurement")
    (let rows [])
    (for [name group] in variant/rows
      (rows .push
        {
          ^name name
          ^result group/result
          ^gross_ns (distribution group/gross_ns)
          ^net_ns (distribution group/net_ns)}))
    (summary .push
      {
        ^executable variant/executable
        ^sha256 variant/sha256
        ^rows rows
        ^process_wall_ms (distribution variant/wall_ms)}))
  ($fs/write_text
    $"${output}/summary.json"
    ($json/stringify {^format 1 ^iterations iterations ^samples samples ^variants summary}))
  ($println $"saved ${output}/summary.json")
  0)
