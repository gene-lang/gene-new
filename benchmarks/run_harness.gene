# Alternate fresh processes and workspaces for the real service/patch workload.
# Usage: gene run benchmarks/run_harness.gene OUTPUT_DIR GENE_EXE [GENE_EXE...]
# GENE_BENCH_SAMPLES defaults to 3; each executable gets one excluded warmup.
(import [capture distribution] ^from "./run")

(fn record_harness_sample [variant result wall round]
  (if (== round 0)
    (then (variant .put "checksum" result/record_checksum))
    (else
      ($assert (== result/record_checksum variant/checksum) "record checksum changed")
      (variant/elapsed_ms .push result/elapsed_ms)
      (variant/wall_ms .push wall))))

(fn main [args] : Int
  (let arguments args/body)
  ($assert (>= ($size arguments) 2) "expected output directory and Gene executable(s)")
  (let output arguments/0)
  ($assert (! ($fs/exists? output)) "output directory must be new")
  (let samples ($parse/parse_int (?? ($os/env? "GENE_BENCH_SAMPLES") "3")))
  ($assert (&& (>= samples 3) (<= samples 100)) "samples must be in 3..100")
  (let variants [])
  (var i 1)
  (while (< i ($size arguments))
    (let executable ($fs/real_path arguments/%i))
    (let version (capture executable ["--version"]))
    ($assert (== version/status 0) "could not read executable version")
    (variants .push {^executable executable ^version version/stdout
      ^sha256 ($crypto/sha256 ($fs/read_bytes executable))
      ^elapsed_ms [] ^wall_ms [] ^checksum nil})
    (set i (+ i 1)))
  ($fs/make_dir output)
  ($fs/make_dir $"${output}/workspaces")
  ($fs/write_text $"${output}/metadata.json" ($json/stringify
    {^format 1 ^samples samples ^warmup_rounds 1 ^turns 100
      ^ordering "rotating executable order per round"
      ^git (capture "git" ["rev-parse" "HEAD"])
      ^worktree (capture "git" ["status" "--porcelain"])
      ^diff (capture "git" ["diff" "--no-ext-diff"])
      ^system (capture "uname" ["-srm"])
      ^machine_label (?? ($os/env? "GENE_BENCH_MACHINE") "")}))
  (repeat round in (+ samples 1)
    (repeat slot in ($size variants)
      (let index (// (+ slot round) ($size variants)))
      (let variant variants/%index)
      (let started ($os/monotonic_ms))
      (let process (capture variant/executable ["run"
        "examples/gene-harness/probes/performance.gene"
        $"${output}/workspaces/${index}-${round}" "100"]))
      (let wall (- ($os/monotonic_ms) started))
      ($fs/write_text $"${output}/${index}-${round}.stdout.json" process/stdout)
      ($fs/write_text $"${output}/${index}-${round}.stderr.txt" process/stderr)
      ($assert (&& (== process/status 0) (! process/timed_out) (! process/truncated))
        $"harness ${index}, round ${round} failed; inspect raw logs")
      (let result ($json/parse process/stdout))
      ($assert (== result/turns 100) "unexpected work count")
      (record_harness_sample variant result wall round)
      ($println $"completed executable ${index}, round ${round}, wall ${wall} ms")))
  (let summary [])
  (for variant in variants
    ($assert (== variant/checksum variants/0/checksum) "executables disagree on records")
    (summary .push {^executable variant/executable ^sha256 variant/sha256
      ^version variant/version ^turns 100 ^record_checksum variant/checksum
      ^service_elapsed_ms (distribution variant/elapsed_ms)
      ^process_wall_ms (distribution variant/wall_ms)}))
  ($fs/write_text $"${output}/summary.json" ($json/stringify summary))
  ($println $"saved ${output}/summary.json")
  0)
