(fn now [] ($os/monotonic_ms))
(fn report [name start result] ($println $"${name}\t${(- (now) start)}\t${result}"))
(fn add3 [x] (+ x 3))
(fn make_adder [k] (fn [x] (+ x k)))
(fn add_local [x] (let y 3) (+ x y))
(fn loop_only [n] (var total 0) (repeat i in n (set total (+ total 3))) total)
(fn plain [n] (var total 0) (repeat i in n (set total (add3 total))) total)
(fn closure [n] (let f (make_adder 3)) (var total 0) (repeat i in n (set total (f total))) total)
(fn scoped [n] (var total 0) (repeat i in n (set total (add_local total))) total)
(fn fib [n] (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))
(type Counter ^props {^n Int} (message inc [d] (set self/n (+ self/n d))) (message get [] self/n))
(fn sends [n] (let c (Counter ^n 0)) (repeat i in n (c .inc 1)) c/.get)
(fn reads [n] (let c (Counter ^n 1)) (var total 0) (repeat i in n (set total (+ total c/.get))) total)
(var t (now)) (report "loop_only_3M" t (loop_only 3000000))
(set t (now)) (report "scopeless_call_3M" t (plain 3000000))
(set t (now)) (report "closure_call_3M" t (closure 3000000))
(set t (now)) (report "scoped_call_3M" t (scoped 3000000))
(set t (now)) (report "fib27" t (fib 27))
(set t (now)) (report "send_write_3M" t (sends 3000000))
(set t (now)) (report "send_read_3M" t (reads 3000000))
