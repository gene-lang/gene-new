-proc kind*(v: Value): ValueKind {.inline, raises: [].} =
-  if v.bits == 0: return vkNil
+const tagValueKinds: array[16, ValueKind] = [
+  ## `kind` for each immediate and dedicated heap tag, indexed by the tag's low
+  ## four bits. A tag below MISSING_TAG is a float (or nil) and is decided
+  ## before the table is read; the two object tags answer from `objKind`.
+  vkFloat,    # 0xFFF0, never read
+  vkNil,      # MISSING_TAG
+  vkBool, vkInt, vkChar, vkFloat, vkSymbol,
+  vkNil,      # CYCLE_OBJECT_TAG, never read
+  vkString, vkList, vkMap, vkNode, vkInt, vkFunction, vkNativeFn,
+  vkNil]      # OBJECT_TAG, never read
+
+proc kind*(v: Value): ValueKind {.inline, raises: [],
+    codegenDecl: "static inline __attribute__((always_inline)) $1 $2$3".} =
+  ## Two table reads rather than a `case` over the tags. The `case` compiled
+  ## to a jump table whose cost kept LLVM from inlining `kind` at most of its
+  ## sites in `runLoop`, where about 400 calls stayed out of line.
   let tag = v.bits shr TAG_SHIFT
-  if tag < MISSING_TAG: return vkFloat   # direct float (incl. +/-Inf, canonical NaN)
-  case tag
-  of MISSING_TAG: vkNil
-  of BOOL_TAG: vkBool
-  of INT_TAG: vkInt
-  of CHAR_TAG: vkChar
-  of FLOATZERO_TAG: vkFloat
-  of SYMBOL_TAG: vkSymbol
-  of STRING_TAG: vkString
-  of INT64_TAG: vkInt
-  of LIST_TAG: vkList
-  of MAP_TAG: vkMap
-  of NODE_TAG: vkNode
-  of FUNCTION_TAG: vkFunction
-  of NATIVE_FN_TAG: vkNativeFn
-  of CYCLE_OBJECT_TAG, OBJECT_TAG:
-    let objKind = objData(v).objKind
-    if objKind == okEnv:
-      # `cast`, not `EnvData(...)`. The checked downcast emits an
-      # `isObjDisplayCheck` that can `raiseObjectConversionError`, and one
-      # possible raise anywhere in this proc compiles *every* `kind` call — the
-      # hottest read in the VM — with the goto-exception preamble: a
-      # thread-local `nimErrorFlag()` load on entry plus a branch after each
-      # inner call. The test above has already established the dynamic type, so
-      # the check can only ever succeed.
-      if cast[EnvData](objData(v)).borrowed: vkCallerEnv else: vkEnv
-    else:
-      objKindValueKinds[objKind]
-  else: vkNil
+  if tag < MISSING_TAG:
+    # nil (all bits zero), or a float stored directly (incl. +/-Inf, NaN)
+    return (if v.bits == 0: vkNil else: vkFloat)
+  if tag != OBJECT_TAG and tag != CYCLE_OBJECT_TAG:
+    return tagValueKinds[tag and 0xF]
+  let objKind = objData(v).objKind
+  if objKind == okEnv:
+    # `cast`, not `EnvData(...)`. The checked downcast emits an
+    # `isObjDisplayCheck` that can `raiseObjectConversionError`, and one
+    # possible raise anywhere in this proc compiles *every* `kind` call — the
+    # hottest read in the VM — with the goto-exception preamble: a
+    # thread-local `nimErrorFlag()` load on entry plus a branch after each
+    # inner call. The test above has already established the dynamic type, so
+    # the check can only ever succeed.
+    if cast[EnvData](objData(v)).borrowed: vkCallerEnv else: vkEnv
+  else:
+    objKindValueKinds[objKind]
 
 proc isNil*(v: Value): bool {.inline.} =
   v.bits == 0
