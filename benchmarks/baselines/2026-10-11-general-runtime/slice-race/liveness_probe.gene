(fn rec [n] (if (< n 2) n (+ (rec (- n 1)) (rec (- n 2)))))
(fn even_ [n] (if (== n 0) true (odd_ (- n 1))))
(fn odd_ [n] (if (== n 0) false (even_ (- n 1))))
(fn tail_ [n, acc] (if (== n 0) acc (tail_ (- n 1) (+ acc 1))))
(fn w [n] (var i 0) (while (< i n) (set i (+ i 1))) i)
(fn l [n] (var i 0) (loop (set i (+ i 1)) (if (< i n) (continue)) (break)) i)
(fn r [n] (var t 0) (repeat n (set t (+ t 1))) t)
(fn f [xs] (var t 0) (for x in xs (for y in xs (set t (+ t 1)))) t)
(fn probe [label, work]
  (let order [])
  (let a (spawn ^lane root (do (work) (order .push "work"))))
  (let b (spawn ^lane root (do (order .push "peer"))))
  (a .join) (b .join)
  ($println label order))
(fn main [args] : Int
  (let xs [])
  (var i 0)
  (while (< i 300) (xs .push i) (set i (+ i 1)))
  (probe "recursion" (fn [] (rec 22)))
  (probe "mutual" (fn [] (even_ 3000)))
  (probe "tail" (fn [] (tail_ 20000 0)))
  (probe "while" (fn [] (w 50000)))
  (probe "loop-continue" (fn [] (l 50000)))
  (probe "repeat" (fn [] (r 50000)))
  (probe "for" (fn [] (f xs)))
  (probe "native-each" (fn [] (xs .map (fn [x] (w 50)))))
  0)
