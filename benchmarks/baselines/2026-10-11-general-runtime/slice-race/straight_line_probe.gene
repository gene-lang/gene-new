(fn spin [n : Int] (var i 0) (while (< i n) (set i (+ i 1))) i)
(fn drain [ex]
  (while true
    ex/wake/.recv
    (var pending (ex/queue .swap []))
    (ex/done .set (+ ex/done/.get ($size pending)))))
(fn submit [ex, pad : Int, tag]
  (spin pad)
  (var q ex/queue/.get)
  (ex/mark .set 1) (ex/mark .set 2) (ex/mark .set 3) (ex/mark .set 4)
  (ex/mark .set 5) (ex/mark .set 6) (ex/mark .set 7) (ex/mark .set 8)
  (q .push tag)
  (ex/wake .try_send nil)
  nil)
(fn main [args] : Int
  (var lost 0)
  (var pad 0)
  (while (< pad 400)
    (let ex {^queue ($cell []) ^wake ($channel ^capacity 1) ^done ($cell 0) ^mark ($cell 0)})
    (let loop (spawn ^lane root (drain ex)))
    (let b (spawn ^lane root (submit ex pad "b")))
    (let a (spawn ^lane root (submit ex (+ 1 (// pad 5)) "a")))
    (let c (spawn ^lane root (submit ex (+ 9 (* 2 pad)) "c")))
    (a .join) (b .join) (c .join)
    ($sleep 1)
    (if (!= ex/done/.get 3) (set lost (+ lost 1)))
    loop/.cancel
    (set pad (+ pad 1)))
  ($println "lost" lost)
  0)
