(mod typed)
(type Point ^props {^x Int ^y Int})
(fn same_text [a b] (== a b))
(fn differs [a b] (!= a b))
(fn is_three [n : Int] : Bool (== n 3))
(fn odd [n : Int] : Bool (!= (// n 2) 0))
(fn half [n : Int] : Int (/ n 2))
(fn fact [n : Int] : Int (if (== n 0) (then 1) (else (* n (fact (- n 1))))))
(fn count_down [n : Int] : Int (if (!= n 0) (then (+ 1 (count_down (- n 1)))) (else 0)))
(fn sum_to [i : Int total : Int] : Int (if (== i 0) total (sum_to (- i 1) (+ total (// i 3)))))
(fn state_is [row wanted] (== row/state wanted))
(fn pick [kind] (if (== kind "a") (then "first") (elif (== kind "b") "second") (else "other")))
(fn until_equal [n : Int] : Int (var i 0) (while (!= i n) (set i (+ i 1))) i)
(fn ratio [a b] (/ a b))
(fn rem [a b] (// a b))
(fn main [args] : Int
  ($println [(same_text "a" "a") (same_text "a" "b") (same_text 1 1) (same_text [1] [1]) (same_text {^k 1} {^k 1}) (same_text nil nil) (same_text true false)])
  ($println [(differs "a" "a") (differs 1 2) (differs (Point ^x 1 ^y 2) (Point ^x 1 ^y 2)) (same_text (Point ^x 1 ^y 2) (Point ^x 1 ^y 3))])
  ($println [(is_three 3) (is_three 4) (odd 3) (odd 4) (half 9) (fact 5) (count_down 4) (sum_to 10 0)])
  ($println [(state_is {^state "done"} "done") (state_is {^state "busy"} "done") (pick "a") (pick "b") (pick "z") (until_equal 5)])
  ($println [(ratio 7 2) (ratio 7.0 2) (rem 7 2) (rem -7 2) (try (ratio 1 0) catch Any $err_msg) (try (rem 1 0) catch Any $err_msg)])
  (var results [])
  (for item in [1 "1" 1.0 nil true] (results .push [(same_text item 1) (differs item nil) (== item true)]))
  ($println results)
  0)
