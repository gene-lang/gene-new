# Differential checks for selectors, maps, namespaces, loops, sort and JSON.
(mod data)

(fn show [label value] ($println label " => " value))
(fn try_show [label thunk]
  (show label (try (thunk) catch Any $"!! ${$err_msg}")))

(ns counter
  (var n 0)
  (var label "start")
  (fn bump [] (set n (+ n 1)) n)
  (fn rename [text] (set label text) label))

(ns outer
  (ns inner
    (var depth 2)
    (fn deepen [] (set depth (+ depth 1)) depth)))

(ns left (var value "left value"))
(ns right (var value "right value"))

(var module_level 10)
(fn read_module_level [] module_level)

(fn selectors []
  (let xs [10 20 30 40])
  (let m {^a 1 ^b "two" ^c nil ^d [1 2]})
  (var acc [])
  (repeat i1 in 4 (acc .push xs/%i1))
  (show "list index" acc)
  (let last 3)
  (let neg -1)
  (let far 9)
  (show "index edges" [xs/%last xs/%neg xs/%far xs/0 xs/9])
  (let key "b")
  (let missing "zz")
  (let sym (quote a))
  (show "map dynamic" [m/%key m/%missing m/%sym m/a m/c m/nope])
  (show "nested" [m/d/0 m/d/5 m/d/%last])
  (let text "hello")
  (let zero 0)
  (try_show "string index" (fn [] text/%zero))
  (let node (quote (point ^x 1 ^y 2 9 8)))
  (let x_key "x")
  (try_show "node dynamic" (fn [] [node/%x_key node/%zero]))
  (let message ".size")
  (try_show "message segment" (fn [] xs/%message))
  (let float_index 1.0)
  (try_show "float index" (fn [] xs/%float_index))
  (try_show "nil target" (fn [] (let nothing nil) nothing/%zero)))

(fn maps []
  (let m {})
  (m .put "alpha" 1)
  (m .put (quote beta) 2)
  (m .put "gamma" nil)
  (show "put/get" [(m .get "alpha") (m .get (quote alpha)) (m .get "beta") (m .get "gamma") (m .get "never_seen_key_1")])
  (show "has" [($has_key? m "alpha") ($has_key? m "gamma") ($has_key? m "never_seen_key_2") ($has_key? m (quote beta))])
  (m .put "alpha" void)
  (show "after delete" [(m .get "alpha") ($size m) m])
  (m .put "never_seen_key_3" void)
  (show "delete absent" ($size m))
  (try_show "bad key" (fn [] (m .get 5)))
  (try_show "bad put key" (fn [] (m .put 5 1)))
  (let frozen ($freeze {^k 1}))
  (try_show "frozen put" (fn [] (frozen .put "k" 2)))
  (let words ["b" "a" "b" "c" "a" "b"])
  (let counts {})
  (for word in words (counts .put word (+ (?? (counts .get word) 0) 1)))
  (show "counts" counts)
  (var pairs [])
  (for [key count] in counts (pairs .push [($to_str key) count key]))
  (show "iteration" pairs)
  (let many {})
  (repeat i2 in 40 (many .put $"k${i2}" (* i2 i2)))
  (var sum 0)
  (repeat i3 in 40 (set sum (+ sum (many .get $"k${i3}"))))
  (show "large map" [sum ($size many) (many .get "k39") (many .get "k40")])
  (show "void literal" {^a 1 ^b void ^c 3}))

(fn pick [space] space/value)

(fn namespaces []
  (var seen [])
  (repeat i4 in 4
    (seen .push counter/n)
    (counter/bump))
  (seen .push counter/n)
  (show "live member" seen)
  (var labels [])
  (repeat i5 in 3
    (labels .push counter/label)
    (counter/rename $"round ${i5}"))
  (labels .push counter/label)
  (show "live label" labels)
  (var depths [])
  (repeat i6 in 3
    (depths .push outer/inner/depth)
    (outer/inner/deepen))
  (depths .push outer/inner/depth)
  (show "nested member" depths)
  (var picked [])
  (repeat i7 in 4 (picked .push (pick (if (== (// i7 2) 0) (then left) (else right)))))
  (show "two namespaces" picked)
  (try_show "missing member" (fn [] counter/nope))
  (var std [])
  (repeat i8 in 3 (std .push ($str/upper $"v${i8}")))
  (show "stdlib repeated" std)
  (var levels [])
  (repeat i9 in 3
    (levels .push (read_module_level))
    (set module_level (+ module_level 5)))
  (show "module var" levels))

(fn loops []
  (var fns [])
  (for item in [1 2 3] (fns .push (fn [] (* item 10))))
  (var called [])
  (for f in fns (called .push (f)))
  (show "captured loop vars" called)
  (var out [])
  (for item in [1 2 3 4 5 6]
    (if (== item 2) (then (continue)))
    (if (== item 5) (then (break)))
    (out .push item))
  (show "break/continue" out)
  (var nested [])
  (for a in [1 2]
    (for b in ["x" "y"]
      (let joined $"${a}${b}")
      (nested .push joined)))
  (show "nested loops" nested)
  (let source [1 2 3])
  (var grown [])
  (for item in source
    (if (< ($size source) 6) (then (source .push (+ item 10))))
    (grown .push item))
  (show "mutation during loop" [grown source])
  (var total 0)
  (for [a b] in [[1 2] [3 4] [5 6]] (set total (+ total (* a b))))
  (show "destructuring" total)
  (try_show "pattern mismatch" (fn [] (for [a b] in [[1 2] 3] a)))
  (var chars [])
  (for ch in "héllo" (chars .push ch))
  (show "string iteration" chars)
  (var empties 0)
  (for item in [] (set empties (+ empties 1)))
  (for item in nil (set empties (+ empties 1)))
  (show "empty iteration" empties))

(fn sorting []
  (let rows [{^id 1 ^k 3} {^id 2 ^k 1} {^id 3 ^k 3} {^id 4 ^k 1} {^id 5 ^k 2}])
  (var ids [])
  (for row in ($order/sort_by rows /k) (ids .push row/id))
  (show "stable sort_by" ids)
  (show "source untouched" rows/0/id)
  (show "sort numbers" ($order/sort [5 3 9 1 3 7 2 8 6 4 0]))
  (show "sort strings" ($order/sort ["pear" "apple" "fig" "apple" "kiwi"]))
  (show "descending" ($order/sort [3 1 2] ^compare (fn [a b] (- b a))))
  (let pending [4 2 9 1])
  (try_show "comparator error" (fn [] ($order/sort pending ^compare (fn [a b] (fail (Error ^message "no order"))))))
  (show "after failed sort" pending)
  (try_show "mixed sort" (fn [] ($order/sort [1 "a" 2])))
  (show "empty and single" [($order/sort []) ($order/sort [7])]))

(fn json []
  (let value {^name "Ada \"Lovelace\"" ^tags ["a" "b\\c" "tab\there" "nl\nx" "uni é ✓"] ^n 42 ^neg -7 ^big 9007199254740993 ^f 1.5 ^t true ^no false ^nothing nil ^nested {^empty {} ^list []}})
  (let text ($json/stringify value))
  (show "stringify" text)
  (show "round trip" ($json/parse text))
  (show "equal" (== ($json/parse text) value))
  (show "numbers" ($json/parse "[0, -0, 007, 12, -34, 1.5, -2.5e3, 1E2, 123456789012345678, 1234567890123456789, 12345678901234567890, 99999999999999999999999]"))
  (show "whitespace" ($json/parse " { \"a\" : [ 1 , 2 ] , \"b\" : { } }  "))
  (show "escapes" ($json/parse "[\"\\u0041\\n\\t\\\\\\/\\\"\", \"\\u00e9\", \"plain\", \"\"]"))
  (show "repeated keys" ($json/parse "[{\"id\":1,\"name\":\"x\"},{\"id\":2,\"name\":\"y\"},{\"name\":\"z\",\"id\":3,\"extra\":true}]"))
  (show "escaped key" ($json/parse "{\"a\\nb\": 1, \"\": 2, \"a\": 3, \"a\": 4}"))
  (show "control chars" ($json/stringify ["\u0001" "\u001f" "a\u0000b"]))
  (try_show "duplicate strict" (fn [] ($json/parse "{\"a\":1,\"a\":2}" ^^strict)))
  (try_show "unterminated string" (fn [] ($json/parse "[\"abc")))
  (try_show "unterminated key" (fn [] ($json/parse "{\"abc")))
  (try_show "bad escape" (fn [] ($json/parse "[\"a\\qb\"]")))
  (try_show "bad unicode" (fn [] ($json/parse "[\"\\u12\"]")))
  (try_show "raw newline" (fn [] ($json/parse "[\"a\nb\"]")))
  (try_show "raw newline key" (fn [] ($json/parse "{\"a\nb\":1}")))
  (try_show "bad number" (fn [] ($json/parse "[-]")))
  (try_show "bad number 2" (fn [] ($json/parse "[1-2]")))
  (try_show "trailing" (fn [] ($json/parse "[1] x")))
  (try_show "missing colon" (fn [] ($json/parse "{\"a\" 1}")))
  (try_show "bare key" (fn [] ($json/parse "{a:1}")))
  (try_show "unsupported" (fn [] ($json/stringify [(fn [] 1)])))
  (show "symbols" ($json/stringify [(quote sym) {^k (quote v)}]))
  (show "scalars" [($json/parse "12") ($json/parse "-1") ($json/parse "\"s\"") ($json/parse "null") ($json/parse "true")]))

(fn main [args] : Int
  (selectors)
  (maps)
  (namespaces)
  (loops)
  (sorting)
  (json)
  0)
