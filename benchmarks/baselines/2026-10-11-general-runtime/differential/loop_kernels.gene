(fn with_for [xs] (var t 0) (for x in xs (set t (+ t x))) t)
(fn with_while [xs] (var t 0) (var i 0) (while (< i 3) (set t (+ t xs/%i)) (set i (+ i 1))) t)
(fn no_loop [xs] (+ (+ xs/0 xs/1) xs/2))
(fn nested [rows] (var t 0) (for row in rows (for x in row (set t (+ t x)))) t)
(fn timeit [label, f, arg, n : Int]
  (var best 1000000)
  (var round 0)
  (var check 0)
  (while (< round 5)
    (let start ($os/monotonic_ms))
    (var i 0)
    (while (< i n) (set check (f arg)) (set i (+ i 1)))
    (let took (- ($os/monotonic_ms) start))
    (if (< took best) (set best took))
    (set round (+ round 1)))
  ($println label best check))
(fn main [args] : Int
  (let xs [1 2 3])
  (timeit "no_loop  " no_loop xs 300000)
  (timeit "while    " with_while xs 300000)
  (timeit "for      " with_for xs 300000)
  (let rows [])
  (var i 0)
  (while (< i 200) (rows .push [1 2 3]) (set i (+ i 1)))
  (timeit "nested   " nested rows 1500)
  0)
