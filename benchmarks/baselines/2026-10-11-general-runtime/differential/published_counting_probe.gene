(fn build [n : Int]
  (var rows [])
  (var i 0)
  (while (< i n)
    (rows .push {^id i ^name $"row${i}" ^tags [i (+ i 1) $"t${i}"]})
    (set i (+ i 1)))
  rows)
(fn pick [row] row/name)
(fn score [rows]
  (var total 0)
  (for row in rows
    (var name (pick row))
    (var tags row/tags)
    (if (== name "") (set total 0)) (set total (+ total ($size tags))))
  total)
(fn main [args] : Int
  (let rows (build 2000))
  (let t (spawn ^lane root ($size rows)))
  (t .join)
  (var best 1000000)
  (var round 0)
  (var check 0)
  (while (< round 7)
    (let start ($os/wall_ms))
    (var i 0)
    (while (< i 150) (set check (score rows)) (set i (+ i 1)))
    (let took (- ($os/wall_ms) start))
    (if (< took best) (set best took))
    (set round (+ round 1)))
  ($println best check)
  0)
