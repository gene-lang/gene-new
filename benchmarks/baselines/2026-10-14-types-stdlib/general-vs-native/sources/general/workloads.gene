# Matched by workloads.py. Input construction is outside kernel timing.
(mod workloads)

(fn make_input [size]
  (let numbers [])
  (let records [])
  (let lines [])
  (let events [])
  (let words ["READ" "WRITE" "SAVE" "LOAD" "OPEN" "CLOSE"])
  (repeat i in size
    (let amount (// (+ (* i 37) 11) 1009))
    (numbers .push amount)
    (records .push {^id i ^group $"group-${(// i 32)}" ^amount amount ^active (!= (// i 5) 0)})
    (let word_index (// i 6))
    (lines .push $" INFO user-${(// i 64)} ACTION ${words/%word_index} ")
    (events .push {^key $"user-${(// i 64)}" ^kind (// i 3) ^amount amount}))
  {^numbers numbers ^records records ^lines lines ^events events})

(fn integer_loop [input]
  (var state 7)
  (var total 0)
  (for number in input/numbers
    (set state (// (+ (* state 33) number) 1000003))
    (set total (+ total state)))
  [state total])

(fn make_transform [factor]
  (fn [value] (// (+ (* value (+ factor 1)) factor) 1009)))

(fn closure_dispatch [input]
  (let handlers [])
  (repeat i in 8 (handlers .push (make_transform i)))
  (var total 0)
  (var index 0)
  (for number in input/numbers
    (let handler_index (// index 8))
    (let handler handlers/%handler_index)
    (set total (+ total (handler number)))
    (set index (+ index 1)))
  total)

(fn records [input]
  (let selected [])
  (let groups {})
  (for row in input/records
    (if row/active
      (then
        (selected .push row)
        (groups .put row/group (+ (?? (groups .get row/group) 0) row/amount)))))
  (let ordered ($order/sort_by selected /amount))
  (var digest 0)
  (for row in ordered (set digest (// (+ (* digest 31) row/id) 1000000007)))
  (let totals [])
  (repeat i in 32 (totals .push (?? (groups .get $"group-${i}") 0)))
  [($size ordered) digest totals])

(fn text_index [input]
  (let counts {})
  (var total 0)
  (for line in input/lines
    (for word in ($str/split ($str/lower ($str/trim line)) " ")
      (counts .put word (+ (?? (counts .get word) 0) 1))
      (set total (+ total 1))))
  (let entries [])
  (for [key count] in counts (entries .push [($to_str key) count]))
  [total ($order/sort_by entries /0)])

(fn json_roundtrip [input]
  (let encoded ($json/stringify input/records))
  (let decoded ($json/parse encoded))
  (var total 0)
  (for row in decoded (set total (+ total row/amount)))
  [($size decoded) total ($str/byte_size encoded)])

(fn event_replay [input]
  (let state {})
  (for event in input/events
    (var account (state .get event/key))
    (if ($absent? account)
      (then
        (set account {^balance 0 ^revision 0})
        (state .put event/key account)))
    (if (== event/kind 0)
      (then (account .put "balance" (+ account/balance event/amount)))
      (elif (== event/kind 1)
        (account .put "balance" (- account/balance event/amount)))
      (else (account .put "balance" event/amount)))
    (account .put "revision" (+ account/revision 1)))
  (let result [])
  (for [key account] in state
    (result .push [($to_str key) account/balance account/revision]))
  ($order/sort_by result /0))

(fn cases []
  [["integer_loop" integer_loop] ["closure_dispatch" closure_dispatch]
   ["records" records] ["text_index" text_index]
   ["json_roundtrip" json_roundtrip] ["event_replay" event_replay]])

# Calibrate each kernel separately, then time a fresh batch. Timing includes
# calls and result allocation/release, but excludes fixture setup and reporting.
(fn measure [name callable input target_ms]
  (var repetitions 1)
  (var elapsed 0)
  (var result nil)
  (while (< elapsed target_ms)
    (let calibration_started ($os/monotonic_ms))
    (repeat i in repetitions (set result (callable input)))
    (set elapsed (- ($os/monotonic_ms) calibration_started))
    (if (< elapsed target_ms)
      (then
        ($assert (< repetitions 1048576) "benchmark calibration exceeded repetition limit")
        (set repetitions (* repetitions 2)))))
  (let expected result)
  (let started ($os/monotonic_ms))
  (repeat measured_index in repetitions (set result (callable input)))
  (set elapsed (- ($os/monotonic_ms) started))
  ($assert (== result expected) $"unstable result: ${name}")
  {^name name ^repetitions repetitions ^elapsed_ms elapsed ^result result})

(fn main [args] : Int
  ($assert (&& (>= ($size args/body) 1) (<= ($size args/body) 2))
    "usage: workloads.gene SIZE [TARGET_MS]; TARGET_MS=0 verifies without timing")
  (let size ($parse/parse_int args/body/0))
  (let target_ms (if (== ($size args/body) 2) ($parse/parse_int args/body/1) 100))
  ($assert (&& (>= size 1) (<= size 1000000)) "size must be in 1..1000000")
  ($assert (&& (>= target_ms 0) (<= target_ms 10000)) "target_ms must be in 0..10000")
  (let input (make_input size))
  (let rows [])
  (for entry in (cases)
    (let callable entry/1)
    (rows .push (if (== target_ms 0)
      {^name entry/0 ^result (callable input)}
      (measure entry/0 callable input target_ms))))
  ($println ($json/stringify {^format 1 ^language "gene" ^size size
    ^target_ms target_ms ^rows rows}))
  0)
