# General-purpose cross-language benchmarks. Orchestration stays in Gene.
(import [capture distribution] ^from "./run")
(import [cases] ^from "./general/workloads")

(fn new_variant [language]
  {^language language ^label language ^rows {} ^wall_ms []})

(fn validate_results [payload language size target_ms]
  ($assert (&& (== payload/format 1) (== payload/language language)
    (== payload/size size) (== payload/target_ms target_ms)) "unexpected workload metadata")
  ($assert (== ($size payload/rows) ($size (cases))) "unexpected workload count")
  (let results {})
  (for row in payload/rows
    ($assert (! ($has_key? results row/name)) "duplicate workload")
    ($assert (! ($absent? row/result)) "missing workload result")
    (results .put row/name row/result)
    (if (> target_ms 0)
      (then
        ($assert (&& (> row/repetitions 0) (<= row/repetitions 1048576)
          (== row/repetitions ($to_int row/repetitions))) "invalid repetition count")
        ($assert (> row/elapsed_ms 0) "timer resolution too low; increase GENE_BENCH_TARGET_MS"))))
  (for entry in (cases)
    ($assert ($has_key? results entry/0) $"missing workload: ${entry/0}"))
  results)

(fn record_sample [variant payload size target_ms wall round]
  (let results (validate_results payload variant/language size target_ms))
  (if (> round 0)
    (for row in payload/rows
      ($assert ($has_key? variant/rows row/name) "missing warmup result")
      (let group (variant/rows .get row/name))
      ($assert (== group/result row/result) "workload result changed")))
  (for row in payload/rows
    (if (== round 0)
      (then
        (variant/rows .put row/name {^result row/result ^batch_ms [] ^raw []}))
      (else
        (let group (variant/rows .get row/name))
        (group/batch_ms .push (/ (* row/elapsed_ms 1.0) row/repetitions))
        (group/raw .push row))))
  (if (> round 0) (variant/wall_ms .push wall))
  results)

(fn run_worker [variant size target_ms]
  (let arguments (if (== variant/language "gene")
    ["run" variant/source ($to_str size) ($to_str target_ms)]
    [variant/source ($to_str size) ($to_str target_ms)]))
  (capture variant/executable arguments))

(fn checked_output [process]
  ($assert (&& (== process/status 0) (! process/timed_out) (! process/truncated))
    $"workload process failed: ${process/stderr}")
  ($json/parse process/stdout))

(fn rounded [value]
  (/ (* ($to_int (+ (* value 1000.0) 0.5)) 1.0) 1000.0))

(fn main [args] : Int
  ($assert (&& (>= ($size args/body) 3) (<= ($size args/body) 5))
    "usage: run_general.gene OUTPUT_DIR GENE_EXE PYTHON_EXE [SIZE [BASELINE_GENE_EXE]]")
  (let output args/body/0)
  ($assert (! ($fs/exists? output)) "output directory must be new")
  (let size (if (>= ($size args/body) 4) ($parse/parse_int args/body/3) 5000))
  (let samples ($parse/parse_int (?? ($os/env? "GENE_BENCH_SAMPLES") "5")))
  (let target_ms ($parse/parse_int (?? ($os/env? "GENE_BENCH_TARGET_MS") "100")))
  ($assert (&& (>= size 1) (<= size 1000000)) "size must be in 1..1000000")
  ($assert (&& (>= samples 3) (<= samples 100)) "samples must be in 3..100")
  ($assert (&& (>= target_ms 50) (<= target_ms 10000)) "target_ms must be in 50..10000")
  (let directory ($path/parent this_mod/.path))
  (let variants [(new_variant "gene") (new_variant "python")])
  (if (== ($size args/body) 5)
    (then
      (let baseline (new_variant "gene"))
      (baseline .put "label" "baseline")
      (variants .push baseline)))
  (repeat index in ($size variants)
    (let variant variants/%index)
    (let argument_index (if (== index 2) 4 (+ index 1)))
    (let executable ($fs/real_path args/body/%argument_index))
    (let source ($path/join directory "general"
      (if (== variant/language "gene") "workloads.gene" "workloads.py")))
    (let version (capture executable ["--version"]))
    ($assert (== version/status 0) "could not read executable version")
    (variant .put "executable" executable)
    (variant .put "source" source)
    (variant .put "version" ($str/trim ($to_str version/stdout version/stderr)))
    (variant .put "sha256" ($crypto/sha256 ($fs/read_bytes executable)))
    (variant .put "source_sha256" ($crypto/sha256 ($fs/read_bytes source))))
  ($fs/make_dir output)
  (let metadata {^format 1 ^size size ^samples samples ^target_ms target_ms
    ^warmup_rounds 1 ^ordering "rotating fresh-process order; fixed workload order within each process"
    ^clock "Gene monotonic milliseconds; Python perf_counter_ns converted to milliseconds"
    ^calibration "per-process, per-workload doubling; calibration excluded from kernel samples"
    ^variants variants
    ^git (capture "git" ["rev-parse" "HEAD"])
    ^worktree (capture "git" ["status" "--porcelain"])
    ^diff (capture "git" ["diff" "--no-ext-diff"])
    ^system (capture "uname" ["-srm"])
    ^machine_label (?? ($os/env? "GENE_BENCH_MACHINE") "")})
  ($fs/write_text $"${output}/metadata.json" ($json/stringify metadata))
  # Preserve even untracked sources, which git diff would omit.
  ($fs/make_dir $"${output}/sources/general")
  (for source in ["run_general.gene" "run.gene" "general/workloads.gene" "general/workloads.py"]
    ($fs/write_text $"${output}/sources/${source}" ($fs/read_text ($path/join directory source))))

  # Exercise wraps, all branches, duplicate sort keys and multi-event accounts
  # before timing. Cross-language correctness is independent of sample collection.
  (let verification [])
  (for fixture_size in [1 17 257 2048]
    (var reference nil)
    (for variant in variants
      (let process (run_worker variant fixture_size 0))
      ($fs/write_text $"${output}/verify-${fixture_size}-${variant/label}.stdout.json" process/stdout)
      ($fs/write_text $"${output}/verify-${fixture_size}-${variant/label}.stderr.txt" process/stderr)
      (let results (validate_results (checked_output process) variant/language fixture_size 0))
      (if (== reference nil)
        (set reference results)
        ($assert (== reference results) $"languages disagree at size ${fixture_size}")))
    (verification .push fixture_size))
  ($println "cross-language verification passed for sizes 1, 17, 257, 2048")
  (repeat round in (+ samples 1)
    (var reference nil)
    (repeat slot in ($size variants)
      (let index (// (+ slot round) ($size variants)))
      (let variant variants/%index)
      (let started ($os/monotonic_ms))
      (let process (run_worker variant size target_ms))
      (let wall (- ($os/monotonic_ms) started))
      ($fs/write_text $"${output}/${variant/label}-${round}.stdout.json" process/stdout)
      ($fs/write_text $"${output}/${variant/label}-${round}.stderr.txt" process/stderr)
      (let results (record_sample variant (checked_output process) size target_ms wall round))
      (if (== reference nil)
        (set reference results)
        ($assert (== reference results) "languages disagree on workload results"))
      ($println $"completed ${variant/label}, round ${round}, process ${wall} ms")))
  (for variant in variants
    ($assert (== variant/source_sha256 ($crypto/sha256 ($fs/read_bytes variant/source)))
      "workload source changed during benchmark")
    ($assert (== variant/sha256 ($crypto/sha256 ($fs/read_bytes variant/executable)))
      "executable changed during benchmark"))
  (let comparisons [])
  (let report ["# Gene / Python general-purpose benchmark" ""
    $"${size} input items per batch; ${samples} measured fresh processes per executable."
    "One excluded warmup process per executable; each kernel calibrates before timing."
    "Ratio = Gene median / Python median; greater than 1 means Gene took longer."
    "" "| Workload | Gene ms/batch | Python ms/batch | Ratio |"
    "| --- | ---: | ---: | ---: |"])
  (for entry in (cases)
    (let name entry/0)
    (let gene_group (variants/0/rows .get name))
    (let python_group (variants/1/rows .get name))
    (let gene_stats (distribution gene_group/batch_ms))
    (let python_stats (distribution python_group/batch_ms))
    (let ratio (/ gene_stats/median python_stats/median))
    (let comparison {^name name ^gene_ms_per_batch gene_stats ^python_ms_per_batch python_stats
      ^gene_over_python ratio ^result gene_group/result})
    (if (== ($size variants) 3)
      (then
        (let baseline_group (variants/2/rows .get name))
        (let baseline_stats (distribution baseline_group/batch_ms))
        (comparison .put "baseline_ms_per_batch" baseline_stats)
        (comparison .put "baseline_over_gene" (/ baseline_stats/median gene_stats/median))))
    (comparisons .push comparison)
    (report .push $"| ${name} | ${(rounded gene_stats/median)} | ${(rounded python_stats/median)} | ${(rounded ratio)} |"))
  (if (== ($size variants) 3)
    (then
      (report .push "")
      (report .push "Baseline / current Gene ratio: greater than 1 means current Gene is faster.")
      (report .push "")
      (report .push "| Workload | Baseline ms/batch | Current ms/batch | Speedup |")
      (report .push "| --- | ---: | ---: | ---: |")
      (for comparison in comparisons
        (report .push $"| ${comparison/name} | ${(rounded comparison/baseline_ms_per_batch/median)} | ${(rounded comparison/gene_ms_per_batch/median)} | ${(rounded comparison/baseline_over_gene)} |"))))
  (report .push "")
  (report .push "Process wall times include startup, input construction, calibration and reporting; they are not kernel speed ratios.")
  (let processes [])
  (for variant in variants
    (processes .push {^language variant/language ^label variant/label
      ^wall_ms (distribution variant/wall_ms)}))
  ($fs/write_text $"${output}/summary.json" ($json/stringify
    {^format 1 ^size size ^samples samples ^verification_sizes verification
      ^comparisons comparisons ^processes processes}))
  ($fs/write_text $"${output}/report.md" ($str/join report "\n"))
  ($println ($str/join report "\n"))
  ($println $"saved ${output}/summary.json and report.md")
  0)
